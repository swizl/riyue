              (右乘, 右乘类型)提升浮点 = 右乘提升;
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "*") { ("  " + 表达式C + " = 浮点乘 double " + 左乘提升 + ", " + 右乘提升)发射; }
             否则 { ("  " + 表达式C + " = 浮点除 double " + 左乘提升 + ", " + 右乘提升)发射; }
             "浮点" = 表达式类型;
         } 否则 {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "*") { ("  " + 表达式C + " = 乘 i32 " + 左乘 + ", " + 右乘)发射; }
             否则如果 (操作符 ?= "/") { ("  " + 表达式C + " = 有符号除 i32 " + 左乘 + ", " + 右乘)发射; }
             否则 { ("  " + 表达式C + " = 有符号取余 i32 " + 左乘 + ", " + 右乘)发射; }
             "整数" = 表达式类型;
         }
     }
}

函数 解析一元 {
    如果 (标记类型 ?= 4 && 标记值 ?= "-") {
        ()下一个标记;
        ()解析一元;
        表达式C = 一元操作数;
        表达式类型 = 一元类型;
        如果 (一元类型 ?= "浮点") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 浮点减 double 0.000000e+00, " + 一元操作数)发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 0, " + 一元操作数)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (标记类型 ?= 4 && 标记值 ?= "!") {
        ()下一个标记;
        ()解析一元;
        表达式C = 一元操作数;
        ()新寄存器 = 比较临时;
        ("  " + 比较临时 + " = 整数比较 eq i32 " + 一元操作数 + ", 0")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    } 否则 {
        ()解析原子;
    }
}

函数 解析原子 {
    如果 (标记类型 ?= 1) {
        // 整数数字字面量
        标记值 = 表达式C;
        "整数" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 5) {
        // 浮点数字字面量（原样发射十进制 double，llvm-as 接受）
        标记值 = 表达式C;
        "浮点" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 3) {
        // 字符串字面量
        (标记值)存字符串常量 = 表达式C;
        "字符串" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 2) {
        // 标识符
        标记值 = 标识名;
        如果 (标识名 ?= "函数") {
            ()解析闭包;
        } 否则如果 (标识名 ?= "真") {
            "1" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则如果 (标识名 ?= "假") {
            "0" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则 {
            (标识名)查闭包函数 = 闭包函数名;
            如果 (闭包函数名 ?= "") {
                (标识名)查类型 = 类型码;
                如果 (类型码 ?= 0) {
                    "0" = 表达式C;
                    "整数" = 表达式类型;
                    ()下一个标记;
                } 否则 {
                    (标识名)转义标识符 = 转义;
                    如果 (命中全局表 ?= 1) { "@" + 转义 = 地址; }
                    否则 { "%" + 转义 = 地址; }
                    ()新寄存器 = 表达式C;
                    如果 (类型码 ?= 2) {
                        ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
                        "字符串" = 表达式类型;
                    } 否则如果 (类型码 ?= 4) {
                        ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
                        "函数" = 表达式类型;
                    } 否则如果 (类型码 ?= 3) {
                        ("  " + 表达式C + " = 加载 double, ptr " + 地址 + ", align 8")发射;
                        "浮点" = 表达式类型;
                    } 否则 {
                        ("  " + 表达式C + " = 加载 i32, ptr " + 地址 + ", align 4")发射;
                        "整数" = 表达式类型;
                    }
                    ()下一个标记;
                }
            } 否则 {
                // 闭包名：值为内部函数指针
                "@" + 闭包函数名 = 表达式C;
                "函数" = 表达式类型;
                ()下一个标记;
            }
        }
    } 否则如果 (标记值 ?= "(") {
        ()解析括号或调用;
    } 否则 {
        // 未知：空表达式
        "0" = 表达式C;
        "整数" = 表达式类型;
    }
}

// 解析 ( ... ) 可能是分组或前缀调用
函数 解析括号或调用 {
    ()下一个标记;   // 消费 "("
    如果 (标记值 ?= ")") {
        0 = 参数计数;
        "" = 参数文本;
        "" = 参数类型IR;
        "" = 参数前缀文本;
    } 否则 {
        ()解析表达式;
        表达式C = 参数文本;
        表达式类型 = 参数0类型;
        (表达式类型)类型转IR = 参数类型IR;
        参数类型IR + " " = 参数前缀文本;
        参数前缀文本 + 表达式C = 参数前缀文本;
        1 = 参数计数;
        当 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            参数文本 + ", " = 参数文本;
            参数文本 + 表达式C = 参数文本;
            (表达式类型)类型转IR = 参数单类型;
            参数类型IR + ", " = 参数类型IR;
            参数类型IR + 参数单类型 = 参数类型IR;
            参数前缀文本 + ", " = 参数前缀文本;
            参数前缀文本 + 参数单类型 = 参数前缀文本;
            参数前缀文本 + " " = 参数前缀文本;
            参数前缀文本 + 表达式C = 参数前缀文本;
            参数计数 + 1 = 参数计数;
        }
    }
    ()下一个标记;   // 消费 ")"
    如果 (标记类型 ?= 2) {
        标记值 = 函数名;
        ()下一个标记;
        (函数名)查闭包函数 = 闭包函数名;
        如果 (闭包函数名 ?= "") {
        如果 (函数名 ?= "打印") {
            如果 (参数计数 ?= 0) {
                ("\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ")")发射;
            } 否则如果 (参数0类型 ?= "字符串") {
                ("%s\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ", " + 参数前缀文本 + ")")发射;
            } 否则如果 (参数0类型 ?= "浮点") {
                ("%g\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ", " + 参数前缀文本 + ")")发射;
            } 否则 {
                ("%d\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ", " + 参数前缀文本 + ")")发射;
            }
            "" = 表达式C;
            "空" = 表达式类型;
        } 否则如果 (函数名 ?= "长度") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr) @" + 转义_获取字符数 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "字符码") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, i32) @" + 转义_字符码 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "子串") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, i32, i32) @" + ("辅助子串")转义标识符 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "转字符串") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (i32) @" + ("辅助转字符串")转义标识符 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "拼接") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + ("辅助拼接")转义标识符 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "读取文件") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr) @" + 转义_读取文件 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "写入文件") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, ptr) @" + 转义_写入文件 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "获取参数") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (i32) @" + 转义_获取参数 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "获取参数数量") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 () @" + 转义_获取参数数量 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "输出错误") {
            ("调用 void (ptr) @" + 转义_输出错误 + "(" + 参数前缀文本 + ")")发射;
            "" = 表达式C;
            "空" = 表达式类型;
        } 否则如果 (函数名 ?= "字符串开头") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, ptr) @" + 转义_字符串开头 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "分割行数") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr) @" + 转义_分割行数 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "获取行") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, i32) @" + 转义_获取行 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "字符位置到字节位置") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, i32) @" + 转义_字符位置到字节位置 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "文件存在") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr) @" + 转义_文件存在 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "获取目录路径") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr) @" + 转义_获取目录路径 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "连接路径") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + 转义_连接路径 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则 {
            (函数名)查函数返回类型 = 类型码;
            (函数名)转义标识符 = 函数转义;
            如果 (类型码 ?= 0) {
                (函数名)查类型 = 变量码;
                // 间接调用不追加捕获实参、返回类型固定 i32 —— 与宿主 源/后端/代码生成器_表达式.cpp 的「函数指针变量」间接调用路径一致；故只有不捕获、返回 i32 的函数值可作为值传递。
                如果 (变量码 ?= 4) {
                    (函数名)取地址 = 指针地址;
                    ()新寄存器 = 函数指针;
                    ("  " + 函数指针 + " = 加载 ptr, ptr " + 指针地址 + ", align 8")发射;
                    ()新寄存器 = 表达式C;
                    ("  " + 表达式C + " = 调用 i32 (" + 参数类型IR + ") " + 函数指针 + "(" + 参数前缀文本 + ")")发射;
                    "整数" = 表达式类型;
                } 否则 {
                    ("调用 void (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
                    "" = 表达式C;
                    "空" = 表达式类型;
                }
            } 否则如果 (类型码 ?= 2) {
                ()新寄存器 = 表达式C;
                ("  " + 表达式C + " = 调用 ptr (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
                "字符串" = 表达式类型;
            } 否则 {
                ()新寄存器 = 表达式C;
                ("  " + 表达式C + " = 调用 i32 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
                "整数" = 表达式类型;
            }
        }
        } 否则 {
            // 闭包调用：直接调用内部函数，追加捕获变量地址
            "" = 闭包捕获参数;
            "" = 闭包全参数类型;
            参数类型IR = 闭包全参数类型;
            0 = 索引;
            (闭包捕获表)分割行数 = 行数;
            当 (索引 < 行数) {
                (闭包捕获表, 索引)获取行 = 行;
                (行, 闭包函数名 + ":")字符串开头 = 开头命中;
                如果 (开头命中 ?= 1) {
                    (闭包函数名)长度 = 函数名长;
                    (行)长度 = 行总长;
                    (行, 函数名长 + 1, 行总长 - 函数名长 - 1)子串 = 捕获名;
                    (捕获名)取地址 = 捕获地址;
                    如果 (闭包全参数类型 ?= "") {
                        "ptr" = 闭包全参数类型;
                        "ptr " = 闭包捕获参数;
                        闭包捕获参数 + 捕获地址 = 闭包捕获参数;
                    } 否则 {
                        闭包全参数类型 + ", ptr" = 闭包全参数类型;
                        闭包捕获参数 + ", ptr " = 闭包捕获参数;
                        闭包捕获参数 + 捕获地址 = 闭包捕获参数;
                    }
                }
                索引 + 1 = 索引;
            }
            (函数名)查闭包返回 = 闭包返回值IR;
            如果 (闭包返回值IR ?= "i32") {
                ()新寄存器 = 表达式C;
                ("  " + 表达式C + " = 调用 i32 (" + 闭包全参数类型 + ") @" + 闭包函数名 + "(" + 参数前缀文本 + 闭包捕获参数 + ")")发射;
                "整数" = 表达式类型;
            } 否则如果 (闭包返回值IR ?= "ptr") {
                ()新寄存器 = 表达式C;
                ("  " + 表达式C + " = 调用 ptr (" + 闭包全参数类型 + ") @" + 闭包函数名 + "(" + 参数前缀文本 + 闭包捕获参数 + ")")发射;
                "字符串" = 表达式类型;
            } 否则 {
                ("调用 void (" + 闭包全参数类型 + ") @" + 闭包函数名 + "(" + 参数前缀文本 + 闭包捕获参数 + ")")发射;
                "" = 表达式C;
                "空" = 表达式类型;
            }
        }
    } 否则 {
        // 分组
        表达式C = 参数文本;
    }
}

// ────────────────────────────────────────────
// 语句解析 (Statement Parser)
// ────────────────────────────────────────────

// 解析并发射函数体（直到 } 为止，不消费 }）
函数 发射函数体 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "}") { 中断; }
        ()解析并发射语句;
    }
}

// 解析并发射一条语句
函数 解析并发射语句 {
    如果 (标记值 ?= "如果") {
        ()新标签 = 合并标签;
        (合并标签, 0)发射如果链;
    } 否则如果 (标记值 ?= "当") {
        ()下一个标记;   // 当
        ()下一个标记;   // (
        ()新标签 = 循环头标签;
        ()新标签 = 循环体标签;
        ()新标签 = 循环退出标签;
        (循环退出标签)压退出栈;
        (循环头标签)压继续栈;
        (循环头标签)发射标签;
        ()解析表达式;   // 必须在 循环头标签 之后：条件指令落入循环体，每轮重新求值
        ()下一个标记;   // )
        ()发射条件;
        ("分支 i1 " + 当前条件 + ", 标签 %" + 循环体标签 + ", 标签 %" + 循环退出标签)发射终结;
        (循环体标签)发射标签;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("分支 标签 %" + 循环头标签)发射终结;
        (循环退出标签)发射标签;
        ()弹退出栈;
        ()弹继续栈;
    } 否则如果 (标记值 ?= "循环") {
        // 范围循环: 循环 (变量: 开始, 结束[, 步长])
        ()下一个标记;   // 循环
        ()下一个标记;   // (
        标记值 = 循环变量;
        ()下一个标记;   // :
        ()下一个标记;   // 开始
        ()解析表达式;
        表达式C = 循环开始C;
        ()下一个标记;   // ,
        ()解析表达式;
        表达式C = 循环结束C;
        如果 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            表达式C = 循环步长C;
            ()下一个标记;   // )
        } 否则 {
            "1" = 循环步长C;
            ()下一个标记;   // )
        }
        (循环变量, "I")局部表添加;
        (循环变量)转义标识符 = 循环变量转义;
        ()新标签 = 循环头标签;
        ()新标签 = 循环体标签;
        ()新标签 = 循环步长标签;
        ()新标签 = 循环退出标签;
        (循环退出标签)压退出栈;
        (循环步长标签)压继续栈;
        ("存储 i32 " + 循环开始C + ", ptr %" + 循环变量转义 + ", align 4")发射;
        (循环头标签)发射标签;
        ()新寄存器 = 循环值;
        ("  " + 循环值 + " = 加载 i32, ptr %" + 循环变量转义 + ", align 4")发射;
        ()新寄存器 = 循环比较;
        ("  " + 循环比较 + " = 整数比较 slt i32 " + 循环值 + ", " + 循环结束C)发射;
        ("分支 i1 " + 循环比较 + ", 标签 %" + 循环体标签 + ", 标签 %" + 循环退出标签)发射终结;
        (循环体标签)发射标签;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        (循环步长标签)发射标签;
        ()新寄存器 = 循环加载;
        ("  " + 循环加载 + " = 加载 i32, ptr %" + 循环变量转义 + ", align 4")发射;
        ()新寄存器 = 循环步进;
        ("  " + 循环步进 + " = 加 i32 " + 循环加载 + ", " + 循环步长C)发射;
        ("存储 i32 " + 循环步进 + ", ptr %" + 循环变量转义 + ", align 4")发射;
        ("分支 标签 %" + 循环头标签)发射终结;
        (循环退出标签)发射标签;
        ()弹退出栈;
        ()弹继续栈;
    } 否则如果 (标记值 ?= "返回") {
        ()下一个标记;
        如果 (标记值 ?= ";") {
            ("返回 void")发射终结;
        } 否则 {
            ()解析表达式;
            如果 (表达式类型 ?= "字符串") { ("返回 ptr " + 表达式C)发射终结; }
            否则如果 (表达式类型 ?= "浮点") { ("返回 double " + 表达式C)发射终结; }
            否则 { ("返回 i32 " + 表达式C)发射终结; }
        }
        ()下一个标记;   // ;
    } 否则如果 (标记值 ?= "中断") {
        ()查退出栈 = 退出标签;
        ("分支 标签 %" + 退出标签)发射终结;
        ()下一个标记;   // ;
        ()下一个标记;   // } 或下一语句
    } 否则如果 (标记值 ?= "继续") {
        ()查继续栈 = 继续标签;
        ("分支 标签 %" + 继续标签)发射终结;
        ()下一个标记;   // ;
        ()下一个标记;   // } 或下一语句
    } 否则如果 (标记值 ?= "{") {
        ()下一个标记;
        ()发射函数体;
        ()下一个标记;   // }
    } 否则 {
        ()解析表达式;
        ()发射表达式语句;
    }
}

// 表达式语句：赋值（值在左，目标在右）或调用语句
函数 发射表达式语句 {
    如果 (标记值 ?= "=") {
        ()下一个标记;
        如果 (标记类型 ?= 2) {
            标记值 = 目标名;
            ()下一个标记;
            (目标名)查类型 = 类型码;
            如果 (类型码 ?= 0) {
                (目标名)转义标识符 = 目标转义;
                如果 (表达式类型 ?= "字符串") { (目标名, "S")局部表添加; }
                否则如果 (表达式类型 ?= "浮点") { (目标名, "F")局部表添加; }
                否则如果 (表达式类型 ?= "函数") { (目标名, "C")局部表添加; }
                否则 { (目标名, "I")局部表添加; }
                "%" + 目标转义 = 目标地址;
            } 否则 {
                (目标名)转义标识符 = 目标转义;
                如果 (命中全局表 ?= 1) { "@" + 目标转义 = 目标地址; }
                否则 { "%" + 目标转义 = 目标地址; }
            }
            如果 (表达式类型 ?= "字符串") {
                ("存储 ptr " + 表达式C + ", ptr " + 目标地址 + ", align 8")发射;
            } 否则如果 (表达式类型 ?= "函数") {
                // 闭包赋给变量：登记 变量名 → 内部闭包名，调用点据此直接调用并追加捕获地址
                (表达式C, "@")字符串开头 = 是闭包值;
                如果 (是闭包值 ?= 1) {
                    (表达式C)长度 = 闭包值长;
                    (表达式C, 1, 闭包值长 - 1)子串 = 闭包内部名;
                    (闭包函数表, 目标名, 闭包内部名)表替换 = 闭包函数表;
                    (闭包内部名)查闭包返回 = 内部返回IR;
                    (闭包返回表, 目标名, 内部返回IR)表替换 = 闭包返回表;
                }
                ("存储 ptr " + 表达式C + ", ptr " + 目标地址 + ", align 8")发射;
            } 否则如果 (表达式类型 ?= "浮点") {
                ("存储 double " + 表达式C + ", ptr " + 目标地址 + ", align 8")发射;
            } 否则 {
                ("存储 i32 " + 表达式C + ", ptr " + 目标地址 + ", align 4")发射;
            }
            ()下一个标记;   // ;
        } 否则 {
            ()下一个标记;   // ;
        }
    } 否则如果 (标记值 ?= "+=" || 标记值 ?= "-=" || 标记值 ?= "*=" || 标记值 ?= "/=") {
        // 复合赋值「目标 op= 值」：解析表达式 已把目标读入 表达式C 并把目标地址写入 地址
        标记值 = 操作符;
        地址 = 目标地址;
        ()下一个标记;             // 消费运算符
        ()解析表达式;             // 右侧值 → 表达式C
        ()新寄存器 = 加载临时;
        ("  " + 加载临时 + " = 加载 i32, ptr " + 目标地址 + ", align 4")发射;
        ()新寄存器 = 运算临时;
        如果 (操作符 ?= "+=") { ("  " + 运算临时 + " = 加 i32 " + 加载临时 + ", " + 表达式C)发射; }
        否则如果 (操作符 ?= "-=") { ("  " + 运算临时 + " = 减 i32 " + 加载临时 + ", " + 表达式C)发射; }
        否则如果 (操作符 ?= "*=") { ("  " + 运算临时 + " = 乘 i32 " + 加载临时 + ", " + 表达式C)发射; }
        否则 { ("  " + 运算临时 + " = 有符号除 i32 " + 加载临时 + ", " + 表达式C)发射; }
        ("存储 i32 " + 运算临时 + ", ptr " + 目标地址 + ", align 4")发射;
        ()下一个标记;   // ;
    } 否则 {
        // 调用语句：调用指令已在解析表达式时发射
        ()下一个标记;   // ;
    }
}

// 发射 if / else if / else 链（IR 标签与分支版）
函数 (合并标签:字符串, 是否递归:整数)发射如果链 {
    ()下一个标记;   // 如果/否则如果
    ()下一个标记;   // (
    ()解析表达式;
    ()下一个标记;   // )
    ()发射条件;
    ()新标签 = 真标签;
    ()新标签 = 假标签;
    ("分支 i1 " + 当前条件 + ", 标签 %" + 真标签 + ", 标签 %" + 假标签)发射终结;
    (真标签)发射标签;
    ()下一个标记;   // {
    ()发射函数体;
    ()下一个标记;   // }
    ("分支 标签 %" + 合并标签)发射终结;
    (假标签)发射标签;
    如果 (标记值 ?= "否则如果") {
        (合并标签, 1)发射如果链;
    } 否则如果 (标记值 ?= "否则") {
        ()下一个标记;   // 否则
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("分支 标签 %" + 合并标签)发射终结;
    } 否则 {
        ("分支 标签 %" + 合并标签)发射终结;
    }
    如果 (是否递归 ?= 0) {
        (合并标签)发射标签;
    }
}

// ────────────────────────────────────────────
// 函数定义 (Function Definitions)
// ────────────────────────────────────────────

// 解析函数签名（当前标记在 函数 关键字）
// 产出: 原型名/输入参数IR/输入参数表/输出参数表/返回类型名/输出参数名
函数 解析函数签名 {
    ()下一个标记;   // 函数
    "" = 输入参数IR;
    "" = 输入参数表;
    "" = 返回类型名;
    "" = 输出参数名;
    "" = 局部类型表;
    "" = 已声明表;
    如果 (标记值 ?= "(") {
        // 输入参数列表在前
        ()下一个标记;
        "" = 输入参数IR;
        "" = 输入参数表;
        如果 (标记值 ?= ")") {
            "" = 输入参数IR;
            "" = 输入参数表;
        } 否则 {
            当 (真) {
                标记值 = 参数名;
                ()下一个标记;
                "" = 类型名;
                如果 (标记值 ?= ":") {
                    ()下一个标记;
                    标记值 = 类型名;
                    ()下一个标记;
                } 否则 {
                    "整数" = 类型名;
                }
                // 记录参数类型到局部表
                如果 (类型名 ?= "整数") { (参数名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (参数名, "S")局部表添加; }
                否则如果 (类型名 ?= "函数") { (参数名, "C")局部表添加; }
                否则 { (参数名, "F")局部表添加; }
                // 记录到已声明表（参数由函数签名声明）
                (已声明表, 参数名, "X")表添加 = 已声明表;
                // 收集 IR 参数（头部参数列表 + 名:I 行）
                如果 (类型名 ?= "整数") { "i32" = 参数类型IR; (输入参数表, 参数名, "I")表添加 = 输入参数表; }
                否则如果 (类型名 ?= "字符串") { "ptr" = 参数类型IR; (输入参数表, 参数名, "S")表添加 = 输入参数表; }
                否则如果 (类型名 ?= "函数") { "ptr" = 参数类型IR; (输入参数表, 参数名, "C")表添加 = 输入参数表; }
                否则 { "double" = 参数类型IR; (输入参数表, 参数名, "F")表添加 = 输入参数表; }
                (参数名 + "_in")转义标识符 = 参数转义;
                如果 (输入参数IR ?= "") {
                    参数类型IR + " %" = 输入参数IR;
                } 否则 {
                    输入参数IR + ", " = 输入参数IR;
                    输入参数IR + 参数类型IR = 输入参数IR;
                    输入参数IR + " %" = 输入参数IR;
                }
                输入参数IR + 参数转义 = 输入参数IR;
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
        如果 (标记值 ?= "(" || 标记值 ?= "{") {
            "" = 原型名;   // 匿名函数：无名字
        } 否则 {
            标记值 = 原型名;
            ()下一个标记;
        }
    } 否则 {
        // 函数名在前
        标记值 = 原型名;
        ()下一个标记;
    }
    // 输出参数列表
    "" = 输出参数表;
    "" = 返回类型名;
    如果 (标记值 ?= "(") {
        ()下一个标记;
        如果 (标记值 ?= ")") {
            "" = 输出参数表;
        } 否则 {
            当 (真) {
                 // "0 = 名:类型"
                 如果 (标记类型 ?= 1) { ()下一个标记; }
                 如果 (标记值 ?= "=") { ()下一个标记; }
                 标记值 = 输出名;
                 ()下一个标记;
                 "" = 类型名;
                 如果 (标记值 ?= ":") {
                     ()下一个标记;
                     标记值 = 类型名;
                     ()下一个标记;
                 } 否则 {
                     "整数" = 类型名;
                 }
                // 记录返回类型（第一个输出参数）
                如果 (返回类型名 ?= "") {
                    "" = 返回类型名;
                    类型名 = 返回类型名;
                }
                // 记录输出参数名（第一个输出参数）
                如果 (输出参数名 ?= "") {
                    输出名 = 输出参数名;
                }
                // 记录输出参数类型到局部表
                如果 (类型名 ?= "整数") { (输出名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (输出名, "S")局部表添加; }
                否则 { (输出名, "F")局部表添加; }
                // 记录到已声明表（输出参数由函数签名声明）
                (已声明表, 输出名, "X")表添加 = 已声明表;
                // 收集输出参数表（名:码 行）
                如果 (类型名 ?= "整数") { (输出参数表, 输出名, "I")表添加 = 输出参数表; }
                否则如果 (类型名 ?= "字符串") { (输出参数表, 输出名, "S")表添加 = 输出参数表; }
                否则 { (输出参数表, 输出名, "F")表添加 = 输出参数表; }
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
    }
}

// 收集函数原型（第一遍）
函数 收集函数原型 {
    ()解析函数签名;
    // 不发射声明：LLVM 模块级符号允许前向引用，用户函数均在第二遍以 `定义 内部` 定义；
    // 而 llvm-as 不允许为 `内部` 链接的函数写 `声明`（invalid linkage for function declaration）。
    // 记录函数返回类型
    如果 (返回类型名 ?= "字符串") { (原型名, "S")函数返回表添加; }
    否则如果 (返回类型名 ?= "整数") { (原型名, "I")函数返回表添加; }
    // 跳到代码块
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "{") {
            ()跳过代码块;
            ()下一个标记;   // 消费 }
            中断;
        }
        ()下一个标记;
    }
}

// 发射输出参数的 alloca + 零初始化
函数 发射输出参数声明 {
    0 = 索引;
    (输出参数表)分割行数 = 行数;
    当 (索引 < 行数) {
        (输出参数表, 索引)获取行 = 行;
        (行)提取行名 = 输出名;
        (行)提取行码 = 输出码;
        (输出名)转义标识符 = 输出转义;
        如果 (输出码 ?= "S") {
            ("%" + 输出转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr null, ptr %" + 输出转义 + ", align 8")发射;
        } 否则如果 (输出码 ?= "C") {
            ("%" + 输出转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr null, ptr %" + 输出转义 + ", align 8")发射;
        } 否则如果 (输出码 ?= "F") {
            ("%" + 输出转义 + " = 分配 double, align 8")发射;
            ("存储 double 0.000000e+00, ptr %" + 输出转义 + ", align 8")发射;
        } 否则 {
            ("%" + 输出转义 + " = 分配 i32, align 4")发射;
            ("存储 i32 0, ptr %" + 输出转义 + ", align 4")发射;
        }
        索引 + 1 = 索引;
    }
}

// 发射输入参数复制（参数 %名_in → alloca %名）
函数 发射输入参数复制 {
    0 = 索引;
    (输入参数表)分割行数 = 行数;
    当 (索引 < 行数) {
        (输入参数表, 索引)获取行 = 行;
        (行)提取行名 = 参数名;
        (行)提取行码 = 参数码;
        (参数名)转义标识符 = 参数转义;
        (参数名 + "_in")转义标识符 = 参数入转义;
        如果 (参数码 ?= "S") {
            ("%" + 参数转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则如果 (参数码 ?= "C") {
            ("%" + 参数转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则如果 (参数码 ?= "F") {
            ("%" + 参数转义 + " = 分配 double, align 8")发射;
            ("存储 double %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则 {
            ("%" + 参数转义 + " = 分配 i32, align 4")发射;
            ("存储 i32 %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 4")发射;
        }
        索引 + 1 = 索引;
    }
}

// 发射局部变量声明（函数内新局部变量，跳过已由签名/输出声明声明的）
函数 发射局部声明 {
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        // 提取名（: 之前字符）
        (行)长度 = 行长;
        0 = 位置;
        "" = 局部名;
        当 (位置 < 行长) {
            (行, 位置, 1)子串 = 字;
            如果 (字 ?= ":") { 位置 = 行长; }
            否则 {
                局部名 + 字 = 局部名;
                位置 + 1 = 位置;
            }
        }
        // 提取类型码（必须在遍历 已声明表 之前，因为 获取行 共享静态缓冲区会覆盖 行）
        (局部名)长度 = 类型码长;
        (行, 类型码长 + 1, 1)子串 = 提取类型码;
        // 跳过已声明（参数/输出）：遍历 已声明表
        0 = 索引2;
        (已声明表)分割行数 = 声明行数;
        0 = 已声明命中;
        当 (索引2 < 声明行数) {
            (已声明表, 索引2)获取行 = 声明行;
            (声明行, 局部名 + ":")字符串开头 = 已声明命中;
            如果 (已声明命中 ?= 1) { 索引2 = 声明行数; }
            否则 { 索引2 + 1 = 索引2; }
        }
        如果 (已声明命中 ?= 0) {
            (局部名)转义标识符 = 局部转义;
            如果 (提取类型码 ?= "S") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "C") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "F") { ("%" + 局部转义 + " = 分配 double, align 8")发射; }
            否则 { ("%" + 局部转义 + " = 分配 i32, align 4")发射; }
        }
        索引 + 1 = 索引;
    }
}

// 发射函数定义（第二遍）
函数 发射函数定义 {
    ()解析函数签名;
    "" = 返回类型IR;
    如果 (返回类型名 ?= "整数") { "i32" = 返回类型IR; }
    否则如果 (返回类型名 ?= "字符串") { "ptr" = 返回类型IR; }
    否则如果 (返回类型名 ?= "浮点") { "double" = 返回类型IR; }
    否则 { "void" = 返回类型IR; }
    (原型名)转义标识符 = 原型转义;
    0 = 已终结;
    1 = 缓冲模式;
    "" = 函数体C;
    ()下一个标记;   // {
    ()发射函数体;
    0 = 缓冲模式;
    ()下一个标记;   // }
    ("定义 内部 " + 返回类型IR + " @" + 原型转义 + "(" + 输入参数IR + ") {")发射;
    ("entry:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    (函数体C)发射;
    如果 (已终结 ?= 1) {
        // 当前块已终结，无需再追加返回
    } 否则如果 (返回类型名 ?= "") {
        ("返回 void")发射;
    } 否则 {
