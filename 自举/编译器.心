// 第一遍：收集全局变量与函数原型
函数 第一遍 {
    0 = 源位置;
    ()下一个标记;
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "函数") {
            ()收集函数原型;
         } 否则 {
            // 尝试全局声明: 值 = 变量 名 ;
            标记类型 = 保存标记类型;
            标记值 = 保存标记值;
            ()下一个标记;
            如果 (标记值 ?= "=") {
                ()下一个标记;
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                    标记值 = 全局名;
                    ()下一个标记;
                    // 发射全局声明（IR 版）
                    如果 (保存标记类型 ?= 1) {
                        (全局名)转义标识符 = 全局转义;
                        ("@" + 全局转义 + " = 内部 全局 i32 " + 保存标记值)发射;
                        (全局名, "I")全局表添加;
                    } 否则如果 (保存标记类型 ?= 5) {
                        (全局名)转义标识符 = 全局转义;
                        ("@" + 全局转义 + " = 内部 全局 double " + 保存标记值)发射;
                        (全局名, "F")全局表添加;
                    } 否则 {
                        (保存标记值)存字符串常量 = 字符串号;
                        (全局名)转义标识符 = 全局转义;
                        ("@" + 全局转义 + " = 内部 全局 ptr " + 字符串号)发射;
                        (全局名, "S")全局表添加;
                    }
                    ()下一个标记;   // ;
                } 否则 {
                    ()跳到分号;
                }
            } 否则 {
                ()跳到分号;
            }
        }
    }
}

// 第二遍：发射函数体
函数 第二遍 {
    0 = 源位置;
    ()下一个标记;
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "函数") {
            ()发射函数定义;
        } 否则 {
            // 跳过全局声明（已发射）
            ()跳过表达式;
            ()下一个标记;
            如果 (标记值 ?= "=") {
                ()下一个标记;
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                }
                ()下一个标记;
            } 否则 {
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                    ()下一个标记;
                }
            }
        }
    }
}

