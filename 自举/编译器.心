            (名)长度 = 名长;
            (行)长度 = 行长;
            (行, 名长 + 1, 行长 - 名长 - 1)子串 = 结果;
            索引 = 行数;
        } 否则 {
            索引 + 1 = 索引;
        }
    }
}

// 表中是否含 名: 前缀行
函数 (表:字符串, 名:字符串)在表(0 = 结果:整数) {
