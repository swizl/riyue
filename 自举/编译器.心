// 解析匿名函数（当前标记 = 标识符 "函数"）：生成内部函数定义、捕获外层局部变量
函数 解析闭包 {
    局部类型表 = 保存局部类型表;
    函数体C = 保存函数体C;
    输入参数表 = 保存输入参数表;
    输出参数表 = 保存输出参数表;
    已声明表 = 保存已声明表;
    输入参数IR = 保存输入参数IR;
    返回类型名 = 保存返回类型名;
    输出参数名 = 保存输出参数名;
    原型名 = 保存原型名;
    已终结 = 保存已终结;
    ()解析函数签名;               // 止于 { ；原型名 = ""
    闭包计数 + 1 = 闭包计数;
    "闭包" + (闭包计数)转字符串 = 闭包名;
    (闭包名)转义标识符 = 闭包转义;
    源位置 = 体开始位置;
    "" = 闭包捕获参数;
    ()下一个标记;                 // 进入函数体
    1 = 体深度;
    当 (体深度 > 0) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "{") { 体深度 + 1 = 体深度; }
        否则如果 (标记值 ?= "}") { 体深度 - 1 = 体深度; }
        否则如果 (标记类型 ?= 2) {
            标记值 = 捕获名;
            (已声明表, 捕获名)在表 = 已声明;
            如果 (已声明 ?= 0) {
                (保存局部类型表, 捕获名)查表值 = 捕获码;
                如果 (捕获码 ?= "") { "无" = 忽略名; }
                否则 {
                    (捕获名, 捕获码)局部表添加;
                    (已声明表, 捕获名, 捕获码)表添加 = 已声明表;
                    (捕获名)转义标识符 = 捕获转义;
                    如果 (输入参数IR ?= "" && 闭包捕获参数 ?= "") {
                        "ptr %" + 捕获转义 = 闭包捕获参数;
                    } 否则 {
                        闭包捕获参数 + ", ptr %" = 闭包捕获参数;
                        闭包捕获参数 + 捕获转义 = 闭包捕获参数;
                    }
                    (闭包捕获表, 闭包名, 捕获名)表添加 = 闭包捕获表;
                }
            }
        }
        ()下一个标记;
    }
    体开始位置 = 源位置;
    ()下一个标记;                 // 回退到函数体首标记
    0 = 已终结;
    "" = 函数体C;
    ()发射函数体;
    ()下一个标记;                 // 过 }
    函数体C = 闭包体;             // 保存体 IR
    如果 (返回类型名 ?= "") { "void" = 闭包返回IR; }
    否则 { (返回类型名)类型转IR = 闭包返回IR; }
    "" = 函数体C;
    ("定义 内部 " + 闭包返回IR + " @" + 闭包转义 + "(" + 输入参数IR + 闭包捕获参数 + ") {")发射;
    ("entry:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    函数体C + 闭包体 = 函数体C;
    如果 (已终结 ?= 1) {
        "无" = 忽略终结;
    } 否则如果 (返回类型名 ?= "") {
        ("返回 void")发射;
    } 否则 {
        (输出参数名)取地址 = 闭包返回地址;
        ()新寄存器 = 闭包返回加载;
        ("  " + 闭包返回加载 + " = 加载 " + 闭包返回IR + ", ptr " + 闭包返回地址 + ", align 4")发射;
        ("  返回 " + 闭包返回IR + " " + 闭包返回加载)发射;
    }
    ("}")发射;
    闭包定义 + 函数体C = 闭包定义;
    (闭包函数表, 闭包名, 闭包名)表添加 = 闭包函数表;
    (闭包返回表, 闭包名, 闭包返回IR)表添加 = 闭包返回表;
    "@" + 闭包名 = 表达式C;
    "函数" = 表达式类型;
    保存函数体C = 函数体C;
    保存局部类型表 = 局部类型表;
    保存输入参数表 = 输入参数表;
    保存输出参数表 = 输出参数表;
    保存已声明表 = 已声明表;
    保存输入参数IR = 输入参数IR;
    保存返回类型名 = 返回类型名;
    保存输出参数名 = 输出参数名;
    保存原型名 = 原型名;
    保存已终结 = 已终结;
}

// ────────────────────────────────────────────
// 导入处理（文本包含）
// 扫描整行 导入 "路径"; → 解析路径 → 去重/环检测 → 递归读入 → 用其内容替换该行
// ────────────────────────────────────────────

// 已导入 / 正在导入（解析后的路径字符串；用于去重与环检测；只追加不移除）
"" = 变量 已导入表;
"" = 变量 正在导入表;

// 取路径的目录部分（末尾带分隔符；无分隔符返回 ""）
函数 (路径:字符串)取目录(0 = 结果:字符串) {
    "" = 结果;
    0 = 索引;
    (路径)长度 = 总长;
    0 = 末位;
    当 (索引 < 总长) {
        (路径, 索引)字符码 = 码值;
        如果 (码值 ?= 47) { 索引 + 1 = 末位; }
        如果 (码值 ?= 92) { 索引 + 1 = 末位; }
        索引 + 1 = 索引;
    }
    如果 (末位 > 0) { (路径, 0, 末位)子串 = 结果; }
}

// 解析模块文件：依次尝试 基础目录+名、名、名+".心"，都找不到返回 ""
函数 (模块名:字符串, 基础目录:字符串)查找模块(0 = 结果:字符串) {
    "" = 结果;
    (基础目录, 模块名)连接路径 = 候选;
    (候选)文件存在 = 存在;
    如果 (存在 ?= 1) {
        候选 = 结果;
    } 否则 {
        (模块名)文件存在 = 存在;
        如果 (存在 ?= 1) {
            模块名 = 结果;
        } 否则 {
            (模块名 + ".心")文件存在 = 存在;
            如果 (存在 ?= 1) {
                模块名 + ".心" = 结果;
            }
        }
    }
}

// 把源码中的 导入 行替换为被导入文件（递归处理）；失败返回 ""
// 注意：错误分支用 中断 跳出最外层行循环（宿主与自举均不支持 返回 关键字）
函数 (源码:字符串, 基础目录:字符串)处理导入(0 = 结果:字符串) {
    "" = 结果;
    // 固化输入：读取文件 使用静态缓冲，递归读取子模块会覆盖它，故先复制本次源码
    (源码)长度 = 源码长;
    (源码, 0, 源码长)子串 = 源文本;
    (源文本)分割行数 = 行数;
    0 = 索引;
    当 (索引 < 行数) {
        (源文本, 索引)获取行 = 行;
        (行, 0, 3)子串 = 前缀;
        如果 (前缀 ?= "导入 ") {
            (行)长度 = 行长;
            (行, 3, 行长 - 3)子串 = 余下;
            // 跳过前导空白（前缀已含一个空格，此处容忍多余空白）
            0 = 余位;
            0 = 停止;
            (余下)长度 = 余下长;
            当 (余位 < 余下长 && 停止 ?= 0) {
                (余下, 余位)字符码 = 余码;
                如果 (余码 ?= 32 || 余码 ?= 9) { 余位 + 1 = 余位; }
                否则 { 1 = 停止; }
            }
            (余下, 余位, 余下长 - 余位)子串 = 余下;
            (余下, 0, 1)子串 = 引号;
            如果 (引号 ?= "\"") {
                (余下)长度 = 余下长;
                (余下, 1, 余下长 - 1)子串 = 内部;
                0 = 结束位;
                0 = 扫描位;
                (内部)长度 = 内部长;
                当 (扫描位 < 内部长) {
                    (内部, 扫描位)字符码 = 内码;
                    如果 (内码 ?= 34) { 扫描位 = 结束位; 中断; }
                    扫描位 + 1 = 扫描位;
                }
                (内部, 0, 结束位)子串 = 模块名;
                (模块名, 基础目录)查找模块 = 模块路径;
                (模块路径)长度 = 模块路径长;
                如果 (模块路径长 ?= 0) {
                    ("错误: 找不到模块 ")输出错误;
                    (模块名)打印;
                    "" = 结果;
                    中断;
                }
                (已导入表, 模块路径)在表 = 命中;
                如果 (命中 ?= 0) {
                    (正在导入表, 模块路径)在表 = 循环命中;
                    如果 (循环命中 ?= 1) {
                        ("错误: 检测到循环导入 ")输出错误;
                        (模块路径)打印;
                        "" = 结果;
                        中断;
                    }
                    (模块路径)取目录 = 子目录;
                    正在导入表 + 模块路径 + ":" + "\n" = 正在导入表;
                    (模块路径)读取文件 = 子源码;
                    (子源码)长度 = 子源码长;
                    如果 (子源码长 ?= 0) {
                        ("错误: 无法读取模块 ")输出错误;
                        (模块路径)打印;
                        "" = 结果;
                        中断;
                    }
                    已导入表 + 模块路径 + ":" + "\n" = 已导入表;
                    (子源码, 子目录)处理导入 = 子结果;
                    (子结果)长度 = 子结果长;
                    如果 (子结果长 ?= 0) {
                        ("错误: 导入子模块失败 ")输出错误;
                        (模块名)打印;
                        "" = 结果;
                        中断;
                    } 否则 {
                        结果 + 子结果 = 结果;
                    }
                }
            } 否则 { 结果 + 行 + "\n" = 结果; }
        } 否则 { 结果 + 行 + "\n" = 结果; }
        索引 + 1 = 索引;
    }
}

函数 主程序 {
    // 参数: (1)=输入路径 (2)=输出路径
    (1)获取参数 = 输入路径;
    (2)获取参数 = 输出路径;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        (输入路径)获取目录路径 = 输入目录;
        (源码, 输入目录)处理导入 = 源码;
        (源码)长度 = 长;
        如果 (长 ?= 0) {
            ("错误: 导入处理失败: ")输出错误;
            (输入路径)打印;
        } 否则 {
            "" = 生成代码;
            ()预计算转义;
            ()发射前导;
            ()第一遍;
            "" = 局部类型表;
            ()第二遍;
            ()发射字符串常量表;
            (闭包定义)发射;
            ()发射主程序入口;
            (输出路径, 生成代码)写入文件 = 结果;
        }
    }
}
