// ────────────────────────────────────────────
// 字符操作 (Character Operations)
// ────────────────────────────────────────────

函数 当前字符码(0 = 结果:整数) {
    (源码)长度 = 长;
    如果 (源位置 < 长) {
        (源码, 源位置)字符码 = 结果;
    } 否则 {
        0 - 1 = 结果;
    }
}

函数 下一个字符码(0 = 结果:整数) {
    (源码)长度 = 长;
    如果 (源位置 + 1 < 长) {
        (源码, 源位置 + 1)字符码 = 结果;
    } 否则 {
        0 - 1 = 结果;
    }
}

函数 前进 {
    (源码, 源位置)字符码 = 当前码;
    如果 (当前码 ?= 10) { 当前行号 + 1 = 当前行号; }
    源位置 + 1 = 源位置;
}

函数 (码:整数)判断空白(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) { 1 = 结果; }
}

函数 (码:整数)判断数字(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
}

函数 (码:整数)判断字母开始(0 = 结果:整数) {
    0 = 结果;
    如果 ((码 >= 65 && 码 <= 90) || (码 >= 97 && 码 <= 122) || 码 > 127) { 1 = 结果; }
}

函数 (码:整数)判断字母数字(0 = 结果:整数) {
    0 = 结果;
    如果 ((码 >= 65 && 码 <= 90) || (码 >= 97 && 码 <= 122) || (码 >= 48 && 码 <= 57) || 码 ?= 95 || 码 > 127) { 1 = 结果; }
}

// ────────────────────────────────────────────
// 词法分析 (Lexer)
// ────────────────────────────────────────────

函数 跳过空白注释 {
    (源码)长度 = 长;
    当 (源位置 < 长) {
        ()当前字符码 = 码;
        (码)判断空白 = 判断空白结果;
        如果 (判断空白结果 ?= 1) {
            ()前进;
        } 否则如果 (码 ?= 47) {
            ()下一个字符码 = 第二码;
            如果 (第二码 ?= 47) {
                // // 单行注释：跳到行尾
                当 (源位置 < 长) {
                    ()当前字符码 = 行内码;
                    如果 (行内码 ?= 10) { 中断; }
                    ()前进;
                }
            } 否则如果 (第二码 ?= 42) {
                // /* 块注释 */
                ()前进;
                ()前进;
                当 (源位置 < 长) {
                    ()当前字符码 = 块码;
                    ()下一个字符码 = 块下码;
                    如果 (块码 ?= 42 && 块下码 ?= 47) {
                        ()前进;
                        ()前进;
                        中断;
                    }
                    ()前进;
                }
            } 否则 {
                中断;
            }
        } 否则 {
            中断;
        }
    }
}

函数 下一个标记 {
    ()跳过空白注释;
    (源码)长度 = 长;
    如果 (源位置 >= 长) {
        0 = 标记类型;
        "" = 标记值;
    } 否则 {
        ()当前字符码 = 码;
        (码)判断数字 = 判断数字结果;
        如果 (判断数字结果 ?= 1) {
            // 数字（整数或浮点）
            1 = 标记类型;
            "" = 数字文本;
            当 (真) {
                ()当前字符码 = 当前码;
                (当前码)判断数字 = 判断数字结果;
                如果 (判断数字结果 ?= 1) {
                    (源码, 源位置, 1)子串 = 字;
                    数字文本 + 字 = 数字文本;
                    ()前进;
                } 否则 {
                    中断;
                }
            }
            // 浮点小数部分：当前为 '.' 且其后为数字时，标记为浮点(5) 并消费小数位
            ()当前字符码 = 当前码;
            如果 (当前码 ?= 46) {
                ()下一个字符码 = 小数首码;
                (小数首码)判断数字 = 小数判数;
                如果 (小数判数 ?= 1) {
                    5 = 标记类型;
                    数字文本 + "." = 数字文本;
                    ()前进;
                    当 (真) {
                        ()当前字符码 = 小数码;
                        (小数码)判断数字 = 小数判数2;
                        如果 (小数判数2 ?= 1) {
                            (源码, 源位置, 1)子串 = 小数字;
                            数字文本 + 小数字 = 数字文本;
                            ()前进;
                        } 否则 {
                            中断;
                        }
                    }
                }
            }
            数字文本 = 标记值;
        } 否则 {
            (码)判断字母开始 = 判断字母开始结果;
            如果 (判断字母开始结果 ?= 1) {
                // 标识符
                2 = 标记类型;
                "" = 标识文本;
                当 (真) {
                    ()当前字符码 = 当前码;
                    (当前码)判断字母数字 = 判断字母数字结果;
                    如果 (判断字母数字结果 ?= 1) {
                        (源码, 源位置, 1)子串 = 字;
                        标识文本 + 字 = 标识文本;
                        ()前进;
                    } 否则 {
                        中断;
                    }
                }
                标识文本 = 标记值;
            } 否则如果 (码 ?= 34) {
                // 字符串字面量
                3 = 标记类型;
                ()前进;
                "" = 字符串文本;
                当 (真) {
                    ()当前字符码 = 当前码;
                    如果 (当前码 ?= 34) {
                        ()前进;
                        中断;
                    } 否则如果 (当前码 ?= 92) {
                        // 转义字符
                        ()前进;
                        ()当前字符码 = 转义码;
                        如果 (转义码 ?= 110) { 字符串文本 + "\n" = 字符串文本; }
                        否则如果 (转义码 ?= 116) { 字符串文本 + "\t" = 字符串文本; }
                        否则 { (源码, 源位置, 1)子串 = 转义字; 字符串文本 + 转义字 = 字符串文本; }
                        ()前进;
                    } 否则 {
                        (源码, 源位置, 1)子串 = 字;
                        字符串文本 + 字 = 字符串文本;
                        ()前进;
                    }
                }
                字符串文本 = 标记值;
            } 否则 {
                // 运算符（含双字符）
                4 = 标记类型;
                (源码, 源位置, 1)子串 = 操作符;
                操作符 = 标记值;
                ()前进;
                ()当前字符码 = 第二码;
                如果 (操作符 ?= "=") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 62) { 标记值 + ">" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 43) { 标记值 + "+" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 45) { 标记值 + "-" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 42) { 标记值 + "*" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 47) { 标记值 + "/" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "!") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "<") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= ">") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "&") {
                    如果 (第二码 ?= 38) { 标记值 + "&" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "|") {
                    如果 (第二码 ?= 124) { 标记值 + "|" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "?") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "+") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "-") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "*") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "/") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                }
            }
        }
    }
}

// ────────────────────────────────────────────
// 语法工具 (Parse Helpers)
// ────────────────────────────────────────────

函数 是表达式结束(0 = 结果:整数) {
    0 = 结果;
    如果 (标记类型 ?= 4) {
        如果 (标记值 ?= ";" || 标记值 ?= "," || 标记值 ?= ")" || 标记值 ?= "]" || 标记值 ?= "}" || 标记值 ?= "{") { 1 = 结果; }
    }
}

// 跳过表达式（含嵌套括号/方括号/调用）
函数 跳过表达式 {
    0 = 括号深度;
    0 = 方括号深度;
    当 (真) {
        ()是表达式结束 = 是结束结果;
        如果 (是结束结果 ?= 1 && 括号深度 ?= 0 && 方括号深度 ?= 0) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "(") {
                括号深度 + 1 = 括号深度;
            } 否则如果 (标记值 ?= ")") {
                如果 (括号深度 > 0) { 括号深度 - 1 = 括号深度; }
            } 否则如果 (标记值 ?= "[") {
                方括号深度 + 1 = 方括号深度;
            } 否则如果 (标记值 ?= "]") {
                如果 (方括号深度 > 0) { 方括号深度 - 1 = 方括号深度; }
            }
        }
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
    }
}

// 跳过代码块 { ... }（不含开头 {）
函数 跳过代码块 {
    1 = 块深度;
    当 (真) {
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "{") {
                块深度 + 1 = 块深度;
            } 否则如果 (标记值 ?= "}") {
                如果 (块深度 > 0) { 块深度 - 1 = 块深度; }
                如果 (块深度 ?= 0) { 中断; }
            }
        }
    }
}

// 跳到语句末尾（分号后）
函数 跳到分号 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4 && 标记值 ?= ";") { ()下一个标记; 中断; }
        ()下一个标记;
    }
}

// ────────────────────────────────────────────
// 类型表 (Type Tables)
// ────────────────────────────────────────────

// 追加 名:类型码 到表中（\n 分隔），返回新表
函数 (表:字符串, 名:字符串, 类型码:字符串)表添加(0 = 结果:字符串) {
    如果 (表 ?= "") {
        表 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 类型码 = 结果;
    } 否则 {
        表 + "\n" = 结果;
        结果 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 类型码 = 结果;
    }
}

// 表替换：删除所有 名: 前缀行（精确匹配「名:」，避免 f 覆盖 f2），再以 表添加 的行格式追加 名:新值
函数 (表:字符串, 名:字符串, 新值:字符串)表替换(0 = 结果:字符串) {
    "" = 结果;
    0 = 索引;
    (表)分割行数 = 行数;
    当 (索引 < 行数) {
        (表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 0) {
            如果 (结果 ?= "") { 行 = 结果; }
            否则 { 结果 + "\n" = 结果; 结果 + 行 = 结果; }
        }
        索引 + 1 = 索引;
    }
    如果 (结果 ?= "") { 结果 + 名 = 结果; }
    否则 { 结果 + "\n" = 结果; 结果 + 名 = 结果; }
    结果 + ":" = 结果;
    结果 + 新值 = 结果;
    结果 + "\n" = 结果;
}

函数 (名:字符串, 类型码:字符串)局部表添加 {
    (局部类型表, 名, 类型码)表添加 = 局部类型表;
}

函数 (名:字符串, 类型码:字符串)全局表添加 {
    (全局类型表, 名, 类型码)表添加 = 全局类型表;
}

函数 (名:字符串, 类型码:字符串)函数返回表添加 {
    (函数返回表, 名, 类型码)表添加 = 函数返回表;
}

// 查类型：0=未知 1=整数 2=字符串 3=浮点
函数 (名:字符串)查类型(0 = 结果:整数) {
    0 = 命中全局表;
    0 = 结果;
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 1) {
            (名)长度 = 名长;
            (行, 名长 + 1, 1)子串 = 提取类型码;
            如果 (提取类型码 ?= "S") { 2 = 结果; }
            否则如果 (提取类型码 ?= "F") { 3 = 结果; }
            否则如果 (提取类型码 ?= "C") { 4 = 结果; }
            否则 { 1 = 结果; }
            索引 = 行数;
        } 否则 {
            索引 + 1 = 索引;
        }
    }
    如果 (结果 ?= 0) {
        0 = 索引;
        (全局类型表)分割行数 = 行数;
        当 (索引 < 行数) {
            (全局类型表, 索引)获取行 = 行;
             (行, 名 + ":")字符串开头 = 开头命中;
             如果 (开头命中 ?= 1) {
                (名)长度 = 名长;
                (行, 名长 + 1, 1)子串 = 提取类型码;
                如果 (提取类型码 ?= "S") { 2 = 结果; }
                否则如果 (提取类型码 ?= "F") { 3 = 结果; }
            否则如果 (提取类型码 ?= "C") { 4 = 结果; }
                否则 { 1 = 结果; }
                1 = 命中全局表;
                索引 = 行数;
            } 否则 {
                索引 + 1 = 索引;
            }
        }
    }
}

// 查函数返回类型：0=无 1=整数 2=字符串
函数 (名:字符串)查函数返回类型(0 = 结果:整数) {
    0 = 结果;
    0 = 索引;
    (函数返回表)分割行数 = 行数;
    当 (索引 < 行数) {
        (函数返回表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 1) {
            (名)长度 = 名长;
            (行, 名长 + 1, 1)子串 = 提取类型码;
            如果 (提取类型码 ?= "S") { 2 = 结果; }
            否则 { 1 = 结果; }
            索引 = 行数;
        } 否则 {
            索引 + 1 = 索引;
        }
    }
}

