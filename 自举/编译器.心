// 发射助手 (Emit Helpers)
// ────────────────────────────────────────────

函数 (生成文本:字符串)发射 {
    如果 (缓冲模式 ?= 1) {
        函数体C + 生成文本 = 函数体C;
        函数体C + "\n" = 函数体C;
    } 否则 {
        生成代码 + 生成文本 = 生成代码;
        生成代码 + "\n" = 生成代码;
    }
}

// 把字符串内容转成 IR c"..." 字面量（带引号；LLVM 需 \XX 十六进制转义，不支持 \n/\t/\"/\\）
函数 (内容:字符串)转义字符串(0 = 结果:字符串) {
    "" = 转义文本;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
