// S4.4a 单元测试：手工构造 `1 + 2 * 3` 的 AST，走 发射表达式，打印生成的 IR
导入 "编译器.心";
导入 "语法_树.心";

函数 主程序 {
    ()表初始化;
    ()语法树初始化;
    ("整数", "1")新叶 = 一;
    ("整数", "2")新叶 = 二;
    ("整数", "3")新叶 = 三;
    ("二元运算", "*", 二, 三)双节点 = 乘;
    ("二元运算", "+", 一, 乘)双节点 = 加;
    ()新建文本缓冲 = 生成代码;
    (加)发射表达式;
    (生成代码)文本缓冲取整体 = 生成代码文本;
    (生成代码文本)打印;
}
