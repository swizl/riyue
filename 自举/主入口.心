// ============================================
// 日月编译器 主入口
// 用法: 主入口.exe 输入.心 输出.ll
// 与 编译器.心 拆分，便于对发射层做单元测试（编译器.心 不再含 主程序）。
// ============================================

导入 "编译器.心";

函数 主程序 {
    ()表初始化;
    // 参数: (1)=输入路径 (2)=输出路径
    (1)获取参数 = 输入路径;
    (2)获取参数 = 输出路径;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        (输入路径)获取目录路径 = 输入目录;
        (源码, 输入目录)处理导入 = 源码;
        (源码)长度 = 长;
        如果 (长 ?= 0) {
            ("错误: 导入处理失败: ")输出错误;
            (输入路径)打印;
        } 否则 {
            ()库初始化;
            (源码)解析根 = 根;
            如果 (根 ?= -1) {
                ("错误: 解析失败: ")输出错误;
                (输入路径)打印;
            } 否则 {
                ()新建文本缓冲 = 生成代码;
                ()预计算转义;
                // 先按输出扩展名判定产物类型（须在发射前生效）：
                // 0=可执行  1=Windows 动态库(.dll)  2=ELF 共享库(.so)
                (输出路径)长度 = 出长;
                "" = 出后缀;
                0 = 是否动态库;
                如果 (出长 >= 4) {
                    (输出路径, 出长 - 4, 4)子串 = 出后缀4;
                    如果 (出后缀4 ?= ".dll") {
                        ".dll" = 出后缀;
                        1 = 是否动态库;
                    }
                }
                如果 (出后缀 ?= "") {
                    如果 (出长 >= 3) {
                        (输出路径, 出长 - 3, 3)子串 = 出后缀;
                        如果 (出后缀 ?= ".so") { 2 = 是否动态库; }
                    }
                }
                (根)发射程序;
                (映射_全局表)发射;
                ()发射字符串常量表;
                (闭包定义)发射;
                如果 (是否动态库 ?= 0) { ()发射主程序入口; }
                ()发射外部声明;
                如果 (出后缀 ?= ".ll") {
                    (生成代码)文本缓冲取整体 = 生成代码文本;
                    (输出路径, 生成代码文本)写入文件 = 结果;
                } 否则 {
                    // 非 .ll 输出：写临时 IR，再调用工具链链接出原生可执行文件
                    "" = 临时ll;
                    输出路径 + ".ll" = 临时ll;
                    "" = 临时bc;
                    输出路径 + ".bc" = 临时bc;
                    (生成代码)文本缓冲取整体 = 生成代码文本;
                    (临时ll, 生成代码文本)写入文件 = 结果;
                    // 工具链用绝对目录，避免依赖环境变量 PATH。
                    // 关键：clang++ 调用 ld 时，命令行里交给 ld 的非 ASCII（中文）路径
                    // 会被按本地代码页（GBK）曲解成乱码（ld: cannot open ... 乱码）。
                    // 因此凡是要交给 clang++/ld 的路径——运行时 .o、输入 .o、输出 exe
                    // ——一律改用纯 ASCII 临时名，再用 move 改名为（可能含中文的）目标
                    // 路径。%RANDOM% 在同一命令行里每次出现都会取到不同的值，不能重复
                    // 书写；故用 for 把它捕获一次，之后统一引用 %i。llvm-as/llc 不经过
                    // ld，可正确读写中文路径，故临时 .ll/.bc 仍放在输出路径旁。
                    "" = 链接前置;
                    链接前置 + "set \"PATH=D:\\src\\riyue\\llvm\\llvm-build\\bin;C:\\tools\\msys64\\mingw64\\bin;%PATH%\" && " = 链接前置;
                    链接前置 + "for /f %i in (\"%RANDOM%\") do " = 链接前置;
                    "" = 链接命令;
                    链接前置 + 链接命令 = 链接命令;
                    链接命令 + "copy /Y \"源\\运行时\\运行时辅助.o\" riyue_rt_%i.o >nul && llvm-as " = 链接命令;
                    链接命令 + 临时ll = 链接命令;
                    链接命令 + " -o " = 链接命令;
                    链接命令 + 临时bc = 链接命令;
                    如果 (是否动态库 ?= 1) {
                        // Windows DLL：clang++ -shared 直出 .dll。
                        // 动态库必须直接写到目标名：DLL 会把自身文件名内嵌为「导入名」，
                        // 若先建临时名再改名，调用方将按临时名去找 DLL 而失败。
                        链接命令 + " && llc -mtriple=x86_64-w64-windows-gnu -filetype=obj " = 链接命令;
                        链接命令 + 临时bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && clang++ -shared riyue_obj_%i.o riyue_rt_%i.o -o " = 链接命令;
                        链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                        链接命令 + " -lshell32 -lws2_32 -lm -lstdc++" = 链接命令;
                    } 否则如果 (是否动态库 ?= 2) {
                        // ELF 共享库：PIC 目标 + ld.lld --shared。宿主为 Windows，
                        // 运行时辅助.o 为 PE 目标、不能参与 ELF 链接，故此处仅链入本模块目标
                        // （同样直接写目标名，保证 DT_NEEDED 记录正确）
                        链接命令 + " && llc -mtriple=x86_64-unknown-linux-gnu -relocation-model=pic -filetype=obj " = 链接命令;
                        链接命令 + 临时bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && ld.lld -m elf_x86_64 --shared riyue_obj_%i.o -o " = 链接命令;
                        链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                    } 否则 {
                        链接命令 + " && llc -mtriple=x86_64-w64-windows-gnu -filetype=obj " = 链接命令;
                        链接命令 + 临时bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && clang++ riyue_obj_%i.o riyue_rt_%i.o -o riyue_out_%i.exe -lshell32 -lws2_32 -lm -lstdc++ && move /Y riyue_out_%i.exe " = 链接命令;
                        如果 (出后缀 ?= "exe") {
                            链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                        } 否则 {
                            链接命令 + "\"" + 输出路径 + ".exe\"" = 链接命令;
                        }
                    }
                    链接命令 + " && del riyue_rt_%i.o riyue_obj_%i.o" = 链接命令;
                    (链接命令)执行命令 = 链接结果;
                }
            }
        }
    }
}
