                    }
                    // 非 .ll 输出：写临时 IR，再调用工具链链接出原生可执行文件
                    "" = 临时ll;
                    输出路径 + ".ll" = 临时ll;
                    "" = 临时bc;
                    输出路径 + ".bc" = 临时bc;
