                        // （--allow-undefined），与 .so 的「不链运行时」策略一致。
                        链接命令 + " && llc" = 链接命令;
                        链接命令 + llc优化参数 = 链接命令;
                        链接命令 + " -mtriple=" = 链接命令;
                        链接命令 + 目标三元组 = 链接命令;
                        链接命令 + " -filetype=obj " = 链接命令;
                        链接命令 + 编译输入bc = 链接命令;
