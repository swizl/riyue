                            链接命令 + llc优化参数 = 链接命令;
                            链接命令 + " -mtriple=" = 链接命令;
                            链接命令 + 目标三元组 = 链接命令;
                            链接命令 + " -filetype=obj " = 链接命令;
                            链接命令 + 编译输入bc = 链接命令;
                            链接命令 + " -o riyue_obj_%i.o && clang --target=" = 链接命令;
                            链接命令 + 目标三元组 = 链接命令;
                            链接命令 + " -ffreestanding -nostdlibinc -O1 -c \"源/运行时/交叉运行时.c\" -o riyue_crt_%i.o && ld.lld -m arm64pe --dll --no-insert-timestamp riyue_crt_%i.o riyue_obj_%i.o -o " = 链接命令;
