// ============================================
// 日月编译器 主入口
// 用法: 主入口.exe 输入.心 输出.ll
// 与 编译器.心 拆分，便于对发射层做单元测试（编译器.心 不再含 主程序）。
// ============================================

导入 "编译器.心";

函数 主程序 {
    // 参数: (1)=输入路径 (2)=输出路径
    (1)获取参数 = 输入路径;
    (2)获取参数 = 输出路径;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        (输入路径)获取目录路径 = 输入目录;
        (源码, 输入目录)处理导入 = 源码;
        (源码)长度 = 长;
        如果 (长 ?= 0) {
            ("错误: 导入处理失败: ")输出错误;
            (输入路径)打印;
        } 否则 {
            ()库初始化;
            (源码)解析根 = 根;
            如果 (根 ?= -1) {
                ("错误: 解析失败: ")输出错误;
                (输入路径)打印;
            } 否则 {
                "" = 生成代码;
                ()预计算转义;
                ()发射前导;
                (根)发射程序;
                (映射_全局表)发射;
                ()发射字符串常量表;
                (闭包定义)发射;
                ()发射主程序入口;
                (输出路径)长度 = 出长;
                "" = 出后缀;
                如果 (出长 >= 3) {
                    (输出路径, 出长 - 3, 3)子串 = 出后缀;
                }
                如果 (出后缀 ?= ".ll") {
                    (输出路径, 生成代码)写入文件 = 结果;
                } 否则 {
                    // 非 .ll 输出：写临时 IR，再调用工具链链接出原生可执行文件
                    "" = 临时ll;
                    输出路径 + ".ll" = 临时ll;
                    "" = 临时bc;
                    输出路径 + ".bc" = 临时bc;
                    "" = 临时o;
                    输出路径 + ".o" = 临时o;
                    (临时ll, 生成代码)写入文件 = 结果;
                    // 工具链用绝对目录，避免依赖环境变量 PATH
                    "" = 链接前置;
                    链接前置 + "set \"PATH=D:\\src\\riyue\\llvm\\llvm-build\\bin;C:\\tools\\msys64\\mingw64\\bin;%PATH%\" && " = 链接前置;
                    "" = 链接命令;
                    链接前置 + 链接命令 = 链接命令;
                    链接命令 + "llvm-as " = 链接命令;
                    链接命令 + 临时ll = 链接命令;
                    链接命令 + " -o " = 链接命令;
                    链接命令 + 临时bc = 链接命令;
                    链接命令 + " && llc -mtriple=x86_64-w64-windows-gnu -filetype=obj " = 链接命令;
                    链接命令 + 临时bc = 链接命令;
                    链接命令 + " -o " = 链接命令;
                    链接命令 + 临时o = 链接命令;
                    链接命令 + " && clang++ " = 链接命令;
                    链接命令 + 临时o = 链接命令;
                    链接命令 + " 源/运行时/运行时辅助.o -o " = 链接命令;
                    链接命令 + 输出路径 = 链接命令;
                    链接命令 + " -lshell32 -lws2_32 -lm -lstdc++" = 链接命令;
                    (链接命令)执行命令 = 链接结果;
                }
            }
        }
    }
}
