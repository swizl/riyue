                        链接命令 + " && opt -O" = 链接命令;
                        链接命令 + 优化级文本 = 链接命令;
                        链接命令 + " " = 链接命令;
                        链接命令 + 临时bc = 链接命令;
                        链接命令 + " -o " = 链接命令;
                        链接命令 + 优化后bc = 链接命令;
                        优化后bc = 编译输入bc;
                        llc优化参数 + " -O" = llc优化参数;
                        llc优化参数 + 优化级文本 = llc优化参数;
