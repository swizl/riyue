// ============================================
// 日月编译器 主入口
// 用法: 主入口.exe 输入.心 输出.ll
// 与 编译器.心 拆分，便于对发射层做单元测试（编译器.心 不再含 主程序）。
// ============================================

导入 "编译器.心";

// 优化级别 → 传给 opt/llc 的 -O 文本：0→"0" 1→"1" 2→"2" 3→"3"；
// 4(Os) 亦映射为 "2"——本地化 LLVM 23 的 opt/llc 已移除 -Os（宿主链靠 optsize 属性做体积优化）。
函数 (级:整数)优化级别文本("" = 结果:字符串) {
    "2" = 结果;
    如果 (级 ?= 0) { "0" = 结果; }
    否则如果 (级 ?= 1) { "1" = 结果; }
    否则如果 (级 ?= 3) { "3" = 结果; }
}

// 级文本 → 级别：0..3 数字；"s"/"S"/"大小" → 4；其余回退 2
函数 (级文本:字符串)优化级别解析(2 = 结果:整数) {
    2 = 结果;
    如果 (级文本 ?= "0") { 0 = 结果; }
    否则如果 (级文本 ?= "1") { 1 = 结果; }
    否则如果 (级文本 ?= "2") { 2 = 结果; }
    否则如果 (级文本 ?= "3") { 3 = 结果; }
    否则如果 (级文本 ?= "s") { 4 = 结果; }
    否则如果 (级文本 ?= "S") { 4 = 结果; }
    否则如果 (级文本 ?= "大小") { 4 = 结果; }
}

// 文本是否含子串（1/0）。阶段5G：用于判定目标三元组是否属交叉链接子集。
// 注意：形参不能命名「子串」，否则会遮蔽内建 子串 函数，导致其调用报「变量不是闭包」。
函数 (文本:字符串, 目标串:字符串)含子串(0 = 结果:整数) {
    (文本)长度 = 文本长;
    (目标串)长度 = 目标串长;
    文本长 - 目标串长 + 1 = 扫描上限;
    0 = 序;
    当 (序 < 扫描上限) {
        (文本, 序, 目标串长)子串 = 扫描片段;
        如果 (扫描片段 ?= 目标串) {
            1 = 结果;
            序 = 扫描上限;
        }
        序 + 1 = 序;
    }
}

// 解析优化参数：--优化→2；--优化=级→解析；-O0..-O3/-Os→级别；非优化参数→-1
函数 (值:字符串)优化参数解析(0 = 结果:整数) {
    -1 = 结果;
    如果 (值 ?= "--优化") { 2 = 结果; }
    否则如果 (值 ?= "-O0") { 0 = 结果; }
    否则如果 (值 ?= "-O1") { 1 = 结果; }
    否则如果 (值 ?= "-O2") { 2 = 结果; }
    否则如果 (值 ?= "-O3") { 3 = 结果; }
    否则如果 (值 ?= "-Os") { 4 = 结果; }
    否则 {
        (值)长度 = 值长;
        如果 (值长 >= 5) {
            (值, 0, 5)子串 = 值前五;
            如果 (值前五 ?= "--优化=") {
                (值, 5, 值长 - 5)子串 = 级文本;
                (级文本)优化级别解析 = 结果;
            }
        }
    }
}

// 阶段9 G9-G：缓存淘汰接入编译流程（上限 128，回写成功后触发）。
// 口径与 标准库/编译缓存.心 的 9C 一致：非子目录项按文件名字典序保留前 `上限` 个，其余删除，
// 结果确定可复现；自举链不导入标准库，故此处自带最小实现。子目录一律跳过。
// 缓存名小于：甲 按字典序小于 乙 → 1/0（逐字符码比较，等前缀时短者更小）
// 注：入口只导入 编译器.心，标准库的 `字符串比较` 不可见，故此处自带。
函数 (甲:字符串, 乙:字符串)缓存名小于(0 = 结果:整数) {
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    0 = 短长;
    如果 (甲长 < 乙长) { 甲长 = 短长; } 否则 { 乙长 = 短长; }
    0 = 已判;
    0 = i;
    当 (i < 短长 && 已判 ?= 0) {
        (甲, i)字符码 = 甲码;
        (乙, i)字符码 = 乙码;
        如果 (甲码 < 乙码) {
            1 = 结果;
            1 = 已判;
        } 否则如果 (甲码 > 乙码) {
            1 = 已判;
        } 否则 {
            i + 1 = i;
        }
    }
    如果 (已判 ?= 0) {
        如果 (甲长 < 乙长) {
            1 = 结果;
        }
    }
}

// 缓存淘汰：返回删除个数
函数 (目录:字符串, 上限:整数)缓存淘汰(0 = 结果:整数) {
    0 = 结果;
    ()创建动态字符串数组 = 名表;
    0 = 文件数;
    (目录)列出目录 = 总数;
    0 = i;
    当 (i < 总数) {
        (i)获取目录项是否目录 = 是否目录;
        如果 (是否目录 ?= 0) {
            (i)获取目录项名称 = 名;
            (名表, 名)动态字符串数组添加;
            文件数 + 1 = 文件数;
        }
        i + 1 = i;
    }
    // 选择排序：文件数为上限量级，O(n²) 可接受
    0 = i;
    当 (i < 文件数) {
        i = 最小位;
        i + 1 = j;
        当 (j < 文件数) {
            (名表, j)动态字符串数组获取 = 名甲;
            (名表, 最小位)动态字符串数组获取 = 名乙;
            (名甲, 名乙)缓存名小于 = 较小;
            如果 (较小 ?= 1) {
                j = 最小位;
            }
            j + 1 = j;
        }
        如果 (最小位 != i) {
            (名表, i)动态字符串数组获取 = 名甲;
            (名表, 最小位)动态字符串数组获取 = 名乙;
            (名表, 最小位, 名甲)动态字符串数组设置;
            (名表, i, 名乙)动态字符串数组设置;
        }
        i + 1 = i;
    }
    0 = 保留数;
    如果 (上限 > 0) {
        如果 (上限 < 文件数) {
            上限 = 保留数;
        } 否则 {
            文件数 = 保留数;
        }
    }
    保留数 = i;
    当 (i < 文件数) {
        (名表, i)动态字符串数组获取 = 名;
        "" = 全路径;
        (全路径, 目录)拼接 = 全路径;
        (全路径, "/")拼接 = 全路径;
        (全路径, 名)拼接 = 全路径;
        (全路径)删除文件 = 删果;
        结果 + 1 = 结果;
        i + 1 = i;
    }
}

函数 主程序 {
    ()表初始化;
    // 参数解析：--调试 置调试模式；其余按序取前两个为 输入路径/输出路径。
    // 索引 0 为程序名（宿主与自举同构），故从 1 开始。
    0 = 参数数;
    ()获取参数数量 = 参数数;
    1 = 参数i;
    "" = 输入路径;
    "" = 输出路径;
    "" = 目标覆盖;
    0 = 已见输入;
    // 阶段9 G9-B：增量编译缓存（--缓存 开启；默认关闭，保证自举不动点与回归流程不变）
    // 阶段9 G9-D：同一开关下，宿主 .exe 目标另有链接产物级缓存（命中即复制，跳过编译与链接）
    0 = 缓存模式;
    "" = 缓存目录;
    "" = 缓存文件;
    当 (参数i < 参数数) {
        (参数i)获取参数 = 参数值;
        (参数值)优化参数解析 = 优化候选;
        如果 (优化候选 >= 0) {
            优化候选 = 优化级别;
        } 否则如果 (参数值 ?= "--调试") {
            1 = 调试模式;
        } 否则如果 (参数值 ?= "--发布") {
            1 = 发布模式;
        } 否则如果 (参数值 ?= "--缓存") {
            1 = 缓存模式;
        } 否则 {
            // 阶段5A：--目标=<三元组>（前缀匹配 "--目标="，共 5 个字符）
            (参数值)长度 = 参数长;
            0 = 是目标参数;
            如果 (参数长 >= 5) {
                (参数值, 0, 5)子串 = 参数前缀;
                如果 (参数前缀 ?= "--目标=") { 1 = 是目标参数; }
            }
            如果 (是目标参数 ?= 1) {
                (参数值, 5, 参数长 - 5)子串 = 目标覆盖;
            } 否则如果 (已见输入 ?= 0) {
                参数值 = 输入路径;
                1 = 已见输入;
            } 否则 {
                参数值 = 输出路径;
            }
        }
        参数i + 1 = 参数i;
    }
    输入路径 = 源文件名;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        (输入路径)获取目录路径 = 输入目录;
        (源码, 输入目录)处理导入 = 源码;
        (源码)长度 = 长;
        如果 (长 ?= 0) {
            ("错误: 导入处理失败: ")输出错误;
            (输入路径)打印;
        } 否则 {
            // 产物扩展名判定提前到解析之前：编译缓存只对 .ll 目标生效。
            // 0=可执行  1=Windows 动态库(.dll)  2=ELF 共享库(.so)  3=WebAssembly 模块(.wasm)
            (输出路径)长度 = 出长;
            "" = 出后缀;
            0 = 是否动态库;
            // 阶段5F：.wasm（5 字符后缀）
            如果 (出长 >= 5) {
                (输出路径, 出长 - 5, 5)子串 = 出后缀5;
                如果 (出后缀5 ?= ".wasm") {
                    ".wasm" = 出后缀;
                    3 = 是否动态库;
                }
            }
            如果 (出长 >= 4) {
                (输出路径, 出长 - 4, 4)子串 = 出后缀4;
                如果 (出后缀4 ?= ".dll") {
                    ".dll" = 出后缀;
                    1 = 是否动态库;
                }
            }
            如果 (出后缀 ?= "") {
                如果 (出长 >= 3) {
                    (输出路径, 出长 - 3, 3)子串 = 出后缀;
                    如果 (出后缀 ?= ".so") { 2 = 是否动态库; }
                }
            }
            // 阶段5A：解析生效目标三元组（默认按产物类型；--目标= 覆盖）
            "" = 目标三元组;
            如果 (是否动态库 ?= 2) { "x86_64-unknown-linux-gnu" = 目标三元组; }
            否则如果 (是否动态库 ?= 3) { "wasm32-unknown-unknown" = 目标三元组; }
            否则 { "x86_64-w64-windows-gnu" = 目标三元组; }
            如果 (目标覆盖 ?= "") { } 否则 { 目标覆盖 = 目标三元组; }
            // 阶段9 G9-B：--缓存 且目标为 .ll 时先查缓存（IR 文本级）。
            // 阶段9 G9-D：--缓存 且宿主 .exe 时也查产物缓存（链接产物级），命中即复制、跳过编译与链接。
            // 键 = 简单哈希(源码 | 源码长度 | 优化级别 | 调试模式 | 发布模式 | 目标三元组 | 输出路径)
            //     + 格式版本前缀；凡是会改变产物内容的开关都必须进键。
            // 输出路径入键：opt 会把「输入文件名」写进 `; 模块标识`，故不同产物路径的 IR 不共享。
            // 缓存目录 = 输出目录/.日月编译缓存，产物按「键.ll」/「键.exe」落盘。
            // 编译器自身实现或运行时 .o 变更会改变产物，须递增格式版本前缀或清理缓存目录。
            "" = 缓存产物后缀;
            "" = 缓存键前缀;
            "" = 缓存产物路径;
            如果 (出后缀 ?= ".ll") {
                ".ll" = 缓存产物后缀;
                "日月IR缓存1|" = 缓存键前缀;
                输出路径 = 缓存产物路径;
            } 否则如果 (是否动态库 ?= 0) {
                // 仅宿主 x86_64 可执行文件走产物级缓存（交叉目标在下方边界检查处直接报错）
                (目标三元组)长度 = 产物目标长;
                0 = 产物宿主目标;
                如果 (产物目标长 >= 6) {
                    (目标三元组, 0, 6)子串 = 产物目标前六;
                    如果 (产物目标前六 ?= "x86_64") { 1 = 产物宿主目标; }
                }
                如果 (产物宿主目标 ?= 1) {
                    ".exe" = 缓存产物后缀;
                    "日月产物缓存1|" = 缓存键前缀;
                    如果 (出后缀 ?= "exe") { 输出路径 = 缓存产物路径; }
                    否则 { 输出路径 + ".exe" = 缓存产物路径; }
                }
            }
            如果 (缓存模式 ?= 1) {
                如果 (缓存产物后缀 ?= "") { } 否则 {
                    0 = 缓存命中;
                    (源码)简单哈希 = 源码哈希;
                    (源码哈希)转字符串 = 源码哈希文本;
                    (长)转字符串 = 源码长文本;
                    (优化级别)转字符串 = 缓存优化文本;
                    (调试模式)转字符串 = 缓存调试文本;
                    (发布模式)转字符串 = 缓存发布文本;
                    "" = 缓存签名;
                    缓存签名 + 缓存键前缀 = 缓存签名;
                    缓存签名 + 源码哈希文本 = 缓存签名;
                    缓存签名 + "|" = 缓存签名;
                    缓存签名 + 源码长文本 = 缓存签名;
                    缓存签名 + "|" = 缓存签名;
                    缓存签名 + 缓存优化文本 = 缓存签名;
                    缓存签名 + "|" = 缓存签名;
                    缓存签名 + 缓存调试文本 = 缓存签名;
                    缓存签名 + "|" = 缓存签名;
                    缓存签名 + 缓存发布文本 = 缓存签名;
                    缓存签名 + "|" = 缓存签名;
                    缓存签名 + 目标三元组 = 缓存签名;
                    缓存签名 + "|" = 缓存签名;
                    缓存签名 + 输出路径 = 缓存签名;
                    (缓存签名)简单哈希 = 缓存键;
                    (缓存键)转字符串 = 缓存键文本;
                    (输出路径)获取目录路径 = 缓存根;
                    如果 (缓存根 ?= "") { "." = 缓存根; }
                    缓存目录 + 缓存根 = 缓存目录;
                    缓存目录 + "/.日月编译缓存" = 缓存目录;
                    0 = 缓存已建;
                    (缓存目录)目录存在 = 缓存已建;
                    如果 (缓存已建 ?= 0) { (缓存目录)创建目录 = 缓存建结果; }
                    缓存文件 + 缓存目录 = 缓存文件;
                    缓存文件 + "/" = 缓存文件;
                    缓存文件 + 缓存键文本 = 缓存文件;
                    缓存文件 + 缓存产物后缀 = 缓存文件;
                    (缓存文件)文件存在 = 缓存命中;
                    如果 (缓存命中 ?= 1) {
                        // 产物可能是二进制（.exe），必须按字节复制，不能走字符串读写
                        (缓存文件, 缓存产物路径)复制文件 = 缓存复制结果;
                        如果 (缓存复制结果 ?= 0) {
                            ("编译缓存: 命中 ")输出错误;
                            (缓存文件)打印;
                            (0)退出进程;
                        }
                    }
                }
            }
            ()库初始化;
            (源码)解析根 = 根;
            如果 (根 ?= -1) {
                ("错误: 解析失败: ")输出错误;
                (输入路径)打印;
            } 否则 {
                ()新建文本缓冲 = 生成代码;
                ()预计算转义;
                // 阶段5A 的目标三元组已在解析前（缓存判定处）解析生效
                如果 (调试模式 ?= 1) { ()初始化调试元数据; }
                (根)发射程序;
                (映射_全局表)发射;
                ()发射字符串常量表;
                ()发射字符串结构常量表;
                (闭包定义)发射;
                如果 (是否动态库 ?= 0) { ()发射主程序入口; }
                ()发射外部声明;
                如果 (调试模式 ?= 1) { ()发射调试元数据表; }
                如果 (未声明出错 ?= 1) {
                    ("错误: 编译中止：存在未声明的标识符")输出错误;
                } 否则如果 (出后缀 ?= ".ll") {
                    (生成代码)文本缓冲取整体 = 生成代码文本;
                    如果 (优化级别 > 0) {
                        // 中端优化：原始 IR 先写临时文件，opt -O{N} 后覆盖为优化 IR
                        输出路径 + ".raw.ll" = 临时raw;
                        (临时raw, 生成代码文本)写入文件 = 结果;
                        (优化级别)优化级别文本 = 优化级文本;
                        "" = 优化命令;
                        优化命令 + "set \"PATH=D:\\src\\riyue\\llvm\\llvm-build\\bin;C:\\tools\\msys64\\mingw64\\bin;%PATH%\" && opt -O" = 优化命令;
                        优化命令 + 优化级文本 = 优化命令;
                        优化命令 + " -S \"" = 优化命令;
                        优化命令 + 临时raw = 优化命令;
                        优化命令 + "\" -o \"" = 优化命令;
                        优化命令 + 输出路径 = 优化命令;
                        优化命令 + "\"" = 优化命令;
                        (优化命令)执行命令 = 结果;
                    } 否则 {
                        (输出路径, 生成代码文本)写入文件 = 结果;
                    }
                    // 阶段9 G9-B：编译成功后回写缓存（仅 --缓存 且 .ll 目标）
                    如果 (缓存模式 ?= 1) {
                        (输出路径)读取文件 = 缓存产物;
                        (缓存产物)长度 = 缓存产物长;
                        如果 (缓存产物长 > 0) {
                            (缓存文件, 缓存产物)写入文件 = 缓存回写结果;
                            // 阶段9 G9-G：回写后按上限淘汰旧缓存（删除失败不影响本次编译）
                            (缓存目录, 128)缓存淘汰 = 隐淘汰数;
                            如果 (隐淘汰数 > 0) {
                                (隐淘汰数)转字符串 = 隐淘汰文本;
                                ("编译缓存: 淘汰 ", 隐淘汰文本)拼接 = 隐淘汰消息;
                                (隐淘汰消息)输出错误;
                            }
                        }
                    }
                } 否则 {
                    // 阶段5G：交叉链接子集——aarch64 Linux 静态可执行文件 与
                    // aarch64 Windows 动态库（ARM64 PE）。二者仅需 llc + ld.lld 与
                    // 无 libc 的「交叉运行时」即可产出，不依赖目标 sysroot。
                    0 = 交叉可执行;
                    0 = 交叉动态库;
                    如果 (是否动态库 ?= 0) {
                        (目标三元组, "aarch64")含子串 = 甲为甲64;
                        如果 (甲为甲64 ?= 1) {
                            (目标三元组, "linux")含子串 = 甲为Linux;
                            如果 (甲为Linux ?= 1) { 1 = 交叉可执行; }
                        }
                    }
                    如果 (是否动态库 ?= 1) {
                        (目标三元组, "aarch64")含子串 = 乙为甲64;
                        如果 (乙为甲64 ?= 1) {
                            (目标三元组, "windows")含子串 = 乙为Windows;
                            如果 (乙为Windows ?= 1) { 1 = 交叉动态库; }
                        }
                    }
                    // 阶段5F：其余交叉 exe/dll 仍只诊断——Windows 可执行文件需要目标平台的
                    // crt 与 libc，本工具链仅提供宿主 x86_64 的这两者。
                    如果 (是否动态库 ?= 0 || 是否动态库 ?= 1) {
                        (目标三元组)长度 = 边界长;
                        0 = 是宿主目标;
