                            如果 (交叉可执行 ?= 1 || 交叉动态库 ?= 1) { } 否则 {
                                "错误: 交叉目标 " + 目标三元组 = 边界消息;
                                边界消息 + " 不支持该产物（缺目标 crt 与 libc）；支持 .so / .wasm / aarch64-linux 可执行文件 / aarch64-windows 动态库" = 边界消息;
                                (边界消息)输出错误;
