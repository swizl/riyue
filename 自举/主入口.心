// ============================================
// 日月编译器 主入口
// 用法: 主入口.exe 输入.心 输出.ll
// 与 编译器.心 拆分，便于对发射层做单元测试（编译器.心 不再含 主程序）。
// ============================================

导入 "编译器.心";

// 优化级别 → 传给 opt/llc 的 -O 文本：0→"0" 1→"1" 2→"2" 3→"3"；
// 4(Os) 亦映射为 "2"——本地化 LLVM 23 的 opt/llc 已移除 -Os（宿主链靠 optsize 属性做体积优化）。
函数 (级:整数)优化级别文本("" = 结果:字符串) {
    "2" = 结果;
    如果 (级 ?= 0) { "0" = 结果; }
    否则如果 (级 ?= 1) { "1" = 结果; }
    否则如果 (级 ?= 3) { "3" = 结果; }
}

// 级文本 → 级别：0..3 数字；"s"/"S"/"大小" → 4；其余回退 2
函数 (级文本:字符串)优化级别解析(2 = 结果:整数) {
    2 = 结果;
    如果 (级文本 ?= "0") { 0 = 结果; }
    否则如果 (级文本 ?= "1") { 1 = 结果; }
    否则如果 (级文本 ?= "2") { 2 = 结果; }
    否则如果 (级文本 ?= "3") { 3 = 结果; }
    否则如果 (级文本 ?= "s") { 4 = 结果; }
    否则如果 (级文本 ?= "S") { 4 = 结果; }
    否则如果 (级文本 ?= "大小") { 4 = 结果; }
}

// 解析优化参数：--优化→2；--优化=级→解析；-O0..-O3/-Os→级别；非优化参数→-1
函数 (值:字符串)优化参数解析(0 = 结果:整数) {
    -1 = 结果;
    如果 (值 ?= "--优化") { 2 = 结果; }
    否则如果 (值 ?= "-O0") { 0 = 结果; }
    否则如果 (值 ?= "-O1") { 1 = 结果; }
    否则如果 (值 ?= "-O2") { 2 = 结果; }
    否则如果 (值 ?= "-O3") { 3 = 结果; }
    否则如果 (值 ?= "-Os") { 4 = 结果; }
    否则 {
        (值)长度 = 值长;
        如果 (值长 >= 5) {
            (值, 0, 5)子串 = 值前五;
            如果 (值前五 ?= "--优化=") {
                (值, 5, 值长 - 5)子串 = 级文本;
                (级文本)优化级别解析 = 结果;
            }
        }
    }
}

函数 主程序 {
    ()表初始化;
    // 参数解析：--调试 置调试模式；其余按序取前两个为 输入路径/输出路径。
    // 索引 0 为程序名（宿主与自举同构），故从 1 开始。
    0 = 参数数;
    ()获取参数数量 = 参数数;
    1 = 参数i;
    "" = 输入路径;
    "" = 输出路径;
    "" = 目标覆盖;
    0 = 已见输入;
    当 (参数i < 参数数) {
        (参数i)获取参数 = 参数值;
        (参数值)优化参数解析 = 优化候选;
        如果 (优化候选 >= 0) {
            优化候选 = 优化级别;
        } 否则如果 (参数值 ?= "--调试") {
            1 = 调试模式;
        } 否则如果 (参数值 ?= "--发布") {
            1 = 发布模式;
        } 否则 {
            // 阶段5A：--目标=<三元组>（前缀匹配 "--目标="，共 5 个字符）
            (参数值)长度 = 参数长;
            0 = 是目标参数;
            如果 (参数长 >= 5) {
                (参数值, 0, 5)子串 = 参数前缀;
                如果 (参数前缀 ?= "--目标=") { 1 = 是目标参数; }
            }
            如果 (是目标参数 ?= 1) {
                (参数值, 5, 参数长 - 5)子串 = 目标覆盖;
            } 否则如果 (已见输入 ?= 0) {
                参数值 = 输入路径;
                1 = 已见输入;
            } 否则 {
                参数值 = 输出路径;
            }
        }
        参数i + 1 = 参数i;
    }
    输入路径 = 源文件名;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        (输入路径)获取目录路径 = 输入目录;
        (源码, 输入目录)处理导入 = 源码;
        (源码)长度 = 长;
        如果 (长 ?= 0) {
            ("错误: 导入处理失败: ")输出错误;
            (输入路径)打印;
        } 否则 {
            ()库初始化;
            (源码)解析根 = 根;
            如果 (根 ?= -1) {
                ("错误: 解析失败: ")输出错误;
                (输入路径)打印;
            } 否则 {
                ()新建文本缓冲 = 生成代码;
                ()预计算转义;
                // 先按输出扩展名判定产物类型（须在发射前生效）：
                // 0=可执行  1=Windows 动态库(.dll)  2=ELF 共享库(.so)
                (输出路径)长度 = 出长;
                "" = 出后缀;
                0 = 是否动态库;
                如果 (出长 >= 4) {
                    (输出路径, 出长 - 4, 4)子串 = 出后缀4;
                    如果 (出后缀4 ?= ".dll") {
                        ".dll" = 出后缀;
                        1 = 是否动态库;
                    }
                }
                如果 (出后缀 ?= "") {
                    如果 (出长 >= 3) {
                        (输出路径, 出长 - 3, 3)子串 = 出后缀;
                        如果 (出后缀 ?= ".so") { 2 = 是否动态库; }
                    }
                }
                // 阶段5A：解析生效目标三元组（默认按产物类型；--目标= 覆盖）
                "" = 目标三元组;
                如果 (是否动态库 ?= 2) { "x86_64-unknown-linux-gnu" = 目标三元组; }
                否则 { "x86_64-w64-windows-gnu" = 目标三元组; }
                如果 (目标覆盖 ?= "") { } 否则 { 目标覆盖 = 目标三元组; }
                如果 (调试模式 ?= 1) { ()初始化调试元数据; }
                (根)发射程序;
                (映射_全局表)发射;
                ()发射字符串常量表;
                ()发射字符串结构常量表;
                (闭包定义)发射;
                如果 (是否动态库 ?= 0) { ()发射主程序入口; }
                ()发射外部声明;
                如果 (调试模式 ?= 1) { ()发射调试元数据表; }
                如果 (未声明出错 ?= 1) {
                    ("错误: 编译中止：存在未声明的标识符")输出错误;
                } 否则如果 (出后缀 ?= ".ll") {
                    (生成代码)文本缓冲取整体 = 生成代码文本;
                    如果 (优化级别 > 0) {
                        // 中端优化：原始 IR 先写临时文件，opt -O{N} 后覆盖为优化 IR
                        输出路径 + ".raw.ll" = 临时raw;
                        (临时raw, 生成代码文本)写入文件 = 结果;
                        (优化级别)优化级别文本 = 优化级文本;
                        "" = 优化命令;
                        优化命令 + "set \"PATH=D:\\src\\riyue\\llvm\\llvm-build\\bin;C:\\tools\\msys64\\mingw64\\bin;%PATH%\" && opt -O" = 优化命令;
                        优化命令 + 优化级文本 = 优化命令;
                        优化命令 + " -S \"" = 优化命令;
                        优化命令 + 临时raw = 优化命令;
                        优化命令 + "\" -o \"" = 优化命令;
                        优化命令 + 输出路径 = 优化命令;
                        优化命令 + "\"" = 优化命令;
                        (优化命令)执行命令 = 结果;
                    } 否则 {
                        (输出路径, 生成代码文本)写入文件 = 结果;
                    }
                } 否则 {
                    // 非 .ll 输出：写临时 IR，再调用工具链链接出原生可执行文件
                    "" = 临时ll;
                    输出路径 + ".ll" = 临时ll;
                    "" = 临时bc;
                    输出路径 + ".bc" = 临时bc;
                    (生成代码)文本缓冲取整体 = 生成代码文本;
                    (临时ll, 生成代码文本)写入文件 = 结果;
                    // 工具链用绝对目录，避免依赖环境变量 PATH。
                    // 链接层一律用本地化 LLVM 的 lld（ld.lld）：可执行文件走
                    // `ld.lld -m i386pep` + crt2.o，Windows 动态库走 `-m i386pep --dll`
                    // + dllcrt2.o，不再依赖 clang++ 驱动；crt 与库列表手工复刻（见下方）。
                    // 关键：交给链接器的非 ASCII（中文）路径会被按本地代码页（GBK）曲解
                    // 成乱码（ld: cannot open ... 乱码）。因此凡是要交给链接器的路径——
                    // 运行时 .o、输入 .o、输出 exe——一律改用纯 ASCII 临时名，再用 move
                    // 改名为（可能含中文的）目标路径。%RANDOM% 在同一命令行里每次出现都会
                    // 取到不同的值，不能重复书写；故用 for 把它捕获一次，之后统一引用 %i。
                    // llvm-as/llc 不经过链接器，可正确读写中文路径，故临时 .ll/.bc 仍放在
                    // 输出路径旁。
                    "" = 链接前置;
                    链接前置 + "set \"PATH=D:\\src\\riyue\\llvm\\llvm-build\\bin;C:\\tools\\msys64\\mingw64\\bin;%PATH%\" && " = 链接前置;
                    链接前置 + "for /f %i in (\"%RANDOM%\") do " = 链接前置;
                    "" = 链接命令;
                    链接前置 + 链接命令 = 链接命令;
                    链接命令 + "copy /Y \"源\\运行时\\运行时辅助.o\" riyue_rt_%i.o >nul && llvm-as " = 链接命令;
                    链接命令 + 临时ll = 链接命令;
                    链接命令 + " -o " = 链接命令;
                    链接命令 + 临时bc = 链接命令;
                    // 中端优化前置：优化级别>0 时在 llvm-as 之后、llc 之前插入 opt -O{N}
                    临时bc = 编译输入bc;
                    "" = llc优化参数;
                    如果 (优化级别 > 0) {
                        输出路径 + ".opt.bc" = 优化后bc;
                        (优化级别)优化级别文本 = 优化级文本;
                        链接命令 + " && opt -O" = 链接命令;
                        链接命令 + 优化级文本 = 链接命令;
                        链接命令 + " " = 链接命令;
                        链接命令 + 临时bc = 链接命令;
                        链接命令 + " -o " = 链接命令;
                        链接命令 + 优化后bc = 链接命令;
                        优化后bc = 编译输入bc;
                        llc优化参数 + " -O" = llc优化参数;
                        llc优化参数 + 优化级文本 = llc优化参数;
                    }
                    // 阶段5C：按目标三元组选择 ld.lld 仿真器（交叉共享库链接）。
                    // 目标三元组以 "aarch64"（7 字符）开头 → aarch64linux；否则 elf_x86_64（默认不变）。
                    "elf_x86_64" = 链接仿真;
                    (目标三元组)长度 = 目标长;
                    如果 (目标长 >= 7) {
                        (目标三元组, 0, 7)子串 = 目标前七;
                        如果 (目标前七 ?= "aarch64") { "aarch64linux" = 链接仿真; }
                    }
                    如果 (是否动态库 ?= 1) {
                        // Windows DLL：ld.lld -m i386pep --dll 直出 .dll（dllexport 符号
                        // 由目标文件的 .drectve 自动导出）。
                        // 动态库必须直接写到目标名：DLL 会把自身文件名内嵌为「导入名」，
                        // 若先建临时名再改名，调用方将按临时名去找 DLL 而失败。
                        链接命令 + " && llc" = 链接命令;
                        链接命令 + llc优化参数 = 链接命令;
                        链接命令 + " -mtriple=" = 链接命令;
                        链接命令 + 目标三元组 = 链接命令;
                        链接命令 + " -filetype=obj " = 链接命令;
                        链接命令 + 编译输入bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && ld.lld -m i386pep --dll C:/tools/msys64/mingw64/lib/dllcrt2.o riyue_obj_%i.o riyue_rt_%i.o -o " = 链接命令;
                        链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                        链接命令 + " -LC:/tools/msys64/mingw64/lib -LC:/tools/msys64/mingw64/lib/gcc/x86_64-w64-mingw32/16.1.0 -lmingw32 -lmingwex -lmsvcrt -lgcc -lmoldname -lws2_32 -lm -ladvapi32 -lshell32 -luser32 -lkernel32" = 链接命令;
                    } 否则如果 (是否动态库 ?= 2) {
                        // ELF 共享库：PIC 目标 + ld.lld --shared。宿主为 Windows，
                        // 运行时辅助.o 为 PE 目标、不能参与 ELF 链接，故此处仅链入本模块目标
                        // （同样直接写目标名，保证 DT_NEEDED 记录正确）
                        链接命令 + " && llc" = 链接命令;
                        链接命令 + llc优化参数 = 链接命令;
                        链接命令 + " -mtriple=" = 链接命令;
                        链接命令 + 目标三元组 = 链接命令;
                        链接命令 + " -relocation-model=pic -filetype=obj " = 链接命令;
                        链接命令 + 编译输入bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && ld.lld -m " = 链接命令;
                        链接命令 + 链接仿真 = 链接命令;
                        链接命令 + " --shared riyue_obj_%i.o -o " = 链接命令;
                        链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                    } 否则 {
                        链接命令 + " && llc" = 链接命令;
                        链接命令 + llc优化参数 = 链接命令;
                        链接命令 + " -mtriple=" = 链接命令;
                        链接命令 + 目标三元组 = 链接命令;
                        链接命令 + " -filetype=obj " = 链接命令;
                        链接命令 + 编译输入bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && ld.lld -m i386pep C:/tools/msys64/mingw64/lib/crt2.o riyue_obj_%i.o riyue_rt_%i.o -o riyue_out_%i.exe -LC:/tools/msys64/mingw64/lib -LC:/tools/msys64/mingw64/lib/gcc/x86_64-w64-mingw32/16.1.0 -lmingw32 -lmingwex -lmsvcrt -lgcc -lmoldname -lws2_32 -lm -ladvapi32 -lshell32 -luser32 -lkernel32 && move /Y riyue_out_%i.exe " = 链接命令;
                        如果 (出后缀 ?= "exe") {
                            链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                        } 否则 {
                            链接命令 + "\"" + 输出路径 + ".exe\"" = 链接命令;
                        }
                    }
                    链接命令 + " && del riyue_rt_%i.o riyue_obj_%i.o" = 链接命令;
                    (链接命令)执行命令 = 链接结果;
                }
            }
        }
    }
}
