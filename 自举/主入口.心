// ============================================
// 日月编译器 主入口
// 用法: 主入口.exe 输入.心 输出.ll
// 与 编译器.心 拆分，便于对发射层做单元测试（编译器.心 不再含 主程序）。
// ============================================

导入 "编译器.心";

函数 主程序 {
    // 参数: (1)=输入路径 (2)=输出路径
    (1)获取参数 = 输入路径;
    (2)获取参数 = 输出路径;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        (输入路径)获取目录路径 = 输入目录;
        (源码, 输入目录)处理导入 = 源码;
        (源码)长度 = 长;
        如果 (长 ?= 0) {
            ("错误: 导入处理失败: ")输出错误;
            (输入路径)打印;
        } 否则 {
            "" = 生成代码;
            ()预计算转义;
            ()发射前导;
            ()第一遍;
            "" = 局部类型表;
            ()第二遍;
            (映射_全局表)发射;
            ()发射字符串常量表;
            (闭包定义)发射;
            ()发射主程序入口;
            (输出路径, 生成代码)写入文件 = 结果;
        }
    }
}
