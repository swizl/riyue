                        // 若先建临时名再改名，调用方将按临时名去找 DLL 而失败。
                        链接命令 + " && llc" = 链接命令;
                        链接命令 + llc优化参数 = 链接命令;
                        链接命令 + " -mtriple=" = 链接命令;
                        链接命令 + 目标三元组 = 链接命令;
                        链接命令 + " -filetype=obj " = 链接命令;
                        链接命令 + 编译输入bc = 链接命令;
                        链接命令 + " -o riyue_obj_%i.o && ld.lld -m i386pep --dll C:/tools/msys64/mingw64/lib/dllcrt2.o riyue_obj_%i.o riyue_rt_%i.o -o " = 链接命令;
                        链接命令 + "\"" + 输出路径 + "\"" = 链接命令;
                        链接命令 + " -LC:/tools/msys64/mingw64/lib -LC:/tools/msys64/mingw64/lib/gcc/x86_64-w64-mingw32/16.1.0 -lmingw32 -lmingwex -lmsvcrt -lgcc -lmoldname -lws2_32 -lm -ladvapi32 -lshell32 -luser32 -lkernel32" = 链接命令;
                        }
                    } 否则如果 (是否动态库 ?= 2) {
                        // ELF 共享库：PIC 目标 + ld.lld --shared。宿主为 Windows，
                        // 运行时辅助.o 为 PE 目标、不能参与 ELF 链接，故此处仅链入本模块目标
                        // （同样直接写目标名，保证 DT_NEEDED 记录正确）
                        链接命令 + " && llc" = 链接命令;
                        链接命令 + llc优化参数 = 链接命令;
                        链接命令 + " -mtriple=" = 链接命令;
                        链接命令 + 目标三元组 = 链接命令;
                        链接命令 + " -relocation-model=pic -filetype=obj " = 链接命令;
