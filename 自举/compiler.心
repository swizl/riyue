// 集中发射字符串常量表（@N = 私有 未命名地址 常量 ...）
函数 发射字符串常量表 {
    0 = 索引;
    (字符串表)分割行数 = 行数;
    当 (索引 < 行数) {
        (字符串表, 索引)获取行 = 行;
        (行)表还原 = 内容;
        (内容)长度 = 字符数;
        (内容, 字符数)字符位置到字节位置 = 字节数;
        字节数 + 1 = 字节数;
        (内容)转义字符串 = 内容C;
        (内容C)长度 = C长;
        (内容C, 0, C长 - 1)子串 = 去尾;
        去尾 + "\\00\"" = 内容C;
        ("@" + (索引)转字符串 + " = 私有 未命名地址 常量 [" + (字节数)转字符串 + " x i8] c" + 内容C + ", align 1")发射;
        索引 + 1 = 索引;
    }
}

