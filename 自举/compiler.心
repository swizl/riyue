// 语句解析 (Statement Parser)
// ────────────────────────────────────────────

// 解析并发射函数体（直到 } 为止，不消费 }）
函数 发射函数体 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "}") { 中断; }
        ()解析并发射语句;
    }
}

// 解析并发射一条语句
函数 解析并发射语句 {
    如果 (标记值 ?= "如果") {
        ()发射如果链;
    } 否则如果 (标记值 ?= "当") {
        ()下一个标记;   // 当
        ()下一个标记;   // (
        ()解析表达式;
        ()下一个标记;   // )
        ("while ( " + 表达式C + " ) {")发射;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则如果 (标记值 ?= "循环") {
        // 范围循环: 循环 (变量: 开始, 结束[, 步长])
        ()下一个标记;   // 循环
        ()下一个标记;   // (
        标记值 = 循环变量;
        ()下一个标记;   // :
        ()下一个标记;   // 开始
        ()解析表达式;
        表达式C = 循环开始C;
        ()下一个标记;   // ,
        ()解析表达式;
        表达式C = 循环结束C;
        如果 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            表达式C = 循环步长C;
            ()下一个标记;   // )
        } 否则 {
            "1" = 循环步长C;
            ()下一个标记;   // )
        }
        ("for ( int " + 循环变量 + " = " + 循环开始C + "; " + 循环变量 + " < " + 循环结束C + "; " + 循环变量 + " = " + 循环变量 + " + " + 循环步长C + " ) {")发射;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则如果 (标记值 ?= "返回") {
        ()下一个标记;
        如果 (标记值 ?= ";") {
            ("return;")发射;
        } 否则 {
            ()解析表达式;
            ("return " + 表达式C + ";")发射;
        }
        ()下一个标记;   // ;
    } 否则如果 (标记值 ?= "中断") {
        ("break;")发射;
        ()下一个标记;   // ;
        ()下一个标记;   // } 或下一语句
    } 否则如果 (标记值 ?= "继续") {
        ("continue;")发射;
        ()下一个标记;   // ;
        ()下一个标记;   // } 或下一语句
    } 否则如果 (标记值 ?= "{") {
        ("{")发射;
        ()下一个标记;
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则 {
        ()解析表达式;
        ()发射表达式语句;
    }
}

// 表达式语句：赋值（值在左，目标在右）或调用语句
函数 发射表达式语句 {
    如果 (标记值 ?= "=") {
        ()下一个标记;
        如果 (标记类型 ?= 2) {
            标记值 = 目标名;
            ()下一个标记;
            (目标名 + " = " + 表达式C + ";")发射;
            ()下一个标记;   // ;
            // 类型记录
            (目标名)查类型 = 类型码;
            如果 (类型码 ?= 0) {
                如果 (表达式类型 ?= "字符串") { (目标名, "S")局部表添加; }
                否则如果 (表达式类型 ?= "浮点") { (目标名, "F")局部表添加; }
                否则 { (目标名, "I")局部表添加; }
            }
        } 否则 {
            (表达式C + ";")发射;
            ()下一个标记;   // ;
        }
    } 否则如果 (标记值 ?= "+=" || 标记值 ?= "-=" || 标记值 ?= "*=" || 标记值 ?= "/=") {
        标记值 = 操作符;
        ()下一个标记;
        如果 (标记类型 ?= 2) {
            标记值 = 目标名;
            ()下一个标记;
            (目标名 + " " + 操作符 + " " + 表达式C + ";")发射;
            ()下一个标记;   // ;
        } 否则 {
            (表达式C + ";")发射;
            ()下一个标记;   // ;
        }
    } 否则 {
        (表达式C + ";")发射;
        ()下一个标记;   // ;
    }
}

// 发射 if / else if / else 链
函数 发射如果链 {
    0 = 是否否则如果;
    如果 (标记值 ?= "否则如果") { 1 = 是否否则如果; }
    否则 { 0 = 是否否则如果; }
    ()下一个标记;   // 如果/否则如果
    ()下一个标记;   // (
    ()解析表达式;
    ()下一个标记;   // )
    如果 (是否否则如果 ?= 1) {
        ("} else if ( " + 表达式C + " ) {")发射;
    } 否则 {
        ("if ( " + 表达式C + " ) {")发射;
    }
    ()下一个标记;   // {
    ()发射函数体;
    ()下一个标记;   // }
    如果 (标记值 ?= "否则如果") {
        ()发射如果链;
    } 否则如果 (标记值 ?= "否则") {
        ()下一个标记;   // 否则
        ("} else {")发射;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则 {
        ("}")发射;
    }
}

