函数 是表达式结束(0 = 结果:整数) {
    0 = 结果;
    如果 (标记类型 ?= 4) {
        如果 (标记值 ?= ";" || 标记值 ?= "," || 标记值 ?= ")" || 标记值 ?= "]" || 标记值 ?= "}" || 标记值 ?= "{") { 1 = 结果; }
    }
}

// 跳过表达式（含嵌套括号/方括号/调用）
函数 跳过表达式 {
    0 = 括号深度;
    0 = 方括号深度;
    当 (真) {
        ()是表达式结束 = 是结束结果;
        如果 (是结束结果 ?= 1 && 括号深度 ?= 0 && 方括号深度 ?= 0) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "(") {
                括号深度 + 1 = 括号深度;
            } 否则如果 (标记值 ?= ")") {
                如果 (括号深度 > 0) { 括号深度 - 1 = 括号深度; }
            } 否则如果 (标记值 ?= "[") {
                方括号深度 + 1 = 方括号深度;
            } 否则如果 (标记值 ?= "]") {
                如果 (方括号深度 > 0) { 方括号深度 - 1 = 方括号深度; }
            }
        }
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
    }
}

// 跳过代码块 { ... }（不含开头 {）
函数 跳过代码块 {
    1 = 块深度;
    当 (真) {
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "{") {
                块深度 + 1 = 块深度;
            } 否则如果 (标记值 ?= "}") {
                如果 (块深度 > 0) { 块深度 - 1 = 块深度; }
                如果 (块深度 ?= 0) { 中断; }
            }
        }
    }
}

// 跳到语句末尾（分号后）
函数 跳到分号 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4 && 标记值 ?= ";") { ()下一个标记; 中断; }
        ()下一个标记;
    }
}

