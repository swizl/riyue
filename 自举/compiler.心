// 字节 → \HH（大写十六进制）
函数 (码:整数)字节转义(0 = 结果:字符串) {
    "0123456789ABCDEF" = 十六进制表;
    (十六进制表, 码 / 16, 1)子串 = 高字;
    (十六进制表, 码 % 16, 1)子串 = 低字;
    "\\" + 高字 = 结果;
    结果 + 低字 = 结果;
}

// 码点 → UTF-8 字节转义串（纯加减乘除/取余，日月语言无位运算）
函数 (码:整数)转UTF8字节转义(0 = 结果:字符串) {
    "" = 结果;
    如果 (码 < 128) {
        (码)字节转义 = 结果;
    } 否则如果 (码 < 2048) {
        (192 + (码 / 64))字节转义 = 字节0文本;
        (128 + (码 % 64))字节转义 = 字节1文本;
        字节0文本 + 字节1文本 = 结果;
    } 否则如果 (码 < 65536) {
        (224 + (码 / 4096))字节转义 = 字节0文本;
        (128 + ((码 / 64) % 64))字节转义 = 字节1文本;
        (128 + (码 % 64))字节转义 = 字节2文本;
        字节0文本 + 字节1文本 = 字节0_1;
        字节0_1 + 字节2文本 = 结果;
    } 否则 {
        (240 + (码 / 262144))字节转义 = 字节0文本;
        (128 + ((码 / 4096) % 64))字节转义 = 字节1文本;
        (128 + ((码 / 64) % 64))字节转义 = 字节2文本;
        (128 + (码 % 64))字节转义 = 字节3文本;
        字节0文本 + 字节1文本 = 字节0_1;
        字节0_1 + 字节2文本 = 字节0_1_2;
        字节0_1_2 + 字节3文本 = 结果;
    }
}

