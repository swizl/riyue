函数 (生成文本:字符串)发射 {
    如果 (缓冲模式 ?= 1) {
        函数体C + 生成文本 = 函数体C;
        函数体C + "\n" = 函数体C;
    } 否则 {
        生成代码 + 生成文本 = 生成代码;
        生成代码 + "\n" = 生成代码;
    }
}

// 把字符串内容转成 C 字符串字面量（带引号与转义）
函数 (内容:字符串)转义字符串(0 = 结果:字符串) {
    "" = 转义文本;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 34) { 转义文本 + "\\\"" = 转义文本; }
        否则如果 (码 ?= 92) { 转义文本 + "\\\\" = 转义文本; }
        否则如果 (码 ?= 10) { 转义文本 + "\\n" = 转义文本; }
        否则如果 (码 ?= 9) { 转义文本 + "\\t" = 转义文本; }
        否则 {
            (内容, 索引, 1)子串 = 字;
            转义文本 + 字 = 转义文本;
        }
        索引 + 1 = 索引;
    }
    "\"" + 转义文本 + "\"" = 结果;
}

