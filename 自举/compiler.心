        } 否则 {
            // 用户函数
            函数名 + "( " + 参数文本 + " )" = 表达式C;
            (函数名)查函数返回类型 = 类型码;
            如果 (类型码 ?= 2) { "字符串" = 表达式类型; }
            否则 { "整数" = 表达式类型; }
        }
    } 否则 {
        // 分组
        "( " + 参数文本 + " )" = 表达式C;
    }
}

