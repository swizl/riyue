    0 = 命中全局表;
    0 = 结果;
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 1) {
            (名)长度 = 名长;
            (行, 名长 + 1, 1)子串 = 提取类型码;
            如果 (提取类型码 ?= "S") { 2 = 结果; }
            否则如果 (提取类型码 ?= "F") { 3 = 结果; }
            否则 { 1 = 结果; }
            索引 = 行数;
        } 否则 {
            索引 + 1 = 索引;
        }
    }
    如果 (结果 ?= 0) {
        0 = 索引;
        (全局类型表)分割行数 = 行数;
        当 (索引 < 行数) {
            (全局类型表, 索引)获取行 = 行;
             (行, 名 + ":")字符串开头 = 开头命中;
             如果 (开头命中 ?= 1) {
                (名)长度 = 名长;
                (行, 名长 + 1, 1)子串 = 提取类型码;
                如果 (提取类型码 ?= "S") { 2 = 结果; }
                否则如果 (提取类型码 ?= "F") { 3 = 结果; }
                否则 { 1 = 结果; }
                1 = 命中全局表;
                索引 = 行数;
