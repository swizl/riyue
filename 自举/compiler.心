// 把字符串内容转成 IR c"..." 字面量（带引号；LLVM 需 \XX 十六进制转义，不支持 \n/\t/\"/\\）
函数 (内容:字符串)转义字符串(0 = 结果:字符串) {
    "" = 转义文本;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 34) { (码)字节转义 = 转义字节; 转义文本 + 转义字节 = 转义文本; }
        否则如果 (码 ?= 92) { (码)字节转义 = 转义字节; 转义文本 + 转义字节 = 转义文本; }
        否则如果 (码 < 32) { (码)字节转义 = 转义字节; 转义文本 + 转义字节 = 转义文本; }
        否则如果 (码 >= 128) {
            (码)转UTF8字节转义 = 转义字节;
            转义文本 + 转义字节 = 转义文本;
        } 否则 {
            (内容, 索引, 1)子串 = 字;
            转义文本 + 字 = 转义文本;
        }
        索引 + 1 = 索引;
    }
    "\"" + 转义文本 + "\"" = 结果;
}

