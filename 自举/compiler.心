// 追加 名:类型码 到表中（\n 分隔），返回新表
函数 (表:字符串, 名:字符串, 类型码:字符串)表添加(0 = 结果:字符串) {
    如果 (表 ?= "") {
        表 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 类型码 = 结果;
    } 否则 {
        表 + "\n" = 结果;
        结果 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 类型码 = 结果;
    }
}

函数 (名:字符串, 类型码:字符串)局部表添加 {
