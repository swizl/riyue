// 字符串表行转义（\n → "\\n"、\t → "\\t"、\ → "\\\\"）
函数 (内容:字符串)表转义(0 = 结果:字符串) {
    "" = 结果;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 10) { 结果 + "\\n" = 结果; }
        否则如果 (码 ?= 9) { 结果 + "\\t" = 结果; }
        否则如果 (码 ?= 92) { 结果 + "\\\\" = 结果; }
        否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
        索引 + 1 = 索引;
    }
}

// 字符串表行还原（"\\n" → 换行、"\\t" → 制表、"\\\\" → \）
函数 (内容:字符串)表还原(0 = 结果:字符串) {
    "" = 结果;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 92) {
            如果 (索引 + 1 < 值长) {
                (内容, 索引 + 1)字符码 = 下码;
                如果 (下码 ?= 110) { 结果 + "\n" = 结果; 索引 + 1 = 索引; }
                否则如果 (下码 ?= 116) { 结果 + "\t" = 结果; 索引 + 1 = 索引; }
                否则如果 (下码 ?= 92) { 结果 + "\\" = 结果; 索引 + 1 = 索引; }
                否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
            } 否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
        } 否则 {
            (内容, 索引, 1)子串 = 字;
            结果 + 字 = 结果;
        }
        索引 + 1 = 索引;
    }
}

// 字符串字面量入表，返回 @N
函数 (内容:字符串)存字符串常量(0 = 结果:字符串) {
    (内容)表转义 = 转义内容;
    字符串表 + 转义内容 = 字符串表;
    字符串表 + "\n" = 字符串表;
    "@" + (字符串计数)转字符串 = 结果;
    字符串计数 + 1 = 字符串计数;
}

// 新临时寄存器 %tmpN
函数 新寄存器(0 = 结果:字符串) {
    寄存器计数 + 1 = 寄存器计数;
    "%tmp" + (寄存器计数)转字符串 = 结果;
}

// 新标签 L1 / L2 / ...
函数 新标签(0 = 结果:字符串) {
    标签计数 + 1 = 标签计数;
    "L" + (标签计数)转字符串 = 结果;
}

// 退出标签栈
函数 (标签:字符串)压退出栈 {
    退出标签栈 + 标签 = 退出标签栈;
    退出标签栈 + "\n" = 退出标签栈;
}

函数 弹退出栈 {
    (退出标签栈)分割行数 = 行数;
    如果 (行数 ?= 0 || 行数 ?= 1) {
        "" = 退出标签栈;
    } 否则 {
        "" = 新栈;
        0 = 索引;
        当 (索引 < 行数 - 1) {
            (退出标签栈, 索引)获取行 = 行;
            新栈 + 行 = 新栈;
            新栈 + "\n" = 新栈;
            索引 + 1 = 索引;
        }
        新栈 = 退出标签栈;
    }
}

函数 查退出栈(0 = 结果:字符串) {
    (退出标签栈)分割行数 = 行数;
    如果 (行数 ?= 0) { "" = 结果; }
    否则 { (退出标签栈, 行数 - 1)获取行 = 结果; }
}

// 继续标签栈
函数 (标签:字符串)压继续栈 {
    继续标签栈 + 标签 = 继续标签栈;
    继续标签栈 + "\n" = 继续标签栈;
}

函数 弹继续栈 {
    (继续标签栈)分割行数 = 行数;
    如果 (行数 ?= 0 || 行数 ?= 1) {
        "" = 继续标签栈;
    } 否则 {
        "" = 新栈;
        0 = 索引;
        当 (索引 < 行数 - 1) {
            (继续标签栈, 索引)获取行 = 行;
            新栈 + 行 = 新栈;
            新栈 + "\n" = 新栈;
            索引 + 1 = 索引;
        }
        新栈 = 继续标签栈;
    }
}

函数 查继续栈(0 = 结果:字符串) {
    (继续标签栈)分割行数 = 行数;
    如果 (行数 ?= 0) { "" = 结果; }
    否则 { (继续标签栈, 行数 - 1)获取行 = 结果; }
}

// 类型名 → IR 类型
函数 (类型:字符串)类型转IR(0 = 结果:字符串) {
    如果 (类型 ?= "字符串") { "ptr" = 结果; }
    否则如果 (类型 ?= "浮点") { "double" = 结果; }
    否则 { "i32" = 结果; }
}

// 从 "名:码" 行提取名字
函数 (行:字符串)提取行名(0 = 结果:字符串) {
    "" = 结果;
    (行)长度 = 行长;
    0 = 位置;
    当 (位置 < 行长) {
        (行, 位置, 1)子串 = 字;
        如果 (字 ?= ":") { 位置 = 行长; }
        否则 { 结果 + 字 = 结果; 位置 + 1 = 位置; }
    }
}

// 从 "名:码" 行提取类型码
函数 (行:字符串)提取行码(0 = 结果:字符串) {
    (行)长度 = 行长;
    0 = 位置;
    "" = 结果;
    当 (位置 < 行长) {
        (行, 位置, 1)子串 = 字;
        如果 (字 ?= ":") {
            (行, 位置 + 1, 1)子串 = 结果;
            位置 = 行长;
        } 否则 { 位置 + 1 = 位置; }
    }
}

// 全局→@"名"，局部→%"名"（调用 查类型，副作用置 命中全局表）
函数 (名:字符串)取地址(0 = 结果:字符串) {
    (名)查类型 = 类型码;
    (名)转义标识符 = 转义;
    如果 (命中全局表 ?= 1) { "@" + 转义 = 结果; }
    否则 { "%" + 转义 = 结果; }
}

// ────────────────────────────────────────────
// 表达式解析 (Expression Parser)
// 结果写入 表达式C/表达式类型
// ────────────────────────────────────────────

函数 解析表达式 {
    ()解析或;
}

函数 解析或 {
     ()解析与;
     当 (标记值 ?= "||") {
         表达式C = 左或;
         表达式类型 = 左或类型;
         ()下一个标记;
         ()解析与;
         表达式C = 右或;
         表达式类型 = 右或类型;
         ()新寄存器 = 左布尔;
         ("  " + 左布尔 + " = 整数比较 ne i32 " + 左或 + ", 0")发射;
         ()新寄存器 = 右布尔;
         ("  " + 右布尔 + " = 整数比较 ne i32 " + 右或 + ", 0")发射;
         ()新寄存器 = 或结果;
         ("  " + 或结果 + " = 或 i1 " + 左布尔 + ", " + 右布尔)发射;
         ()新寄存器 = 表达式C;
         ("  " + 表达式C + " = 零扩展 i1 " + 或结果 + " to i32")发射;
         "整数" = 表达式类型;
     }
}

函数 解析与 {
     ()解析比较;
     当 (标记值 ?= "&&") {
         表达式C = 左与;
         表达式类型 = 左与类型;
         ()下一个标记;
         ()解析比较;
         表达式C = 右与;
         表达式类型 = 右与类型;
         ()新寄存器 = 左布尔;
         ("  " + 左布尔 + " = 整数比较 ne i32 " + 左与 + ", 0")发射;
         ()新寄存器 = 右布尔;
         ("  " + 右布尔 + " = 整数比较 ne i32 " + 右与 + ", 0")发射;
         ()新寄存器 = 与结果;
         ("  " + 与结果 + " = 与 i1 " + 左布尔 + ", " + 右布尔)发射;
         ()新寄存器 = 表达式C;
         ("  " + 表达式C + " = 零扩展 i1 " + 与结果 + " to i32")发射;
         "整数" = 表达式类型;
     }
}

函数 解析比较 {
     ()解析加减;
     当 (标记值 ?= ">" || 标记值 ?= "<" || 标记值 ?= ">=" || 标记值 ?= "<=" || 标记值 ?= "==" || 标记值 ?= "!=" || 标记值 ?= "?=") {
         标记值 = 操作符;
         表达式C = 左比;
         表达式类型 = 左比类型;
         ()下一个标记;
         ()解析加减;
         表达式C = 右比;
         表达式类型 = 右比类型;
         如果 (左比类型 ?= "字符串" || 右比类型 ?= "字符串") {
             ()新寄存器 = 调用临时;
             ("  " + 调用临时 + " = 调用 i32 (ptr, ptr) @strcmp(ptr " + 左比 + ", ptr " + 右比 + ")")发射;
             ()新寄存器 = 比较临时;
             如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 调用临时 + ", 0")发射; }
             否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 调用临时 + ", 0")发射; }
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
             "整数" = 表达式类型;
         } 否则如果 (左比类型 ?= "浮点" || 右比类型 ?= "浮点") {
             ()新寄存器 = 比较临时;
             如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 浮点比较 oeq double " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 浮点比较 une double " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 浮点比较 ogt double " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 浮点比较 olt double " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 浮点比较 oge double " + 左比 + ", " + 右比)发射; }
             否则 { ("  " + 比较临时 + " = 浮点比较 ole double " + 左比 + ", " + 右比)发射; }
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
             "整数" = 表达式类型;
         } 否则 {
             ()新寄存器 = 比较临时;
             如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 左比 + ", " + 右比)发射; }
             否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 左比 + ", " + 右比)发射; }
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
             "整数" = 表达式类型;
         }
     }
}

函数 解析加减 {
     ()解析乘除;
     当 (标记值 ?= "+" || 标记值 ?= "-") {
         标记值 = 操作符;
         表达式C = 左加;
         表达式类型 = 左加类型;
         ()下一个标记;
         ()解析乘除;
         表达式C = 右加;
         表达式类型 = 右加类型;
         如果 (操作符 ?= "+" && (左加类型 ?= "字符串" || 右加类型 ?= "字符串")) {
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + ("辅助拼接")转义标识符 + "(ptr " + 左加 + ", ptr " + 右加 + ")")发射;
             "字符串" = 表达式类型;
         } 否则如果 (左加类型 ?= "浮点" || 右加类型 ?= "浮点") {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "+") { ("  " + 表达式C + " = 浮点加 double " + 左加 + ", " + 右加)发射; }
             否则 { ("  " + 表达式C + " = 浮点减 double " + 左加 + ", " + 右加)发射; }
             "浮点" = 表达式类型;
         } 否则 {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "+") { ("  " + 表达式C + " = 加 i32 " + 左加 + ", " + 右加)发射; }
             否则 { ("  " + 表达式C + " = 减 i32 " + 左加 + ", " + 右加)发射; }
             "整数" = 表达式类型;
         }
     }
}

函数 解析乘除 {
     ()解析一元;
     当 (标记值 ?= "*" || 标记值 ?= "/" || 标记值 ?= "%") {
         标记值 = 操作符;
         表达式C = 左乘;
         表达式类型 = 左乘类型;
         ()下一个标记;
         ()解析一元;
         表达式C = 右乘;
         表达式类型 = 右乘类型;
         如果 (左乘类型 ?= "浮点" || 右乘类型 ?= "浮点") {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "*") { ("  " + 表达式C + " = 浮点乘 double " + 左乘 + ", " + 右乘)发射; }
             否则 { ("  " + 表达式C + " = 浮点除 double " + 左乘 + ", " + 右乘)发射; }
             "浮点" = 表达式类型;
         } 否则 {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "*") { ("  " + 表达式C + " = 乘 i32 " + 左乘 + ", " + 右乘)发射; }
             否则如果 (操作符 ?= "/") { ("  " + 表达式C + " = 有符号除 i32 " + 左乘 + ", " + 右乘)发射; }
             否则 { ("  " + 表达式C + " = 有符号取余 i32 " + 左乘 + ", " + 右乘)发射; }
             "整数" = 表达式类型;
         }
     }
}

函数 解析一元 {
    如果 (标记类型 ?= 4 && 标记值 ?= "-") {
        ()下一个标记;
        ()解析一元;
        表达式C = 一元操作数;
        表达式类型 = 一元类型;
        如果 (一元类型 ?= "浮点") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 浮点减 double 0.000000e+00, " + 一元操作数)发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 0, " + 一元操作数)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (标记类型 ?= 4 && 标记值 ?= "!") {
        ()下一个标记;
        ()解析一元;
        表达式C = 一元操作数;
        ()新寄存器 = 比较临时;
        ("  " + 比较临时 + " = 整数比较 eq i32 " + 一元操作数 + ", 0")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    } 否则 {
        ()解析原子;
    }
}

函数 解析原子 {
    如果 (标记类型 ?= 1) {
        // 数字字面量
        标记值 = 表达式C;
        "整数" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 3) {
        // 字符串字面量
        (标记值)存字符串常量 = 表达式C;
        "字符串" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 2) {
        // 标识符
        标记值 = 标识名;
        如果 (标识名 ?= "真") {
            "1" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则如果 (标识名 ?= "假") {
            "0" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则 {
            (标识名)查类型 = 类型码;
            如果 (类型码 ?= 0) {
                "0" = 表达式C;
                "整数" = 表达式类型;
                ()下一个标记;
            } 否则 {
                (标识名)转义标识符 = 转义;
                如果 (命中全局表 ?= 1) { "@" + 转义 = 地址; }
                否则 { "%" + 转义 = 地址; }
                ()新寄存器 = 表达式C;
                如果 (类型码 ?= 2) {
                    ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
                    "字符串" = 表达式类型;
                } 否则如果 (类型码 ?= 3) {
                    ("  " + 表达式C + " = 加载 double, ptr " + 地址 + ", align 8")发射;
                    "浮点" = 表达式类型;
                } 否则 {
                    ("  " + 表达式C + " = 加载 i32, ptr " + 地址 + ", align 4")发射;
                    "整数" = 表达式类型;
                }
                ()下一个标记;
            }
        }
    } 否则如果 (标记值 ?= "(") {
        ()解析括号或调用;
    } 否则 {
        // 未知：空表达式
        "0" = 表达式C;
        "整数" = 表达式类型;
    }
}

// 解析 ( ... ) 可能是分组或前缀调用
函数 解析括号或调用 {
    ()下一个标记;   // 消费 "("
    如果 (标记值 ?= ")") {
        0 = 参数计数;
        "" = 参数文本;
        "" = 参数类型IR;
        "" = 参数前缀文本;
    } 否则 {
        ()解析表达式;
        表达式C = 参数文本;
        表达式类型 = 参数0类型;
        (表达式类型)类型转IR = 参数类型IR;
        参数类型IR + " " = 参数前缀文本;
        参数前缀文本 + 表达式C = 参数前缀文本;
        1 = 参数计数;
        当 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            参数文本 + ", " = 参数文本;
            参数文本 + 表达式C = 参数文本;
            (表达式类型)类型转IR = 参数单类型;
            参数类型IR + ", " = 参数类型IR;
            参数类型IR + 参数单类型 = 参数类型IR;
            参数前缀文本 + ", " = 参数前缀文本;
            参数前缀文本 + 参数单类型 = 参数前缀文本;
            参数前缀文本 + " " = 参数前缀文本;
            参数前缀文本 + 表达式C = 参数前缀文本;
            参数计数 + 1 = 参数计数;
        }
    }
    ()下一个标记;   // 消费 ")"
    如果 (标记类型 ?= 2) {
        标记值 = 函数名;
        ()下一个标记;
        如果 (函数名 ?= "打印") {
            如果 (参数计数 ?= 0) {
                ("\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ")")发射;
            } 否则如果 (参数0类型 ?= "字符串") {
                ("%s\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ", " + 参数前缀文本 + ")")发射;
            } 否则 {
                ("%d\n")存字符串常量 = 格式号;
                ("调用 void (ptr, ...) @printf(ptr " + 格式号 + ", " + 参数前缀文本 + ")")发射;
            }
            "" = 表达式C;
            "空" = 表达式类型;
        } 否则如果 (函数名 ?= "长度") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr) @" + 转义_获取字符数 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "字符码") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, i32) @" + 转义_字符码 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "子串") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, i32, i32) @" + ("辅助子串")转义标识符 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "转字符串") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (i32) @" + ("辅助转字符串")转义标识符 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "拼接") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + ("辅助拼接")转义标识符 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "读取文件") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr) @" + 转义_读取文件 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "写入文件") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, ptr) @" + 转义_写入文件 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "获取参数") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (i32) @" + 转义_获取参数 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "获取参数数量") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 () @" + 转义_获取参数数量 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "输出错误") {
            ("调用 void (ptr) @" + 转义_输出错误 + "(" + 参数前缀文本 + ")")发射;
            "" = 表达式C;
            "空" = 表达式类型;
        } 否则如果 (函数名 ?= "字符串开头") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr, ptr) @" + 转义_字符串开头 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "分割行数") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 i32 (ptr) @" + 转义_分割行数 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "获取行") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 ptr (ptr, i32) @" + 转义_获取行 + "(" + 参数前缀文本 + ")")发射;
            "字符串" = 表达式类型;
        } 否则 {
            (函数名)查函数返回类型 = 类型码;
            (函数名)转义标识符 = 函数转义;
            如果 (类型码 ?= 2) {
                ()新寄存器 = 表达式C;
                ("  " + 表达式C + " = 调用 ptr (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
                "字符串" = 表达式类型;
            } 否则如果 (类型码 ?= 1) {
                ()新寄存器 = 表达式C;
                ("  " + 表达式C + " = 调用 i32 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
                "整数" = 表达式类型;
            } 否则 {
                ("调用 void (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
                "" = 表达式C;
                "空" = 表达式类型;
            }
        }
    } 否则 {
        // 分组
        表达式C = 参数文本;
    }
}

// ────────────────────────────────────────────
// 语句解析 (Statement Parser)
// ────────────────────────────────────────────

// 解析并发射函数体（直到 } 为止，不消费 }）
函数 发射函数体 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "}") { 中断; }
        ()解析并发射语句;
    }
}

// 解析并发射一条语句
函数 解析并发射语句 {
    如果 (标记值 ?= "如果") {
        ()发射如果链;
    } 否则如果 (标记值 ?= "当") {
        ()下一个标记;   // 当
        ()下一个标记;   // (
        ()解析表达式;
        ()下一个标记;   // )
        ("while ( " + 表达式C + " ) {")发射;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则如果 (标记值 ?= "循环") {
        // 范围循环: 循环 (变量: 开始, 结束[, 步长])
        ()下一个标记;   // 循环
        ()下一个标记;   // (
        标记值 = 循环变量;
        ()下一个标记;   // :
        ()下一个标记;   // 开始
        ()解析表达式;
        表达式C = 循环开始C;
        ()下一个标记;   // ,
        ()解析表达式;
        表达式C = 循环结束C;
        如果 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            表达式C = 循环步长C;
            ()下一个标记;   // )
        } 否则 {
            "1" = 循环步长C;
            ()下一个标记;   // )
        }
        ("for ( int " + 循环变量 + " = " + 循环开始C + "; " + 循环变量 + " < " + 循环结束C + "; " + 循环变量 + " = " + 循环变量 + " + " + 循环步长C + " ) {")发射;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则如果 (标记值 ?= "返回") {
        ()下一个标记;
        如果 (标记值 ?= ";") {
            ("返回 void")发射;
        } 否则 {
            ()解析表达式;
            如果 (表达式类型 ?= "字符串") { ("返回 ptr " + 表达式C)发射; }
            否则如果 (表达式类型 ?= "浮点") { ("返回 double " + 表达式C)发射; }
            否则 { ("返回 i32 " + 表达式C)发射; }
        }
        ()下一个标记;   // ;
    } 否则如果 (标记值 ?= "中断") {
        ("break;")发射;
        ()下一个标记;   // ;
        ()下一个标记;   // } 或下一语句
    } 否则如果 (标记值 ?= "继续") {
        ("continue;")发射;
        ()下一个标记;   // ;
        ()下一个标记;   // } 或下一语句
    } 否则如果 (标记值 ?= "{") {
        ("{")发射;
        ()下一个标记;
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则 {
        ()解析表达式;
        ()发射表达式语句;
    }
}

// 表达式语句：赋值（值在左，目标在右）或调用语句
函数 发射表达式语句 {
    如果 (标记值 ?= "=") {
        ()下一个标记;
        如果 (标记类型 ?= 2) {
            标记值 = 目标名;
            ()下一个标记;
            (目标名)查类型 = 类型码;
            如果 (类型码 ?= 0) {
                (目标名)转义标识符 = 目标转义;
                如果 (表达式类型 ?= "字符串") { (目标名, "S")局部表添加; }
                否则如果 (表达式类型 ?= "浮点") { (目标名, "F")局部表添加; }
                否则 { (目标名, "I")局部表添加; }
                "%" + 目标转义 = 目标地址;
            } 否则 {
                (目标名)转义标识符 = 目标转义;
                如果 (命中全局表 ?= 1) { "@" + 目标转义 = 目标地址; }
                否则 { "%" + 目标转义 = 目标地址; }
            }
            如果 (表达式类型 ?= "字符串") {
                ("存储 ptr " + 表达式C + ", ptr " + 目标地址 + ", align 8")发射;
            } 否则如果 (表达式类型 ?= "浮点") {
                ("存储 double " + 表达式C + ", ptr " + 目标地址 + ", align 8")发射;
            } 否则 {
                ("存储 i32 " + 表达式C + ", ptr " + 目标地址 + ", align 4")发射;
            }
            ()下一个标记;   // ;
        } 否则 {
            ()下一个标记;   // ;
        }
    } 否则如果 (标记值 ?= "+=" || 标记值 ?= "-=" || 标记值 ?= "*=" || 标记值 ?= "/=") {
        标记值 = 操作符;
        ()下一个标记;
        如果 (标记类型 ?= 2) {
            标记值 = 目标名;
            ()下一个标记;
            (目标名)查类型 = 类型码;
            如果 (类型码 ?= 0) {
                (目标名)转义标识符 = 目标转义;
                ("存储 i32 0, ptr %" + 目标转义 + ", align 4")发射;
                (目标名, "I")局部表添加;
                "%" + 目标转义 = 目标地址;
            } 否则 {
                (目标名)转义标识符 = 目标转义;
                如果 (命中全局表 ?= 1) { "@" + 目标转义 = 目标地址; }
                否则 { "%" + 目标转义 = 目标地址; }
            }
            ()新寄存器 = 加载临时;
            ("  " + 加载临时 + " = 加载 i32, ptr " + 目标地址 + ", align 4")发射;
            ()新寄存器 = 运算临时;
            如果 (操作符 ?= "+=") { ("  " + 运算临时 + " = 加 i32 " + 加载临时 + ", " + 表达式C)发射; }
            否则如果 (操作符 ?= "-=") { ("  " + 运算临时 + " = 减 i32 " + 加载临时 + ", " + 表达式C)发射; }
            否则如果 (操作符 ?= "*=") { ("  " + 运算临时 + " = 乘 i32 " + 加载临时 + ", " + 表达式C)发射; }
            否则 { ("  " + 运算临时 + " = 有符号除 i32 " + 加载临时 + ", " + 表达式C)发射; }
            ("存储 i32 " + 运算临时 + ", ptr " + 目标地址 + ", align 4")发射;
            ()下一个标记;   // ;
        } 否则 {
            ()下一个标记;   // ;
        }
    } 否则 {
        // 调用语句：调用指令已在解析表达式时发射
        ()下一个标记;   // ;
    }
}

// 发射 if / else if / else 链
函数 发射如果链 {
    0 = 是否否则如果;
    如果 (标记值 ?= "否则如果") { 1 = 是否否则如果; }
    否则 { 0 = 是否否则如果; }
    ()下一个标记;   // 如果/否则如果
    ()下一个标记;   // (
    ()解析表达式;
    ()下一个标记;   // )
    如果 (是否否则如果 ?= 1) {
        ("} else if ( " + 表达式C + " ) {")发射;
    } 否则 {
        ("if ( " + 表达式C + " ) {")发射;
    }
    ()下一个标记;   // {
    ()发射函数体;
    ()下一个标记;   // }
    如果 (标记值 ?= "否则如果") {
        ()发射如果链;
    } 否则如果 (标记值 ?= "否则") {
        ()下一个标记;   // 否则
        ("} else {")发射;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("}")发射;
    } 否则 {
        ("}")发射;
    }
}

// ────────────────────────────────────────────
// 函数定义 (Function Definitions)
// ────────────────────────────────────────────

// 解析函数签名（当前标记在 函数 关键字）
// 产出: 原型名/输入参数IR/输入参数表/输出参数表/返回类型名/输出参数名
函数 解析函数签名 {
    ()下一个标记;   // 函数
    "" = 输入参数IR;
    "" = 输入参数表;
    "" = 返回类型名;
    "" = 输出参数名;
    "" = 局部类型表;
    "" = 已声明表;
    如果 (标记值 ?= "(") {
        // 输入参数列表在前
        ()下一个标记;
        "" = 输入参数IR;
        "" = 输入参数表;
        如果 (标记值 ?= ")") {
            "" = 输入参数IR;
            "" = 输入参数表;
        } 否则 {
            当 (真) {
                标记值 = 参数名;
                ()下一个标记;
                "" = 类型名;
                如果 (标记值 ?= ":") {
                    ()下一个标记;
                    标记值 = 类型名;
                    ()下一个标记;
                } 否则 {
                    "整数" = 类型名;
                }
                // 记录参数类型到局部表
                如果 (类型名 ?= "整数") { (参数名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (参数名, "S")局部表添加; }
                否则 { (参数名, "F")局部表添加; }
                // 记录到已声明表（参数由函数签名声明）
                (已声明表, 参数名, "X")表添加 = 已声明表;
                // 收集 IR 参数（头部参数列表 + 名:I 行）
                如果 (类型名 ?= "整数") { "i32" = 参数类型IR; (输入参数表, 参数名, "I")表添加 = 输入参数表; }
                否则如果 (类型名 ?= "字符串") { "ptr" = 参数类型IR; (输入参数表, 参数名, "S")表添加 = 输入参数表; }
                否则 { "double" = 参数类型IR; (输入参数表, 参数名, "F")表添加 = 输入参数表; }
                (参数名 + "_in")转义标识符 = 参数转义;
                如果 (输入参数IR ?= "") {
                    参数类型IR + " %" = 输入参数IR;
                } 否则 {
                    输入参数IR + ", " = 输入参数IR;
                    输入参数IR + 参数类型IR = 输入参数IR;
                    输入参数IR + " %" = 输入参数IR;
                }
                输入参数IR + 参数转义 = 输入参数IR;
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
        标记值 = 原型名;
        ()下一个标记;
    } 否则 {
        // 函数名在前
        标记值 = 原型名;
        ()下一个标记;
    }
    // 输出参数列表
    "" = 输出参数表;
    "" = 返回类型名;
    如果 (标记值 ?= "(") {
        ()下一个标记;
        如果 (标记值 ?= ")") {
            "" = 输出参数表;
        } 否则 {
            当 (真) {
                 // "0 = 名:类型"
                 如果 (标记类型 ?= 1) { ()下一个标记; }
                 如果 (标记值 ?= "=") { ()下一个标记; }
                 标记值 = 输出名;
                 ()下一个标记;
                 "" = 类型名;
                 如果 (标记值 ?= ":") {
                     ()下一个标记;
                     标记值 = 类型名;
                     ()下一个标记;
                 } 否则 {
                     "整数" = 类型名;
                 }
                // 记录返回类型（第一个输出参数）
                如果 (返回类型名 ?= "") {
                    "" = 返回类型名;
                    类型名 = 返回类型名;
                }
                // 记录输出参数名（第一个输出参数）
                如果 (输出参数名 ?= "") {
                    输出名 = 输出参数名;
                }
                // 记录输出参数类型到局部表
                如果 (类型名 ?= "整数") { (输出名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (输出名, "S")局部表添加; }
                否则 { (输出名, "F")局部表添加; }
                // 记录到已声明表（输出参数由函数签名声明）
                (已声明表, 输出名, "X")表添加 = 已声明表;
                // 收集输出参数表（名:码 行）
                如果 (类型名 ?= "整数") { (输出参数表, 输出名, "I")表添加 = 输出参数表; }
                否则如果 (类型名 ?= "字符串") { (输出参数表, 输出名, "S")表添加 = 输出参数表; }
                否则 { (输出参数表, 输出名, "F")表添加 = 输出参数表; }
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
    }
}

// 收集函数原型（第一遍）
函数 收集函数原型 {
    ()解析函数签名;
    // 不发射声明：LLVM 模块级符号允许前向引用，用户函数均在第二遍以 `定义 内部` 定义；
    // 而 llvm-as 不允许为 `内部` 链接的函数写 `声明`（invalid linkage for function declaration）。
    // 记录函数返回类型
    如果 (返回类型名 ?= "字符串") { (原型名, "S")函数返回表添加; }
    否则如果 (返回类型名 ?= "整数") { (原型名, "I")函数返回表添加; }
    // 跳到代码块
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "{") {
            ()跳过代码块;
            ()下一个标记;   // 消费 }
            中断;
        }
        ()下一个标记;
    }
}

// 发射输出参数的 alloca + 零初始化
函数 发射输出参数声明 {
    0 = 索引;
    (输出参数表)分割行数 = 行数;
    当 (索引 < 行数) {
        (输出参数表, 索引)获取行 = 行;
        (行)提取行名 = 输出名;
        (行)提取行码 = 输出码;
        (输出名)转义标识符 = 输出转义;
        如果 (输出码 ?= "S") {
            ("%" + 输出转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr null, ptr %" + 输出转义 + ", align 8")发射;
        } 否则如果 (输出码 ?= "F") {
            ("%" + 输出转义 + " = 分配 double, align 8")发射;
            ("存储 double 0.000000e+00, ptr %" + 输出转义 + ", align 8")发射;
        } 否则 {
            ("%" + 输出转义 + " = 分配 i32, align 4")发射;
            ("存储 i32 0, ptr %" + 输出转义 + ", align 4")发射;
        }
        索引 + 1 = 索引;
    }
}

// 发射输入参数复制（参数 %名_in → alloca %名）
函数 发射输入参数复制 {
    0 = 索引;
    (输入参数表)分割行数 = 行数;
    当 (索引 < 行数) {
        (输入参数表, 索引)获取行 = 行;
        (行)提取行名 = 参数名;
        (行)提取行码 = 参数码;
        (参数名)转义标识符 = 参数转义;
        (参数名 + "_in")转义标识符 = 参数入转义;
        如果 (参数码 ?= "S") {
            ("%" + 参数转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则如果 (参数码 ?= "F") {
            ("%" + 参数转义 + " = 分配 double, align 8")发射;
            ("存储 double %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则 {
            ("%" + 参数转义 + " = 分配 i32, align 4")发射;
            ("存储 i32 %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 4")发射;
        }
        索引 + 1 = 索引;
    }
}

// 发射局部变量声明（函数内新局部变量，跳过已由签名/输出声明声明的）
函数 发射局部声明 {
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        // 提取名（: 之前字符）
        (行)长度 = 行长;
        0 = 位置;
        "" = 局部名;
        当 (位置 < 行长) {
            (行, 位置, 1)子串 = 字;
            如果 (字 ?= ":") { 位置 = 行长; }
            否则 {
                局部名 + 字 = 局部名;
                位置 + 1 = 位置;
            }
        }
        // 提取类型码（必须在遍历 已声明表 之前，因为 获取行 共享静态缓冲区会覆盖 行）
        (局部名)长度 = 类型码长;
        (行, 类型码长 + 1, 1)子串 = 提取类型码;
        // 跳过已声明（参数/输出）：遍历 已声明表
        0 = 索引2;
        (已声明表)分割行数 = 声明行数;
        0 = 已声明命中;
        当 (索引2 < 声明行数) {
            (已声明表, 索引2)获取行 = 声明行;
            (声明行, 局部名 + ":")字符串开头 = 已声明命中;
            如果 (已声明命中 ?= 1) { 索引2 = 声明行数; }
            否则 { 索引2 + 1 = 索引2; }
        }
        如果 (已声明命中 ?= 0) {
            (局部名)转义标识符 = 局部转义;
            如果 (提取类型码 ?= "S") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "F") { ("%" + 局部转义 + " = 分配 double, align 8")发射; }
            否则 { ("%" + 局部转义 + " = 分配 i32, align 4")发射; }
        }
        索引 + 1 = 索引;
    }
}

// 发射函数定义（第二遍）
函数 发射函数定义 {
    ()解析函数签名;
    "" = 返回类型IR;
    如果 (返回类型名 ?= "整数") { "i32" = 返回类型IR; }
    否则如果 (返回类型名 ?= "字符串") { "ptr" = 返回类型IR; }
    否则如果 (返回类型名 ?= "浮点") { "double" = 返回类型IR; }
    否则 { "void" = 返回类型IR; }
    (原型名)转义标识符 = 原型转义;
    1 = 缓冲模式;
    "" = 函数体C;
    ()下一个标记;   // {
    ()发射函数体;
    0 = 缓冲模式;
    ()下一个标记;   // }
    ("定义 内部 " + 返回类型IR + " @" + 原型转义 + "(" + 输入参数IR + ") {")发射;
    ("entry:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    (函数体C)发射;
    如果 (返回类型名 ?= "") {
        ("返回 void")发射;
    } 否则 {
        (输出参数名)取地址 = 返回地址;
        ()新寄存器 = 返回加载;
        ("  " + 返回加载 + " = 加载 " + 返回类型IR + ", ptr " + 返回地址 + ", align 4")发射;
        ("  返回 " + 返回类型IR + " " + 返回加载)发射;
    }
    ("}")发射;
}

