函数 主程序 {
    // 参数: (1)=输入路径 (2)=输出路径
    (1)获取参数 = 输入路径;
    (2)获取参数 = 输出路径;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        "" = 生成代码;
        ()预计算转义;
        ()发射前导;
        ()第一遍;
        "" = 局部类型表;
        ()第二遍;
        ()发射字符串常量表;
        ()发射主程序入口;
        (输出路径, 生成代码)写入文件 = 结果;
    }
}
