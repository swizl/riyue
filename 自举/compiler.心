                否则如果 (下码 ?= 92) { 结果 + "\\" = 结果; 索引 + 1 = 索引; }
                否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
            } 否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
