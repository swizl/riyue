// 表达式解析 (Expression Parser)
// 结果写入 表达式C/表达式类型
// ────────────────────────────────────────────

函数 解析表达式 {
    ()解析或;
}

函数 解析或 {
     ()解析与;
     当 (标记值 ?= "||") {
         表达式C = 左或;
         表达式类型 = 左或类型;
         ()下一个标记;
         ()解析与;
         表达式C = 右或;
         表达式类型 = 右或类型;
         "( " + 左或 + " || " + 右或 + " )" = 表达式C;
         "整数" = 表达式类型;
     }
}

函数 解析与 {
     ()解析比较;
     当 (标记值 ?= "&&") {
         表达式C = 左与;
         表达式类型 = 左与类型;
         ()下一个标记;
         ()解析比较;
         表达式C = 右与;
         表达式类型 = 右与类型;
         "( " + 左与 + " && " + 右与 + " )" = 表达式C;
         "整数" = 表达式类型;
     }
}

函数 解析比较 {
     ()解析加减;
     当 (标记值 ?= ">" || 标记值 ?= "<" || 标记值 ?= ">=" || 标记值 ?= "<=" || 标记值 ?= "==" || 标记值 ?= "!=" || 标记值 ?= "?=") {
         标记值 = 操作符;
         表达式C = 左比;
         表达式类型 = 左比类型;
         ()下一个标记;
         ()解析加减;
         表达式C = 右比;
         表达式类型 = 右比类型;
         如果 (左比类型 ?= "字符串" || 右比类型 ?= "字符串") {
             如果 (操作符 ?= "==" || 操作符 ?= "?=") {
                 "( strcmp( " + 左比 + " , " + 右比 + " ) == 0 )" = 表达式C;
             } 否则如果 (操作符 ?= "!=") {
                 "( strcmp( " + 左比 + " , " + 右比 + " ) != 0 )" = 表达式C;
             } 否则 {
                 "( strcmp( " + 左比 + " , " + 右比 + " ) < 0 )" = 表达式C;
             }
         } 否则 {
             如果 (操作符 ?= "?=") {
                 "( " + 左比 + " == " + 右比 + " )" = 表达式C;
             } 否则 {
                 "( " + 左比 + " " + 操作符 + " " + 右比 + " )" = 表达式C;
             }
         }
         "整数" = 表达式类型;
     }
}

函数 解析加减 {
     ()解析乘除;
     当 (标记值 ?= "+" || 标记值 ?= "-") {
         标记值 = 操作符;
         表达式C = 左加;
         表达式类型 = 左加类型;
         ()下一个标记;
         ()解析乘除;
         表达式C = 右加;
         表达式类型 = 右加类型;
         如果 (操作符 ?= "+" && (左加类型 ?= "字符串" || 右加类型 ?= "字符串")) {
             "日月拼接( " + 左加 + " , " + 右加 + " )" = 表达式C;
             "字符串" = 表达式类型;
         } 否则 {
             "( " + 左加 + " " + 操作符 + " " + 右加 + " )" = 表达式C;
             "整数" = 表达式类型;
         }
     }
}

函数 解析乘除 {
     ()解析一元;
     当 (标记值 ?= "*" || 标记值 ?= "/" || 标记值 ?= "%") {
         标记值 = 操作符;
         表达式C = 左乘;
         ()下一个标记;
         ()解析一元;
         表达式C = 右乘;
         "( " + 左乘 + " " + 操作符 + " " + 右乘 + " )" = 表达式C;
         "整数" = 表达式类型;
     }
}

函数 解析一元 {
    如果 (标记类型 ?= 4 && 标记值 ?= "-") {
        ()下一个标记;
        ()解析一元;
        "( 0 - " + 表达式C + " )" = 表达式C;
    } 否则如果 (标记类型 ?= 4 && 标记值 ?= "!") {
        ()下一个标记;
        ()解析一元;
        "( ! " + 表达式C + " )" = 表达式C;
        "整数" = 表达式类型;
    } 否则 {
        ()解析原子;
    }
}

函数 解析原子 {
    如果 (标记类型 ?= 1) {
        // 数字字面量
        标记值 = 表达式C;
        "整数" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 3) {
        // 字符串字面量
        (标记值)转义字符串 = 表达式C;
        "字符串" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 2) {
        // 标识符
        标记值 = 表达式C;
        如果 (标记值 ?= "真") {
            "1" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则如果 (标记值 ?= "假") {
            "0" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则 {
            (标记值)查类型 = 类型码;
            如果 (类型码 ?= 2) { "字符串" = 表达式类型; }
            否则如果 (类型码 ?= 3) { "浮点" = 表达式类型; }
            否则 { "整数" = 表达式类型; }
            ()下一个标记;
        }
    } 否则如果 (标记值 ?= "(") {
        ()解析括号或调用;
    } 否则 {
        // 未知：空表达式
        "0" = 表达式C;
        "整数" = 表达式类型;
    }
}

// 解析 ( ... ) 可能是分组或前缀调用
函数 解析括号或调用 {
    ()下一个标记;   // 消费 "("
    "" = 参数文本;
    "" = 参数0类型;
    0 = 参数计数;
    如果 (标记值 ?= ")") {
        0 = 参数计数;
    } 否则 {
        ()解析表达式;
        表达式C = 参数文本;
        表达式类型 = 参数0类型;
        1 = 参数计数;
        当 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            参数文本 + ", " = 参数文本;
            参数文本 + 表达式C = 参数文本;
            参数计数 + 1 = 参数计数;
        }
    }
    // 消费 ")"
    ()下一个标记;
    如果 (标记类型 ?= 2) {
        // 前缀调用
        标记值 = 函数名;
        ()下一个标记;
        如果 (函数名 ?= "打印") {
            如果 (参数计数 ?= 0) {
                "printf(\"\\n\")" = 表达式C;
            } 否则如果 (参数0类型 ?= "字符串") {
                "printf(\"%s\\n\", " + 参数文本 + " )" = 表达式C;
            } 否则 {
                "printf(\"%d\\n\", " + 参数文本 + " )" = 表达式C;
            }
            "空" = 表达式类型;
        } 否则如果 (函数名 ?= "长度") {
            "获取字符数( " + 参数文本 + " )" = 表达式C;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "字符码") {
            "字符码( " + 参数文本 + " )" = 表达式C;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "子串") {
            "日月子串( " + 参数文本 + " )" = 表达式C;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "转字符串") {
            "日月转字符串( " + 参数文本 + " )" = 表达式C;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "拼接") {
            "日月拼接( " + 参数文本 + " )" = 表达式C;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "读取文件") {
            "读取文件( " + 参数文本 + " )" = 表达式C;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "写入文件") {
            "写入文件( " + 参数文本 + " )" = 表达式C;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "获取参数") {
            "获取参数( " + 参数文本 + " )" = 表达式C;
            "字符串" = 表达式类型;
        } 否则如果 (函数名 ?= "获取参数数量") {
