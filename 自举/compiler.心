// 预计算 12 个运行时函数 + 主程序的转义名到全局（供 IR 前导/内置分发使用）
函数 预计算转义 {
    "设置参数" = 运行时名;
    (运行时名)转义标识符 = 转义_设置参数;
    "获取参数数量" = 运行时名;
    (运行时名)转义标识符 = 转义_获取参数数量;
    "获取参数" = 运行时名;
    (运行时名)转义标识符 = 转义_获取参数;
    "读取文件" = 运行时名;
    (运行时名)转义标识符 = 转义_读取文件;
    "写入文件" = 运行时名;
    (运行时名)转义标识符 = 转义_写入文件;
    "字符位置到字节位置" = 运行时名;
    (运行时名)转义标识符 = 转义_字符位置到字节位置;
    "获取字符数" = 运行时名;
    (运行时名)转义标识符 = 转义_获取字符数;
    "字符码" = 运行时名;
    (运行时名)转义标识符 = 转义_字符码;
    "输出错误" = 运行时名;
    (运行时名)转义标识符 = 转义_输出错误;
    "分割行数" = 运行时名;
    (运行时名)转义标识符 = 转义_分割行数;
    "获取行" = 运行时名;
    (运行时名)转义标识符 = 转义_获取行;
    "字符串开头" = 运行时名;
    (运行时名)转义标识符 = 转义_字符串开头;
    "主程序" = 运行时名;
    (运行时名)转义标识符 = 转义_主程序;
}

函数 主程序 {
    // 参数: (1)=输入路径 (2)=输出路径
    (1)获取参数 = 输入路径;
    (2)获取参数 = 输出路径;
    (输入路径)读取文件 = 源码;
    (源码)长度 = 长;
    // 剥离 UTF-8 BOM
    如果 (长 >= 1) {
        (源码, 0)字符码 = 首码;
        如果 (首码 ?= 65279) {
            (源码, 1, 长 - 1)子串 = 源码;
        }
    }
    (源码)长度 = 长;
    如果 (长 ?= 0) {
        ("错误: 无法读取输入文件: ")输出错误;
        (输入路径)打印;
    } 否则 {
        "" = 生成代码;
        ()发射前导;
        ()第一遍;
        "" = 局部类型表;
        ()第二遍;
        ()发射主程序入口;
        (输出路径, 生成代码)写入文件 = 结果;
    }
}
