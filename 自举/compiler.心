            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "输出错误") {
            "输出错误( " + 参数文本 + " )" = 表达式C;
            "空" = 表达式类型;
        } 否则如果 (函数名 ?= "字符串开头") {
            "字符串开头( " + 参数文本 + " )" = 表达式C;
            "整数" = 表达式类型;
        } 否则如果 (函数名 ?= "分割行数") {
            "分割行数( " + 参数文本 + " )" = 表达式C;
