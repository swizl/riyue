// ============================================
// 日月编译器自举源码 (compiler.心)
// 词法分析 + 语法分析 + 确定性摘要输出
// 使用整数字符码避免字符串比较类型问题
// ============================================

变量 源码 = "";
变量 源位置 = 0;
变量 当前行号 = 1;
变量 函数数量 = 0;
变量 变量数量 = 0;
变量 语句数量 = 0;
变量 哈希值 = 0;

函数 更新哈希(值): 空 {
    哈希值 = (哈希值 * 31 + 值) % 1000000007;
}

函数 当前字符码(): 整数 {
    如果 (源位置 >= 长度(源码)) { 返回 -1; }
    返回 转整数(子串(源码, 源位置, 1));
}

函数 下一个字符码(): 整数 {
    如果 (源位置 + 1 >= 长度(源码)) { 返回 -1; }
    返回 转整数(子串(源码, 源位置 + 1, 1));
}

函数 前进(): 空 {
    如果 (源位置 < 长度(源码) && 子串(源码, 源位置, 1) ?= "\n") {
        当前行号 = 当前行号 + 1;
    }
    源位置 = 源位置 + 1;
}

函数 是空白(c): 整数 {
    如果 (c ?= 32) { 返回 1; }
    如果 (c ?= 9) { 返回 1; }
    如果 (c ?= 10) { 返回 1; }
    如果 (c ?= 13) { 返回 1; }
    返回 0;
}

函数 是数字(c): 整数 {
    返回 (c >= 48 && c <= 57);
}

函数 是字母开始(c): 整数 {
    如果 (c >= 65 && c <= 90) { 返回 1; }
    如果 (c >= 97 && c <= 122) { 返回 1; }
    如果 (c ?= 95) { 返回 1; }
    如果 (c >= 19968) { 返回 1; }
    返回 0;
}

函数 是字母数字(c): 整数 {
    如果 (是字母开始(c)) { 返回 1; }
    如果 (是数字(c)) { 返回 1; }
    返回 0;
}

函数 跳过空白注释(): 空 {
    当 (源位置 < 长度(源码)) {
        变量 c = 当前字符码();
        如果 (是空白(c)) { 前进(); 继续; }
        如果 (c ?= 47) {
            变量 下一个 = 下一个字符码();
            如果 (下一个 ?= 47) {
                当 (源位置 < 长度(源码)) {
                    如果 (当前字符码() ?= 10) { 中断; }
                    前进();
                }
                继续;
            }
            如果 (下一个 ?= 42) {
                前进(); 前进();
                当 (源位置 < 长度(源码)) {
                    如果 (当前字符码() ?= 42) {
                        如果 (下一个字符码() ?= 47) {
                            前进(); 前进(); 中断;
                        }
                    }
                    前进();
                }
                继续;
            }
        }
        中断;
    }
}

变量 标记类型 = 0;
变量 标记值 = "";

函数 下一个标记(): 空 {
    跳过空白注释();
    如果 (源位置 >= 长度(源码)) {
        标记类型 = 0; 标记值 = ""; 返回;
    }

    变量 c = 当前字符码();

    如果 (是数字(c)) {
        变量 开始 = 源位置;
        当 (是数字(当前字符码())) { 前进(); }
        标记值 = 子串(源码, 开始, 源位置 - 开始);
        标记类型 = 1; 返回;
    }

    如果 (是字母开始(c)) {
        变量 开始 = 源位置;
        当 (是字母数字(当前字符码())) { 前进(); }
        标记值 = 子串(源码, 开始, 源位置 - 开始);
        标记类型 = 2; 返回;
    }

    如果 (c ?= 34) {
        前进();
        变量 开始 = 源位置;
        当 (源位置 < 长度(源码) && !当前字符码() ?= 34) {
            如果 (当前字符码() ?= 92) { 前进(); }
            前进();
        }
        标记值 = 子串(源码, 开始, 源位置 - 开始);
        标记类型 = 3;
        如果 (源位置 < 长度(源码)) { 前进(); }
        返回;
    }

    标记值 = 子串(源码, 源位置, 1);
    标记类型 = 4;
    前进();

    变量 下一个 = 下一个字符码();
    如果 (c ?= 61 && 下一个 ?= 61) { 标记值 = "=="; 前进(); 返回; }
    如果 (c ?= 43 && 下一个 ?= 61) { 标记值 = "+="; 前进(); 返回; }
    如果 (c ?= 45 && 下一个 ?= 61) { 标记值 = "-="; 前进(); 返回; }
    如果 (c ?= 42 && 下一个 ?= 61) { 标记值 = "*="; 前进(); 返回; }
    如果 (c ?= 47 && 下一个 ?= 61) { 标记值 = "/="; 前进(); 返回; }
    如果 (c ?= 33 && 下一个 ?= 61) { 标记值 = "!="; 前进(); 返回; }
    如果 (c ?= 60 && 下一个 ?= 61) { 标记值 = "<="; 前进(); 返回; }
    如果 (c ?= 62 && 下一个 ?= 61) { 标记值 = ">="; 前进(); 返回; }
    如果 (c ?= 38) {
        如果 (下一个 ?= 38) { 标记值 = "&&"; 前进(); 返回; }
    }
    如果 (c ?= 124) {
        如果 (下一个 ?= 124) { 标记值 = "||"; 前进(); 返回; }
    }
    如果 (c ?= 63 && 下一个 ?= 61) { 标记值 = "?="; 前进(); 返回; }
}

函数 是表达式结束(): 整数 {
    如果 (标记值 ?= ";") { 返回 1; }
    如果 (标记值 ?= ",") { 返回 1; }
    如果 (标记值 ?= ")") { 返回 1; }
    如果 (标记值 ?= "]") { 返回 1; }
    如果 (标记值 ?= "}") { 返回 1; }
    返回 0;
}

函数 跳过表达式(): 空 {
    当 (标记类型 != 0) {
        如果 (是表达式结束()) { 中断; }
        如果 (标记值 ?= "(") { 下一个标记(); 跳过表达式(); 如果 (标记值 ?= ")") { 下一个标记(); } 继续; }
        如果 (标记值 ?= "[") { 下一个标记(); 跳过表达式(); 如果 (标记值 ?= "]") { 下一个标记(); } 继续; }
        如果 (标记类型 ?= 2) {
            下一个标记();
            如果 (标记值 ?= "(") {
                下一个标记(); 跳过表达式();
                如果 (标记值 ?= ")") { 下一个标记(); }
            }
            继续;
        }
        下一个标记();
    }
}

函数 跳过代码块(): 空 {
    如果 (!标记值 ?= "{") { 返回; }
    下一个标记();
    当 (标记类型 != 0 && !标记值 ?= "}") {
        解析语句();
    }
    如果 (标记值 ?= "}") { 下一个标记(); }
}

函数 解析语句(): 空 {
    如果 (标记类型 ?= 0) { 返回; }
    语句数量 = 语句数量 + 1;

    如果 (标记值 ?= "变量") {
        变量数量 = 变量数量 + 1;
        下一个标记();
        如果 (标记类型 ?= 2) { 下一个标记(); }
        如果 (标记值 ?= ":") { 下一个标记(); 下一个标记(); }
        如果 (标记值 ?= "=") { 下一个标记(); 跳过表达式(); }
        如果 (标记值 ?= ";") { 下一个标记(); }
        返回;
    }
    如果 (标记值 ?= "常量") {
        变量数量 = 变量数量 + 1;
        下一个标记();
        如果 (标记类型 ?= 2) { 下一个标记(); }
        如果 (标记值 ?= ":") { 下一个标记(); 下一个标记(); }
        如果 (标记值 ?= "=") { 下一个标记(); 跳过表达式(); }
        如果 (标记值 ?= ";") { 下一个标记(); }
        返回;
    }

    如果 (标记值 ?= "函数") {
        函数数量 = 函数数量 + 1;
        下一个标记();
        如果 (标记类型 ?= 2) { 下一个标记(); }
        如果 (标记值 ?= "(") {
            下一个标记();
            当 (标记类型 != 0) {
                如果 (标记值 ?= ")") { 中断; }
                下一个标记();
            }
            如果 (标记值 ?= ")") { 下一个标记(); }
        }
        如果 (标记值 ?= ":") { 下一个标记(); 下一个标记(); }
        跳过代码块();
        返回;
    }

    如果 (标记值 ?= "如果") {
        下一个标记();
        如果 (标记值 ?= "(") { 下一个标记(); 跳过表达式(); 如果 (标记值 ?= ")") { 下一个标记(); } }
        跳过代码块();
        当 (标记值 ?= "否则如果") {
            下一个标记();
            如果 (标记值 ?= "(") { 下一个标记(); 跳过表达式(); 如果 (标记值 ?= ")") { 下一个标记(); } }
            跳过代码块();
        }
        如果 (标记值 ?= "否则") { 下一个标记(); 跳过代码块(); }
        返回;
    }

    如果 (标记值 ?= "当") {
        下一个标记();
        如果 (标记值 ?= "(") { 下一个标记(); 跳过表达式(); 如果 (标记值 ?= ")") { 下一个标记(); } }
        跳过代码块();
        返回;
    }

    如果 (标记值 ?= "循环") {
        下一个标记();
        如果 (标记值 ?= "(") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ";") { 下一个标记(); 跳过表达式(); }
            如果 (标记值 ?= ";") { 下一个标记(); 跳过表达式(); }
            如果 (标记值 ?= ")") { 下一个标记(); }
        } 否则 {
            跳过代码块();
        }
        返回;
    }

    如果 (标记值 ?= "返回") {
        下一个标记();
        如果 (标记值 ?= ";") { 下一个标记(); } 否则 { 跳过表达式(); 如果 (标记值 ?= ";") { 下一个标记(); } }
        返回;
    }

    如果 (标记值 ?= "打印") {
        下一个标记();
        如果 (标记值 ?= "(") { 下一个标记(); 跳过表达式(); 如果 (标记值 ?= ")") { 下一个标记(); } }
        如果 (标记值 ?= ";") { 下一个标记(); }
        返回;
    }

    如果 (标记值 ?= "中断") {
        下一个标记();
        如果 (标记值 ?= ";") { 下一个标记(); }
        返回;
    }
    如果 (标记值 ?= "继续") {
        下一个标记();
        如果 (标记值 ?= ";") { 下一个标记(); }
        返回;
    }

    如果 (标记类型 ?= 2) {
        下一个标记();
        如果 (标记值 ?= "=") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则如果 (标记值 ?= "+=") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则如果 (标记值 ?= "-=") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则如果 (标记值 ?= "*=") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则如果 (标记值 ?= "/=") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则如果 (标记值 ?= "[") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= "]") { 下一个标记(); }
            如果 (标记值 ?= "=") { 下一个标记(); 跳过表达式(); }
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则如果 (标记值 ?= "(") {
            下一个标记(); 跳过表达式();
            如果 (标记值 ?= ")") { 下一个标记(); }
            如果 (标记值 ?= ";") { 下一个标记(); }
        } 否则 {
            如果 (标记值 ?= ";") { 下一个标记(); }
        }
        返回;
    }

    如果 (标记值 ?= "{") { 跳过代码块(); 返回; }
    下一个标记();
    如果 (标记值 ?= ";") { 下一个标记(); }
}

函数 解析程序(): 空 {
    下一个标记();
    当 (标记类型 != 0) {
        解析语句();
    }
}

函数 主程序(): 空 {
    变量 文件句柄 = 打开("自举/compiler.心", "r");
    如果 (文件句柄 < 0) {
        打印("ERROR");
        返回;
    }

    源码 = "";
    当 (真) {
        变量 行 = 读取行(文件句柄);
        如果 (长度(行) ?= 0) { 中断; }
        源码 = 源码 + 行 + "\n";
    }
    关闭(文件句柄);

    解析程序();

    更新哈希(函数数量);
    更新哈希(变量数量);
    更新哈希(语句数量);

    循环 (变量 i = 0; i < 长度(源码); i += 1) {
        更新哈希(转整数(子串(源码, i, 1)));
    }

    打印("DIGEST");
    打印(函数数量);
    打印(变量数量);
    打印(语句数量);
    打印(哈希值);
    打印("END");
}
