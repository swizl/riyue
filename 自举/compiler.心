// 解析函数签名（当前标记在 函数 关键字）
// 返回: 原型名/输入声明C/返回类型名/输出参数名
// 若 打印原型=1 则发射原型行
函数 解析函数签名 {
    ()下一个标记;   // 函数
    "" = 输入声明C;
    "" = 返回类型名;
    "" = 输出参数名;
    "" = 局部类型表;
    "" = 已声明表;
    如果 (标记值 ?= "(") {
        // 输入参数列表在前
        ()下一个标记;
        "" = 输入声明C;
        如果 (标记值 ?= ")") {
            "" = 输入声明C;
        } 否则 {
            当 (真) {
                标记值 = 参数名;
                ()下一个标记;
                "" = 类型名;
                如果 (标记值 ?= ":") {
                    ()下一个标记;
                    标记值 = 类型名;
                    ()下一个标记;
                } 否则 {
                    "整数" = 类型名;
                }
                如果 (输入声明C ?= "") {
                    如果 (类型名 ?= "整数") { 输入声明C + "int " = 输入声明C; }
                    否则 { 输入声明C + "char* " = 输入声明C; }
                    输入声明C + 参数名 = 输入声明C;
                } 否则 {
                    如果 (类型名 ?= "整数") { 输入声明C + ", int " = 输入声明C; }
                    否则 { 输入声明C + ", char* " = 输入声明C; }
                    输入声明C + 参数名 = 输入声明C;
                }
                // 记录参数类型到局部表
                如果 (类型名 ?= "整数") { (参数名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (参数名, "S")局部表添加; }
                否则 { (参数名, "F")局部表添加; }
                // 记录到已声明表（参数由函数签名声明）
                (已声明表, 参数名, "X")表添加 = 已声明表;
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
        标记值 = 原型名;
        ()下一个标记;
    } 否则 {
        // 函数名在前
        标记值 = 原型名;
        ()下一个标记;
    }
    // 输出参数列表
    "" = 输出声明C;
    "" = 返回类型名;
    如果 (标记值 ?= "(") {
        ()下一个标记;
        如果 (标记值 ?= ")") {
            "" = 输出声明C;
        } 否则 {
            当 (真) {
                 // "0 = 名:类型"
                 如果 (标记类型 ?= 1) { ()下一个标记; }
                 如果 (标记值 ?= "=") { ()下一个标记; }
                 标记值 = 输出名;
                 ()下一个标记;
                 "" = 类型名;
                 如果 (标记值 ?= ":") {
                     ()下一个标记;
                     标记值 = 类型名;
                     ()下一个标记;
                 } 否则 {
                     "整数" = 类型名;
                 }
                // 输出参数作为局部变量声明
                如果 (类型名 ?= "整数") {
                    输出声明C + "int " = 输出声明C;
                } 否则 {
                    输出声明C + "char* " = 输出声明C;
                }
                输出声明C + 输出名 = 输出声明C;
                输出声明C + " = 0;" = 输出声明C;
                // 记录返回类型（第一个输出参数）
                如果 (返回类型名 ?= "") {
                    "" = 返回类型名;
                    类型名 = 返回类型名;
                }
                // 记录输出参数名（第一个输出参数）
                如果 (输出参数名 ?= "") {
                    输出名 = 输出参数名;
                }
                // 记录输出参数类型到局部表
                如果 (类型名 ?= "整数") { (输出名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (输出名, "S")局部表添加; }
                否则 { (输出名, "F")局部表添加; }
                // 记录到已声明表（输出参数由 输出声明C 声明）
                (已声明表, 输出名, "X")表添加 = 已声明表;
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
    }
}

// 收集函数原型（第一遍）
函数 收集函数原型 {
    ()解析函数签名;
    // 发射原型
    "" = 返回类型C;
    如果 (返回类型名 ?= "整数") { "int " = 返回类型C; }
    否则如果 (返回类型名 ?= "字符串") { "char* " = 返回类型C; }
    否则 { "void " = 返回类型C; }
    (返回类型C + 原型名 + "( " + 输入声明C + " );")发射;
    // 记录函数返回类型
    如果 (返回类型名 ?= "字符串") { (原型名, "S")函数返回表添加; }
    否则如果 (返回类型名 ?= "整数") { (原型名, "I")函数返回表添加; }
    // 跳到代码块
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "{") {
            ()跳过代码块;
            ()下一个标记;   // 消费 }
            中断;
        }
        ()下一个标记;
    }
}

// 发射局部变量声明（函数内新局部变量，跳过已由签名/输出声明声明的）
函数 发射局部声明 {
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        // 提取名（: 之前字符）
        (行)长度 = 行长;
        0 = 位置;
        "" = 局部名;
        当 (位置 < 行长) {
            (行, 位置, 1)子串 = 字;
            如果 (字 ?= ":") { 位置 = 行长; }
            否则 {
                局部名 + 字 = 局部名;
                位置 + 1 = 位置;
            }
        }
        // 提取类型码（必须在遍历 已声明表 之前，因为 获取行 共享静态缓冲区会覆盖 行）
        (局部名)长度 = 类型码长;
        (行, 类型码长 + 1, 1)子串 = 提取类型码;
        // 跳过已声明（参数/输出）：遍历 已声明表
        0 = 索引2;
        (已声明表)分割行数 = 声明行数;
        0 = 已声明命中;
        当 (索引2 < 声明行数) {
            (已声明表, 索引2)获取行 = 声明行;
            (声明行, 局部名 + ":")字符串开头 = 已声明命中;
            如果 (已声明命中 ?= 1) { 索引2 = 声明行数; }
            否则 { 索引2 + 1 = 索引2; }
        }
        如果 (已声明命中 ?= 0) {
            如果 (提取类型码 ?= "S") { ("char* " + 局部名 + ";")发射; }
            否则如果 (提取类型码 ?= "F") { ("double " + 局部名 + ";")发射; }
            否则 { ("int " + 局部名 + ";")发射; }
        }
        索引 + 1 = 索引;
    }
}

// 发射函数定义（第二遍）
函数 发射函数定义 {
    ()解析函数签名;
    "" = 返回类型C;
    如果 (返回类型名 ?= "整数") { "int " = 返回类型C; }
    否则如果 (返回类型名 ?= "字符串") { "char* " = 返回类型C; }
    否则 { "void " = 返回类型C; }
    // 缓冲函数体
    1 = 缓冲模式;
    "" = 函数体C;
    ()下一个标记;   // {
    ()发射函数体;
    0 = 缓冲模式;
    ()下一个标记;   // }
    // 发射函数
    (返回类型C + 原型名 + "( " + 输入声明C + " )")发射;
    ("{")发射;
    // 局部变量声明：输出参数
    如果 (输出声明C ?= "") {
        // 无输出参数
    } 否则 {
        (输出声明C)发射;
    }
    // 局部变量声明：函数内新局部变量
    ()发射局部声明;
    // 函数体
    (函数体C)发射;
    // 输出参数 return
    如果 (返回类型名 ?= "") {
        // 无输出
    } 否则 {
        ("return " + 输出参数名 + ";")发射;
    }
    ("}")发射;
}

