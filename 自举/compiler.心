// 两遍扫描 (Two Passes)
// ────────────────────────────────────────────

// 第一遍：收集全局变量与函数原型
函数 第一遍 {
    0 = 源位置;
    ()下一个标记;
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "函数") {
            ()收集函数原型;
         } 否则 {
            // 尝试全局声明: 值 = 变量 名 ;
            标记类型 = 保存标记类型;
            标记值 = 保存标记值;
            ()下一个标记;
            如果 (标记值 ?= "=") {
                ()下一个标记;
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                    标记值 = 全局名;
                    ()下一个标记;
                    // 发射全局声明
                    如果 (保存标记类型 ?= 1) {
                        ("int " + 全局名 + " = " + 保存标记值 + ";")发射;
                        (全局名, "I")全局表添加;
                    } 否则 {
                        (保存标记值)转义字符串 = 值C;
                        ("char* " + 全局名 + " = " + 值C + ";")发射;
                        (全局名, "S")全局表添加;
                    }
                    ()下一个标记;   // ;
                } 否则 {
                    ()跳到分号;
                }
            } 否则 {
                ()跳到分号;
            }
        }
    }
}

// 第二遍：发射函数体
函数 第二遍 {
    0 = 源位置;
    ()下一个标记;
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "函数") {
            ()发射函数定义;
        } 否则 {
            // 跳过全局声明（已发射）
            ()跳过表达式;
            ()下一个标记;
            如果 (标记值 ?= "=") {
                ()下一个标记;
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                }
                ()下一个标记;
            } 否则 {
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                    ()下一个标记;
                }
            }
        }
    }
}

