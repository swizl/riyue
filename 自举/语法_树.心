        如果 (默认种类 ?= "真") { "1" = 默认值文本; }
        否则如果 (默认种类 ?= "假") { "0" = 默认值文本; }
        否则如果 (默认文本 ?= "") { "0" = 默认值文本; }
        否则 { 默认文本 = 默认值文本; }
        如果 (输出码 ?= "S") {
