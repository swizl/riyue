// ============================================
// 日月编译器 — AST 发射层 (语法_树.心, S4.4)
// 遍历 自举/解析器.心 构造的扁平节点池 AST，发射 中文 LLVM IR。
// 与 自举/语法.心（token 递归下降版本）语义等价。
// 结果约定：全局 表达式C = 值寄存器/字面量，表达式类型 = 整数/浮点/字符串/函数/数组/结构体/...
// ============================================

导入 "语法树.心";
导入 "发射.心";

// 发射一个表达式节点 -> 表达式C / 表达式类型
函数 (节点:整数)发射表达式 {
    (节点)取种类 = 种;
    如果 (种 ?= "二元运算") { (节点)发射二元; }
    否则如果 (种 ?= "一元运算") { (节点)发射一元; }
    否则如果 (种 ?= "整数") { (节点)发射叶数字; }
    否则如果 (种 ?= "数字") { (节点)发射叶数字; }
    否则如果 (种 ?= "浮点数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "小数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "字符串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "字串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "布尔值") { (节点)发射叶布尔; }
    否则如果 (种 ?= "变量") { (节点)发射变量; }
    否则如果 (种 ?= "标识符") { (节点)发射变量; }
    否则 { (节点)发射表达式兜底; }
}

// 兜底（未实现的表达式种类，占位 0；S4.4 后续补齐）
函数 (节点:整数)发射表达式兜底 {
    "0" = 表达式C;
    "整数" = 表达式类型;
}

函数 (节点:整数)发射叶数字 {
    (节点)取文本 = 表达式C;
    "整数" = 表达式类型;
}

函数 (节点:整数)发射叶浮点 {
    (节点)取文本 = 表达式C;
    "浮点" = 表达式类型;
}

函数 (节点:整数)发射叶字符串 {
    (节点)取文本 = 原文;
    (原文)存字符串常量 = 表达式C;
    "字符串" = 表达式类型;
}

函数 (节点:整数)发射叶布尔 {
    (节点)取文本 = 原文;
    如果 (原文 ?= "真") { "1" = 表达式C; }
    否则 { "0" = 表达式C; }
    "整数" = 表达式类型;
}

// 变量：标量加载 / 闭包名 / 数组地址（结构体/映射/元组成员链在 后缀 中处理）
函数 (节点:整数)发射变量 {
    (节点)取文本 = 名;
    (名)查闭包函数 = 闭包函数名;
    如果 (闭包函数名 ?= "") {
        (名)查类型 = 类型码;
        (名)转义标识符 = 转义;
        如果 (命中全局表 ?= 1) { "@" + 转义 = 地址; }
        否则 { "%" + 转义 = 地址; }
        如果 (类型码 ?= 0) {
            "0" = 表达式C;
            "整数" = 表达式类型;
        } 否则如果 (类型码 ?= 5) {
            地址 = 表达式C;
            "数组" = 表达式类型;
        } 否则如果 (类型码 ?= 2) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "字符串" = 表达式类型;
        } 否则如果 (类型码 ?= 4) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "函数" = 表达式类型;
        } 否则如果 (类型码 ?= 3) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 double, ptr " + 地址 + ", align 8")发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 i32, ptr " + 地址 + ", align 4")发射;
            "整数" = 表达式类型;
        }
    } 否则 {
        "@" + 闭包函数名 = 表达式C;
        "函数" = 表达式类型;
    }
}

函数 (节点:整数)发射一元 {
    (节点)取文本 = 操作符;
    (节点, 0)取子 = 操作数;
    (操作数)发射表达式;
    表达式C = 操作数C;
    表达式类型 = 操作数类型;
    如果 (操作符 ?= "-") {
        如果 (操作数类型 ?= "浮点") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 浮点减 double 0.000000e+00, " + 操作数C)发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 0, " + 操作数C)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (操作符 ?= "!") {
        ()新寄存器 = 比较临时;
        ("  " + 比较临时 + " = 整数比较 eq i32 " + 操作数C + ", 0")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    }
}

函数 (节点:整数)发射二元 {
    (节点)取文本 = 操作符;
    (节点, 0)取子 = 左;
    (节点, 1)取子 = 右;
    (左)发射表达式;
    表达式C = 左C;
    表达式类型 = 左类型;
    (右)发射表达式;
    表达式C = 右C;
    表达式类型 = 右类型;
    如果 (操作符 ?= "||") {
        (左C, 右C)发射布尔或;
    } 否则如果 (操作符 ?= "&&") {
        (左C, 右C)发射布尔与;
    } 否则如果 (操作符 ?= ">") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "<") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= ">=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "<=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "==") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "!=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "?=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则 {
        (操作符, 左C, 左类型, 右C, 右类型)发射算术;
    }
}

函数 (左:字符串, 右:字符串)发射布尔或 {
    ()新寄存器 = 左布尔;
    ("  " + 左布尔 + " = 整数比较 ne i32 " + 左 + ", 0")发射;
    ()新寄存器 = 右布尔;
    ("  " + 右布尔 + " = 整数比较 ne i32 " + 右 + ", 0")发射;
    ()新寄存器 = 或结果;
    ("  " + 或结果 + " = 或 i1 " + 左布尔 + ", " + 右布尔)发射;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 或结果 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (左:字符串, 右:字符串)发射布尔与 {
    ()新寄存器 = 左布尔;
    ("  " + 左布尔 + " = 整数比较 ne i32 " + 左 + ", 0")发射;
    ()新寄存器 = 右布尔;
    ("  " + 右布尔 + " = 整数比较 ne i32 " + 右 + ", 0")发射;
    ()新寄存器 = 与结果;
    ("  " + 与结果 + " = 与 i1 " + 左布尔 + ", " + 右布尔)发射;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 与结果 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 左类型:字符串, 右:字符串, 右类型:字符串)发射比较 {
    如果 (左类型 ?= "字符串") { (操作符, 左, 右)发射比较字符串; }
    否则如果 (右类型 ?= "字符串") { (操作符, 左, 右)发射比较字符串; }
    否则如果 (左类型 ?= "浮点") { (操作符, 左, 右)发射比较浮点; }
    否则如果 (右类型 ?= "浮点") { (操作符, 左, 右)发射比较浮点; }
    否则 {
        ()新寄存器 = 比较临时;
        如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 左 + ", " + 右)发射; }
        否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 左 + ", " + 右)发射; }
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    }
}

函数 (操作符:字符串, 左:字符串, 右:字符串)发射比较字符串 {
    ()新寄存器 = 调用临时;
    ("  " + 调用临时 + " = 调用 i32 (ptr, ptr) @strcmp(ptr " + 左 + ", ptr " + 右 + ")")发射;
    ()新寄存器 = 比较临时;
    如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 调用临时 + ", 0")发射; }
    否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 调用临时 + ", 0")发射; }
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 右:字符串)发射比较浮点 {
    (左, "浮点")提升浮点 = 左提升;
    (右, "浮点")提升浮点 = 右提升;
    ()新寄存器 = 比较临时;
    如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 浮点比较 oeq double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 浮点比较 une double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 浮点比较 ogt double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 浮点比较 olt double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 浮点比较 oge double " + 左提升 + ", " + 右提升)发射; }
    否则 { ("  " + 比较临时 + " = 浮点比较 ole double " + 左提升 + ", " + 右提升)发射; }
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 左类型:字符串, 右:字符串, 右类型:字符串)发射算术 {
    如果 (操作符 ?= "+") {
        如果 (左类型 ?= "字符串") { (左, 右)发射拼接; }
        否则如果 (右类型 ?= "字符串") { (左, 右)发射拼接; }
        否则如果 (左类型 ?= "浮点") { (操作符, 左, 右)发射浮点算术; }
        否则如果 (右类型 ?= "浮点") { (操作符, 左, 右)发射浮点算术; }
        否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加 i32 " + 左 + ", " + 右)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (操作符 ?= "-") {
        如果 (左类型 ?= "浮点") { (操作符, 左, 右)发射浮点算术; }
        否则如果 (右类型 ?= "浮点") { (操作符, 左, 右)发射浮点算术; }
        否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 " + 左 + ", " + 右)发射;
            "整数" = 表达式类型;
        }
    } 否则 {
        如果 (左类型 ?= "浮点") { (操作符, 左, 右)发射浮点算术; }
        否则如果 (右类型 ?= "浮点") { (操作符, 左, 右)发射浮点算术; }
        否则 {
            ()新寄存器 = 表达式C;
            如果 (操作符 ?= "*") { ("  " + 表达式C + " = 乘 i32 " + 左 + ", " + 右)发射; }
            否则如果 (操作符 ?= "/") { ("  " + 表达式C + " = 有符号除 i32 " + 左 + ", " + 右)发射; }
            否则 { ("  " + 表达式C + " = 有符号取余 i32 " + 左 + ", " + 右)发射; }
            "整数" = 表达式类型;
        }
    }
}

函数 (左:字符串, 右:字符串)发射拼接 {
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + ("辅助拼接")转义标识符 + "(ptr " + 左 + ", ptr " + 右 + ")")发射;
    "字符串" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 右:字符串)发射浮点算术 {
    (左, "浮点")提升浮点 = 左提升;
    (右, "浮点")提升浮点 = 右提升;
    ()新寄存器 = 表达式C;
    如果 (操作符 ?= "+") { ("  " + 表达式C + " = 浮点加 double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "-") { ("  " + 表达式C + " = 浮点减 double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "*") { ("  " + 表达式C + " = 浮点乘 double " + 左提升 + ", " + 右提升)发射; }
    否则 { ("  " + 表达式C + " = 浮点除 double " + 左提升 + ", " + 右提升)发射; }
    "浮点" = 表达式类型;
}
