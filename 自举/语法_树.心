// ============================================
// 日月编译器 — AST 发射层 (语法_树.心, S4.4)
// 遍历 自举/解析器.心 构造的扁平节点池 AST，发射 中文 LLVM IR。
// 与 自举/语法.心（token 递归下降版本）语义等价。
// 结果约定：全局 表达式C = 值寄存器/字面量，表达式类型 = 整数/浮点/字符串/函数/数组/结构体/...
// ============================================

导入 "语法树.心";
导入 "发射.心";

// 发射一个表达式节点 -> 表达式C / 表达式类型
函数 (节点:整数)发射表达式 {
    (节点)取种类 = 种;
    如果 (种 ?= "二元运算") { (节点)发射二元; }
    否则如果 (种 ?= "一元运算") { (节点)发射一元; }
    否则如果 (种 ?= "整数") { (节点)发射叶数字; }
    否则如果 (种 ?= "数字") { (节点)发射叶数字; }
    否则如果 (种 ?= "浮点数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "小数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "字符串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "字串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "布尔值") { (节点)发射叶布尔; }
    否则如果 (种 ?= "变量") { (节点)发射变量; }
    否则如果 (种 ?= "标识符") { (节点)发射变量; }
    否则如果 (种 ?= "函数调用") { (节点)发射调用; }
    否则如果 (种 ?= "后缀") { (节点)发射后缀; }
    否则如果 (种 ?= "条件表达式") { (节点)发射条件表达式; }
    否则如果 (种 ?= "元组") { (节点)发射元组; }
    否则如果 (种 ?= "数组字面") { (节点)发射数组字面; }
    否则如果 (种 ?= "映射字面") { (节点)发射映射字面; }
    否则 { (节点)发射表达式兜底; }
}

// 兜底（未实现的表达式种类，占位 0；S4.4 后续补齐）
函数 (节点:整数)发射表达式兜底 {
    "0" = 表达式C;
    "整数" = 表达式类型;
}

函数 (节点:整数)发射叶数字 {
    (节点)取文本 = 表达式C;
    "整数" = 表达式类型;
}

函数 (节点:整数)发射叶浮点 {
    (节点)取文本 = 表达式C;
    "浮点" = 表达式类型;
}

// 字符串字面量：去掉包围引号（插串的 f 前缀）并解码转义，旧词法器行为一致
函数 (原文:字符串)解码字面(0 = 结果:字符串) {
    (原文)长度 = 原长;
    0 = 起i;
    (原文, 0, 1)子串 = 首字;
    如果 (首字 ?= "f") { 1 = 起i; }
    起i + 1 = 内容起;
    原长 - 内容起 - 1 = 内容长;
    如果 (内容长 < 0) { "" = 结果; }
    否则 {
        (原文, 内容起, 内容长)子串 = 内部;
        (内部)解码转义 = 结果;
    }
}

函数 (文本:字符串)解码转义(0 = 结果:字符串) {
    (文本)长度 = 文本长;
    0 = 转i;
    "" = 结果;
    当 (转i < 文本长) {
        (文本, 转i, 1)子串 = 字;
        (字, 0)字符码 = 码;
        如果 (码 ?= 92) {
            转i + 1 = 转i;
            如果 (转i < 文本长) {
                (文本, 转i, 1)子串 = 转字;
                (转字, 0)字符码 = 转码;
                如果 (转码 ?= 110) { 结果 + "\n" = 结果; }
                否则如果 (转码 ?= 116) { 结果 + "\t" = 结果; }
                否则 { 结果 + 转字 = 结果; }
            }
        } 否则 {
            结果 + 字 = 结果;
        }
        转i + 1 = 转i;
    }
}

函数 (节点:整数)发射叶字符串 {
    (节点)取文本 = 原文;
    (原文)解码字面 = 文本值;
    (文本值)存字符串常量 = 表达式C;
    "字符串" = 表达式类型;
}

函数 (节点:整数)发射叶布尔 {
    (节点)取文本 = 原文;
    如果 (原文 ?= "真") { "1" = 表达式C; }
    否则 { "0" = 表达式C; }
    "整数" = 表达式类型;
}

// 变量：标量加载 / 闭包名 / 数组地址（结构体/映射/元组成员链在 后缀 中处理）
函数 (节点:整数)发射变量 {
    (节点)取文本 = 名;
    (名)查闭包函数 = 闭包函数名;
    如果 (闭包函数名 ?= "") {
        (名)查类型 = 类型码;
        (名)转义标识符 = 转义;
        如果 (命中全局表 ?= 1) { "@" + 转义 = 地址; }
        否则 { "%" + 转义 = 地址; }
        如果 (类型码 ?= 0) {
            "0" = 表达式C;
            "整数" = 表达式类型;
        } 否则如果 (类型码 ?= 5) {
            名 = 当前数组名;
            0 = 链式数组标志;
            地址 = 表达式C;
            "数组" = 表达式类型;
        } 否则如果 (类型码 ?= 6) {
            (名)查结构体变量类型 = 当前结构体名;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "结构体" = 表达式类型;
        } 否则如果 (类型码 ?= 7) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "映射" = 表达式类型;
        } 否则如果 (类型码 ?= 8) {
            (名)查元组类型 = 元组_类型体;
            名 = 元组_基名;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "元组" = 表达式类型;
        } 否则如果 (类型码 ?= 2) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "字符串" = 表达式类型;
        } 否则如果 (类型码 ?= 4) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 ptr, ptr " + 地址 + ", align 8")发射;
            "函数" = 表达式类型;
        } 否则如果 (类型码 ?= 3) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 double, ptr " + 地址 + ", align 8")发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 i32, ptr " + 地址 + ", align 4")发射;
            "整数" = 表达式类型;
        }
    } 否则 {
        "@" + 闭包函数名 = 表达式C;
        "函数" = 表达式类型;
    }
}

函数 (节点:整数)发射一元 {
    (节点)取文本 = 操作符;
    (节点, 0)取子 = 操作数;
    (操作数)发射表达式;
    表达式C = 操作数C;
    表达式类型 = 操作数类型;
    如果 (操作符 ?= "-") {
        如果 (操作数类型 ?= "浮点") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 浮点减 double 0.000000e+00, " + 操作数C)发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 0, " + 操作数C)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (操作符 ?= "!") {
        ()新寄存器 = 比较临时;
        ("  " + 比较临时 + " = 整数比较 eq i32 " + 操作数C + ", 0")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    }
}

函数 (节点:整数)发射二元 {
    (节点)取文本 = 操作符;
    (节点, 0)取子 = 左;
    (节点, 1)取子 = 右;
    (左)发射表达式;
    表达式C = 左C;
    表达式类型 = 左类型;
    (右)发射表达式;
    表达式C = 右C;
    表达式类型 = 右类型;
    如果 (操作符 ?= "||") {
        (左C, 右C)发射布尔或;
    } 否则如果 (操作符 ?= "&&") {
        (左C, 右C)发射布尔与;
    } 否则如果 (操作符 ?= ">") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "<") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= ">=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "<=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "==") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "!=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则如果 (操作符 ?= "?=") {
        (操作符, 左C, 左类型, 右C, 右类型)发射比较;
    } 否则 {
        (操作符, 左C, 左类型, 右C, 右类型)发射算术;
    }
}

函数 (左:字符串, 右:字符串)发射布尔或 {
    ()新寄存器 = 左布尔;
    ("  " + 左布尔 + " = 整数比较 ne i32 " + 左 + ", 0")发射;
    ()新寄存器 = 右布尔;
    ("  " + 右布尔 + " = 整数比较 ne i32 " + 右 + ", 0")发射;
    ()新寄存器 = 或结果;
    ("  " + 或结果 + " = 或 i1 " + 左布尔 + ", " + 右布尔)发射;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 或结果 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (左:字符串, 右:字符串)发射布尔与 {
    ()新寄存器 = 左布尔;
    ("  " + 左布尔 + " = 整数比较 ne i32 " + 左 + ", 0")发射;
    ()新寄存器 = 右布尔;
    ("  " + 右布尔 + " = 整数比较 ne i32 " + 右 + ", 0")发射;
    ()新寄存器 = 与结果;
    ("  " + 与结果 + " = 与 i1 " + 左布尔 + ", " + 右布尔)发射;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 与结果 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 左类型:字符串, 右:字符串, 右类型:字符串)发射比较 {
    如果 (左类型 ?= "字符串") { (操作符, 左, 右)发射比较字符串; }
    否则如果 (右类型 ?= "字符串") { (操作符, 左, 右)发射比较字符串; }
    否则如果 (左类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射比较浮点; }
    否则如果 (右类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射比较浮点; }
    否则 {
        ()新寄存器 = 比较临时;
        如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 左 + ", " + 右)发射; }
        否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 左 + ", " + 右)发射; }
        否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 左 + ", " + 右)发射; }
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    }
}

函数 (操作符:字符串, 左:字符串, 右:字符串)发射比较字符串 {
    ()新寄存器 = 调用临时;
    ("  " + 调用临时 + " = 调用 i32 (ptr, ptr) @strcmp(ptr " + 左 + ", ptr " + 右 + ")")发射;
    ()新寄存器 = 比较临时;
    如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 调用临时 + ", 0")发射; }
    否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 调用临时 + ", 0")发射; }
    否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 调用临时 + ", 0")发射; }
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 左类型:字符串, 右:字符串, 右类型:字符串)发射比较浮点 {
    (左, 左类型)提升浮点 = 左提升;
    (右, 右类型)提升浮点 = 右提升;
    ()新寄存器 = 比较临时;
    如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 浮点比较 oeq double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 浮点比较 une double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 浮点比较 ogt double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 浮点比较 olt double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 浮点比较 oge double " + 左提升 + ", " + 右提升)发射; }
    否则 { ("  " + 比较临时 + " = 浮点比较 ole double " + 左提升 + ", " + 右提升)发射; }
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
    "整数" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 左类型:字符串, 右:字符串, 右类型:字符串)发射算术 {
    如果 (操作符 ?= "+") {
        如果 (左类型 ?= "字符串") { (左, 右)发射拼接; }
        否则如果 (右类型 ?= "字符串") { (左, 右)发射拼接; }
        否则如果 (左类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射浮点算术; }
        否则如果 (右类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射浮点算术; }
        否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加 i32 " + 左 + ", " + 右)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (操作符 ?= "-") {
        如果 (左类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射浮点算术; }
        否则如果 (右类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射浮点算术; }
        否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 " + 左 + ", " + 右)发射;
            "整数" = 表达式类型;
        }
    } 否则 {
        如果 (左类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射浮点算术; }
        否则如果 (右类型 ?= "浮点") { (操作符, 左, 左类型, 右, 右类型)发射浮点算术; }
        否则 {
            ()新寄存器 = 表达式C;
            如果 (操作符 ?= "*") { ("  " + 表达式C + " = 乘 i32 " + 左 + ", " + 右)发射; }
            否则如果 (操作符 ?= "/") { ("  " + 表达式C + " = 有符号除 i32 " + 左 + ", " + 右)发射; }
            否则 { ("  " + 表达式C + " = 有符号取余 i32 " + 左 + ", " + 右)发射; }
            "整数" = 表达式类型;
        }
    }
}

函数 (左:字符串, 右:字符串)发射拼接 {
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + ("辅助拼接")转义标识符 + "(ptr " + 左 + ", ptr " + 右 + ")")发射;
    "字符串" = 表达式类型;
}

函数 (操作符:字符串, 左:字符串, 左类型:字符串, 右:字符串, 右类型:字符串)发射浮点算术 {
    (左, 左类型)提升浮点 = 左提升;
    (右, 右类型)提升浮点 = 右提升;
    ()新寄存器 = 表达式C;
    如果 (操作符 ?= "+") { ("  " + 表达式C + " = 浮点加 double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "-") { ("  " + 表达式C + " = 浮点减 double " + 左提升 + ", " + 右提升)发射; }
    否则如果 (操作符 ?= "*") { ("  " + 表达式C + " = 浮点乘 double " + 左提升 + ", " + 右提升)发射; }
