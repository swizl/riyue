        (映射_键明文)存字符串常量 = 映射_键;
        映射_i + 1 = 映射_i;
        (节点, 映射_i)取子 = 值节点;
        (值节点)发射表达式;
        如果 (表达式类型 ?= "字符串") { 表达式C = 映射_值; }
        否则 {
            ()新寄存器 = 映射_值;
            ("  " + 映射_值 + " = 调用 指针 (整数32) @" + ("辅助转字符串")转义标识符 + "(整数32 " + 表达式C + ")")发射;
        }
        ()新寄存器 = 映射_大小值;
        ("  " + 映射_大小值 + " = 加载 整数32, 指针 " + 映射_大小分配 + ", 对齐 4")发射;
        ()新寄存器 = 映射_新大小;
        ("  " + 映射_新大小 + " = 调用 整数32 (指针, 指针, 整数32, 指针, 指针) @映射设置(指针 " + 映射_键数组地址 + ", 指针 " + 映射_值数组地址 + ", 整数32 " + 映射_大小值 + ", 指针 " + 映射_键 + ", 指针 " + 映射_值 + ")")发射;
        ("  存储 整数32 " + 映射_新大小 + ", 指针 " + 映射_大小分配 + ", 对齐 4")发射;
