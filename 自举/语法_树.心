                    (类型参数约束子)取种类 = 类型参数约束子种;
                    如果 (类型参数约束子种 ?= "类型") {
                        (类型参数约束子)取文本 = 本类型参数约束名原始;
                        (本类型参数约束名原始)长度 = 本类型参数约束名长;
                        (本类型参数约束名原始, 0, 本类型参数约束名长)子串 = 本类型参数约束名;
                    } 否则如果 (类型参数约束子种 ?= "加竖约束项") {
