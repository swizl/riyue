    (如果真标签)发射标签;
    (节点, 1)取子 = 如果体;
    (如果体)发射代码块;
    ("分支 标签 %" + 如果合并标签)发射终结;
    (如果假标签)发射标签;
    2 = 如果i;
    0 = 如果有否则;
    当 (如果i < 如果子数) {
        (节点, 如果i)取子 = 如果子;
        (如果子)取种类 = 如果子种;
        如果 (如果子种 ?= "代码块") {
            1 = 如果有否则;
            (如果子)发射代码块;
            ("分支 标签 %" + 如果合并标签)发射终结;
            如果i = 如果子数;
        } 否则 {
            (如果子)发射表达式;
            ()发射条件;
            ()新标签 = 如果真标签;
            ()新标签 = 如果假标签;
            ("分支 整数1 " + 当前条件 + ", 标签 %" + 如果真标签 + ", 标签 %" + 如果假标签)发射终结;
            (如果真标签)发射标签;
            如果i + 1 = 如果i;
            (节点, 如果i)取子 = 如果体;
            (如果体)发射代码块;
            ("分支 标签 %" + 如果合并标签)发射终结;
            (如果假标签)发射标签;
            如果i + 1 = 如果i;
        }
    }
    如果 (如果有否则 ?= 0) {
        ("分支 标签 %" + 如果合并标签)发射终结;
