// 预扫描：收集类型别名（整数 = 整数别名:类型;）→ 类型别名表 名:基名
函数 (节点:整数)收集类型别名节点 {
    0 = 顶层别名i;
    (节点)取子数 = 顶层别名数;
    当 (顶层别名i < 顶层别名数) {
        (节点, 顶层别名i)取子 = 顶层别名节点;
        (顶层别名节点)取种类 = 顶层别名种;
        如果 (顶层别名种 ?= "类型别名") {
            "" = 别名基名;
            "" = 别名名;
            0 = 别名子i;
            (顶层别名节点)取子数 = 别名子数;
            当 (别名子i < 别名子数) {
                (顶层别名节点, 别名子i)取子 = 别名子;
                (别名子)取种类 = 别名子种;
                如果 (别名子种 ?= "类型") {
                    如果 (别名基名 ?= "") { (别名子)取文本 = 别名基名; }
                } 否则如果 (别名子种 ?= "标识符") {
                    如果 (别名名 ?= "") { (别名子)取文本 = 别名名; }
                }
                别名子i + 1 = 别名子i;
            }
            如果 (别名名 != "") {
                如果 (别名基名 != "") {
                    (类型别名表, 别名名, 别名基名)表添加 = 类型别名表;
                }
            }
        }
        顶层别名i + 1 = 顶层别名i;
    }
}

函数 发射输出参数声明 {
    0 = 索引;
    (输出参数表)文本表键数 = 行数;
    当 (索引 < 行数) {
        (输出参数表, 索引)文本表键 = 输出名;
        (输出参数表, 输出名)文本表取 = 输出码;
        (输出名)转义标识符 = 输出转义;
        (输出默认表, 输出名)查表值 = 默认文本;
        (输出默认种类, 输出名)查表值 = 默认种类;
        // 槽位类型由声明的输出码决定（与宿主一致）；默认字面仅决定初值。
        // 注意：字符串输出惯用 (0 = 结果:字符串)，其中 0 只是占位符，应按空指针处理，
        // 不可因字面为整数而分配 整数32 槽位（会导致指针写入 4 字节槽位的类型/内存错乱）。
        "0" = 默认值文本;
        如果 (默认种类 ?= "真") { "1" = 默认值文本; }
        否则如果 (默认种类 ?= "假") { "0" = 默认值文本; }
        否则如果 (默认文本 ?= "") { "0" = 默认值文本; }
        否则 { 默认文本 = 默认值文本; }
        如果 (输出码 ?= "S") {
            ("%" + 输出转义 + " = 分配 指针, 对齐 8")发射;
            如果 (默认种类 ?= "字串") {
                (默认文本)解码字面 = 默认解码;
                (默认解码)存字符串常量 = 默认常量;
                ("存储 指针 " + 默认常量 + ", 指针 %" + 输出转义 + ", 对齐 8")发射;
            } 否则 {
                ("存储 指针 空指针, 指针 %" + 输出转义 + ", 对齐 8")发射;
            }
        } 否则如果 (输出码 ?= "C" || 输出码 ?= "O" || 输出码 ?= "M" || 输出码 ?= "T" || 输出码 ?= "A") {
            ("%" + 输出转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 空指针, 指针 %" + 输出转义 + ", 对齐 8")发射;
        } 否则如果 (输出码 ?= "F") {
            ("%" + 输出转义 + " = 分配 双精度, 对齐 8")发射;
            如果 (默认种类 ?= "小数") {
                ("存储 双精度 " + 默认文本 + ", 指针 %" + 输出转义 + ", 对齐 8")发射;
            } 否则 {
                ("存储 双精度 0.000000e+00, 指针 %" + 输出转义 + ", 对齐 8")发射;
            }
        } 否则如果 (输出码 ?= "G") {
            ("%" + 输出转义 + " = 分配 单精度, 对齐 4")发射;
            如果 (默认种类 ?= "小数") {
                ("存储 单精度 " + 默认文本 + ", 指针 %" + 输出转义 + ", 对齐 4")发射;
            } 否则 {
                ("存储 单精度 0.000000e+00, 指针 %" + 输出转义 + ", 对齐 4")发射;
            }
        } 否则如果 (输出码 ?= "B") {
            ("%" + 输出转义 + " = 分配 整数8, 对齐 1")发射;
            ("存储 整数8 " + 默认值文本 + ", 指针 %" + 输出转义 + ", 对齐 1")发射;
        } 否则如果 (输出码 ?= "H") {
            ("%" + 输出转义 + " = 分配 整数16, 对齐 2")发射;
            ("存储 整数16 " + 默认值文本 + ", 指针 %" + 输出转义 + ", 对齐 2")发射;
        } 否则如果 (输出码 ?= "J") {
            ("%" + 输出转义 + " = 分配 整数64, 对齐 8")发射;
            ("存储 整数64 " + 默认值文本 + ", 指针 %" + 输出转义 + ", 对齐 8")发射;
        } 否则 {
            ("%" + 输出转义 + " = 分配 整数32, 对齐 4")发射;
            ("存储 整数32 " + 默认值文本 + ", 指针 %" + 输出转义 + ", 对齐 4")发射;
        }
        索引 + 1 = 索引;
    }
}

