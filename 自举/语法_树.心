        (保存存储值, 表达式IR, 存储IR)转换IR = 存储值C;
        "" = 存储对齐;
        如果 (存储IR ?= "整数8") { "1" = 存储对齐; }
        否则如果 (存储IR ?= "整数16") { "2" = 存储对齐; }
        否则如果 (存储IR ?= "整数64") { "8" = 存储对齐; }
        否则 { "4" = 存储对齐; }
        ("存储 " + 存储IR + " " + 存储值C + ", 指针 " + 目标地址 + ", 对齐 " + 存储对齐)发射;
    } 否则如果 (表达式类型 ?= "数组") {
        (数组元素码)数组元素转IR = 数组元素IR;
        ()新寄存器 = 数组字节;
        ("  " + 数组字节 + " = 零扩展 整数32 " + 数组大小文本 + " 到 整数64")发射;
        ()新寄存器 = 数组字节2;
        0 = 是宽元素;
        如果 (数组元素码 ?= "S") { 1 = 是宽元素; }
        如果 (数组元素码 ?= "F") { 1 = 是宽元素; }
        如果 (是宽元素 ?= 1) { ("  " + 数组字节2 + " = 乘 整数64 " + 数组字节 + ", 8")发射; }
        否则 { ("  " + 数组字节2 + " = 乘 整数64 " + 数组字节 + ", 4")发射; }
        ("调用 指针 (指针, 指针, 整数64) @memcpy(指针 " + 目标地址 + ", 指针 " + 保存存储值 + ", 整数64 " + 数组字节2 + ")")发射;
    } 否则如果 (表达式类型 ?= "结构体") {
        ("存储 指针 " + 保存存储值 + ", 指针 " + 目标地址 + ", 对齐 8")发射;
    } 否则如果 (表达式类型 ?= "映射") {
        ("存储 指针 " + 保存存储值 + ", 指针 " + 目标地址 + ", 对齐 8")发射;
    } 否则如果 (表达式类型 ?= "元组") {
        ("存储 指针 " + 保存存储值 + ", 指针 " + 目标地址 + ", 对齐 8")发射;
    } 否则如果 (表达式类型 ?= "动态数组" || 表达式类型 ?= "动态字符串数组") {
        ("存储 指针 " + 保存存储值 + ", 指针 " + 目标地址 + ", 对齐 8")发射;
    } 否则 {
        (保存存储值, 表达式IR, 存储IR)转换IR = 存储值C;
        ("存储 " + 存储IR + " " + 存储值C + ", 指针 " + 目标地址 + ", 对齐 4")发射;
    }
}

函数 (值节点:整数, 目标名:字符串, 下标节点:整数)发射下标写 {
    // 内存安全 §八 O3：借用期内禁止修改源（下标写与只读借用冲突）。
    (目标名)是借用源 = 下标写借用命中;
    如果 (下标写借用命中 ?= 1) {
        "借用期内不可修改源: " + 目标名 = 下标写借用消息;
        (下标写借用消息)借用报错;
    }
    (值节点)发射表达式;
    表达式C = 保存存储值;
    (下标节点)发射表达式;
    表达式C = 保存下标;
    (目标名)查类型 = 下标写类型码;
    // 内存安全 §4.3 A.3 视图不可逃逸：不得把切片视图存入堆容器（映射）。
    如果 (下标写类型码 ?= 7) {
        (值节点)是视图节点 = 下标写是视图;
        如果 (下标写是视图 ?= 1) {
            "不能把切片视图存入堆容器（映射 '" + 目标名 + "'）" = 映射逃逸说明;
            (映射逃逸说明)视图逃逸报错;
        }
    }
    如果 (下标写类型码 ?= 10 || 下标写类型码 ?= 11) {
        // 内存安全 §4.3 A.2 / S4：动态数组（含 字符串[]/文字[]）元素写入按元素码分派。
        (目标名)转义标识符 = 下标写转义;
        如果 (命中全局表 ?= 1) { "@" + 下标写转义 = 下标写地址; }
        否则 { "%" + 下标写转义 = 下标写地址; }
        ()新寄存器 = 下标写加载;
        ("  " + 下标写加载 + " = 加载 指针, 指针 " + 下标写地址 + ", 对齐 8")发射;
        (目标名)查动态数组元素码 = 下标写元素码;
        如果 (下标写元素码 ?= "") {
            如果 (下标写类型码 ?= 11) { "S" = 下标写元素码; }
            否则 { "I" = 下标写元素码; }
        }
        如果 (下标写元素码 ?= "S") {
            ()新寄存器 = 胖_解包临;
            ("  " + 胖_解包临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 保存存储值 + ")")发射;
            ("调用 空类型 (指针, 整数32, 指针) @动态字符串数组索引设置(指针 " + 下标写加载 + ", 整数32 " + 保存下标 + ", 指针 " + 胖_解包临 + ")")发射;
        } 否则 {
            ("调用 空类型 (指针, 整数32, 整数32) @动态数组索引设置(指针 " + 下标写加载 + ", 整数32 " + 保存下标 + ", 整数32 " + 保存存储值 + ")")发射;
        }
    } 否则如果 (下标写类型码 ?= 13) {
        // 内存安全 §八 O3-2c1/O3-2c3：只读切片视图禁写；可变切片视图放行（经运行时写入口直达借用源存储）。
        (可变视图表, 目标名)文本表含 = 视图写可变更;
        如果 (视图写可变更 ?= 0) {
            "不可写入只读视图: " + 目标名 = 视图写消息;
            (视图写消息)借用报错;
        } 否则 {
            (目标名)转义标识符 = 视图写转义;
            如果 (命中全局表 ?= 1) { "@" + 视图写转义 = 视图写地址; }
            否则 { "%" + 视图写转义 = 视图写地址; }
            ()新寄存器 = 视图写加载;
            ("  " + 视图写加载 + " = 加载 指针, 指针 " + 视图写地址 + ", 对齐 8")发射;
            (目标名)查切片元素码 = 视图写元素码;
            如果 (视图写元素码 ?= "S") {
                ()新寄存器 = 视图写胖临;
                ("  " + 视图写胖临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 保存存储值 + ")")发射;
                ("调用 空类型 (指针, 整数32, 指针) @切片设置指针(指针 " + 视图写加载 + ", 整数32 " + 保存下标 + ", 指针 " + 视图写胖临 + ")")发射;
            } 否则 {
                ("调用 空类型 (指针, 整数32, 整数32) @切片设置整数(指针 " + 视图写加载 + ", 整数32 " + 保存下标 + ", 整数32 " + 保存存储值 + ")")发射;
            }
        }
    } 否则如果 (下标写类型码 ?= 25) {
        // 阶段4B：变长形参元素写 —— alloca 存指向 整数32 数组的指针，先加载再按整数32 GEP。
        (目标名)转义标识符 = 变长写转义;
        如果 (命中全局表 ?= 1) { "@" + 变长写转义 = 变长写地址; }
        否则 { "%" + 变长写转义 = 变长写地址; }
        ()新寄存器 = 变长写加载;
        ("  " + 变长写加载 + " = 加载 指针, 指针 " + 变长写地址 + ", 对齐 8")发射;
        ()新寄存器 = 变长写元素地址;
        ("  " + 变长写元素地址 + " = 获取元素指针 整数32, 指针 " + 变长写加载 + ", 整数32 " + 保存下标)发射;
        ("  存储 整数32 " + 保存存储值 + ", 指针 " + 变长写元素地址 + ", 对齐 4")发射;
    } 否则 {
    (目标名)查数组大小 = 数组大小文本;
    (目标名)查数组元素码 = 数组元素码;
    (数组元素码)数组元素转IR = 数组元素IR;
    (数组元素码)数组对齐 = 数组对齐值;
    (目标名)转义标识符 = 目标转义;
    如果 (命中全局表 ?= 1) { "@" + 目标转义 = 目标地址; }
    否则 { "%" + 目标转义 = 目标地址; }
    ()新寄存器 = 下标扩展;
    ("  " + 下标扩展 + " = 零扩展 整数32 " + 保存下标 + " 到 整数64")发射;
    (数组大小文本)发射越界检查;
    ()新寄存器 = 元素指针;
    ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 指针 " + 目标地址 + ", 整数64 0, 整数64 " + 下标扩展)发射;
    ("  存储 " + 数组元素IR + " " + 保存存储值 + ", 指针 " + 元素指针 + ", 对齐 " + 数组对齐值)发射;
    }
}

函数 (值节点:整数, 目标名:字符串, 成员名:字符串)发射成员写 {
    (值节点)发射表达式;
    表达式C = 保存存储值;
    (目标名)查结构体变量类型 = 当前结构体名;
    (目标名)转义标识符 = 目标转义;
    如果 (命中全局表 ?= 1) { "@" + 目标转义 = 目标地址; }
    否则 { "%" + 目标转义 = 目标地址; }
    ()新寄存器 = 链式地址;
    ("  " + 链式地址 + " = 加载 指针, 指针 " + 目标地址 + ", 对齐 8")发射;
    (当前结构体名, 成员名)查结构体成员索引 = 结构体成员索引;
    (当前结构体名, 成员名)查结构体成员类型 = 结构体成员类型;
    ()新寄存器 = 成员指针;
    ("  " + 成员指针 + " = 获取元素指针 %" + 当前结构体名 + ", 指针 " + 链式地址 + ", 整数32 0, 整数32 " + 结构体成员索引)发射;
    如果 (结构体成员类型 ?= "整数") {
        ("  存储 整数32 " + 保存存储值 + ", 指针 " + 成员指针 + ", 对齐 4")发射;
    } 否则如果 (结构体成员类型 ?= "字符串") {
        ("  存储 指针 " + 保存存储值 + ", 指针 " + 成员指针 + ", 对齐 8")发射;
    } 否则如果 (结构体成员类型 ?= "浮点") {
        ("  存储 双精度 " + 保存存储值 + ", 指针 " + 成员指针 + ", 对齐 8")发射;
    }     否则 {
        ("  存储 指针 " + 保存存储值 + ", 指针 " + 成员指针 + ", 对齐 8")发射;
    }
}

// ============================================
// 顶层发射 (S4.4c)
// ============================================

0 = 变量 函数体节点;
0 = 变量 签名i;
0 = 变量 顶层i;

// ============================================
// 内存安全 §4.3 阶段A：三形态类型语法（T[N] 定长 / T[] 动态 / T[:] 切片）
// 归一化叶文本形如 "整数[3]" / "整数[]" / "整数[:]"。
// ============================================

// 类型后缀：返回 "[]" / "[:]" / "[可变:]" / "[N]" / ""（无后缀）。
函数 (类型名:字符串)类型后缀(0 = 结果:字符串) {
    "" = 结果;
    (类型名, "[可变:]")字符串结尾 = 后缀尾可变;
    (类型名, "[:]")字符串结尾 = 后缀尾切片;
    (类型名, "[]")字符串结尾 = 后缀尾动态;
    (类型名)长度 = 后缀判长;
    "" = 后缀末字;
    如果 (后缀判长 > 0) { (类型名, 后缀判长 - 1, 1)子串 = 后缀末字; }
    如果 (后缀尾可变 != 0) { "[可变:]" = 结果; }
    否则如果 (后缀尾切片 != 0) { "[:]" = 结果; }
    否则如果 (后缀尾动态 != 0) { "[]" = 结果; }
    否则如果 (后缀末字 ?= "]") { "[N]" = 结果; }
}

// ============================================
// 内存安全 §4.3 A.3 视图不可逃逸（S5）
// 切片 T[:] 是借来的视图，其生命周期不得长于被切来源所在函数帧；
// 编译期禁止 4 类逃逸：函数返回类型 / 结构体成员 / 全局变量 / 存入堆容器。
// ============================================

// 类型名含切片后缀 `[:]` 或可变切片后缀 `[可变:]` 即视图（借用）。
函数 (类型文本:字符串)是视图类型名(0 = 结果:整数) {
    0 = 结果;
    (类型文本)类型后缀 = 视图判后缀;
    如果 (视图判后缀 ?= "[:]") { 1 = 结果; }
    否则如果 (视图判后缀 ?= "[可变:]") { 1 = 结果; }
}

// 表达式节点是否为切片视图来源：分片访问节点（"分片"）直接是视图；
// 变量引用节点（"变量"）若登记于 切片表（T[:] 注解登记）亦为视图变量。
函数 (节点:整数)是视图节点(0 = 结果:整数) {
    0 = 结果;
    (节点)取种类 = 视图节点种;
    如果 (视图节点种 ?= "分片") { 1 = 结果; }
    否则如果 (视图节点种 ?= "变量") {
        (节点)取文本 = 视图节点名;
        (切片表, 视图节点名)查表值 = 视图节点码;
        如果 (视图节点码 != "") { 1 = 结果; }
    }
}

// 报错并置编译失败标志（与既有 输出错误 / 未声明出错 机制一致）。
函数 (说明:字符串)视图逃逸报错 {
    "视图不可逃逸: " + 说明 = 逃逸消息;
    (逃逸消息)输出错误;
    1 = 未声明出错;
}

// 内存安全 §八 O3：源容器是否处于只读借用期（遍历 借用视图源表，命中源名即真）。
函数 (源名:字符串)是借用源(0 = 结果:整数) {
    0 = 结果;
    (借用视图源表)文本表键数 = 是借键数;
    (是借键数 - 1) = 是借i;
    当 (是借i >= 0) {
        (借用视图源表, 是借i)文本表键 = 是借视图;
        (借用视图源表, 是借视图)文本表取 = 是借源;
        如果 (是借源 ?= 源名) { 1 = 结果; }
        是借i - 1 = 是借i;
    }
}

// 内存安全 §八 O3-2c3：源容器是否已被**可变**视图借用（遍历 借用视图源表，命中且其视图已登记为可变即真）。
函数 (源名:字符串)是可变借用源(0 = 结果:整数) {
    0 = 结果;
    (借用视图源表)文本表键数 = 是变借键数;
    (是变借键数 - 1) = 是变借i;
    当 (是变借i >= 0) {
        (借用视图源表, 是变借i)文本表键 = 是变借视图;
        (借用视图源表, 是变借视图)文本表取 = 是变借源;
        如果 (是变借源 ?= 源名) {
            (借用视图可变表, 是变借视图)文本表含 = 是变借标;
            如果 (是变借标 ?= 1) { 1 = 结果; }
        }
        是变借i - 1 = 是变借i;
    }
}

// 内存安全 §八 O3-2b：解除指定名关联的借用 —— 名作视图名（改绑）→ 删该视图两项；
// 否则名作源名（重绑定）→ 删以名为源的全部视图项（重绑定即解除借用）。
函数 (名:字符串)解除借用 {
    (借用视图源表, 名)文本表含 = 解借是视图;
    如果 (解借是视图 ?= 1) {
        (借用视图源表, 名)文本表删;
        (借用视图深度表, 名)文本表删;
        (借用视图可变表, 名)文本表删;
    } 否则 {
        (借用视图源表)文本表键数 = 解借键数;
        (解借键数 - 1) = 解借i;
        当 (解借i >= 0) {
            (借用视图源表, 解借i)文本表键 = 解借视图;
            (借用视图源表, 解借视图)文本表取 = 解借源;
            如果 (解借源 ?= 名) {
                (借用视图源表, 解借视图)文本表删;
                (借用视图深度表, 解借视图)文本表删;
                (借用视图可变表, 解借视图)文本表删;
            }
            解借i - 1 = 解借i;
        }
    }
}

// 内存安全 §八 O3-2a：改源内建 —— 会改变源容器存储（realloc 使切片视图失效）或转移其所有权。
函数 (函数名:字符串)是改源内建(0 = 结果:整数) {
    0 = 结果;
    如果 (函数名 ?= "动态数组添加") { 1 = 结果; }
    否则如果 (函数名 ?= "动态数组插入") { 1 = 结果; }
    否则如果 (函数名 ?= "动态数组删除") { 1 = 结果; }
    否则如果 (函数名 ?= "动态数组设置") { 1 = 结果; }
    否则如果 (函数名 ?= "释放动态数组") { 1 = 结果; }
    否则如果 (函数名 ?= "动态字符串数组添加") { 1 = 结果; }
    否则如果 (函数名 ?= "动态字符串数组插入") { 1 = 结果; }
    否则如果 (函数名 ?= "动态字符串数组删除") { 1 = 结果; }
    否则如果 (函数名 ?= "动态字符串数组设置") { 1 = 结果; }
}

// 内存安全 §八 O3：报借用冲突并置编译失败标志（与 发射变量 的已移动报错同格式）。
函数 (消息:字符串)借用报错 {
    "错误: " + 消息 = 借用消息;
    (借用消息)输出错误;
    1 = 未声明出错;
}

// 内存安全 §八 O3-2c2：登记某名的末次使用（释放点）。"" 释放点（闭包内使用）具粘性，
// 不被后续外层使用覆盖（保证闭包借用检查不变、不误释放外层借用）。
函数 (名:字符串, 点:字符串)登记末次使用 {
    (末次使用表, 名)文本表含 = 登末已存;
    如果 (登末已存 ?= 0) {
        (末次使用表, 名, 点)表添加 = 末次使用表;
    } 否则 {
        (末次使用表, 名)文本表取 = 登末旧点;
        如果 (登末旧点 ?= "") { }
        否则 { (末次使用表, 名, 点)表替换 = 末次使用表; }
    }
}

// 内存安全 §八 O3-2c2：预扫描函数体（统一节点树），记录每个视图名的末次使用（释放点）语句节点号。
// 释放点口径：闭包内 → ""（永不释放）；处于最外层循环内 → 该循环语句节点号；否则 → 本语句节点号。
// 赋值目标（目标/常量目标/解构）不计使用；匿名函数体以「在闭包」递归。
函数 (节点:整数, 释放点:字符串, 最外循环:字符串, 在闭包:整数)预扫描节点 {
    (节点)取种类 = 预扫种;
    // 预扫本点 / 预扫子循 须为函数体级局部（日月局部为块作用域，否则嵌套分支内首次赋值不可见）
    "" = 预扫本点;
    "" = 预扫子循;
    // 本点：闭包内 → ""；最外循环非空 → 最外循环；否则 → 释放点
    如果 (在闭包 ?= 1) { "" = 预扫本点; }
    否则如果 (最外循环 != "") { 最外循环 = 预扫本点; }
    否则 { 释放点 = 预扫本点; }
    // 子循环：最外循环非空 → 最外循环；否则本节点是循环语句 → 本节点号；否则 ""
    如果 (最外循环 != "") { 最外循环 = 预扫子循; }
    否则如果 (预扫种 ?= "循环" || 预扫种 ?= "当" || 预扫种 ?= "遍历") { (节点)转字符串 = 预扫子循; }
    否则 { "" = 预扫子循; }
    // 变量引用（"变量"）→ 记一次使用
    如果 (预扫种 ?= "变量") {
        (节点)取文本 = 预扫名;
        (预扫名, 预扫本点)登记末次使用;
    }
    // 赋值写目标：跳过基准名（子 0），仅扫描后缀（下标/成员索引中的读取）
    否则如果 (预扫种 ?= "目标") {
        (节点)取子数 = 预扫数;
        1 = 预扫i;
        当 (预扫i < 预扫数) {
            (节点, 预扫i)取子 = 预扫子;
            (预扫子, 预扫本点, 预扫子循, 在闭包)预扫描节点;
            预扫i + 1 = 预扫i;
        }
    }
    // 常量目标 / 解构：整节点皆为目标名，不计使用
    否则如果 (预扫种 ?= "常量目标" || 预扫种 ?= "解构") { }
    // 匿名函数：体以「在闭包」递归（其中使用记 ""，永不释放）
    否则如果 (预扫种 ?= "匿名函数") {
        (节点)取子数 = 预扫数;
        0 = 预扫i;
        当 (预扫i < 预扫数) {
            (节点, 预扫i)取子 = 预扫子;
            (预扫子, "", "", 1)预扫描节点;
            预扫i + 1 = 预扫i;
        }
    }
    // 代码块：子语句各自成为释放点；处于最外层循环内则归该循环
    否则如果 (预扫种 ?= "代码块") {
        (节点)取子数 = 预扫数;
        0 = 预扫i;
        当 (预扫i < 预扫数) {
            (节点, 预扫i)取子 = 预扫子;
            (预扫子)转字符串 = 预扫子点;
            如果 (预扫子循 != "") { 预扫子循 = 预扫子点; }
            (预扫子, 预扫子点, 预扫子循, 在闭包)预扫描节点;
            预扫i + 1 = 预扫i;
        }
    }
    // 一般节点：递归全部子节点
    否则 {
        (节点)取子数 = 预扫数;
        0 = 预扫i;
        当 (预扫i < 预扫数) {
            (节点, 预扫i)取子 = 预扫子;
            (预扫子, 预扫本点, 预扫子循, 在闭包)预扫描节点;
            预扫i + 1 = 预扫i;
        }
    }
}

// 内存安全 §八 O3-2c2：进入函数体时，按函数体代码块子语句预扫描计算末次使用（重置表）。
函数 (函数体节点:整数)计算末次使用 {
    ()新建文本表 = 末次使用表;
    如果 (函数体节点 ?= 0) { }
    否则 {
        (函数体节点)取子数 = 体子数;
        0 = 体i;
        当 (体i < 体子数) {
            (函数体节点, 体i)取子 = 体子;
            (体子)转字符串 = 体点;
            (体子, 体点, "", 0)预扫描节点;
            体i + 1 = 体i;
        }
    }
}

// 内存安全 §八 O3-2c2：某语句发射完毕后，解除「末次使用点 == 本语句」或「无登记」的视图借用（NLL）。
// 倒序遍历 + 边遍历边删（文本表删 左移序键，只影响更高位）安全。
函数 (节点:整数)按末次使用解借 {
    (节点)转字符串 = 本语句点;
    (借用视图源表)文本表键数 = 按解键数;
    (按解键数 - 1) = 按解i;
    当 (按解i >= 0) {
        (借用视图源表, 按解i)文本表键 = 按解视图;
        (末次使用表, 按解视图)文本表含 = 按解有登;
        0 = 按解该删;
        如果 (按解有登 ?= 0) { 1 = 按解该删; }
        否则 {
            (末次使用表, 按解视图)文本表取 = 按解末点;
            如果 (按解末点 ?= 本语句点) { 1 = 按解该删; }
        }
        如果 (按解该删 ?= 1) {
            (借用视图源表, 按解视图)文本表删;
            (借用视图深度表, 按解视图)文本表删;
            (借用视图可变表, 按解视图)文本表删;
        }
        按解i - 1 = 按解i;
    }
}

// 内存安全 §八 O1b-2：成员类型名是否为拥有型 —— `T[]` 动态数组（后缀 `[]`）或拥有型结构体。
函数 (类型名:字符串)是拥有型成员类型(0 = 结果:整数) {
    0 = 结果;
    (类型名)类型后缀 = 拥有判后缀;
    如果 (拥有判后缀 ?= "[]") { 1 = 结果; }
    否则 {
        (拥有型结构体表, 类型名)文本表含 = 拥有判命中;
        如果 (拥有判命中 ?= 1) { 1 = 结果; }
    }
}

// 类型基名：去掉首个 '[' 起的后缀，返回其前部分；无后缀则原样返回。
函数 (类型名:字符串)类型基名(0 = 结果:字符串) {
    类型名 = 结果;
    (类型名)长度 = 基名判长;
    0 = 基名i;
    当 (基名i < 基名判长) {
        (类型名, 基名i, 1)子串 = 基名字;
        如果 (基名字 ?= "[") {
            (类型名, 0, 基名i)子串 = 结果;
            基名判长 = 基名i;
        } 否则 { 基名i + 1 = 基名i; }
    }
}

// 类型定长：返回 T[N] 中的 'N' 文本；非定长返回 ""。
函数 (类型名:字符串)类型定长(0 = 结果:字符串) {
    "" = 结果;
    (类型名)长度 = 定长判长;
    0 = 定长i;
    -1 = 定长左;
    当 (定长i < 定长判长) {
        (类型名, 定长i, 1)子串 = 定长字;
        如果 (定长字 ?= "[") {
            如果 (定长左 < 0) { 定长i = 定长左; }
        }
        定长i + 1 = 定长i;
    }
    如果 (定长左 >= 0) {
        定长判长 - 定长左 - 2 = 定长宽;
        如果 (定长宽 > 0) { (类型名, 定长左 + 1, 定长宽)子串 = 结果; }
    }
}

// 由类型注解登记容器元素码：T[:]→切片表 名:元素码；T[N]→数组表 名:"元素码:大小"；
// T[]→动态数组表 名:元素码（内存安全 §4.3 A.2 / S4：元素码由注解推断，下标据此分派）。
函数 (类型名:字符串, 名:字符串)登记类型注解 {
    (类型名)类型后缀 = 登记后缀;
    如果 (登记后缀 != "") {
        (类型名)类型基名 = 登记基名;
        (登记基名)类型名到局部码 = 登记元素码;
        如果 (登记后缀 ?= "[:]") {
            (切片表, 名, 登记元素码)表添加 = 切片表;
        } 否则如果 (登记后缀 ?= "[可变:]") {
            // 内存安全 §八 O3-2c3：可变切片视图同样登记为切片变量，并标记可变。
            (切片表, 名, 登记元素码)表添加 = 切片表;
            (可变视图表, 名, "1")表添加 = 可变视图表;
        } 否则如果 (登记后缀 ?= "[N]") {
            (类型名)类型定长 = 登记大小;
            (数组表, 名, 登记元素码 + ":" + 登记大小)表添加 = 数组表;
        } 否则如果 (登记后缀 ?= "[]") {
            (动态数组表, 名, 登记元素码)表添加 = 动态数组表;
        }
    }
}

函数 (类型名:字符串)类型名到局部码(0 = 结果:字符串) {
    // 阶段4A：单态化发射期，类型参数名按当前替换表映射为具体类型名。
    如果 (当前替换开 ?= 1) {
        (当前替换表, 类型名)文本表含 = 局部码替换有;
        如果 (局部码替换有 ?= 1) {
            (当前替换表, 类型名)文本表取 = 局部码实类型;
            局部码实类型 = 类型名;
        }
    }
    "F" = 结果;
    如果 (类型名 ?= "整数") { "I" = 结果; }
    否则如果 (类型名 ?= "整数32") { "I" = 结果; }
    否则如果 (类型名 ?= "整数8") { "B" = 结果; }
    否则如果 (类型名 ?= "整数16") { "H" = 结果; }
    否则如果 (类型名 ?= "整数64") { "J" = 结果; }
    否则如果 (类型名 ?= "字符串") { "S" = 结果; }
    否则如果 (类型名 ?= "文本") { "S" = 结果; }
    否则如果 (类型名 ?= "函数") { "C" = 结果; }
    否则如果 (类型名 ?= "指针") { "P" = 结果; }
    // 内存安全 §4.3 A.7：`文字` = 单个 Unicode 码点（IR 整数32），局部码 R。
    否则如果 (类型名 ?= "文字") { "R" = 结果; }
    否则如果 (类型名 ?= "切片") { "L" = 结果; }
    否则如果 (类型名 ?= "浮点32") { "G" = 结果; }
    否则如果 (类型名 ?= "浮点64") { "F" = 结果; }
    否则如果 (类型名 ?= "") { "U" = 结果; }
    否则 {
        // 内存安全 §4.3 阶段A：先识别类型后缀（T[N]/T[]/T[:]）
        (类型名)类型后缀 = 局部码后缀;
        如果 (局部码后缀 != "") {
            (类型名)类型基名 = 局部码基名;
            (局部码基名)类型名到局部码 = 局部码基元;
            如果 (局部码后缀 ?= "[]") {
                如果 (局部码基元 ?= "S") { "E" = 结果; } 否则 { "D" = 结果; }
            } 否则如果 (局部码后缀 ?= "[:]") { "L" = 结果; }
            否则如果 (局部码后缀 ?= "[可变:]") { "L" = 结果; }
            否则 { "A" = 结果; }
        } 否则 {
            0 = 别名命中;
            (类型名)在类型别名表 = 别名命中;
            如果 (别名命中 ?= 1) {
                (类型别名表, 类型名)查表值 = 别名基名;
                (别名基名)类型名到局部码 = 结果;
            } 否则 {
                (结构体_大小表, 类型名)在表 = 结构体命中;
                如果 (结构体命中 ?= 1) { "O" = 结果; }
            }
        }
    }
}

函数 (类型名:字符串)类型名到IR(0 = 结果:字符串) {
    // 阶段4A：单态化发射期，类型参数名按当前替换表映射为具体类型名。
    如果 (当前替换开 ?= 1) {
        (当前替换表, 类型名)文本表含 = IR替换有;
        如果 (IR替换有 ?= 1) {
            (当前替换表, 类型名)文本表取 = IR实类型;
            IR实类型 = 类型名;
        }
    }
    "双精度" = 结果;
    如果 (类型名 ?= "整数") { "整数32" = 结果; }
    否则如果 (类型名 ?= "整数32") { "整数32" = 结果; }
    否则如果 (类型名 ?= "整数8") { "整数8" = 结果; }
    否则如果 (类型名 ?= "整数16") { "整数16" = 结果; }
    否则如果 (类型名 ?= "整数64") { "整数64" = 结果; }
    否则如果 (类型名 ?= "字符串") { "指针" = 结果; }
    否则如果 (类型名 ?= "文本") { "指针" = 结果; }
    否则如果 (类型名 ?= "函数") { "指针" = 结果; }
    否则如果 (类型名 ?= "指针") { "指针" = 结果; }
    // 内存安全 §4.3 A.7：`文字` 的 IR 表示 整数32。
    否则如果 (类型名 ?= "文字") { "整数32" = 结果; }
    否则如果 (类型名 ?= "切片") { "指针" = 结果; }
    否则如果 (类型名 ?= "浮点32") { "单精度" = 结果; }
    否则如果 (类型名 ?= "浮点64") { "双精度" = 结果; }
    否则如果 (类型名 ?= "") { "指针" = 结果; }
    否则 {
        // 内存安全 §4.3 阶段A：三后缀一律作指针（T[N] 定长 / T[] 动态 / T[:] 切片）
        (类型名)类型后缀 = IR后缀;
        如果 (IR后缀 != "") { "指针" = 结果; }
        否则 {
            0 = 别名命中2;
            (类型名)在类型别名表 = 别名命中2;
            如果 (别名命中2 ?= 1) {
                (类型别名表, 类型名)查表值 = 别名基名;
                (别名基名)类型名到IR = 结果;
            } 否则 {
                (结构体_大小表, 类型名)在表 = 结构体命中2;
                如果 (结构体命中2 ?= 1) { "指针" = 结果; }
            }
        }
    }
}

// 数值转换：把 源IR 类型的 源C 转为 目标IR（不相同才发转换指令）
函数 (源C:字符串, 源IR:字符串, 目标IR:字符串)转换IR(0 = 结果:字符串) {
    如果 (目标IR ?= 源IR) { 源C = 结果; }
    否则如果 (源IR ?= "指针") { 源C = 结果; }
    否则如果 (目标IR ?= "指针") {
        如果 (源IR ?= "整数8" || 源IR ?= "整数16" || 源IR ?= "整数32" || 源IR ?= "整数64") {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 整数转指针 " + 源IR + " " + 源C + " 到 指针")发射;
        } 否则 {
            源C = 结果;
        }
    }
    否则如果 (目标IR ?= "双精度") {
        如果 (源IR ?= "单精度") {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 扩展浮点 单精度 " + 源C + " 到 双精度")发射;
        } 否则 {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 有符号转浮点 " + 源IR + " " + 源C + " 到 双精度")发射;
        }
    } 否则如果 (目标IR ?= "单精度") {
        如果 (源IR ?= "双精度") {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 截断浮点 双精度 " + 源C + " 到 单精度")发射;
        } 否则 {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 有符号转浮点 " + 源IR + " " + 源C + " 到 单精度")发射;
        }
    } 否则 {
        如果 (源IR ?= "双精度") {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 浮点转有符号 双精度 " + 源C + " 到 " + 目标IR)发射;
        } 否则如果 (源IR ?= "单精度") {
            ()新寄存器 = 结果;
            ("  " + 结果 + " = 浮点转有符号 单精度 " + 源C + " 到 " + 目标IR)发射;
        } 否则 {
            0 = 源宽;
            如果 (源IR ?= "整数8") { 1 = 源宽; }
            否则如果 (源IR ?= "整数16") { 2 = 源宽; }
            否则如果 (源IR ?= "整数32") { 4 = 源宽; }
            否则 { 8 = 源宽; }
            0 = 目标宽;
            如果 (目标IR ?= "整数8") { 1 = 目标宽; }
            否则如果 (目标IR ?= "整数16") { 2 = 目标宽; }
            否则如果 (目标IR ?= "整数32") { 4 = 目标宽; }
            否则 { 8 = 目标宽; }
            如果 (目标宽 > 源宽) {
                ()新寄存器 = 结果;
                ("  " + 结果 + " = 符号扩展 " + 源IR + " " + 源C + " 到 " + 目标IR)发射;
            } 否则 {
                ()新寄存器 = 结果;
                ("  " + 结果 + " = 截断 " + 源IR + " " + 源C + " 到 " + 目标IR)发射;
            }
        }
    }
}

函数 (节点:整数)解析输入参数表 {
    (节点)取子数 = 参数数;
    0 = 参数i;
    当 (参数i < 参数数) {
        (节点, 参数i)取子 = 参数节点;
        (参数节点)取子数 = 参数子数;
        "" = 参数名;
        "" = 参数类型名;
        0 = 参数变长;
        0 = 参数j;
        当 (参数j < 参数子数) {
            (参数节点, 参数j)取子 = 参数子;
            (参数子)取种类 = 参数子种;
            如果 (参数子种 ?= "标识符") { (参数子)取文本 = 参数名; }
            否则如果 (参数子种 ?= "类型") { (参数子)取文本 = 参数类型名; }
            否则如果 (参数子种 ?= "省略号") { 1 = 参数变长; }
            参数j + 1 = 参数j;
        }
        (参数类型名)类型名到局部码 = 参数码;
        如果 (参数变长 ?= 1) {
            // 阶段4B：变长形参 —— IR 类型为 指针（指向 整数32 元素数组），局部码记 "V"
            //（供 发射变量/发射下标访问/发射下标写 分派）；固定形参个数 = 本形参序号。
            "V" = 参数码;
            1 = 本函数变长标志;
            参数i = 本函数变长固定数;
            (变长数组表, 参数名, "1")表添加 = 变长数组表;
        }
        (参数类型名, 参数名)登记类型注解;
        (参数名, 参数码)局部表添加;
        如果 (参数码 ?= "O") {
            (结构体_变量表, 参数名, 参数类型名)表替换 = 结构体_变量表;
        }
        (已声明表, 参数名, "X")表添加 = 已声明表;
        如果 (参数变长 ?= 1) { "指针" = 参数类型IR; }
        否则 { (参数类型名)类型名到IR = 参数类型IR; }
        (输入参数表, 参数名, 参数码)表添加 = 输入参数表;
        (参数名 + "_in")转义标识符 = 参数转义;
        如果 (输入参数IR ?= "") {
