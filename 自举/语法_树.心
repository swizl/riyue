    ("  存储 整数32 0, 指针 " + 映射_大小分配 + ", 对齐 4")发射;
    ()新寄存器 = 映射_键数组地址;
    ("  " + 映射_键数组地址 + " = 获取元素指针 %映射类型, 指针 " + 映射_全局名 + ", 整数32 0, 整数32 0")发射;
    ()新寄存器 = 映射_值数组地址;
    ("  " + 映射_值数组地址 + " = 获取元素指针 %映射类型, 指针 " + 映射_全局名 + ", 整数32 0, 整数32 1")发射;
