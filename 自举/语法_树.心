            否则 { "I" = 下标写元素码; }
        }
        如果 (下标写元素码 ?= "S") {
            ()新寄存器 = 胖_解包临;
            ("  " + 胖_解包临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 保存存储值 + ")")发射;
            ("调用 空类型 (指针, 整数32, 指针) @动态字符串数组索引设置(指针 " + 下标写加载 + ", 整数32 " + 保存下标 + ", 指针 " + 胖_解包临 + ")")发射;
        } 否则 {
            ("调用 空类型 (指针, 整数32, 整数32) @动态数组索引设置(指针 " + 下标写加载 + ", 整数32 " + 保存下标 + ", 整数32 " + 保存存储值 + ")")发射;
        }
    } 否则如果 (下标写类型码 ?= 13) {
        // 内存安全 §八 O3-2c1/O3-2c3：只读切片视图禁写；可变切片视图放行（经运行时写入口直达借用源存储）。
        (可变视图表, 目标名)文本表含 = 视图写可变更;
        如果 (视图写可变更 ?= 0) {
            "不可写入只读视图: " + 目标名 = 视图写消息;
            (视图写消息)借用报错;
        } 否则 {
            (目标名)转义标识符 = 视图写转义;
            如果 (命中全局表 ?= 1) { "@" + 视图写转义 = 视图写地址; }
            否则 { "%" + 视图写转义 = 视图写地址; }
            ()新寄存器 = 视图写加载;
            ("  " + 视图写加载 + " = 加载 指针, 指针 " + 视图写地址 + ", 对齐 8")发射;
            (目标名)查切片元素码 = 视图写元素码;
            如果 (视图写元素码 ?= "S") {
                ()新寄存器 = 视图写胖临;
                ("  " + 视图写胖临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 保存存储值 + ")")发射;
                ("调用 空类型 (指针, 整数32, 指针) @切片设置指针(指针 " + 视图写加载 + ", 整数32 " + 保存下标 + ", 指针 " + 视图写胖临 + ")")发射;
            } 否则 {
                ("调用 空类型 (指针, 整数32, 整数32) @切片设置整数(指针 " + 视图写加载 + ", 整数32 " + 保存下标 + ", 整数32 " + 保存存储值 + ")")发射;
            }
        }
    } 否则如果 (下标写类型码 ?= 25) {
        // 阶段4F：变长形参元素写 —— 元素类型按形参声明登记（默认 整数 → 整数32）。
        (变长数组表, 目标名)查表值 = 变长写元素名;
