        (数组写入索引)转字符串 = 保存存储值;
        (数组元素表, 保存存储值, 表达式C)表添加 = 数组元素表;
        数组写入索引 + 1 = 数组写入索引;
    }
    如果 (数组元素码整 ?= 2) { "S" = 数组元素码; }
    如果 (数组元素码整 ?= 3) { "F" = 数组元素码; }
    如果 (数组元素码整 ?= 1) { "I" = 数组元素码; }
    如果 (数组元素码整 ?= 0) { "I" = 数组元素码; }
    (数组元素计数)转字符串 = 数组大小文本;
    (数组元素码)数组元素转IR = 数组元素IR;
    (数组元素码)数组对齐 = 数组对齐值;
    ()新寄存器 = 数组分配名;
    ("  " + 数组分配名 + " = 分配 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 对齐 " + 数组对齐值)发射;
    0 = 数组写入索引;
    当 (数组写入索引 < 数组元素计数) {
        (数组写入索引)转字符串 = 保存存储值;
        (数组元素表, 保存存储值)查表值 = 数组元素值;
        ()新寄存器 = 元素指针;
        ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 指针 " + 数组分配名 + ", 整数64 0, 整数64 " + (数组写入索引)转字符串)发射;
        ("  存储 " + 数组元素IR + " " + 数组元素值 + ", 指针 " + 元素指针 + ", 对齐 " + 数组对齐值)发射;
        数组写入索引 + 1 = 数组写入索引;
    }
    数组分配名 = 表达式C;
    "数组" = 表达式类型;
}

// 映射字面量：子交替为 字串键(叶) / 值表达式
函数 (节点:整数)发射映射字面 {
    (节点)取子数 = 映射_n;
    映射_计数 + 1 = 映射_计数;
    "@.映射" + (映射_计数)转字符串 = 映射_全局名;
    映射_全局名 + " = 内部 全局 %映射类型 零初始化" = 映射_行;
    如果 (映射_全局表 ?= "") { 映射_行 = 映射_全局表; }
    否则 { 映射_全局表 + "\n" = 映射_全局表; 映射_全局表 + 映射_行 = 映射_全局表; }
    ()新寄存器 = 映射_大小分配;
    ("  " + 映射_大小分配 + " = 分配 整数32, 对齐 4")发射;
    ("  存储 整数32 0, 指针 " + 映射_大小分配 + ", 对齐 4")发射;
    ()新寄存器 = 映射_键数组地址;
    ("  " + 映射_键数组地址 + " = 获取元素指针 %映射类型, 指针 " + 映射_全局名 + ", 整数32 0, 整数32 0")发射;
    ()新寄存器 = 映射_值数组地址;
    ("  " + 映射_值数组地址 + " = 获取元素指针 %映射类型, 指针 " + 映射_全局名 + ", 整数32 0, 整数32 1")发射;
    0 = 映射_i;
    当 (映射_i < 映射_n) {
        (节点, 映射_i)取子 = 键叶;
        (键叶)取文本 = 映射_键文本;
        (映射_键文本)解码字面 = 映射_键明文;
        (映射_键明文)存字符串常量 = 映射_键;
        映射_i + 1 = 映射_i;
        (节点, 映射_i)取子 = 值节点;
        (值节点)发射表达式;
        如果 (表达式类型 ?= "字符串") {
            ()新寄存器 = 胖_解包临;
            ("  " + 胖_解包临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 表达式C + ")")发射;
            胖_解包临 = 映射_值;
        }
        否则 {
            ()新寄存器 = 映射_值;
            ("  " + 映射_值 + " = 调用 指针 (整数32) @" + ("辅助转字符串")转义标识符 + "(整数32 " + 表达式C + ")")发射;
        }
        ()新寄存器 = 映射_大小值;
        ("  " + 映射_大小值 + " = 加载 整数32, 指针 " + 映射_大小分配 + ", 对齐 4")发射;
        ()新寄存器 = 映射_新大小;
        ("  " + 映射_新大小 + " = 调用 整数32 (指针, 指针, 整数32, 指针, 指针) @映射设置(指针 " + 映射_键数组地址 + ", 指针 " + 映射_值数组地址 + ", 整数32 " + 映射_大小值 + ", 指针 " + 映射_键 + ", 指针 " + 映射_值 + ")")发射;
        ("  存储 整数32 " + 映射_新大小 + ", 指针 " + 映射_大小分配 + ", 对齐 4")发射;
        映射_i + 1 = 映射_i;
    }
    映射_全局名 = 表达式C;
    "映射" = 表达式类型;
}

// 条件表达式：条 ? 真枝 : 假枝
// 用「临时槽 + 分支 + 存储/加载」实现（避免 PHI 与跨块值传递）。
// 先捕获真枝文本与类型，据其 IR 类型分配槽位；两支分别存储后于合并块加载。
函数 (节点:整数)发射条件表达式 {
    (节点, 0)取子 = 条件节点;
    (节点, 1)取子 = 真枝节点;
    (节点, 2)取子 = 假枝节点;

    (条件节点)发射表达式;
    ()发射条件;
    当前条件 = 条件布尔;

    生成代码 = 保存真前;
    函数体C = 保存真前体;
    ()新建文本缓冲 = 生成代码;
    ()新建文本缓冲 = 函数体C;
    (真枝节点)发射表达式;
    生成代码 = 真段;
    函数体C = 真段体;
    表达式C = 真值;
    表达式类型 = 真类型;
    表达式IR = 真IR;
    保存真前 = 生成代码;
    保存真前体 = 函数体C;

    8 = 槽对齐;
    如果 (真IR ?= "整数8") { 1 = 槽对齐; }
    否则如果 (真IR ?= "整数16") { 2 = 槽对齐; }
    否则如果 (真IR ?= "整数32") { 4 = 槽对齐; }
    否则如果 (真IR ?= "单精度") { 4 = 槽对齐; }
    (槽对齐)转字符串 = 槽对齐文本;
    ()新寄存器 = 槽;
    ("  " + 槽 + " = 分配 " + 真IR + ", 对齐 " + 槽对齐文本)发射;
    ()新标签 = 真标签;
    ()新标签 = 假标签;
    ()新标签 = 合并标签;
    ("分支 整数1 " + 条件布尔 + ", 标签 %" + 真标签 + ", 标签 %" + 假标签)发射终结;
    (真标签)发射标签;
    (真段)发射缓冲;
    (真段体)发射缓冲;
    ("  存储 " + 真IR + " " + 真值 + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    ("分支 标签 %" + 合并标签)发射终结;
    (假标签)发射标签;
    (假枝节点)发射表达式;
    ("  存储 " + 真IR + " " + 表达式C + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    ("分支 标签 %" + 合并标签)发射终结;
    (合并标签)发射标签;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 加载 " + 真IR + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    真类型 = 表达式类型;
    真IR = 表达式IR;
}

// ============================================
// 语句发射 (S4.4b)
// ============================================

函数 (节点:整数)发射语句 {
    (节点)取种类 = 种;
    // 调试（S-C）：语句级 !位置（无行号则回退函数行），供本语句指令挂 !dbg
    如果 (调试模式 ?= 1 && 当前子程序 > 0) {
        (节点)取行 = 语句行;
        如果 (语句行 <= 0) { 当前函数行 = 语句行; }
        (语句行, 当前子程序)取位置号 = 当前调试位置;
    }
    如果 (种 ?= "代码块") { (节点)发射代码块; }
    否则如果 (种 ?= "表达式语句") {
        (节点, 0)取子 = 子;
        (子)发射表达式;
    }
    否则如果 (种 ?= "赋值") { (节点)发射赋值; }
    否则如果 (种 ?= "返回") { (节点)发射返回语句; }
    否则如果 (种 ?= "中断") {
        ()查退出栈 = 中断标签;
        ("分支 标签 %" + 中断标签)发射终结;
    }
    否则如果 (种 ?= "继续") {
        ()查继续栈 = 继续标签2;
        ("分支 标签 %" + 继续标签2)发射终结;
    }
    否则如果 (种 ?= "如果") { (节点)发射如果; }
    否则如果 (种 ?= "当") { (节点)发射当; }
    否则如果 (种 ?= "循环") { (节点)发射循环; }
    否则如果 (种 ?= "遍历") { (节点)发射遍历; }
    否则如果 (种 ?= "匹配") { (节点)发射匹配; }
    否则 { }
}

函数 (节点:整数)发射代码块 {
    // 内存安全 §八 O2：块深度 +1（函数体顶层 = 1；嵌套块递增），供 发射值存储 只在函数体顶层登记待释放。
    当前块深度 + 1 = 当前块深度;
    (节点)取子数 = 块数;
    0 = 块i;
    当 (块i < 块数) {
        // 当前块已被终结指令（返回/中断/继续）终结时，其后的语句不可达，
        // 不再发射，避免终结指令后出现非法 IR（同一基本块出现多条终止/后续指令）。
        如果 (已终结 ?= 0) {
            (节点, 块i)取子 = 语句;
            (语句)发射语句;
            // 内存安全 §八 O3-2c2：本语句发射完毕 → 解除「末次使用点 == 本语句」或「无登记」的视图借用（精确 NLL）。
            (语句)按末次使用解借;
        }
        块i + 1 = 块i;
    }
    // 内存安全 §八 O2b：本块退出前，释放本块（深度 == 当前块深度）新建的待释放动态数组。
    // 块被终结（已终结 != 0）时无法发射 → 仅移除登记项（保守泄漏，避免对未初始化句柄释放）。
    // 倒序遍历 + 边遍历边删（文本表删 左移序键，只影响更高位）安全。
    (待释放表)文本表键数 = 块释放总数;
    (块释放总数 - 1) = 块释放i;
    当 (块释放i >= 0) {
        (待释放表, 块释放i)文本表键 = 块释放名;
        (待释放深度表, 块释放名)文本表取 = 块释放深度文本;
        (块释放深度文本)转整数 = 块释放深度;
        如果 (块释放深度 ?= 当前块深度) {
            如果 (已终结 ?= 0) {
                (已移动表, 块释放名)文本表含 = 块释放已移;
                (逃逸表, 块释放名)文本表含 = 块释放逃逸;
                如果 (块释放已移 ?= 0 && 块释放逃逸 ?= 0) {
                    (待释放表, 块释放名)文本表取 = 块释放码;
                    (块释放名)转义标识符 = 块释放转义;
                    ()新寄存器 = 块释放句柄;
                    ("  " + 块释放句柄 + " = 加载 指针, 指针 %" + 块释放转义 + ", 对齐 8")发射;
                    如果 (块释放码 ?= "E") {
                        ("调用 空类型 (指针) @释放动态字符串数组(指针 " + 块释放句柄 + ")")发射;
                    } 否则 {
                        ("调用 空类型 (指针) @释放动态数组(指针 " + 块释放句柄 + ")")发射;
                    }
                }
            }
            (待释放表, 块释放名)文本表删;
            (待释放深度表, 块释放名)文本表删;
        }
        块释放i - 1 = 块释放i;
    }
    // 内存安全 §八 O3：本块退出前，解除本块（深度 == 当前块深度）登记的只读借用（按视图名两表）。
    // 倒序遍历 + 边遍历边删（文本表删 左移序键，只影响更高位）安全。
    (借用视图深度表)文本表键数 = 解借总数;
    (解借总数 - 1) = 解借i;
    当 (解借i >= 0) {
        (借用视图深度表, 解借i)文本表键 = 解借视图;
        (借用视图深度表, 解借视图)文本表取 = 解借深度文本;
        (解借深度文本)转整数 = 解借深度;
        如果 (解借深度 ?= 当前块深度) {
            (借用视图深度表, 解借视图)文本表删;
            (借用视图源表, 解借视图)文本表删;
            (借用视图可变表, 解借视图)文本表删;
        }
        解借i - 1 = 解借i;
    }
    当前块深度 - 1 = 当前块深度;
}

函数 (节点:整数)发射返回语句 {
    (节点)取子数 = 返数;
    如果 (返数 ?= 0) { ("返回 空类型")发射终结; }
    否则 {
        (节点, 0)取子 = 返值;
        (返值)发射表达式;
        如果 (表达式类型 ?= "字符串") { ("返回 指针 " + 表达式C)发射终结; }
        否则如果 (表达式类型 ?= "指针") { ("返回 指针 " + 表达式C)发射终结; }
        否则如果 (表达式类型 ?= "浮点") { ("返回 双精度 " + 表达式C)发射终结; }
        否则 { ("返回 整数32 " + 表达式C)发射终结; }
    }
}

函数 (节点:整数)发射当 {
    (节点, 0)取子 = 当条件;
    (节点, 1)取子 = 当体;
    ()新标签 = 当头标签;
    ()新标签 = 当体标签;
    ()新标签 = 当退出标签;
    (当退出标签)压退出栈;
    (当头标签)压继续栈;
    (当头标签)发射标签;
    (当条件)发射表达式;
    ()发射条件;
    ("分支 整数1 " + 当前条件 + ", 标签 %" + 当体标签 + ", 标签 %" + 当退出标签)发射终结;
    (当体标签)发射标签;
    (当体)发射代码块;
    ("分支 标签 %" + 当头标签)发射终结;
    (当退出标签)发射标签;
    ()弹退出栈;
    ()弹继续栈;
}

函数 (节点:整数)发射循环 {
    (节点, 0)取子 = 循环头节点;
    (节点, 1)取子 = 循环体节点;
    (循环头节点, 0)取子 = 循环变量叶;
    (循环变量叶)取文本 = 循环变量;
    (循环头节点, 1)取子 = 循环开始节点;
    (循环开始节点)发射表达式;
    表达式C = 循环开始C;
    (循环头节点, 2)取子 = 循环结束节点;
    (循环结束节点)发射表达式;
    表达式C = 循环结束C;
    (循环头节点)取子数 = 循环头数;
    如果 (循环头数 >= 4) {
        (循环头节点, 3)取子 = 循环步长节点;
        (循环步长节点)发射表达式;
        表达式C = 循环步长C;
    } 否则 {
        "1" = 循环步长C;
    }
    (循环变量, "I")局部表添加;
    (循环变量)转义标识符 = 循环变量转义;
    ()新标签 = 范围头标签;
    ()新标签 = 范围体标签;
    ()新标签 = 范围步长标签;
    ()新标签 = 范围退出标签;
    (范围退出标签)压退出栈;
    (范围步长标签)压继续栈;
    ("存储 整数32 " + 循环开始C + ", 指针 %" + 循环变量转义 + ", 对齐 4")发射;
    (范围头标签)发射标签;
    ()新寄存器 = 范围循环值;
    ("  " + 范围循环值 + " = 加载 整数32, 指针 %" + 循环变量转义 + ", 对齐 4")发射;
    ()新寄存器 = 范围比较;
    ("  " + 范围比较 + " = 整数比较 有符号小于 整数32 " + 范围循环值 + ", " + 循环结束C)发射;
    ("分支 整数1 " + 范围比较 + ", 标签 %" + 范围体标签 + ", 标签 %" + 范围退出标签)发射终结;
    (范围体标签)发射标签;
