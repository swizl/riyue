        } 否则 {
            ("%" + 输出转义 + " = 分配 整数32, 对齐 4")发射;
            ("存储 整数32 " + 默认值文本 + ", 指针 %" + 输出转义 + ", 对齐 4")发射;
        }
        (输出名, 输出码)登记局部变量;
        索引 + 1 = 索引;
    }
}

