函数 (节点:整数)第一遍节点 {
    (节点)取子数 = 顶层数;
    0 = 顶层i;
    当 (顶层i < 顶层数) {
        (节点, 顶层i)取子 = 顶层节点;
        (顶层节点)取种类 = 顶层种;
        如果 (顶层种 ?= "函数") { (顶层节点)收集函数原型节点; }
        否则如果 (顶层种 ?= "结构体") { (顶层节点)收集结构体定义节点; }
        否则如果 (顶层种 ?= "枚举") { (顶层节点)收集枚举定义节点; }
        否则如果 (顶层种 ?= "全局变量") { (顶层节点)发射全局声明节点; }
        否则 { }
        顶层i + 1 = 顶层i;
    }
}

函数 (节点:整数)第二遍节点 {
    (结构体_大小表)文本表键数 = 结构体行数;
    0 = 结构体遍历索引;
    当 (结构体遍历索引 < 结构体行数) {
        (结构体_大小表, 结构体遍历索引)文本表键 = 结构体类型名;
        (结构体_类型表, 结构体类型名)查表值 = 结构体类型体;
        ("%" + 结构体类型名 + " = 类型 " + 结构体类型体)发射;
        结构体遍历索引 + 1 = 结构体遍历索引;
    }
    (节点)取子数 = 顶层数2;
    0 = 顶层j;
    当 (顶层j < 顶层数2) {
        (节点, 顶层j)取子 = 顶层节点2;
        (顶层节点2)取种类 = 顶层种2;
        如果 (顶层种2 ?= "函数") { (顶层节点2)发射函数定义节点; }
        否则如果 (顶层种2 ?= "结构体") { (顶层节点2)发射结构体方法节点; }
        否则 { }
        顶层j + 1 = 顶层j;
    }
}

// 第二遍：发射结构体的所有「方法」（合成为普通函数后发射）
函数 (节点:整数)发射结构体方法节点 {
    (节点, 0)取子 = 结构体名叶;
    (结构体名叶)取文本 = 当前结构体名;
    (节点)取子数 = 方法发射子数;
    1 = 方法发射i;
    当 (方法发射i < 方法发射子数) {
        (节点, 方法发射i)取子 = 方法发射项;
        (方法发射项)取种类 = 方法发射种;
        如果 (方法发射种 ?= "方法") {
            (方法发射项)合成方法函数节点 = 方法发射函数;
            (方法发射函数)发射函数定义节点;
        }
        方法发射i + 1 = 方法发射i;
    }
}

函数 (根:整数)发射程序 {
    (根)收集类型别名节点;
    (根)收集用户函数节点;
    ()发射前导;
    (根)第一遍节点;
    ()新建文本表 = 局部类型表;
    (根)第二遍节点;
}

// 预扫描：收集所有用户定义函数名（供 发射前导 判定内建遮蔽、发射调用 判定优先级）
函数 (节点:整数)收集用户函数节点 {
    (节点)取子数 = 用户顶层数;
    0 = 用户顶层i;
    当 (用户顶层i < 用户顶层数) {
        (节点, 用户顶层i)取子 = 用户顶层节点;
        (用户顶层节点)取种类 = 用户顶层种;
        如果 (用户顶层种 ?= "函数") {
            (用户顶层节点)解析函数签名节点;
            (用户函数表, 原型名, "1")表添加 = 用户函数表;
            原型名 = 最后函数名;
        }
        用户顶层i + 1 = 用户顶层i;
    }
    如果 (("主程序")在用户函数表 ?= 0) {
        // 无 主程序：仅当存在名为 主 的零参函数时以其为入口；否则视为纯模块，不生成入口调用
        如果 (("主")在用户函数表 ?= 1) {
            最后函数名 = 运行时名;
            (运行时名)转义标识符 = 转义_主程序;
        } 否则 {
            "" = 转义_主程序;
        }
    }
}

