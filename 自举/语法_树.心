// ============================================
// 日月编译器 — AST 发射层 (语法_树.心, S4.4)
// 遍历 自举/解析器.心 构造的扁平节点池 AST，发射 中文 LLVM IR。
// 与 自举/语法.心（token 递归下降版本）语义等价。
// 结果约定：全局 表达式C = 值寄存器/字面量，表达式类型 = 整数/浮点/字符串/函数/数组/结构体/...
// ============================================

导入 "语法树.心";
导入 "发射.心";

// 当前调用是否为「双精度数学内建」（需要把整数实参提升为 双精度）
0 = 变量 内建双精度;

// 发射一个表达式节点 -> 表达式C / 表达式类型
函数 (节点:整数)发射表达式 {
    "" = 表达式IR;
    (节点)取种类 = 种;
    如果 (种 ?= "二元运算") { (节点)发射二元; }
    否则如果 (种 ?= "一元运算") { (节点)发射一元; }
    否则如果 (种 ?= "整数") { (节点)发射叶数字; }
    否则如果 (种 ?= "数字") { (节点)发射叶数字; }
    否则如果 (种 ?= "浮点数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "小数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "字符串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "字串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "布尔值") { (节点)发射叶布尔; }
    否则如果 (种 ?= "变量") { (节点)发射变量; }
    否则如果 (种 ?= "标识符") { (节点)发射变量; }
    否则如果 (种 ?= "函数调用") { (节点)发射调用; }
    否则如果 (种 ?= "后缀") { (节点)发射后缀; }
    否则如果 (种 ?= "条件表达式") { (节点)发射条件表达式; }
    否则如果 (种 ?= "元组") { (节点)发射元组; }
    否则如果 (种 ?= "数组字面") { (节点)发射数组字面; }
    否则如果 (种 ?= "映射字面") { (节点)发射映射字面; }
    否则如果 (种 ?= "匿名函数") { (节点)发射匿名函数; }
    否则 { (节点)发射表达式兜底; }
    如果 (表达式IR ?= "") { (表达式类型)类型转IR = 表达式IR; }
    否则如果 (表达式IR ?= "整数32") {
        如果 (表达式类型 ?= "浮点") { "双精度" = 表达式IR; }
        否则如果 (表达式类型 ?= "数组") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "映射") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "元组") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "结构体") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "字符串") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "函数") { "指针" = 表达式IR; }
    }
}

// 兜底（未实现的表达式种类，占位 0；S4.4 后续补齐）
函数 (节点:整数)发射表达式兜底 {
    "0" = 表达式C;
    "整数" = 表达式类型;
}

// ────────────────────────────────────────────
// 闭包 / 匿名函数（AST 版，语义等价 语法.心 解析闭包）
// 匿名函数 = 内部函数 + 捕获变量（按引用，隐藏 指针 形参）
// 节点两种形状：
//   ① 函数形式：子 = [参数表, 返回表?, 类型?, 代码块]
//   ② Lambda形式：子 = [输入形参*, 表达式]
// 结果：表达式C = "@<闭包名>"，表达式类型 = "函数"（函数指针）
// ────────────────────────────────────────────
函数 (节点:整数)发射匿名函数 {
    局部类型表 = 保存局部类型表;
    函数体C = 保存函数体C;
    输入参数表 = 保存输入参数表;
    输出参数表 = 保存输出参数表;
    已声明表 = 保存已声明表;
    输入参数IR = 保存输入参数IR;
    返回类型名 = 保存返回类型名;
    输出参数名 = 保存输出参数名;
    原型名 = 保存原型名;
    已终结 = 保存已终结;
    缓冲模式 = 匿名_缓冲;

    // 形状探测：含「参数表」即函数形式；代码块 子节点即函数体
    0 = 匿名_有参表;
    0 = 匿名_体节点;
    (节点)取子数 = 匿名_子数;
    0 = 匿名_形状i;
    当 (匿名_形状i < 匿名_子数) {
        (节点, 匿名_形状i)取子 = 匿名_形状子;
        (匿名_形状子)取种类 = 匿名_形状种;
        如果 (匿名_形状种 ?= "参数表") { 1 = 匿名_有参表; }
        否则如果 (匿名_形状种 ?= "代码块") { 匿名_形状子 = 匿名_体节点; }
        匿名_形状i + 1 = 匿名_形状i;
    }
    0 = 匿名_是lambda;
    如果 (匿名_有参表 ?= 1) {
        (节点)解析函数签名节点;
    } 否则 {
        1 = 匿名_是lambda;
        ()新建文本表 = 局部类型表;
        ()新建文本表 = 已声明表;
        ()新建文本表 = 输入参数表;
        ()新建文本表 = 输出参数表;
        "" = 输入参数IR;
        "" = 返回类型名;
        "" = 输出参数名;
        "" = 原型名;
        ()新子列表 = 匿名_合成表;
        0 = 匿名_形状j;
        当 (匿名_形状j < 匿名_子数) {
            (节点, 匿名_形状j)取子 = 匿名_形状子2;
            (匿名_形状子2)取种类 = 匿名_形状种2;
            如果 (匿名_形状种2 ?= "输入形参") { (匿名_合成表, 匿名_形状子2)子列表添加; }
            否则如果 (匿名_形状种2 ?= "输出形参") { (匿名_合成表, 匿名_形状子2)子列表添加; }
            否则 { 匿名_形状子2 = 匿名_体节点; }
            匿名_形状j + 1 = 匿名_形状j;
        }
        ("参数表", "", 匿名_合成表)新节点 = 匿名_参表节点;
        (匿名_参表节点)解析输入参数表;
        "整数" = 返回类型名;
        "结果" = 输出参数名;
        (输出参数名, "I")局部表添加;
        (已声明表, 输出参数名, "X")表添加 = 已声明表;
        (输出参数表, 输出参数名, "I")表添加 = 输出参数表;
    }

    闭包计数 + 1 = 闭包计数;
    "闭包" + (闭包计数)转字符串 = 闭包名;
    (闭包名)转义标识符 = 闭包转义;
    "" = 闭包捕获参数;
    (匿名_体节点)闭包捕获扫描;

    0 = 已终结;
    1 = 缓冲模式;
    ()新建文本缓冲 = 函数体C;
    如果 (匿名_是lambda ?= 1) {
        (匿名_体节点, 输出参数名)发射变量写到;
    } 否则 {
        (匿名_体节点)发射代码块;
    }
    函数体C = 闭包体;

    如果 (返回类型名 ?= "") { "空类型" = 闭包返回IR; }
    否则 { (返回类型名)类型名到IR = 闭包返回IR; }
    // 多输出闭包：登记结构体返回类型与元素码（键为闭包内部名，供闭包调用/解构使用），
    // 返回类型改为结构体，函数尾部按 插入值 链构造后整体返回。
    "" = 闭包多返回体;
    "" = 闭包多返回元素;
    (输出参数表)文本表键数 = 闭包多返回行数;
    如果 (闭包多返回行数 > 1) {
        0 = 闭包登记i;
        当 (闭包登记i < 闭包多返回行数) {
            (输出参数表, 闭包登记i)文本表键 = 闭包登记键;
            (输出参数表, 闭包登记键)文本表取 = 闭包登记码;
            (闭包登记码)输出码转IR = 闭包登记IR;
            如果 (闭包登记i ?= 0) {
                闭包登记IR = 闭包多返回体;
                闭包登记码 = 闭包多返回元素;
            } 否则 {
                闭包多返回体 + ", " = 闭包多返回体;
                闭包多返回体 + 闭包登记IR = 闭包多返回体;
                闭包多返回元素 + "\n" = 闭包多返回元素;
                闭包多返回元素 + 闭包登记码 = 闭包多返回元素;
            }
            闭包登记i + 1 = 闭包登记i;
        }
        (函数多返回表, 闭包名, 闭包多返回体)表替换 = 函数多返回表;
        (函数多返回元素表, 闭包名, 闭包多返回元素)表替换 = 函数多返回元素表;
        "{" + 闭包多返回体 = 闭包返回IR;
        闭包返回IR + "}" = 闭包返回IR;
    }
    ()新建文本缓冲 = 函数体C;
    ("定义 内部 " + 闭包返回IR + " @" + 闭包转义 + "(" + 输入参数IR + 闭包捕获参数 + ") {")发射;
    ("入口:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    (函数体C, 闭包体)文本缓冲追加缓冲;
    如果 (已终结 ?= 1) { }
    否则如果 (闭包多返回体 ?= "") {
    如果 (返回类型名 ?= "") { ("  返回 空类型")发射; }
    否则 {
        (输出参数名)取地址 = 闭包返回地址;
        ()新寄存器 = 闭包返回加载;
        ("  " + 闭包返回加载 + " = 加载 " + 闭包返回IR + ", 指针 " + 闭包返回地址 + ", 对齐 4")发射;
        ("  返回 " + 闭包返回IR + " " + 闭包返回加载)发射;
    }
    } 否则 {
        // 多输出：逐输出加载并 插入值 链式构造结构体，最后整体返回
        "" = 闭包聚合;
        "" = 闭包前值;
        0 = 闭包聚合i;
        当 (闭包聚合i < 闭包多返回行数) {
            (输出参数表, 闭包聚合i)文本表键 = 闭包聚合名;
            (输出参数表, 闭包聚合名)文本表取 = 闭包聚合码;
            (闭包聚合码)输出码转IR = 闭包聚合单IR;
            (闭包聚合名)取地址 = 闭包聚合地址;
            ()新寄存器 = 闭包聚合加载;
            ("  " + 闭包聚合加载 + " = 加载 " + 闭包聚合单IR + ", 指针 " + 闭包聚合地址 + ", 对齐 4")发射;
            (闭包聚合i)转字符串 = 闭包聚合i文本;
            ()新寄存器 = 闭包聚合;
            如果 (闭包聚合i ?= 0) {
                ("  " + 闭包聚合 + " = 插入值 {" + 闭包多返回体 + "} 未定义, " + 闭包聚合单IR + " " + 闭包聚合加载 + ", 0")发射;
                闭包聚合 = 闭包前值;
            } 否则 {
                ("  " + 闭包聚合 + " = 插入值 {" + 闭包多返回体 + "} " + 闭包前值 + ", " + 闭包聚合单IR + " " + 闭包聚合加载 + ", " + 闭包聚合i文本)发射;
                闭包聚合 = 闭包前值;
            }
            闭包聚合i + 1 = 闭包聚合i;
        }
        ("  返回 {" + 闭包多返回体 + "} " + 闭包前值)发射;
    }
    ("}")发射;
    (函数体C)文本缓冲取整体 = 闭包体文本;
    闭包定义 + 闭包体文本 = 闭包定义;
    (闭包函数表, 闭包名, 闭包名)表添加 = 闭包函数表;
    (闭包返回表, 闭包名, 闭包返回IR)表添加 = 闭包返回表;

    匿名_缓冲 = 缓冲模式;
    保存局部类型表 = 局部类型表;
    保存函数体C = 函数体C;
    保存输入参数表 = 输入参数表;
    保存输出参数表 = 输出参数表;
    保存已声明表 = 已声明表;
    保存输入参数IR = 输入参数IR;
    保存返回类型名 = 返回类型名;
    保存输出参数名 = 输出参数名;
    保存原型名 = 原型名;
    保存已终结 = 已终结;

    "@" + 闭包名 = 表达式C;
    "函数" = 表达式类型;
    "" = 表达式IR;
}

// 闭包捕获扫描：递归扫描闭包体 AST，把未在闭包内声明、却存在于外层局部类型表的
// 变量登记为捕获（按引用）。不进入嵌套匿名函数。
函数 (节点:整数)闭包捕获扫描 {
    (节点)取种类 = 扫种;
    如果 (扫种 ?= "变量") {
        (节点)取文本 = 扫名;
        (扫名)闭包登记捕获;
    } 否则如果 (扫种 ?= "目标") {
        (节点)取子数 = 扫目标数;
        如果 (扫目标数 ?= 1) {
            (节点, 0)取子 = 扫目标名叶;
            (扫目标名叶)取种类 = 扫目标名种;
            如果 (扫目标名种 ?= "标识符") {
                (扫目标名叶)取文本 = 扫目标名;
                (扫目标名)闭包登记捕获;
            }
        }
    } 否则如果 (扫种 ?= "匿名函数") {
    } 否则 {
        (节点)取子数 = 扫数;
        0 = 扫i;
        当 (扫i < 扫数) {
            (节点, 扫i)取子 = 扫子;
            (扫子)闭包捕获扫描;
            扫i + 1 = 扫i;
        }
    }
}

// 登记单个捕获：外层局部表存在该名（有类型码）且闭包内未声明时，按引用捕获
函数 (扫名:字符串)闭包登记捕获 {
    (已声明表, 扫名)在表 = 扫声明命中;
    如果 (扫声明命中 ?= 0) {
        (保存局部类型表, 扫名)查表值 = 扫捕获码;
        如果 (扫捕获码 ?= "") { }
        否则 {
            (扫名, 扫捕获码)局部表添加;
            (已声明表, 扫名, "X")表添加 = 已声明表;
            (扫名)转义标识符 = 扫捕获转义;
            如果 (输入参数IR ?= "" && 闭包捕获参数 ?= "") {
                "指针 %" + 扫捕获转义 = 闭包捕获参数;
            } 否则 {
                闭包捕获参数 + ", 指针 %" = 闭包捕获参数;
                闭包捕获参数 + 扫捕获转义 = 闭包捕获参数;
            }
            (闭包捕获表, 闭包名 + ":" + 扫名, "1")表添加 = 闭包捕获表;
        }
    }
}

函数 (节点:整数)发射叶数字 {
    (节点)取文本 = 表达式C;
    "整数" = 表达式类型;
    "整数32" = 表达式IR;
}

函数 (节点:整数)发射叶浮点 {
    (节点)取文本 = 表达式C;
    "浮点" = 表达式类型;
    "双精度" = 表达式IR;
}

// 字符串字面量：去掉包围引号（插串的 f 前缀）并解码转义，旧词法器行为一致
函数 (原文:字符串)解码字面(0 = 结果:字符串) {
    (原文)长度 = 原长;
    0 = 起i;
    (原文, 0, 1)子串 = 首字;
    如果 (首字 ?= "f") { 1 = 起i; }
    起i + 1 = 内容起;
    原长 - 内容起 - 1 = 内容长;
    如果 (内容长 < 0) { "" = 结果; }
    否则 {
        (原文, 内容起, 内容长)子串 = 内部;
        (内部)解码转义 = 结果;
    }
}

函数 (文本:字符串)解码转义(0 = 结果:字符串) {
    (文本)长度 = 文本长;
    0 = 转i;
    "" = 结果;
    当 (转i < 文本长) {
        (文本, 转i, 1)子串 = 字;
        (字, 0)字符码 = 码;
        如果 (码 ?= 92) {
            转i + 1 = 转i;
            如果 (转i < 文本长) {
                (文本, 转i, 1)子串 = 转字;
                (转字, 0)字符码 = 转码;
                如果 (转码 ?= 110) { 结果 + "\n" = 结果; }
                否则如果 (转码 ?= 116) { 结果 + "\t" = 结果; }
                否则 { 结果 + 转字 = 结果; }
            }
        } 否则 {
            结果 + 字 = 结果;
        }
        转i + 1 = 转i;
    }
}

函数 (节点:整数)发射叶字符串 {
    (节点)取文本 = 原文;
    (原文)解码字面 = 文本值;
    (文本值)存字符串常量 = 表达式C;
    "字符串" = 表达式类型;
    "指针" = 表达式IR;
}

函数 (节点:整数)发射叶布尔 {
    (节点)取文本 = 原文;
    如果 (原文 ?= "真") { "1" = 表达式C; }
    否则 { "0" = 表达式C; }
    "整数" = 表达式类型;
}

// 变量：标量加载 / 闭包名 / 数组地址（结构体/映射/元组成员链在 后缀 中处理）
函数 (节点:整数)发射变量 {
    (节点)取文本 = 名;
    (名)查闭包函数 = 闭包函数名;
    如果 (闭包函数名 ?= "") {
        (名)查类型 = 类型码;
        (名)转义标识符 = 转义;
        如果 (命中全局表 ?= 1) { "@" + 转义 = 地址; }
        否则 { "%" + 转义 = 地址; }
        如果 (类型码 ?= 0) {
            "0" = 表达式C;
            "整数" = 表达式类型;
            "整数32" = 表达式IR;
        } 否则如果 (类型码 ?= 5) {
            名 = 当前数组名;
            0 = 链式数组标志;
            地址 = 表达式C;
            "数组" = 表达式类型;
            "指针" = 表达式IR;
        } 否则如果 (类型码 ?= 6) {
            (名)查结构体变量类型 = 当前结构体名;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 指针, 指针 " + 地址 + ", 对齐 8")发射;
            "结构体" = 表达式类型;
            "指针" = 表达式IR;
        } 否则如果 (类型码 ?= 7) {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 指针, 指针 " + 地址 + ", 对齐 8")发射;
            "映射" = 表达式类型;
            "指针" = 表达式IR;
        } 否则如果 (类型码 ?= 8) {
            (名)查元组类型 = 元组_类型体;
            名 = 元组_基名;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 指针, 指针 " + 地址 + ", 对齐 8")发射;
