            ("  " + 表达式C + " = 调用 ptr (" + 闭包全参数类型 + ") @" + 闭包函数名 + "(" + 参数前缀文本 + 闭包捕获参数 + ")")发射;
            "字符串" = 表达式类型;
        } 否则 {
            ("调用 void (" + 闭包全参数类型 + ") @" + 闭包函数名 + "(" + 参数前缀文本 + 闭包捕获参数 + ")")发射;
            "" = 表达式C;
            "空" = 表达式类型;
        }
    }
}

// ────────────────────────────────────────────
// 后缀链 (S4.4b)：左 = 基表达式，项 = 后缀项
// ────────────────────────────────────────────
函数 (节点:整数)发射后缀 {
    (节点, 0)取子 = 左;
    (节点, 1)取子 = 项;
    (项)取种类 = 种项;
    如果 (种项 ?= "结构体实例") {
        (左)取文本 = 类型名;
        (类型名, 项)发射结构体实例;
    } 否则如果 (种项 ?= "双冒访问") {
        (左)取文本 = 枚举名;
        (项, 0)取子 = 名字叶;
        (名字叶)取文本 = 枚举成员名;
        (枚举_成员表, 枚举名 + "::" + 枚举成员名)查表值 = 表达式C;
        "整数" = 表达式类型;
    } 否则 {
        (左)发射表达式;
        (项)发射后缀项;
    }
}

函数 (节点:整数)发射后缀项 {
    (节点)取种类 = 种;
    如果 (种 ?= "成员访问") { (节点)发射成员访问; }
    否则如果 (种 ?= "下标访问") { (节点)发射下标访问; }
    否则如果 (种 ?= "元组访问") { (节点)发射元组访问; }
    否则 { }
}

函数 (节点:整数)发射成员访问 {
    (节点, 0)取子 = 名字叶;
    (名字叶)取文本 = 成员名;
    (当前结构体名, 成员名)查结构体成员索引 = 成员索引;
    (当前结构体名, 成员名)查结构体成员类型 = 成员类型;
    ()新寄存器 = 成员指针;
    ("  " + 成员指针 + " = 获取元素指针 %" + 当前结构体名 + ", ptr " + 表达式C + ", i32 0, i32 " + 成员索引)发射;
    如果 (成员类型 ?= "整数") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 i32, ptr " + 成员指针 + ", align 4")发射;
        "整数" = 表达式类型;
    } 否则如果 (成员类型 ?= "字符串") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 ptr, ptr " + 成员指针 + ", align 8")发射;
        "字符串" = 表达式类型;
    } 否则如果 (成员类型 ?= "浮点") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 double, ptr " + 成员指针 + ", align 8")发射;
        "浮点" = 表达式类型;
    } 否则如果 (成员类型 ?= "数组") {
        (当前结构体名, 成员名)查结构体成员数组元素码 = 结构体元素码;
        (当前结构体名, 成员名)查结构体成员数组大小 = 结构体大小;
        ()新寄存器 = 链式加载;
        ("  " + 链式加载 + " = 加载 ptr, ptr " + 成员指针 + ", align 8")发射;
        链式加载 = 表达式C;
        链式加载 = 链式数组基址;
        结构体大小 = 数组大小文本;
        结构体元素码 = 数组元素码;
        1 = 链式数组标志;
        "数组" = 表达式类型;
    } 否则 {
        成员类型 = 当前结构体名;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 ptr, ptr " + 成员指针 + ", align 8")发射;
        "结构体" = 表达式类型;
    }
}

函数 (节点:整数)发射下标访问 {
    表达式C = 基地址;
    表达式类型 = 基类型;
    (节点, 0)取子 = 索引节点;
    (索引节点)发射表达式;
    表达式C = 保存下标;
    如果 (基类型 ?= "数组") {
        如果 (链式数组标志 ?= 1) {
            0 = 链式数组标志;
            链式数组基址 = 基地址;
        } 否则 {
            (当前数组名)查数组大小 = 数组大小文本;
            (当前数组名)查数组元素码 = 数组元素码;
        }
        (数组元素码)数组元素转IR = 数组元素IR;
        (数组元素码)数组对齐 = 数组对齐值;
        ()新寄存器 = 下标扩展;
        ("  " + 下标扩展 + " = 零扩展 i32 " + 保存下标 + " to i64")发射;
        ()新寄存器 = 元素指针;
        ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " x " + 数组元素IR + "], ptr " + 基地址 + ", i64 0, i64 " + 下标扩展)发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 " + 数组元素IR + ", ptr " + 元素指针 + ", align " + 数组对齐值)发射;
        如果 (数组元素码 ?= "S") { "字符串" = 表达式类型; }
        否则如果 (数组元素码 ?= "F") { "浮点" = 表达式类型; }
        否则 { "整数" = 表达式类型; }
    } 否则如果 (基类型 ?= "映射") {
        ()新寄存器 = 映射_访问变量;
        ("  " + 映射_访问变量 + " = 加载 ptr, ptr " + 基地址 + ", align 8")发射;
        ()新寄存器 = 映射_键数组地址;
        ("  " + 映射_键数组地址 + " = 获取元素指针 %映射类型, ptr " + 映射_访问变量 + ", i32 0, i32 0")发射;
        ()新寄存器 = 映射_值数组地址;
        ("  " + 映射_值数组地址 + " = 获取元素指针 %映射类型, ptr " + 映射_访问变量 + ", i32 0, i32 1")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 ptr (ptr, ptr, i32, ptr) @映射获取(ptr " + 映射_键数组地址 + ", ptr " + 映射_值数组地址 + ", i32 1024, ptr " + 保存下标 + ")")发射;
        "字符串" = 表达式类型;
    } 否则 {
    }
}

函数 (节点:整数)发射元组访问 {
    表达式C = 基地址;
    (节点, 0)取子 = 索引叶;
    (索引叶)取文本 = 元组_值;
    (元组_基名 + ":" + 元组_值)查元组成员 = 元组_元素IR;
    ()新寄存器 = 元素指针;
    ("  " + 元素指针 + " = 获取元素指针 {" + 元组_类型体 + "}, ptr " + 基地址 + ", i32 0, i32 " + 元组_值)发射;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 加载 " + 元组_元素IR + ", ptr " + 元素指针 + ", align 8")发射;
    如果 (元组_元素IR ?= "i32") { "整数" = 表达式类型; }
    否则如果 (元组_元素IR ?= "double") { "浮点" = 表达式类型; }
    否则 { "字符串" = 表达式类型; }
}

// 结构体实例字面量： 类型名 { 成员: 值, ... }（类型名来自后缀链左节点文本）
函数 (类型名:字符串, 节点:整数)发射结构体实例 {
    类型名 = 当前结构体名;
    (当前结构体名)查结构体大小 = 结构体大小文本;
    ()新寄存器 = 结构体实例名;
    ("  " + 结构体实例名 + " = 分配 %" + 当前结构体名 + ", align 8")发射;
    (节点)取子数 = 成员数;
    0 = 成员i;
    当 (成员i < 成员数) {
        (节点, 成员i)取子 = 成员;
        (成员, 0)取子 = 名字叶;
        (名字叶)取文本 = 结构体成员名;
        (成员, 1)取子 = 值节点;
        当前结构体名 = 结构体保存名;
        结构体成员名 = 结构体保存成员名;
        (值节点)发射表达式;
        表达式C = 结构体成员值;
        结构体保存名 = 当前结构体名;
        结构体保存成员名 = 结构体成员名;
        如果 (表达式类型 ?= "数组") {
            当前结构体名 + ":" = 链式地址;
            链式地址 + 结构体成员名 = 链式地址;
            数组元素码 + ":" = 保存存储值;
            保存存储值 + 数组大小文本 = 保存存储值;
            (结构体_数组表, 链式地址, 保存存储值)表添加 = 结构体_数组表;
        }
        (当前结构体名, 结构体成员名)查结构体成员索引 = 结构体成员索引;
        (当前结构体名, 结构体成员名)查结构体成员类型 = 结构体成员类型;
        ()新寄存器 = 成员指针;
        ("  " + 成员指针 + " = 获取元素指针 %" + 当前结构体名 + ", ptr " + 结构体实例名 + ", i32 0, i32 " + 结构体成员索引)发射;
        (结构体成员类型)结构体成员类型转IR = 结构体成员IR;
        ("  存储 " + 结构体成员IR + " " + 结构体成员值 + ", ptr " + 成员指针 + ", align 8")发射;
        成员i + 1 = 成员i;
    }
    结构体实例名 = 表达式C;
    "结构体" = 表达式类型;
    "" = 当前数组名;
}

// 数组字面量：子 = 各元素表达式（同类型）
函数 (节点:整数)发射数组字面 {
    (节点)取子数 = 数组元素计数;
    "" = 数组元素码;
    "" = 数组元素表;
    0 = 数组元素码整;
    0 = 数组写入索引;
    当 (数组写入索引 < 数组元素计数) {
        (节点, 数组写入索引)取子 = 甲;
        (甲)发射表达式;
        0 = 数组类型码;
        如果 (表达式类型 ?= "整数") { 1 = 数组类型码; }
        如果 (表达式类型 ?= "字符串") { 2 = 数组类型码; }
        如果 (表达式类型 ?= "浮点") { 3 = 数组类型码; }
        如果 (数组元素码整 ?= 0) { 数组类型码 = 数组元素码整; }
        (数组写入索引)转字符串 = 保存存储值;
        (数组元素表, 保存存储值, 表达式C)表添加 = 数组元素表;
        数组写入索引 + 1 = 数组写入索引;
    }
    如果 (数组元素码整 ?= 2) { "S" = 数组元素码; }
    如果 (数组元素码整 ?= 3) { "F" = 数组元素码; }
    如果 (数组元素码整 ?= 1) { "I" = 数组元素码; }
    如果 (数组元素码整 ?= 0) { "I" = 数组元素码; }
    (数组元素计数)转字符串 = 数组大小文本;
    (数组元素码)数组元素转IR = 数组元素IR;
    (数组元素码)数组对齐 = 数组对齐值;
    ()新寄存器 = 数组分配名;
    ("  " + 数组分配名 + " = 分配 [" + 数组大小文本 + " x " + 数组元素IR + "], align " + 数组对齐值)发射;
    0 = 数组写入索引;
    当 (数组写入索引 < 数组元素计数) {
        (数组写入索引)转字符串 = 保存存储值;
        (数组元素表, 保存存储值)查表值 = 数组元素值;
        ()新寄存器 = 元素指针;
        ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " x " + 数组元素IR + "], ptr " + 数组分配名 + ", i64 0, i64 " + (数组写入索引)转字符串)发射;
        ("  存储 " + 数组元素IR + " " + 数组元素值 + ", ptr " + 元素指针 + ", align " + 数组对齐值)发射;
        数组写入索引 + 1 = 数组写入索引;
    }
    数组分配名 = 表达式C;
    "数组" = 表达式类型;
}

// 映射字面量：子交替为 字串键(叶) / 值表达式
函数 (节点:整数)发射映射字面 {
    (节点)取子数 = 映射_n;
    映射_计数 + 1 = 映射_计数;
    "@.映射" + (映射_计数)转字符串 = 映射_全局名;
    映射_全局名 + " = 内部 全局 %映射类型 零初始化" = 映射_行;
    如果 (映射_全局表 ?= "") { 映射_行 = 映射_全局表; }
    否则 { 映射_全局表 + "\n" = 映射_全局表; 映射_全局表 + 映射_行 = 映射_全局表; }
    ()新寄存器 = 映射_大小分配;
    ("  " + 映射_大小分配 + " = 分配 i32, align 4")发射;
    ("  存储 i32 0, ptr " + 映射_大小分配 + ", align 4")发射;
    ()新寄存器 = 映射_键数组地址;
    ("  " + 映射_键数组地址 + " = 获取元素指针 %映射类型, ptr " + 映射_全局名 + ", i32 0, i32 0")发射;
    ()新寄存器 = 映射_值数组地址;
    ("  " + 映射_值数组地址 + " = 获取元素指针 %映射类型, ptr " + 映射_全局名 + ", i32 0, i32 1")发射;
    0 = 映射_i;
    当 (映射_i < 映射_n) {
        (节点, 映射_i)取子 = 键叶;
        (键叶)取文本 = 映射_键文本;
        (映射_键文本)解码字面 = 映射_键明文;
        (映射_键明文)存字符串常量 = 映射_键;
        映射_i + 1 = 映射_i;
        (节点, 映射_i)取子 = 值节点;
        (值节点)发射表达式;
        如果 (表达式类型 ?= "字符串") { 表达式C = 映射_值; }
        否则 {
            ()新寄存器 = 映射_值;
            ("  " + 映射_值 + " = 调用 ptr (i32) @" + ("辅助转字符串")转义标识符 + "(i32 " + 表达式C + ")")发射;
        }
        ()新寄存器 = 映射_大小值;
        ("  " + 映射_大小值 + " = 加载 i32, ptr " + 映射_大小分配 + ", align 4")发射;
        ()新寄存器 = 映射_新大小;
        ("  " + 映射_新大小 + " = 调用 i32 (ptr, ptr, i32, ptr, ptr) @映射设置(ptr " + 映射_键数组地址 + ", ptr " + 映射_值数组地址 + ", i32 " + 映射_大小值 + ", ptr " + 映射_键 + ", ptr " + 映射_值 + ")")发射;
        ("  存储 i32 " + 映射_新大小 + ", ptr " + 映射_大小分配 + ", align 4")发射;
        映射_i + 1 = 映射_i;
    }
    映射_全局名 = 表达式C;
    "映射" = 表达式类型;
}

// 条件表达式（旧前端未支持；占位）
函数 (节点:整数)发射条件表达式 {
    (节点)发射表达式兜底;
}

// ============================================
// 语句发射 (S4.4b)
// ============================================

函数 (节点:整数)发射语句 {
    (节点)取种类 = 种;
    如果 (种 ?= "代码块") { (节点)发射代码块; }
    否则如果 (种 ?= "表达式语句") {
        (节点, 0)取子 = 子;
        (子)发射表达式;
    }
    否则如果 (种 ?= "赋值") { (节点)发射赋值; }
    否则如果 (种 ?= "返回") { (节点)发射返回语句; }
    否则如果 (种 ?= "中断") {
        ()查退出栈 = 中断标签;
        ("分支 标签 %" + 中断标签)发射终结;
    }
    否则如果 (种 ?= "继续") {
        ()查继续栈 = 继续标签2;
        ("分支 标签 %" + 继续标签2)发射终结;
    }
    否则如果 (种 ?= "如果") { (节点)发射如果; }
    否则如果 (种 ?= "当") { (节点)发射当; }
    否则如果 (种 ?= "循环") { (节点)发射循环; }
    否则如果 (种 ?= "遍历") { (节点)发射遍历; }
    否则如果 (种 ?= "匹配") { (节点)发射匹配; }
    否则 { }
}

函数 (节点:整数)发射代码块 {
    (节点)取子数 = 块数;
    0 = 块i;
    当 (块i < 块数) {
        (节点, 块i)取子 = 语句;
        (语句)发射语句;
        块i + 1 = 块i;
    }
}

函数 (节点:整数)发射返回语句 {
    (节点)取子数 = 返数;
    如果 (返数 ?= 0) { ("返回 void")发射终结; }
    否则 {
        (节点, 0)取子 = 返值;
        (返值)发射表达式;
        如果 (表达式类型 ?= "字符串") { ("返回 ptr " + 表达式C)发射终结; }
        否则如果 (表达式类型 ?= "浮点") { ("返回 double " + 表达式C)发射终结; }
        否则 { ("返回 i32 " + 表达式C)发射终结; }
    }
}

函数 (节点:整数)发射当 {
    (节点, 0)取子 = 当条件;
    (节点, 1)取子 = 当体;
    ()新标签 = 当头标签;
    ()新标签 = 当体标签;
    ()新标签 = 当退出标签;
    (当退出标签)压退出栈;
    (当头标签)压继续栈;
    (当头标签)发射标签;
    (当条件)发射表达式;
    ()发射条件;
    ("分支 i1 " + 当前条件 + ", 标签 %" + 当体标签 + ", 标签 %" + 当退出标签)发射终结;
    (当体标签)发射标签;
    (当体)发射代码块;
    ("分支 标签 %" + 当头标签)发射终结;
    (当退出标签)发射标签;
    ()弹退出栈;
    ()弹继续栈;
}

函数 (节点:整数)发射循环 {
    (节点, 0)取子 = 循环头节点;
    (节点, 1)取子 = 循环体节点;
    (循环头节点, 0)取子 = 循环变量叶;
    (循环变量叶)取文本 = 循环变量;
    (循环头节点, 1)取子 = 循环开始节点;
    (循环开始节点)发射表达式;
    表达式C = 循环开始C;
    (循环头节点, 2)取子 = 循环结束节点;
    (循环结束节点)发射表达式;
    表达式C = 循环结束C;
    (循环头节点)取子数 = 循环头数;
    如果 (循环头数 >= 4) {
        (循环头节点, 3)取子 = 循环步长节点;
        (循环步长节点)发射表达式;
        表达式C = 循环步长C;
    } 否则 {
        "1" = 循环步长C;
    }
    (循环变量, "I")局部表添加;
    (循环变量)转义标识符 = 循环变量转义;
    ()新标签 = 范围头标签;
    ()新标签 = 范围体标签;
    ()新标签 = 范围步长标签;
    ()新标签 = 范围退出标签;
    (范围退出标签)压退出栈;
