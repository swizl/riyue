函数 (节点:整数)发射匹配 {
    (节点, 0)取子 = 匹配值节点;
    (匹配值节点)发射表达式;
    表达式C = 匹配_值;
    表达式类型 = 匹配_值类型;
    ()新标签 = 匹配_检查标签;
    ()新标签 = 匹配_合并标签;
    0 = 匹配_有默认;
    ("分支 标签 %" + 匹配_检查标签)发射终结;
    (节点)取子数 = 匹配_子数;
    1 = 匹配_i;
    当 (匹配_i < 匹配_子数) {
        (匹配_检查标签)发射标签;
        (节点, 匹配_i)取子 = 匹配分支;
        (匹配分支)取子数 = 匹配分支数;
        如果 (匹配分支数 ?= 1) {
            1 = 匹配_有默认;
            (匹配分支, 0)取子 = 匹配分支体;
            (匹配分支体)发射代码块;
            如果 (已终结 ?= 0) { ("分支 标签 %" + 匹配_合并标签)发射终结; }
            匹配_i = 匹配_子数;
        } 否则 {
            (匹配分支, 0)取子 = 匹配条件节点;
            (匹配分支, 1)取子 = 匹配分支体;
            (匹配条件节点)取种类 = 匹配条件种;
            0 = 匹配_绑定;
            "" = 匹配_条件名;
            0 = 是整数条;
            如果 (匹配条件种 ?= "整数") { 1 = 是整数条; }
            如果 (匹配条件种 ?= "数字") { 1 = 是整数条; }
            0 = 是字符串条;
            如果 (匹配条件种 ?= "字符串") { 1 = 是字符串条; }
            如果 (匹配条件种 ?= "字串") { 1 = 是字符串条; }
            0 = 是变量条;
            如果 (匹配条件种 ?= "变量") { 1 = 是变量条; }
            如果 (匹配条件种 ?= "标识符") { 1 = 是变量条; }
            如果 (是整数条 ?= 1) {
                (匹配条件节点)取文本 = 匹配_条件;
                "整数" = 匹配_条件类型;
            } 否则如果 (是字符串条 ?= 1) {
                (匹配条件节点)取文本 = 匹配_暂;
                (匹配_暂)解码字面 = 匹配_暂明文;
                (匹配_暂明文)存字符串结构常量 = 匹配_条件;
                "字符串" = 匹配_条件类型;
            } 否则如果 (匹配条件种 ?= "后缀") {
                (匹配条件节点, 0)取子 = 枚举名叶;
                (枚举名叶)取文本 = 枚举名;
                (匹配条件节点, 1)取子 = 双冒节点;
                (双冒节点)取子数 = 匹配双冒子数;
                0 = 枚举成员叶;
                如果 (匹配双冒子数 >= 2) {
                    (双冒节点, 1)取子 = 枚举成员叶;
                } 否则 {
                    (双冒节点, 0)取子 = 枚举成员叶;
                }
                (枚举成员叶)取文本 = 枚举成员名;
                (枚举_成员表, 枚举名 + "::" + 枚举成员名)查表值 = 匹配_条件;
                "整数" = 匹配_条件类型;
            } 否则如果 (是变量条 ?= 1) {
                (匹配条件节点)取文本 = 匹配_条件名;
                1 = 匹配_绑定;
                "整数" = 匹配_条件类型;
            } 否则 {
                "0" = 匹配_条件;
                "整数" = 匹配_条件类型;
            }
            如果 (匹配_绑定 ?= 1) {
                (匹配_条件名)转义标识符 = 匹配_绑定转义;
                如果 (匹配_值类型 ?= "字符串") {
                    (匹配_条件名, "S")局部表添加;
                    ("存储 指针 " + 匹配_值 + ", 指针 %" + 匹配_绑定转义 + ", 对齐 8")发射;
                } 否则 {
                    (匹配_条件名, "I")局部表添加;
                    ("存储 整数32 " + 匹配_值 + ", 指针 %" + 匹配_绑定转义 + ", 对齐 4")发射;
                }
                1 = 匹配_有默认;
                (匹配分支体)发射代码块;
                如果 (已终结 ?= 0) { ("分支 标签 %" + 匹配_合并标签)发射终结; }
                匹配_i = 匹配_子数;
            } 否则 {
                ()新标签 = 匹配_体标签;
                ()新标签 = 匹配_下标签;
                如果 (匹配_值类型 ?= "字符串") {
                    ()新寄存器 = 匹配_比较;
                    ("  " + 匹配_比较 + " = 调用 整数32 (指针, 指针) @" + ("胖字符串比较")转义标识符 + "(指针 " + 匹配_值 + ", 指针 " + 匹配_条件 + ")")发射;
                    ()新寄存器 = 匹配_比较2;
                    ("  " + 匹配_比较2 + " = 整数比较 等于 整数32 " + 匹配_比较 + ", 0")发射;
                } 否则 {
                    ()新寄存器 = 匹配_比较2;
                    ("  " + 匹配_比较2 + " = 整数比较 等于 整数32 " + 匹配_值 + ", " + 匹配_条件)发射;
                }
                ("分支 整数1 " + 匹配_比较2 + ", 标签 %" + 匹配_体标签 + ", 标签 %" + 匹配_下标签)发射终结;
                (匹配_体标签)发射标签;
                (匹配分支体)发射代码块;
                如果 (已终结 ?= 0) { ("分支 标签 %" + 匹配_合并标签)发射终结; }
                匹配_下标签 = 匹配_检查标签;
            }
        }
        匹配_i + 1 = 匹配_i;
    }
    如果 (匹配_有默认 ?= 0) {
        (匹配_检查标签)发射标签;
        ("分支 标签 %" + 匹配_合并标签)发射终结;
    }
    (匹配_合并标签)发射标签;
}

函数 (节点:整数)发射如果 {
    (节点)取子数 = 如果子数;
    ()新标签 = 如果合并标签;
    (节点, 0)取子 = 如果头节点;
    (如果头节点)取子数 = 头子数;
