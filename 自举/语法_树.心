            (泛型结构体成员名表, 泛型基名)文本表取 = 泛型成员名串;
            (泛型结构体成员类型表, 泛型基名)文本表取 = 泛型成员类型串;
            (泛型参数串)分割行数 = 泛型参数数;
            (泛型成员名串)分割行数 = 泛型成员数;
            ()新建文本表 = 泛型替换表;
            // 方法特化用：类型参数名 → 实参名（\n 分隔），入 泛型待发 供延迟发射方法体时建替换表。
            "" = 泛型替换名串;
            "" = 泛型替换值串;
            0 = 泛型参数i;
            当 (泛型参数i < 泛型参数数) {
                (泛型参数串, 泛型参数i)获取行 = 泛型参数名0;
