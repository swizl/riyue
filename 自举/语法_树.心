    否则如果 (符 ?= "*") { 1 = 成; 左 * 右 = 编译期_结果; }
    否则如果 (符 ?= "/") { 如果 (右 ?= 0) { } 否则 { 1 = 成; 左 / 右 = 编译期_结果; } }
    否则如果 (符 ?= "%") { 如果 (右 ?= 0) { } 否则 { 1 = 成; 左 % 右 = 编译期_结果; } }
    否则如果 (符 ?= "==") { 1 = 成; 0 = 编译期_结果; 如果 (左 ?= 右) { 1 = 编译期_结果; } }
    否则如果 (符 ?= "!=") { 1 = 成; 1 = 编译期_结果; 如果 (左 ?= 右) { 0 = 编译期_结果; } }
    否则如果 (符 ?= "<") { 1 = 成; 0 = 编译期_结果; 如果 (左 < 右) { 1 = 编译期_结果; } }
    否则如果 (符 ?= ">") { 1 = 成; 0 = 编译期_结果; 如果 (左 > 右) { 1 = 编译期_结果; } }
    否则如果 (符 ?= "<=") { 1 = 成; 0 = 编译期_结果; 如果 (左 <= 右) { 1 = 编译期_结果; } }
    否则如果 (符 ?= ">=") { 1 = 成; 0 = 编译期_结果; 如果 (左 >= 右) { 1 = 编译期_结果; } }
    否则如果 (符 ?= "&&") { 1 = 成; 0 = 编译期_结果; 如果 (左 != 0 && 右 != 0) { 1 = 编译期_结果; } }
    否则如果 (符 ?= "||") { 1 = 成; 0 = 编译期_结果; 如果 (左 != 0 || 右 != 0) { 1 = 编译期_结果; } }
    否则如果 (符 ?= "&") { 1 = 成; 左 & 右 = 编译期_结果; }
    否则如果 (符 ?= "^") { 1 = 成; 左 ^ 右 = 编译期_结果; }
    否则如果 (符 ?= "<|") { 如果 (右 >= 0 && 右 <= 31) { 1 = 成; 左 <| 右 = 编译期_结果; } }
    否则如果 (符 ?= ">|") { 如果 (右 >= 0 && 右 <= 31) { 1 = 成; 左 >| 右 = 编译期_结果; } }
}

// 表达式求值：成 置 1 表示可解释，结果置 编译期_结果
函数 (节点:整数)编译期求表达式(0 = 成:整数) {
