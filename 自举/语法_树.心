函数 发射局部声明 {
    0 = 索引;
    (局部类型表)文本表键数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)文本表键 = 局部名;
        (局部类型表, 局部名)文本表取 = 提取类型码;
        (已声明表, 局部名)文本表含 = 已声明命中;
        如果 (已声明命中 ?= 0) {
            (局部名)转义标识符 = 局部转义;
            如果 (提取类型码 ?= "S") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "C") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "F") { ("%" + 局部转义 + " = 分配 双精度, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "B") { ("%" + 局部转义 + " = 分配 整数8, 对齐 1")发射; }
