            (可变视图表, 目标名, "1")表添加 = 可变视图表;
        } 否则 {
            // 只读借用不与已有可变借用共存。
            (当前分片源名)是可变借用源 = 借用冲突命2;
            如果 (借用冲突命2 ?= 1) {
                "可变借用冲突: 源 '" + 当前分片源名 + "' 已被可变视图借用" = 借用冲突消息2;
                (借用冲突消息2)借用报错;
            }
        }
        (借用视图源表, 目标名, 当前分片源名)表添加 = 借用视图源表;
        (借用视图深度表, 目标名, 借用深度文本)表添加 = 借用视图深度表;
    }
    如果 (表达式类型 ?= "字符串" || 表达式类型 ?= "指针" || 表达式类型 ?= "切片") {
        ("存储 指针 " + 保存存储值 + ", 指针 " + 目标地址 + ", 对齐 8")发射;
    } 否则如果 (表达式类型 ?= "未知") {
        如果 (存储IR ?= "指针") {
