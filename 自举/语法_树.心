        0 = 索引;
        (闭包捕获表)文本表键数 = 行数;
        当 (索引 < 行数) {
            (闭包捕获表, 索引)文本表键 = 行;
            (行, 闭包函数名 + ":")字符串开头 = 开头命中;
            如果 (开头命中 ?= 1) {
                (闭包函数名)长度 = 函数名长;
                (行)长度 = 行总长;
                (行, 函数名长 + 1, 行总长 - 函数名长 - 1)子串 = 捕获名;
