    }
    否则如果 (求种 ?= "布尔值") {
        (节点)取文本 = 求文;
        0 = 编译期_结果;
        如果 (求文 ?= "真") { 1 = 编译期_结果; }
        1 = 成;
    }
    否则如果 (求种 ?= "变量" || 求种 ?= "标识符") {
        (节点)取文本 = 求名;
        (求名)编译期查变量 = 求有;
        如果 (求有 ?= 1) {
