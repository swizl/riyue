                }
            }
            (结构体_变量表, 参数名, 参数结构体名)表替换 = 结构体_变量表;
        }
        (已声明表, 参数名, "X")表添加 = 已声明表;
        如果 (参数变长 ?= 1) { "指针" = 参数类型IR; }
        否则 { (参数类型名)类型名到IR = 参数类型IR; }
        // 协程纤维入口逐槽加载：登记形参 IR 类型（\n 分隔，与调用点帧槽一一对应）。
        本函数形参IR串 + 参数类型IR = 本函数形参IR串;
