函数 (节点:整数)发射赋值 {
    (节点)取子数 = 赋值子数;
    (节点, 0)取子 = 赋值甲;
    (赋值甲)取种类 = 赋值甲种;
    (节点, 赋值子数 - 1)取子 = 赋值乙;
    (赋值乙)取种类 = 赋值乙种;
    "" = 值侧类型;
    如果 (赋值子数 >= 3) {
        (节点, 1)取子 = 赋值子;
        (赋值子)取种类 = 赋值子种;
        如果 (赋值子种 ?= "类型") { (赋值子)取文本 = 值侧类型; }
    }
    // 反向赋值：本行含义为「声明目标类型 := 值侧类型」。每条赋值语句都重设它，
    // 避免上一语句残留的标注泄漏到无标注的目标上（否则 `0 = 甲;` 会被当成上一句的类型）。
    值侧类型 = 声明目标类型;
    0 = 首是标识;
    如果 (赋值甲种 ?= "标识符") { 1 = 首是标识; }
