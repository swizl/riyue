        (变长写元素名)类型名到IR = 变长写元素IR;
        "" = 变长写对齐;
        如果 (变长写元素IR ?= "整数8") { "1" = 变长写对齐; }
        否则如果 (变长写元素IR ?= "整数16") { "2" = 变长写对齐; }
        否则如果 (变长写元素IR ?= "整数32") { "4" = 变长写对齐; }
        否则 { "8" = 变长写对齐; }
        (目标名)转义标识符 = 变长写转义;
        如果 (命中全局表 ?= 1) { "@" + 变长写转义 = 变长写地址; }
        否则 { "%" + 变长写转义 = 变长写地址; }
        ()新寄存器 = 变长写加载;
        ("  " + 变长写加载 + " = 加载 指针, 指针 " + 变长写地址 + ", 对齐 8")发射;
        ()新寄存器 = 变长写元素地址;
        ("  " + 变长写元素地址 + " = 获取元素指针 " + 变长写元素IR + ", 指针 " + 变长写加载 + ", 整数32 " + 保存下标)发射;
        (保存存储值, 保存存储IR, 变长写元素IR)转换IR = 变长写值;
        ("  存储 " + 变长写元素IR + " " + 变长写值 + ", 指针 " + 变长写元素地址 + ", 对齐 " + 变长写对齐)发射;
    } 否则 {
    (目标名)查数组大小 = 数组大小文本;
    (目标名)查数组元素码 = 数组元素码;
    (数组元素码)数组元素转IR = 数组元素IR;
