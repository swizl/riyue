                    (泛型实参名0)长度 = 泛型实参名0长;
                    (泛型实参名0, 0, 泛型实参名0长)子串 = 泛型实参名;
                    (泛型替换表, 泛型参数名, 泛型实参名)表替换 = 泛型替换表;
                    如果 (泛型替换名串 ?= "") {
                        泛型参数名 = 泛型替换名串;
                        泛型实参名 = 泛型替换值串;
