            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "V") {
            // 阶段4B：变长形参 —— alloca 存指向 整数32 数组的指针。
            ("%" + 参数转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "U") {
            ("%" + 参数转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "P") {
            ("%" + 参数转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "L") {
            // 内存安全 §4.3 阶段A：切片 T[:] 参数为胖切片指针句柄。
            ("%" + 参数转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "D") {
            ("%" + 参数转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "E") {
            ("%" + 参数转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "F") {
            ("%" + 参数转义 + " = 分配 双精度, 对齐 8")发射;
            ("存储 双精度 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "B") {
            ("%" + 参数转义 + " = 分配 整数8, 对齐 1")发射;
            ("存储 整数8 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 1")发射;
        } 否则如果 (参数码 ?= "H") {
            ("%" + 参数转义 + " = 分配 整数16, 对齐 2")发射;
            ("存储 整数16 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 2")发射;
        } 否则如果 (参数码 ?= "J") {
            ("%" + 参数转义 + " = 分配 整数64, 对齐 8")发射;
            ("存储 整数64 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 8")发射;
        } 否则如果 (参数码 ?= "G") {
            ("%" + 参数转义 + " = 分配 单精度, 对齐 4")发射;
            ("存储 单精度 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 4")发射;
        } 否则 {
            ("%" + 参数转义 + " = 分配 整数32, 对齐 4")发射;
            ("存储 整数32 %" + 参数入转义 + ", 指针 %" + 参数转义 + ", 对齐 4")发射;
        }
        (参数名, 参数码)登记局部变量;
        索引 + 1 = 索引;
    }
}

函数 发射局部声明 {
    0 = 索引;
    (局部类型表)文本表键数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)文本表键 = 局部名;
        (局部类型表, 局部名)文本表取 = 提取类型码;
        (已声明表, 局部名)文本表含 = 已声明命中;
        如果 (已声明命中 ?= 0) {
            (局部名)转义标识符 = 局部转义;
            如果 (提取类型码 ?= "S") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "C") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "F") { ("%" + 局部转义 + " = 分配 双精度, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "B") { ("%" + 局部转义 + " = 分配 整数8, 对齐 1")发射; }
            否则如果 (提取类型码 ?= "H") { ("%" + 局部转义 + " = 分配 整数16, 对齐 2")发射; }
            否则如果 (提取类型码 ?= "J") { ("%" + 局部转义 + " = 分配 整数64, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "G") { ("%" + 局部转义 + " = 分配 单精度, 对齐 4")发射; }
            否则如果 (提取类型码 ?= "A") {
                (局部名)查数组大小 = 数组大小文本;
                (局部名)查数组元素码 = 数组元素码;
                (数组元素码)数组元素转IR = 数组元素IR;
                (数组元素码)数组对齐 = 数组对齐值;
                ("%" + 局部转义 + " = 分配 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 对齐 " + 数组对齐值)发射;
            }
            否则如果 (提取类型码 ?= "O") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "D") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "E") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "M") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "T") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "U") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "P") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "L") { ("%" + 局部转义 + " = 分配 指针, 对齐 8")发射; }
            否则 { ("%" + 局部转义 + " = 分配 整数32, 对齐 4")发射; }
            (局部名, 提取类型码)登记局部变量;
            (已声明表, 局部名, "X")表添加 = 已声明表;
        }
        索引 + 1 = 索引;
    }
