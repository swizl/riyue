// 内存安全 §八 O4a：调用返回切片视图 → 表达式类型置「切片」，并发布「视图源 = 实参名」
// （复用 发射值存储 的借用登记；实参须为裸变量，否则保守不登记）。
函数 (节点:整数, 函数名:字符串)发布视图返回源 {
    (函数返回表, 函数名)文本表含 = 视返回有;
    如果 (视返回有 ?= 1) {
        (函数返回表, 函数名)文本表取 = 视返回码;
        如果 (视返回码 ?= "L") {
            "切片" = 表达式类型;
            (视图返回形参序号表, 函数名)文本表含 = 视形参序有;
            如果 (视形参序有 ?= 1) {
                (视图返回形参序号表, 函数名)文本表取 = 视形参序文本;
                (视形参序文本)转整数 = 视形参序;
                (节点)取子数 = 视实参数;
                如果 (视形参序 < 视实参数) {
                    (节点, 视形参序)取子 = 视实参;
                    (视实参)取种类 = 视实参种;
                    如果 (视实参种 ?= "变量" || 视实参种 ?= "标识符") {
                        (视实参)取文本 = 当前分片源名;
                    }
                }
            }
        }
    }
}

// 普通函数调用发射（无内建/闭包匹配）：按 函数返回表/类型表 决定返回类型
函数 发射普通调用 {
    (函数名)查函数返回类型 = 类型码;
    (函数名)转义标识符 = 函数转义;
    (函数多返回表, 函数名)查表值 = 多返回体;
    如果 (多返回体 ?= "") {
    如果 (类型码 ?= 0) {
        (函数名)查类型 = 变量码;
        如果 (变量码 ?= 4) {
            (函数名)取地址 = 指针地址;
            ()新寄存器 = 函数指针;
            ("  " + 函数指针 + " = 加载 指针, 指针 " + 指针地址 + ", 对齐 8")发射;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 整数32 (" + 参数类型IR + ") " + 函数指针 + "(" + 参数前缀文本 + ")")发射;
            "整数" = 表达式类型;
        } 否则 {
            如果 (用户函数命中 ?= 0) {
                // 本模块未定义、也非内建函数：视为外部符号（如动态库导出函数），
                // 登记后在模块末尾统一补一条声明，供 llvm-as 解析、链接期由提供者解析
                (外部声明表, 函数转义, 参数类型IR)表添加 = 外部声明表;
            }
            ("调用 空类型 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
            "" = 表达式C;
            "空" = 表达式类型;
        }
    } 否则如果 (类型码 ?= 2) {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 指针 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
        "字符串" = 表达式类型;
    } 否则如果 (类型码 ?= 3) {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 双精度 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
        "浮点" = 表达式类型;
    } 否则如果 (类型码 ?= 4) {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 指针 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
        "指针" = 表达式类型;
    } 否则如果 (类型码 ?= 24) {
        // 内存安全 §4.3 A.7：`字符` 返回值（IR 整数32），调用点保留 字符 类型
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 整数32 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
        "文字" = 表达式类型;
    } 否则 {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 整数32 (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
        "整数" = 表达式类型;
    }
    } 否则 {
        // 多返回值：整体返回结构体，供解构赋值逐元素 提取值
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 {" + 多返回体 + "} (" + 参数类型IR + ") @" + 函数转义 + "(" + 参数前缀文本 + ")")发射;
        (函数多返回元素表, 函数名)查表值 = 多返回元素码;
        "元组" = 表达式类型;
    }
}

// ────────────────────────────────────────────
// 后缀链 (S4.4b)：左 = 基表达式，项 = 后缀项
// ────────────────────────────────────────────
函数 (节点:整数)发射后缀 {
    (节点, 0)取子 = 左;
    (节点, 1)取子 = 项;
    (项)取种类 = 种项;
    如果 (种项 ?= "结构体实例") {
        (左)取文本 = 类型名;
        (类型名, 项)发射结构体实例;
    } 否则如果 (种项 ?= "双冒访问") {
        (左)取文本 = 枚举名;
        (项)取子数 = 双冒子数;
        0 = 名字叶;
        如果 (双冒子数 >= 2) {
            (项, 1)取子 = 名字叶;
        } 否则 {
            (项, 0)取子 = 名字叶;
        }
        (名字叶)取文本 = 枚举成员名;
        (枚举_成员表, 枚举名 + "::" + 枚举成员名)查表值 = 表达式C;
        "整数" = 表达式类型;
    } 否则如果 (种项 ?= "成员调用") {
        (左, 项)发射成员调用;
    } 否则如果 (种项 ?= "管道") {
        (左, 项)发射管道;
    } 否则 {
        (左)发射表达式;
        (项)发射后缀项;
    }
}

函数 (节点:整数)发射后缀项 {
    (节点)取种类 = 种;
    如果 (种 ?= "成员访问") { (节点)发射成员访问; }
    否则如果 (种 ?= "下标访问") { (节点)发射下标访问; }
    否则如果 (种 ?= "分片") { (节点)发射分片访问; }
    否则如果 (种 ?= "元组访问") { (节点)发射元组访问; }
    否则 { }
}

// 管道（8AN）：`左 | 函数名` / `左 |(映射)函数名(额外参数)`。
// 与宿主链 源/后端/代码生成器_表达式.cpp 的 管道调用 语义一致：左值作为被调函数实参，
// 有映射时按形参名定位落点，其余空槽按序由额外实参填充、仍空者以 0 占位。此处以合成
// 「函数调用」节点复用 发射调用（内建 打印 / 变长 / 内存安全 等逻辑随之与宿主链对齐）。
函数 (左:整数, 项:整数)发射管道 {
    "" = 管函数名;
    -1 = 管映射节点;
    -1 = 管额外节点;
    ()新子列表 = 管额外表;
    (项)取子数 = 管子数;
    0 = 管i;
    当 (管i < 管子数) {
        (项, 管i)取子 = 管子;
        (管子)取种类 = 管子种;
        如果 (管子种 ?= "标识符") { (管子)取文本 = 管函数名; }
        否则如果 (管子种 ?= "管道映射") { 管子 = 管映射节点; }
        否则如果 (管子种 ?= "额外参数") { 管子 = 管额外节点; }
        管i + 1 = 管i;
    }
    如果 (管额外节点 != -1) {
        (管额外节点)取子数 = 管额外数;
        0 = 管额外i;
        当 (管额外i < 管额外数) {
            (管额外节点, 管额外i)取子 = 管额外实参;
            (管额外表, 管额外实参)子列表添加;
            管额外i + 1 = 管额外i;
        }
    }
    (管额外表)动态数组大小 = 管额外表长;
    ()新子列表 = 管参数表;
    (管函数名)在用户函数表 = 管是用户;
    如果 (管是用户 ?= 1) {
        // 用户函数：按形参槽位对齐。无映射时落点=0（等价位置语义）；有映射时落点=命中的
        // 形参序号，未命中则为 -1（左值不落任何槽，与宿主链「映射名不存在则丢弃左值」一致）。
        0 = 管落点;
        如果 (管映射节点 != -1) {
            -1 = 管落点;
            (管映射节点)取子数 = 管映射数;
            1 = 管映射i;
            当 (管映射i < 管映射数) {
                (管映射节点, 管映射i)取子 = 管右名叶;
                (管右名叶)取文本 = 管右名;
                (管函数名, 管右名)形参名序号 = 管命中;
                如果 (管命中 != -1) { 管命中 = 管落点; }
                管映射i + 2 = 管映射i;
            }
        }
        (管函数名)形参个数 = 管槽数;
        0 = 管游标;
        0 = 管槽j;
        当 (管槽j < 管槽数) {
            如果 (管槽j ?= 管落点) {
                (管参数表, 左)子列表添加;
            } 否则如果 (管游标 < 管额外表长) {
                (管额外表, 管游标)动态数组获取 = 管顺实参;
                (管参数表, 管顺实参)子列表添加;
                管游标 + 1 = 管游标;
            } 否则 {
                ("整数", "0")新叶 = 管零叶;
                (管参数表, 管零叶)子列表添加;
            }
            管槽j + 1 = 管槽j;
        }
    } 否则 {
        // 非用户函数（如内建 打印）：位置语义，左值 + 额外实参。
        (管参数表, 左)子列表添加;
        0 = 管游标;
        当 (管游标 < 管额外表长) {
            (管额外表, 管游标)动态数组获取 = 管顺实参;
            (管参数表, 管顺实参)子列表添加;
            管游标 + 1 = 管游标;
        }
    }
    ("函数调用", 管函数名, 管参数表)新节点 = 管调用节点;
    (管调用节点)发射调用;
}

// 8AN：在 函数形参名表 中按名定位序号（未命中返回 -1）。
函数 (函名:字符串, 目标名:字符串)形参名序号(0 = 序号:整数) {
    -1 = 序号;
    0 = 探i;
    1 = 探续;
    当 (探续 ?= 1) {
        (函数形参名表, 函名 + "#" + (探i)转字符串)文本表含 = 探在;
        如果 (探在 ?= 0) { 0 = 探续; }
        否则 {
            (函数形参名表, 函名 + "#" + (探i)转字符串)文本表取 = 探名;
            如果 (探名 ?= 目标名) { 探i = 序号; 0 = 探续; }
            否则 { 探i + 1 = 探i; }
        }
    }
}

// 8AN：按 函数形参名表 中的登记项数取函数形参个数（未登记返回 0）。
函数 (函名:字符串)形参个数(0 = 个数:整数) {
    0 = 个数;
    1 = 数续;
    当 (数续 ?= 1) {
        (函数形参名表, 函名 + "#" + (个数)转字符串)文本表含 = 数在;
        如果 (数在 ?= 0) { 0 = 数续; }
        否则 { 个数 + 1 = 个数; }
    }
}

// 内存安全 §4.2：解引用前空检查。入口：表达式C = 将被解引用的指针（结构体/映射句柄基址）。
// 发射 @运行时空检查(指针, 指针) 调用，位置串为编译期常量（存字符串常量）。
函数 (位置:字符串)发射空检查 {
    (位置)存字符串常量 = 空检位置;
    ("  调用 空类型 (指针, 指针) @运行时空检查(指针 " + 表达式C + ", 指针 " + 空检位置 + ")")发射;
}

// 阶段7（G7）：契约检查——前置条件 当前条件 为假时调用 @运行时契约失败 并中止；否则落穿继续。
函数 (诊断:字符串)发射契约检查 {
    ()新标签 = 契约失败标签;
    ()新标签 = 契约通过标签;
    (诊断)存字符串常量 = 契约诊断号;
    ("分支 整数1 " + 当前条件 + ", 标签 %" + 契约通过标签 + ", 标签 %" + 契约失败标签)发射终结;
    (契约失败标签)发射标签;
    ("  调用 空类型 (指针) @运行时契约失败(指针 " + 契约诊断号 + ")")发射;
    ("  不可达")发射终结;
    (契约通过标签)发射标签;
}

函数 (节点:整数)发射成员访问 {
    (节点, 0)取子 = 名字叶;
    (名字叶)取文本 = 成员名;
    (当前结构体名, 成员名)查结构体成员索引 = 成员索引;
    (当前结构体名, 成员名)查结构体成员类型 = 成员类型;
    // 内存安全 §4.2：解引用前空检查（成员访问）。
    ("成员访问 " + 当前结构体名 + "." + 成员名)发射空检查;
    ()新寄存器 = 成员指针;
    ("  " + 成员指针 + " = 获取元素指针 %" + 当前结构体名 + ", 指针 " + 表达式C + ", 整数32 0, 整数32 " + 成员索引)发射;
    如果 (成员类型 ?= "整数") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 整数32, 指针 " + 成员指针 + ", 对齐 4")发射;
        "整数" = 表达式类型;
    } 否则如果 (成员类型 ?= "字符串") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 指针, 指针 " + 成员指针 + ", 对齐 8")发射;
        "字符串" = 表达式类型;
    } 否则如果 (成员类型 ?= "浮点") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 双精度, 指针 " + 成员指针 + ", 对齐 8")发射;
        "浮点" = 表达式类型;
    } 否则 {
        // 阶段4C2 前置⑤：数组成员（`T[]`/`T[N]`）下标链。旧条件 `成员类型 ?= "数组"` 恒假
        //（真实成员类型名是 `整数[]`/`T[]`/`整数[3]`），故改用 结构体_数组表 判据：该表在
        // 结构体字面量处与定长成员定义处写入 `元素码:大小`，命中即数组分支。
        (当前结构体名, 成员名)查结构体成员数组元素码 = 成员数组元素码;
        如果 (成员数组元素码 != "") {
            (当前结构体名, 成员名)查结构体成员数组大小 = 结构体大小;
            ()新寄存器 = 链式加载;
            ("  " + 链式加载 + " = 加载 指针, 指针 " + 成员指针 + ", 对齐 8")发射;
            链式加载 = 表达式C;
            链式加载 = 链式数组基址;
            结构体大小 = 数组大小文本;
            成员数组元素码 = 数组元素码;
            1 = 链式数组标志;
            "数组" = 表达式类型;
        } 否则 {
            成员类型 = 当前结构体名;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 加载 指针, 指针 " + 成员指针 + ", 对齐 8")发射;
            "结构体" = 表达式类型;
        }
    }
}

// 成员方法调用：基表达式为结构体变量，组装 结构体名_方法名(基址, 实参...) 合成调用节点
// 项节点子 = [标识符(方法名), 实参...]；左节点 = 基表达式（结构体变量标识符）
函数 (左:整数, 项:整数)发射成员调用 {
    (左)取文本 = 基名;
    (基名)查结构体变量类型 = 基结构体名;
    如果 (基结构体名 ?= "") { 基结构体名 = 当前结构体名; }
    (项, 0)取子 = 方法名叶;
    (方法名叶)取文本 = 方法名;
    // 内存安全 §4.2：方法调用前对接收者做空检查。先求值基表达式（加载出结构体句柄）再检查；
    // 随后合成调用节点时会重新求值基名（幂等加载），不影响语义。
    (左)发射表达式;
    ("方法调用 " + 基结构体名 + "." + 方法名)发射空检查;
    基结构体名 + "_" = 合成名;
    合成名 + 方法名 = 合成名;
    ()新子列表 = 成员调用参数;
    (成员调用参数, 左)子列表添加;
    (项)取子数 = 成员调用子数;
    1 = 成员调用i;
    当 (成员调用i < 成员调用子数) {
        (项, 成员调用i)取子 = 成员实参;
        (成员调用参数, 成员实参)子列表添加;
        成员调用i + 1 = 成员调用i;
    }
    ("函数调用", 合成名, 成员调用参数)新节点 = 成员调用节点;
    (成员调用节点)发射调用;
}

函数 (节点:整数)发射下标访问 {
    表达式C = 基地址;
    表达式类型 = 基类型;
    (节点, 0)取子 = 索引节点;
    (索引节点)发射表达式;
    表达式C = 保存下标;
    如果 (基类型 ?= "数组") {
        如果 (链式数组标志 ?= 1) {
            0 = 链式数组标志;
            链式数组基址 = 基地址;
        } 否则 {
            (当前数组名)查数组大小 = 数组大小文本;
            (当前数组名)查数组元素码 = 数组元素码;
        }
        (数组元素码)数组元素转IR = 数组元素IR;
        (数组元素码)数组对齐 = 数组对齐值;
        ()新寄存器 = 下标扩展;
        ("  " + 下标扩展 + " = 零扩展 整数32 " + 保存下标 + " 到 整数64")发射;
        (数组大小文本)发射越界检查;
        ()新寄存器 = 元素指针;
        ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 指针 " + 基地址 + ", 整数64 0, 整数64 " + 下标扩展)发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 " + 数组元素IR + ", 指针 " + 元素指针 + ", 对齐 " + 数组对齐值)发射;
        如果 (数组元素码 ?= "S") { "字符串" = 表达式类型; }
        否则如果 (数组元素码 ?= "F") { "浮点" = 表达式类型; }
        否则 { "整数" = 表达式类型; }
    } 否则如果 (基类型 ?= "映射") {
        // 内存安全 §4.2：映射取值前对映射句柄做空检查。
        // 注意反向赋值语义：`基地址 = 表达式C;` 才是「表达式C := 基地址」（恢复基址寄存器）。
        基地址 = 表达式C;
        ("映射取值")发射空检查;
        ()新寄存器 = 映射_键数组地址;
        ("  " + 映射_键数组地址 + " = 获取元素指针 %映射类型, 指针 " + 基地址 + ", 整数32 0, 整数32 0")发射;
        ()新寄存器 = 映射_值数组地址;
        ("  " + 映射_值数组地址 + " = 获取元素指针 %映射类型, 指针 " + 基地址 + ", 整数32 0, 整数32 1")发射;
        ()新寄存器 = 胖_解包临;
        ("  " + 胖_解包临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 保存下标 + ")")发射;
        ()新寄存器 = 胖_包装临;
        ("  " + 胖_包装临 + " = 调用 指针 (指针, 指针, 整数32, 指针) @映射获取(指针 " + 映射_键数组地址 + ", 指针 " + 映射_值数组地址 + ", 整数32 1024, 指针 " + 胖_解包临 + ")")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 指针 (指针) @" + ("胖字符串包装")转义标识符 + "(指针 " + 胖_包装临 + ")")发射;
        "字符串" = 表达式类型;
    } 否则如果 (基类型 ?= "动态数组" || 基类型 ?= "动态字符串数组") {
        // 内存安全 §4.3 A.2 / S4：动态数组（含 字符串[]/文字[]）下标按元素码分派。
        // 元素码由类型注解登记于 动态数组表；未登记时按变量类型码回退（D→I，E→S）。
        (当前数组名)查动态数组元素码 = 下标动态码;
        如果 (下标动态码 ?= "") {
            如果 (基类型 ?= "动态字符串数组") { "S" = 下标动态码; }
            否则 { "I" = 下标动态码; }
        }
        如果 (下标动态码 ?= "S") {
            ()新寄存器 = 胖_包装临;
            ("  " + 胖_包装临 + " = 调用 指针 (指针, 整数32) @动态字符串数组索引获取(指针 " + 基地址 + ", 整数32 " + 保存下标 + ")")发射;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 指针 (指针) @" + ("胖字符串包装")转义标识符 + "(指针 " + 胖_包装临 + ")")发射;
            "字符串" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 整数32 (指针, 整数32) @动态数组索引获取(指针 " + 基地址 + ", 整数32 " + 保存下标 + ")")发射;
            如果 (下标动态码 ?= "R") { "文字" = 表达式类型; }
            否则 { "整数" = 表达式类型; }
        }
    } 否则如果 (基类型 ?= "切片") {
        // 内存安全 §4.2/§4.3：切片下标读改走运行时长度检查入口（越界即中止）。
        (当前切片名)查切片元素码 = 切片元素码;
        如果 (切片元素码 ?= "S") {
            ()新寄存器 = 胖_包装临;
            ("  " + 胖_包装临 + " = 调用 指针 (指针, 整数32) @切片取指针(指针 " + 基地址 + ", 整数32 " + 保存下标 + ")")发射;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 指针 (指针) @" + ("胖字符串包装")转义标识符 + "(指针 " + 胖_包装临 + ")")发射;
            "字符串" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 整数32 (指针, 整数32) @切片取整数(指针 " + 基地址 + ", 整数32 " + 保存下标 + ")")发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (基类型 ?= "字符串") {
        // 内存安全 §4.3 A.9：标量字符串下标 `文本[i]` → 运行时带界检查码点入口（产出 文字）。
        // 自举链字符串为胖串（字符串对象*），越界即中止（`运行时越界: 字符串下标 索引 i 超出 [0, n)`）。
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 调用 整数32 (指针, 整数32) @" + ("胖字符串字符码检查")转义标识符 + "(指针 " + 基地址 + ", 整数32 " + 保存下标 + ")")发射;
        "文字" = 表达式类型;
    } 否则如果 (基类型 ?= "变长数组") {
        // 阶段4F：变长形参下标读 —— 元素类型按形参声明登记（默认 整数 → 整数32）。
        (变长数组表, 当前数组名)查表值 = 变长取元素名;
        如果 (变长取元素名 ?= "") { "整数" = 变长取元素名; }
        (变长取元素名)类型名到IR = 变长取元素IR;
        "" = 变长取对齐;
        如果 (变长取元素IR ?= "整数8") { "1" = 变长取对齐; }
        否则如果 (变长取元素IR ?= "整数16") { "2" = 变长取对齐; }
        否则如果 (变长取元素IR ?= "整数32") { "4" = 变长取对齐; }
        否则 { "8" = 变长取对齐; }
        ()新寄存器 = 变长元素地址;
        ("  " + 变长元素地址 + " = 获取元素指针 " + 变长取元素IR + ", 指针 " + 基地址 + ", 整数32 " + 保存下标)发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 " + 变长取元素IR + ", 指针 " + 变长元素地址 + ", 对齐 " + 变长取对齐)发射;
        如果 (变长取元素IR ?= "指针") { "字符串" = 表达式类型; }
        否则如果 (变长取元素IR ?= "双精度" || 变长取元素IR ?= "单精度") { "浮点" = 表达式类型; }
        否则 { "整数" = 表达式类型; }
    } 否则 {
    }
}

// 分片访问 arr[起:止] / arr[起:] / arr[:止] / arr[:] → 胖切片 {数据, 长度}（内存安全 §4.2/§4.3）。
// 入口：表达式C = 源基地址；表达式类型 = 源类型（数组/动态数组/动态字符串数组）。
// 节点 文本 = "起省"（起省略）/ "起在"（起存在）；节点 子 = 分片起/止表达式（按需）。
// 出口：表达式C = 切片指针；表达式类型 = "切片"；表达式IR = "指针"；分片元素码 = 元素码。
函数 (节点:整数)发射分片访问 {
    表达式类型 = 分片源类型;
    表达式C = 分片基地址;
    // 内存安全 §八 O3：捕获源数组名（反式赋值：`当前数组名 = 分片源名;` 即 分片源名 := 当前数组名）。
    当前数组名 = 分片源名;
    (节点)取文本 = 分片标记;
    (节点)取子数 = 分片子数;
    0 = 分片本地;
    0 = 分片动态;
    如果 (分片源类型 ?= "切片") {
        ("错误: 暂不支持对切片再分片")输出错误;
        1 = 未声明出错;
        "0" = 表达式C;
        "整数" = 表达式类型;
    } 否则 {
        如果 (链式数组标志 ?= 1) {
            0 = 链式数组标志;
            数组大小文本 = 分片源大小;
            数组元素码 = 分片源元素码;
            链式数组基址 = 分片基地址;
        } 否则如果 (分片源类型 ?= "数组") {
            1 = 分片本地;
            (分片源名)查数组大小 = 分片源大小;
            (分片源名)查数组元素码 = 分片源元素码;
        } 否则 {
            1 = 分片动态;
            (分片源名)查数组大小 = 分片源大小;
            // 动态数组元素码取自 动态数组表；未登记时按源类型回退（动态字符串数组→S，其余→I），
            // 与 发射下标访问 的分派一致（决定分片数据指针的元素步长与运行时助手）。
            (分片源名)查动态数组元素码 = 分片源元素码;
            如果 (分片源元素码 ?= "") {
                如果 (分片源类型 ?= "动态字符串数组") { "S" = 分片源元素码; }
                否则 { "I" = 分片源元素码; }
            }
        }
        (分片源元素码)数组元素转IR = 分片元素IR;
        "" = 分片起值;
        "" = 分片止值;
        如果 (分片标记 ?= "起省") {
            "0" = 分片起值;
            如果 (分片子数 >= 1) {
                (节点, 0)取子 = 分片止节点;
                (分片止节点)发射表达式;
                表达式C = 分片止值;
            } 否则 {
                如果 (分片动态 ?= 1) { "4294967295" = 分片止值; } 否则 { 分片源大小 = 分片止值; }
            }
        } 否则 {
            (节点, 0)取子 = 分片起节点;
            (分片起节点)发射表达式;
            表达式C = 分片起值;
            如果 (分片子数 >= 2) {
                (节点, 1)取子 = 分片止节点2;
                (分片止节点2)发射表达式;
                表达式C = 分片止值;
            } 否则 {
                如果 (分片动态 ?= 1) { "4294967295" = 分片止值; } 否则 { 分片源大小 = 分片止值; }
            }
        }
        // 内存安全 §S1：动态数组分片交给运行时助手（长度/基址取自运行期胖指针；止 4294967295 = 到末尾）。
        // 注意：基表达式求值（发射变量）已把动态数组句柄加载进 分片基地址，此处直接传句柄，勿再加载。
        如果 (分片动态 ?= 1) {
            如果 (分片源元素码 ?= "S") { "动态字符串数组分片" = 分片函数名; } 否则 { "动态数组分片" = 分片函数名; }
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 指针 (指针, 整数32, 整数32) @" + 分片函数名 + "(指针 " + 分片基地址 + ", 整数32 " + 分片起值 + ", 整数32 " + 分片止值 + ")")发射;
        } 否则 {
            // 边界：起 ∈ [0, 长度)（>= 长度 即中止）；止 ∈ [0, 长度]（> 长度 才中止）
            ()新寄存器 = 下标扩展;
            ("  " + 下标扩展 + " = 零扩展 整数32 " + 分片起值 + " 到 整数64")发射;
            下标扩展 = 分片起扩展;
            分片起值 = 保存下标;
            (分片源大小)发射越界检查;
            ()新寄存器 = 下标扩展;
            ("  " + 下标扩展 + " = 零扩展 整数32 " + 分片止值 + " 到 整数64")发射;
            分片止值 = 保存下标;
            (分片源大小)发射越界检查大于;
            // 数据指针：本地定长数组 → [N 个 T] GEP；链式 → 元素 GEP
            ()新寄存器 = 分片数据;
            如果 (分片本地 ?= 1) {
                ("  " + 分片数据 + " = 获取元素指针 [" + 分片源大小 + " 个 " + 分片元素IR + "], 指针 " + 分片基地址 + ", 整数64 0, 整数64 " + 分片起扩展)发射;
            } 否则 {
                ("  " + 分片数据 + " = 获取元素指针 " + 分片元素IR + ", 指针 " + 分片基地址 + ", 整数32 " + 分片起值)发射;
            }
            ()新寄存器 = 分片长度;
            ("  " + 分片长度 + " = 减 整数32 " + 分片止值 + ", " + 分片起值)发射;
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 指针 (指针, 整数32) @切片创建(指针 " + 分片数据 + ", 整数32 " + 分片长度 + ")")发射;
        }
        "切片" = 表达式类型;
        "指针" = 表达式IR;
        分片源元素码 = 分片元素码;
        // 内存安全 §八 O3：求值分片起/止边界会经 发射表达式 清空「最近分片源名」，故在此发布源名，
        // 供 发射值存储（新建切片局部）登记借用源。反式赋值：`分片源名 = 当前分片源名;` 即 当前分片源名 := 分片源名。
        分片源名 = 当前分片源名;
    }
}

函数 (节点:整数)发射元组访问 {
    表达式C = 基地址;
    (节点, 0)取子 = 索引叶;
    (索引叶)取文本 = 元组_值;
    // 阶段4C5：优先按「当前元组类型体:索引」查元素表，支持链式嵌套元组（如 t.1 .0，逐级切到内层类型体）；
    // 未命中（多返回值元组仅登记了「变量名:索引」）时回退旧成员表。
    "" = 元组_访问键;
    元组_类型体 + ":" = 元组_访问键;
    元组_访问键 + 元组_值 = 元组_访问键;
    (元组_元素表, 元组_访问键)查表值 = 元组_元素IR;
    如果 (元组_元素IR ?= "") {
        (元组_基名 + ":" + 元组_值)查元组成员 = 元组_元素IR;
    }
    ()新寄存器 = 元素指针;
    ("  " + 元素指针 + " = 获取元素指针 {" + 元组_类型体 + "}, 指针 " + 基地址 + ", 整数32 0, 整数32 " + 元组_值)发射;
    // 阶段4C5：该元素若是嵌套元组（子元组表命中），本次取地址并切到内层类型体，供后续后缀继续索引；
    // 否则按元素 IR 加载为普通值。
    "" = 元组_访问子体;
    (元组_子元组表, 元组_访问键)查表值 = 元组_访问子体;
    如果 (元组_访问子体 ?= "") {
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 " + 元组_元素IR + ", 指针 " + 元素指针 + ", 对齐 8")发射;
        如果 (元组_元素IR ?= "整数32") { "整数" = 表达式类型; }
        否则如果 (元组_元素IR ?= "双精度") { "浮点" = 表达式类型; }
        否则 { "字符串" = 表达式类型; }
    } 否则 {
        // 嵌套元组元素以「指针」存储：先加载取出内层元组地址，供后续后缀继续索引。
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 加载 指针, 指针 " + 元素指针 + ", 对齐 8")发射;
        元组_访问子体 = 元组_类型体;
        "元组" = 表达式类型;
    }
}

// 结构体实例字面量： 类型名 { 成员: 值, ... }（类型名来自后缀链左节点文本）
函数 (类型名:字符串, 节点:整数)发射结构体实例 {
    类型名 = 当前结构体名;
    // 本次调用的 当前结构体名/结构体成员名 保存槽必须为**函数局部**：
    // 嵌套结构体字面量 `外层 { 内层: 内点 { ... } }` 会递归进入本函数，
    // 若用全局保存槽，内层递归会覆盖外层的保存值，外层恢复后 当前结构体名 错为内层类型。
    "" = 实例保存名;
    "" = 实例保存成员名;
    (当前结构体名)查结构体大小 = 结构体大小文本;
    ()新寄存器 = 实例寄存器;
    ("  " + 实例寄存器 + " = 分配 %" + 当前结构体名 + ", 对齐 8")发射;
    (节点)取子数 = 成员数;
    0 = 成员i;
    当 (成员i < 成员数) {
        (节点, 成员i)取子 = 成员;
        (成员, 0)取子 = 名字叶;
        (名字叶)取文本 = 结构体成员名;
        (成员, 1)取子 = 值节点;
        // 内存安全 §八 O2：拥有型句柄写入结构体字面量字段 → 可能被外部持有，判逃逸。
        (值节点)取种类 = 字面字段种;
        如果 (字面字段种 ?= "变量" || 字面字段种 ?= "标识符") {
            (值节点)取文本 = 字面字段名;
            (逃逸表, 字面字段名, "1")表添加 = 逃逸表;
        }
        当前结构体名 = 实例保存名;
        结构体成员名 = 实例保存成员名;
        (值节点)发射表达式;
        表达式C = 结构体成员值;
        实例保存名 = 当前结构体名;
        实例保存成员名 = 结构体成员名;
        如果 (表达式类型 ?= "数组") {
            当前结构体名 + ":" = 链式地址;
            链式地址 + 结构体成员名 = 链式地址;
            数组元素码 + ":" = 保存存储值;
            保存存储值 + 数组大小文本 = 保存存储值;
            (结构体_数组表, 链式地址, 保存存储值)表添加 = 结构体_数组表;
        }
        (当前结构体名, 结构体成员名)查结构体成员索引 = 结构体成员索引;
        (当前结构体名, 结构体成员名)查结构体成员类型 = 结构体成员类型;
        ()新寄存器 = 成员指针;
        ("  " + 成员指针 + " = 获取元素指针 %" + 当前结构体名 + ", 指针 " + 实例寄存器 + ", 整数32 0, 整数32 " + 结构体成员索引)发射;
        (结构体成员类型)结构体成员类型转IR = 结构体成员IR;
        ("  存储 " + 结构体成员IR + " " + 结构体成员值 + ", 指针 " + 成员指针 + ", 对齐 8")发射;
        成员i + 1 = 成员i;
    }
    实例寄存器 = 表达式C;
    "结构体" = 表达式类型;
    "" = 当前数组名;
}

// 数组字面量：子 = 各元素表达式（同类型）
函数 (节点:整数)发射数组字面 {
    (节点)取子数 = 数组元素计数;
    "" = 数组元素码;
    ()新建文本表 = 数组元素表;
    0 = 数组元素码整;
    0 = 数组写入索引;
    当 (数组写入索引 < 数组元素计数) {
        (节点, 数组写入索引)取子 = 甲;
        (甲)发射表达式;
        0 = 数组类型码;
        如果 (表达式类型 ?= "整数") { 1 = 数组类型码; }
        如果 (表达式类型 ?= "字符串") { 2 = 数组类型码; }
        如果 (表达式类型 ?= "浮点") { 3 = 数组类型码; }
        如果 (数组元素码整 ?= 0) { 数组类型码 = 数组元素码整; }
        (数组写入索引)转字符串 = 保存存储值;
        (数组元素表, 保存存储值, 表达式C)表添加 = 数组元素表;
        数组写入索引 + 1 = 数组写入索引;
    }
    如果 (数组元素码整 ?= 2) { "S" = 数组元素码; }
    如果 (数组元素码整 ?= 3) { "F" = 数组元素码; }
    如果 (数组元素码整 ?= 1) { "I" = 数组元素码; }
    如果 (数组元素码整 ?= 0) { "I" = 数组元素码; }
    (数组元素计数)转字符串 = 数组大小文本;
    (数组元素码)数组元素转IR = 数组元素IR;
    (数组元素码)数组对齐 = 数组对齐值;
    ()新寄存器 = 数组分配名;
    ("  " + 数组分配名 + " = 分配 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 对齐 " + 数组对齐值)发射;
    0 = 数组写入索引;
    当 (数组写入索引 < 数组元素计数) {
        (数组写入索引)转字符串 = 保存存储值;
        (数组元素表, 保存存储值)查表值 = 数组元素值;
        ()新寄存器 = 元素指针;
        ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 指针 " + 数组分配名 + ", 整数64 0, 整数64 " + (数组写入索引)转字符串)发射;
        ("  存储 " + 数组元素IR + " " + 数组元素值 + ", 指针 " + 元素指针 + ", 对齐 " + 数组对齐值)发射;
        数组写入索引 + 1 = 数组写入索引;
    }
    数组分配名 = 表达式C;
    "数组" = 表达式类型;
}

// 映射字面量：子交替为 字串键(叶) / 值表达式
函数 (节点:整数)发射映射字面 {
    (节点)取子数 = 映射_n;
    映射_计数 + 1 = 映射_计数;
    "@.映射" + (映射_计数)转字符串 = 映射_全局名;
    映射_全局名 + " = 内部 全局 %映射类型 零初始化" = 映射_行;
    如果 (映射_全局表 ?= "") { 映射_行 = 映射_全局表; }
    否则 { 映射_全局表 + "\n" = 映射_全局表; 映射_全局表 + 映射_行 = 映射_全局表; }
    ()新寄存器 = 映射_大小分配;
    ("  " + 映射_大小分配 + " = 分配 整数32, 对齐 4")发射;
    ("  存储 整数32 0, 指针 " + 映射_大小分配 + ", 对齐 4")发射;
    ()新寄存器 = 映射_键数组地址;
    ("  " + 映射_键数组地址 + " = 获取元素指针 %映射类型, 指针 " + 映射_全局名 + ", 整数32 0, 整数32 0")发射;
    ()新寄存器 = 映射_值数组地址;
    ("  " + 映射_值数组地址 + " = 获取元素指针 %映射类型, 指针 " + 映射_全局名 + ", 整数32 0, 整数32 1")发射;
    0 = 映射_i;
    当 (映射_i < 映射_n) {
        (节点, 映射_i)取子 = 键叶;
        (键叶)取文本 = 映射_键文本;
        (映射_键文本)解码字面 = 映射_键明文;
        (映射_键明文)存字符串常量 = 映射_键;
        映射_i + 1 = 映射_i;
        (节点, 映射_i)取子 = 值节点;
        (值节点)发射表达式;
        如果 (表达式类型 ?= "字符串") {
            ()新寄存器 = 胖_解包临;
            ("  " + 胖_解包临 + " = 调用 指针 (指针) @" + ("胖字符串数据")转义标识符 + "(指针 " + 表达式C + ")")发射;
            胖_解包临 = 映射_值;
        }
        否则 {
            ()新寄存器 = 映射_值;
            ("  " + 映射_值 + " = 调用 指针 (整数32) @" + ("辅助转字符串")转义标识符 + "(整数32 " + 表达式C + ")")发射;
        }
        ()新寄存器 = 映射_大小值;
        ("  " + 映射_大小值 + " = 加载 整数32, 指针 " + 映射_大小分配 + ", 对齐 4")发射;
        ()新寄存器 = 映射_新大小;
        ("  " + 映射_新大小 + " = 调用 整数32 (指针, 指针, 整数32, 指针, 指针) @映射设置(指针 " + 映射_键数组地址 + ", 指针 " + 映射_值数组地址 + ", 整数32 " + 映射_大小值 + ", 指针 " + 映射_键 + ", 指针 " + 映射_值 + ")")发射;
        ("  存储 整数32 " + 映射_新大小 + ", 指针 " + 映射_大小分配 + ", 对齐 4")发射;
        映射_i + 1 = 映射_i;
    }
    映射_全局名 = 表达式C;
    "映射" = 表达式类型;
}

// 条件表达式：条 ? 真枝 : 假枝
// 用「临时槽 + 分支 + 存储/加载」实现（避免 PHI 与跨块值传递）。
// 先捕获真枝文本与类型，据其 IR 类型分配槽位；两支分别存储后于合并块加载。
函数 (节点:整数)发射条件表达式 {
    (节点, 0)取子 = 条件节点;
    (节点, 1)取子 = 真枝节点;
    (节点, 2)取子 = 假枝节点;

    (条件节点)发射表达式;
    ()发射条件;
    当前条件 = 条件布尔;

    生成代码 = 保存真前;
    函数体C = 保存真前体;
    ()新建文本缓冲 = 生成代码;
    ()新建文本缓冲 = 函数体C;
    (真枝节点)发射表达式;
    生成代码 = 真段;
    函数体C = 真段体;
    表达式C = 真值;
    表达式类型 = 真类型;
    表达式IR = 真IR;
    保存真前 = 生成代码;
    保存真前体 = 函数体C;

    8 = 槽对齐;
    如果 (真IR ?= "整数8") { 1 = 槽对齐; }
    否则如果 (真IR ?= "整数16") { 2 = 槽对齐; }
    否则如果 (真IR ?= "整数32") { 4 = 槽对齐; }
    否则如果 (真IR ?= "单精度") { 4 = 槽对齐; }
    (槽对齐)转字符串 = 槽对齐文本;
    ()新寄存器 = 槽;
    ("  " + 槽 + " = 分配 " + 真IR + ", 对齐 " + 槽对齐文本)发射;
    ()新标签 = 真标签;
    ()新标签 = 假标签;
    ()新标签 = 合并标签;
    ("分支 整数1 " + 条件布尔 + ", 标签 %" + 真标签 + ", 标签 %" + 假标签)发射终结;
    (真标签)发射标签;
    (真段)发射缓冲;
    (真段体)发射缓冲;
    ("  存储 " + 真IR + " " + 真值 + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    ("分支 标签 %" + 合并标签)发射终结;
    (假标签)发射标签;
    (假枝节点)发射表达式;
    ("  存储 " + 真IR + " " + 表达式C + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    ("分支 标签 %" + 合并标签)发射终结;
    (合并标签)发射标签;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 加载 " + 真IR + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    真类型 = 表达式类型;
    真IR = 表达式IR;
}

// ============================================
// 语句发射 (S4.4b)
// ============================================

函数 (节点:整数)发射语句 {
    (节点)取种类 = 种;
    // 调试（S-C）：语句级 !位置（无行号则回退函数行），供本语句指令挂 !dbg
    如果 (调试模式 ?= 1 && 当前子程序 > 0) {
        (节点)取行 = 语句行;
        如果 (语句行 <= 0) { 当前函数行 = 语句行; }
        (语句行, 当前子程序)取位置号 = 当前调试位置;
    }
    如果 (种 ?= "代码块") { (节点)发射代码块; }
    否则如果 (种 ?= "表达式语句") {
        (节点, 0)取子 = 子;
        (子)发射表达式;
    }
    否则如果 (种 ?= "赋值") { (节点)发射赋值; }
    否则如果 (种 ?= "返回") { }
    否则如果 (种 ?= "中断") {
        ()查退出栈 = 中断标签;
        ("分支 标签 %" + 中断标签)发射终结;
    }
    否则如果 (种 ?= "继续") {
        ()查继续栈 = 继续标签2;
        ("分支 标签 %" + 继续标签2)发射终结;
    }
    否则如果 (种 ?= "如果") { (节点)发射如果; }
    否则如果 (种 ?= "当") { (节点)发射当; }
    否则如果 (种 ?= "循环") { (节点)发射循环; }
    否则如果 (种 ?= "遍历") { (节点)发射遍历; }
    否则如果 (种 ?= "匹配") { (节点)发射匹配; }
    否则如果 (种 ?= "让出") { (节点)发射让出语句; }
    否则 { }
}

函数 (节点:整数)发射代码块 {
    // 内存安全 §八 O2：块深度 +1（函数体顶层 = 1；嵌套块递增），供 发射值存储 只在函数体顶层登记待释放。
    当前块深度 + 1 = 当前块深度;
    (节点)取子数 = 块数;
    0 = 块i;
    当 (块i < 块数) {
        // 当前块已被终结指令（返回/中断/继续）终结时，其后的语句不可达，
        // 不再发射，避免终结指令后出现非法 IR（同一基本块出现多条终止/后续指令）。
        如果 (已终结 ?= 0) {
            (节点, 块i)取子 = 语句;
            (语句)发射语句;
            // 内存安全 §八 O3-2c2：本语句发射完毕 → 解除「末次使用点 == 本语句」或「无登记」的视图借用（精确 NLL）。
            (语句)按末次使用解借;
        }
        块i + 1 = 块i;
    }
    // 内存安全 §八 O2b：本块退出前，释放本块（深度 == 当前块深度）新建的待释放动态数组。
    // 块被终结（已终结 != 0）时无法发射 → 仅移除登记项（保守泄漏，避免对未初始化句柄释放）。
    // 倒序遍历 + 边遍历边删（文本表删 左移序键，只影响更高位）安全。
    (待释放表)文本表键数 = 块释放总数;
    (块释放总数 - 1) = 块释放i;
    当 (块释放i >= 0) {
        (待释放表, 块释放i)文本表键 = 块释放名;
        (待释放深度表, 块释放名)文本表取 = 块释放深度文本;
        (块释放深度文本)转整数 = 块释放深度;
        如果 (块释放深度 ?= 当前块深度) {
            如果 (已终结 ?= 0) {
                (已移动表, 块释放名)文本表含 = 块释放已移;
                (逃逸表, 块释放名)文本表含 = 块释放逃逸;
                如果 (块释放已移 ?= 0 && 块释放逃逸 ?= 0) {
                    (待释放表, 块释放名)文本表取 = 块释放码;
                    (块释放名)转义标识符 = 块释放转义;
                    ()新寄存器 = 块释放句柄;
                    ("  " + 块释放句柄 + " = 加载 指针, 指针 %" + 块释放转义 + ", 对齐 8")发射;
                    如果 (块释放码 ?= "E") {
                        ("调用 空类型 (指针) @释放动态字符串数组(指针 " + 块释放句柄 + ")")发射;
                    } 否则 {
                        ("调用 空类型 (指针) @释放动态数组(指针 " + 块释放句柄 + ")")发射;
                    }
                }
            }
            (待释放表, 块释放名)文本表删;
            (待释放深度表, 块释放名)文本表删;
        }
        块释放i - 1 = 块释放i;
    }
    // 内存安全 §八 O3：本块退出前，解除本块（深度 == 当前块深度）登记的只读借用（按视图名两表）。
    // 倒序遍历 + 边遍历边删（文本表删 左移序键，只影响更高位）安全。
    (借用视图深度表)文本表键数 = 解借总数;
    (解借总数 - 1) = 解借i;
    当 (解借i >= 0) {
        (借用视图深度表, 解借i)文本表键 = 解借视图;
        (借用视图深度表, 解借视图)文本表取 = 解借深度文本;
        (解借深度文本)转整数 = 解借深度;
        如果 (解借深度 ?= 当前块深度) {
            (借用视图深度表, 解借视图)文本表删;
            (借用视图源表, 解借视图)文本表删;
            (借用视图可变表, 解借视图)文本表删;
        }
        解借i - 1 = 解借i;
    }
    当前块深度 - 1 = 当前块深度;
}

// 返回语句已改为函数体内的返回值声明，由 `扫描返回声明` 并入输出参数；
// 发射阶段不再产生 `返回` 指令（函数末尾统一按输出参数返回）。

// ────────────────────────────────────────────
// 协程（纤程）发射 (8AI)：让出 / 创建 / 纤程入口
// ────────────────────────────────────────────

// IR 类型 → 自然对齐字节数（帧槽对齐用）。
函数 (IR类型:字符串)IR对齐(0 = 结果:整数) {
    4 = 结果;
    如果 (IR类型 ?= "指针" || IR类型 ?= "整数64" || IR类型 ?= "双精度") { 8 = 结果; }
    否则如果 (IR类型 ?= "整数16") { 2 = 结果; }
    否则如果 (IR类型 ?= "整数8") { 1 = 结果; }
    否则 { 4 = 结果; }
}

// 让出值归一：把「值文本（IR 类型 值IR）」转为语言层「整数」(整型32) 文本（供 @协程让出）。
// 指针→指针转整数；浮点→浮点转有符号；窄/宽整型→扩展/截断。
函数 (值文本:字符串, 值IR:字符串)让出值到整数32(0 = 结果:字符串) {
    如果 (值IR ?= "指针") {
        ()新寄存器 = 结果;
        ("  " + 结果 + " = 指针转整数 指针 " + 值文本 + " 到 整数32")发射;
    } 否则如果 (值IR ?= "双精度") {
        ()新寄存器 = 结果;
        ("  " + 结果 + " = 浮点转有符号 双精度 " + 值文本 + " 到 整数32")发射;
    } 否则如果 (值IR ?= "单精度") {
        ()新寄存器 = 结果;
        ("  " + 结果 + " = 浮点转有符号 单精度 " + 值文本 + " 到 整数32")发射;
    } 否则如果 (值IR ?= "整数64") {
        ()新寄存器 = 结果;
        ("  " + 结果 + " = 截断 整数64 " + 值文本 + " 到 整数32")发射;
    } 否则如果 (值IR ?= "整数8") {
        ()新寄存器 = 结果;
        ("  " + 结果 + " = 符号扩展 整数8 " + 值文本 + " 到 整数32")发射;
    } 否则如果 (值IR ?= "整数16") {
        ()新寄存器 = 结果;
        ("  " + 结果 + " = 符号扩展 整数16 " + 值文本 + " 到 整数32")发射;
    } 否则 { 值文本 = 结果; }
}

// 让出语句（前缀 `让出 值;`）：调用 @协程让出(整数32 值)，由纤程切换到恢复者后**原地继续**（不终结基本块）。
函数 (节点:整数)发射让出语句 {
    (节点, 1)取子 = 让出值节点;
    (让出值节点)发射表达式;
    (表达式C, 表达式IR)让出值到整数32 = 让出文本;
    ("调用 空类型 (整数32) @协程让出(整数32 " + 让出文本 + ")")发射;
}

// 帧槽存储：把 "IR类型 值" 段写入协程帧（第 槽序号 槽 × 8 字节偏移）。
函数 (槽文本:字符串, 帧寄存器:字符串, 槽序号:整数)发射协程槽存 {
    (槽文本)长度 = 槽总长;
    "" = 槽IR;
    "" = 槽值;
    0 = 槽切;
    0 = 槽位;
    当 (槽位 < 槽总长) {
        (槽文本, 槽位, 1)子串 = 槽字;
        如果 (槽切 ?= 0 && 槽字 ?= " ") { 1 = 槽切; }
        否则如果 (槽切 ?= 1) { 槽值 + 槽字 = 槽值; }
        否则 { 槽IR + 槽字 = 槽IR; }
        槽位 + 1 = 槽位;
    }
    (槽IR)IR对齐 = 槽对齐;
    槽序号 * 8 = 槽偏移;
    ()新寄存器 = 槽指针;
    ("  " + 槽指针 + " = 获取元素指针 整数8, 指针 " + 帧寄存器 + ", 整数64 " + (槽偏移)转字符串)发射;
    ("  存储 " + 槽IR + " " + 槽值 + ", 指针 " + 槽指针 + ", 对齐 " + (槽对齐)转字符串)发射;
}

// 协程创建（调用点）：分配帧 → 逐槽存入实参 → @创建协程对象(入口, 帧) → 句柄（指针）。
// 创建不执行；首次「恢复」才进入协程体直至「让出」。
函数 发射协程创建 {
    参数计数 * 8 = 协程帧字节;
    如果 (协程帧字节 <= 0) { 8 = 协程帧字节; }
    ()新寄存器 = 协程帧;
    ("  " + 协程帧 + " = 调用 指针 (整数64) @malloc(整数64 " + (协程帧字节)转字符串 + ")")发射;
    (参数前缀文本)长度 = 前缀总长;
    0 = 前缀位;
    0 = 段序;
    1 = 段首;
    "" = 当前段;
    当 (前缀位 < 前缀总长) {
        (参数前缀文本, 前缀位, 1)子串 = 前缀字;
        如果 (前缀字 ?= ",") {
            如果 (当前段 != "") { (当前段, 协程帧, 段序)发射协程槽存; 段序 + 1 = 段序; }
            "" = 当前段;
            1 = 段首;
        } 否则如果 (段首 ?= 1 && 前缀字 ?= " ") { }
        否则 { 当前段 + 前缀字 = 当前段; 0 = 段首; }
        前缀位 + 1 = 前缀位;
    }
    如果 (当前段 != "") { (当前段, 协程帧, 段序)发射协程槽存; }
    (函数名)转义标识符 = 协程本体转义;
    ()新寄存器 = 协程句柄;
