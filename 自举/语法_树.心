            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 调用 {" + 多返回体 + "} (" + 闭包全参数类型 + ") @" + 闭包函数名 + "(" + 参数前缀文本 + 闭包捕获参数 + ")")发射;
