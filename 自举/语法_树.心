            否则如果 (提取类型码 ?= "J") { ("%" + 局部转义 + " = 分配 整数64, 对齐 8")发射; }
            否则如果 (提取类型码 ?= "G") { ("%" + 局部转义 + " = 分配 单精度, 对齐 4")发射; }
            否则如果 (提取类型码 ?= "A") {
                (局部名)查数组大小 = 数组大小文本;
                (局部名)查数组元素码 = 数组元素码;
                (数组元素码)数组元素转IR = 数组元素IR;
