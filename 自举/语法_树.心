                } 否则 {
                    闭包全参数类型 + ", 指针" = 闭包全参数类型;
                    闭包捕获参数 + ", 指针 " = 闭包捕获参数;
                    闭包捕获参数 + 捕获地址 = 闭包捕获参数;
                }
            }
            索引 + 1 = 索引;
        }
        (函数多返回表, 闭包函数名)查表值 = 多返回体;
        如果 (多返回体 ?= "") {
        (函数名)查闭包返回 = 闭包返回值IR;
