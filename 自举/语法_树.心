    }
    否则如果 (求种 ?= "函数调用") {
        (节点)编译期求调用表达式 = 调成;
        如果 (调成 ?= 1) { 1 = 成; }
    }
}

// 表达式中的函数调用：仅当被调者是「编译期」函数且可解释时成功
