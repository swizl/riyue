// ============================================
// 日月编译器 — AST 发射层 (语法_树.心, S4.4)
// 遍历 自举/解析器.心 构造的扁平节点池 AST，发射 中文 LLVM IR。
// 与 自举/语法.心（token 递归下降版本）语义等价。
// 结果约定：全局 表达式C = 值寄存器/字面量，表达式类型 = 整数/浮点/字符串/函数/数组/结构体/...
// ============================================

导入 "语法树.心";
导入 "发射.心";

// 当前调用是否为「双精度数学内建」（需要把整数实参提升为 双精度）
0 = 变量 内建双精度;

// 发射一个表达式节点 -> 表达式C / 表达式类型
函数 (节点:整数)发射表达式 {
    "" = 表达式IR;
    // 内存安全 §八 O3：每个表达式的求值起点清空「最近分片源名」，仅 发射分片访问 会重新置名。
    "" = 当前分片源名;
    (节点)取种类 = 种;
    如果 (种 ?= "二元运算") { (节点)发射二元; }
    否则如果 (种 ?= "一元运算") { (节点)发射一元; }
    否则如果 (种 ?= "整数") { (节点)发射叶数字; }
    否则如果 (种 ?= "数字") { (节点)发射叶数字; }
    否则如果 (种 ?= "浮点数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "小数") { (节点)发射叶浮点; }
    否则如果 (种 ?= "字符串") { (节点)发射叶字符串; }
    否则如果 (种 ?= "字串") { (节点)发射叶字符串; }
    // 内存安全 §4.3 A.7：字符字面量 'x' → 单个 Unicode 码点（整数32，类型 `字符`）
    // 原子 规则包装为 种="字符"；字面量 规则透传 种="字符字面"，两者同样处理。
    否则如果 (种 ?= "字符" || 种 ?= "字符字面") { (节点)发射叶字符; }
    否则如果 (种 ?= "布尔值") { (节点)发射叶布尔; }
    否则如果 (种 ?= "变量") { (节点)发射变量; }
    否则如果 (种 ?= "标识符") { (节点)发射变量; }
    // 8AK：编译期常量函数——实参全为整数常量时折叠为整数常量，否则回落普通调用。
    否则如果 (种 ?= "函数调用") {
        如果 ((节点)编译期尝试折叠 ?= 1) {
            (编译期_结果)转字符串 = 表达式C;
            "整数" = 表达式类型;
        } 否则 {
            (节点)发射调用;
        }
    }
    否则如果 (种 ?= "后缀") { (节点)发射后缀; }
    // 阶段4C1：泛型结构体字面量 `名<实类型,...>{...}`（文法 泛型结构体原子 直接产出本种节点）。
    否则如果 (种 ?= "结构体实例") { (节点)取文本 = 类型名; (类型名, 节点)发射结构体实例; }
    否则如果 (种 ?= "条件表达式") { (节点)发射条件表达式; }
    否则如果 (种 ?= "元组") { (节点)发射元组; }
    否则如果 (种 ?= "数组字面") { (节点)发射数组字面; }
    否则如果 (种 ?= "映射字面") { (节点)发射映射字面; }
    否则如果 (种 ?= "匿名函数") { (节点)发射匿名函数; }
    否则如果 (种 ?= "立即执行") { (节点)发射立即执行; }
    否则 { (节点)发射表达式兜底; }
    如果 (表达式IR ?= "") { (表达式类型)类型转IR = 表达式IR; }
    否则如果 (表达式IR ?= "整数32") {
        如果 (表达式类型 ?= "浮点") { "双精度" = 表达式IR; }
        否则如果 (表达式类型 ?= "数组") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "映射") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "元组") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "结构体") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "字符串") { "指针" = 表达式IR; }
        否则如果 (表达式类型 ?= "函数") { "指针" = 表达式IR; }
    }
}

// 兜底（未实现的表达式种类，占位 0；S4.4 后续补齐）
函数 (节点:整数)发射表达式兜底 {
    "0" = 表达式C;
    "整数" = 表达式类型;
}

// 立即执行 `入(入参表){语句… 结果表达式}`：不产生函数对象，直接执行函数体。
// 子节点 = [实参…, 立即代码块]；裸标识符按名引入（按值复制），其余按绝对位置绑定 参数N。
函数 (节点:整数)发射立即执行 {
    (节点)取子数 = 立即子数;
    立即子数 - 1 = 立即块序;
    (节点, 立即块序)取子 = 立即块;
    0 = 立即i;
    当 (立即i < 立即块序) {
        (节点, 立即i)取子 = 立即参;
        (立即参)取种类 = 立即参种;
        "" = 立即参名;
        如果 (立即参种 ?= "变量" || 立即参种 ?= "标识符") {
            (立即参)取文本 = 立即参名;
        } 否则 {
            立即i + 1 = 立即序;
            (立即序)转字符串 = 立即序文本;
            "参数" + 立即序文本 = 立即参名;
        }
        "" = 声明目标类型;
        (立即参)发射表达式;
        (立即参名)发射值存储;
        立即i + 1 = 立即i;
    }
    (立即块)发射代码块;
    // 结果表达式：整块作为表达式取值；无结果表达式则取 0。
    "0" = 表达式C;
    "整数" = 表达式类型;
    "整数32" = 表达式IR;
    (立即块)取子数 = 立即块子数;
    如果 (立即块子数 > 0) {
        立即块子数 - 1 = 立即末序;
        (立即块, 立即末序)取子 = 立即末子;
        (立即末子)取种类 = 立即末种;
        如果 (立即末种 ?= "结果") {
            (立即末子, 0)取子 = 立即结果;
            (立即结果)发射表达式;
        }
    }
}

// ────────────────────────────────────────────
// 闭包 / 匿名函数（AST 版，语义等价 语法.心 解析闭包）
// 匿名函数 = 内部函数 + 捕获变量（按引用，隐藏 指针 形参）
// 节点两种形状：
//   ① 函数形式：子 = [参数表, 返回表?, 类型?, 代码块]
//   ② Lambda形式：子 = [输入形参*, 表达式]
// 结果：表达式C = "@<闭包名>"，表达式类型 = "函数"（函数指针）
// ────────────────────────────────────────────
函数 (节点:整数)发射匿名函数 {
    局部类型表 = 保存局部类型表;
    函数体C = 保存函数体C;
    输入参数表 = 保存输入参数表;
    输出参数表 = 保存输出参数表;
    已声明表 = 保存已声明表;
    // 内存安全 §八 O2：闭包体独立编译，暂存并清空外层「待释放 / 逃逸」集合（闭包内不自动释放 → 泄漏安全）。
    待释放表 = 保存待释放表;
    逃逸表 = 保存逃逸表;
    待释放深度表 = 保存待释放深度表;
    ()新建文本表 = 待释放表;
    ()新建文本表 = 逃逸表;
    ()新建文本表 = 待释放深度表;
    输入参数IR = 保存输入参数IR;
    返回类型名 = 保存返回类型名;
    输出参数名 = 保存输出参数名;
    // 内存安全 §八 O4a：闭包体独立编译，暂存并清空外层「视图结果」上下文（闭包不返回视图）。
    当前视图结果名 = 保存视图结果名;
    当前视图结果形参 = 保存视图结果形参;
    "" = 当前视图结果名;
    "" = 当前视图结果形参;
    原型名 = 保存原型名;
    已终结 = 保存已终结;
    缓冲模式 = 匿名_缓冲;
    // 调试（B2）：闭包不携带调试信息，暂存外层调试上下文并清零，防止闭包局部误挂外层 !子程序
    当前子程序 = 保存调试子程序;
    当前函数行 = 保存调试函数行;
    当前保留表号 = 保存调试保留表;
    当前函数局部号表 = 保存调试局部号;
    当前调试位置 = 保存调试位置;
    0 = 当前子程序;
    0 = 当前调试位置;

    // 形状探测：含「参数表」即函数形式；代码块 子节点即函数体
    0 = 匿名_有参表;
    0 = 匿名_体节点;
    (节点)取子数 = 匿名_子数;
    0 = 匿名_形状i;
    当 (匿名_形状i < 匿名_子数) {
        (节点, 匿名_形状i)取子 = 匿名_形状子;
        (匿名_形状子)取种类 = 匿名_形状种;
        如果 (匿名_形状种 ?= "参数表") { 1 = 匿名_有参表; }
        否则如果 (匿名_形状种 ?= "代码块") { 匿名_形状子 = 匿名_体节点; }
        匿名_形状i + 1 = 匿名_形状i;
    }
    0 = 匿名_是lambda;
    如果 (匿名_有参表 ?= 1) {
        (节点)解析函数签名节点;
    } 否则 {
        1 = 匿名_是lambda;
        ()新建文本表 = 局部类型表;
        ()新建文本表 = 已声明表;
        ()新建文本表 = 输入参数表;
        ()新建文本表 = 输出参数表;
        "" = 输入参数IR;
        "" = 返回类型名;
        "" = 输出参数名;
        "" = 原型名;
        ()新子列表 = 匿名_合成表;
        0 = 匿名_形状j;
        当 (匿名_形状j < 匿名_子数) {
            (节点, 匿名_形状j)取子 = 匿名_形状子2;
            (匿名_形状子2)取种类 = 匿名_形状种2;
            如果 (匿名_形状种2 ?= "输入形参") { (匿名_合成表, 匿名_形状子2)子列表添加; }
            否则如果 (匿名_形状种2 ?= "输出形参") { (匿名_合成表, 匿名_形状子2)子列表添加; }
            否则 { 匿名_形状子2 = 匿名_体节点; }
            匿名_形状j + 1 = 匿名_形状j;
        }
        ("参数表", "", 匿名_合成表)新节点 = 匿名_参表节点;
        (匿名_参表节点)解析输入参数表;
        "整数" = 返回类型名;
        "结果" = 输出参数名;
        (输出参数名, "I")局部表添加;
        (已声明表, 输出参数名, "X")表添加 = 已声明表;
        (输出参数表, 输出参数名, "I")表添加 = 输出参数表;
    }

    闭包计数 + 1 = 闭包计数;
    "闭包" + (闭包计数)转字符串 = 闭包名;
    (闭包名)转义标识符 = 闭包转义;
    "" = 闭包捕获参数;
    (匿名_体节点)闭包捕获扫描;

    0 = 已终结;
    1 = 缓冲模式;
    ()新建文本缓冲 = 函数体C;
    如果 (匿名_是lambda ?= 1) {
        (匿名_体节点, 输出参数名)发射变量写到;
    } 否则 {
        (匿名_体节点)发射代码块;
    }
    函数体C = 闭包体;

    如果 (返回类型名 ?= "") { "空类型" = 闭包返回IR; }
    否则 { (返回类型名)类型名到IR = 闭包返回IR; }
    // 多输出闭包：登记结构体返回类型与元素码（键为闭包内部名，供闭包调用/解构使用），
    // 返回类型改为结构体，函数尾部按 插入值 链构造后整体返回。
    "" = 闭包多返回体;
    "" = 闭包多返回元素;
    (输出参数表)文本表键数 = 闭包多返回行数;
    如果 (闭包多返回行数 > 1) {
        0 = 闭包登记i;
        当 (闭包登记i < 闭包多返回行数) {
            (输出参数表, 闭包登记i)文本表键 = 闭包登记键;
            (输出参数表, 闭包登记键)文本表取 = 闭包登记码;
            (闭包登记码)输出码转IR = 闭包登记IR;
            如果 (闭包登记i ?= 0) {
                闭包登记IR = 闭包多返回体;
                闭包登记码 = 闭包多返回元素;
            } 否则 {
                闭包多返回体 + ", " = 闭包多返回体;
                闭包多返回体 + 闭包登记IR = 闭包多返回体;
                闭包多返回元素 + "\n" = 闭包多返回元素;
                闭包多返回元素 + 闭包登记码 = 闭包多返回元素;
            }
            闭包登记i + 1 = 闭包登记i;
        }
        (函数多返回表, 闭包名, 闭包多返回体)表替换 = 函数多返回表;
        (函数多返回元素表, 闭包名, 闭包多返回元素)表替换 = 函数多返回元素表;
        "{" + 闭包多返回体 = 闭包返回IR;
        闭包返回IR + "}" = 闭包返回IR;
    }
    ()新建文本缓冲 = 函数体C;
    ("定义 内部 " + 闭包返回IR + " @" + 闭包转义 + "(" + 输入参数IR + 闭包捕获参数 + ") {")发射;
    ("入口:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    (函数体C, 闭包体)文本缓冲追加缓冲;
    如果 (已终结 ?= 1) { }
    否则如果 (闭包多返回体 ?= "") {
    如果 (返回类型名 ?= "") { ("  返回 空类型")发射; }
    否则 {
        (输出参数名)取地址 = 闭包返回地址;
        ()新寄存器 = 闭包返回加载;
        ("  " + 闭包返回加载 + " = 加载 " + 闭包返回IR + ", 指针 " + 闭包返回地址 + ", 对齐 4")发射;
        ("  返回 " + 闭包返回IR + " " + 闭包返回加载)发射;
    }
    } 否则 {
        // 多输出：逐输出加载并 插入值 链式构造结构体，最后整体返回
        "" = 闭包聚合;
        "" = 闭包前值;
        0 = 闭包聚合i;
        当 (闭包聚合i < 闭包多返回行数) {
            (输出参数表, 闭包聚合i)文本表键 = 闭包聚合名;
            (输出参数表, 闭包聚合名)文本表取 = 闭包聚合码;
            (闭包聚合码)输出码转IR = 闭包聚合单IR;
            (闭包聚合名)取地址 = 闭包聚合地址;
            ()新寄存器 = 闭包聚合加载;
            ("  " + 闭包聚合加载 + " = 加载 " + 闭包聚合单IR + ", 指针 " + 闭包聚合地址 + ", 对齐 4")发射;
            (闭包聚合i)转字符串 = 闭包聚合i文本;
            ()新寄存器 = 闭包聚合;
            如果 (闭包聚合i ?= 0) {
                ("  " + 闭包聚合 + " = 插入值 {" + 闭包多返回体 + "} 未定义, " + 闭包聚合单IR + " " + 闭包聚合加载 + ", 0")发射;
                闭包聚合 = 闭包前值;
            } 否则 {
                ("  " + 闭包聚合 + " = 插入值 {" + 闭包多返回体 + "} " + 闭包前值 + ", " + 闭包聚合单IR + " " + 闭包聚合加载 + ", " + 闭包聚合i文本)发射;
                闭包聚合 = 闭包前值;
            }
            闭包聚合i + 1 = 闭包聚合i;
        }
        ("  返回 {" + 闭包多返回体 + "} " + 闭包前值)发射;
    }
    ("}")发射;
    (函数体C)文本缓冲取整体 = 闭包体文本;
    闭包定义 + 闭包体文本 = 闭包定义;
    (闭包函数表, 闭包名, 闭包名)表添加 = 闭包函数表;
    (闭包返回表, 闭包名, 闭包返回IR)表添加 = 闭包返回表;

    匿名_缓冲 = 缓冲模式;
    保存局部类型表 = 局部类型表;
    保存函数体C = 函数体C;
    保存输入参数表 = 输入参数表;
    保存输出参数表 = 输出参数表;
    保存已声明表 = 已声明表;
    保存待释放表 = 待释放表;
    保存逃逸表 = 逃逸表;
    保存待释放深度表 = 待释放深度表;
    保存输入参数IR = 输入参数IR;
    保存返回类型名 = 返回类型名;
    保存输出参数名 = 输出参数名;
    保存视图结果名 = 当前视图结果名;
    保存视图结果形参 = 当前视图结果形参;
    保存原型名 = 原型名;
    保存已终结 = 已终结;
    // 调试（B2）：恢复外层调试上下文
    保存调试子程序 = 当前子程序;
    保存调试函数行 = 当前函数行;
    保存调试保留表 = 当前保留表号;
    保存调试局部号 = 当前函数局部号表;
    保存调试位置 = 当前调试位置;

    "@" + 闭包名 = 表达式C;
    "函数" = 表达式类型;
    "" = 表达式IR;
}

// 闭包捕获扫描：递归扫描闭包体 AST，把未在闭包内声明、却存在于外层局部类型表的
// 变量登记为捕获（按引用）。不进入嵌套匿名函数。
函数 (节点:整数)闭包捕获扫描 {
    (节点)取种类 = 扫种;
    如果 (扫种 ?= "变量") {
        (节点)取文本 = 扫名;
        (扫名)闭包登记捕获;
    } 否则如果 (扫种 ?= "目标") {
        (节点)取子数 = 扫目标数;
        如果 (扫目标数 ?= 1) {
            (节点, 0)取子 = 扫目标名叶;
            (扫目标名叶)取种类 = 扫目标名种;
            如果 (扫目标名种 ?= "标识符") {
                (扫目标名叶)取文本 = 扫目标名;
                (扫目标名)闭包登记捕获;
            }
        }
    } 否则如果 (扫种 ?= "匿名函数") {
    } 否则 {
        (节点)取子数 = 扫数;
        0 = 扫i;
        当 (扫i < 扫数) {
            (节点, 扫i)取子 = 扫子;
            (扫子)闭包捕获扫描;
            扫i + 1 = 扫i;
        }
    }
}

// 登记单个捕获：外层局部表存在该名（有类型码）且闭包内未声明时，按引用捕获
函数 (扫名:字符串)闭包登记捕获 {
    (已声明表, 扫名)在表 = 扫声明命中;
    如果 (扫声明命中 ?= 0) {
        (保存局部类型表, 扫名)查表值 = 扫捕获码;
