                    // 其原始实参可能含类型参数（解析期未知类型参数落码 X），须按当前替换表
                    // 逐个替换实参名后重建特化名（盒子_X → 盒子_I），并补登记新实例，使外层循环递归单态化。
                    (泛型结构体实例表, 泛型成员类型)文本表含 = 泛型成员是实例;
                    如果 (泛型成员是实例 ?= 1) {
                        (泛型结构体实例表, 泛型成员类型)文本表取 = 泛型成员实例值;
                        (泛型成员实例值)分割行数 = 泛型成员实例行数;
                        (泛型成员实例值, 0)获取行 = 泛型成员实例基名0;
                        (泛型成员实例基名0)长度 = 泛型成员实例基名0长;
                        (泛型成员实例基名0, 0, 泛型成员实例基名0长)子串 = 泛型成员新基名;
                        "" = 泛型成员新码串;
                        "" = 泛型成员新实参串;
                        1 = 泛型成员实例i;
                        当 (泛型成员实例i < 泛型成员实例行数) {
                            (泛型成员实例值, 泛型成员实例i)获取行 = 泛型成员实例实参0;
                            (泛型成员实例实参0)长度 = 泛型成员实例实参0长;
                            (泛型成员实例实参0, 0, 泛型成员实例实参0长)子串 = 泛型成员实例实参;
                            (泛型替换表, 泛型成员实例实参)文本表含 = 泛型成员实参有替换;
                            如果 (泛型成员实参有替换 ?= 1) {
                                (泛型替换表, 泛型成员实例实参)文本表取 = 泛型成员实例实参1;
                                (泛型成员实例实参1)长度 = 泛型成员实例实参1长;
                                (泛型成员实例实参1, 0, 泛型成员实例实参1长)子串 = 泛型成员实例实参;
                            }
                            (泛型成员实例实参)类型名到码 = 泛型成员实例实参码;
                            泛型成员新码串 + 泛型成员实例实参码 = 泛型成员新码串;
                            如果 (泛型成员新实参串 ?= "") { 泛型成员实例实参 = 泛型成员新实参串; }
                            否则 { 泛型成员新实参串 + "\n" + 泛型成员实例实参 = 泛型成员新实参串; }
                            泛型成员实例i + 1 = 泛型成员实例i;
                        }
                        泛型成员新基名 + "_" = 泛型成员实类型;
                        泛型成员实类型 + 泛型成员新码串 = 泛型成员实类型;
                        泛型成员新基名 + "\n" = 泛型成员新实例值;
                        泛型成员新实例值 + 泛型成员新实参串 = 泛型成员新实例值;
                        (泛型结构体实例表, 泛型成员实类型, 泛型成员新实例值)表添加 = 泛型结构体实例表;
                    }
                }
                ()新子列表 = 泛型成员项子;
                ("标识符", 泛型成员名)新叶 = 泛型成员名叶;
                (泛型成员项子, 泛型成员名叶)子列表添加;
                ("类型", 泛型成员实类型)新叶 = 泛型成员类叶;
                (泛型成员项子, 泛型成员类叶)子列表添加;
                ("成员", "", 泛型成员项子)新节点 = 泛型成员项;
                (泛型合成子表, 泛型成员项)子列表添加;
                泛型成员i + 1 = 泛型成员i;
            }
            ("结构体", "", 泛型合成子表)新节点 = 泛型合成结构体;
            (泛型合成结构体)收集结构体定义节点;
            // 阶段4C1 第二切片：泛型结构体方法特化 —— 以 特化名 为结构体名（决定自参类型与
            // 合成名 特化名_方法名）、模板基名为自参名（方法体内以 基名.成员 引用自身），
            // 类型参数经替换表替换后 收集函数原型节点 注册（用户函数表/参数类型表/返回表）；
            // 方法体入 泛型待发 表，由 发射泛型特化体 延迟发射（复用全部泛型函数机制）。
            (泛型结构体模板节点表, 泛型基名)文本表含 = 泛型有模板节点;
            如果 (泛型有模板节点 ?= 1) {
                (泛型结构体模板节点表, 泛型基名)文本表取 = 泛型模板节点串;
                (泛型模板节点串)转整数 = 泛型模板节点;
                泛型特化名 = 当前结构体名;
                泛型基名 = 自参名覆盖;
                (泛型模板节点)取子数 = 泛型方法子数;
                1 = 泛型方法i;
                当 (泛型方法i < 泛型方法子数) {
                    (泛型模板节点, 泛型方法i)取子 = 泛型方法项;
                    (泛型方法项)取种类 = 泛型方法种;
                    如果 (泛型方法种 ?= "方法") {
                        (泛型方法项)合成方法函数节点 = 泛型方法函数节点;
                        泛型特化名 + "_" = 泛型方法合成名;
                        (泛型方法项, 0)取子 = 泛型方法名叶;
                        (泛型方法名叶)取文本 = 泛型方法名;
                        泛型方法合成名 + 泛型方法名 = 泛型方法合成名;
                        泛型方法合成名 = 当前函数名覆盖;
                        // 注册方法签名时启用替换：使返回类型中的类型参数（如 A）按实参解析为具体码，
                        // 登记进 函数返回表，供调用点取得正确返回类型。
                        泛型替换表 = 当前替换表;
                        1 = 当前替换开;
                        (泛型方法函数节点)收集函数原型节点;
                        (用户函数表, 原型名, "1")表添加 = 用户函数表;
                        "" = 当前函数名覆盖;
                        0 = 当前替换开;
                        (泛型方法函数节点)转字符串 = 泛型方法函数串;
                        (泛型节点表, 泛型方法合成名, 泛型方法函数串)表替换 = 泛型节点表;
                        (泛型待发数)转字符串 = 泛型待发键;
                        (泛型待发_泛型名, 泛型待发键, 泛型方法合成名)表替换 = 泛型待发_泛型名;
                        (泛型待发_特化名, 泛型待发键, 泛型方法合成名)表替换 = 泛型待发_特化名;
                        (泛型待发_替换名, 泛型待发键, 泛型替换名串)表替换 = 泛型待发_替换名;
                        (泛型待发_替换值, 泛型待发键, 泛型替换值串)表替换 = 泛型待发_替换值;
                        泛型待发数 + 1 = 泛型待发数;
                    }
                    泛型方法i + 1 = 泛型方法i;
                }
                "" = 自参名覆盖;
            }
        }
        泛型实例i + 1 = 泛型实例i;
        // 阶段4C2 前置③：嵌套泛型成员在上一轮可能补登记了新实例（盒子_I）。
        // 每轮重读键数，使新实例在本循环内递归单态化。
        (泛型结构体实例表)文本表键数 = 泛型实例数;
    }
}

// 将结构体「方法」合成为普通函数节点（与宿主 语法分析器 合成规则一致）：
//   名 = 结构体名_方法名；隐式首参 = 结构体名:结构体名
//   方法节点子 = [标识符(方法名), 参数表, 返回表?, 代码块]
//   返回 函数节点，子 = [参数表, 标识符(名), 返回表?, 代码块]
函数 (方法节点:整数)合成方法函数节点(0 = 结果:整数) {
    (方法节点, 0)取子 = 方法名叶;
    (方法名叶)取文本 = 方法名;
    当前结构体名 + "_" = 合成名;
    合成名 + 方法名 = 合成名;
    ()新子列表 = 合成参数列表;
    // 泛型方法特化：自参「名」用模板基名（方法体内以 基名.成员 引用自身），
    // 而「类型」与合成函数名用 当前结构体名（特化名）。
    当前结构体名 = 自参实际名;
    如果 (自参名覆盖 ?= "") { } 否则 { 自参名覆盖 = 自参实际名; }
    ("标识符", 自参实际名)新叶 = 自参名叶;
    ("类型", 当前结构体名)新叶 = 自参类型叶;
    ("输入形参", "", 自参名叶, 自参类型叶)双节点 = 自参形参;
    (合成参数列表, 自参形参)子列表添加;
    (方法节点)取子数 = 方法子数;
    0 = 方法j;
    当 (方法j < 方法子数) {
        (方法节点, 方法j)取子 = 方法子;
        (方法子)取种类 = 方法子种;
        如果 (方法子种 ?= "参数表") {
            (方法子)取子数 = 形参数;
            0 = 形参i;
            当 (形参i < 形参数) {
                (方法子, 形参i)取子 = 形参;
                (合成参数列表, 形参)子列表添加;
                形参i + 1 = 形参i;
            }
        }
        否则如果 (方法子种 ?= "输入形参" || 方法子种 ?= "输出形参") {
            // 阶段4C2：自举文法 `方法定义`（工具/日月/日月.文法:60）未把形参包进「参数表」
            // 节点 —— 形参经 `收集` 拍平后作为「方法」节点的直接子（宿主链 `语法分析器`
            // 的方法参数走 `解析参数列表()`，两条链语义等价）。此处把直接形参子纳入合成
            // 参数列表，否则方法形参丢失 → 特化方法体内报「未声明的标识符」。
            (合成参数列表, 方法子)子列表添加;
        }
        否则 { }
        方法j + 1 = 方法j;
    }
    ("参数表", "", 合成参数列表)新节点 = 合成参表节点;
    ()新子列表 = 合成函数子表;
    (合成函数子表, 合成参表节点)子列表添加;
    ("标识符", 合成名)新叶 = 合成名叶;
    (合成函数子表, 合成名叶)子列表添加;
    0 = 方法k;
    当 (方法k < 方法子数) {
        (方法节点, 方法k)取子 = 方法子2;
        (方法子2)取种类 = 方法子种2;
        如果 (方法子种2 ?= "返回表") { (合成函数子表, 方法子2)子列表添加; }
        否则如果 (方法子种2 ?= "代码块") { (合成函数子表, 方法子2)子列表添加; }
        否则 { }
        方法k + 1 = 方法k;
    }
    ("函数", "", 合成函数子表)新节点 = 结果;
}

函数 (节点:整数)收集枚举定义节点 {
    (节点, 0)取子 = 枚举名叶;
    (枚举名叶)取文本 = 枚举_名;
    0 = 枚举_值;
    (节点)取子数 = 枚举子数;
    1 = 枚举i;
    当 (枚举i < 枚举子数) {
        (节点, 枚举i)取子 = 枚举成员节点;
        (枚举成员节点, 0)取子 = 枚举成员名叶;
        (枚举成员名叶)取文本 = 枚举_成员名;
        (枚举成员节点)取子数 = 枚举成员子数;
        如果 (枚举成员子数 >= 2) {
            (枚举成员节点, 1)取子 = 枚举值叶;
            (枚举值叶)取文本 = 枚举_值文本;
            (枚举_值文本)转整数 = 枚举_值;
        } 否则 {
            (枚举_值)转字符串 = 枚举_值文本;
        }
        枚举_名 + "::" = 枚举_行;
        枚举_行 + 枚举_成员名 = 枚举_行;
        (枚举_成员表, 枚举_行, 枚举_值文本)表添加 = 枚举_成员表;
        枚举_值 + 1 = 枚举_值;
        枚举i + 1 = 枚举i;
    }
}

// ────────────────────────────────────────────
// 接口（trait）(阶段4C3-1)：接口定义收集 + 结构体实现校验
//   与宿主链 `语法分析器` 语义一致：仅在「结构体名 : 接口名」且接口存在时校验，
//   逐接口方法签名比对结构体的同名方法（名称 / 形参个数 / 返回类型），
//   缺失或不匹配即报错。非接口基名（如结构体继承）跳过。
// ────────────────────────────────────────────

"" = 变量 接口_校验名;
0 = 变量 接口_校验参;
"" = 变量 接口_校验返;

// 结构体节点声明的基名（`: 接口名`）——首个「标识符」直接子（跳过首子=结构体名）。
// 泛型结构体（子含 类型参数表）由调用方跳过。
函数 (节点:整数)取结构体基名(0 = 结果:字符串) {
    "" = 结果;
    (节点)取子数 = 基名子数;
    1 = 基名i;
    当 (基名i < 基名子数) {
        (节点, 基名i)取子 = 基名子;
        (基名子)取种类 = 基名子种;
        如果 (基名子种 ?= "标识符") { (基名子)取文本 = 结果; 中断; }
        基名i + 1 = 基名i;
    }
}

// 从「返回表」节点取首个输出参数的类型名（无返回 / `()` / `(空)` → ""）。
函数 (节点:整数)取首个输出类型(0 = 结果:字符串) {
    "" = 结果;
    (节点)取子数 = 取返子数;
    如果 (取返子数 > 0) {
        (节点, 0)取子 = 取返首个;
        (取返首个)取子数 = 取返参数子数;
        0 = 取返i;
        当 (取返i < 取返参数子数) {
            (取返首个, 取返i)取子 = 取返子;
            (取返子)取种类 = 取返子种;
            如果 (取返子种 ?= "类型") {
                (取返子)取文本 = 取返类型原始;
                (取返类型原始)长度 = 取返类型长;
                (取返类型原始, 0, 取返类型长)子串 = 结果;
            }
            取返i + 1 = 取返i;
        }
    }
}

// 提取「方法」/「方法签名」节点的 (名, 形参个数, 返回类型) 到 接口_校验* 全局。
// 子 = [标识符(名), 输入形参/输出形参..., 返回表?]（`收集` 拍平后与 方法定义 同构）。
函数 (节点:整数)提取方法签名(无) {
    "" = 接口_校验名;
    0 = 接口_校验参;
    "" = 接口_校验返;
    (节点)取子数 = 提签子数;
    0 = 提签i;
    当 (提签i < 提签子数) {
        (节点, 提签i)取子 = 提签子;
        (提签子)取种类 = 提签子种;
        如果 (提签子种 ?= "标识符" && 提签i ?= 0) {
            (提签子)取文本 = 提签名原始;
            (提签名原始)长度 = 提签名长;
            (提签名原始, 0, 提签名长)子串 = 接口_校验名;
        }
        否则如果 (提签子种 ?= "输入形参" || 提签子种 ?= "输出形参") { 接口_校验参 + 1 = 接口_校验参; }
        否则如果 (提签子种 ?= "返回表") { (提签子)取首个输出类型 = 接口_校验返; }
        提签i + 1 = 提签i;
    }
}

// 校验单个结构体对某接口的全部方法实现。
函数 (结构体节点:整数, 结构体名:字符串, 接口节点:整数, 接口名:字符串)校验单个接口实现(无) {
    (接口节点)取子数 = 接法子数;
    0 = 接法i;
    当 (接法i < 接法子数) {
        (接口节点, 接法i)取子 = 接法子;
        (接法子)取种类 = 接法种;
        如果 (接法种 ?= "方法签名") {
            (接法子)提取方法签名;
            // 留存接口侧签名（避免内层提取方法签名 覆盖 接口_校验* 全局）。
            (接口_校验名)长度 = 接法名长;
            (接口_校验名, 0, 接法名长)子串 = 接法名;
            接口_校验参 = 接法参;
            (接口_校验返)长度 = 接法返长;
            (接口_校验返, 0, 接法返长)子串 = 接法返;
            0 = 接法找到;
            0 = 结构体i;
            (结构体节点)取子数 = 结构体法子数;
            当 (结构体i < 结构体法子数) {
                (结构体节点, 结构体i)取子 = 结构体法;
                (结构体法)取种类 = 结构体法种;
                如果 (结构体法种 ?= "方法") {
                    (结构体法)提取方法签名;
                    如果 (接口_校验名 ?= 接法名) {
                        1 = 接法找到;
                        如果 (接口_校验参 != 接法参 || 接口_校验返 != 接法返) {
                            "结构体 '" + 结构体名 + "' 实现接口 '" + 接口名 + "' 的方法 '" + 接法名 + "' 签名不匹配" = 接口错误;
                            (接口错误)输出错误;
                            1 = 未声明出错;
                        }
                    }
                }
                结构体i + 1 = 结构体i;
            }
            如果 (接法找到 ?= 0) {
                "结构体 '" + 结构体名 + "' 未实现接口 '" + 接口名 + "' 的方法 '" + 接法名 + "'" = 接口错误;
                (接口错误)输出错误;
                1 = 未声明出错;
            }
        }
        接法i + 1 = 接法i;
    }
}

// 预扫描后统一校验：遍历顶层结构体，遇「基名 == 某接口名」即逐方法校验。
函数 (根:整数)校验接口实现(无) {
    (根)取子数 = 接口校验顶层数;
    0 = 接口校验i;
    当 (接口校验i < 接口校验顶层数) {
        (根, 接口校验i)取子 = 接口校验节点;
        (接口校验节点)取种类 = 接口校验种;
        如果 (接口校验种 ?= "接口") {
            // 阶段4C3-2：登记接口名（供泛型约束校验识别「限制名是否为接口」）。
            (接口校验节点, 0)取子 = 接口名叶;
            (接口名叶)取文本 = 接口名原始;
            (接口名原始)长度 = 接口名长;
            (接口名原始, 0, 接口名长)子串 = 接口名登记;
            (接口名集, 接口名登记, "1")表添加 = 接口名集;
        } 否则如果 (接口校验种 ?= "结构体") {
            (接口校验节点)是泛型函数节点 = 接口校验泛型;
            如果 (接口校验泛型 ?= 0) {
                (接口校验节点, 0)取子 = 接口校验名叶;
                (接口校验名叶)取文本 = 接口校验结构体名原始;
                (接口校验结构体名原始)长度 = 接口校验结构体名长;
                (接口校验结构体名原始, 0, 接口校验结构体名长)子串 = 接口校验结构体名;
                (接口校验节点)取结构体基名 = 接口校验基名原始;
                (接口校验基名原始)长度 = 接口校验基名长;
                (接口校验基名原始, 0, 接口校验基名长)子串 = 接口校验基名;
                // 阶段4C3-2：登记结构体「基名/接口名」（供泛型约束校验）。
                如果 (接口校验基名 != "") {
                    (结构体基名表, 接口校验结构体名, 接口校验基名)表替换 = 结构体基名表;
                }
                如果 (接口校验基名 != "") {
                    0 = 接口校验j;
                    当 (接口校验j < 接口校验顶层数) {
                        (根, 接口校验j)取子 = 接口候节点;
                        (接口候节点)取种类 = 接口候种;
                        如果 (接口候种 ?= "接口") {
                            (接口候节点, 0)取子 = 接口候名叶;
                            (接口候名叶)取文本 = 接口候名原始;
                            (接口候名原始)长度 = 接口候名长;
