            ()新寄存器 = 未知截断;
            ("  " + 未知截断 + " = 截断 整数64 " + 未知整值 + " 到 " + 存储IR)发射;
            ("存储 " + 存储IR + " " + 未知截断 + ", 指针 " + 目标地址 + ", 对齐 4")发射;
        }
    } 否则如果 (表达式类型 ?= "函数") {
        (保存存储值, "@")字符串开头 = 是闭包值;
        如果 (是闭包值 ?= 1) {
