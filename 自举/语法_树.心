}

// 条件表达式：条 ? 真枝 : 假枝
// 用「临时槽 + 分支 + 存储/加载」实现（避免 PHI 与跨块值传递）。
// 先捕获真枝文本与类型，据其 IR 类型分配槽位；两支分别存储后于合并块加载。
函数 (节点:整数)发射条件表达式 {
    (节点, 0)取子 = 条件节点;
    (节点, 1)取子 = 真枝节点;
    (节点, 2)取子 = 假枝节点;

    (条件节点)发射表达式;
    ()发射条件;
    当前条件 = 条件布尔;

    生成代码 = 保存真前;
    函数体C = 保存真前体;
    ()新建文本缓冲 = 生成代码;
    ()新建文本缓冲 = 函数体C;
    (真枝节点)发射表达式;
    生成代码 = 真段;
    函数体C = 真段体;
    表达式C = 真值;
    表达式类型 = 真类型;
    表达式IR = 真IR;
    保存真前 = 生成代码;
    保存真前体 = 函数体C;

    8 = 槽对齐;
    如果 (真IR ?= "整数8") { 1 = 槽对齐; }
    否则如果 (真IR ?= "整数16") { 2 = 槽对齐; }
    否则如果 (真IR ?= "整数32") { 4 = 槽对齐; }
    否则如果 (真IR ?= "单精度") { 4 = 槽对齐; }
    (槽对齐)转字符串 = 槽对齐文本;
    ()新寄存器 = 槽;
    ("  " + 槽 + " = 分配 " + 真IR + ", 对齐 " + 槽对齐文本)发射;
    ()新标签 = 真标签;
    ()新标签 = 假标签;
    ()新标签 = 合并标签;
    ("分支 整数1 " + 条件布尔 + ", 标签 %" + 真标签 + ", 标签 %" + 假标签)发射终结;
    (真标签)发射标签;
    (真段)发射缓冲;
    (真段体)发射缓冲;
    ("  存储 " + 真IR + " " + 真值 + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    ("分支 标签 %" + 合并标签)发射终结;
    (假标签)发射标签;
    (假枝节点)发射表达式;
    ("  存储 " + 真IR + " " + 表达式C + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    ("分支 标签 %" + 合并标签)发射终结;
    (合并标签)发射标签;
    ()新寄存器 = 表达式C;
    ("  " + 表达式C + " = 加载 " + 真IR + ", 指针 " + 槽 + ", 对齐 " + 槽对齐文本)发射;
    真类型 = 表达式类型;
    真IR = 表达式IR;
}

// ============================================
// 语句发射 (S4.4b)
// ============================================

函数 (节点:整数)发射语句 {
    (节点)取种类 = 种;
    如果 (种 ?= "代码块") { (节点)发射代码块; }
    否则如果 (种 ?= "表达式语句") {
        (节点, 0)取子 = 子;
        (子)发射表达式;
    }
    否则如果 (种 ?= "赋值") { (节点)发射赋值; }
    否则如果 (种 ?= "返回") { (节点)发射返回语句; }
    否则如果 (种 ?= "中断") {
        ()查退出栈 = 中断标签;
        ("分支 标签 %" + 中断标签)发射终结;
    }
    否则如果 (种 ?= "继续") {
        ()查继续栈 = 继续标签2;
        ("分支 标签 %" + 继续标签2)发射终结;
    }
    否则如果 (种 ?= "如果") { (节点)发射如果; }
    否则如果 (种 ?= "当") { (节点)发射当; }
    否则如果 (种 ?= "循环") { (节点)发射循环; }
    否则如果 (种 ?= "遍历") { (节点)发射遍历; }
    否则如果 (种 ?= "匹配") { (节点)发射匹配; }
    否则 { }
}

函数 (节点:整数)发射代码块 {
    (节点)取子数 = 块数;
    0 = 块i;
    当 (块i < 块数) {
        (节点, 块i)取子 = 语句;
        (语句)发射语句;
        块i + 1 = 块i;
    }
}

函数 (节点:整数)发射返回语句 {
    (节点)取子数 = 返数;
    如果 (返数 ?= 0) { ("返回 空类型")发射终结; }
    否则 {
        (节点, 0)取子 = 返值;
        (返值)发射表达式;
        如果 (表达式类型 ?= "字符串") { ("返回 指针 " + 表达式C)发射终结; }
        否则如果 (表达式类型 ?= "浮点") { ("返回 双精度 " + 表达式C)发射终结; }
        否则 { ("返回 整数32 " + 表达式C)发射终结; }
    }
}

函数 (节点:整数)发射当 {
    (节点, 0)取子 = 当条件;
    (节点, 1)取子 = 当体;
    ()新标签 = 当头标签;
    ()新标签 = 当体标签;
    ()新标签 = 当退出标签;
    (当退出标签)压退出栈;
    (当头标签)压继续栈;
    (当头标签)发射标签;
    (当条件)发射表达式;
    ()发射条件;
    ("分支 整数1 " + 当前条件 + ", 标签 %" + 当体标签 + ", 标签 %" + 当退出标签)发射终结;
    (当体标签)发射标签;
    (当体)发射代码块;
    ("分支 标签 %" + 当头标签)发射终结;
    (当退出标签)发射标签;
    ()弹退出栈;
    ()弹继续栈;
}

函数 (节点:整数)发射循环 {
    (节点, 0)取子 = 循环头节点;
    (节点, 1)取子 = 循环体节点;
    (循环头节点, 0)取子 = 循环变量叶;
    (循环变量叶)取文本 = 循环变量;
    (循环头节点, 1)取子 = 循环开始节点;
    (循环开始节点)发射表达式;
    表达式C = 循环开始C;
    (循环头节点, 2)取子 = 循环结束节点;
    (循环结束节点)发射表达式;
    表达式C = 循环结束C;
    (循环头节点)取子数 = 循环头数;
    如果 (循环头数 >= 4) {
        (循环头节点, 3)取子 = 循环步长节点;
        (循环步长节点)发射表达式;
        表达式C = 循环步长C;
    } 否则 {
        "1" = 循环步长C;
    }
    (循环变量, "I")局部表添加;
    (循环变量)转义标识符 = 循环变量转义;
    ()新标签 = 范围头标签;
    ()新标签 = 范围体标签;
    ()新标签 = 范围步长标签;
    ()新标签 = 范围退出标签;
    (范围退出标签)压退出栈;
    (范围步长标签)压继续栈;
    ("存储 整数32 " + 循环开始C + ", 指针 %" + 循环变量转义 + ", 对齐 4")发射;
    (范围头标签)发射标签;
    ()新寄存器 = 范围循环值;
    ("  " + 范围循环值 + " = 加载 整数32, 指针 %" + 循环变量转义 + ", 对齐 4")发射;
    ()新寄存器 = 范围比较;
    ("  " + 范围比较 + " = 整数比较 有符号小于 整数32 " + 范围循环值 + ", " + 循环结束C)发射;
    ("分支 整数1 " + 范围比较 + ", 标签 %" + 范围体标签 + ", 标签 %" + 范围退出标签)发射终结;
    (范围体标签)发射标签;
    (循环体节点)发射代码块;
