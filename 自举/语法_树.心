                (默认解码)存字符串结构常量 = 默认常量;
                ("存储 指针 " + 默认常量 + ", 指针 %" + 输出转义 + ", 对齐 8")发射;
            } 否则 {
                ("存储 指针 空指针, 指针 %" + 输出转义 + ", 对齐 8")发射;
            }
        } 否则如果 (输出码 ?= "C" || 输出码 ?= "O" || 输出码 ?= "M" || 输出码 ?= "T" || 输出码 ?= "A" || 输出码 ?= "P") {
            ("%" + 输出转义 + " = 分配 指针, 对齐 8")发射;
            ("存储 指针 空指针, 指针 %" + 输出转义 + ", 对齐 8")发射;
        } 否则如果 (输出码 ?= "F") {
