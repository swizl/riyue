        (当前子程序, 调试子程体)设置元数据;
        " !dbg !" + (当前子程序)转字符串 = 函数调试尾;
    }
    0 = 已终结;
    // 内存安全 §八 O2b：函数体顶层块从深度 0 起算（发射代码块 +1 后 = 1）。
    0 = 当前块深度;
    1 = 缓冲模式;
    ()新建文本缓冲 = 函数体C;
