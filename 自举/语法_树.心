    // 集中包装：C 边界内建/外部符号返回的裸 char* 补长度，升为胖指针
    // （日月函数/闭包/函数变量/胖结构内建 的结果已是胖指针，胖_调用已胖=1）
    如果 (胖_调用已胖 ?= 0 && 表达式类型 ?= "字符串") {
