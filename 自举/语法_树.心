函数 发射局部声明 {
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        (行)长度 = 行长;
        0 = 位置;
        "" = 局部名;
        当 (位置 < 行长) {
            (行, 位置, 1)子串 = 字;
            如果 (字 ?= ":") { 位置 = 行长; }
            否则 {
                局部名 + 字 = 局部名;
                位置 + 1 = 位置;
            }
        }
        (局部名)长度 = 类型码长;
        (行, 类型码长 + 1, 1)子串 = 提取类型码;
        0 = 索引2;
        (已声明表)分割行数 = 声明行数;
        0 = 已声明命中;
        当 (索引2 < 声明行数) {
            (已声明表, 索引2)获取行 = 声明行;
            (声明行, 局部名 + ":")字符串开头 = 已声明命中;
            如果 (已声明命中 ?= 1) { 索引2 = 声明行数; }
            否则 { 索引2 + 1 = 索引2; }
        }
        如果 (已声明命中 ?= 0) {
            (局部名)转义标识符 = 局部转义;
            如果 (提取类型码 ?= "S") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "C") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "F") { ("%" + 局部转义 + " = 分配 double, align 8")发射; }
            否则如果 (提取类型码 ?= "A") {
                (局部名)查数组大小 = 数组大小文本;
                (局部名)查数组元素码 = 数组元素码;
                (数组元素码)数组元素转IR = 数组元素IR;
                (数组元素码)数组对齐 = 数组对齐值;
                ("%" + 局部转义 + " = 分配 [" + 数组大小文本 + " x " + 数组元素IR + "], align " + 数组对齐值)发射;
            }
            否则如果 (提取类型码 ?= "O") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "M") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "T") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则 { ("%" + 局部转义 + " = 分配 i32, align 4")发射; }
        }
        索引 + 1 = 索引;
    }
}
