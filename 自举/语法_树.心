// 成员方法调用：基表达式为结构体变量，组装 结构体名_方法名(基址, 实参...) 合成调用节点
// 项节点子 = [标识符(方法名), 实参...]；左节点 = 基表达式（结构体变量标识符）
函数 (左:整数, 项:整数)发射成员调用 {
    (左)取文本 = 基名;
    (基名)查结构体变量类型 = 基结构体名;
    如果 (基结构体名 ?= "") { 基结构体名 = 当前结构体名; }
    (项, 0)取子 = 方法名叶;
    (方法名叶)取文本 = 方法名;
    基结构体名 + "_" = 合成名;
    合成名 + 方法名 = 合成名;
    ()新子列表 = 成员调用参数;
    (成员调用参数, 左)子列表添加;
    (项)取子数 = 成员调用子数;
    1 = 成员调用i;
    当 (成员调用i < 成员调用子数) {
        (项, 成员调用i)取子 = 成员实参;
        (成员调用参数, 成员实参)子列表添加;
        成员调用i + 1 = 成员调用i;
    }
    ("函数调用", 合成名, 成员调用参数)新节点 = 成员调用节点;
    (成员调用节点)发射调用;
}

函数 (节点:整数)发射下标访问 {
    表达式C = 基地址;
