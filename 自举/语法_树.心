        如果 (求子数 >= 1) {
            (节点, 0)取子 = 求子;
            (求子)编译期求表达式 = 内成;
            如果 (内成 ?= 1) {
                (节点)取文本 = 求符;
                编译期_结果 = 求甲;
                如果 (求符 ?= "-") { 0 - 求甲 = 编译期_结果; 1 = 成; }
                否则如果 (求符 ?= "!") {
                    0 = 编译期_结果;
                    如果 (求甲 ?= 0) { 1 = 编译期_结果; }
                    1 = 成;
                }
            }
        }
    }
    否则如果 (求种 ?= "二元运算") {
        (节点)取子数 = 求子数;
        如果 (求子数 >= 2) {
            (节点, 0)取子 = 求左节;
            (节点, 1)取子 = 求右节;
            (求左节)编译期求表达式 = 左成;
            如果 (左成 ?= 1) {
                编译期_结果 = 求左值;
                (求右节)编译期求表达式 = 右成;
                如果 (右成 ?= 1) {
                    编译期_结果 = 求右值;
                    (节点)取文本 = 求符;
                    (求左值, 求右值, 求符)编译期二元运算 = 算成;
                    如果 (算成 ?= 1) { 1 = 成; }
