        } 否则如果 (输出码 ?= "B") {
            ("%" + 输出转义 + " = 分配 整数8, 对齐 1")发射;
            ("存储 整数8 " + 默认值文本 + ", 指针 %" + 输出转义 + ", 对齐 1")发射;
