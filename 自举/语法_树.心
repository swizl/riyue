    ("  " + 下标扩展 + " = 零扩展 整数32 " + 保存下标 + " 到 整数64")发射;
    (数组大小文本)发射越界检查;
    ()新寄存器 = 元素指针;
    ("  " + 元素指针 + " = 获取元素指针 [" + 数组大小文本 + " 个 " + 数组元素IR + "], 指针 " + 目标地址 + ", 整数64 0, 整数64 " + 下标扩展)发射;
    ("  存储 " + 数组元素IR + " " + 保存存储值 + ", 指针 " + 元素指针 + ", 对齐 " + 数组对齐值)发射;
    }
}

