函数 (节点:整数)发射赋值 {
    (节点)取子数 = 赋值子数;
    (节点, 0)取子 = 赋值甲;
    (赋值甲)取种类 = 赋值甲种;
    (节点, 赋值子数 - 1)取子 = 赋值乙;
    (赋值乙)取种类 = 赋值乙种;
    "" = 值侧类型;
    如果 (赋值子数 >= 3) {
        (节点, 1)取子 = 赋值子;
        (赋值子)取种类 = 赋值子种;
        如果 (赋值子种 ?= "类型") { (赋值子)取文本 = 值侧类型; }
    }
    // 反向赋值：本行含义为「声明目标类型 := 值侧类型」。每条赋值语句都重设它，
    // 避免上一语句残留的标注泄漏到无标注的目标上（否则 `0 = 甲;` 会被当成上一句的类型）。
    值侧类型 = 声明目标类型;
    0 = 首是标识;
    如果 (赋值甲种 ?= "标识符") { 1 = 首是标识; }
    如果 (赋值乙种 ?= "目标") { 0 = 首是标识; }
    如果 (赋值乙种 ?= "常量目标") { 0 = 首是标识; }
    如果 (赋值乙种 ?= "解构") { 0 = 首是标识; }
    如果 (首是标识 ?= 1) {
        (赋值甲)取文本 = 目标名;
        (节点, 1)取子 = 赋值尾;
        (赋值尾)取种类 = 赋值尾种;
        如果 (赋值尾种 ?= "复合赋值尾") {
            (赋值尾, 0)取子 = 复合符叶;
            (复合符叶)取文本 = 复合符;
            (赋值尾, 1)取子 = 复合值节点;
            (复合值节点)发射表达式;
            表达式C = 复合值C;
            (目标名)转义标识符 = 目标转义;
            (目标名)查类型 = 类型码;
            如果 (命中全局表 ?= 1) { "@" + 目标转义 = 目标地址; }
            否则 { "%" + 目标转义 = 目标地址; }
            ()新寄存器 = 复合加载;
            ("  " + 复合加载 + " = 加载 整数32, 指针 " + 目标地址 + ", 对齐 4")发射;
            ()新寄存器 = 复合运算;
            如果 (复合符 ?= "+=") { ("  " + 复合运算 + " = 加 整数32 " + 复合加载 + ", " + 复合值C)发射; }
            否则如果 (复合符 ?= "-=") { ("  " + 复合运算 + " = 减 整数32 " + 复合加载 + ", " + 复合值C)发射; }
            否则如果 (复合符 ?= "*=") { ("  " + 复合运算 + " = 乘 整数32 " + 复合加载 + ", " + 复合值C)发射; }
            否则 { ("  " + 复合运算 + " = 有符号除 整数32 " + 复合加载 + ", " + 复合值C)发射; }
            ("存储 整数32 " + 复合运算 + ", 指针 " + 目标地址 + ", 对齐 4")发射;
        } 否则如果 (赋值尾种 ?= "赋值尾") {
            (赋值尾, 0)取子 = 赋值位置节点;
            (赋值尾, 1)取子 = 赋值值节点;
            (赋值位置节点)取种类 = 赋值位置种;
            如果 (赋值位置种 ?= "下标") {
                (赋值位置节点, 0)取子 = 赋值下标节点;
                (赋值值节点, 目标名, 赋值下标节点)发射下标写;
            } 否则如果 (赋值位置种 ?= "成员") {
                (赋值位置节点, 0)取子 = 赋值成员叶;
                (赋值成员叶)取文本 = 赋值成员名;
                // 内存安全 §八 O2：拥有型句柄写入结构体成员 → 句柄可能被外部持有，判逃逸。
                (赋值值节点)取种类 = 成员写源种;
                如果 (成员写源种 ?= "变量" || 成员写源种 ?= "标识符") {
                    (赋值值节点)取文本 = 成员写源名;
                    (逃逸表, 成员写源名, "1")表添加 = 逃逸表;
                }
                (赋值值节点, 目标名, 赋值成员名)发射成员写;
            } 否则 {
                (赋值值节点, 目标名)发射变量写到;
            }
        }
    } 否则 {
        // 目标恒为末位子（带类型标注时为 [值, 类型, 目标]，否则 [值, 目标]）；
        // 早前写死 child[1] 会在带标注时误取到「类型」结点，导致赋值被静默丢弃、目标未声明。
        (节点, 赋值子数 - 1)取子 = 赋值目标节点;
        (赋值甲, 赋值目标节点)发射赋值到目标;
    }
}

函数 (值节点:整数, 目标节点:整数)发射赋值到目标 {
