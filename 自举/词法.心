// ============================================
// 日月编译器 — 自举源码 (compiler.心) v3
// 将 日月 源码翻译为 中文 LLVM IR 文本
//
// 用法:  compiler.exe 输入.心 输出.ll
// 输出的 .ll 由 llvm-as + llc + ld.lld 配合 运行时辅助.o 链接为可执行（见 Makefile 自举 目标）。
// ============================================
//
// 词法模块：字符操作 + 词法分析（当前字符码/下一个字符码/前进/判断空白/判断数字/判断字母开始/判断字母数字/跳过空白注释/下一个标记）
// 由 自举/编译器.心 导入 展开（拆分自 编译器.心，函数体未改动）
//

// ────────────────────────────────────────────
// 字符操作 (Character Operations)
// ────────────────────────────────────────────

函数 当前字符码(0 = 结果:整数) {
    (源码)长度 = 长;
    如果 (源位置 < 长) {
        (源码, 源位置)字符码 = 结果;
    } 否则 {
        0 - 1 = 结果;
    }
}

函数 下一个字符码(0 = 结果:整数) {
    (源码)长度 = 长;
    如果 (源位置 + 1 < 长) {
        (源码, 源位置 + 1)字符码 = 结果;
    } 否则 {
        0 - 1 = 结果;
    }
}

函数 前进 {
    (源码, 源位置)字符码 = 当前码;
    如果 (当前码 ?= 10) { 当前行号 + 1 = 当前行号; }
    源位置 + 1 = 源位置;
}

函数 (码:整数)判断空白(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) { 1 = 结果; }
}

函数 (码:整数)判断数字(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
}

函数 (码:整数)判断字母开始(0 = 结果:整数) {
    0 = 结果;
    如果 ((码 >= 65 && 码 <= 90) || (码 >= 97 && 码 <= 122) || 码 > 127) { 1 = 结果; }
}

函数 (码:整数)判断字母数字(0 = 结果:整数) {
    0 = 结果;
    如果 ((码 >= 65 && 码 <= 90) || (码 >= 97 && 码 <= 122) || (码 >= 48 && 码 <= 57) || 码 ?= 95 || 码 > 127) { 1 = 结果; }
}

// ────────────────────────────────────────────
// 词法分析 (Lexer)
// ────────────────────────────────────────────

函数 跳过空白注释 {
    (源码)长度 = 长;
    当 (源位置 < 长) {
        ()当前字符码 = 码;
        (码)判断空白 = 判断空白结果;
        如果 (判断空白结果 ?= 1) {
            ()前进;
        } 否则如果 (码 ?= 47) {
            ()下一个字符码 = 第二码;
            如果 (第二码 ?= 47) {
                // // 单行注释：跳到行尾
                当 (源位置 < 长) {
                    ()当前字符码 = 行内码;
                    如果 (行内码 ?= 10) { 中断; }
                    ()前进;
                }
            } 否则如果 (第二码 ?= 42) {
                // /* 块注释 */
                ()前进;
                ()前进;
                当 (源位置 < 长) {
                    ()当前字符码 = 块码;
                    ()下一个字符码 = 块下码;
                    如果 (块码 ?= 42 && 块下码 ?= 47) {
                        ()前进;
                        ()前进;
                        中断;
                    }
                    ()前进;
                }
            } 否则 {
                中断;
            }
        } 否则 {
            中断;
        }
    }
}

函数 下一个标记 {
    ()跳过空白注释;
    (源码)长度 = 长;
    如果 (源位置 >= 长) {
        0 = 标记类型;
        "" = 标记值;
    } 否则 {
        ()当前字符码 = 码;
        (码)判断数字 = 判断数字结果;
        如果 (判断数字结果 ?= 1) {
            // 数字（整数或浮点）
            1 = 标记类型;
            "" = 数字文本;
            当 (真) {
                ()当前字符码 = 当前码;
                (当前码)判断数字 = 判断数字结果;
                如果 (判断数字结果 ?= 1) {
                    (源码, 源位置, 1)子串 = 字;
                    数字文本 + 字 = 数字文本;
                    ()前进;
                } 否则 {
                    中断;
                }
            }
            // 浮点小数部分：当前为 '.' 且其后为数字时，标记为浮点(5) 并消费小数位
            ()当前字符码 = 当前码;
            如果 (当前码 ?= 46) {
                ()下一个字符码 = 小数首码;
                (小数首码)判断数字 = 小数判数;
                如果 (小数判数 ?= 1) {
                    5 = 标记类型;
                    数字文本 + "." = 数字文本;
                    ()前进;
                    当 (真) {
                        ()当前字符码 = 小数码;
                        (小数码)判断数字 = 小数判数2;
                        如果 (小数判数2 ?= 1) {
                            (源码, 源位置, 1)子串 = 小数字;
                            数字文本 + 小数字 = 数字文本;
                            ()前进;
                        } 否则 {
                            中断;
                        }
                    }
                }
            }
            数字文本 = 标记值;
        } 否则 {
            (码)判断字母开始 = 判断字母开始结果;
            如果 (判断字母开始结果 ?= 1) {
                // 标识符
                2 = 标记类型;
                "" = 标识文本;
                当 (真) {
                    ()当前字符码 = 当前码;
                    (当前码)判断字母数字 = 判断字母数字结果;
                    如果 (判断字母数字结果 ?= 1) {
                        (源码, 源位置, 1)子串 = 字;
                        标识文本 + 字 = 标识文本;
                        ()前进;
                    } 否则 {
                        中断;
                    }
                }
                标识文本 = 标记值;
            } 否则如果 (码 ?= 34) {
                // 字符串字面量
                3 = 标记类型;
                ()前进;
                "" = 字符串文本;
                当 (真) {
                    ()当前字符码 = 当前码;
                    如果 (当前码 ?= 34) {
                        ()前进;
                        中断;
                    } 否则如果 (当前码 ?= 92) {
                        // 转义字符
                        ()前进;
                        ()当前字符码 = 转义码;
                        如果 (转义码 ?= 110) { 字符串文本 + "\n" = 字符串文本; }
                        否则如果 (转义码 ?= 116) { 字符串文本 + "\t" = 字符串文本; }
                        否则 { (源码, 源位置, 1)子串 = 转义字; 字符串文本 + 转义字 = 字符串文本; }
                        ()前进;
                    } 否则 {
                        (源码, 源位置, 1)子串 = 字;
                        字符串文本 + 字 = 字符串文本;
                        ()前进;
                    }
                }
                字符串文本 = 标记值;
            } 否则 {
                // 运算符（含双字符）
                4 = 标记类型;
                (源码, 源位置, 1)子串 = 操作符;
                操作符 = 标记值;
                ()前进;
                ()当前字符码 = 第二码;
                如果 (操作符 ?= "=") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 62) { 标记值 + ">" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 43) { 标记值 + "+" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 45) { 标记值 + "-" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 42) { 标记值 + "*" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 47) { 标记值 + "/" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "!") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "<") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= ">") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "&") {
                    如果 (第二码 ?= 38) { 标记值 + "&" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "|") {
                    如果 (第二码 ?= 124) { 标记值 + "|" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "?") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "+") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "-") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "*") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                 } 否则如果 (操作符 ?= "/") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                 } 否则如果 (操作符 ?= ":") {
                    如果 (第二码 ?= 58) { 标记值 + ":" = 标记值; ()前进; }
                 }
             }
        }
    }
}
