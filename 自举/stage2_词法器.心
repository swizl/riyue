// ============================================
// Stage 2: 词法分析器 — 验证编译器能编译词法分析
// ============================================

变量 标记_整数 = 1;
变量 标记_标识符 = 2;
变量 标记_加号 = 3;
变量 标记_减号 = 4;
变量 标记_乘号 = 5;
变量 标记_除号 = 6;
变量 标记_左括号 = 7;
变量 标记_右括号 = 8;
变量 标记_分号 = 9;
变量 标记_等于 = 10;
变量 标记_文件结束 = 99;

变量 源代码 = "";
变量 源位置 = 0;
变量 当前标记类型 = 0;
变量 当前标记值 = "";

函数 下一个标记(): 空 {
    // 跳过空白
    当 (源位置 < 长度(源代码)) {
        变量 c = 子串(源代码, 源位置, 1);
        如果 (c ?= " ") { 源位置 = 源位置 + 1; } 否则如果 (c ?= "\t") { 源位置 = 源位置 + 1; } 否则如果 (c ?= "\n") { 源位置 = 源位置 + 1; } 否则 { 中断; }
    }

    如果 (源位置 >= 长度(源代码)) {
        当前标记类型 = 标记_文件结束;
        当前标记值 = "";
        返回;
    }

    变量 c = 子串(源代码, 源位置, 1);

    // 数字
    变量 是数字 = 0;
    如果 (c ?= "0") { 是数字 = 1; }
    如果 (c ?= "1") { 是数字 = 1; }
    如果 (c ?= "2") { 是数字 = 1; }
    如果 (c ?= "3") { 是数字 = 1; }
    如果 (c ?= "4") { 是数字 = 1; }
    如果 (c ?= "5") { 是数字 = 1; }
    如果 (c ?= "6") { 是数字 = 1; }
    如果 (c ?= "7") { 是数字 = 1; }
    如果 (c ?= "8") { 是数字 = 1; }
    如果 (c ?= "9") { 是数字 = 1; }

    如果 (是数字 ?= 1) {
        变量 开始 = 源位置;
        当 (源位置 < 长度(源代码)) {
            变量 ch = 子串(源代码, 源位置, 1);
            变量 是数 = 0;
            如果 (ch ?= "0") { 是数 = 1; }
            如果 (ch ?= "1") { 是数 = 1; }
            如果 (ch ?= "2") { 是数 = 1; }
            如果 (ch ?= "3") { 是数 = 1; }
            如果 (ch ?= "4") { 是数 = 1; }
            如果 (ch ?= "5") { 是数 = 1; }
            如果 (ch ?= "6") { 是数 = 1; }
            如果 (ch ?= "7") { 是数 = 1; }
            如果 (ch ?= "8") { 是数 = 1; }
            如果 (ch ?= "9") { 是数 = 1; }
            如果 (是数 ?= 1) {
                源位置 = 源位置 + 1;
            } 否则 {
                中断;
            }
        }
        当前标记类型 = 标记_整数;
        当前标记值 = 子串(源代码, 开始, 源位置 - 开始);
        返回;
    }

    // 标识符 (非数字、非运算符、非空白)
    变量 是运算符 = 0;
    如果 (c ?= "+") { 是运算符 = 1; }
    如果 (c ?= "-") { 是运算符 = 1; }
    如果 (c ?= "*") { 是运算符 = 1; }
    如果 (c ?= "/") { 是运算符 = 1; }
    如果 (c ?= "(") { 是运算符 = 1; }
    如果 (c ?= ")") { 是运算符 = 1; }
    如果 (c ?= ";") { 是运算符 = 1; }
    如果 (c ?= "=") { 是运算符 = 1; }

    如果 (是运算符 ?= 0) {
        变量 开始 = 源位置;
        源位置 = 源位置 + 1;
        当前标记类型 = 标记_标识符;
        当前标记值 = 子串(源代码, 开始, 1);
        返回;
    }

    // 单字符标记
    源位置 = 源位置 + 1;
    如果 (c ?= "+") { 当前标记类型 = 标记_加号; 当前标记值 = "+"; 返回; }
    如果 (c ?= "-") { 当前标记类型 = 标记_减号; 当前标记值 = "-"; 返回; }
    如果 (c ?= "*") { 当前标记类型 = 标记_乘号; 当前标记值 = "*"; 返回; }
    如果 (c ?= "/") { 当前标记类型 = 标记_除号; 当前标记值 = "/"; 返回; }
    如果 (c ?= "(") { 当前标记类型 = 标记_左括号; 当前标记值 = "("; 返回; }
    如果 (c ?= ")") { 当前标记类型 = 标记_右括号; 当前标记值 = ")"; 返回; }
    如果 (c ?= ";") { 当前标记类型 = 标记_分号; 当前标记值 = ";"; 返回; }
    如果 (c ?= "=") { 当前标记类型 = 标记_等于; 当前标记值 = "="; 返回; }

    当前标记类型 = 0;
    当前标记值 = "";
}

函数 断言(条件, 消息): 空 {
    如果 (!条件) {
        打印("[失败] ");
        打印(消息);
    }
}

函数 测试整数词法(): 空 {
    源代码 = "123 456";
    源位置 = 0;
    下一个标记();
    断言(当前标记类型 ?= 标记_整数, "整数类型");
    断言(当前标记值 ?= "123", "整数值");
    下一个标记();
    断言(当前标记类型 ?= 标记_整数, "第二个整数");
    断言(当前标记值 ?= "456", "第二个整数值");
    下一个标记();
    断言(当前标记类型 ?= 标记_文件结束, "结束");
}

函数 测试运算符词法(): 空 {
    源代码 = "+ - * / ( ) ; =";
    源位置 = 0;
    下一个标记();
    断言(当前标记类型 ?= 标记_加号, "+");
    下一个标记();
    断言(当前标记类型 ?= 标记_减号, "-");
    下一个标记();
    断言(当前标记类型 ?= 标记_乘号, "*");
    下一个标记();
    断言(当前标记类型 ?= 标记_除号, "/");
    下一个标记();
    断言(当前标记类型 ?= 标记_左括号, "(");
    下一个标记();
    断言(当前标记类型 ?= 标记_右括号, ")");
    下一个标记();
    断言(当前标记类型 ?= 标记_分号, ";");
    下一个标记();
    断言(当前标记类型 ?= 标记_等于, "=");
}

函数 测试混合词法(): 空 {
    源代码 = "(x + 1);";
    源位置 = 0;
    下一个标记();
    断言(当前标记类型 ?= 标记_左括号, "(");
    下一个标记();
    断言(当前标记类型 ?= 标记_标识符, "x");
    下一个标记();
    断言(当前标记类型 ?= 标记_加号, "+");
    下一个标记();
    断言(当前标记类型 ?= 标记_整数, "1");
    下一个标记();
    断言(当前标记类型 ?= 标记_右括号, ")");
    下一个标记();
    断言(当前标记类型 ?= 标记_分号, ";");
}

函数 主程序(): 空 {
    打印("=== Stage 2: 词法分析器 ===");
    测试整数词法();
    测试运算符词法();
    测试混合词法();
    打印("=== Stage 2 通过 ===");
}
