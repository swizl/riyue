// 日月编译器 — 自举源码 (compiler.心) v3
// 将 日月 源码翻译为 中文 LLVM IR 文本
//
// 用法:  compiler.exe 输入.心 输出.ll
// 输出的 .ll 由 llvm-as + llc + ld.lld 配合 运行时辅助.o 链接为可执行（见 Makefile 自举 目标）。
// ============================================
//
// 发射模块：IR 发射基础设施（发射/转义字符串/字节转义/转UTF8字节转义/转义标识符/表转义/表还原/存字符串常量/新寄存器/新标签/压退出栈/弹退出栈/查退出栈/压继续栈/弹继续栈/查继续栈/发射终结/发射标签/发射条件/类型转IR/提取行名/提取行码/取地址/提升浮点/表添加/表替换/局部表添加/全局表添加/函数返回表添加/查类型/查函数返回类型/发射前导/发射辅助函数定义/发射字符串常量表/发射主程序入口/预计算转义/查表值/在表/表删除/查闭包函数/查闭包返回）
// 由 自举/编译器.心 导入 展开（拆分自 编译器.心，函数体未改动）
//

// ────────────────────────────────────────────
// 类型表 (Type Tables)
// ────────────────────────────────────────────

// 追加 名:类型码 到表中（\n 分隔），返回新表
函数 (表:字符串, 名:字符串, 类型码:字符串)表添加(0 = 结果:字符串) {
    如果 (表 ?= "") {
        表 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 类型码 = 结果;
    } 否则 {
        表 + "\n" = 结果;
        结果 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 类型码 = 结果;
    }
}

// 表替换：删除所有 名: 前缀行（精确匹配「名:」，避免 f 覆盖 f2），再以 表添加 的行格式追加 名:新值
函数 (表:字符串, 名:字符串, 新值:字符串)表替换(0 = 结果:字符串) {
    "" = 结果;
    0 = 索引;
    (表)分割行数 = 行数;
    当 (索引 < 行数) {
        (表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 0) {
            如果 (结果 ?= "") { 行 = 结果; }
            否则 { 结果 + "\n" = 结果; 结果 + 行 = 结果; }
        }
        索引 + 1 = 索引;
    }
    如果 (结果 ?= "") { 结果 + 名 = 结果; }
    否则 { 结果 + "\n" = 结果; 结果 + 名 = 结果; }
    结果 + ":" = 结果;
    结果 + 新值 = 结果;
    结果 + "\n" = 结果;
}

函数 (名:字符串, 类型码:字符串)局部表添加 {
    (局部类型表, 名, 类型码)表添加 = 局部类型表;
}

函数 (名:字符串, 类型码:字符串)全局表添加 {
    (全局类型表, 名, 类型码)表添加 = 全局类型表;
}

函数 (名:字符串, 类型码:字符串)函数返回表添加 {
    (函数返回表, 名, 类型码)表添加 = 函数返回表;
}

// 查类型：0=未知 1=整数 2=字符串 3=浮点
函数 (名:字符串)查类型(0 = 结果:整数) {
    0 = 命中全局表;
    0 = 结果;
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 1) {
            (名)长度 = 名长;
             (行, 名长 + 1, 1)子串 = 提取类型码;
             如果 (提取类型码 ?= "S") { 2 = 结果; }
             否则如果 (提取类型码 ?= "F") { 3 = 结果; }
             否则如果 (提取类型码 ?= "C") { 4 = 结果; }
             否则如果 (提取类型码 ?= "A") { 5 = 结果; }
             否则如果 (提取类型码 ?= "O") { 6 = 结果; }
             否则如果 (提取类型码 ?= "M") { 7 = 结果; }
             否则如果 (提取类型码 ?= "T") { 8 = 结果; }
             否则如果 (提取类型码 ?= "B") { 20 = 结果; }
             否则如果 (提取类型码 ?= "H") { 21 = 结果; }
             否则如果 (提取类型码 ?= "J") { 22 = 结果; }
             否则如果 (提取类型码 ?= "G") { 23 = 结果; }
             否则如果 (提取类型码 ?= "U") { 9 = 结果; }
             否则 { 1 = 结果; }
             索引 = 行数;
         } 否则 {
             索引 + 1 = 索引;
         }
     }
     如果 (结果 ?= 0) {
        0 = 索引;
        (全局类型表)分割行数 = 行数;
        当 (索引 < 行数) {
            (全局类型表, 索引)获取行 = 行;
             (行, 名 + ":")字符串开头 = 开头命中;
             如果 (开头命中 ?= 1) {
                (名)长度 = 名长;
                 (行, 名长 + 1, 1)子串 = 提取类型码;
                 如果 (提取类型码 ?= "S") { 2 = 结果; }
                 否则如果 (提取类型码 ?= "F") { 3 = 结果; }
             否则如果 (提取类型码 ?= "C") { 4 = 结果; }
                  否则如果 (提取类型码 ?= "A") { 5 = 结果; }
                  否则如果 (提取类型码 ?= "O") { 6 = 结果; }
                  否则如果 (提取类型码 ?= "M") { 7 = 结果; }
                  否则如果 (提取类型码 ?= "T") { 8 = 结果; }
             否则如果 (提取类型码 ?= "B") { 20 = 结果; }
             否则如果 (提取类型码 ?= "H") { 21 = 结果; }
             否则如果 (提取类型码 ?= "J") { 22 = 结果; }
             否则如果 (提取类型码 ?= "G") { 23 = 结果; }
                  否则如果 (提取类型码 ?= "U") { 9 = 结果; }
                  否则 { 1 = 结果; }
                  1 = 命中全局表;
                索引 = 行数;
            } 否则 {
                索引 + 1 = 索引;
            }
        }
    }
}

// 查函数返回类型：0=无 1=整数 2=字符串
函数 (名:字符串)查函数返回类型(0 = 结果:整数) {
    0 = 结果;
    0 = 索引;
    (函数返回表)分割行数 = 行数;
    当 (索引 < 行数) {
        (函数返回表, 索引)获取行 = 行;
        (行, 名 + ":")字符串开头 = 开头命中;
        如果 (开头命中 ?= 1) {
            (名)长度 = 名长;
            (行, 名长 + 1, 1)子串 = 提取类型码;
            如果 (提取类型码 ?= "S") { 2 = 结果; }
            否则如果 (提取类型码 ?= "F") { 3 = 结果; }
            否则 { 1 = 结果; }
            索引 = 行数;
        } 否则 {
            索引 + 1 = 索引;
        }
    }
}

// ────────────────────────────────────────────
// 发射助手 (Emit Helpers)
// ────────────────────────────────────────────

函数 (生成文本:字符串)发射 {
    如果 (缓冲模式 ?= 1) {
        函数体C + 生成文本 = 函数体C;
        函数体C + "\n" = 函数体C;
    } 否则 {
        生成代码 + 生成文本 = 生成代码;
        生成代码 + "\n" = 生成代码;
    }
}

// 把字符串内容转成 IR 字"..." 字面量（带引号；LLVM 需 \XX 十六进制转义，不支持 \n/\t/\"/\\）
函数 (内容:字符串)转义字符串(0 = 结果:字符串) {
    "" = 转义文本;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 34) { (码)字节转义 = 转义字节; 转义文本 + 转义字节 = 转义文本; }
        否则如果 (码 ?= 92) { (码)字节转义 = 转义字节; 转义文本 + 转义字节 = 转义文本; }
        否则如果 (码 < 32) { (码)字节转义 = 转义字节; 转义文本 + 转义字节 = 转义文本; }
        否则如果 (码 >= 128) {
            (码)转UTF8字节转义 = 转义字节;
            转义文本 + 转义字节 = 转义文本;
        } 否则 {
            (内容, 索引, 1)子串 = 字;
            转义文本 + 字 = 转义文本;
        }
        索引 + 1 = 索引;
    }
    "\"" + 转义文本 + "\"" = 结果;
}

// ────────────────────────────────────────────
// IR 发射基础设施助手 (IR Emission Infrastructure Helpers)
// ────────────────────────────────────────────

// 字节 → \HH（大写十六进制）
函数 (码:整数)字节转义(0 = 结果:字符串) {
    "0123456789ABCDEF" = 十六进制表;
    (十六进制表, 码 / 16, 1)子串 = 高字;
    (十六进制表, 码 % 16, 1)子串 = 低字;
    "\\" + 高字 = 结果;
    结果 + 低字 = 结果;
}

// 码点 → UTF-8 字节转义串（纯加减乘除/取余，日月语言无位运算）
函数 (码:整数)转UTF8字节转义(0 = 结果:字符串) {
    "" = 结果;
    如果 (码 < 128) {
        (码)字节转义 = 结果;
    } 否则如果 (码 < 2048) {
        (192 + (码 / 64))字节转义 = 字节0文本;
        (128 + (码 % 64))字节转义 = 字节1文本;
        字节0文本 + 字节1文本 = 结果;
    } 否则如果 (码 < 65536) {
        (224 + (码 / 4096))字节转义 = 字节0文本;
        (128 + ((码 / 64) % 64))字节转义 = 字节1文本;
        (128 + (码 % 64))字节转义 = 字节2文本;
        字节0文本 + 字节1文本 = 字节0_1;
        字节0_1 + 字节2文本 = 结果;
    } 否则 {
        (240 + (码 / 262144))字节转义 = 字节0文本;
        (128 + ((码 / 4096) % 64))字节转义 = 字节1文本;
        (128 + ((码 / 64) % 64))字节转义 = 字节2文本;
        (128 + (码 % 64))字节转义 = 字节3文本;
        字节0文本 + 字节1文本 = 字节0_1;
        字节0_1 + 字节2文本 = 字节0_1_2;
        字节0_1_2 + 字节3文本 = 结果;
    }
}

// 标识符 → 原样直通（裸中文/ASCII 名；前缀 @/% 由调用方添加）
函数 (名:字符串)转义标识符(0 = 结果:字符串) {
    名 = 结果;
}

// 字符串表行转义（\n → "\\n"、\t → "\\t"、\ → "\\\\"）
函数 (内容:字符串)表转义(0 = 结果:字符串) {
    "" = 结果;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 10) { 结果 + "\\n" = 结果; }
        否则如果 (码 ?= 9) { 结果 + "\\t" = 结果; }
        否则如果 (码 ?= 92) { 结果 + "\\\\" = 结果; }
        否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
        索引 + 1 = 索引;
    }
}

// 字符串表行还原（"\\n" → 换行、"\\t" → 制表、"\\\\" → \）
函数 (内容:字符串)表还原(0 = 结果:字符串) {
    "" = 结果;
    (内容)长度 = 值长;
    0 = 索引;
    当 (索引 < 值长) {
        (内容, 索引)字符码 = 码;
        如果 (码 ?= 92) {
            如果 (索引 + 1 < 值长) {
                (内容, 索引 + 1)字符码 = 下码;
                如果 (下码 ?= 110) { 结果 + "\n" = 结果; 索引 + 1 = 索引; }
                否则如果 (下码 ?= 116) { 结果 + "\t" = 结果; 索引 + 1 = 索引; }
                否则如果 (下码 ?= 92) { 结果 + "\\" = 结果; 索引 + 1 = 索引; }
                否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
            } 否则 { (内容, 索引, 1)子串 = 字; 结果 + 字 = 结果; }
        } 否则 {
            (内容, 索引, 1)子串 = 字;
            结果 + 字 = 结果;
        }
        索引 + 1 = 索引;
    }
}

// 字符串字面量入表，返回 @N
函数 (内容:字符串)存字符串常量(0 = 结果:字符串) {
    (内容)表转义 = 转义内容;
    字符串表 + 转义内容 = 字符串表;
    字符串表 + "\n" = 字符串表;
    "@" + (字符串计数)转字符串 = 结果;
    字符串计数 + 1 = 字符串计数;
}

// 新临时寄存器 %tmpN
函数 新寄存器(0 = 结果:字符串) {
    寄存器计数 + 1 = 寄存器计数;
    "%tmp" + (寄存器计数)转字符串 = 结果;
}

// 新标签 L1 / L2 / ...
函数 新标签(0 = 结果:字符串) {
    标签计数 + 1 = 标签计数;
    "L" + (标签计数)转字符串 = 结果;
}

// 退出标签栈
函数 (标签:字符串)压退出栈 {
    退出标签栈 + 标签 = 退出标签栈;
    退出标签栈 + "\n" = 退出标签栈;
}

函数 弹退出栈 {
    (退出标签栈)分割行数 = 行数;
    如果 (行数 ?= 0 || 行数 ?= 1) {
        "" = 退出标签栈;
    } 否则 {
        "" = 新栈;
        0 = 索引;
        当 (索引 < 行数 - 1) {
            (退出标签栈, 索引)获取行 = 行;
            新栈 + 行 = 新栈;
            新栈 + "\n" = 新栈;
            索引 + 1 = 索引;
        }
        新栈 = 退出标签栈;
    }
}

函数 查退出栈(0 = 结果:字符串) {
    (退出标签栈)分割行数 = 行数;
    如果 (行数 ?= 0) { "" = 结果; }
    否则 { (退出标签栈, 行数 - 1)获取行 = 结果; }
}

// 继续标签栈
函数 (标签:字符串)压继续栈 {
    继续标签栈 + 标签 = 继续标签栈;
    继续标签栈 + "\n" = 继续标签栈;
}

函数 弹继续栈 {
    (继续标签栈)分割行数 = 行数;
    如果 (行数 ?= 0 || 行数 ?= 1) {
        "" = 继续标签栈;
    } 否则 {
        "" = 新栈;
        0 = 索引;
        当 (索引 < 行数 - 1) {
            (继续标签栈, 索引)获取行 = 行;
            新栈 + 行 = 新栈;
            新栈 + "\n" = 新栈;
            索引 + 1 = 索引;
        }
        新栈 = 继续标签栈;
    }
}

函数 查继续栈(0 = 结果:字符串) {
    (继续标签栈)分割行数 = 行数;
    如果 (行数 ?= 0) { "" = 结果; }
    否则 { (继续标签栈, 行数 - 1)获取行 = 结果; }
}

