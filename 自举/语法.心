            ()下一个标记;   // ;
        }
    } 否则如果 (标记值 ?= "+=" || 标记值 ?= "-=" || 标记值 ?= "*=" || 标记值 ?= "/=") {
        // 复合赋值「目标 op= 值」：解析表达式 已把目标读入 表达式C 并把目标地址写入 地址
        标记值 = 操作符;
        地址 = 目标地址;
        ()下一个标记;             // 消费运算符
        ()解析表达式;             // 右侧值 → 表达式C
        ()新寄存器 = 加载临时;
        ("  " + 加载临时 + " = 加载 i32, ptr " + 目标地址 + ", align 4")发射;
        ()新寄存器 = 运算临时;
        如果 (操作符 ?= "+=") { ("  " + 运算临时 + " = 加 i32 " + 加载临时 + ", " + 表达式C)发射; }
        否则如果 (操作符 ?= "-=") { ("  " + 运算临时 + " = 减 i32 " + 加载临时 + ", " + 表达式C)发射; }
        否则如果 (操作符 ?= "*=") { ("  " + 运算临时 + " = 乘 i32 " + 加载临时 + ", " + 表达式C)发射; }
        否则 { ("  " + 运算临时 + " = 有符号除 i32 " + 加载临时 + ", " + 表达式C)发射; }
        ("存储 i32 " + 运算临时 + ", ptr " + 目标地址 + ", align 4")发射;
        ()下一个标记;   // ;
    } 否则 {
        // 调用语句：调用指令已在解析表达式时发射
        ()下一个标记;   // ;
    }
}

// 发射 if / else if / else 链（IR 标签与分支版）
函数 (合并标签:字符串, 是否递归:整数)发射如果链 {
    ()下一个标记;   // 如果/否则如果
    ()下一个标记;   // (
    ()解析表达式;
    ()下一个标记;   // )
    ()发射条件;
    ()新标签 = 真标签;
    ()新标签 = 假标签;
    ("分支 i1 " + 当前条件 + ", 标签 %" + 真标签 + ", 标签 %" + 假标签)发射终结;
    (真标签)发射标签;
    ()下一个标记;   // {
    ()发射函数体;
    ()下一个标记;   // }
    ("分支 标签 %" + 合并标签)发射终结;
    (假标签)发射标签;
    如果 (标记值 ?= "否则如果") {
        (合并标签, 1)发射如果链;
    } 否则如果 (标记值 ?= "否则") {
        ()下一个标记;   // 否则
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("分支 标签 %" + 合并标签)发射终结;
    } 否则 {
        ("分支 标签 %" + 合并标签)发射终结;
    }
    如果 (是否递归 ?= 0) {
        (合并标签)发射标签;
    }
}

// ────────────────────────────────────────────
// 函数定义 (Function Definitions)
// ────────────────────────────────────────────

// 解析函数签名（当前标记在 函数 关键字）
// 产出: 原型名/输入参数IR/输入参数表/输出参数表/返回类型名/输出参数名
函数 解析函数签名 {
    ()下一个标记;   // 函数
    "" = 数组表;   // 每个函数的数组变量表独立重置
    "" = 输入参数IR;
    "" = 输入参数表;
    "" = 返回类型名;
    "" = 输出参数名;
    "" = 局部类型表;
    "" = 已声明表;
    如果 (标记值 ?= "(") {
        // 输入参数列表在前
        ()下一个标记;
        "" = 输入参数IR;
        "" = 输入参数表;
        如果 (标记值 ?= ")") {
            "" = 输入参数IR;
            "" = 输入参数表;
        } 否则 {
            当 (真) {
                标记值 = 参数名;
                ()下一个标记;
                "" = 类型名;
                如果 (标记值 ?= ":") {
                    ()下一个标记;
                    标记值 = 类型名;
                    ()下一个标记;
                } 否则 {
                    "整数" = 类型名;
                }
                // 记录参数类型到局部表
                如果 (类型名 ?= "整数") { (参数名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (参数名, "S")局部表添加; }
                否则如果 (类型名 ?= "函数") { (参数名, "C")局部表添加; }
                否则 { (参数名, "F")局部表添加; }
                // 记录到已声明表（参数由函数签名声明）
                (已声明表, 参数名, "X")表添加 = 已声明表;
                // 收集 IR 参数（头部参数列表 + 名:I 行）
                如果 (类型名 ?= "整数") { "i32" = 参数类型IR; (输入参数表, 参数名, "I")表添加 = 输入参数表; }
                否则如果 (类型名 ?= "字符串") { "ptr" = 参数类型IR; (输入参数表, 参数名, "S")表添加 = 输入参数表; }
                否则如果 (类型名 ?= "函数") { "ptr" = 参数类型IR; (输入参数表, 参数名, "C")表添加 = 输入参数表; }
                否则 { "double" = 参数类型IR; (输入参数表, 参数名, "F")表添加 = 输入参数表; }
                (参数名 + "_in")转义标识符 = 参数转义;
                如果 (输入参数IR ?= "") {
                    参数类型IR + " %" = 输入参数IR;
                } 否则 {
                    输入参数IR + ", " = 输入参数IR;
                    输入参数IR + 参数类型IR = 输入参数IR;
                    输入参数IR + " %" = 输入参数IR;
                }
                输入参数IR + 参数转义 = 输入参数IR;
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
        如果 (标记值 ?= "(" || 标记值 ?= "{") {
            "" = 原型名;   // 匿名函数：无名字
        } 否则 {
            标记值 = 原型名;
            ()下一个标记;
        }
    } 否则 {
        // 函数名在前
        标记值 = 原型名;
        ()下一个标记;
    }
    // 输出参数列表
    "" = 输出参数表;
    "" = 返回类型名;
    如果 (标记值 ?= "(") {
        ()下一个标记;
        如果 (标记值 ?= ")") {
            "" = 输出参数表;
        } 否则 {
            当 (真) {
                 // "0 = 名:类型"
                 如果 (标记类型 ?= 1) { ()下一个标记; }
                 如果 (标记值 ?= "=") { ()下一个标记; }
                 标记值 = 输出名;
                 ()下一个标记;
                 "" = 类型名;
                 如果 (标记值 ?= ":") {
                     ()下一个标记;
                     标记值 = 类型名;
                     ()下一个标记;
                 } 否则 {
                     "整数" = 类型名;
                 }
                // 记录返回类型（第一个输出参数）
                如果 (返回类型名 ?= "") {
                    "" = 返回类型名;
                    类型名 = 返回类型名;
                }
                // 记录输出参数名（第一个输出参数）
                如果 (输出参数名 ?= "") {
                    输出名 = 输出参数名;
                }
                // 记录输出参数类型到局部表
                如果 (类型名 ?= "整数") { (输出名, "I")局部表添加; }
                否则如果 (类型名 ?= "字符串") { (输出名, "S")局部表添加; }
                否则 { (输出名, "F")局部表添加; }
                // 记录到已声明表（输出参数由函数签名声明）
                (已声明表, 输出名, "X")表添加 = 已声明表;
                // 收集输出参数表（名:码 行）
                如果 (类型名 ?= "整数") { (输出参数表, 输出名, "I")表添加 = 输出参数表; }
                否则如果 (类型名 ?= "字符串") { (输出参数表, 输出名, "S")表添加 = 输出参数表; }
                否则 { (输出参数表, 输出名, "F")表添加 = 输出参数表; }
                如果 (标记值 ?= ",") { ()下一个标记; }
                否则 { 中断; }
            }
        }
        ()下一个标记;   // )
    }
}

// 收集函数原型（第一遍）
函数 收集函数原型 {
    ()解析函数签名;
    // 不发射声明：LLVM 模块级符号允许前向引用，用户函数均在第二遍以 `定义 内部` 定义；
    // 而 llvm-as 不允许为 `内部` 链接的函数写 `声明`（invalid linkage for function declaration）。
    // 记录函数返回类型
    如果 (返回类型名 ?= "字符串") { (原型名, "S")函数返回表添加; }
    否则如果 (返回类型名 ?= "整数") { (原型名, "I")函数返回表添加; }
    // 跳到代码块
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "{") {
            ()跳过代码块;
            ()下一个标记;   // 消费 }
            中断;
        }
        ()下一个标记;
    }
}

// 发射输出参数的 alloca + 零初始化
函数 发射输出参数声明 {
    0 = 索引;
    (输出参数表)分割行数 = 行数;
    当 (索引 < 行数) {
        (输出参数表, 索引)获取行 = 行;
        (行)提取行名 = 输出名;
        (行)提取行码 = 输出码;
        (输出名)转义标识符 = 输出转义;
        如果 (输出码 ?= "S") {
            ("%" + 输出转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr null, ptr %" + 输出转义 + ", align 8")发射;
        } 否则如果 (输出码 ?= "C") {
            ("%" + 输出转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr null, ptr %" + 输出转义 + ", align 8")发射;
        } 否则如果 (输出码 ?= "F") {
            ("%" + 输出转义 + " = 分配 double, align 8")发射;
            ("存储 double 0.000000e+00, ptr %" + 输出转义 + ", align 8")发射;
        } 否则 {
            ("%" + 输出转义 + " = 分配 i32, align 4")发射;
            ("存储 i32 0, ptr %" + 输出转义 + ", align 4")发射;
        }
        索引 + 1 = 索引;
    }
}

// 发射输入参数复制（参数 %名_in → alloca %名）
函数 发射输入参数复制 {
    0 = 索引;
    (输入参数表)分割行数 = 行数;
    当 (索引 < 行数) {
        (输入参数表, 索引)获取行 = 行;
        (行)提取行名 = 参数名;
        (行)提取行码 = 参数码;
        (参数名)转义标识符 = 参数转义;
        (参数名 + "_in")转义标识符 = 参数入转义;
        如果 (参数码 ?= "S") {
            ("%" + 参数转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则如果 (参数码 ?= "C") {
            ("%" + 参数转义 + " = 分配 ptr, align 8")发射;
            ("存储 ptr %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则如果 (参数码 ?= "F") {
            ("%" + 参数转义 + " = 分配 double, align 8")发射;
            ("存储 double %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 8")发射;
        } 否则 {
            ("%" + 参数转义 + " = 分配 i32, align 4")发射;
            ("存储 i32 %" + 参数入转义 + ", ptr %" + 参数转义 + ", align 4")发射;
        }
        索引 + 1 = 索引;
    }
}

// 发射局部变量声明（函数内新局部变量，跳过已由签名/输出声明声明的）
函数 发射局部声明 {
    0 = 索引;
    (局部类型表)分割行数 = 行数;
    当 (索引 < 行数) {
        (局部类型表, 索引)获取行 = 行;
        // 提取名（: 之前字符）
        (行)长度 = 行长;
        0 = 位置;
        "" = 局部名;
        当 (位置 < 行长) {
            (行, 位置, 1)子串 = 字;
            如果 (字 ?= ":") { 位置 = 行长; }
            否则 {
                局部名 + 字 = 局部名;
                位置 + 1 = 位置;
            }
        }
        // 提取类型码（必须在遍历 已声明表 之前，因为 获取行 共享静态缓冲区会覆盖 行）
        (局部名)长度 = 类型码长;
        (行, 类型码长 + 1, 1)子串 = 提取类型码;
        // 跳过已声明（参数/输出）：遍历 已声明表
        0 = 索引2;
        (已声明表)分割行数 = 声明行数;
        0 = 已声明命中;
        当 (索引2 < 声明行数) {
            (已声明表, 索引2)获取行 = 声明行;
            (声明行, 局部名 + ":")字符串开头 = 已声明命中;
            如果 (已声明命中 ?= 1) { 索引2 = 声明行数; }
            否则 { 索引2 + 1 = 索引2; }
        }
        如果 (已声明命中 ?= 0) {
            (局部名)转义标识符 = 局部转义;
            如果 (提取类型码 ?= "S") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "C") { ("%" + 局部转义 + " = 分配 ptr, align 8")发射; }
            否则如果 (提取类型码 ?= "F") { ("%" + 局部转义 + " = 分配 double, align 8")发射; }
             否则如果 (提取类型码 ?= "A") {
                 (局部名)查数组大小 = 数组大小文本;
                 (局部名)查数组元素码 = 数组元素码;
                 (数组元素码)数组元素转IR = 数组元素IR;
                 (数组元素码)数组对齐 = 数组对齐值;
                 ("%" + 局部转义 + " = 分配 [" + 数组大小文本 + " x " + 数组元素IR + "], align " + 数组对齐值)发射;
             }
             否则如果 (提取类型码 ?= "O") {
                 // 结构体变量：存放指向结构体的指针
                 ("%" + 局部转义 + " = 分配 ptr, align 8")发射;
             }
             否则如果 (提取类型码 ?= "M") {
                 // 映射变量：存放指向映射全局的指针
                 ("%" + 局部转义 + " = 分配 ptr, align 8")发射;
             }
             否则如果 (提取类型码 ?= "T") {
                 // 元组变量：存放指向元组结构体的指针
                 ("%" + 局部转义 + " = 分配 ptr, align 8")发射;
             }
             否则 { ("%" + 局部转义 + " = 分配 i32, align 4")发射; }
        }
        索引 + 1 = 索引;
    }
}

// 发射函数定义（第二遍）
函数 发射函数定义 {
    ()解析函数签名;
    "" = 返回类型IR;
    如果 (返回类型名 ?= "整数") { "i32" = 返回类型IR; }
    否则如果 (返回类型名 ?= "字符串") { "ptr" = 返回类型IR; }
    否则如果 (返回类型名 ?= "浮点") { "double" = 返回类型IR; }
    否则 { "void" = 返回类型IR; }
    (原型名)转义标识符 = 原型转义;
    0 = 已终结;
    1 = 缓冲模式;
    "" = 函数体C;
    ()下一个标记;   // {
    ()发射函数体;
    0 = 缓冲模式;
    ()下一个标记;   // }
    ("定义 内部 " + 返回类型IR + " @" + 原型转义 + "(" + 输入参数IR + ") {")发射;
    ("entry:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    (函数体C)发射;
    如果 (已终结 ?= 1) {
        // 当前块已终结，无需再追加返回
    } 否则如果 (返回类型名 ?= "") {
        ("返回 void")发射;
    } 否则 {
        (输出参数名)取地址 = 返回地址;
        ()新寄存器 = 返回加载;
        ("  " + 返回加载 + " = 加载 " + 返回类型IR + ", ptr " + 返回地址 + ", align 4")发射;
        ("  返回 " + 返回类型IR + " " + 返回加载)发射;
    }
    ("}")发射;
}

// ────────────────────────────────────────────
// 两遍扫描 (Two Passes)
// ────────────────────────────────────────────

// 生成元组字面量的 IR： 匿名结构体 alloca + 逐元素 store
函数 生成元组 {
    元组_构建 = 元组_R构建;      // 累积值列表 → 快照
    元组_成员构建 = 元组_R成员;
    元组_类型体 = 元组_R类型;
    元组_计数 = 元组_R计数;
    ()新寄存器 = 元组_实例;
    ("  " + 元组_实例 + " = 分配 {" + 元组_R类型 + "}, align 8")发射;
    0 = 元组_索引;
    当 (元组_索引 < 元组_R计数) {
        (元组_R构建, 元组_索引)获取行 = 元组_值;
        (元组_值)长度 = 元组_长度;
        (元组_值, 0, 元组_长度)子串 = 元组_值;
        (元组_R成员, 元组_索引)获取行 = 元组_元素IR;
        (元组_索引)转字符串 = 元组_行;
        ()新寄存器 = 元素指针;
        ("  " + 元素指针 + " = 获取元素指针 {" + 元组_R类型 + "}, ptr " + 元组_实例 + ", i32 0, i32 " + 元组_行)发射;
        ("  存储 " + 元组_元素IR + " " + 元组_值 + ", ptr " + 元素指针 + ", align 8")发射;
        元组_索引 + 1 = 元组_索引;
    }
    元组_实例 = 表达式C;
    "元组" = 表达式类型;
}

// 收集枚举定义： 枚举 名 { 成员[, 成员=整数] }  → 登记 枚举_成员表（键 枚举名::成员名）
函数 收集枚举定义 {
    ()下一个标记;              // 跳过 枚举 → 名
    标记值 = 枚举_名;
    ()下一个标记;              // 名 → {
    ()下一个标记;              // { → 第一个成员名 或 }
    0 = 枚举_值;
    当 (真) {
        如果 (标记值 ?= "}") { 中断; }
        标记值 = 枚举_成员名;
        ()下一个标记;          // 成员名 → , 或 = 或 }
        如果 (标记值 ?= "=") {
            ()下一个标记;       // 值
            标记值 = 枚举_值文本;
            (枚举_值文本)转整数 = 枚举_值;
            ()下一个标记;       // 数字 → , 或 }
        } 否则 {
            (枚举_值)转字符串 = 枚举_值文本;
        }
        枚举_名 + "::" = 枚举_行;
        枚举_行 + 枚举_成员名 = 枚举_行;
        (枚举_成员表, 枚举_行, 枚举_值文本)表添加 = 枚举_成员表;
        枚举_值 + 1 = 枚举_值;
        如果 (标记值 ?= ",") { ()下一个标记; }
        否则 { 中断; }
    }
    ()下一个标记;              // 跳过 } → 下一顶层标记
}

// 收集结构体定义： 结构体 名 { 成员名: 类型名; ... }  → 登记 结构体_成员表/结构体_大小表/结构体_类型表
函数 收集结构体定义 {
    ()下一个标记;           // 跳过 结构体 关键字 → 标记值 = 名称
    标记值 = 当前结构体名;   // 当前结构体名 := 名称
    // 立即登记自身名称（占位），使自引用成员类型（如 子: 节点[N]）解析为 ptr
    (结构体_大小表, 当前结构体名, "0")表添加 = 结构体_大小表;
    ()下一个标记;           // 跳过 名称 → 标记值 = {
    ()下一个标记;           // 跳过 { → 标记值 = 第一个成员名
    "" = 结构体类型体;
    0 = 结构体成员计数;
    当 (真) {
        如果 (标记值 ?= "}") { 中断; }
        标记值 = 结构体成员名;
        ()下一个标记;        // 跳过 成员名 → 标记值 = :
        ()下一个标记;        // 跳过 : → 标记值 = 类型名
        标记值 = 结构体成员类型;
        ()下一个标记;        // 跳过 类型名 → 标记值 = ; 或 [
        如果 (标记值 ?= "[") {
            // 数组成员： 类型名[size]
            ()下一个标记;        // [
            标记值 = 结构体大小;   // 大小文本
            ()下一个标记;        // 数字
            ()下一个标记;        // ]
            如果 (结构体成员类型 ?= "浮点") { "F" = 结构体元素码; }
            否则如果 (结构体成员类型 ?= "字符串") { "S" = 结构体元素码; }
            否则如果 (结构体成员类型 ?= "整数") { "I" = 结构体元素码; }
            否则 { "O" = 结构体元素码; }   // 结构体元素 → ptr
            当前结构体名 + ":" = 链式地址;
            链式地址 + 结构体成员名 = 链式地址;
            结构体元素码 + ":" = 保存存储值;
            保存存储值 + 结构体大小 = 保存存储值;
            (结构体_数组表, 链式地址, 保存存储值)表添加 = 结构体_数组表;
            "数组" = 结构体成员类型;
        }
        ()下一个标记;        // 跳过 ; → 标记值 = 下一个成员名 或 }
        (结构体成员类型)结构体成员类型转IR = 结构体成员IR;
        如果 (结构体成员计数 ?= 0) {
            结构体成员IR = 结构体类型体;
        } 否则 {
            结构体类型体 + ", " = 结构体类型体;
            结构体类型体 + 结构体成员IR = 结构体类型体;
        }
        // 登记成员: 结构体_成员表 += 当前结构体名:成员名 → 索引:类型名
        当前结构体名 + ":" = 链式地址;
        链式地址 + 结构体成员名 = 链式地址;
        (结构体成员计数)转字符串 = 保存存储值;
        保存存储值 + ":" = 保存存储值;
        保存存储值 + 结构体成员类型 = 保存存储值;
        (结构体_成员表, 链式地址, 保存存储值)表添加 = 结构体_成员表;
        结构体成员计数 + 1 = 结构体成员计数;
    }
    ()下一个标记;           // 跳过 } → 下一顶层标记
    // 登记: 结构体_大小表 += 当前结构体名 → 成员数；结构体_类型表 += 当前结构体名 → {类型体}
    (结构体成员计数)转字符串 = 保存存储值;
    (结构体_大小表, 当前结构体名, 保存存储值)表替换 = 结构体_大小表;
    "{" + 结构体类型体 = 保存存储值;
    保存存储值 + "}" = 保存存储值;
    (结构体_类型表, 当前结构体名, 保存存储值)表添加 = 结构体_类型表;
}

// 第一遍：收集全局变量与函数原型
函数 第一遍 {
    0 = 源位置;
    ()下一个标记;
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "函数") {
            ()收集函数原型;
         } 否则如果 (标记值 ?= "结构体") {
            ()收集结构体定义;
        } 否则如果 (标记值 ?= "枚举") {
            ()收集枚举定义;
        } 否则 {
            // 尝试全局声明: 值 = 变量 名 ;
            标记类型 = 保存标记类型;
            标记值 = 保存标记值;
            ()下一个标记;
            如果 (标记值 ?= "=") {
                ()下一个标记;
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                    标记值 = 全局名;
                    ()下一个标记;
                    // 发射全局声明（IR 版）
                    如果 (保存标记类型 ?= 1) {
                        (全局名)转义标识符 = 全局转义;
                        ("@" + 全局转义 + " = 内部 全局 i32 " + 保存标记值)发射;
                        (全局名, "I")全局表添加;
                    } 否则如果 (保存标记类型 ?= 5) {
                        (全局名)转义标识符 = 全局转义;
                        ("@" + 全局转义 + " = 内部 全局 double " + 保存标记值)发射;
                        (全局名, "F")全局表添加;
                    } 否则 {
                        (保存标记值)存字符串常量 = 字符串号;
                        (全局名)转义标识符 = 全局转义;
                        ("@" + 全局转义 + " = 内部 全局 ptr " + 字符串号)发射;
                        (全局名, "S")全局表添加;
                    }
                    ()下一个标记;   // ;
                } 否则 {
                    ()跳到分号;
                }
            } 否则 {
                ()跳到分号;
            }
        }
    }
}

// 第二遍：发射函数体
函数 第二遍 {
    0 = 源位置;
    ()下一个标记;
    // 先发射全部结构体类型定义： %名 = type { ... }
    (结构体_大小表)分割行数 = 结构体行数;
    0 = 结构体遍历索引;
    当 (结构体遍历索引 < 结构体行数) {
        (结构体_大小表, 结构体遍历索引)获取行 = 结构体遍历行;
        (结构体遍历行)提取行名 = 结构体类型名;
        (结构体_类型表, 结构体类型名)查表值 = 结构体类型体;
        ("%" + 结构体类型名 + " = type " + 结构体类型体)发射;
        结构体遍历索引 + 1 = 结构体遍历索引;
    }
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "函数") {
            ()发射函数定义;
        } 否则如果 (标记值 ?= "结构体") {
            // 结构体类型已在第二遍开头发射，这里仅跳过源码
            ()下一个标记;        // 跳过 结构体
            ()下一个标记;        // 跳过 名称
            ()下一个标记;        // 跳过 {
            当 (真) {
                如果 (标记值 ?= "}") { 中断; }
                ()跳过表达式;
                ()下一个标记;
            }
            ()下一个标记;        // 跳过 }
        } 否则如果 (标记值 ?= "枚举") {
            // 枚举定义已在第一遍收集，第二遍仅跳过源码
            ()下一个标记;        // 跳过 枚举
            ()下一个标记;        // 跳过 名称
            ()下一个标记;        // 跳过 {
            当 (真) {
                如果 (标记值 ?= "}") { 中断; }
                ()下一个标记;
            }
            ()下一个标记;        // 跳过 }
        } 否则 {
            // 跳过全局声明（已发射）
            ()跳过表达式;
            ()下一个标记;
            如果 (标记值 ?= "=") {
                ()下一个标记;
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                }
                ()下一个标记;
            } 否则 {
                如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
                    ()下一个标记;
                    ()下一个标记;
                }
            }
        }
    }
}

// ────────────────────────────────────────────
// 闭包 (Closures)：匿名函数 = 内部函数 + 捕获变量（按引用，隐藏 ptr 参数）
// ────────────────────────────────────────────

函数 解析闭包 {
    局部类型表 = 保存局部类型表;
    函数体C = 保存函数体C;
    输入参数表 = 保存输入参数表;
    输出参数表 = 保存输出参数表;
    已声明表 = 保存已声明表;
    输入参数IR = 保存输入参数IR;
    返回类型名 = 保存返回类型名;
    输出参数名 = 保存输出参数名;
    原型名 = 保存原型名;
    已终结 = 保存已终结;
    ()解析函数签名;               // 止于 { ；原型名 = ""
    闭包计数 + 1 = 闭包计数;
    "闭包" + (闭包计数)转字符串 = 闭包名;
    (闭包名)转义标识符 = 闭包转义;
    源位置 = 体开始位置;
    "" = 闭包捕获参数;
    ()下一个标记;                 // 进入函数体
    1 = 体深度;
    当 (体深度 > 0) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记值 ?= "{") { 体深度 + 1 = 体深度; }
        否则如果 (标记值 ?= "}") { 体深度 - 1 = 体深度; }
        否则如果 (标记类型 ?= 2) {
            标记值 = 捕获名;
            (已声明表, 捕获名)在表 = 已声明;
            如果 (已声明 ?= 0) {
                (保存局部类型表, 捕获名)查表值 = 捕获码;
                如果 (捕获码 ?= "") { "无" = 忽略名; }
                否则 {
                    (捕获名, 捕获码)局部表添加;
                    (已声明表, 捕获名, 捕获码)表添加 = 已声明表;
                    (捕获名)转义标识符 = 捕获转义;
                    如果 (输入参数IR ?= "" && 闭包捕获参数 ?= "") {
                        "ptr %" + 捕获转义 = 闭包捕获参数;
                    } 否则 {
                        闭包捕获参数 + ", ptr %" = 闭包捕获参数;
                        闭包捕获参数 + 捕获转义 = 闭包捕获参数;
                    }
                    (闭包捕获表, 闭包名, 捕获名)表添加 = 闭包捕获表;
                }
            }
        }
        ()下一个标记;
    }
    体开始位置 = 源位置;
    ()下一个标记;                 // 回退到函数体首标记
    0 = 已终结;
    "" = 函数体C;
    ()发射函数体;
    ()下一个标记;                 // 过 }
    函数体C = 闭包体;             // 保存体 IR
    如果 (返回类型名 ?= "") { "void" = 闭包返回IR; }
    否则 { (返回类型名)类型转IR = 闭包返回IR; }
    "" = 函数体C;
    ("定义 内部 " + 闭包返回IR + " @" + 闭包转义 + "(" + 输入参数IR + 闭包捕获参数 + ") {")发射;
    ("entry:")发射;
    ()发射输出参数声明;
    ()发射输入参数复制;
    ()发射局部声明;
    函数体C + 闭包体 = 函数体C;
    如果 (已终结 ?= 1) {
        "无" = 忽略终结;
    } 否则如果 (返回类型名 ?= "") {
        ("返回 void")发射;
    } 否则 {
        (输出参数名)取地址 = 闭包返回地址;
        ()新寄存器 = 闭包返回加载;
        ("  " + 闭包返回加载 + " = 加载 " + 闭包返回IR + ", ptr " + 闭包返回地址 + ", align 4")发射;
        ("  返回 " + 闭包返回IR + " " + 闭包返回加载)发射;
    }
    ("}")发射;
    闭包定义 + 函数体C = 闭包定义;
    (闭包函数表, 闭包名, 闭包名)表添加 = 闭包函数表;
    (闭包返回表, 闭包名, 闭包返回IR)表添加 = 闭包返回表;
    "@" + 闭包名 = 表达式C;
    "函数" = 表达式类型;
    保存函数体C = 函数体C;
    保存局部类型表 = 局部类型表;
    保存输入参数表 = 输入参数表;
    保存输出参数表 = 输出参数表;
    保存已声明表 = 已声明表;
    保存输入参数IR = 输入参数IR;
    保存返回类型名 = 返回类型名;
    保存输出参数名 = 输出参数名;
    保存原型名 = 原型名;
    保存已终结 = 已终结;
}
