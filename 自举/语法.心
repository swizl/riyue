// ============================================
// 日月编译器 — 自举源码 (compiler.心) v3
// 将 日月 源码翻译为 中文 LLVM IR 文本
//
// 用法:  compiler.exe 输入.心 输出.ll
// 输出的 .ll 由 llvm-as + llc + ld.lld 配合 运行时辅助.o 链接为可执行（见 Makefile 自举 目标）。
// ============================================
//
// 语法模块：表达式/语句/函数定义解析（是表达式结束/跳过表达式/跳过代码块/跳到分号/解析表达式/解析或/解析与/解析比较/解析加减/解析乘除/解析一元/解析原子/解析括号或调用/发射函数体/解析并发射语句/发射表达式语句/发射如果链/解析函数签名/收集函数原型/发射输出参数声明/发射输入参数复制/发射局部声明/发射函数定义/第一遍/第二遍/解析闭包）
// 由 自举/编译器.心 导入 展开（拆分自 编译器.心，函数体未改动）
//

// ────────────────────────────────────────────
// 语法工具 (Parse Helpers)
// ────────────────────────────────────────────

函数 是表达式结束(0 = 结果:整数) {
    0 = 结果;
    如果 (标记类型 ?= 4) {
        如果 (标记值 ?= ";" || 标记值 ?= "," || 标记值 ?= ")" || 标记值 ?= "]" || 标记值 ?= "}" || 标记值 ?= "{") { 1 = 结果; }
    }
}

// 跳过表达式（含嵌套括号/方括号/调用）
函数 跳过表达式 {
    0 = 括号深度;
    0 = 方括号深度;
    当 (真) {
        ()是表达式结束 = 是结束结果;
        如果 (是结束结果 ?= 1 && 括号深度 ?= 0 && 方括号深度 ?= 0) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "(") {
                括号深度 + 1 = 括号深度;
            } 否则如果 (标记值 ?= ")") {
                如果 (括号深度 > 0) { 括号深度 - 1 = 括号深度; }
            } 否则如果 (标记值 ?= "[") {
                方括号深度 + 1 = 方括号深度;
            } 否则如果 (标记值 ?= "]") {
                如果 (方括号深度 > 0) { 方括号深度 - 1 = 方括号深度; }
            }
        }
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
    }
}

// 跳过代码块 { ... }（不含开头 {）
函数 跳过代码块 {
    1 = 块深度;
    当 (真) {
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "{") {
                块深度 + 1 = 块深度;
            } 否则如果 (标记值 ?= "}") {
                如果 (块深度 > 0) { 块深度 - 1 = 块深度; }
                如果 (块深度 ?= 0) { 中断; }
            }
        }
    }
}

// 跳到语句末尾（分号后）
函数 跳到分号 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4 && 标记值 ?= ";") { ()下一个标记; 中断; }
        ()下一个标记;
    }
}

// ────────────────────────────────────────────
// 表达式解析 (Expression Parser)
// 结果写入 表达式C/表达式类型
// ────────────────────────────────────────────

函数 解析表达式 {
    ()解析或;
}

函数 解析或 {
     ()解析与;
     当 (标记值 ?= "||") {
         表达式C = 左或;
         表达式类型 = 左或类型;
         ()下一个标记;
         ()解析与;
         表达式C = 右或;
         表达式类型 = 右或类型;
         ()新寄存器 = 左布尔;
         ("  " + 左布尔 + " = 整数比较 ne i32 " + 左或 + ", 0")发射;
         ()新寄存器 = 右布尔;
         ("  " + 右布尔 + " = 整数比较 ne i32 " + 右或 + ", 0")发射;
         ()新寄存器 = 或结果;
         ("  " + 或结果 + " = 或 i1 " + 左布尔 + ", " + 右布尔)发射;
         ()新寄存器 = 表达式C;
         ("  " + 表达式C + " = 零扩展 i1 " + 或结果 + " to i32")发射;
         "整数" = 表达式类型;
     }
}

函数 解析与 {
     ()解析比较;
     当 (标记值 ?= "&&") {
         表达式C = 左与;
         表达式类型 = 左与类型;
         ()下一个标记;
         ()解析比较;
         表达式C = 右与;
         表达式类型 = 右与类型;
         ()新寄存器 = 左布尔;
         ("  " + 左布尔 + " = 整数比较 ne i32 " + 左与 + ", 0")发射;
         ()新寄存器 = 右布尔;
         ("  " + 右布尔 + " = 整数比较 ne i32 " + 右与 + ", 0")发射;
         ()新寄存器 = 与结果;
         ("  " + 与结果 + " = 与 i1 " + 左布尔 + ", " + 右布尔)发射;
         ()新寄存器 = 表达式C;
         ("  " + 表达式C + " = 零扩展 i1 " + 与结果 + " to i32")发射;
         "整数" = 表达式类型;
     }
}

函数 解析比较 {
     ()解析加减;
     当 (标记值 ?= ">" || 标记值 ?= "<" || 标记值 ?= ">=" || 标记值 ?= "<=" || 标记值 ?= "==" || 标记值 ?= "!=" || 标记值 ?= "?=") {
         标记值 = 操作符;
         表达式C = 左比;
         表达式类型 = 左比类型;
         ()下一个标记;
         ()解析加减;
         表达式C = 右比;
         表达式类型 = 右比类型;
         如果 (左比类型 ?= "字符串" || 右比类型 ?= "字符串") {
             ()新寄存器 = 调用临时;
             ("  " + 调用临时 + " = 调用 i32 (ptr, ptr) @strcmp(ptr " + 左比 + ", ptr " + 右比 + ")")发射;
             ()新寄存器 = 比较临时;
             如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 调用临时 + ", 0")发射; }
             否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 调用临时 + ", 0")发射; }
             否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 调用临时 + ", 0")发射; }
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
             "整数" = 表达式类型;
         } 否则如果 (左比类型 ?= "浮点" || 右比类型 ?= "浮点") {
              (左比, 左比类型)提升浮点 = 左比提升;
              (右比, 右比类型)提升浮点 = 右比提升;
             ()新寄存器 = 比较临时;
             如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 浮点比较 oeq double " + 左比提升 + ", " + 右比提升)发射; }
             否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 浮点比较 une double " + 左比提升 + ", " + 右比提升)发射; }
             否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 浮点比较 ogt double " + 左比提升 + ", " + 右比提升)发射; }
             否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 浮点比较 olt double " + 左比提升 + ", " + 右比提升)发射; }
             否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 浮点比较 oge double " + 左比提升 + ", " + 右比提升)发射; }
             否则 { ("  " + 比较临时 + " = 浮点比较 ole double " + 左比提升 + ", " + 右比提升)发射; }
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
             "整数" = 表达式类型;
         } 否则 {
             ()新寄存器 = 比较临时;
             如果 (操作符 ?= "==" || 操作符 ?= "?=") { ("  " + 比较临时 + " = 整数比较 eq i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= "!=") { ("  " + 比较临时 + " = 整数比较 ne i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= ">") { ("  " + 比较临时 + " = 整数比较 sgt i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= "<") { ("  " + 比较临时 + " = 整数比较 slt i32 " + 左比 + ", " + 右比)发射; }
             否则如果 (操作符 ?= ">=") { ("  " + 比较临时 + " = 整数比较 sge i32 " + 左比 + ", " + 右比)发射; }
             否则 { ("  " + 比较临时 + " = 整数比较 sle i32 " + 左比 + ", " + 右比)发射; }
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
             "整数" = 表达式类型;
         }
     }
}

函数 解析加减 {
     ()解析乘除;
     当 (标记值 ?= "+" || 标记值 ?= "-") {
         标记值 = 操作符;
         表达式C = 左加;
         表达式类型 = 左加类型;
         ()下一个标记;
         ()解析乘除;
         表达式C = 右加;
         表达式类型 = 右加类型;
         如果 (操作符 ?= "+" && (左加类型 ?= "字符串" || 右加类型 ?= "字符串")) {
             ()新寄存器 = 表达式C;
             ("  " + 表达式C + " = 调用 ptr (ptr, ptr) @" + ("辅助拼接")转义标识符 + "(ptr " + 左加 + ", ptr " + 右加 + ")")发射;
             "字符串" = 表达式类型;
         } 否则如果 (左加类型 ?= "浮点" || 右加类型 ?= "浮点") {
              (左加, 左加类型)提升浮点 = 左加提升;
              (右加, 右加类型)提升浮点 = 右加提升;
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "+") { ("  " + 表达式C + " = 浮点加 double " + 左加提升 + ", " + 右加提升)发射; }
             否则 { ("  " + 表达式C + " = 浮点减 double " + 左加提升 + ", " + 右加提升)发射; }
             "浮点" = 表达式类型;
         } 否则 {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "+") { ("  " + 表达式C + " = 加 i32 " + 左加 + ", " + 右加)发射; }
             否则 { ("  " + 表达式C + " = 减 i32 " + 左加 + ", " + 右加)发射; }
             "整数" = 表达式类型;
         }
     }
}

函数 解析乘除 {
     ()解析一元;
     当 (标记值 ?= "*" || 标记值 ?= "/" || 标记值 ?= "%") {
         标记值 = 操作符;
         表达式C = 左乘;
         表达式类型 = 左乘类型;
         ()下一个标记;
         ()解析一元;
         表达式C = 右乘;
         表达式类型 = 右乘类型;
         如果 (左乘类型 ?= "浮点" || 右乘类型 ?= "浮点") {
              (左乘, 左乘类型)提升浮点 = 左乘提升;
              (右乘, 右乘类型)提升浮点 = 右乘提升;
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "*") { ("  " + 表达式C + " = 浮点乘 double " + 左乘提升 + ", " + 右乘提升)发射; }
             否则 { ("  " + 表达式C + " = 浮点除 double " + 左乘提升 + ", " + 右乘提升)发射; }
             "浮点" = 表达式类型;
         } 否则 {
             ()新寄存器 = 表达式C;
             如果 (操作符 ?= "*") { ("  " + 表达式C + " = 乘 i32 " + 左乘 + ", " + 右乘)发射; }
             否则如果 (操作符 ?= "/") { ("  " + 表达式C + " = 有符号除 i32 " + 左乘 + ", " + 右乘)发射; }
             否则 { ("  " + 表达式C + " = 有符号取余 i32 " + 左乘 + ", " + 右乘)发射; }
             "整数" = 表达式类型;
         }
     }
}

函数 解析一元 {
    如果 (标记类型 ?= 4 && 标记值 ?= "-") {
        ()下一个标记;
        ()解析一元;
        表达式C = 一元操作数;
        表达式类型 = 一元类型;
        如果 (一元类型 ?= "浮点") {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 浮点减 double 0.000000e+00, " + 一元操作数)发射;
            "浮点" = 表达式类型;
        } 否则 {
            ()新寄存器 = 表达式C;
            ("  " + 表达式C + " = 减 i32 0, " + 一元操作数)发射;
            "整数" = 表达式类型;
        }
    } 否则如果 (标记类型 ?= 4 && 标记值 ?= "!") {
        ()下一个标记;
        ()解析一元;
        表达式C = 一元操作数;
        ()新寄存器 = 比较临时;
        ("  " + 比较临时 + " = 整数比较 eq i32 " + 一元操作数 + ", 0")发射;
        ()新寄存器 = 表达式C;
        ("  " + 表达式C + " = 零扩展 i1 " + 比较临时 + " to i32")发射;
        "整数" = 表达式类型;
    } 否则 {
        ()解析原子;
    }
}

函数 解析原子 {
    如果 (标记类型 ?= 1) {
        // 整数数字字面量
        标记值 = 表达式C;
        "整数" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 5) {
        // 浮点数字字面量（原样发射十进制 double，llvm-as 接受）
        标记值 = 表达式C;
        "浮点" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 3) {
        // 字符串字面量
        (标记值)存字符串常量 = 表达式C;
        "字符串" = 表达式类型;
        ()下一个标记;
    } 否则如果 (标记类型 ?= 2) {
        // 标识符
        标记值 = 标识名;
        如果 (标识名 ?= "函数") {
            ()解析闭包;
        } 否则如果 (标识名 ?= "真") {
            "1" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则如果 (标识名 ?= "假") {
            "0" = 表达式C;
            "整数" = 表达式类型;
            ()下一个标记;
        } 否则 {
            (标识名)查闭包函数 = 闭包函数名;
            如果 (闭包函数名 ?= "") {
                 (标识名)查类型 = 类型码;
                 如果 (类型码 ?= 0) {
                     // 可能是 结构体类型名 开头的实例字面量： 类型名{ 成员名: 值, ... }
                      (标识名)查结构体大小 = 结构体大小文本;
                      如果 (结构体大小文本 ?= "") {
                          ()下一个标记;           // 越过 标识名 → 后继
                          如果 (标记类型 ?= 4 && 标记值 ?= "::") {
                              // 枚举成员：枚举名::成员名 → 编译期 i32 常量
                              ()下一个标记;        // 成员名
                              标记值 = 枚举_成员名;
                              (枚举_成员表, 标识名 + "::" + 枚举_成员名)查表值 = 表达式C;
                              "整数" = 表达式类型;
                              ()下一个标记;        // 越过 成员名 → 后继
                          } 否则 {
                              "0" = 表达式C;
                              "整数" = 表达式类型;
                          }
                      } 否则 {
                         标识名 = 当前结构体名;
                         ()下一个标记;           // 跳过 类型名 → {
                         如果 (标记值 ?= "{") {
                             ()下一个标记;      // 跳过 {
                             (当前结构体名)查结构体大小 = 结构体大小文本;
                             ()新寄存器 = 结构体实例名;
                             ("  " + 结构体实例名 + " = 分配 %" + 当前结构体名 + ", align 8")发射;
                             当 (真) {
                                 如果 (标记值 ?= "}") { 中断; }
                                  标记值 = 结构体成员名;
                                  ()下一个标记;   // 跳过 成员名 → :
                                  ()下一个标记;   // 跳过 : → 值表达式
                                  当前结构体名 = 结构体保存名;      // 保存外层 当前结构体名
                                  结构体成员名 = 结构体保存成员名;  // 保存外层 结构体成员名
                                  ()解析表达式;
                                  表达式C = 结构体成员值;
                                  结构体保存名 = 当前结构体名;      // 恢复外层 当前结构体名
                                  结构体保存成员名 = 结构体成员名;  // 恢复外层 结构体成员名
                                  // 数组成员：登记 结构体_数组表（元素码:大小文本 来自字面量）
                                  如果 (表达式类型 ?= "数组") {
                                      当前结构体名 + ":" = 链式地址;
                                      链式地址 + 结构体成员名 = 链式地址;
                                      数组元素码 + ":" = 保存存储值;
                                      保存存储值 + 数组大小文本 = 保存存储值;
                                      (结构体_数组表, 链式地址, 保存存储值)表添加 = 结构体_数组表;
                                  }
                                  (当前结构体名, 结构体成员名)查结构体成员索引 = 结构体成员索引;
                                 (当前结构体名, 结构体成员名)查结构体成员类型 = 结构体成员类型;
                                 ()新寄存器 = 成员指针;
                                 ("  " + 成员指针 + " = 获取元素指针 %" + 当前结构体名 + ", ptr " + 结构体实例名 + ", i32 0, i32 " + 结构体成员索引)发射;
                                  (结构体成员类型)结构体成员类型转IR = 结构体成员IR;
                                  ("  存储 " + 结构体成员IR + " " + 结构体成员值 + ", ptr " + 成员指针 + ", align 8")发射;
                                  如果 (标记值 ?= ",") { ()下一个标记; }
                                  否则 { 中断; }
                             }
                             ()下一个标记;       // 跳过 }
                             结构体实例名 = 表达式C;
                             "结构体" = 表达式类型;
                             // 登记: 当前数组名 清空
                             "" = 当前数组名;
                          } 否则 {
                             "0" = 表达式C;
                             "整数" = 表达式类型;
                          }
                     }
                 } 否则如果 (类型码 ?= 5) {
                     // 数组变量：表达式值即其地址
                     标识名 = 当前数组名;
                     (标识名)转义标识符 = 转义;
                     如果 (命中全局表 ?= 1) { "@" + 转义 = 地址; }
                     否则 { "%" + 转义 = 地址; }
                     地址 = 表达式C;
                     "数组" = 表达式类型;
