// 解析并发射函数体（直到 } 为止，不消费 }）
函数 发射函数体 {
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4 && 标记值 ?= "}") { 中断; }
        ()解析并发射语句;
    }
}

// 解析并发射一条语句
函数 解析并发射语句 {
    如果 (标记值 ?= "如果") {
        ()新标签 = 合并标签;
        (合并标签, 0)发射如果链;
    } 否则如果 (标记值 ?= "当") {
        ()下一个标记;   // 当
        ()下一个标记;   // (
        ()新标签 = 循环头标签;
        ()新标签 = 循环体标签;
        ()新标签 = 循环退出标签;
        (循环退出标签)压退出栈;
        (循环头标签)压继续栈;
        (循环头标签)发射标签;
        ()解析表达式;   // 必须在 循环头标签 之后：条件指令落入循环体，每轮重新求值
        ()下一个标记;   // )
        ()发射条件;
        ("分支 i1 " + 当前条件 + ", 标签 %" + 循环体标签 + ", 标签 %" + 循环退出标签)发射终结;
        (循环体标签)发射标签;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        ("分支 标签 %" + 循环头标签)发射终结;
        (循环退出标签)发射标签;
        ()弹退出栈;
        ()弹继续栈;
    } 否则如果 (标记值 ?= "循环") {
        // 范围循环: 循环 (变量: 开始, 结束[, 步长])
        ()下一个标记;   // 循环
        ()下一个标记;   // (
        标记值 = 循环变量;
        ()下一个标记;   // :
        ()下一个标记;   // 开始
        ()解析表达式;
        表达式C = 循环开始C;
        ()下一个标记;   // ,
        ()解析表达式;
        表达式C = 循环结束C;
        如果 (标记值 ?= ",") {
            ()下一个标记;
            ()解析表达式;
            表达式C = 循环步长C;
            ()下一个标记;   // )
        } 否则 {
            "1" = 循环步长C;
            ()下一个标记;   // )
        }
        (循环变量, "I")局部表添加;
        (循环变量)转义标识符 = 循环变量转义;
        ()新标签 = 循环头标签;
        ()新标签 = 循环体标签;
        ()新标签 = 循环步长标签;
        ()新标签 = 循环退出标签;
        (循环退出标签)压退出栈;
        (循环步长标签)压继续栈;
        ("存储 i32 " + 循环开始C + ", ptr %" + 循环变量转义 + ", align 4")发射;
        (循环头标签)发射标签;
        ()新寄存器 = 循环值;
        ("  " + 循环值 + " = 加载 i32, ptr %" + 循环变量转义 + ", align 4")发射;
        ()新寄存器 = 循环比较;
        ("  " + 循环比较 + " = 整数比较 slt i32 " + 循环值 + ", " + 循环结束C)发射;
        ("分支 i1 " + 循环比较 + ", 标签 %" + 循环体标签 + ", 标签 %" + 循环退出标签)发射终结;
        (循环体标签)发射标签;
        ()下一个标记;   // {
        ()发射函数体;
        ()下一个标记;   // }
        (循环步长标签)发射标签;
        ()新寄存器 = 循环加载;
        ("  " + 循环加载 + " = 加载 i32, ptr %" + 循环变量转义 + ", align 4")发射;
        ()新寄存器 = 循环步进;
        ("  " + 循环步进 + " = 加 i32 " + 循环加载 + ", " + 循环步长C)发射;
        ("存储 i32 " + 循环步进 + ", ptr %" + 循环变量转义 + ", align 4")发射;
        ("分支 标签 %" + 循环头标签)发射终结;
        (循环退出标签)发射标签;
        ()弹退出栈;
        ()弹继续栈;
    } 否则如果 (标记值 ?= "遍历") {
        // 遍历 (变量: 数组对象) { 体 } —— 对象必须是数组变量（怪癖1：非简单变量报错）
        ()下一个标记;   // 遍历
        ()下一个标记;   // (
        标记值 = 遍历变量名;
        ()下一个标记;   // 变量
        ()下一个标记;   // :
        如果 (标记类型 ?= 2) {
            标记值 = 遍历对象名;
            ()下一个标记;   // 对象
        } 否则 {
