// ============================================
// Stage 1: 表达式求值器 — 验证编译器能编译解释器
// ============================================

变量 输入串 = "";
变量 位置 = 0;

函数 前进(): 空 {
    位置 = 位置 + 1;
}

函数 跳过空白(): 空 {
    当 (位置 < 长度(输入串)) {
        变量 c = 子串(输入串, 位置, 1);
        如果 (c ?= " ") { 前进(); } 否则如果 (c ?= "\t") { 前进(); } 否则如果 (c ?= "\n") { 前进(); } 否则 { 中断; }
    }
}

函数 读取数字字符值(): 整数 {
    如果 (位置 >= 长度(输入串)) { 返回 -1; }
    变量 c = 子串(输入串, 位置, 1);
    // 检查是否为数字字符 "0"-"9"
    如果 (c ?= "0") { 返回 0; }
    如果 (c ?= "1") { 返回 1; }
    如果 (c ?= "2") { 返回 2; }
    如果 (c ?= "3") { 返回 3; }
    如果 (c ?= "4") { 返回 4; }
    如果 (c ?= "5") { 返回 5; }
    如果 (c ?= "6") { 返回 6; }
    如果 (c ?= "7") { 返回 7; }
    如果 (c ?= "8") { 返回 8; }
    如果 (c ?= "9") { 返回 9; }
    返回 -1;
}

函数 解析因子(): 整数 {
    跳过空白();
    如果 (位置 < 长度(输入串) && 子串(输入串, 位置, 1) ?= "(") {
        前进();
        变量 值 = 解析表达式();
        跳过空白();
        如果 (位置 < 长度(输入串) && 子串(输入串, 位置, 1) ?= ")") { 前进(); }
        返回 值;
    }
    变量 负 = 0;
    如果 (位置 < 长度(输入串) && 子串(输入串, 位置, 1) ?= "-") {
        负 = 1;
        前进();
    }
    变量 值 = 0;
    当 (位置 < 长度(输入串)) {
        变量 d = 读取数字字符值();
        如果 (d >= 0) {
            值 = 值 * 10 + d;
            前进();
        } 否则 {
            中断;
        }
    }
    如果 (负 ?= 1) { 返回 -值; }
    返回 值;
}

函数 解析项(): 整数 {
    变量 左 = 解析因子();
    跳过空白();
    当 (位置 < 长度(输入串)) {
        变量 c = 子串(输入串, 位置, 1);
        如果 (c ?= "*") {
            前进();
            左 = 左 * 解析因子();
            跳过空白();
        } 否则如果 (c ?= "/") {
            前进();
            变量 右 = 解析因子();
            如果 (右 != 0) { 左 = 左 / 右; }
            跳过空白();
        } 否则如果 (c ?= "%") {
            前进();
            变量 右 = 解析因子();
            如果 (右 != 0) { 左 = 左 % 右; }
            跳过空白();
        } 否则 {
            中断;
        }
    }
    返回 左;
}

函数 解析表达式(): 整数 {
    变量 左 = 解析项();
    跳过空白();
    当 (位置 < 长度(输入串)) {
        变量 c = 子串(输入串, 位置, 1);
        如果 (c ?= "+") {
            前进();
            左 = 左 + 解析项();
            跳过空白();
        } 否则如果 (c ?= "-") {
            前进();
            左 = 左 - 解析项();
            跳过空白();
        } 否则 {
            中断;
        }
    }
    返回 左;
}

函数 断言(条件, 消息): 空 {
    如果 (!条件) {
        打印("[失败] ");
        打印(消息);
    }
}

函数 测试基本运算(): 空 {
    输入串 = "2+3"; 位置 = 0; 断言(解析表达式() ?= 5, "2+3");
    输入串 = "10-4"; 位置 = 0; 断言(解析表达式() ?= 6, "10-4");
    输入串 = "3*7"; 位置 = 0; 断言(解析表达式() ?= 21, "3*7");
    输入串 = "20/4"; 位置 = 0; 断言(解析表达式() ?= 5, "20/4");
    输入串 = "17%5"; 位置 = 0; 断言(解析表达式() ?= 2, "17%5");
}

函数 测试优先级(): 空 {
    输入串 = "2+3*4"; 位置 = 0; 断言(解析表达式() ?= 14, "2+3*4");
    输入串 = "10-6/2"; 位置 = 0; 断言(解析表达式() ?= 7, "10-6/2");
    输入串 = "2*3+4*5"; 位置 = 0; 断言(解析表达式() ?= 26, "2*3+4*5");
    输入串 = "100/10/2"; 位置 = 0; 断言(解析表达式() ?= 5, "100/10/2");
}

函数 测试括号(): 空 {
    输入串 = "(2+3)*4"; 位置 = 0; 断言(解析表达式() ?= 20, "(2+3)*4");
    输入串 = "2*(3+4)"; 位置 = 0; 断言(解析表达式() ?= 14, "2*(3+4)");
    输入串 = "((2+3))"; 位置 = 0; 断言(解析表达式() ?= 5, "((2+3))");
}

函数 测试负数(): 空 {
    输入串 = "-5"; 位置 = 0; 断言(解析表达式() ?= -5, "-5");
    输入串 = "3+(-2)"; 位置 = 0; 断言(解析表达式() ?= 1, "3+(-2)");
    输入串 = "-3*4"; 位置 = 0; 断言(解析表达式() ?= -12, "-3*4");
}

函数 测试空白(): 空 {
    输入串 = " 2 + 3 "; 位置 = 0; 断言(解析表达式() ?= 5, "空白");
}

函数 主程序(): 空 {
    打印("=== Stage 1: 表达式求值器 ===");
    测试基本运算();
    测试优先级();
    测试括号();
    测试负数();
    测试空白();
    打印("=== Stage 1 通过 ===");
}
