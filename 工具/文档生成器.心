// 日月文档生成器（阶段P7 续：`///` 文档注释 / Markdown / 声明索引 / 代码块提取 / HTML / JSON）
// 用法: 导入 "../工具/文档生成器.心" 后调用 `文档生成标记(源文本)`、`文档生成HTML(源文本)`
//       或 `文档生成JSON(源文本)`、`文档代码块(源文本, 序号)`
//       （库文件：入口见 示例/文档生成器测试.心；无 主程序，避免导入方重定义）
// 纯 .心：仅用 长度 / 子串 / 拼接，不改编译器 ⇒ 自举不动点不变，双链逐字一致。
// 覆盖范围：仅行首声明（函数 / 协程 / 方法 / 结构体 / 枚举）；代码围栏内的内容不索引。
// 约束：**不导入 `标准库/字符串.心`**——统一 CLI 同时聚合 测试运行器（→测试框架→`字符串.心`）
//       时，两条链的相对路径不同、模块键不相等，会重复包含同一文件（`invalid redefinition`）；
//       故整数转文本改为本地 `文档整数转字符串`（语义与 `整数转字符串` 一致）。

// 整数转十进制文本（0 → "0"、负数带前导 `-`）；本地实现，避免上述模块键重复
函数 (值:整数)文档整数转字符串("" = 结果:字符串) {
    "0123456789" = 数字表;
    "" = 输出;
    如果 (值 ?= 0) {
        "0" = 输出;
    } 否则 {
        0 = 数;
        如果 (值 < 0) {
            0 - 值 = 数;
        } 否则 {
            值 = 数;
        }
        当 (数 > 0) {
            数 / 10 = 商;
            数 - 商 * 10 = 位;
            (数字表, 位, 1)子串 = 字符;
            (字符, 输出)拼接 = 输出;
            商 = 数;
        }
        如果 (值 < 0) {
            ("-", 输出)拼接 = 输出;
        }
    }
    输出 = 结果;
}

// 模块版本（统一 CLI `版本` 子命令展示）
// 1 = Markdown 生成；2 = HTML 生成与 HTML 转义；3 = JSON 生成与 JSON 转义；
// 4 = 代码块提取（`文档代码块`）
函数 ()文档生成器模块版本(0 = 结果:整数) {
    4 = 结果;
}

// 行首缩进：首个非空白字符下标（整行空白 → 行长）
函数 (行:字符串)文档行缩进(0 = 结果:整数) {
    (行)长度 = 行长;
    0 = 结果;
    0 = 停;
    当 (停 ?= 0 && 结果 < 行长) {
        (行, 结果)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 13) {
            结果 + 1 = 结果;
        } 否则 {
            1 = 停;
        }
    }
}

// 标识符续码：字母 / 数字 / 下划线 / 非 ASCII（与 LSP 符号扫描一致）
函数 (码:整数)文档标识符码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 65 && 码 <= 90) { 1 = 结果; }
    如果 (码 >= 97 && 码 <= 122) { 1 = 结果; }
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
    如果 (码 ?= 95) { 1 = 结果; }
    如果 (码 >= 128) { 1 = 结果; }
}

// 行首声明种类：函数 / 协程 1、方法 2、结构体 3、枚举 4、非声明 0
函数 (行:字符串)文档行种类(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    (行)长度 = 行长;
    如果 (起 + 2 <= 行长) {
        (行, 起, 2)子串 = 两;
        如果 (两 ?= "函数") { 1 = 结果; }
        如果 (两 ?= "协程") { 1 = 结果; }
        如果 (两 ?= "方法") { 2 = 结果; }
        如果 (两 ?= "枚举") { 4 = 结果; }
    }
    如果 (结果 ?= 0 && 起 + 3 <= 行长) {
        (行, 起, 3)子串 = 三;
        如果 (三 ?= "结构体") { 3 = 结果; }
    }
}

// 行首声明名称：跳过关键字、空白与函数参数表；非声明 → ""
函数 (行:字符串)文档行名称("" = 结果:字符串) {
    "" = 结果;
    (行)文档行缩进 = 起;
    (行)长度 = 行长;
    0 = 键长;
    如果 (起 + 2 <= 行长) {
        (行, 起, 2)子串 = 两;
        如果 (两 ?= "函数") { 2 = 键长; }
        如果 (两 ?= "协程") { 2 = 键长; }
        如果 (两 ?= "方法") { 2 = 键长; }
        如果 (两 ?= "枚举") { 2 = 键长; }
    }
    如果 (键长 ?= 0 && 起 + 3 <= 行长) {
        (行, 起, 3)子串 = 三;
        如果 (三 ?= "结构体") { 3 = 键长; }
    }
    如果 (键长 > 0) {
        起 + 键长 = j;
        0 = 停;
        当 (停 ?= 0 && j < 行长) {
            (行, j)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) { j + 1 = j; } 否则 { 1 = 停; }
        }
        如果 (j < 行长) {
            (行, j)字符码 = 码;
            如果 (码 ?= 40) {
                0 = 层;
                0 = 停;
                当 (停 ?= 0 && j < 行长) {
                    (行, j)字符码 = 括码;
                    如果 (括码 ?= 40) { 层 + 1 = 层; }
                    如果 (括码 ?= 41) {
                        层 - 1 = 层;
                        如果 (层 <= 0) { 1 = 停; }
                    }
                    j + 1 = j;
                }
                0 = 停;
                当 (停 ?= 0 && j < 行长) {
                    (行, j)字符码 = 码;
                    如果 (码 ?= 32 || 码 ?= 9) { j + 1 = j; } 否则 { 1 = 停; }
                }
            }
        }
        j = 名起;
        0 = 停;
        当 (停 ?= 0 && j < 行长) {
            (行, j)字符码 = 名码;
            (名码)文档标识符码 = 可续;
            如果 (可续 ?= 1) { j + 1 = j; } 否则 { 1 = 停; }
        }
        如果 (j > 名起) {
            (行, 名起, j - 名起)子串 = 名段;
            ("", 名段)拼接 = 结果;
        }
    }
}

// 行首文档注释：`///` 之后去除前导空白的正文；非 `///` → ""
函数 (行:字符串)文档注释文本("" = 结果:字符串) {
    "" = 结果;
    (行)文档行缩进 = 起;
    (行)长度 = 行长;
    如果 (起 + 3 <= 行长) {
        (行, 起, 3)子串 = 头;
        如果 (头 ?= "///") {
            起 + 3 = j;
            0 = 停;
            当 (停 ?= 0 && j < 行长) {
                (行, j)字符码 = 码;
                如果 (码 ?= 32 || 码 ?= 9) { j + 1 = j; } 否则 { 1 = 停; }
            }
            如果 (j < 行长) {
                (行, j, 行长 - j)子串 = 段;
                ("", 段)拼接 = 结果;
            }
        }
    }
}

// 行首代码围栏（三个反引号）→ 1
函数 (行:字符串)文档行围栏(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    (行)长度 = 行长;
    如果 (起 + 3 <= 行长) {
        (行, 起, 3)子串 = 头;
        如果 (头 ?= "```") { 1 = 结果; }
    }
}

// 取第 N 行（0 基，去掉行尾换行 / 回车）；越界 → ""
函数 (文本:字符串, 行序:整数)文档取行("" = 结果:字符串) {
    "" = 结果;
    (文本)长度 = 总长;
    0 = i;
    0 = 行;
    0 = 起;
    0 = 止;
    0 = 见止;
    0 = 停;
    当 (停 ?= 0 && i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 10) {
            如果 (行 ?= 行序) {
                i = 止;
                1 = 见止;
                1 = 停;
            } 否则 {
                行 + 1 = 行;
                i + 1 = 起;
            }
        }
        i + 1 = i;
    }
    如果 (停 ?= 0 && 行 ?= 行序) {
        总长 = 止;
        1 = 见止;
    }
    如果 (见止 ?= 1) {
        止 = 末;
        如果 (末 > 起) {
            (文本, 末 - 1)字符码 = 末码;
            如果 (末码 ?= 13) { 末 - 1 = 末; }
        }
        如果 (末 > 起) {
            (文本, 起, 末 - 起)子串 = 段;
            ("", 段)拼接 = 结果;
        }
    }
}

// 行数：换行符个数（末行无换行时补 1）
函数 (文本:字符串)文档行数(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 10) { 结果 + 1 = 结果; }
        i + 1 = i;
    }
    如果 (总长 > 0) {
        (文本, 总长 - 1)字符码 = 末码;
        如果 (末码 != 10) { 结果 + 1 = 结果; }
    }
}

// 代码块段数：围栏行数取半
函数 (文本:字符串)文档代码块数(0 = 结果:整数) {
    0 = 结果;
    0 = 围栏数;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        (行)文档行围栏 = 围栏;
        如果 (围栏 ?= 1) { 围栏数 + 1 = 围栏数; }
        行序 + 1 = 行序;
    }
    围栏数 / 2 = 结果;
}

// 生成 Markdown：按 函数 / 方法 / 结构体 / 枚举 分组，附 `///` 注释与 1 基行号；
// 代码围栏内不索引；末尾给出声明条数与代码块段数。
函数 (文本:字符串)文档生成标记("" = 结果:字符串) {
    "" = 函数项;
    "" = 方法项;
    "" = 结构体项;
    "" = 枚举项;
    0 = 函数数;
    0 = 方法数;
    0 = 结构体数;
    0 = 枚举数;
    "" = 待注;
    0 = 在例;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        (行)文档行围栏 = 围栏;
        如果 (围栏 ?= 1) {
            如果 (在例 ?= 1) { 0 = 在例; } 否则 { 1 = 在例; }
            "" = 待注;
        } 否则如果 (在例 ?= 1) {
            "" = 待注;
        } 否则 {
            (行)文档行种类 = 种;
            (行)文档注释文本 = 注;
            如果 (注 != "") {
                (待注, "  ")拼接 = 待注;
                (待注, 注)拼接 = 待注;
                (待注, "\n")拼接 = 待注;
            } 否则如果 (种 != 0) {
                (行)文档行名称 = 名;
                如果 (名 != "") {
                    行序 + 1 = 行号;
                    (行号)文档整数转字符串 = 行文本;
                    "" = 项;
                    (项, "- `")拼接 = 项;
                    (项, 名)拼接 = 项;
                    (项, "`（第 ")拼接 = 项;
                    (项, 行文本)拼接 = 项;
                    (项, " 行）\n")拼接 = 项;
                    (项, 待注)拼接 = 项;
                    如果 (种 ?= 1) { (函数项, 项)拼接 = 函数项; 函数数 + 1 = 函数数; }
                    如果 (种 ?= 2) { (方法项, 项)拼接 = 方法项; 方法数 + 1 = 方法数; }
                    如果 (种 ?= 3) { (结构体项, 项)拼接 = 结构体项; 结构体数 + 1 = 结构体数; }
                    如果 (种 ?= 4) { (枚举项, 项)拼接 = 枚举项; 枚举数 + 1 = 枚举数; }
                }
                "" = 待注;
            } 否则 {
                "" = 待注;
            }
        }
        行序 + 1 = 行序;
    }
    "" = 结果;
    (结果, "# 模块文档\n\n")拼接 = 结果;
    如果 (函数数 > 0) {
        (结果, "## 函数\n")拼接 = 结果;
        (结果, 函数项)拼接 = 结果;
        (结果, "\n")拼接 = 结果;
    }
    如果 (方法数 > 0) {
        (结果, "## 方法\n")拼接 = 结果;
        (结果, 方法项)拼接 = 结果;
        (结果, "\n")拼接 = 结果;
    }
    如果 (结构体数 > 0) {
        (结果, "## 结构体\n")拼接 = 结果;
        (结果, 结构体项)拼接 = 结果;
        (结果, "\n")拼接 = 结果;
    }
    如果 (枚举数 > 0) {
        (结果, "## 枚举\n")拼接 = 结果;
        (结果, 枚举项)拼接 = 结果;
        (结果, "\n")拼接 = 结果;
    }
    0 = 总条;
    函数数 + 方法数 = 总条;
    总条 + 结构体数 = 总条;
    总条 + 枚举数 = 总条;
    (文本)文档代码块数 = 代码块;
    (总条)文档整数转字符串 = 总条文本;
    (代码块)文档整数转字符串 = 块文本;
    (结果, "> 声明 ")拼接 = 结果;
    (结果, 总条文本)拼接 = 结果;
    (结果, " 条，代码块 ")拼接 = 结果;
    (结果, 块文本)拼接 = 结果;
    (结果, " 段\n")拼接 = 结果;
}

// HTML 转义：`&` `<` `>` `"` → 实体；其余字符原样保留
函数 (文本:字符串)文档转义HTML("" = 结果:字符串) {
    "" = 结果;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 38) {
            (结果, "&amp;")拼接 = 结果;
        } 否则如果 (码 ?= 60) {
            (结果, "&lt;")拼接 = 结果;
        } 否则如果 (码 ?= 62) {
            (结果, "&gt;")拼接 = 结果;
        } 否则如果 (码 ?= 34) {
            (结果, "&quot;")拼接 = 结果;
        } 否则 {
            (文本, i, 1)子串 = 字;
            (结果, 字)拼接 = 结果;
        }
        i + 1 = i;
    }
}

