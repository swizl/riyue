// JSON 转义：`"` / `\` / 换行 / 制表 / 回车 → 转义序列；其余字符原样保留
函数 (文本:字符串)文档转义JSON("" = 结果:字符串) {
    "" = 结果;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 34) {
            (结果, "\\\"")拼接 = 结果;
        } 否则如果 (码 ?= 92) {
            (结果, "\\\\")拼接 = 结果;
        } 否则如果 (码 ?= 10) {
            (结果, "\\n")拼接 = 结果;
        } 否则如果 (码 ?= 9) {
            (结果, "\\t")拼接 = 结果;
        } 否则如果 (码 ?= 13) {
            (结果, "\\r")拼接 = 结果;
        } 否则 {
            (文本, i, 1)子串 = 字;
            (结果, 字)拼接 = 结果;
        }
        i + 1 = i;
    }
}

// 生成 JSON（单行）：`{"declarations":[{"kind","name","line","doc"}…],"codeBlocks":M}`；
// 与 Markdown / HTML 同源扫描（围栏内不索引、`///` 多行注释以 `\n` 连接），字符串均转义。
函数 (文本:字符串)文档生成JSON("" = 结果:字符串) {
    "" = 项串;
    0 = 条数;
    "" = 待注;
    0 = 有注;
    0 = 在例;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        (行)文档行围栏 = 围栏;
        如果 (围栏 ?= 1) {
            如果 (在例 ?= 1) { 0 = 在例; } 否则 { 1 = 在例; }
            "" = 待注;
            0 = 有注;
        } 否则如果 (在例 ?= 1) {
            "" = 待注;
            0 = 有注;
        } 否则 {
            (行)文档行种类 = 种;
            (行)文档注释文本 = 注;
            如果 (注 != "") {
                如果 (有注 ?= 1) {
                    (待注, "\n")拼接 = 待注;
                }
                (待注, 注)拼接 = 待注;
                1 = 有注;
            } 否则如果 (种 != 0) {
                (行)文档行名称 = 名;
                如果 (名 != "") {
                    行序 + 1 = 行号;
                    (行号)文档整数转字符串 = 行文本;
                    (名)文档转义JSON = 名安;
                    "" = 种名;
                    如果 (种 ?= 1) { "函数" = 种名; }
                    如果 (种 ?= 2) { "方法" = 种名; }
                    如果 (种 ?= 3) { "结构体" = 种名; }
                    如果 (种 ?= 4) { "枚举" = 种名; }
                    如果 (条数 > 0) { (项串, ",")拼接 = 项串; }
                    (项串, "{\"kind\":\"")拼接 = 项串;
                    (项串, 种名)拼接 = 项串;
                    (项串, "\",\"name\":\"")拼接 = 项串;
                    (项串, 名安)拼接 = 项串;
                    (项串, "\",\"line\":")拼接 = 项串;
                    (项串, 行文本)拼接 = 项串;
                    如果 (有注 ?= 1) {
                        (待注)文档转义JSON = 注安;
                        (项串, ",\"doc\":\"")拼接 = 项串;
                        (项串, 注安)拼接 = 项串;
                        (项串, "\"")拼接 = 项串;
                    }
                    (项串, "}")拼接 = 项串;
                    条数 + 1 = 条数;
                }
                "" = 待注;
                0 = 有注;
            } 否则 {
                "" = 待注;
                0 = 有注;
            }
        }
        行序 + 1 = 行序;
    }
    (文本)文档代码块数 = 代码块;
    (代码块)文档整数转字符串 = 块文本;
    "" = 结果;
    (结果, "{\"declarations\":[")拼接 = 结果;
    (结果, 项串)拼接 = 结果;
    (结果, "],\"codeBlocks\":")拼接 = 结果;
    (结果, 块文本)拼接 = 结果;
    (结果, "}\n")拼接 = 结果;
}

// 取第 N 段代码块正文（0 基）：两个围栏行之间的原文，逐行以 `\n` 结尾，围栏行本身不含；
// 无该段（序号越界）→ ""；围栏未闭合时取到文件末尾（末行无换行也会补一个 `\n`）。
// 段号由「已见围栏行数 / 2」决定（第 2K 个围栏行开启第 K 段），故只有闭合围栏配对后才会推进。
函数 (文本:字符串, 序号:整数)文档代码块("" = 结果:字符串) {
    "" = 结果;
    0 = 围栏序;
    0 = 在例;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        (行)文档行围栏 = 围栏;
        如果 (围栏 ?= 1) {
            如果 (在例 ?= 1) {
                0 = 在例;
            } 否则 {
                围栏序 / 2 = 段;
                如果 (段 ?= 序号) { 1 = 在例; }
            }
            围栏序 + 1 = 围栏序;
        } 否则如果 (在例 ?= 1) {
            (结果, 行)拼接 = 结果;
            (结果, "\n")拼接 = 结果;
        }
        行序 + 1 = 行序;
    }
}
