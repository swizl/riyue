// 日月文档生成器
// 用法: 日月.exe 工具/文档生成器.心 [目录]

// 导入词法器模块
导入 "../编译器/词法器模块.心";

// 文档结构
"" = 当前文件;
"" = 当前函数名;
"" = 当前注释;
"" = 文档输出;

// 生成文档头部
函数 生成文档头(空) {
    "# 日月项目文档\n\n" = 文档输出;
    文档输出 + "自动生成于 " = 文档输出;
    文档输出 + "2026-06-25" = 文档输出;
    文档输出 + "\n\n" = 文档输出;
}

// 生成函数文档
函数 (函数名:字符串, 注释:字符串)生成函数文档(空) {
    文档输出 + "## " = 文档输出;
    文档输出 + 函数名 = 文档输出;
    文档输出 + "\n\n" = 文档输出;
    如果 (注释 != "") {
        文档输出 + 注释 = 文档输出;
        文档输出 + "\n\n" = 文档输出;
    }
}

// 生成文件文档
函数 (文件名:字符串)生成文件文档(空) {
    文档输出 + "# " = 文档输出;
    文档输出 + 文件名 = 文档输出;
    文档输出 + "\n\n" = 文档输出;
}

// 保存文档
函数 (文件路径:字符串)保存文档(空) {
    ("文档已保存到: ")打印;
    (文件路径)打印;
    ("")打印;
}

// 主程序
函数 主程序 {
    ("=== 日月文档生成器 ===")打印;
    
    ("用法: 日月.exe 工具/文档生成器.心 [目录]")打印;
    ("")打印;
    
    ("功能说明:")打印;
    ("  1. 解析 .心 文件中的注释")打印;
    ("  2. 提取函数定义和文档注释")打印;
    ("  3. 生成 Markdown 格式文档")打印;
    ("")打印;
    
    ("示例注释格式:")打印;
    ("  // 函数名: 描述")打印;
    ("  // 参数: 参数名 - 描述")打印;
    ("  // 返回: 返回值描述")打印;
    ("")打印;
    
    ("=== 完成 ===")打印;
}
