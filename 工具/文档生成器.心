                    (行号)文档整数转字符串 = 行文本;
                    (名)文档转义HTML = 名安;
                    "" = 项;
                    (项, "<li><code>")拼接 = 项;
                    (项, 名安)拼接 = 项;
                    (项, "</code>（第 ")拼接 = 项;
                    (项, 行文本)拼接 = 项;
                    (项, " 行）")拼接 = 项;
                    如果 (待注 != "") {
                        (待注)文档转义HTML = 注安;
                        (项, "<p>")拼接 = 项;
                        (项, 注安)拼接 = 项;
                        (项, "</p>")拼接 = 项;
                    }
                    (项, "</li>\n")拼接 = 项;
                    如果 (种 ?= 1) { (函数项, 项)拼接 = 函数项; 函数数 + 1 = 函数数; }
