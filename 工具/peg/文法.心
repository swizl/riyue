// 工具/peg/文法.心 — 文法文件加载器
// 自包含（不导入）：读取文法文件文本，填充四张全局表，供 匹配/生成 使用。
// 表格式：令牌表/跳过表 = "名:正则" 行；关键字表 = "词:" 行；规则表 = "名:表达式文本" 行。
// 用法：编译本文件，运行 `程序 文法文件`。

"" = 变量 令牌表;
"" = 变量 关键字表;
"" = 变量 跳过表;
"" = 变量 规则表;

// 把 名:值 追加到 表（换行分隔）
函数 (表:字符串, 名:字符串, 值:字符串)追加(0 = 结果:字符串) {
    如果 (表 ?= "") {
        名 + ":" = 结果;
        结果 + 值 = 结果;
    } 否则 {
        表 + "\n" = 结果;
        结果 + 名 = 结果;
        结果 + ":" = 结果;
        结果 + 值 = 结果;
    }
}

// 去掉行首尾空白（空格/制表/回车）
函数 (行:字符串)修剪(0 = 结果:字符串) {
    (行)长度 = 长;
    0 = 起;
    当 (起 < 长) {
        (行, 起)字符码 = 码;
        如果 (码 ?= 32) { 起 + 1 = 起; }
        否则如果 (码 ?= 9) { 起 + 1 = 起; }
        否则 { 中断; }
    }
    长 = 止;
    当 (止 > 起) {
        (行, 止 - 1)字符码 = 码2;
        如果 (码2 ?= 32) { 止 - 1 = 止; }
        否则如果 (码2 ?= 9) { 止 - 1 = 止; }
        否则如果 (码2 ?= 13) { 止 - 1 = 止; }
        否则 { 中断; }
    }
    (行, 起, 止 - 起)子串 = 结果;
}

// 返回 目标码 在 行 中首次出现的位置；未找到返回 行长度
函数 (行:字符串, 目标:整数)找码(0 = 结果:整数) {
    (行)长度 = 长;
    长 = 结果;
    0 = i;
    当 (i < 长) {
        (行, i)字符码 = 码;
        如果 (码 ?= 目标) { i = 结果; 中断; }
        i + 1 = i;
    }
}

// 分派一行（已修剪、非空、非注释）
函数 (行:字符串)分派(无) {
    (行)长度 = 行长;
    (行, "%token")字符串开头 = 是令牌;
    如果 (是令牌 ?= 1) {
        (行, 6, 行长 - 6)子串 = 剩余;
        (剩余)修剪 = 剩余;
        (剩余)长度 = 剩余长;
        (剩余, 32)找码 = 空格;
        (剩余, 0, 空格)子串 = 名;
        (剩余, 空格 + 1, 剩余长 - 空格 - 1)子串 = 模式;
        (模式)修剪 = 模式;
        (令牌表, 名, 模式)追加 = 令牌表;
    }
    否则 {
        (行, "%keyword")字符串开头 = 是关键字;
        如果 (是关键字 ?= 1) {
            (行, 8, 行长 - 8)子串 = 剩余;
            (剩余)修剪 = 剩余;
            (关键字表, 剩余, "")追加 = 关键字表;
        }
        否则 {
            (行, "%skip")字符串开头 = 是跳过;
            如果 (是跳过 ?= 1) {
                (行, 5, 行长 - 5)子串 = 剩余;
                (剩余)修剪 = 剩余;
                (剩余)长度 = 剩余长;
                (剩余, 32)找码 = 空格;
                (剩余, 0, 空格)子串 = 名;
                (剩余, 空格 + 1, 剩余长 - 空格 - 1)子串 = 模式;
                (模式)修剪 = 模式;
                (跳过表, 名, 模式)追加 = 跳过表;
            }
            否则 {
                // 规则： 名 = 表达式
                (行, 61)找码 = 等号;
                如果 (等号 < 行长) {
                    (行, 0, 等号)子串 = 左;
                    (左)修剪 = 名;
                    (行, 等号 + 1, 行长 - 等号 - 1)子串 = 右;
                    (右)修剪 = 表达式;
                    (规则表, 名, 表达式)追加 = 规则表;
                }
            }
        }
    }
}

// 处理行（修剪、去注释/空行）
函数 (行:字符串)处理行(无) {
    (行)修剪 = 行;
    如果 (行 ?= "") { }
    否则 {
        (行, "#")字符串开头 = 是井;
        如果 (是井 ?= 1) { }
        否则 {
            (行, "//")字符串开头 = 是斜;
            如果 (是斜 ?= 1) { }
            否则 { (行)分派; }
        }
    }
}

// 解析整份文法文本
函数 (文本:字符串)解析文法(无) {
    (文本)分割行数 = 行数;
    0 = i;
    当 (i < 行数) {
        (文本, i)获取行 = 行;
        (行)处理行;
        i + 1 = i;
    }
}

函数 文法自测 {
    (1)获取参数 = 路径;
    (路径)读取文件 = 文本;
    (文本)解析文法;
    ("== 令牌 ==")打印;
    (令牌表)打印;
    ("== 关键字 ==")打印;
    (关键字表)打印;
    ("== 跳过 ==")打印;
    (跳过表)打印;
    ("== 规则 ==")打印;
    (规则表)打印;
}
