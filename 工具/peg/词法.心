// S2.1 PEG 内核 · 词法：正则子集匹配器 + token 化（玩具单测）
// 正则子集：字面量、. 、[字符类]（含 a-z 范围、^ 取反、\d \w \s \uXXXX 转义）、
//           (分组) 、| 有序选择、* + ? 贪婪量词（不做跨连接回溯）。
// 用法（玩具自测）：本文件含 主程序，直接编译运行打印匹配结果与 token 流。

// 缓存输入文本的 UTF-8 字符数：正则匹配 入口设置一次，
// 匹配原子一次/类别匹配 读取，避免每个原子都对全串重算 长度（O(n²) 卡死）。
0 = 变量 全局文本长;
0 = 变量 长已备;

// ── 字符分类 ─────────────────────────────────────────────
函数 (码:整数)是数字(0 = 结果:整数) {
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
}

函数 (码:整数)是词(0 = 结果:整数) {
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
    如果 (码 >= 65 && 码 <= 90) { 1 = 结果; }
    如果 (码 >= 97 && 码 <= 122) { 1 = 结果; }
    如果 (码 ?= 95) { 1 = 结果; }
}

函数 (码:整数)是空白(0 = 结果:整数) {
    如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) { 1 = 结果; }
}

// ── 读一个十六进制位串（4 位）为整数 ─────────────────────
函数 (模式:字符串, 位置:整数)十六进制值(0 = 值:整数) {
    位置 = 游标;
    0 = 数;
    0 = 位;
    当 (位 < 4) {
        (模式, 游标)字符码 = 单;
        0 = 数码;
        如果 (单 >= 48 && 单 <= 57) { 单 - 48 = 数码; }
        否则如果 (单 >= 97 && 单 <= 102) { 单 - 87 = 数码; }
        否则如果 (单 >= 65 && 单 <= 70) { 单 - 55 = 数码; }
        数 * 16 + 数码 = 数;
        游标 + 1 = 游标;
        位 + 1 = 位;
    }
    数 = 值;
}

// ── 字符类：单个元素末端（不含范围） ─────────────────────
函数 (模式:字符串, 起:整数, 止:整数)单元素末端(0 = 结果:整数) {
    起 + 1 = 结果;
    (模式, 起)字符码 = 首;
    如果 (首 ?= 92) {
        起 + 2 = 结果;
        如果 (起 + 1 < 止) {
            (模式, 起 + 1)字符码 = 转;
            如果 (转 ?= 117) { 起 + 6 = 结果; }
        }
    }
}

// ── 字符类：一个条目是否匹配某码 ─────────────────────────
函数 (模式:字符串, 起:整数, 止:整数, 码:整数)类别项命中(0 = 结果:整数) {
    0 = 低;
    0 = 高;
    0 = 集合;
    0 = 集合型;
    起 = 项;
    (模式, 项)字符码 = 首;
    如果 (首 ?= 92) {
        (模式, 项 + 1)字符码 = 转;
        如果 (转 ?= 100) { 1 = 集合; 100 = 集合型; 项 + 2 = 项; }
        否则如果 (转 ?= 119) { 1 = 集合; 119 = 集合型; 项 + 2 = 项; }
        否则如果 (转 ?= 115) { 1 = 集合; 115 = 集合型; 项 + 2 = 项; }
        否则如果 (转 ?= 117) {
            (模式, 项 + 2)十六进制值 = 低;
            转 = 高;
            项 + 6 = 项;
        }
        否则如果 (转 ?= 110) { 10 = 低; 10 = 高; 项 + 2 = 项; }
        否则如果 (转 ?= 114) { 13 = 低; 13 = 高; 项 + 2 = 项; }
        否则如果 (转 ?= 116) { 9 = 低; 9 = 高; 项 + 2 = 项; }
        否则 { 转 = 低; 转 = 高; 项 + 2 = 项; }
    } 否则 {
        首 = 低;
        首 = 高;
        项 + 1 = 项;
    }
    如果 (集合 ?= 0) {
        如果 (项 < 止) {
            (模式, 项)字符码 = 隔;
            如果 (隔 ?= 45) {
                项 + 1 = 项;
                (模式, 项)字符码 = 首2;
                如果 (首2 ?= 92) {
                    (模式, 项 + 1)字符码 = 转2;
                    如果 (转2 ?= 117) {
                        (模式, 项 + 2)十六进制值 = 高;
                    } 否则 {
                        转2 = 高;
                    }
                } 否则 {
                    首2 = 高;
                }
            }
        }
    }
    如果 (集合 ?= 1) {
        如果 (集合型 ?= 100) { (码)是数字 = 结果; }
        否则如果 (集合型 ?= 119) { (码)是词 = 结果; }
        否则 { (码)是空白 = 结果; }
    } 否则 {
        如果 (低 <= 码 && 码 <= 高) { 1 = 结果; }
    }
}

// ── 字符类匹配：位置字符是否属于 [起,止) 描述 ────────────
函数 (模式:字符串, 起:整数, 止:整数, 文本:字符串, 位置:整数)类别匹配(0 = 结果:整数) {
    全局文本长 = 文本长;
    0 - 1 = 结果;
    如果 (位置 < 文本长) {
        (文本, 位置)字符码 = 码;
        (模式, 起)字符码 = 首;
        起 = 项;
        0 = 取反;
        如果 (首 ?= 94) { 1 = 取反; 起 + 1 = 项; }
        0 = 命中;
        当 (项 < 止) {
            (模式, 项, 止)单元素末端 = 末;
            如果 (末 < 止) {
                (模式, 末)字符码 = 隔;
                如果 (隔 ?= 45) {
                    (模式, 末 + 1, 止)单元素末端 = 末2;
                    末2 = 末;
                }
            }
            (模式, 项, 末, 码)类别项命中 = 本命中;
            如果 (本命中 ?= 1) { 1 = 命中; }
            末 = 项;
        }
        如果 (取反 ?= 1) {
            如果 (命中 ?= 0) { 1 = 命中; }
            否则 { 0 = 命中; }
        }
        如果 (命中 ?= 1) { 位置 + 1 = 结果; }
    }
}

// ── 找配对括号：返回闭合位置，未找到返回 止 ──────────────
函数 (模式:字符串, 起:整数, 止:整数, 左码:整数, 右码:整数)找配对(0 = 结果:整数) {
    止 = 结果;
    起 = 位置;
    0 = 深度;
    0 = 命中;
    当 (位置 < 止) {
        如果 (命中 ?= 0) {
            (模式, 位置)字符码 = 码;
            如果 (码 ?= 左码) { 深度 + 1 = 深度; }
            否则如果 (码 ?= 右码) {
                深度 - 1 = 深度;
                如果 (深度 ?= 0) { 位置 = 结果; 1 = 命中; }
            }
            位置 + 1 = 位置;
        } 否则 {
            中断;
        }
    }
}

// ── 原子匹配一次：返回新位置或 -1 ────────────────────────
函数 (模式:字符串, 原子起:整数, 原子止:整数, 文本:字符串, 位置:整数)匹配原子一次(0 = 结果:整数) {
    全局文本长 = 文本长;
    (模式, 原子起)字符码 = 首;
    0 - 1 = 结果;
    如果 (首 ?= 40) {              // 分组
        (模式, 原子起 + 1, 原子止 - 1, 文本, 位置)匹配选择 = 结果;
    } 否则如果 (首 ?= 91) {       // 字符类
        (模式, 原子起 + 1, 原子止 - 1, 文本, 位置)类别匹配 = 结果;
    } 否则如果 (首 ?= 46) {       // 任意字符
        如果 (位置 < 文本长) { 位置 + 1 = 结果; }
    } 否则如果 (首 ?= 92) {       // 转义（字符类外）
        如果 (原子起 + 1 < 原子止 && 位置 < 文本长) {
            (模式, 原子起 + 1)字符码 = 转;
            (文本, 位置)字符码 = 文;
            0 = 子命中;
            如果 (转 ?= 100) { (文)是数字 = 子命中; }
            否则如果 (转 ?= 119) { (文)是词 = 子命中; }
            否则如果 (转 ?= 115) { (文)是空白 = 子命中; }
            否则如果 (转 ?= 110) { 如果 (文 ?= 10) { 1 = 子命中; } }
            否则如果 (转 ?= 114) { 如果 (文 ?= 13) { 1 = 子命中; } }
            否则如果 (转 ?= 116) { 如果 (文 ?= 9) { 1 = 子命中; } }
            否则 { 如果 (文 ?= 转) { 1 = 子命中; } }
            如果 (子命中 ?= 1) { 位置 + 1 = 结果; }
        }
    } 否则 {                      // 字面量
        如果 (位置 < 文本长) {
            (文本, 位置)字符码 = 文;
            如果 (文 ?= 首) { 位置 + 1 = 结果; }
        }
    }
}

// ── 序列匹配：返回末位置或 -1 ────────────────────────────
函数 (模式:字符串, 起:整数, 止:整数, 文本:字符串, 位置:整数)匹配序列(0 = 结果:整数) {
    起 = 游标;
    位置 = 当前;
    0 - 1 = 结果;
    0 = 失败;
    当 (游标 < 止) {
        如果 (失败 ?= 1) {
            中断;
        } 否则 {
            (模式, 游标)字符码 = 首;
            游标 + 1 = 原子末;
            如果 (首 ?= 40) { (模式, 游标, 止, 40, 41)找配对 = 原子末; 原子末 + 1 = 原子末; }
            如果 (首 ?= 91) { (模式, 游标, 止, 91, 93)找配对 = 原子末; 原子末 + 1 = 原子末; }
            如果 (首 ?= 92) { 游标 + 2 = 原子末; }
            0 = 量词;
            如果 (原子末 < 止) {
                (模式, 原子末)字符码 = 量码;
                如果 (量码 ?= 42) { 1 = 量词; }
                如果 (量码 ?= 43) { 2 = 量词; }
                如果 (量码 ?= 63) { 3 = 量词; }
            }
            如果 (量词 ?= 0) {
                (模式, 游标, 原子末, 文本, 当前)匹配原子一次 = 落;
                如果 (落 ?= 0 - 1) { 1 = 失败; }
                否则 { 落 = 当前; }
                原子末 = 游标;
            } 否则 {
                (模式, 游标, 原子末, 文本, 当前)匹配原子一次 = 首落;
                如果 (首落 ?= 0 - 1) {
                    如果 (量词 ?= 2) { 1 = 失败; }
                } 否则 {
                    首落 = 当前;
                    0 = 停;
                    当 (停 ?= 0) {
                        (模式, 游标, 原子末, 文本, 当前)匹配原子一次 = 再落;
                        如果 (再落 ?= 0 - 1) { 1 = 停; }
                        否则如果 (再落 ?= 当前) { 1 = 停; }
                        否则 { 再落 = 当前; }
                    }
                }
                原子末 + 1 = 游标;
            }
        }
    }
    如果 (失败 ?= 0) { 当前 = 结果; }
}

// ── 有序选择：返回末位置或 -1 ────────────────────────────
函数 (模式:字符串, 起:整数, 止:整数, 文本:字符串, 位置:整数)匹配选择(0 = 结果:整数) {
    0 - 1 = 结果;
    起 = 段起;
    0 = 深度;
    起 = 游标;
    0 = 停止;
    当 (游标 <= 止 && 停止 ?= 0) {
        如果 (游标 >= 止) {
            (模式, 段起, 止, 文本, 位置)匹配序列 = 结;
            如果 (结 >= 0) { 结 = 结果; }
            1 = 停止;
        } 否则 {
            (模式, 游标)字符码 = 字;
            如果 (字 ?= 40 || 字 ?= 91) { 深度 + 1 = 深度; }
            如果 (字 ?= 41 || 字 ?= 93) { 如果 (深度 > 0) { 深度 - 1 = 深度; } }
            0 = 是隔;
            如果 (深度 ?= 0) { 如果 (字 ?= 124) { 1 = 是隔; } }
            如果 (是隔 ?= 1) {
                (模式, 段起, 游标, 文本, 位置)匹配序列 = 结;
                如果 (结 >= 0) { 结 = 结果; 1 = 停止; }
                否则 { 游标 + 1 = 段起; }
            }
            游标 + 1 = 游标;
        }
    }
}

// ── 对外：从 起始 匹配 模式，返回结束位置或 -1 ────────────
函数 (文本:字符串, 模式:字符串, 起始:整数)正则匹配(0 = 结果:整数) {
    如果 (长已备 ?= 0) { (文本)长度 = 全局文本长; }
    (模式)长度 = 模式长;
    起始 = 位置;
    (模式, 0, 模式长, 文本, 位置)匹配选择 = 结果;
}

// ── 玩具 token 化 ────────────────────────────────────────
函数 (输入:字符串)词法扫描(0 = 结果:整数) {
    (输入)长度 = 输入长;
    0 = 位置;
    当 (位置 < 输入长) {
        (输入, 位置)字符码 = 首;
        (首)是空白 = 白;
        如果 (白 ?= 1) {
            位置 + 1 = 位置;
        } 否则 {
            (输入, "[0-9]+", 位置)正则匹配 = 数字末;
            如果 (数字末 >= 0) {
                (输入, 位置, 数字末 - 位置)子串 = 词文本;
                ("整数:")打印;
                (词文本)打印;
                数字末 = 位置;
            } 否则 {
                (输入, "[A-Za-z_一-龥][A-Za-z0-9_一-龥]*", 位置)正则匹配 = 标识末;
                如果 (标识末 >= 0) {
                    (输入, 位置, 标识末 - 位置)子串 = 词文本;
                    ("标识符:")打印;
                    (词文本)打印;
                    标识末 = 位置;
                } 否则 {
                    (输入, 位置, 1)子串 = 词文本;
                    ("符号:")打印;
                    (词文本)打印;
                    位置 + 1 = 位置;
                }
            }
        }
    }
}

函数 词法自测 {
    // 正则匹配探针（返回结束位置，-1 表示不匹配）
    ("abc123", "[a-z]+", 0)正则匹配 = 结果;
    (结果)打印;                                    // 3
    ("abc123", "[0-9]+", 3)正则匹配 = 结果;
    (结果)打印;                                    // 6
    ("foo bar", "[A-Za-z]+", 4)正则匹配 = 结果;
    (结果)打印;                                    // 7
    ("zabq", "(ab|cd)", 1)正则匹配 = 结果;
    (结果)打印;                                    // 3
    ("zcdq", "(ab|cd)", 1)正则匹配 = 结果;
    (结果)打印;                                    // 3
    ("a12b", "[a-z][0-9]+", 0)正则匹配 = 结果;
    (结果)打印;                                    // 3
    ("aaa", "a*", 0)正则匹配 = 结果;
    (结果)打印;                                    // 3
    ("bbb", "a*b", 0)正则匹配 = 结果;
    (结果)打印;                                    // 1
    ("z1", "[0-9]+", 0)正则匹配 = 结果;
    (结果)打印;                                    // -1
    // 玩具 token 流
    ("函数 foo(12) 如果")词法扫描 = 占位;
}
