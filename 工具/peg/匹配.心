// 工具/peg/匹配.心 — 解释模式：把输入按文法规则解析为通用 CST（不执行语义动作）
// 依赖 词法.心（正则匹配）与 文法.心（令牌表/跳过表/规则表 + 解析文法）。
// 用法：程序 文法文件 输入文件   → 打印 CST。
导入 "词法.心";
导入 "文法.心";

"" = 变量 令牌文本;      // 动态字符串数组：token 文本
"" = 变量 令牌类型;      // 动态字符串数组：token 类型名（%token 名 / 符号）
0 = 变量 令牌数;
0 = 变量 匹成功;
0 = 变量 匹位置;
"" = 变量 匹节点;
0 = 变量 主成功;
0 = 变量 主位置;
"" = 变量 主节点;
0 = 变量 主起;
0 = 变量 主末;
0 = 变量 项游标;
0 = 变量 保存位置;
0 = 变量 前瞻;
0 = 变量 负前瞻;
0 = 变量 有量词;
0 = 变量 量型;
0 = 变量 累成功;
0 = 变量 累位置;
"" = 变量 累节点;

// ── 小工具 ────────────────────────────────────────────────
函数 (码:整数)是名符(0 = 结果:整数) {
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
    如果 (码 >= 65 && 码 <= 90) { 1 = 结果; }
    如果 (码 >= 97 && 码 <= 122) { 1 = 结果; }
    如果 (码 ?= 95) { 1 = 结果; }
    如果 (码 >= 128) { 1 = 结果; }
}

函数 (a:字符串, b:字符串)字符串相等(0 = 结果:整数) {
    (a)长度 = 长a;
    (b)长度 = 长b;
    如果 (长a ?= 长b) {
        (a, b)字符串开头 = 前缀;
        如果 (前缀 ?= 1) { 1 = 结果; }
    }
}

函数 (位置:整数)取令牌文本(0 = 结果:字符串) {
    (令牌文本, 位置)动态字符串数组获取 = 结果;
}

// 在 规则表 中查 名 的表达式；未找到返回 ""
函数 (名:字符串)查规则(0 = 结果:字符串) {
    "" = 结果;
    (规则表)分割行数 = 行数;
    0 = i;
    当 (i < 行数) {
        (规则表, i)获取行 = 行;
        (行)长度 = 行长;
        (行, 58)找码 = 冒号;
        如果 (冒号 < 行长) {
            (行, 0, 冒号)子串 = 键;
            (键, 名)字符串相等 = 等;
            如果 (等 ?= 1) {
                (行, 冒号 + 1, 行长 - 冒号 - 1)子串 = 结果;
                中断;
            }
        }
        i + 1 = i;
    }
}

// 名 是否为 %token 名
函数 (名:字符串)是令牌名(0 = 结果:整数) {
    0 = 结果;
    (令牌表)分割行数 = 行数;
    0 = i;
    当 (i < 行数) {
        (令牌表, i)获取行 = 行;
        (行)长度 = 行长;
        (行, 58)找码 = 冒号;
        如果 (冒号 < 行长) {
            (行, 0, 冒号)子串 = 键;
            (键, 名)字符串相等 = 等;
            如果 (等 ?= 1) { 1 = 结果; 中断; }
        }
        i + 1 = i;
    }
}

// ── 分词：按 跳过表/%token 把输入切成 token 流 ─────────────
函数 (输入:字符串, 位置:整数)跳过空白(0 = 新位置:整数) {
    位置 = 新位置;
    1 = 再跳;
    当 (再跳 ?= 1) {
        0 = 推进;
        (跳过表)分割行数 = 行数;
        0 = si;
        当 (si < 行数) {
            (跳过表, si)获取行 = 行;
            (行)长度 = 行长;
            (行, 58)找码 = 冒号;
            如果 (冒号 < 行长) {
                (行, 冒号 + 1, 行长 - 冒号 - 1)子串 = 模式;
                (输入, 模式, 新位置)正则匹配 = 末;
                如果 (末 > 新位置) { 末 = 新位置; 1 = 推进; }
            }
            si + 1 = si;
        }
        如果 (推进 ?= 0) { 0 = 再跳; }
    }
}

函数 (输入:字符串)分词(无) {
    ()创建动态字符串数组 = 令牌文本;
    ()创建动态字符串数组 = 令牌类型;
    (输入)长度 = 输入长;
    0 = 位置;
    当 (位置 < 输入长) {
        (输入, 位置)跳过空白 = 位置;
        如果 (位置 >= 输入长) { 中断; }
        "" = 最佳类型;
        "" = 最佳文本;
        0 = 最佳末;
        (令牌表)分割行数 = 令牌行数;
        0 = ti;
        当 (ti < 令牌行数) {
            (令牌表, ti)获取行 = 行;
            (行)长度 = 行长;
            (行, 58)找码 = 冒号;
            如果 (冒号 < 行长) {
                (行, 0, 冒号)子串 = 名;
                (行, 冒号 + 1, 行长 - 冒号 - 1)子串 = 模式;
                (输入, 模式, 位置)正则匹配 = 末;
                如果 (末 > 最佳末) { 末 = 最佳末; 名 = 最佳类型; }
            }
            ti + 1 = ti;
        }
        如果 (最佳末 > 位置) {
            (输入, 位置, 最佳末 - 位置)子串 = 最佳文本;
            最佳末 = 位置;
        } 否则 {
            (输入, 位置, 1)子串 = 最佳文本;
            "符号" = 最佳类型;
            位置 + 1 = 位置;
        }
        (令牌文本, 最佳文本)动态字符串数组添加;
        (令牌类型, 最佳类型)动态字符串数组添加;
    }
    (令牌文本)动态字符串数组大小 = 令牌数;
}

// ── PEG 解释器 ────────────────────────────────────────────
// 匹配主：解析一个主表达式（字面量 / 分组 / . / 规则名）
函数 (表达式:字符串, 起:整数, 止:整数, 项起:整数, 位置:整数)匹配主(无) {
    0 = 主成功;
    位置 = 主位置;
    项起 = 主末;
    (表达式, 项起)字符码 = 首;
    如果 (首 ?= 39 || 首 ?= 34) {
        项起 + 1 = 扫描;
        0 = 闭合;
        当 (扫描 < 止 && 闭合 ?= 0) {
            (表达式, 扫描)字符码 = c;
            如果 (c ?= 首) { 扫描 = 闭合; }
            扫描 + 1 = 扫描;
        }
        如果 (闭合 ?= 0) { 0 = 主成功; }
        否则 {
            (表达式, 项起 + 1, 闭合 - 项起 - 1)子串 = 字面;
            闭合 + 1 = 主末;
            如果 (位置 < 令牌数) {
                (位置)取令牌文本 = 本文;
                (本文, 字面)字符串相等 = 等;
                如果 (等 ?= 1) { 1 = 主成功; 字面 = 主节点; 位置 + 1 = 主位置; }
            }
        }
    } 否则如果 (首 ?= 40) {
        项起 + 1 = 内起;
        0 = 深度;
        0 = 闭合;
        内起 = 扫描;
        当 (扫描 < 止 && 闭合 ?= 0) {
            (表达式, 扫描)字符码 = c;
            如果 (c ?= 40) { 深度 + 1 = 深度; }
            如果 (c ?= 41) {
                如果 (深度 ?= 0) { 扫描 = 闭合; }
                否则 { 深度 - 1 = 深度; }
            }
            扫描 + 1 = 扫描;
        }
        如果 (闭合 ?= 0) { 0 = 主成功; }
        否则 {
            (表达式, 内起, 闭合, 位置)匹配或;
            闭合 + 1 = 主末;
            匹成功 = 主成功;
            匹位置 = 主位置;
            匹节点 = 主节点;
        }
    } 否则如果 (首 ?= 46) {
        项起 + 1 = 主末;
        如果 (位置 < 令牌数) {
            1 = 主成功;
            (位置)取令牌文本 = 主节点;
            位置 + 1 = 主位置;
        }
    } 否则 {
        项起 = 名末;
        当 (名末 < 止) {
            (表达式, 名末)字符码 = c;
            (c)是名符 = 是名;
            如果 (是名 ?= 1) { 名末 + 1 = 名末; } 否则 { 中断; }
        }
        名末 = 主末;
        如果 (主末 > 项起) {
            (表达式, 项起, 主末 - 项起)子串 = 名;
            (名)是令牌名 = 是令;
            如果 (是令 ?= 1) {
                // %token 终结符：按 token 类型匹配
                如果 (位置 < 令牌数) {
                    (令牌类型, 位置)动态字符串数组获取 = 此类型;
                    (此类型, 名)字符串相等 = 同类;
                    如果 (同类 ?= 1) {
                        1 = 主成功;
                        (位置)取令牌文本 = 主节点;
                        位置 + 1 = 主位置;
                    }
                }
            } 否则 {
                (名, 位置)规则匹配;
                名末 = 主末;
                匹成功 = 主成功;
                匹位置 = 主位置;
                匹节点 = 主节点;
            }
        } 否则 { 0 = 主成功; }
    }
}

// 匹配项：前缀 + 主 + 量词
函数 (表达式:字符串, 起:整数, 止:整数, 项起:整数, 位置:整数)匹配项(无) {
    0 = 匹成功;
    位置 = 保存位置;
    位置 = 匹位置;
    项起 = 项游标;
    0 = 前瞻;
    0 = 负前瞻;
    0 = 有标;
    "" = 标名;
    如果 (项游标 < 止) {
        (表达式, 项游标)字符码 = 前缀;
        如果 (前缀 ?= 38) { 1 = 前瞻; 项游标 + 1 = 项游标; }
        否则如果 (前缀 ?= 33) { 1 = 负前瞻; 项游标 + 1 = 项游标; }
    }
    // 标签 名: —— 记录标签名并跳过
    如果 (项游标 < 止) {
        (表达式, 项游标)字符码 = 标首;
        (标首)是名符 = 是标名;
        如果 (是标名 ?= 1) {
            项游标 = 标末;
            当 (标末 < 止) { (表达式, 标末)字符码 = 标c; (标c)是名符 = 标f; 如果 (标f ?= 1) { 标末 + 1 = 标末; } 否则 { 中断; } }
            如果 (标末 < 止) {
                (表达式, 标末)字符码 = 标c;
                如果 (标c ?= 58) { 1 = 有标; (表达式, 项游标, 标末 - 项游标)子串 = 标名; 标末 + 1 = 项游标; }
            }
        }
    }
    项游标 = 主起;
    (表达式, 起, 止, 主起, 位置)匹配主;
    主末 = 项游标;
    0 = 有量词;
    0 = 量型;
    如果 (项游标 < 止) {
        (表达式, 项游标)字符码 = 量码;
        如果 (量码 ?= 42) { 1 = 有量词; 1 = 量型; }
        如果 (量码 ?= 43) { 1 = 有量词; 2 = 量型; }
        如果 (量码 ?= 63) { 1 = 有量词; 3 = 量型; }
    }
    如果 (有量词 ?= 1) { 项游标 + 1 = 项游标; }
    如果 (有量词 ?= 0 || 量型 ?= 3) {
        如果 (主成功 ?= 0) {
            如果 (量型 ?= 3) {
                1 = 主成功;
                保存位置 = 主位置;
                "" = 主节点;
            }
        }
        主成功 = 匹成功;
        主位置 = 匹位置;
        主节点 = 匹节点;
    } 否则 {
        1 = 累成功;
        保存位置 = 累位置;
        "" = 累节点;
        如果 (主成功 ?= 1) {
            主位置 = 累位置;
            主节点 = 累节点;
        } 否则 {
            如果 (量型 ?= 2) { 0 = 累成功; }
        }
        如果 (累成功 ?= 1) {
            0 = 停;
            当 (停 ?= 0) {
                (表达式, 起, 止, 主起, 累位置)匹配主;
                如果 (主成功 ?= 1) {
                    如果 (主位置 > 累位置) {
                        累节点 + " " + 主节点 = 累节点;
                        主位置 = 累位置;
                    } 否则 { 1 = 停; }
                } 否则 { 1 = 停; }
            }
        }
        累成功 = 匹成功;
        累位置 = 匹位置;
        累节点 = 匹节点;
    }
    如果 (前瞻 ?= 1) {
        如果 (匹成功 ?= 1) {
            保存位置 = 匹位置;
            "" = 匹节点;
        }
    } 否则如果 (负前瞻 ?= 1) {
        如果 (匹成功 ?= 1) { 0 = 匹成功; }
        否则 { 1 = 匹成功; 保存位置 = 匹位置; "" = 匹节点; }
    }
    如果 (有标 ?= 1) {
        如果 (匹成功 ?= 1) {
            标名 + "=" = 标节点;
            标节点 + 匹节点 = 匹节点;
        }
    }
}

// 跳过引号串（位置指向开引号）；返回闭引号位置
函数 (文本:字符串, 位置:整数, 止:整数, Q:整数)跳引号匹(0 = 结果:整数) {
    0 = 码;
    位置 + 1 = 结果;
    当 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 92) { 结果 + 1 = 结果; }
        否则如果 (码 ?= Q) { 中断; }
        结果 + 1 = 结果;
    }
}

// 跳过花括号组（位置指向 '{'）；返回 '}' 位置
函数 (文本:字符串, 位置:整数, 止:整数)跳花括号匹(0 = 结果:整数) {
    0 = 层;
    0 = 码;
    位置 + 1 = 结果;
    当 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 39) { (文本, 结果, 止, 39)跳引号匹 = 结果; }
        否则如果 (码 ?= 34) { (文本, 结果, 止, 34)跳引号匹 = 结果; }
        否则如果 (码 ?= 123) { 层 + 1 = 层; }
        否则如果 (码 ?= 125) { 如果 (层 ?= 0) { 中断; } 层 - 1 = 层; }
        结果 + 1 = 结果;
    }
}

// 匹序列：逐项匹配
函数 (表达式:字符串, 起:整数, 止:整数, 位置:整数)匹序列(无) {
    起 = 游标;
    位置 = 当前;
    1 = 成功;
    "" = 节点累;
    "" = 动作;
    0 = 动作长;
    0 = 动末;
    0 = 码;
    当 (游标 < 止 && 成功 ?= 1) {
        当 (游标 < 止) {
            (表达式, 游标)字符码 = 空格码;
            如果 (空格码 ?= 32 || 空格码 ?= 9) { 游标 + 1 = 游标; }
            否则 { 中断; }
        }
        如果 (游标 < 止) {
            (表达式, 游标)字符码 = 码;
            如果 (码 ?= 123) {
                (表达式, 游标, 止)跳花括号匹 = 动末;
                (表达式, 游标 + 1, 动末 - 游标 - 1)子串 = 动作;
                动末 + 1 = 游标;
                中断;
            }
            (表达式, 起, 止, 游标, 当前)匹配项;
            如果 (匹成功 ?= 0) { 0 = 成功; }
            否则 {
                项游标 = 游标;
                匹位置 = 当前;
                (节点累)长度 = 节点长;
                (匹节点)长度 = 匹长;
                如果 (节点长 ?= 0) { 匹节点 = 节点累; }
                否则如果 (匹长 ?= 0) { }
                否则 { 节点累 + " " + 匹节点 = 节点累; }
            }
        }
    }
    1 = 匹成功;
    当前 = 匹位置;
    (动作)长度 = 动作长;
    如果 (动作长 ?= 0) { } 否则 { 节点累 + " {" + 动作 + "}" = 节点累; }
    节点累 = 匹节点;
    如果 (成功 ?= 0) { 0 = 匹成功; }
}

// 匹配或：顶层 '/' 有序选择
函数 (表达式:字符串, 起:整数, 止:整数, 位置:整数)匹配或(无) {
    0 = 匹成功;
    起 = 段起;
    0 = 深度;
    0 = 引号;
    起 = 游标;
    0 = 停止;
    当 (游标 <= 止 && 停止 ?= 0) {
        如果 (游标 >= 止) {
            (表达式, 段起, 止, 位置)匹序列;
            1 = 停止;
        } 否则 {
            (表达式, 游标)字符码 = 字;
            如果 (引号 ?= 0) {
                如果 (字 ?= 39 || 字 ?= 34) { 字 = 引号; }
                否则 {
                    如果 (字 ?= 40 || 字 ?= 91) { 深度 + 1 = 深度; }
                    如果 (字 ?= 41 || 字 ?= 93) { 如果 (深度 > 0) { 深度 - 1 = 深度; } }
                    0 = 是隔;
                    如果 (深度 ?= 0) { 如果 (字 ?= 47) { 1 = 是隔; } }
                    如果 (是隔 ?= 1) {
                        (表达式, 段起, 游标, 位置)匹序列;
                        如果 (匹成功 ?= 1) { 1 = 停止; }
                        否则 { 游标 + 1 = 段起; }
                    }
                }
            } 否则 {
                如果 (字 ?= 引号) { 0 = 引号; }
            }
            游标 + 1 = 游标;
        }
    }
}

// 规则匹配：查规则表 + 解析 + 包装 CST
函数 (名:字符串, 位置:整数)规则匹配(无) {
    0 = 匹成功;
    (名)查规则 = 表达式;
    (表达式)长度 = 表达式长;
    如果 (表达式长 ?= 0) { }
    否则 {
         (表达式, 0, 表达式长, 位置)匹配或;
         如果 (匹成功 ?= 1) {
            "(" + 名 = 节点包;
            节点包 + " " = 节点包;
            节点包 + 匹节点 = 节点包;
            节点包 + ")" = 节点包;
            节点包 = 匹节点;
        }
    }
}

// 解释模式：读文法与输入，分词后按 程序 规则匹配，打印 CST
函数 (文法路径:字符串, 输入路径:字符串)识别(无) {
    (文法路径)读取文件 = 文法文本;
    (文法文本)解析文法;
    (输入路径)读取文件 = 输入文本;
    (输入文本)分词;
    (令牌数)打印;
    ("程序", 0)规则匹配;
    如果 (匹成功 ?= 1) { (匹节点)打印; }
    否则 { ("解析失败")打印; }
}

函数 匹配自测 {
    (1)获取参数 = 文法路径;
    (2)获取参数 = 输入路径;
    (文法路径, 输入路径)识别;
}
