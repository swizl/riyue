// PEG 工具命令行入口
//   识别 <文法> <输入>   解释模式：输出通用 CST
//   生成 <文法> <输出>   生成模式：输出 日月 递归下降解析器源码
函数 主程序 {
    (1)获取参数 = 命令;
    (2)获取参数 = 目标文法;
    (3)获取参数 = 目标路径;
    如果 (命令 ?= "识别") {
        (目标文法, 目标路径)识别;
    } 否则如果 (命令 ?= "生成") {
        (目标文法, 目标路径)生成解析器;
    } 否则 {
        ("用法: 识别 <文法> <输入> | 生成 <文法> <输出>")输出错误;
    }
}
