        否则如果 (码 ?= 34) { (文本, 扫, 止, 34)跳引号 = 扫; 扫 + 1 = 扫; }
        否则如果 (码 ?= 40) { 深度 + 1 = 深度; 扫 + 1 = 扫; }
        否则如果 (码 ?= 41) { 深度 - 1 = 深度; 扫 + 1 = 扫; }
        否则如果 (码 ?= 123) {
            如果 (深度 ?= 0) {
