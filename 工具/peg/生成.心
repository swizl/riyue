// PEG 生成模式：读文法，为每条规则生成 日月 递归下降解析器源码
// 依赖：匹配.心（提供 分词/字符串相等/是名符/是令牌名 + 运行时函数）

导入 "匹配.心";

// 生成器全局
"" = 变量 输出;          // 生成结果累积
"" = 变量 缓冲;          // 捕集缓冲
"" = 变量 缓冲外;        // 外层缓冲保存
0 = 变量 捕集;           // 1=发 写入缓冲
0 = 变量 捕集外;         // 外层捕集状态保存
"" = 变量 换行;
"" = 变量 引;            // 双引号字符
0 = 变量 临时号;         // 唯一临时名计数
"" = 变量 段表;          // 收集段/项 共用数组（临时）
"" = 变量 项表;
0 = 变量 丢弃;

// 发一行（捕集感知）
函数 (文本:字符串)发(无) {
    如果 (捕集 ?= 1) {
        缓冲 + 文本 = 缓冲;
        缓冲 + 换行 = 缓冲;
    } 否则 {
        输出 + 文本 = 输出;
        输出 + 换行 = 输出;
    }
}

// 追加原始文本（不换行）
函数 (文本:字符串)发原(无) {
    如果 (捕集 ?= 1) {
        缓冲 + 文本 = 缓冲;
    } 否则 {
        输出 + 文本 = 输出;
    }
}

// 生成唯一名：前缀 + 计数
函数 (前缀:字符串)新名(0 = 结果:字符串) {
    临时号 + 1 = 临时号;
    前缀 + (临时号)转字符串 = 结果;
}

// 跳过引号串（位置指向开引号，Q 为引号码）；返回闭引号位置
函数 (文本:字符串, 位置:整数, 止:整数, Q:整数)跳引号(0 = 结果:整数) {
    0 = 码;
    位置 + 1 = 结果;
    当 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= Q) { 中断; }
        结果 + 1 = 结果;
    }
}

// 跳过括号组（位置指向 '('）；返回 ')' 位置
函数 (文本:字符串, 位置:整数, 止:整数)跳括号(0 = 结果:整数) {
    0 = 层;
    0 = 码;
    位置 + 1 = 结果;
    当 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 39) { (文本, 结果, 止, 39)跳引号 = 结果; }
        否则如果 (码 ?= 34) { (文本, 结果, 止, 34)跳引号 = 结果; }
        否则如果 (码 ?= 40) { 层 + 1 = 层; }
        否则如果 (码 ?= 41) { 如果 (层 ?= 0) { 中断; } 层 - 1 = 层; }
        结果 + 1 = 结果;
    }
}

// 跳过花括号组（位置指向 '{'）；返回 '}' 位置
函数 (文本:字符串, 位置:整数, 止:整数)跳花括号(0 = 结果:整数) {
    0 = 层;
    0 = 码;
    位置 + 1 = 结果;
    当 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 39) { (文本, 结果, 止, 39)跳引号 = 结果; }
        否则如果 (码 ?= 34) { (文本, 结果, 止, 34)跳引号 = 结果; }
        否则如果 (码 ?= 123) { 层 + 1 = 层; }
        否则如果 (码 ?= 125) { 如果 (层 ?= 0) { 中断; } 层 - 1 = 层; }
        结果 + 1 = 结果;
    }
}

// 跳过一个项（前缀 &/! + 主 + 量词），返回项末位置
函数 (文本:字符串, 位置:整数, 止:整数)跳项(0 = 结果:整数) {
    0 = 码;
    0 = 名符;
    0 = 扫;
    位置 = 结果;
    当 (结果 < 止) { (文本, 结果)字符码 = 码; 如果 (码 ?= 32) { 结果 + 1 = 结果; } 否则 { 中断; } }
    如果 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 38) { 结果 + 1 = 结果; }
        否则如果 (码 ?= 33) { 结果 + 1 = 结果; }
    }
    当 (结果 < 止) { (文本, 结果)字符码 = 码; 如果 (码 ?= 32) { 结果 + 1 = 结果; } 否则 { 中断; } }
    // 标签 名: —— 跳过标签名与冒号
    如果 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        (码)是名符 = 名符;
        如果 (名符 ?= 1) {
            结果 = 扫;
            当 (扫 < 止) { (文本, 扫)字符码 = 码; (码)是名符 = 名符; 如果 (名符 ?= 1) { 扫 + 1 = 扫; } 否则 { 中断; } }
            如果 (扫 < 止) {
                (文本, 扫)字符码 = 码;
                如果 (码 ?= 58) { 扫 + 1 = 结果; 当 (结果 < 止) { (文本, 结果)字符码 = 码; 如果 (码 ?= 32) { 结果 + 1 = 结果; } 否则 { 中断; } } }
            }
        }
    }
    如果 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 39) { (文本, 结果, 止, 39)跳引号 = 结果; 结果 + 1 = 结果; }
        否则如果 (码 ?= 34) { (文本, 结果, 止, 34)跳引号 = 结果; 结果 + 1 = 结果; }
        否则如果 (码 ?= 40) { (文本, 结果, 止)跳括号 = 结果; 结果 + 1 = 结果; }
        否则如果 (码 ?= 46) { 结果 + 1 = 结果; }
        否则 {
            当 (结果 < 止) {
                (文本, 结果)字符码 = 码;
                (码)是名符 = 名符;
                如果 (名符 ?= 0) { 中断; }
                结果 + 1 = 结果;
            }
        }
    }
    当 (结果 < 止) { (文本, 结果)字符码 = 码; 如果 (码 ?= 32) { 结果 + 1 = 结果; } 否则 { 中断; } }
    如果 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 42) { 结果 + 1 = 结果; }
        否则如果 (码 ?= 43) { 结果 + 1 = 结果; }
        否则如果 (码 ?= 63) { 结果 + 1 = 结果; }
    }
}

// 收集序列项到 项表，返回项数
函数 (文本:字符串, 起:整数, 止:整数)收集项(0 = 结果:整数) {
    0 = 码;
    0 = 数;
    0 = 位置;
    0 = 项起;
    ()创建动态字符串数组 = 项表;
    起 = 位置;
    当 (位置 < 止) {
        当 (位置 < 止) { (文本, 位置)字符码 = 码; 如果 (码 ?= 32) { 位置 + 1 = 位置; } 否则 { 中断; } }
        如果 (位置 < 止) {
            (文本, 位置)字符码 = 码;
            如果 (码 ?= 123) { (文本, 位置, 止)跳花括号 = 位置; 位置 + 1 = 位置; }
            否则 {
                位置 = 项起;
                (文本, 位置, 止)跳项 = 位置;
                如果 (位置 ?= 项起) { 位置 + 1 = 位置; }
                (文本, 项起, 位置 - 项起)子串 = 段表;
                (项表, 段表)动态字符串数组添加;
                数 + 1 = 数;
            }
        }
    }
    数 = 结果;
}

// 收集有序选择各段到 段表，返回段数
函数 (文本:字符串, 起:整数, 止:整数)收集段(0 = 结果:整数) {
    0 = 码;
    0 = 数;
    0 = 位置;
    0 = 段起;
    ()创建动态字符串数组 = 段表;
    起 = 位置;
    起 = 段起;
    当 (位置 < 止) {
        (文本, 位置)字符码 = 码;
        如果 (码 ?= 47) {
            (文本, 段起, 位置 - 段起)子串 = 名;
            (段表, 名)动态字符串数组添加;
            数 + 1 = 数;
            位置 + 1 = 段起;
            位置 + 1 = 位置;
        }
        否则如果 (码 ?= 39) { (文本, 位置, 止, 39)跳引号 = 位置; }
        否则如果 (码 ?= 34) { (文本, 位置, 止, 34)跳引号 = 位置; }
        否则如果 (码 ?= 40) { (文本, 位置, 止)跳括号 = 位置; }
        否则 { 位置 + 1 = 位置; }
    }
    位置 = 位置;
    (文本, 段起, 位置 - 段起)子串 = 名;
    (段表, 名)动态字符串数组添加;
    数 + 1 = 数;
    数 = 结果;
}

// 生成字面量匹配（token 文本等于 字面）
函数 (字面:字符串)生字面匹配(无) {
    ("暂")新名 = 暂A;
    ("暂")新名 = 暂B;
    ("如果 (解析位置 < 令牌数) {")发;
    ("(" + "令牌文本" + ", 解析位置)动态字符串数组获取 = " + 暂A + ";")发;
    ("(" + 暂A + ", " + 引 + 字面 + 引 + ")字符串相等 = " + 暂B + ";")发;
    ("如果 (" + 暂B + " ?= 1) {")发;
    ("(" + "令牌文本" + ", 解析位置)动态字符串数组获取 = 解析结果;")发;
    ("1 = 解析成功;")发;
    ("解析位置 + 1 = 解析位置;")发;
    ("} 否则 { 0 = 解析成功; }")发;
    ("} 否则 { 0 = 解析成功; }")发;
}

// 生成 %token 终结符匹配（token 类型等于 名）
函数 (名:字符串)生令牌匹配(无) {
    ("暂")新名 = 暂A;
    ("暂")新名 = 暂B;
    ("如果 (解析位置 < 令牌数) {")发;
    ("(" + "令牌类型" + ", 解析位置)动态字符串数组获取 = " + 暂A + ";")发;
    ("(" + 暂A + ", " + 引 + 名 + 引 + ")字符串相等 = " + 暂B + ";")发;
    ("如果 (" + 暂B + " ?= 1) {")发;
    ("(" + "令牌文本" + ", 解析位置)动态字符串数组获取 = 解析结果;")发;
    ("1 = 解析成功;")发;
    ("解析位置 + 1 = 解析位置;")发;
    ("} 否则 { 0 = 解析成功; }")发;
    ("} 否则 { 0 = 解析成功; }")发;
}

// 生成 '.' 任意 token
函数 生任意(无) {
    ("如果 (解析位置 < 令牌数) {")发;
    ("(" + "令牌文本" + ", 解析位置)动态字符串数组获取 = 解析结果;")发;
    ("1 = 解析成功;")发;
    ("解析位置 + 1 = 解析位置;")发;
    ("} 否则 { 0 = 解析成功; }")发;
}

// 按名字生成：%token 名→令牌匹配，否则→规则调用
函数 (名:字符串)生名(无) {
    0 = 是令;
    (名)是令牌名 = 是令;
    如果 (是令 ?= 1) { (名)生令牌匹配; }
    否则 { ("()规则" + 名 + ";")发; }
}

// 生成主表达式（位置指向起始）；返回主表达式末位置
函数 (文本:字符串, 位置:整数, 止:整数)生成主(0 = 结果:整数) {
    0 = 码;
    0 = 闭;
    0 = 项起;
    0 = 名符;
    位置 = 结果;
    如果 (结果 < 止) {
        (文本, 结果)字符码 = 码;
        如果 (码 ?= 39) {
            (文本, 结果, 止, 39)跳引号 = 闭;
            (文本, 结果 + 1, 闭 - 结果 - 1)子串 = 名;
            (名)生字面匹配;
            闭 + 1 = 结果;
        }
        否则如果 (码 ?= 34) {
            (文本, 结果, 止, 34)跳引号 = 闭;
            (文本, 结果 + 1, 闭 - 结果 - 1)子串 = 名;
            (名)生字面匹配;
            闭 + 1 = 结果;
        }
        否则如果 (码 ?= 40) {
            (文本, 结果, 止)跳括号 = 闭;
            (文本, 结果 + 1, 闭)生成或;
            闭 + 1 = 结果;
        }
        否则如果 (码 ?= 46) {
            ()生任意;
            结果 + 1 = 结果;
        }
        否则 {
            结果 = 项起;
            当 (结果 < 止) {
                (文本, 结果)字符码 = 码;
                (码)是名符 = 名符;
                如果 (名符 ?= 0) { 中断; }
                结果 + 1 = 结果;
            }
            (文本, 项起, 结果 - 项起)子串 = 名;
            (名)生名;
        }
    }
}

