            (参, 4, 参长 - 4)子串 = 库名;
        } 否则如果 (是常量 ?= 1 && 参长 > 6) {
            (参, 6, 参长 - 6)子串 = 常量名;
        } 否则如果 (输入 ?= "") {
            参 = 输入;
        } 否则 {
            参 = 输出;
        }
        i + 1 = i;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/头文件导入.心 输入.h 输出.心 [--库=库名] [--常量名=枚举名]")打印;
    } 否则 {
        (输入)读取文件 = 原文;
        (原文)去注释 = 净文;
        (净文)行数 = 总行;
        "" = 生成;
        生成 + "// 由 工具/头文件导入.心 从 " + 输入 + " 生成，勿手改。\n" = 生成;
        生成 + "// 外部库: " + 库名 + "\n\n" = 生成;
        "" = 常量块;
        0 = 常量数;
        "" = 枚举块;
        "" = 函数块;
        0 = 枚举数;
        0 = 函数数;
        0 = 跳过数;
        0 = 行;
        当 (行 < 总行) {
            (净文, 行)取行 = 原行;
            (原行)去空白 = 行文;
            (行文)长度 = 行长;
            如果 (行长 > 0) {
                (行文)取首词 = 首词;
                如果 (首词 ?= "#define") {
                    // #define 名 值（仅整数常量）
                    (行文)长度 = 文长;
                    (行文, 7, 文长 - 7)子串 = 余文;
                    (余文)去空白 = 余文;
                    (余文)取首词 = 宏名;
                    (余文)长度 = 余长;
                    (宏名)长度 = 名长;
                    "" = 宏值;
                    如果 (余长 > 名长) {
                        (余文, 名长, 余长 - 名长)子串 = 值文;
                        (值文)去空白 = 宏值;
                    }
                    (宏值)是整数文本 = 是数;
                    如果 (是数 ?= 1) {
                        如果 (常量数 > 0) { 常量块 + ",\n" = 常量块; }
                        // 心字面量只支持十进制，十六进制（0x..）须换算成十进制文本再写出
                        (宏值)文本转数值 = 宏数值;
                        (宏数值)数值文本 = 宏值文;
                        常量块 + "    " + 宏名 + "=" + 宏值文 = 常量块;
                        常量数 + 1 = 常量数;
                    } 否则 {
                        跳过数 + 1 = 跳过数;
                    }
                } 否则如果 (首词 ?= "enum") {
                    // enum [名] { 成员... } —— 收集到 '}' 为止
                    (行文, "{")包含 = 有开;
                    "" = 成员文;
                    0 = 收完;
                    如果 (有开 ?= 1) {
                        (行文)取花括号后 = 片;
                        (片, "}")包含 = 片有闭;
                        如果 (片有闭 ?= 1) {
                            (片)取花括号前 = 片前;
                            成员文 + 片前 = 成员文;
                            1 = 收完;
                        } 否则 {
                            成员文 + 片 = 成员文;
                            成员文 + " " = 成员文;
                        }
                    }
                    当 (收完 ?= 0) {
                        行 + 1 = 行;
                        (净文, 行)取行 = 原行2;
                        (原行2)去空白 = 行文2;
                        (行文2, "}")包含 = 有闭;
                        如果 (有闭 ?= 1) {
                            (行文2)取花括号前 = 片前2;
                            成员文 + 片前2 = 成员文;
                            1 = 收完;
                        } 否则 {
                            成员文 + 行文2 = 成员文;
                            成员文 + " " = 成员文;
                        }
                    }
                    // 枚举名： 'enum' 之后、'{' 之前
                    (行文)取左花括号前 = 头文;
                    (头文)取首词 = 头首;
                    (头文)长度 = 头文长;
                    "" = 枚举名;
                    如果 (头首 ?= "enum" && 头文长 > 4) {
                        (头文, 4, 头文长 - 4)子串 = 名文;
                        (名文)去空白 = 枚举名;
                    }
                    如果 (枚举名 ?= "") { 枚举名 = 常量名; }
                    "" = 成员块;
                    0 = 成员数;
                    0 = 序;
                    0 = k;
                    0 = 停;
                    当 (停 ?= 0) {
                        (成员文, k)第段 = 一段;
                        如果 (一段 ?= "" && k > 0) {
                            1 = 停;
                        } 否则 {
                            如果 (一段 ?= "") { } 否则 {
                                (一段, 0)等号两侧 = 名文2;
                                (一段, 1)等号两侧 = 值文2;
                                (名文2)去空白 = 成员名;
                                "" = 值文3;
                                (值文2)去空白 = 值文3;
                                0 = 成员值;
                                序 = 成员值;
                                如果 (值文3 ?= "") { } 否则 {
                                    (值文3)是整数文本 = 值可;
                                    如果 (值可 ?= 1) {
                                        (值文3)文本转数值 = 成员值;
                                    }
                                }
                                如果 (成员数 > 0) { 成员块 + ",\n" = 成员块; }
                                成员块 + "    " + 成员名 = 成员块;
                                如果 (值文3 ?= "") { } 否则 {
                                    (值文3)是整数文本 = 值可2;
                                    如果 (值可2 ?= 1) {
                                        (成员值)数值文本 = 成员值文;
                                        成员块 + "=" + 成员值文 = 成员块;
                                    }
                                }
                                成员数 + 1 = 成员数;
                                成员值 + 1 = 序;
                            }
                            k + 1 = k;
                        }
                    }
                    如果 (成员数 > 0) {
                        枚举块 + "枚举 " + 枚举名 + " {\n" + 成员块 + "\n}\n\n" = 枚举块;
                        枚举数 + 1 = 枚举数;
                    } 否则 {
                        跳过数 + 1 = 跳过数;
                    }
                } 否则 {
                    (行文, "(")包含 = 有括;
                    (行文, ";")包含 = 有分;
                    0 = 是原型;
                    如果 (有括 ?= 1 && 有分 ?= 1) { 1 = 是原型; }
                    如果 (是原型 ?= 1) {
                        (行文)取括号前 = 头文2;
                        (行文)取括号内 = 参文;
                        (头文2)取最后词 = 名;
                        (头文2)长度 = 头长;
                        (名)长度 = 名长;
                        "" = 返型类;
                        如果 (头长 > 名长) {
                            (头文2, 0, 头长 - 名长)子串 = 返文;
                            (返文)去空白 = 返型类;
                        }
                        (返型类)心类型 = 返型;
                        "" = 参数串;
                        0 = 参数数;
                        0 = k2;
                        0 = 停2;
                        当 (停2 ?= 0) {
                            (参文, k2)第段 = 一段2;
                            如果 (一段2 ?= "" && k2 > 0) {
                                1 = 停2;
                            } 否则 {
                                如果 (一段2 ?= "" || 一段2 ?= "void" || 一段2 ?= "...") { } 否则 {
                                    (一段2)参数类型 = 参型;
                                    如果 (参型 ?= "") { } 否则 {
                                        (参型)心类型 = 心参;
                                        (一段2)取最后词 = 参名;
                                        (参名)是类型词 = 名是类;
                                        "" = 用名;
                                        如果 (名是类 ?= 0 && 参名 != "") { 参名 = 用名; }
                                        如果 (用名 ?= "") {
                                            (参数数)参数名 = 用名;
                                        }
                                        如果 (参数数 > 0) { 参数串 + ", " = 参数串; }
                                        参数串 + 用名 + ": " + 心参 = 参数串;
                                        参数数 + 1 = 参数数;
                                    }
                                }
                                k2 + 1 = k2;
                            }
                        }
                        如果 (参数数 > 4) {
                            跳过数 + 1 = 跳过数;
                        } 否则如果 (名 ?= "") {
                            跳过数 + 1 = 跳过数;
                        } 否则 {
                            函数块 + "外部 函数 \"" + 库名 + "\" \"" + 名 + "\" " + 名 + "(" = 函数块;
                            函数块 + 参数串 = 函数块;
                            函数块 + ")(结果: " + 返型 + ");\n" = 函数块;
                            函数数 + 1 = 函数数;
                        }
                    }
                }
            }
            行 + 1 = 行;
        }
        如果 (常量数 > 0) {
            生成 + "枚举 " + 常量名 + " {\n" + 常量块 + "\n}\n\n" = 生成;
        }
        生成 + 枚举块 = 生成;
        生成 + 函数块 = 生成;
        (输出, 生成)写入文件 = 写码;
        ("已生成: " + 输出)打印;
    }
