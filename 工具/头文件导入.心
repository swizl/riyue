// C 头文件导入工具（阶段10 续50）
// 用法: 日月.exe 工具/头文件导入.心 输入.h 输出.心 [--库=库名] [--常量名=枚举名]
//
// 支持的头文件子集（面向 FFI 声明生成，不做完整 C 语法分析）：
//   · `#define 名 <十进制/十六进制整数>`  → 归入一个 `枚举 <常量名>` 常量组
//   · `enum [名] { 成员, 成员 = 值, ... }` → `枚举 名 { ... }`（值须为整数常量）
//   · 函数原型 `返回类型 名(参数...);`      → `外部 函数 "<库名>" "<符号名>" 名(...)(结果: ...)`
// 生成结果是可直接 `导入` 的 `.心` 文件（纯 `.心` 切片，不改编译器 ⇒ 不动点恒定）。
//
// 限制（有意保留，避免静默错误）：
//   · 结构体 / typedef / 宏函数 / `#if` 条件、非整数常量一律跳过（不生成声明）
//   · `...` 变参原型只保留固定参数（只有 printf / sprintf 由编译器前导按 C 变参原型发射）
//   · 参数超过 4 个的原型跳过（FFI 入口上限）
//   · `void` 返回值按 `整数` 声明（调用方丢弃返回值即可）

// 前缀判定：文本是否以 前缀 开头
函数 (文本:字符串, 前缀:字符串)前缀是(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 文长;
    (前缀)长度 = 前长;
    如果 (前长 <= 文长) {
        1 = 同;
        0 = j;
        当 (j < 前长) {
            (文本, j)字符码 = 甲码;
            (前缀, j)字符码 = 乙码;
            如果 (甲码 != 乙码) { 0 = 同; }
            j + 1 = j;
        }
        如果 (同 ?= 1) { 1 = 结果; }
    }
}

// 子串判定：文本是否包含 子
函数 (文本:字符串, 子:字符串)包含(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 文长;
    (子)长度 = 子长;
    如果 (子长 > 0) {
        0 = i;
        0 = 停;
        当 (i + 子长 <= 文长 && 停 ?= 0) {
            1 = 同;
            0 = j;
            当 (j < 子长) {
                (文本, i + j)字符码 = 甲码;
                (子, j)字符码 = 乙码;
                如果 (甲码 != 乙码) { 0 = 同; }
                j + 1 = j;
            }
            如果 (同 ?= 1) { 1 = 结果; 1 = 停; }
            i + 1 = i;
        }
    }
}

