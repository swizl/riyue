// 日月编译器诊断行解析（统一命令行 `诊断` 子命令共用）
//   编译器格式：`错误[C0xx][文件]: 消息（行 N:列）`
//   码 / 文件名 / 列号均可缺省；码由编译器在严重级别后内建，缺省回落 `C000`。
//   错误码定义（`C` 前缀 = 编译器；与 检查 的 `E`/`W` 前缀区分）：
//   C001 未声明标识符 / C002 使用已移动的值 / C003 解析失败 / C004 无法读取输入文件
//   C005 模块或导入 / C006 返回声明 / C007 数组切片遍历 / C008 动态库与交叉目标
//   C009 借用与视图逃逸 / C010 接口实现不合规 / C011 泛型约束不满足 / C000 未分类
// 注：本模块自带 JSON 转义（与 代码检查器 的 检查JSON转义 同口径）与非负整数转
//     字符串，保持零依赖——不导入 `标准库/字符串.心`，避免与 统一命令行 现有链
//     （测试运行器 → 测试框架 → 字符串.心）产生第二个模块键（`invalid redefinition`）。

// 非负整数 → 十进制字符串（行号/列号专用）
函数 (值:整数)诊断整数转字符串("" = 结果:字符串) {
    0 = 商;
    0 = 回;
    0 = 余;
    0 = 原;
    "" = 位;
    "" = 结果;
    值 = 商;
    如果 (商 ?= 0) {
        "0" = 结果;
    }
    当 (商 > 0) {
        商 = 原;
        商 / 10 = 商;
        商 * 10 = 回;
        原 - 回 = 余;
        (48 + 余)字符 = 位;
        (位, 结果)拼接 = 结果;
    }
}

// JSON 字符串转义：转义反斜杠、双引号与 \n / \r / \t 控制字符
// （不自建 `\"` 字面量，用 `(92)字符` / `(34)字符` 拼接，避免转义歧义）
函数 (文本:字符串)诊断JSON转义("" = 结果:字符串) {
    0 = 长;
    0 = i;
    0 = 码;
    "" = 反斜杠;
    "" = 引;
    "" = 单;
    "" = 结果;
    (文本)长度 = 长;
    (92)字符 = 反斜杠;
    (34)字符 = 引;
    0 = i;
    当 (i < 长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 34) {
            (结果, 反斜杠)拼接 = 结果;
            (结果, 引)拼接 = 结果;
        } 否则 {
            如果 (码 ?= 92) {
                (结果, 反斜杠)拼接 = 结果;
                (结果, 反斜杠)拼接 = 结果;
            } 否则 {
                如果 (码 ?= 10) {
                    (结果, 反斜杠)拼接 = 结果;
                    (结果, "n")拼接 = 结果;
                } 否则 {
                    如果 (码 ?= 13) {
                        (结果, 反斜杠)拼接 = 结果;
                        (结果, "r")拼接 = 结果;
                    } 否则 {
                        如果 (码 ?= 9) {
                            (结果, 反斜杠)拼接 = 结果;
                            (结果, "t")拼接 = 结果;
                        } 否则 {
                            (文本, i, 1)子串 = 单;
                            (结果, 单)拼接 = 结果;
                        }
                    }
                }
            }
        }
        i + 1 = i;
    }
}

// JSON 字符串值段：`"…"`
函数 (文本:字符串)诊断JSON串("" = 结果:字符串) {
    "" = 引;
    "" = 转;
    (34)字符 = 引;
    (文本)诊断JSON转义 = 转;
    (引, 转)拼接 = 结果;
    (结果, 引)拼接 = 结果;
}

// 括号内容是否为错误码：`C` + 3 位数字（长度 4）
函数 (文本:字符串)诊断是错误码(0 = 结果:整数) {
    (文本)长度 = 码长;
    如果 (码长 ?= 4) {
        (文本, 0, 1)子串 = 码首;
        如果 (码首 ?= "C") {
            (文本, 1)字符码 = 码一;
            (文本, 2)字符码 = 码二;
            (文本, 3)字符码 = 码三;
            如果 (码一 >= 48 && 码一 <= 57) {
                如果 (码二 >= 48 && 码二 <= 57) {
                    如果 (码三 >= 48 && 码三 <= 57) {
                        1 = 结果;
                    }
                }
            }
        }
    }
}

// 编译器诊断行 → JSON 对象；非诊断行返回 ""
//   后续的源码行与 `^` 指示符行不以 错误|警告|注意 开头，自然被过滤
//   字段：file / line / column / severity / code / message
函数 (行:字符串)诊断行JSON("" = 结果:字符串) {
    0 = 长;
    0 = 偏移;
    0 = 扫;
    0 = 起;
    0 = 止;
    0 = 标记;
    0 = 行号;
    0 = 列号;
    0 = 位数;
    0 = 停;
    0 = 是数;
    0 = 码;
    0 = 行长;
    0 = 括号余数;
    0 = 括号继续;
    0 = 是码;
    "" = 严重;
    "" = 错误码;
    "" = 文件名;
    "" = 消息;
    "" = 探;
    "" = 前两;
    "" = 引;
    "" = 段;
    "" = 文;
    (34)字符 = 引;
    (行)长度 = 长;
    0 = 偏移;
    如果 (长 >= 2) {
        (行, 0, 2)子串 = 前两;
        如果 (前两 ?= "错误") {
            "error" = 严重;
            2 = 偏移;
        } 否则 {
            如果 (前两 ?= "警告") {
                "warning" = 严重;
                2 = 偏移;
            } 否则 {
                如果 (前两 ?= "注意") {
                    "note" = 严重;
                    2 = 偏移;
                }
            }
        }
    }
    如果 (偏移 > 0) {
        // 可选标记：`[C0xx]` 错误码 与 `[文件名]`（顺序不限，最多两个；均可缺省）
        2 = 括号余数;
        1 = 括号继续;
        当 (括号继续 ?= 1 && 括号余数 > 0) {
            如果 (偏移 < 长) {
                (行, 偏移, 1)子串 = 探;
                如果 (探 ?= "[") {
                    偏移 + 1 = 扫;
                    0 = 标记;
                    当 (扫 < 长 && 标记 ?= 0) {
                        (行, 扫, 1)子串 = 探;
                        如果 (探 ?= "]") {
                            1 = 标记;
                        } 否则 {
                            扫 + 1 = 扫;
                        }
                    }
                    如果 (标记 ?= 1) {
                        (行, 偏移 + 1, 扫 - 偏移 - 1)子串 = 段;
                        (段)诊断是错误码 = 是码;
                        如果 (是码 ?= 1) {
                            段 = 错误码;
                        } 否则 {
                            段 = 文件名;
                        }
                        // 跳过 `]`，紧邻的下一个 `[...]` 或 `: ` 由外层继续处理
                        扫 + 1 = 偏移;
                        括号余数 - 1 = 括号余数;
                    } 否则 {
                        0 = 括号继续;
                    }
                } 否则 {
                    0 = 括号继续;
                }
            } 否则 {
                0 = 括号继续;
            }
        }
        // 标记之后为 `: `（半角冒号 + 空格）；无括号标记时同样跳过
        如果 (偏移 + 1 < 长) {
            (行, 偏移, 2)子串 = 探;
            如果 (探 ?= ": ") {
                偏移 + 2 = 偏移;
            }
        }
        // 无内建码的旧诊断统一回落 `C000`
        如果 (错误码 ?= "") {
            "C000" = 错误码;
        }
        // 消息结束位置 = `（行 ` 标记（标记 0 = 未找到 → 取到行尾）
        0 = 标记;
        偏移 = 起;
        偏移 = 扫;
        当 (扫 + 3 <= 长 && 标记 ?= 0) {
            (行, 扫, 3)子串 = 探;
            如果 (探 ?= "（行 ") {
                扫 = 标记;
            } 否则 {
                扫 + 1 = 扫;
            }
        }
        如果 (标记 ?= 0) {
            长 = 止;
        } 否则 {
            标记 = 止;
        }
        如果 (止 > 起) {
            (行, 起, 止 - 起)子串 = 消息;
        }
        // 行号 / 列号
        如果 (标记 > 0) {
            标记 + 3 = 扫;
            0 = 停;
            当 (扫 < 长 && 停 ?= 0) {
                (行, 扫)字符码 = 码;
                0 = 是数;
                如果 (码 >= 48) {
                    如果 (码 <= 57) {
                        1 = 是数;
                    }
                }
                如果 (是数 ?= 1) {
                    行号 * 10 + 码 - 48 = 行号;
                    位数 + 1 = 位数;
                    扫 + 1 = 扫;
                } 否则 {
                    1 = 停;
                }
            }
            如果 (扫 < 长 && 位数 > 0) {
                (行, 扫, 1)子串 = 探;
                如果 (探 ?= ":") {
                    扫 + 1 = 扫;
                    0 = 停;
                    当 (扫 < 长 && 停 ?= 0) {
                        (行, 扫)字符码 = 码;
                        0 = 是数;
                        如果 (码 >= 48) {
                            如果 (码 <= 57) {
                                1 = 是数;
                            }
                        }
                        如果 (是数 ?= 1) {
                            列号 * 10 + 码 - 48 = 列号;
                            扫 + 1 = 扫;
                        } 否则 {
                            1 = 停;
                        }
                    }
                }
            }
            如果 (位数 ?= 0) {
                0 = 行号;
            }
        }
        // 组装对象
        "{" = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "file")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (文件名)诊断JSON串 = 段;
        (结果, 段)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "line")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (行号)诊断整数转字符串 = 文;
        (结果, 文)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "column")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (列号)诊断整数转字符串 = 文;
        (结果, 文)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "severity")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (严重)诊断JSON串 = 段;
        (结果, 段)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "code")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (错误码)诊断JSON串 = 段;
        (结果, 段)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "message")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (消息)诊断JSON串 = 段;
        (结果, 段)拼接 = 结果;
        (结果, "}")拼接 = 结果;
    }
}

// 模块版本
函数 诊断解析模块版本(0 = 结果:整数) {
    1 = 结果;
}
