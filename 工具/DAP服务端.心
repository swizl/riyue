// 日月 DAP 服务端（阶段10 续65：VS Code 调试器集成）
// 用法：日月.exe 工具/DAP服务端.心
//
// 架构：
//   · 传输：stdio —— 帧为 `Content-Length: N\r\n\r\n` + N 字节 JSON 正文（与 LSP 同格式，
//           按 UTF-8 字节计长：`读取标准输入字节` / `写入标准输出` / `字节长度`）；
//   · 会话分派：工具/DAP会话.心（可单测，不碰 stdio）；
//   · 本文件只做两件事：帧循环 + 收到运行请求后「编译并运行」。
//
// 运行流程（能力边界见 工具/DAP会话.心 文件头）：
//   launch 登记 program → configurationDone（未要求停在入口）或 continue →
//   `日月.exe <program> 构建/.dap运行 --调试` 编译 → 执行产物（stdout+stderr 重定向到文件，
//   运行时无管道，故运行结束后一次性回放）→ output 事件 → exited / terminated。
//   编译失败：回放编译日志（stderr 类别）+ exitCode 非 0 的 exited。

导入 "DAP会话.心";
导入 "LSP报文.心";

// 读一帧正文：循环读头行直到空行，再按 Content-Length 读正文；EOF（无任何头）→ ""
函数 ()读报文("" = 结果:字符串) {
    "" = 结果;
    0 = 体长;
    0 = 见头;
    0 = 头停;
    当 (头停 ?= 0) {
        ()读取标准输入行 = 行暂;
        ("", 行暂)拼接 = 行;
        如果 (行 ?= "") {
            1 = 头停;
        } 否则 {
            (行)报文长度 = 候选;
            如果 (候选 > 0) {
                候选 = 体长;
                1 = 见头;
            }
        }
    }
    如果 (见头 ?= 1) {
        (体长)读取标准输入字节 = 体暂;
        ("", 体暂)拼接 = 结果;
    }
}

// 写出应答（空串 = 无应答）
函数 (帧:字符串)写帧 {
    如果 (帧 != "") {
        (帧)写入标准输出;
    }
}

// 宿主是否为 Windows（`OS` 环境变量非空）
函数 ()是视窗(0 = 结果:整数) {
    ("OS")获取环境变量 = 宿主;
    (宿主)长度 = 宿主长;
    0 = 结果;
    如果 (宿主长 > 0) { 1 = 结果; }
}

// 路径一律正斜杠：VS Code 传来的 program 是 `d:\...` 反斜杠形式，cmd 里会报文件名语法错
函数 (文本:字符串)斜杠路径("" = 结果:字符串) {
    "" = 结果;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 92) {
            (结果, "/")拼接 = 结果;
        } 否则 {
            (码)字符 = 符;
            (结果, 符)拼接 = 结果;
        }
        i + 1 = i;
    }
}

// 链接产物后缀：Windows 补 `.exe`
函数 ()可执行后缀("" = 结果:字符串) {
    ()是视窗 = 视窗;
    如果 (视窗 ?= 1) { ".exe" = 结果; } 否则 { "" = 结果; }
}

// output 事件帧（文本为空 → 不发射）
函数 (类别:字符串, 文本:字符串)DAP输出帧("" = 结果:字符串) {
    如果 (文本 ?= "") {
        "" = 结果;
    } 否则 {
        (文本)DAP转义 = 文本文;
        "{\"category\":\"" + 类别 + "\",\"output\":\"" + 文本文 + "\"}" = 参;
        ("output", 参)DAP通知帧 = 结果;
    }
}

// exited + terminated 事件帧
函数 (码:整数)DAP结束帧("" = 结果:字符串) {
    (码)整数转字符串 = 码文;
    "{\"exitCode\":" + 码文 + "}" = 体;
    ("exited", 体)DAP通知帧 = 一;
    ("terminated", "{}")DAP通知帧 = 二;
    (一, 二)拼接 = 结果;
}

// 编译并运行：返回追加在应答之后的事件帧串
// Windows cmd 实测两条约束：路径一律用正斜杠（反斜杠会让 `执行命令` 报文件名语法错），
// 可执行文件不能带路径作为命令首词（`构建/x.exe` 会被拆成 `构建`），故先 cd 进构建目录再跑裸文件名。
函数 ()DAP执行("" = 结果:字符串) {
    "" = 结果;
    0 = 待运行;
    1 = 已运行;
    (待运行程序)长度 = 程序长;
    如果 (程序长 ?= 0) {
        ("[日月] launch 未提供 program，已终止\n")输出错误;
        (1)DAP结束帧 = 结果;
    } 否则 {
        ("构建")目录存在 = 有构建;
        如果 (有构建 ?= 0) { ("构建")创建目录; }
        "构建/.dap运行" = 目标;
        "构建/.dap编译.log" = 编译日志;
        "构建/.dap输出.log" = 输出日志;
        (待运行程序)斜杠路径 = 程序;
        "日月.exe \"" + 程序 + "\" \"" + 目标 + "\" --调试 > \"" + 编译日志 + "\" 2>&1" = 编译命令;
        (编译命令)执行命令 = 编译码;
        如果 (编译码 != 0) {
            (编译码)整数转字符串 = 编译码文;
            "[日月] 编译失败（退出码 " + 编译码文 + "）\n" = 提示;
            ("console", 提示)DAP输出帧 = 一;
            (编译日志)读取文件 = 日志;
            ("stderr", 日志)DAP输出帧 = 二;
            (编译码)DAP结束帧 = 三;
            (一, 二)拼接 = 结果;
            (结果, 三)拼接 = 结果;
            (编译日志)删除文件;
        } 否则 {
            ()可执行后缀 = 后缀;
            ".dap运行" + 后缀 = 产物名;
            "cd 构建 && " = 进入;
            ()是视窗 = 视窗;
            如果 (视窗 ?= 1) { "cd /d 构建 && " = 进入; }
            进入 + 产物名 + " > .dap输出.log 2>&1" = 运行命令;
            (运行命令)执行命令 = 运行码;
            (输出日志)读取文件 = 输出;
            ("stdout", 输出)DAP输出帧 = 一;
            (运行码)整数转字符串 = 运行码文;
            "{\"exitCode\":" + 运行码文 + "}" = 体;
            ("exited", 体)DAP通知帧 = 二;
            ("terminated", "{}")DAP通知帧 = 三;
            (一, 二)拼接 = 结果;
            (结果, 三)拼接 = 结果;
            ("构建/" + 产物名)删除文件;
            (编译日志)删除文件;
            (输出日志)删除文件;
        }
    }
}

函数 主程序 {
    ("日月 DAP 服务端已启动（stdio / DAP）")输出错误;
    0 = 运行;
    当 (运行 ?= 0) {
        ()读报文 = 正文;
        如果 (正文 ?= "") {
            ("日月 DAP 服务端：输入结束，退出")输出错误;
            1 = 运行;
        } 否则 {
            (正文)DAP处理 = 应答;
            (应答)写帧;
            如果 (待运行 ?= 1) {
                ()DAP执行 = 事件帧;
                (事件帧)写帧;
            }
            如果 (退出请求 ?= 1) {
                1 = 运行;
            }
        }
    }
    ("日月 DAP 服务端已退出")输出错误;
}
