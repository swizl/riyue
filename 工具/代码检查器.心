// 日月代码检查器（阶段P7 续：纯 .心 静态检查库）
// 用法: 导入 "../工具/代码检查器.心" 后调用
//       `(源文本)代码检查诊断`（单文件）、`(目录)检查目录诊断`（单层目录）
//       或 `(目录)检查目录诊断递归`（递归目录）
//       （库文件：入口见 示例/代码检查器测试.心；无 主程序，避免导入方重定义）
// 规则（5 条）：制表符缩进 / 行尾多余空白 / 全角标点 / 字符串未闭合 / `===` 与 `!==` 非法运算符
// 纯 .心：复用文档生成器的 取行 / 行数 / 缩进 / `文档整数转字符串`，
//         仅用 字符码 / 子串 / 拼接 / 长度；不改编译器 ⇒ 自举不动点不变，双链逐字一致。
// 注意：不直接再导入 `标准库/字符串.心`；文档生成器亦不导入（见其文件头），
//       以免与 测试运行器 → 测试框架 → `字符串.心` 的模块键重复。
// 定位：文本模式维持 `严重 [行 N]: 消息`；JSON 模式另给 `column`（1 基）与 `code`
//       （W001 制表 / W002 行尾空白 / W003 全角标点 / E001 未闭合 / E002 非法运算符）。
// 字面量：全角标点与 `===` 在「屏蔽行」上判定——字符串字面量与 `//` 注释内不计；
//       未闭合字面量按开引号位置报 E001。
// 限制：不做完整词法/语法分析（字符常量、块注释 `/* */` 未识别）。

导入 "../工具/文档生成器.心";

// 屏蔽字符串字面量与行注释：返回等长「屏蔽行」（串内与注释内字符变空格），
// 未闭合字面量的起始列（1 基）写入 未闭列（闭合 → 0）。
// 线索：换行后的转义与引号仍需按字符推进，故逐码点扫描。
函数 (行:字符串)检查屏蔽字面量(0 = 未闭列:整数, "" = 结果:字符串) {
    0 = 行长;
    0 = i;
    0 = 码;
    0 = 次码;
    0 = 在串;
    0 = 串起;
    0 = 停;
    "" = 单;
    "" = 空格;
    (行)长度 = 行长;
    (32)字符 = 空格;
    0 = 未闭列;
    0 = 在串;
    0 = 串起;
    0 = i;
    当 (停 ?= 0 && i < 行长) {
        (行, i)字符码 = 码;
        如果 (在串 ?= 1) {
            如果 (码 ?= 92) {
                (结果, 空格)拼接 = 结果;
                i + 1 = i;
                如果 (i < 行长) { (结果, 空格)拼接 = 结果; }
            } 否则如果 (码 ?= 34) {
                0 = 在串;
                0 = 串起;
                (结果, 空格)拼接 = 结果;
            } 否则 {
                (结果, 空格)拼接 = 结果;
            }
        } 否则如果 (码 ?= 34) {
            1 = 在串;
            i + 1 = 串起;
            (结果, 空格)拼接 = 结果;
        } 否则如果 (码 ?= 47 && i + 1 < 行长) {
            (行, i + 1)字符码 = 次码;
            如果 (次码 ?= 47) {
                行长 = i;
                1 = 停;
            } 否则 {
                (行, i, 1)子串 = 单;
                (结果, 单)拼接 = 结果;
            }
        } 否则 {
            (行, i, 1)子串 = 单;
            (结果, 单)拼接 = 结果;
        }
        i + 1 = i;
    }
    如果 (在串 ?= 1) {
        串起 = 未闭列;
    }
}

// 缩进区内首个制表符列（1 基）→ 无则 0
函数 (行:字符串)检查制表列(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i < 起) {
        (行, i)字符码 = 码;
        如果 (码 ?= 9) {
            i + 1 = 结果;
            1 = 停;
        }
        i + 1 = i;
    }
}

// 行尾空白串的起始列（1 基）→ 无则 0
函数 (行:字符串)检查尾白列(0 = 结果:整数) {
    (行)长度 = 行长;
    0 = i;
    0 = 结果;
    0 = 停;
    行长 = i;
    当 (停 ?= 0 && i > 0) {
        i - 1 = i;
        (行, i)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) {
            i + 1 = 结果;
        } 否则 {
            1 = 停;
        }
    }
}

// 全角标点码：，。；：！？ → 1
函数 (码:整数)检查全角码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 65292 || 码 ?= 12290 || 码 ?= 65307 || 码 ?= 65306) { 1 = 结果; }
    如果 (码 ?= 65281 || 码 ?= 65311) { 1 = 结果; }
}

// 行内首个全角标点列（1 基，作用于屏蔽行）→ 无则 0
函数 (行:字符串)检查全角列(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i < 行长) {
        (行, i)字符码 = 码;
        (码)检查全角码 = 是;
        如果 (是 ?= 1) {
            i + 1 = 结果;
            1 = 停;
        }
        i + 1 = i;
    }
}

// 行内首个 `===` / `!==` 列（1 基，作用于屏蔽行）→ 无则 0
函数 (行:字符串)检查非法列(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i + 2 < 行长) {
        (行, i)字符码 = 甲;
        (行, i + 1)字符码 = 乙;
        (行, i + 2)字符码 = 丙;
        如果 (甲 ?= 61 && 乙 ?= 61 && 丙 ?= 61) { i + 1 = 结果; 1 = 停; }
        如果 (甲 ?= 33 && 乙 ?= 61 && 丙 ?= 61) { i + 1 = 结果; 1 = 停; }
        i + 1 = i;
    }
}

// 追加一条诊断：`严重 [行 N]: 消息\n`
函数 (结果:字符串, 严重:字符串, 行号:整数, 消息:字符串)检查追加诊断("" = 结果输出:字符串) {
    (结果, 严重)拼接 = 结果输出;
    (结果输出, " [行 ")拼接 = 结果输出;
    (行号)文档整数转字符串 = 行文本;
    (结果输出, 行文本)拼接 = 结果输出;
    (结果输出, "]: ")拼接 = 结果输出;
    (结果输出, 消息)拼接 = 结果输出;
    (结果输出, "\n")拼接 = 结果输出;
}

// 追加一条明细项：`行号<TAB>列<TAB>严重<TAB>码<TAB>消息\n`（供 JSON 定位）
函数 (结果:字符串, 行号:整数, 列:整数, 严重:字符串, 码:字符串, 消息:字符串)检查追加明细("" = 结果输出:字符串) {
    "" = 制表;
    "" = 行文本;
    "" = 列文本;
    (9)字符 = 制表;
    (行号)文档整数转字符串 = 行文本;
    (列)文档整数转字符串 = 列文本;
    (结果, 行文本)拼接 = 结果输出;
    (结果输出, 制表)拼接 = 结果输出;
    (结果输出, 列文本)拼接 = 结果输出;
    (结果输出, 制表)拼接 = 结果输出;
    (结果输出, 严重)拼接 = 结果输出;
    (结果输出, 制表)拼接 = 结果输出;
    (结果输出, 码)拼接 = 结果输出;
    (结果输出, 制表)拼接 = 结果输出;
    (结果输出, 消息)拼接 = 结果输出;
    (结果输出, "\n")拼接 = 结果输出;
}

// 全量检查：逐行应用 5 条规则，返回诊断文本、明细文本（TAB 分隔、含列与错误码）与计数。
// 全角标点 / 非法运算符在「屏蔽行」上判定——字符串字面量与 `//` 注释内的内容不计，
// 消除字面量内出现 `===` 或全角标点的误报。
函数 (文本:字符串)代码检查明细("" = 结果:字符串, "" = 明细表:字符串, 0 = 警告数:整数, 0 = 错误数:整数) {
    "" = 结果;
    "" = 明细表;
    0 = 警告数;
    0 = 错误数;
    0 = 未闭列;
    "" = 屏蔽行;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        行序 + 1 = 行号;
        (行)检查制表列 = 制表列;
        如果 (制表列 > 0) {
            (结果, "警告", 行号, "制表符缩进")检查追加诊断 = 结果;
            (明细表, 行号, 制表列, "warning", "W001", "制表符缩进")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        (行)检查尾白列 = 尾白列;
        如果 (尾白列 > 0) {
            (结果, "警告", 行号, "行尾多余空白")检查追加诊断 = 结果;
            (明细表, 行号, 尾白列, "warning", "W002", "行尾多余空白")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        (行)检查屏蔽字面量 = (未闭列, 屏蔽行);
        (屏蔽行)检查全角列 = 全角列;
        如果 (全角列 > 0) {
            (结果, "警告", 行号, "全角标点")检查追加诊断 = 结果;
            (明细表, 行号, 全角列, "warning", "W003", "全角标点")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        如果 (未闭列 > 0) {
            (结果, "错误", 行号, "字符串未闭合")检查追加诊断 = 结果;
            (明细表, 行号, 未闭列, "error", "E001", "字符串未闭合")检查追加明细 = 明细表;
            错误数 + 1 = 错误数;
        }
        (屏蔽行)检查非法列 = 非法列;
        如果 (非法列 > 0) {
            (结果, "错误", 行号, "非法运算符 === 或 !==")检查追加诊断 = 结果;
            (明细表, 行号, 非法列, "error", "E002", "非法运算符 === 或 !==")检查追加明细 = 明细表;
            错误数 + 1 = 错误数;
        }
        行序 + 1 = 行序;
    }
    (警告数)文档整数转字符串 = 警文本;
    (错误数)文档整数转字符串 = 错文本;
    (结果, "---\n检查完成: 警告 ")拼接 = 结果;
    (结果, 警文本)拼接 = 结果;
    (结果, " 条, 错误 ")拼接 = 结果;
    (结果, 错文本)拼接 = 结果;
    (结果, " 条\n")拼接 = 结果;
}

// 纯文本诊断（对外格式与历史一致，不含列与错误码）
函数 (文本:字符串)代码检查诊断("" = 结果:字符串) {
    (文本)代码检查明细 = (结果, 明细表, 警告数, 错误数);
}

// ---------- 目录模式（单层、非递归） ----------

// 文件名是否以 `.心` 结尾 → 1
函数 (名称:字符串)检查是源文件名(0 = 结果:整数) {
    0 = 长;
    "" = 尾;
    0 = 结果;
    (名称)长度 = 长;
    如果 (长 >= 2) {
        (名称, 长 - 2, 2)子串 = 尾;
        如果 (尾 ?= ".心") { 1 = 结果; }
    }
}

// 拼接目录与名称（自建分隔符，避免 `连接路径` 的共享静态缓冲）
函数 (目录:字符串, 名称:字符串)检查拼接路径("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    (目录)长度 = 长;
    如果 (长 ?= 0) {
        名称 = 结果;
    } 否则 {
        (目录, 长 - 1)字符码 = 码;
        如果 (码 ?= 47 || 码 ?= 92) {
            (目录, 名称)拼接 = 结果;
        } 否则 {
            (目录, "/")拼接 = 结果;
            (结果, 名称)拼接 = 结果;
        }
    }
}

// 文本比较：按字符码逐位比较，前缀相同时短者在前 → -1 / 0 / 1
// （本地实现：不导入 `标准库/字符串.心`，避免模块键重复）
函数 (甲:字符串, 乙:字符串)检查文本比较(0 = 结果:整数) {
    0 = 甲长;
    0 = 乙长;
    0 = 短长;
    0 = i;
    0 = 甲码;
    0 = 乙码;
    0 = 结果;
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    甲长 = 短长;
    如果 (乙长 < 甲长) { 乙长 = 短长; }
    0 = i;
    当 (i < 短长 && 结果 ?= 0) {
        (甲, i)字符码 = 甲码;
        (乙, i)字符码 = 乙码;
        如果 (甲码 < 乙码) { 0 - 1 = 结果; }
        如果 (甲码 > 乙码) { 1 = 结果; }
        i + 1 = i;
    }
    如果 (结果 ?= 0) {
        如果 (甲长 < 乙长) { 0 - 1 = 结果; }
        如果 (甲长 > 乙长) { 1 = 结果; }
    }
}

// 文本数组升序插入排序（按 `检查文本比较`）
函数 (表)检查文本排序(空) {
    0 = 数;
