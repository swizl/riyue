            如果 (段 ?= 段号) {
                (文本, 起, i - 起)子串 = 单;
                (结果, 单)拼接 = 结果;
                1 = 停;
            }
            段 + 1 = 段;
            i + 1 = 起;
        }
        i + 1 = i;
    }
    如果 (停 ?= 0 && 段 ?= 段号) {
        如果 (起 < 长) {
            (文本, 起, 长 - 起)子串 = 单;
            (结果, 单)拼接 = 结果;
        }
    }
}

