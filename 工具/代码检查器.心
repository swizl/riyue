// 日月代码检查器（阶段P7 续：纯 .心 静态检查库）
// 用法: 导入 "../工具/代码检查器.心" 后调用
//       `(源文本)代码检查诊断`（单文件）、`(目录)检查目录诊断`（单层目录）
//       或 `(目录)检查目录诊断递归`（递归目录）
//       （库文件：入口见 示例/代码检查器测试.心；无 主程序，避免导入方重定义）
// 规则（5 条）：制表符缩进 / 行尾多余空白 / 全角标点 / 字符串未闭合 / `===` 与 `!==` 非法运算符
// 纯 .心：复用文档生成器的 取行 / 行数 / 缩进 / `文档整数转字符串`，
//         仅用 字符码 / 子串 / 拼接 / 长度；不改编译器 ⇒ 自举不动点不变，双链逐字一致。
// 注意：不直接再导入 `标准库/字符串.心`；文档生成器亦不导入（见其文件头），
//       以免与 测试运行器 → 测试框架 → `字符串.心` 的模块键重复。
// 限制：以 `//` 开头的注释行只检查缩进与行尾空白；不解析字符串字面量，
//       因此字面量内的 `===` 或全角标点也会计数（简单规则检查器，非完整语法分析）。

导入 "../工具/文档生成器.心";

// 行首 `//` 注释 → 1
函数 (行:字符串)检查行注释(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    (行)长度 = 行长;
    如果 (起 + 2 <= 行长) {
        (行, 起, 2)子串 = 两;
        如果 (两 ?= "//") { 1 = 结果; }
    }
}

// 缩进区内含制表符 → 1
函数 (行:字符串)检查制表缩进(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    0 = i;
    当 (i < 起) {
        (行, i)字符码 = 码;
        如果 (码 ?= 9) { 1 = 结果; }
        i + 1 = i;
    }
}

// 行尾为空格或制表符 → 1
函数 (行:字符串)检查行尾空白(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    如果 (行长 > 0) {
        (行, 行长 - 1)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) { 1 = 结果; }
    }
}

// 全角标点码：，。；：！？ → 1
函数 (码:整数)检查全角码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 65292 || 码 ?= 12290 || 码 ?= 65307 || 码 ?= 65306) { 1 = 结果; }
    如果 (码 ?= 65281 || 码 ?= 65311) { 1 = 结果; }
}

// 行内含全角标点 → 1
函数 (行:字符串)检查全角标点(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    当 (i < 行长) {
        (行, i)字符码 = 码;
        (码)检查全角码 = 是;
        如果 (是 ?= 1) { 1 = 结果; }
        i + 1 = i;
    }
}

// 未转义双引号个数（跳过 `\` 后的一个字符）
函数 (行:字符串)检查引号计数(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    当 (i < 行长) {
        (行, i)字符码 = 码;
        如果 (码 ?= 92) {
            i + 1 = i;
        } 否则如果 (码 ?= 34) {
            结果 + 1 = 结果;
        }
        i + 1 = i;
    }
}

// 行内含 `===` 或 `!==` → 1
函数 (行:字符串)检查非法运算符(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    当 (i + 2 < 行长) {
        (行, i)字符码 = 甲;
        (行, i + 1)字符码 = 乙;
        (行, i + 2)字符码 = 丙;
        如果 (甲 ?= 61 && 乙 ?= 61 && 丙 ?= 61) { 1 = 结果; }
        如果 (甲 ?= 33 && 乙 ?= 61 && 丙 ?= 61) { 1 = 结果; }
        i + 1 = i;
    }
}

// 追加一条诊断：`严重 [行 N]: 消息\n`
