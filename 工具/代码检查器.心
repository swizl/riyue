// JSON 字符串转义：转义反斜杠、双引号与 \n / \r / \t 控制字符
// （不自建 `\"` 字面量，用 `(92)字符` / `(34)字符` 拼接，避免转义歧义）
函数 (文本:字符串)检查JSON转义("" = 结果:字符串) {
    0 = 长;
    0 = i;
    0 = 码;
    "" = 单;
    "" = 反斜杠;
    "" = 引;
    "" = 结果;
    (文本)长度 = 长;
    (92)字符 = 反斜杠;
    (34)字符 = 引;
    0 = i;
    当 (i < 长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 34) {
            (结果, 反斜杠)拼接 = 结果;
            (结果, 引)拼接 = 结果;
        } 否则 {
            如果 (码 ?= 92) {
                (结果, 反斜杠)拼接 = 结果;
                (结果, 反斜杠)拼接 = 结果;
            } 否则 {
                如果 (码 ?= 10) {
                    (结果, 反斜杠)拼接 = 结果;
                    (结果, "n")拼接 = 结果;
                } 否则 {
                    如果 (码 ?= 13) {
                        (结果, 反斜杠)拼接 = 结果;
                        (结果, "r")拼接 = 结果;
                    } 否则 {
                        如果 (码 ?= 9) {
                            (结果, 反斜杠)拼接 = 结果;
                            (结果, "t")拼接 = 结果;
                        } 否则 {
                            (文本, i, 1)子串 = 单;
                            (结果, 单)拼接 = 结果;
                        }
                    }
                }
            }
        }
        i + 1 = i;
    }
}

// 取第 N 段（0 基，TAB 分隔）；越界 → ""
函数 (文本:字符串, 段号:整数)检查取段("" = 结果:字符串) {
