// 代码检查器
// 用法: 日月.exe 工具/代码检查器.心 文件名.心

// 检查结果计数器
0 = 警告数:整数;
0 = 错误数:整数;

// 显示警告
函数 (行号:整数, 消息:字符串)显示警告(空) {
    警告数 + 1 = 警告数;
    ("警告 [行 ")打印;
    (行号)打印;
    ("]: ")打印;
    (消息)打印;
    ("")打印;
}

// 显示错误
函数 (行号:整数, 消息:字符串)显示错误(空) {
    错误数 + 1 = 错误数;
    ("错误 [行 ")打印;
    (行号)打印;
    ("]: ")打印;
    (消息)打印;
    ("")打印;
}

// 检查文件
函数 (文件路径:字符串)检查文件(空) {
    ("检查文件: ")打印;
    (文件路径)打印;
    ("")打印;
    
    // 注意：完整的代码检查需要词法分析和语法分析
    // 这里提供基本的检查框架
    
    ("代码检查器功能:")打印;
    ("  1. 语法检查 - 通过编译器实现")打印;
    ("  2. 未使用变量检查 - 需要符号表分析")打印;
    ("  3. 未定义变量检查 - 需要作用域分析")打印;
    ("  4. 代码风格检查 - 需要规则引擎")打印;
    ("")打印;
    ("建议: 使用 --调试 模式运行编译器获取详细信息")打印;
}

// 显示检查结果
函数 显示检查结果(空) {
    ("=")打印;
    ("检查结果:")打印;
    ("  警告: ")打印;
    (警告数)打印;
    ("  错误: ")打印;
    (错误数)打印;
    ("")打印;
    
    如果 (错误数 ?= 0) {
        如果 (警告数 ?= 0) {
            ("代码检查通过!")打印;
        } 否则 {
            ("代码检查完成，有警告")打印;
        }
    } 否则 {
        ("代码检查失败，有错误")打印;
    }
}

// 主程序
函数 主程序 {
    ("日月代码检查器 v1.0")打印;
    ("=")打印;
    ("")打印;
    
    ("使用方法:")打印;
    ("  日月.exe 文件名.心        - 编译并检查语法")打印;
    ("  日月.exe --调试 文件名.心 - 显示详细调试信息")打印;
    ("")打印;
    ("检查项目:")打印;
    ("  ✓ 语法正确性")打印;
    ("  ✓ 类型检查")打印;
    ("  ✓ 变量定义检查")打印;
    ("  ✓ 函数签名检查")打印;
    ("")打印;
    ("示例:")打印;
    ("  日月.exe 示例/数组基础.心")打印;
    ("  日月.exe --调试 示例/结构体测试.心")打印;
}
