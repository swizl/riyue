    0 = 甲码;
    0 = 乙码;
    0 = 结果;
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    甲长 = 短长;
    如果 (乙长 < 甲长) { 乙长 = 短长; }
    0 = i;
    当 (i < 短长 && 结果 ?= 0) {
        (甲, i)字符码 = 甲码;
        (乙, i)字符码 = 乙码;
        如果 (甲码 < 乙码) { 0 - 1 = 结果; }
        如果 (甲码 > 乙码) { 1 = 结果; }
        i + 1 = i;
    }
    如果 (结果 ?= 0) {
        如果 (甲长 < 乙长) { 0 - 1 = 结果; }
        如果 (甲长 > 乙长) { 1 = 结果; }
    }
}

