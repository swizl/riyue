    0 = 名位;
    0 = 名中;
    0 = 跳位;
    0 = 行总长;
    0 = 序;
    0 = 词起;
    0 = 词末;
    0 = 继;
    0 = 是标;
    0 = 码;
    0 = 旧域;
    "" = 表名;
    "" = 词;
    "" = 读文;
    "" = 写文;
    0 = 行序;
    当 (行序 < 总行) {
        (行表, 行序)动态字符串数组获取 = 行;
        行序 + 1 = 行号;
        (行)检查制表列 = 制表列;
        如果 (制表列 > 0) {
            (结果, "警告", 行号, "制表符缩进")检查追加诊断 = 结果;
            (明细表, 行号, 制表列, "warning", "W001", "制表符缩进")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        (行)检查尾白列 = 尾白列;
        如果 (尾白列 > 0) {
            (结果, "警告", 行号, "行尾多余空白")检查追加诊断 = 结果;
            (明细表, 行号, 尾白列, "warning", "W002", "行尾多余空白")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        (行, 在块)检查屏蔽字面量 = (未闭列, 字未闭列, 块起列, 出块, 屏蔽行);
        (屏蔽行表, 屏蔽行)动态字符串数组添加;
        // 赋值目标预扫描：每行只解析一次，供次遍 W004 与第四遍 W007 共用
        (屏蔽行)检查赋值目标 = (目标名, 目标列);
        (目标名表, 目标名)动态字符串数组添加;
        (目标列表, 目标列)动态数组添加;
        如果 (块起列 > 0) {
            行号 = 块起行;
            块起列 = 块开列;
        }
        出块 = 在块;
        (屏蔽行)检查全角列 = 全角列;
        如果 (全角列 > 0) {
            (结果, "警告", 行号, "全角标点")检查追加诊断 = 结果;
            (明细表, 行号, 全角列, "warning", "W003", "全角标点")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        如果 (未闭列 > 0) {
            (结果, "错误", 行号, "字符串未闭合")检查追加诊断 = 结果;
            (明细表, 行号, 未闭列, "error", "E001", "字符串未闭合")检查追加明细 = 明细表;
            错误数 + 1 = 错误数;
        }
        (屏蔽行)检查非法列 = 非法列;
        如果 (非法列 > 0) {
            (结果, "错误", 行号, "非法运算符 === 或 !==")检查追加诊断 = 结果;
            (明细表, 行号, 非法列, "error", "E002", "非法运算符 === 或 !==")检查追加明细 = 明细表;
            错误数 + 1 = 错误数;
        }
        如果 (字未闭列 > 0) {
            (结果, "错误", 行号, "字符常量未闭合")检查追加诊断 = 结果;
            (明细表, 行号, 字未闭列, "error", "E004", "字符常量未闭合")检查追加明细 = 明细表;
            错误数 + 1 = 错误数;
        }
        行序 + 1 = 行序;
    }
    如果 (在块 ?= 1) {
        如果 (块起行 ?= 0) { 1 = 块起行; }
        (结果, "错误", 块起行, "块注释未闭合")检查追加诊断 = 结果;
        (明细表, 块起行, 块开列, "error", "E003", "块注释未闭合")检查追加明细 = 明细表;
        错误数 + 1 = 错误数;
    }
    // W004 预统计：先把目标名整理成「词序升序去重表」，再一次扫描全部屏蔽行，
    //   逐行切出标识符词并查表，标出「有读」（该名在非赋值目标位置出现过）；
    //   同时按赋值行标出「有调用写」（赋值号左侧含括号 ⇒ 调用结果落地）。
    //   这样每个词只比对一次，避免「每个目标 × 全表 × 全字符」的重复扫描。
    (屏蔽行表)动态字符串数组大小 = 屏蔽总行;
    0 = 名扫;
    当 (名扫 < 屏蔽总行) {
        (目标名表, 名扫)动态字符串数组获取 = 目标名;
        如果 (目标名 != "") {
            (名字表, 目标名)检查名查找 = (名位, 名中);
            如果 (名中 ?= 0) {
                (名字表, 名位, 目标名)动态字符串数组插入;
                (读标表, 名位, "0")动态字符串数组插入;
                (写标表, 名位, "0")动态字符串数组插入;
            }
        }
        名扫 + 1 = 名扫;
    }
    (名字表)动态字符串数组大小 = 名总数;
    0 = 名扫;
    当 (名扫 < 名总数) {
        (已查域, 0 - 1)动态数组添加;
        名扫 + 1 = 名扫;
    }
    0 = 名扫;
    当 (名扫 < 屏蔽总行) {
        (屏蔽行表, 名扫)动态字符串数组获取 = 屏蔽行;
        (目标名表, 名扫)动态字符串数组获取 = 目标名;
        (目标列表, 名扫)动态数组获取 = 目标列;
        0 - 1 = 跳位;
        如果 (目标名 != "") {
            目标列 - 1 = 跳位;
            (屏蔽行, 目标列)检查是调用写 = 是调用;
            如果 (是调用 ?= 1) {
                (名字表, 目标名)检查名查找 = (名位, 名中);
                如果 (名中 ?= 1) { (写标表, 名位, "1")动态字符串数组设置; }
            }
        }
        (屏蔽行)长度 = 行总长;
        0 = 序;
        当 (序 < 行总长) {
            (屏蔽行, 序)字符码 = 码;
            (码)检查是标识码 = 是标;
            如果 (是标 ?= 0) {
                序 + 1 = 序;
            } 否则 {
                // 切出一个极大标识符词 [词起, 词末)，非赋值目标位置的词即算读
                序 = 词起;
                词起 = 词末;
                1 = 继;
                当 (继 ?= 1 && 词末 < 行总长) {
                    (屏蔽行, 词末)字符码 = 码;
                    (码)检查是标识码 = 是标;
                    如果 (是标 ?= 1) { 词末 + 1 = 词末; } 否则 { 0 = 继; }
                }
                如果 (词起 != 跳位 && 名总数 > 0) {
                    (屏蔽行, 词起, 词末 - 词起)子串 = 词;
                    (名字表, 词)检查名查找 = (名位, 名中);
                    如果 (名中 ?= 1) {
                        (读标表, 名位)动态字符串数组获取 = 读文;
                        如果 (读文 ?= "0") { (读标表, 名位, "1")动态字符串数组设置; }
                    }
                }
                词末 = 序;
            }
        }
        名扫 + 1 = 名扫;
    }
    // 次遍：未使用变量（W004）——赋值目标「无读」、且无调用写 ⇒ 只写不读
    //      （同一函数作用域内同一变量只报首次写入行）
    //      不可达代码（W005）——同块内 `中断;` / `继续;` 之后的同层语句
    0 = 扫序;
    0 = 层深;
    0 - 1 = 跳层;
    0 = 域号;
    当 (扫序 < 屏蔽总行) {
        (屏蔽行表, 扫序)动态字符串数组获取 = 屏蔽行;
        (屏蔽行)检查拆语句行 = (前闭, 句列, 语句);
        (语句, 0, "函数")检查前缀是 = 是域界;
        如果 (是域界 ?= 0) { (语句, 0, "协程")检查前缀是 = 是域界; }
        如果 (是域界 ?= 1) { 域号 + 1 = 域号; }
        (目标名表, 扫序)动态字符串数组获取 = 目标名;
        (目标列表, 扫序)动态数组获取 = 目标列;
        如果 (目标名 != "") {
            (名字表, 目标名)检查名查找 = (名位, 名中);
            如果 (名中 ?= 1) {
                (已查域, 名位)动态数组获取 = 旧域;
                如果 (旧域 != 域号) {
                    (已查域, 名位, 域号)动态数组设置;
                    (读标表, 名位)动态字符串数组获取 = 读文;
                    (写标表, 名位)动态字符串数组获取 = 写文;
                    如果 (读文 ?= "0" && 写文 ?= "0") {
                        扫序 + 1 = 行号;
                        (结果, "警告", 行号, "未使用变量")检查追加诊断 = 结果;
                        (明细表, 行号, 目标列, "warning", "W004", "未使用变量")检查追加明细 = 明细表;
                        警告数 + 1 = 警告数;
                    }
                }
            }
        }
        0 = 闭序;
        当 (闭序 < 前闭) {
            如果 (跳层 >= 0 && 跳层 ?= 层深) { 0 - 1 = 跳层; }
            层深 - 1 = 层深;
            闭序 + 1 = 闭序;
        }
        (语句)长度 = 句长;
        如果 (句长 > 0) {
            如果 (跳层 >= 0 && 跳层 ?= 层深) {
                扫序 + 1 = 行号;
                (结果, "警告", 行号, "不可达代码")检查追加诊断 = 结果;
                (明细表, 行号, 句列, "warning", "W005", "不可达代码")检查追加明细 = 明细表;
                警告数 + 1 = 警告数;
            } 否则 {
                (语句)检查是跳转语句 = 是跳;
                如果 (是跳 ?= 1) { 层深 = 跳层; }
            }
            (语句)检查括号净增 = 净增;
            层深 + 净增 = 层深;
        }
        扫序 + 1 = 扫序;
    }
    // 第三遍：潜在空指针（W006）——可失败资源获取（`打开文件` / `分配`）的目标变量，
    //        首次使用之前若无判空（见 `检查有判空`）则告警；同一变量只报一次。
    0 = 扫序;
    当 (扫序 < 屏蔽总行) {
        (屏蔽行表, 扫序)动态字符串数组获取 = 屏蔽行;
        (屏蔽行)检查资源目标 = (资源名, 资源列, 是资源);
        如果 (是资源 ?= 1) {
            0 = 用行;
            0 = 用列;
            扫序 + 1 = 查序;
            0 = 查列;
            0 = 有防;
            0 = 停;
            当 (停 ?= 0 && 查序 < 屏蔽总行) {
                (屏蔽行表, 查序)动态字符串数组获取 = 查行;
                (查行, 资源名)检查查词列 = 查列;
                如果 (查列 > 0) {
                    (查行, 资源名)检查有判空 = 有防;
                    如果 (有防 ?= 0) {
                        查序 + 1 = 用行;
                        查列 = 用列;
                    }
                    1 = 停;
                }
                查序 + 1 = 查序;
            }
            (已报表)动态字符串数组大小 = 已报数;
            0 = 报序;
            0 = 重;
            当 (报序 < 已报数) {
                (已报表, 报序)动态字符串数组获取 = 报名;
                如果 (报名 ?= 资源名) { 1 = 重; }
                报序 + 1 = 报序;
            }
            如果 (用列 > 0 && 重 ?= 0) {
                (结果, "警告", 用行, "潜在空指针")检查追加诊断 = 结果;
                (明细表, 用行, 用列, "warning", "W006", "潜在空指针")检查追加明细 = 明细表;
                警告数 + 1 = 警告数;
                (已报表, 资源名)动态字符串数组添加;
            }
        }
        扫序 + 1 = 扫序;
    }
    // 第四遍：类型不匹配（W007）——① 字面量与 `:类型` 标注冲突；② 同函数内同名变量
    //        先后被整数 / 字符串字面量赋值。`函数` / `协程` 行在类型表压入 `#界` 标记，
    //        反向查找遇标记即止（作用域按函数重置，避免同名跨函数误报）。
    0 = 扫序;
    ()创建动态字符串数组 = 型名表;
    ()创建动态字符串数组 = 型种表;
    ()创建动态字符串数组 = 型报表;
    当 (扫序 < 总行) {
        (行表, 扫序)动态字符串数组获取 = 行;
        扫序 + 1 = 行号;
        (屏蔽行表, 扫序)动态字符串数组获取 = 屏蔽行;
        (行)检查拆语句行 = (前闭, 句列, 语句);
        (语句, 0, "函数")检查前缀是 = 是界;
        如果 (是界 ?= 0) { (语句, 0, "协程")检查前缀是 = 是界; }
        如果 (是界 ?= 1) {
            (型名表, "#界")动态字符串数组添加;
            (型种表, "")动态字符串数组添加;
            (型报表, "#界")动态字符串数组添加;
        }
        (行, 屏蔽行)检查声明冲突 = 声列;
        如果 (声列 > 0) {
            (结果, "警告", 行号, "类型不匹配")检查追加诊断 = 结果;
            (明细表, 行号, 声列, "warning", "W007", "类型不匹配")检查追加明细 = 明细表;
            警告数 + 1 = 警告数;
        }
        (行)检查赋值左值 = (左种, 左列);
        如果 (左种 > 0) {
            (目标名表, 扫序)动态字符串数组获取 = 目标名;
            如果 (目标名 != "") {
                "整数" = 左型;
                如果 (左种 ?= 2) { "字符串" = 左型; }
                (型名表, 型种表, 目标名)检查取型 = 旧种;
                如果 (旧种 ?= "") {
                    (型名表, 目标名)动态字符串数组添加;
                    (型种表, 左型)动态字符串数组添加;
                } 否则如果 (旧种 != 左型) {
                    (型报表, 目标名)检查表含词 = 已报型;
                    如果 (已报型 ?= 0) {
                        (结果, "警告", 行号, "类型不匹配")检查追加诊断 = 结果;
                        (明细表, 行号, 左列, "warning", "W007", "类型不匹配")检查追加明细 = 明细表;
                        警告数 + 1 = 警告数;
                        (型报表, 目标名)动态字符串数组添加;
                    }
                }
            }
        }
        扫序 + 1 = 扫序;
    }
    (警告数)文档整数转字符串 = 警文本;
    (错误数)文档整数转字符串 = 错文本;
    (结果, "---\n检查完成: 警告 ")拼接 = 结果;
    (结果, 警文本)拼接 = 结果;
    (结果, " 条, 错误 ")拼接 = 结果;
    (结果, 错文本)拼接 = 结果;
    (结果, " 条\n")拼接 = 结果;
}

// 纯文本诊断（对外格式与历史一致，不含列与错误码）
函数 (文本:字符串)代码检查诊断("" = 结果:字符串) {
    (文本)代码检查明细 = (结果, 明细表, 警告数, 错误数);
}

// ---------- 目录模式（单层、非递归） ----------

// 文件名是否以 `.心` 结尾 → 1
函数 (名称:字符串)检查是源文件名(0 = 结果:整数) {
    0 = 长;
    "" = 尾;
    0 = 结果;
    (名称)长度 = 长;
    如果 (长 >= 2) {
        (名称, 长 - 2, 2)子串 = 尾;
        如果 (尾 ?= ".心") { 1 = 结果; }
    }
}

// 拼接目录与名称（自建分隔符，避免 `连接路径` 的共享静态缓冲）
函数 (目录:字符串, 名称:字符串)检查拼接路径("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    (目录)长度 = 长;
    如果 (长 ?= 0) {
        名称 = 结果;
    } 否则 {
        (目录, 长 - 1)字符码 = 码;
        如果 (码 ?= 47 || 码 ?= 92) {
            (目录, 名称)拼接 = 结果;
        } 否则 {
            (目录, "/")拼接 = 结果;
            (结果, 名称)拼接 = 结果;
        }
    }
}

// 文本比较：按字符码逐位比较，前缀相同时短者在前 → -1 / 0 / 1
// （本地实现：不导入 `标准库/字符串.心`，避免模块键重复）
函数 (甲:字符串, 乙:字符串)检查文本比较(0 = 结果:整数) {
    0 = 甲长;
    0 = 乙长;
    0 = 短长;
    0 = i;
    0 = 甲码;
    0 = 乙码;
    0 = 结果;
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    甲长 = 短长;
    如果 (乙长 < 甲长) { 乙长 = 短长; }
    0 = i;
    当 (i < 短长 && 结果 ?= 0) {
        (甲, i)字符码 = 甲码;
        (乙, i)字符码 = 乙码;
        如果 (甲码 < 乙码) { 0 - 1 = 结果; }
        如果 (甲码 > 乙码) { 1 = 结果; }
        i + 1 = i;
    }
    如果 (结果 ?= 0) {
        如果 (甲长 < 乙长) { 0 - 1 = 结果; }
        如果 (甲长 > 乙长) { 1 = 结果; }
    }
}

// 文本数组升序插入排序（按 `检查文本比较`）
函数 (表)检查文本排序(空) {
    0 = 数;
    0 = i;
    0 = j;
    0 = 比;
    0 = 停;
    "" = 当前;
    "" = 前;
    (表)动态字符串数组大小 = 数;
    1 = i;
    当 (i < 数) {
        (表, i)动态字符串数组获取 = 当前;
        i - 1 = j;
        0 = 停;
        当 (j >= 0 && 停 ?= 0) {
            (表, j)动态字符串数组获取 = 前;
            (前, 当前)检查文本比较 = 比;
            如果 (比 > 0) {
                (表, j + 1, 前)动态字符串数组设置;
                j - 1 = j;
            } 否则 {
                1 = 停;
            }
        }
        (表, j + 1, 当前)动态字符串数组设置;
        i + 1 = i;
    }
}

// 诊断文本中「错误」开头的行数
函数 (诊断:字符串)检查错误行数(0 = 结果:整数) {
    0 = 总行;
    0 = 行序;
    0 = 行长;
    "" = 行;
    "" = 前两;
    0 = 结果;
    (诊断)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (诊断, 行序)文档取行 = 行;
        (行)长度 = 行长;
        如果 (行长 >= 2) {
            (行, 0, 2)子串 = 前两;
            如果 (前两 ?= "错误") { 结果 + 1 = 结果; }
        }
        行序 + 1 = 行序;
    }
}

// 路径表批量诊断：先按路径升序，再逐文件读取 + 检查；
// 每个文件输出 `== 路径 ==` + 单文件诊断，末尾汇总文件数与错误数。
函数 (表)检查表格诊断("" = 结果:字符串, 0 = 文件数:整数, 0 = 总错误:整数) {
    0 = 数;
    0 = i;
    0 = 本错;
    "" = 路径;
    "" = 原文;
    "" = 诊断;
    "" = 数文本;
    "" = 错文本;
    "" = 结果;
    0 = 文件数;
