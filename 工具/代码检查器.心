// 日月代码检查器（阶段P7 续：纯 .心 静态检查库）
// 用法: 导入 "../工具/代码检查器.心" 后调用
//       `(源文本)代码检查诊断`（单文件）、`(目录)检查目录诊断`（单层目录）
//       或 `(目录)检查目录诊断递归`（递归目录）
//       （库文件：入口见 示例/代码检查器测试.心；无 主程序，避免导入方重定义）
// 规则（11 条）：制表符缩进 / 行尾多余空白 / 全角标点 / 字符串未闭合 / `===` 与 `!==` 非法运算符
//               / 块注释未闭合（E003）/ 字符常量未闭合（E004）/ 未使用变量（W004）
//               / 不可达代码（W005）/ 潜在空指针（W006）/ 类型不匹配（W007）
// 纯 .心：复用文档生成器的 取行 / 行数 / 缩进 / `文档整数转字符串`，
//         仅用 字符码 / 子串 / 拼接 / 长度；不改编译器 ⇒ 自举不动点不变，双链逐字一致。
// 注意：不直接再导入 `标准库/字符串.心`；文档生成器亦不导入（见其文件头），
//       以免与 测试运行器 → 测试框架 → `字符串.心` 的模块键重复。
// 定位：文本模式维持 `严重 [行 N]: 消息`；JSON 模式另给 `column`（1 基）与 `code`
//       （W001 制表 / W002 行尾空白 / W003 全角标点 / W004 未使用变量 / W005 不可达代码
//        / W006 潜在空指针 / W007 类型不匹配
//        / E001 字符串未闭合 / E002 非法运算符 / E003 块注释未闭合 / E004 字符常量未闭合）。
// 字面量：全角标点与 `===` 在「屏蔽行」上判定——字符串 / 字符常量 / `//` 行注释 / `/* */`
//       块注释内不计；未闭合字面量按开引号位置报 E001（字符串）/ E004（字符常量），
//       未闭合块注释按开 `/*` 位置报 E003（跨行状态由 `代码检查明细` 持有）。
// 未使用变量：只统计「读位置」——赋值语句右侧的单一标识符目标（`值 = 变量;`，去 `:类型`
//       后缀）在各屏蔽行中作为独立整词出现、但**不处于任何赋值目标位置**的次数为 0 时，
//       判为「只写不读」报 W004（同一函数作用域内同名变量只报首次写入行）；若该变量有
//       任一次「调用写」（赋值号左侧含括号 ⇒ 调用结果落地、有意丢弃）则不报；
//       函数 / 结构体 / 枚举 / 外部 / 导出 前缀行与注解行不查（声明语句）。
// 不可达代码：按花括号层级跟踪，同一块内 `中断;` / `继续;` 之后的同层语句判不可达报 W005；
//       遇 `}` 关闭该块即解除（含 `} 否则 {` 的另一分支）。
// 潜在空指针：可失败资源获取（调用名为 `打开文件` / `分配`，失败返回 0 / 空指针）的赋值目标，
//       其「首次使用」之前若无判空行（同行含 `?= 0` / `!= 0` / `> 0` / `>= 1` / `< 1`），
//       在该使用行列报 W006；同一变量只报一次，遇判空即视为安全。
// 类型不匹配：两条保守子规则——① 字面量赋值与 `:类型` 标注冲突（`0 = 名:字符串;` /
//       `"" = 名:整数;`）；② 同一函数（`函数` / `协程` 起新作用域）内同名变量先后被
//       整数 / 字符串字面量赋值，在后者行报 W007，同一变量只报一次。
// 限制：不做完整词法/语法分析（不识别原始字符串与嵌套块注释）；W004 为保守启发式——
//       同一行多条语句只取最后一个 `=`（只剔除该目标位置，其余出现一律算读，宁可漏报）；
//       形参 / 局部变量在别处的出现算读，跨文件读取（库导出全局）因此不再误报；
//       赋值号左侧含括号即视为「调用写」而豁免（纯函数返回值丢弃不会被报出，宁可漏报）；
//       作用域仅按 `函数` / `协程` 行切分，同名变量在不同函数内分别判定；
//       W005 只认整行独立成句的 `中断;` / `继续;`（带标签或与其它语句同行不查）；
//       W006 只认 `变量` 之外的普通赋值行，资源函数名白名单仅两名，判空只认 0/1 比较
//       （自定义谓词不识别，宁缺勿滥；跨函数传递后判空的情形不跟踪）；
//       W007 只认「纯整数字面量 / 纯字符串字面量」赋值左侧（表达式与调用结果不推断），
//       类型标注只认 `:整数` / `:字符串` 两种，参数与返回位标注不参与推断。

导入 "../工具/文档生成器.心";

// 屏蔽字面量与注释：返回等长「屏蔽行」（串 / 字符常量 / 注释内字符变空格）。
//   · 入参 在块 = 行首是否已处于块注释（承接上一行的状态）；
//   · 出参 未闭列 / 字未闭列 = 本行未闭合的字符串 / 字符常量起始列（1 基，闭合 → 0）；
//   · 出参 块起列 = 本行新开且未闭合的 `/*` 起始列（承接进来 → 0）；
//   · 出参 出块 = 行尾是否仍在块注释中。
// 线索：换行后的转义与引号仍需按字符推进，故逐码点扫描。
函数 (行:字符串, 在块:整数)检查屏蔽字面量(0 = 未闭列:整数, 0 = 字未闭列:整数, 0 = 块起列:整数, 0 = 出块:整数, "" = 结果:字符串) {
    0 = 行长;
    0 = i;
    0 = 码;
    0 = 次码;
    0 = 在串;
    0 = 在字;
    0 = 串起;
    0 = 字起;
    0 = 停;
    0 = 块开;
    "" = 单;
    "" = 空格;
    (行)长度 = 行长;
    (32)字符 = 空格;
    0 = 未闭列;
    0 = 字未闭列;
    0 = 块起列;
    在块 = 出块;
    0 = 在串;
    0 = 在字;
    0 = 串起;
    0 = 字起;
    0 = 块开;
    0 = i;
    当 (停 ?= 0 && i < 行长) {
        (行, i)字符码 = 码;
        如果 (出块 ?= 1) {
            // 块注释内：寻 `*/` 收尾，其余一律屏蔽
            如果 (码 ?= 42 && i + 1 < 行长) {
                (行, i + 1)字符码 = 次码;
                如果 (次码 ?= 47) {
                    0 = 出块;
                    0 = 块开;
                    (结果, 空格)拼接 = 结果;
                    (结果, 空格)拼接 = 结果;
                    i + 1 = i;
                } 否则 {
                    (结果, 空格)拼接 = 结果;
                }
            } 否则 {
                (结果, 空格)拼接 = 结果;
            }
        } 否则如果 (在串 ?= 1) {
            如果 (码 ?= 92) {
                (结果, 空格)拼接 = 结果;
                i + 1 = i;
                如果 (i < 行长) { (结果, 空格)拼接 = 结果; }
            } 否则如果 (码 ?= 34) {
                0 = 在串;
                0 = 串起;
                (结果, 空格)拼接 = 结果;
            } 否则 {
                (结果, 空格)拼接 = 结果;
            }
        } 否则如果 (在字 ?= 1) {
            // 字符常量内：反斜杠转义连同下一字符一并屏蔽
            如果 (码 ?= 92) {
                (结果, 空格)拼接 = 结果;
                i + 1 = i;
                如果 (i < 行长) { (结果, 空格)拼接 = 结果; }
            } 否则如果 (码 ?= 39) {
                0 = 在字;
                0 = 字起;
                (结果, 空格)拼接 = 结果;
            } 否则 {
                (结果, 空格)拼接 = 结果;
            }
        } 否则如果 (码 ?= 34) {
            1 = 在串;
            i + 1 = 串起;
            (结果, 空格)拼接 = 结果;
        } 否则如果 (码 ?= 39) {
            1 = 在字;
            i + 1 = 字起;
            (结果, 空格)拼接 = 结果;
        } 否则如果 (码 ?= 47 && i + 1 < 行长) {
            (行, i + 1)字符码 = 次码;
            如果 (次码 ?= 47) {
                行长 = i;
                1 = 停;
            } 否则如果 (次码 ?= 42) {
                1 = 出块;
                i + 1 = 块开;
                (结果, 空格)拼接 = 结果;
                (结果, 空格)拼接 = 结果;
                i + 1 = i;
            } 否则 {
                (行, i, 1)子串 = 单;
                (结果, 单)拼接 = 结果;
            }
        } 否则 {
            (行, i, 1)子串 = 单;
            (结果, 单)拼接 = 结果;
        }
        i + 1 = i;
    }
    如果 (在串 ?= 1) {
        串起 = 未闭列;
    }
    如果 (在字 ?= 1) {
        字起 = 字未闭列;
    }
    如果 (出块 ?= 1 && 块开 > 0) {
        块开 = 块起列;
    }
}

// 缩进区内首个制表符列（1 基）→ 无则 0
函数 (行:字符串)检查制表列(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i < 起) {
        (行, i)字符码 = 码;
        如果 (码 ?= 9) {
            i + 1 = 结果;
            1 = 停;
        }
        i + 1 = i;
    }
}

// 行尾空白串的起始列（1 基）→ 无则 0
函数 (行:字符串)检查尾白列(0 = 结果:整数) {
    (行)长度 = 行长;
    0 = i;
    0 = 结果;
    0 = 停;
    行长 = i;
    当 (停 ?= 0 && i > 0) {
        i - 1 = i;
        (行, i)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) {
            i + 1 = 结果;
        } 否则 {
            1 = 停;
        }
    }
}

// 全角标点码：，。；：！？ → 1
函数 (码:整数)检查全角码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 65292 || 码 ?= 12290 || 码 ?= 65307 || 码 ?= 65306) { 1 = 结果; }
    如果 (码 ?= 65281 || 码 ?= 65311) { 1 = 结果; }
}

// 行内首个全角标点列（1 基，作用于屏蔽行）→ 无则 0
函数 (行:字符串)检查全角列(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i < 行长) {
        (行, i)字符码 = 码;
        (码)检查全角码 = 是;
        如果 (是 ?= 1) {
            i + 1 = 结果;
            1 = 停;
        }
        i + 1 = i;
    }
}

// 行内首个 `===` / `!==` 列（1 基，作用于屏蔽行）→ 无则 0
函数 (行:字符串)检查非法列(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i + 2 < 行长) {
        (行, i)字符码 = 甲;
        (行, i + 1)字符码 = 乙;
        (行, i + 2)字符码 = 丙;
        如果 (甲 ?= 61 && 乙 ?= 61 && 丙 ?= 61) { i + 1 = 结果; 1 = 停; }
        如果 (甲 ?= 33 && 乙 ?= 61 && 丙 ?= 61) { i + 1 = 结果; 1 = 停; }
        i + 1 = i;
    }
}

// 标识符码点：ASCII 字母 / 数字 / 下划线，或非全角标点的东亚文字 → 1
函数 (码:整数)检查是标识码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
    如果 (码 >= 65 && 码 <= 90) { 1 = 结果; }
    如果 (码 >= 97 && 码 <= 122) { 1 = 结果; }
    如果 (码 ?= 95) { 1 = 结果; }
    如果 (码 >= 128) {
        1 = 结果;
        (码)检查全角码 = 全角;
        如果 (全角 ?= 1) { 0 = 结果; }
        如果 (码 ?= 12288 || 码 ?= 65288 || 码 ?= 65289 || 码 ?= 65282) { 0 = 结果; }
        如果 (码 ?= 8216 || 码 ?= 8217 || 码 ?= 8220 || 码 ?= 8221 || 码 ?= 8230) { 0 = 结果; }
        如果 (码 ?= 65308 || 码 ?= 65309 || 码 ?= 65310 || 码 ?= 65291 || 码 ?= 65293) { 0 = 结果; }
    }
}

// 行内从 起 处是否以前缀开头 → 1
函数 (行:字符串, 起:整数, 前缀:字符串)检查前缀是(0 = 结果:整数) {
    0 = 行长;
    0 = 前缀长;
    0 = i;
    0 = 甲;
    0 = 乙;
    1 = 结果;
    (行)长度 = 行长;
    (前缀)长度 = 前缀长;
    如果 (起 + 前缀长 > 行长) { 0 = 结果; }
    0 = i;
    当 (i < 前缀长 && 结果 ?= 1) {
        (行, 起 + i)字符码 = 甲;
        (前缀, i)字符码 = 乙;
        如果 (甲 != 乙) { 0 = 结果; }
        i + 1 = i;
    }
}

// 赋值语句的单一标识符目标：`值 = 变量;` 中的「变量」与其 1 基列号。
//   · 仅认「去尾空白后以 `;` 结尾」的行；`?=` / `!=` / `>=` / `<=` / `==` 不算赋值号；
//   · 取行内最后一个赋值号，右侧须为唯一标识符（可带 `:类型` 后缀），否则返回空名；
//   · 以 函数 / 结构体 / 枚举 / 外部 / 导出 开头或 `@` 注解行跳过（声明行不查）。
函数 (行:字符串)检查赋值目标("" = 名:字符串, 0 = 列:整数) {
    "" = 名;
    0 = 列;
    0 = 行长;
    0 = 起;
    0 = 末;
    0 = i;
    0 = 码;
    0 = 前码;
    0 = 等号;
    0 = 停;
    0 = 是;
    "" = 前缀;
    (行)长度 = 行长;
    0 = 起;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i < 行长) {
        (行, i)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) {
            i + 1 = 起;
            i + 1 = i;
        } 否则 {
            1 = 停;
        }
    }
    0 = 末;
    0 = i;
    0 = 停;
    行长 = i;
    当 (停 ?= 0 && i > 起) {
        i - 1 = i;
        (行, i)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) {
            i = 末;
        } 否则 {
            i + 1 = 末;
            1 = 停;
        }
    }
    如果 (末 > 起) {
        (行, 末 - 1)字符码 = 码;
        如果 (码 ?= 59) {
            "函数" = 前缀;
            (行, 起, 前缀)检查前缀是 = 是;
            如果 (是 ?= 0) {
                "结构体" = 前缀;
                (行, 起, 前缀)检查前缀是 = 是;
            }
            如果 (是 ?= 0) {
                "枚举" = 前缀;
                (行, 起, 前缀)检查前缀是 = 是;
            }
            如果 (是 ?= 0) {
                "外部" = 前缀;
                (行, 起, 前缀)检查前缀是 = 是;
            }
            如果 (是 ?= 0) {
                "导出" = 前缀;
                (行, 起, 前缀)检查前缀是 = 是;
            }
            如果 (是 ?= 0) {
                (行, 起)字符码 = 码;
                如果 (码 ?= 64) { 1 = 是; }
            }
            如果 (是 ?= 0) {
                0 = 等号;
                0 = i;
                起 = i;
                当 (i < 末 - 1) {
                    (行, i)字符码 = 码;
                    如果 (码 ?= 61) {
                        0 = 前码;
                        如果 (i > 起) { (行, i - 1)字符码 = 前码; }
                        如果 (前码 != 63 && 前码 != 33 && 前码 != 62 && 前码 != 60 && 前码 != 61) {
                            (行, i + 1)字符码 = 前码;
                            如果 (前码 != 61) { i = 等号; }
                        }
                    }
                    i + 1 = i;
                }
            }
            如果 (是 ?= 0 && 等号 > 0) {
                0 = i;
                等号 + 1 = i;
                当 (i < 末 - 1 && 名 ?= "") {
                    (行, i)字符码 = 码;
                    (码)检查是标识码 = 是标;
                    如果 (码 ?= 32 || 码 ?= 9) {
                        i + 1 = i;
                    } 否则如果 (是标 ?= 1) {
                        i + 1 = 列;
                        (行, i, 1)子串 = 单;
                        (名, 单)拼接 = 名;
                        i + 1 = i;
                        当 (i < 末 - 1) {
                            (行, i)字符码 = 码;
                            (码)检查是标识码 = 是标;
                            如果 (是标 ?= 1) {
                                (行, i, 1)子串 = 单;
                                (名, 单)拼接 = 名;
                                i + 1 = i;
                            } 否则 {
                                末 - 1 = i;
                            }
                        }
                    } 否则 {
                        末 - 1 = i;
                    }
                }
                // 右侧标识符后须直接收到 `;`（中间仅空白）
                (名)长度 = 名长;
                0 = i;
                如果 (名长 > 0) {
                    列 - 1 = i;
                    i + 名长 = i;
                    0 = 停;
                    当 (停 ?= 0 && i < 末 - 1) {
                        (行, i)字符码 = 码;
                        如果 (码 ?= 32 || 码 ?= 9) {
                            i + 1 = i;
                        } 否则 {
                            1 = 停;
                            0 = 列;
                            "" = 名;
                        }
                    }
                } 否则 {
                    0 = 列;
                    "" = 名;
                }
                // 全局声明 `0 = 变量 名;` 的右侧首词是关键字，不是变量名
                如果 (名 ?= "变量") {
                    0 = 列;
                    "" = 名;
                }
            }
        }
    }
}

// 词序比较（按字符码逐位比较，短者在前）：甲 < 乙 → -1，相等 → 0，甲 > 乙 → 1
函数 (甲:字符串, 乙:字符串)检查词比较(0 = 结果:整数) {
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    0 = 短;
    0 = i;
    0 = 甲码;
    0 = 乙码;
    0 = 结果;
    甲长 = 短;
    如果 (乙长 < 短) { 乙长 = 短; }
    当 (结果 ?= 0 && i < 短) {
        (甲, i)字符码 = 甲码;
        (乙, i)字符码 = 乙码;
        如果 (甲码 < 乙码) { 0 - 1 = 结果; }
        如果 (甲码 > 乙码) { 1 = 结果; }
        i + 1 = i;
    }
    如果 (结果 ?= 0 && 甲长 != 乙长) {
        如果 (甲长 < 乙长) { 0 - 1 = 结果; } 否则 { 1 = 结果; }
    }
}

// 在按词序升序排列的 名字表 中二分查找 名：
//   命中 → 命中 = 1、位置 = 索引；未命中 → 命中 = 0、位置 = 应插入位置（保持升序）
函数 (名字表, 名:字符串)检查名查找(0 = 位置:整数, 0 = 命中:整数) {
    (名字表)动态字符串数组大小 = 总数;
    0 = 低;
    0 = 高;
    0 = 中;
    0 = 序;
    0 = 位置;
    0 = 命中;
    "" = 表名;
    总数 = 高;
