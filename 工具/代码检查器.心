// 全量检查：逐行应用 5 条规则，返回诊断文本（末尾附警告/错误计数）
函数 (文本:字符串)代码检查诊断("" = 结果:字符串) {
    "" = 结果;
    0 = 警告数;
    0 = 错误数;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        行序 + 1 = 行号;
        (行)检查制表缩进 = 制表;
        如果 (制表 ?= 1) {
            (结果, "警告", 行号, "制表符缩进")检查追加诊断 = 结果;
            警告数 + 1 = 警告数;
        }
        (行)检查行尾空白 = 尾白;
        如果 (尾白 ?= 1) {
            (结果, "警告", 行号, "行尾多余空白")检查追加诊断 = 结果;
            警告数 + 1 = 警告数;
        }
        (行)检查行注释 = 注释;
        如果 (注释 ?= 0) {
            (行)检查全角标点 = 全角;
            如果 (全角 ?= 1) {
                (结果, "警告", 行号, "全角标点")检查追加诊断 = 结果;
                警告数 + 1 = 警告数;
            }
            (行)检查引号计数 = 引号数;
            引号数 % 2 = 引号余;
            如果 (引号余 ?= 1) {
                (结果, "错误", 行号, "字符串未闭合")检查追加诊断 = 结果;
                错误数 + 1 = 错误数;
            }
            (行)检查非法运算符 = 非法;
            如果 (非法 ?= 1) {
                (结果, "错误", 行号, "非法运算符 === 或 !==")检查追加诊断 = 结果;
                错误数 + 1 = 错误数;
            }
        }
        行序 + 1 = 行序;
    }
    (警告数)文档整数转字符串 = 警文本;
    (错误数)文档整数转字符串 = 错文本;
    (结果, "---\n检查完成: 警告 ")拼接 = 结果;
    (结果, 警文本)拼接 = 结果;
    (结果, " 条, 错误 ")拼接 = 结果;
    (结果, 错文本)拼接 = 结果;
    (结果, " 条\n")拼接 = 结果;
}

