    当 (i < 数) {
        (表, i)动态字符串数组获取 = 当前;
        i - 1 = j;
        0 = 停;
        当 (j >= 0 && 停 ?= 0) {
            (表, j)动态字符串数组获取 = 前;
            (前, 当前)检查文本比较 = 比;
            如果 (比 > 0) {
                (表, j + 1, 前)动态字符串数组设置;
                j - 1 = j;
            } 否则 {
                1 = 停;
            }
        }
        (表, j + 1, 当前)动态字符串数组设置;
        i + 1 = i;
    }
}

