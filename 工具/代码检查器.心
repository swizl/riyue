// 日月代码检查器（阶段P7 续：纯 .心 静态检查库）
// 用法: 导入 "../工具/代码检查器.心" 后调用 `(源文本)代码检查诊断`
//       （库文件：入口见 示例/代码检查器测试.心；无 主程序，避免导入方重定义）
// 规则（5 条）：制表符缩进 / 行尾多余空白 / 全角标点 / 字符串未闭合 / `===` 与 `!==` 非法运算符
// 纯 .心：复用文档生成器的 取行 / 行数 / 缩进（及其传递导入的 `整数转字符串`），
//         仅用 字符码 / 子串 / 拼接 / 长度；不改编译器 ⇒ 自举不动点不变，双链逐字一致。
// 注意：不直接再导入 `标准库/字符串.心`——自举链的模块键不规范化 `..`，
//       同一文件经不同相对路径会被合并两次（`invalid redefinition`）。
// 限制：以 `//` 开头的注释行只检查缩进与行尾空白；不解析字符串字面量，
//       因此字面量内的 `===` 或全角标点也会计数（简单规则检查器，非完整语法分析）。

导入 "../工具/文档生成器.心";

// 行首 `//` 注释 → 1
函数 (行:字符串)检查行注释(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    (行)长度 = 行长;
    如果 (起 + 2 <= 行长) {
        (行, 起, 2)子串 = 两;
        如果 (两 ?= "//") { 1 = 结果; }
    }
}

// 缩进区内含制表符 → 1
函数 (行:字符串)检查制表缩进(0 = 结果:整数) {
    0 = 结果;
    (行)文档行缩进 = 起;
    0 = i;
    当 (i < 起) {
        (行, i)字符码 = 码;
        如果 (码 ?= 9) { 1 = 结果; }
        i + 1 = i;
    }
}

// 行尾为空格或制表符 → 1
函数 (行:字符串)检查行尾空白(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    如果 (行长 > 0) {
        (行, 行长 - 1)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) { 1 = 结果; }
    }
}

// 全角标点码：，。；：！？ → 1
函数 (码:整数)检查全角码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 65292 || 码 ?= 12290 || 码 ?= 65307 || 码 ?= 65306) { 1 = 结果; }
    如果 (码 ?= 65281 || 码 ?= 65311) { 1 = 结果; }
}

// 行内含全角标点 → 1
函数 (行:字符串)检查全角标点(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    当 (i < 行长) {
        (行, i)字符码 = 码;
        (码)检查全角码 = 是;
        如果 (是 ?= 1) { 1 = 结果; }
        i + 1 = i;
    }
}

// 未转义双引号个数（跳过 `\` 后的一个字符）
函数 (行:字符串)检查引号计数(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    当 (i < 行长) {
        (行, i)字符码 = 码;
        如果 (码 ?= 92) {
            i + 1 = i;
        } 否则如果 (码 ?= 34) {
            结果 + 1 = 结果;
        }
        i + 1 = i;
    }
}

// 行内含 `===` 或 `!==` → 1
函数 (行:字符串)检查非法运算符(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 行长;
    0 = i;
    当 (i + 2 < 行长) {
        (行, i)字符码 = 甲;
        (行, i + 1)字符码 = 乙;
        (行, i + 2)字符码 = 丙;
        如果 (甲 ?= 61 && 乙 ?= 61 && 丙 ?= 61) { 1 = 结果; }
        如果 (甲 ?= 33 && 乙 ?= 61 && 丙 ?= 61) { 1 = 结果; }
        i + 1 = i;
    }
}

// 追加一条诊断：`严重 [行 N]: 消息\n`
函数 (结果:字符串, 严重:字符串, 行号:整数, 消息:字符串)检查追加诊断("" = 结果输出:字符串) {
    (结果, 严重)拼接 = 结果输出;
    (结果输出, " [行 ")拼接 = 结果输出;
    (行号)整数转字符串 = 行文本;
    (结果输出, 行文本)拼接 = 结果输出;
    (结果输出, "]: ")拼接 = 结果输出;
    (结果输出, 消息)拼接 = 结果输出;
    (结果输出, "\n")拼接 = 结果输出;
}

// 全量检查：逐行应用 5 条规则，返回诊断文本（末尾附警告/错误计数）
函数 (文本:字符串)代码检查诊断("" = 结果:字符串) {
    "" = 结果;
    0 = 警告数;
    0 = 错误数;
    (文本)文档行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)文档取行 = 行;
        行序 + 1 = 行号;
        (行)检查制表缩进 = 制表;
        如果 (制表 ?= 1) {
            (结果, "警告", 行号, "制表符缩进")检查追加诊断 = 结果;
            警告数 + 1 = 警告数;
        }
        (行)检查行尾空白 = 尾白;
        如果 (尾白 ?= 1) {
            (结果, "警告", 行号, "行尾多余空白")检查追加诊断 = 结果;
            警告数 + 1 = 警告数;
        }
        (行)检查行注释 = 注释;
        如果 (注释 ?= 0) {
            (行)检查全角标点 = 全角;
            如果 (全角 ?= 1) {
                (结果, "警告", 行号, "全角标点")检查追加诊断 = 结果;
                警告数 + 1 = 警告数;
            }
            (行)检查引号计数 = 引号数;
            引号数 % 2 = 引号余;
            如果 (引号余 ?= 1) {
                (结果, "错误", 行号, "字符串未闭合")检查追加诊断 = 结果;
                错误数 + 1 = 错误数;
            }
            (行)检查非法运算符 = 非法;
            如果 (非法 ?= 1) {
                (结果, "错误", 行号, "非法运算符 === 或 !==")检查追加诊断 = 结果;
                错误数 + 1 = 错误数;
            }
        }
        行序 + 1 = 行序;
    }
    (警告数)整数转字符串 = 警文本;
    (错误数)整数转字符串 = 错文本;
    (结果, "---\n检查完成: 警告 ")拼接 = 结果;
    (结果, 警文本)拼接 = 结果;
    (结果, " 条, 错误 ")拼接 = 结果;
    (结果, 错文本)拼接 = 结果;
    (结果, " 条\n")拼接 = 结果;
}
