// 日月 DAP 会话逻辑（阶段10 续65：VS Code 调试器集成）
// 纯 `.心`：不触碰 stdio，回归里可直接单测分派；帧循环见 工具/DAP服务端.心。
// 帧格式复用 工具/LSP报文.心（`Content-Length: N\r\n\r\n` + JSON 正文，按字节计长）。
//
// 支持的方法：initialize / launch / attach / setBreakpoints / setExceptionBreakpoints /
//            configurationDone / threads / stackTrace / scopes / variables /
//            continue / next / stepIn / stepOut / pause / evaluate /
//            disconnect / terminate；未知请求 → -32601。
// 事件：initialized / stopped(entry) / output / exited / terminated。
//
// 能力边界（诚实声明，见 文档/短板补齐计划.md §6.3）：
//   · 编译器 `--调试` 已发射 DWARF 行表，但本适配器不挂接调试引擎；
//   · 断点仅登记（verified=false），不中断执行；
//   · 栈帧只有「入口」一帧，作用域 / 变量为空（运行时未暴露变量快照）；
//   · 单步（next / stepIn / stepOut）与「继续」等价；程序输出在运行结束后一次性回放。

导入 "LSP报文.心";

// 收到 disconnect / terminate 后置 1：服务端主循环据此终止
0 = 变量 退出请求;
// launch 登记的待运行程序路径（服务端在 configurationDone 后编译并运行）
"" = 变量 待运行程序;
// 1 = 服务端应立即编译并运行（configurationDone 未停在入口，或 continue / 单步请求）
0 = 变量 待运行;
// 1 = 程序已经启动过（避免单步重复触发重跑）
0 = 变量 已运行;
// 1 = 当前停在入口（stopOnEntry）
0 = 变量 停止中;
// 1 = 本次 launch 要求停在入口
0 = 变量 入口暂停;
// 断点登记：最近一次 setBreakpoints 的源文件与条数（仅登记，不生效）
"" = 变量 断点文件;
0 = 变量 断点条数;

函数 ()DAP模块版本(0 = 结果:整数) {
    1 = 结果;
}

// JSON 字段取值：JSON获取字符串 共用静态缓冲，取到后立刻复制
函数 (正文:字符串, 键:字符串)DAP取字段("" = 结果:字符串) {
    (正文, 键)JSON获取字符串 = 暂;
    ("", 暂)拼接 = 结果;
}

// JSON 字符串反转义：\n \t \r \" \\ \/（未知转义保留原字符）
函数 (文本:字符串)DAP反转义("" = 结果:字符串) {
    "" = 输出;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 92 && i + 1 < 总长) {
            (文本, i + 1)字符码 = 后码;
            0 = 认;
            如果 (后码 ?= 110) { 10 = 后码; 1 = 认; }
            如果 (后码 ?= 116) { 9 = 后码; 1 = 认; }
            如果 (后码 ?= 114) { 13 = 后码; 1 = 认; }
            如果 (后码 ?= 34) { 34 = 后码; 1 = 认; }
            如果 (后码 ?= 92) { 92 = 后码; 1 = 认; }
            如果 (后码 ?= 47) { 47 = 后码; 1 = 认; }
            如果 (认 ?= 1) {
                (后码)字符 = 符;
                (输出, 符)拼接 = 输出;
                i + 2 = i;
            } 否则 {
                (码)字符 = 符;
                (输出, 符)拼接 = 输出;
                i + 1 = i;
            }
        } 否则 {
            (码)字符 = 符;
            (输出, 符)拼接 = 输出;
            i + 1 = i;
        }
    }
    输出 = 结果;
}

// JSON 字符串转义：控制字符（\r 丢弃 / \n \t 转义）+ 引号 + 反斜
函数 (文本:字符串)DAP转义("" = 结果:字符串) {
    "" = 结果;
    (34)字符 = 单;
    ("", 单)拼接 = 引;
    (92)字符 = 单;
    ("", 单)拼接 = 反斜;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 13) {
            (结果, "")拼接 = 结果;
        } 否则如果 (码 ?= 34) {
            (结果, 反斜)拼接 = 结果;
            (结果, 引)拼接 = 结果;
        } 否则如果 (码 ?= 92) {
            (结果, 反斜)拼接 = 结果;
            (结果, 反斜)拼接 = 结果;
        } 否则如果 (码 ?= 10) {
            (结果, 反斜)拼接 = 结果;
            (结果, "n")拼接 = 结果;
        } 否则如果 (码 ?= 9) {
            (结果, 反斜)拼接 = 结果;
            (结果, "t")拼接 = 结果;
        } 否则 {
            (码)字符 = 符;
            (结果, 符)拼接 = 结果;
        }
        i + 1 = i;
    }
}

// 子串出现次数（setBreakpoints 的断点条数 = `"line"` 出现次数）
函数 (文本:字符串, 子:字符串)DAP计数(0 = 结果:整数) {
    0 = 结果;
    (子)长度 = 子长;
    如果 (子长 > 0) {
        (文本)长度 = 总长;
        0 = i;
        当 (i + 子长 <= 总长) {
            (文本, i, 子长)子串 = 片;
            如果 (片 ?= 子) {
                结果 + 1 = 结果;
                i + 子长 = i;
            } 否则 {
                i + 1 = i;
            }
        }
    }
}

// 成功应答帧：{"jsonrpc":"2.0","id":N,"result":<载荷>}
函数 (编号:整数, 载荷:字符串)DAP结果帧("" = 结果:字符串) {
    (编号)整数转字符串 = 编号文;
    "{\"jsonrpc\":\"2.0\",\"id\":" + 编号文 + ",\"result\":" + 载荷 + "}" = 体;
    (体)构造报文按字节 = 结果;
}

// 错误应答帧：{"jsonrpc":"2.0","id":N,"error":{"code":C,"message":"M"}}
函数 (编号:整数, 码:整数, 消息:字符串)DAP错误帧("" = 结果:字符串) {
    (编号)整数转字符串 = 编号文;
    (码)整数转字符串 = 码文;
    (消息)DAP转义 = 消息文;
    "{\"jsonrpc\":\"2.0\",\"id\":" + 编号文 + ",\"error\":{\"code\":" + 码文 + ",\"message\":\"" + 消息文 + "\"}}" = 体;
    (体)构造报文按字节 = 结果;
}

// 事件帧：{"jsonrpc":"2.0","method":"<方法名>","params":<参数>}
函数 (方法名:字符串, 参数:字符串)DAP通知帧("" = 结果:字符串) {
    "{\"jsonrpc\":\"2.0\",\"method\":\"" + 方法名 + "\",\"params\":" + 参数 + "}" = 体;
    (体)构造报文按字节 = 结果;
}

// initialize 应答：只声明 configurationDone / terminate 两项能力
函数 (编号:整数)DAP初始化应答("" = 结果:字符串) {
    "{\"capabilities\":{\"supportsConfigurationDoneRequest\":true,\"supportsTerminateRequest\":true}}" = 载荷;
    (编号, 载荷)DAP结果帧 = 结果;
}

// 停在入口事件（reason=entry）
函数 ()DAP停止帧("" = 结果:字符串) {
    "{\"reason\":\"entry\",\"description\":\"停在入口：日月暂不支持行级断点\",\"threadId\":1,\"allThreadsStopped\":true}" = 参;
    ("stopped", 参)DAP通知帧 = 结果;
}

// 断点数组：条数 = 请求条数，逐条标记 verified=false（已登记但不生效）
函数 (条数:整数)DAP断点数组("" = 结果:字符串) {
    "" = 结果;
    0 = i;
    当 (i < 条数) {
        如果 (i ?= 0) {
            "" = 结果;
        } 否则 {
            (结果, ",")拼接 = 结果;
        }
        "{\"verified\":false,\"message\":\"日月暂不支持行级断点（已登记）\"}" = 项;
        (结果, 项)拼接 = 结果;
        i + 1 = i;
    }
    "[" + 结果 + "]" = 结果;
}

// 停在入口时，continue / 单步 / 暂停一律视为「开始执行」（单步等价继续）
函数 ()DAP恢复 {
    如果 (停止中 ?= 1 && 已运行 ?= 0) {
        0 = 停止中;
        1 = 待运行;
    }
}

// DAP 分派：返回应答 / 事件帧（可拼接多帧）；无应答（通知）返回 ""
函数 (正文:字符串)DAP处理("" = 结果:字符串) {
    "" = 结果;
    (正文, "method")DAP取字段 = 方法名;
    (正文, "id")JSON获取整数 = 编号;
    (正文, "id")JSON存在 = 有编号;
    "" = 未支持;
    如果 (方法名 ?= "initialize") {
        (编号)DAP初始化应答 = 结果;
        ("initialized", "{}")DAP通知帧 = 事件;
        (结果, 事件)拼接 = 结果;
    } 否则如果 (方法名 ?= "launch" || 方法名 ?= "attach") {
        (正文, "program")DAP取字段 = 程序原;
        (程序原)DAP反转义 = 程序;
        如果 (程序 != "") { 程序 = 待运行程序; }
        (正文, "stopOnEntry")JSON获取布尔 = 停;
        停 = 入口暂停;
        "" = 断点文件;
        0 = 断点条数;
        (编号, "{}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "setBreakpoints") {
        (正文, "path")DAP取字段 = 路径原;
        (路径原)DAP反转义 = 断点文件;
        "\"line\"" = 行键;
        (正文, 行键)DAP计数 = 条数;
        条数 = 断点条数;
        (条数)DAP断点数组 = 数组;
        "{\"breakpoints\":" + 数组 + "}" = 载荷;
        (编号, 载荷)DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "setExceptionBreakpoints") {
        (编号, "{}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "configurationDone") {
        (编号, "{}")DAP结果帧 = 结果;
        如果 (入口暂停 ?= 1) {
            1 = 停止中;
            ()DAP停止帧 = 事件;
            (结果, 事件)拼接 = 结果;
        } 否则 {
            1 = 待运行;
        }
    } 否则如果 (方法名 ?= "threads") {
        (编号, "{\"threads\":[{\"id\":1,\"name\":\"主线程\"}]}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "stackTrace") {
        如果 (停止中 ?= 1) {
            (待运行程序)DAP转义 = 路径;
            "{\"stackFrames\":[{\"id\":1,\"name\":\"主程序\",\"source\":{\"name\":\"日月程序\",\"path\":\"" + 路径 + "\"},\"line\":1,\"column\":1}],\"totalFrames\":1}" = 载荷;
            (编号, 载荷)DAP结果帧 = 结果;
        } 否则 {
            (编号, "{\"stackFrames\":[],\"totalFrames\":0}")DAP结果帧 = 结果;
        }
    } 否则如果 (方法名 ?= "scopes") {
        (编号, "{\"scopes\":[]}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "variables") {
        (编号, "{\"variables\":[]}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "evaluate") {
        (编号, "{\"result\":\"日月暂不支持表达式求值\",\"variablesReference\":0}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "continue") {
        ()DAP恢复;
        (编号, "{\"allThreadsContinued\":true}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "next" || 方法名 ?= "stepIn" || 方法名 ?= "stepOut" || 方法名 ?= "pause") {
        ()DAP恢复;
        (编号, "{}")DAP结果帧 = 结果;
    } 否则如果 (方法名 ?= "disconnect" || 方法名 ?= "terminate") {
        1 = 退出请求;
        (编号, "{}")DAP结果帧 = 结果;
    } 否则 {
        如果 (有编号 ?= 1) {
            "未支持的方法: " + 方法名 = 未支持;
            (编号, -32601, 未支持)DAP错误帧 = 结果;
        } 否则 {
            "" = 结果;
        }
    }
}
