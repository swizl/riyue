// 测试运行器命令行入口
// 用法: 日月.exe 工具/测试运行器命令行.心 [目录] [过滤词] [编译器]
//   目录   默认 示例
//   过滤词 默认 空（全部）；按套件名子串过滤
//   编译器 默认 日月.exe
//
// 运行器主体见 工具/测试运行器.心（纯库，无 主程序，可被示例导入）。

导入 "../工具/测试运行器.心";

函数 主程序 {
    "" = 目录;
    "" = 过滤词;
    "" = 编译器;
    "" = 临时;
    "示例" = 目录;
    "日月.exe" = 编译器;
    ()获取参数数量 = 参数数;
    如果 (参数数 > 1) {
        (1)获取参数 = 临时;
        (临时, "")拼接 = 目录;
    }
    如果 (参数数 > 2) {
        (2)获取参数 = 临时;
        (临时, "")拼接 = 过滤词;
    }
    如果 (参数数 > 3) {
        (3)获取参数 = 临时;
        (临时, "")拼接 = 编译器;
    }
    ("日月测试运行器 v2.0")打印;
    ("=")打印;
    (目录, 过滤词, 编译器, "构建/.tr")测试运行目录 = (通过, 失败, 跳过);
    (通过, 失败, 跳过)测试汇总;
}
