// 日月包管理器 - 功能演示版
// 使用：函数、动态数组（存储整数ID）

// 全局状态
"" = 项目名称;
"" = 项目版本;
0 = 包计数;

// 包名映射（简化版，用整数ID代替）
"" = 包1名称;
"" = 包2名称;
"" = 包3名称;

// 安装包
函数 (名称:字符串, ID:整数)安装包 {
    如果 (ID ?= 1) { 名称 = 包1名称; }
    如果 (ID ?= 2) { 名称 = 包2名称; }
    如果 (ID ?= 3) { 名称 = 包3名称; }
    包计数 + 1 = 包计数;
    ("安装包: ")打印;
    (名称)打印;
    ("  (ID: ")打印;
    (ID)打印;
    (")")打印;
    ("")打印;
}

// 列出包
函数 列出包 {
    ("已安装的包 (")打印;
    (包计数)打印;
    ("):")打印;
    ("")打印;
    如果 (包计数 >= 1) {
        ("  - ")打印;
        (包1名称)打印;
        ("")打印;
    }
    如果 (包计数 >= 2) {
        ("  - ")打印;
        (包2名称)打印;
        ("")打印;
    }
    如果 (包计数 >= 3) {
        ("  - ")打印;
        (包3名称)打印;
        ("")打印;
    }
}

// 主程序
函数 主程序 {
    ("=== 日月包管理器 v1.0 ===")打印;
    ("")打印;

    // 初始化
    "我的项目" = 项目名称;
    "0.1.0" = 项目版本;
    ("项目: ")打印;
    (项目名称)打印;
    (" v")打印;
    (项目版本)打印;
    ("")打印;
    ("")打印;

    // 安装包
    ("math", 1)安装包;
    ("json", 2)安装包;
    ("string", 3)安装包;
    ("")打印;

    // 列出包
    ()列出包;
    ("")打印;

    // 搜索演示
    ("搜索: json")打印;
    ("  (搜索功能待实现)")打印;
    ("")打印;

    // 更新演示
    ("更新包...")打印;
    ("  检查 math...")打印;
    ("  检查 json...")打印;
    ("  检查 string...")打印;
    ("")打印;

    // 帮助
    ("日月包管理器 v1.0")打印;
    ("用法: 包管理器 <命令> [参数]")打印;
    ("命令: 初始化/安装/卸载/列表/搜索/更新")打印;
    ("")打印;

    ("=== 完成 ===")打印;
}
