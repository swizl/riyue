// 日月包管理器 v4.0 - 远程仓库版
// 支持从远程仓库下载安装包

// 包注册表目录
"标准库/" = 包目录;
"https://raw.githubusercontent.com/user/riyue-packages/main/" = 仓库地址;

// 已安装包列表
"" = 已安装包1;
"" = 已安装包2;
"" = 已安装包3;
"" = 已安装包4;
"" = 已安装包5;
0 = 已安装数量;

// 检查包是否已安装
函数 (名称:字符串)检查已安装(0 = 已安装:整数) {
    如果 (名称 ?= 已安装包1) { 1 = 已安装; }
    如果 (名称 ?= 已安装包2) { 1 = 已安装; }
    如果 (名称 ?= 已安装包3) { 1 = 已安装; }
    如果 (名称 ?= 已安装包4) { 1 = 已安装; }
    如果 (名称 ?= 已安装包5) { 1 = 已安装; }
    已安装;
}

// 从远程仓库下载包
函数 (名称:字符串)下载包(0 = 成功:整数) {
    ("下载包: ")打印;
    (名称)打印;
    ("")打印;
    仓库地址 + 名称 + ".心" = 下载地址;
    ("  URL: ")打印;
    (下载地址)打印;
    ("")打印;
    (下载地址)HTTP获取 = 内容;
    如果 (内容 ?= "") {
        ("  下载失败")打印;
        ("")打印;
        0 = 成功;
    } 否则 {
        包目录 + 名称 + ".心" = 本地路径;
        (本地路径, 内容)写入文件 = 写入结果;
        如果 (写入结果 ?= 0) {
            ("  下载成功: ")打印;
            (本地路径)打印;
            ("")打印;
            1 = 成功;
        } 否则 {
            ("  写入文件失败")打印;
            ("")打印;
            0 = 成功;
        }
    }
    成功;
}

// 安装包（支持远程下载）
函数 (名称:字符串)安装包 {
    (名称)检查已安装 = 已安装;
    如果 (已安装) {
        ("包 '")打印;
        (名称)打印;
        ("' 已安装")打印;
        ("")打印;
    } 否则如果 (已安装数量 >= 5) {
        ("错误: 已达到最大包数量限制 (5)")打印;
        ("")打印;
    } 否则 {
        // 先检查本地是否存在
        包目录 + 名称 + ".心" = 本地路径;
        (本地路径)读取文件 = 本地内容;
        如果 (本地内容 != "") {
            ("本地安装: ")打印;
            (名称)打印;
            ("")打印;
        } 否则 {
            // 从远程下载
            (名称)下载包 = 下载成功;
            如果 (下载成功) {
                已安装数量 + 1 = 已安装数量;
                如果 (已安装数量 ?= 1) { 名称 = 已安装包1; }
                否则如果 (已安装数量 ?= 2) { 名称 = 已安装包2; }
                否则如果 (已安装数量 ?= 3) { 名称 = 已安装包3; }
                否则如果 (已安装数量 ?= 4) { 名称 = 已安装包4; }
                否则如果 (已安装数量 ?= 5) { 名称 = 已安装包5; }
                ("安装完成: ")打印;
                (名称)打印;
                ("")打印;
            } 否则 {
                ("安装失败: ")打印;
                (名称)打印;
                ("")打印;
            }
        }
    }
}

// 列出已安装包
函数 列出已安装 {
    ("已安装的包 (")打印;
    (已安装数量)打印;
    ("):")打印;
    ("")打印;
    如果 (已安装包1 != "") { ("  - ")打印; (已安装包1)打印; ("")打印; }
    如果 (已安装包2 != "") { ("  - ")打印; (已安装包2)打印; ("")打印; }
    如果 (已安装包3 != "") { ("  - ")打印; (已安装包3)打印; ("")打印; }
    如果 (已安装包4 != "") { ("  - ")打印; (已安装包4)打印; ("")打印; }
    如果 (已安装包5 != "") { ("  - ")打印; (已安装包5)打印; ("")打印; }
}

// 卸载包
函数 (名称:字符串)卸载包 {
    (名称)检查已安装 = 已安装;
    如果 (!已安装) {
        ("包 '")打印;
        (名称)打印;
        ("' 未安装")打印;
        ("")打印;
    } 否则 {
        ("卸载包: ")打印;
        (名称)打印;
        ("")打印;
        如果 (名称 ?= 已安装包1) { "" = 已安装包1; }
        如果 (名称 ?= 已安装包2) { "" = 已安装包2; }
        如果 (名称 ?= 已安装包3) { "" = 已安装包3; }
        如果 (名称 ?= 已安装包4) { "" = 已安装包4; }
        如果 (名称 ?= 已安装包5) { "" = 已安装包5; }
        已安装数量 - 1 = 已安装数量;
    }
}

// 主程序
函数 主 {
    ("=== 日月包管理器 v4.0 ===")打印;
    ("")打印;
    ("数学")安装包;
    ("字符串")安装包;
    ("")打印;
    ()列出已安装;
    ("")打印;
    ("数学")安装包;
    ("")打印;
    ("JSON")卸载包;
    ("")打印;
    ()列出已安装;
    ("=== 完成 ===")打印;
}
