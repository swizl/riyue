// 日月包管理器
//
// 正式化切片：包管理核心（清单解析 / 依赖解析与版本冲突 / 锁文件与校验和 / 子命令分派）
// 下沉到 `标准库/包管理.心`，本文件只做演示编排。规范见 `文档/短板补齐计划.md` §Phase 2。
//
// 数据约定：
//   注册表 = 动态字符串数组，元素形如 `名称@版本`
//   清单   = `包信息.心` 的 `键 = 值` 文本（键：名称/版本/描述/作者/依赖）
//   依赖   = `名称 约束`，约束语法见 `标准库/版本.心`（= > >= < <= ^ ~ 与通配、逗号区间）
//
// 限制：不做多包传递闭包 / 冲突回溯；不访问网络（注册表由调用方给出）。

导入 "../标准库/包管理.心";

// 演示用注册表（真实场景由远程索引拉取后装填）
函数 (注册表)装填注册表 {
    (注册表, "数学@1.0.0")动态字符串数组添加;
    (注册表, "数学@1.2.0")动态字符串数组添加;
    (注册表, "数学@2.0.0")动态字符串数组添加;
    (注册表, "字符串@1.1.0")动态字符串数组添加;
    (注册表, "JSON@0.9.0")动态字符串数组添加;
}

// 演示用清单（等价于项目根的 `包信息.心`）
函数 ()构造清单("" = 清单:字符串) {
    "" = 换行;
    (10)字符 = 换行;
    (清单, "名称 = 演示项目")拼接 = 清单;
    (清单, 换行)拼接 = 清单;
    (清单, "版本 = 0.1.0")拼接 = 清单;
    (清单, 换行)拼接 = 清单;
    (清单, "依赖 = 数学 >=1.0.0, 字符串 ^1.0.0")拼接 = 清单;
    (清单, 换行)拼接 = 清单;
}

函数 主 {
    ("=== 日月包管理器 ===")打印;
    ("")打印;

    ()创建动态字符串数组 = 注册表;
    (注册表)装填注册表;
    ()构造清单 = 清单;

    ("[列表]")打印;
    ("列表", "", 清单, 注册表)包命令 = 命令码;
    ("")打印;

    ("[搜索 数学]")打印;
    ("搜索", "数学", 清单, 注册表)包命令 = 命令码;
    ("")打印;

    ("[安装 数学 <2.0.0]")打印;
    ("安装", "数学 <2.0.0", 清单, 注册表)包命令 = 命令码;
    ("")打印;

    ("[锁定]")打印;
    ("锁定", "", 清单, 注册表)包命令 = 命令码;
    ("")打印;

    ("[未知命令]")打印;
    ("发布", "", 清单, 注册表)包命令 = 命令码;
    ("")打印;

    ("=== 完成 ===")打印;
}
