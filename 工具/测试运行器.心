// ==================== 模块版本 4：输出捕获 / 结果解析 / 覆盖率 ====================
//   · 子进程 stdout+stderr 重定向到独立文件（运行时不提供管道读取），再以 `读取文件` 读回；
//   · 数字解析只用 `子串` + `字符码` + `字符串比较`（`字符串转整数` 来自 字符串.心，
//     经 测试框架 传递包含），避免 `查找` 的字节偏移与字符索引混用。

// 从 起点 起取首个连续十进制数字段 → (数值, 新位置)；无数字 → (0, 起点)
函数 (文本:字符串, 起点:整数)测试取整数(0 = 值:整数, 0 = 新位:整数) {
    0 = 长;
    0 = i;
    0 = 末;
    0 = 码;
    0 = 始;
    0 = 停;
    "" = 段;
    (文本)长度 = 长;
    起点 = i;
    -1 = 始;
    当 (始 < 0 && i < 长) {
        (文本, i)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            i = 始;
        } 否则 {
            i + 1 = i;
        }
    }
    如果 (始 < 0) {
        起点 = 新位;
    } 否则 {
        始 = i;
        始 = 末;
        0 = 停;
        当 (停 ?= 0 && 末 < 长) {
            (文本, 末)字符码 = 码;
            如果 (码 < 48 || 码 > 57) {
                1 = 停;
            } 否则 {
                末 + 1 = 末;
            }
        }
        (文本, 始, 末 - 始)子串 = 段;
        (段)字符串转整数 = 值;
        末 = 新位;
    }
}

// 解析测试输出中的 `测试结果: N 通过, M 失败` → (通过, 失败, 命中)
//   · 未出现 `测试结果:` → 命中 = 0，通过/失败 均为 -1（区别于「0 通过 0 失败」）。
函数 (输出:字符串)测试解析结果(0 = 通过:整数, 0 = 失败:整数, 0 = 命中:整数) {
    0 = 长;
    0 = 标长;
    0 = i;
    0 = 比;
    0 = 位;
    0 = 阶段;
    0 = 新位;
    "" = 片段;
    "测试结果:" = 标记;
    (标记)长度 = 标长;
    (输出)长度 = 长;
    -1 = 通过;
    -1 = 失败;
    0 = 命中;
    0 = 阶段;
    0 = i;
    当 (阶段 ?= 0 && i + 标长 <= 长) {
        (输出, i, 标长)子串 = 片段;
        (片段, 标记)字符串比较 = 比;
        如果 (比 ?= 0) {
            i + 标长 = 位;
            1 = 阶段;
        }
        i + 1 = i;
    }
    如果 (阶段 ?= 1) {
        (输出, 位)测试取整数 = (通过, 新位);
        (输出, 新位)测试取整数 = (失败, 新位);
        1 = 命中;
    }
}

// 捕获运行：编译成功后把子进程 stdout/stderr 重定向到 输出文件，再读回文本。
//   · 编译失败 → 结果 -1、输出 ""；否则 结果 = 子进程退出码、输出 = 落盘内容；
//   · 与 `测试编译运行` 同口径：Windows 补 `.exe` 并把路径换反斜杠；POSIX 原样。
函数 (编译器:字符串, 文件:字符串, 输出名:字符串, 输出文件:字符串)测试编译运行捕获(0 = 结果:整数, "" = 输出:字符串) {
    0 = 编译码;
    0 = 码;
    0 = 宿主系统长;
    "" = 宿主系统;
    "" = 命令;
    "" = 程序;
    -1 = 结果;
    "" = 输出;
    (编译器, 文件, 输出名)测试编译运行 = 编译码;
    如果 (编译码 ?= 0) {
        ("OS")获取环境变量 = 宿主系统;
        (宿主系统)长度 = 宿主系统长;
        如果 (宿主系统长 > 0) {
            (输出名, ".exe")拼接 = 程序;
            (程序)测试反斜杠 = 程序;
        } 否则 {
            输出名 = 程序;
        }
        (输出文件)测试反斜杠 = 输出文件;
        (程序, " >")拼接 = 命令;
        (命令, 输出文件)拼接 = 命令;
        (命令, " 2>&1")拼接 = 命令;
        (命令)执行命令 = 码;
        码 = 结果;
        (输出文件)读取文件 = 输出;
    }
}

// 断言点覆盖率百分比：执行点 / 静态点，四舍五入整数，上限 100；静态点 ≤ 0 → 0
//   · 静态点按 `断言` 文本出现次数近似，可能与运行期计数不同口径，故截断到 100%。
函数 (静点:整数, 动点:整数)测试覆盖百分比(0 = 结果:整数) {
    0 = 结果;
    如果 (静点 > 0 && 动点 > 0) {
        (动点 * 100 + 静点 / 2) / 静点 = 结果;
        如果 (结果 > 100) { 100 = 结果; }
    }
}

// 目录级断言点覆盖率报告（逐套件 静态断言点 vs 运行期已执行断言数）
//   · 报告行：`套件 静态=N 执行=M 覆盖=R%`；子进程未输出 `测试结果:` → 执行 = -1、覆盖 0%
//   · 末尾：`覆盖汇总: 套件 K / 断言点 S / 已执行 E / 覆盖率 R%`
//   · 过滤词口径同 `测试运行目录`（套件名子串，命中才计入）
函数 (目录:字符串, 过滤词:字符串, 编译器:字符串, 输出前缀:字符串)测试覆盖报告("" = 报告:字符串, 0 = 套件数:整数, 0 = 静态点:整数, 0 = 执行点:整数) {
    0 = 数;
    0 = i;
    0 = 命中;
    0 = 码;
    0 = 静;
    0 = 动;
    0 = 通过;
    0 = 失败;
    0 = 有结果;
    0 = 率;
    0 = 总率;
    "" = 文件;
    "" = 名;
    "" = 套件;
    "" = 输出名;
    "" = 输出文件;
    "" = 子输出;
    "" = 行;
    "" = 文;
    (目录)测试发现 = 文件表;
    (文件表)动态字符串数组大小 = 数;
    "" = 报告;
    0 = i;
    当 (i < 数) {
        (文件表, i)动态字符串数组获取 = 文件;
        (文件)测试基名 = 名;
        (名)测试套件名 = 套件;
        (套件, 过滤词)测试名匹配 = 命中;
        如果 (命中 ?= 1) {
            (文件)测试文件断言数 = 静;
            (输出前缀, 套件)拼接 = 输出名;
            (输出名, ".out")拼接 = 输出文件;
            (编译器, 文件, 输出名, 输出文件)测试编译运行捕获 = (码, 子输出);
            -1 = 动;
            (子输出)测试解析结果 = (通过, 失败, 有结果);
            如果 (有结果 ?= 1) {
                通过 + 失败 = 动;
            }
            (静, 动)测试覆盖百分比 = 率;
            静 + 静态点 = 静态点;
            如果 (动 > 0) {
                动 + 执行点 = 执行点;
            }
            套件 = 行;
            (行, " 静态=")拼接 = 行;
            (静)整数转字符串 = 文;
            (行, 文)拼接 = 行;
            (行, " 执行=")拼接 = 行;
            (动)整数转字符串 = 文;
            (行, 文)拼接 = 行;
            (行, " 覆盖=")拼接 = 行;
            (率)整数转字符串 = 文;
            (行, 文)拼接 = 行;
            (行, "%")拼接 = 行;
            如果 (码 < 0) {
                (行, " (编译失败)")拼接 = 行;
            } 否则如果 (有结果 ?= 0) {
                (行, " (无测试结果)")拼接 = 行;
            }
            (报告, 行)拼接 = 报告;
            (报告, "\n")拼接 = 报告;
            套件数 + 1 = 套件数;
        }
        i + 1 = i;
    }
    (静态点, 执行点)测试覆盖百分比 = 总率;
    (报告, "覆盖汇总: 套件 ")拼接 = 报告;
    (套件数)整数转字符串 = 文;
    (报告, 文)拼接 = 报告;
    (报告, " / 断言点 ")拼接 = 报告;
    (静态点)整数转字符串 = 文;
    (报告, 文)拼接 = 报告;
    (报告, " / 已执行 ")拼接 = 报告;
    (执行点)整数转字符串 = 文;
    (报告, 文)拼接 = 报告;
    (报告, " / 覆盖率 ")拼接 = 报告;
    (总率)整数转字符串 = 文;
    (报告, 文)拼接 = 报告;
    (报告, "%")拼接 = 报告;
}
