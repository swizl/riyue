// 测试运行器（库模块）
// 用法: 日月.exe 工具/测试运行器命令行.心 [目录] [过滤词] [编译器]
//
// 说明：本文件为纯库（无 `主程序`），便于被 示例/ 用例 `导入`；
//       自举链的 `导入` 是文本包含，被导入模块若含 `主程序` 会与之重复定义。
//       命令行入口见 工具/测试运行器命令行.心。
//
// 阶段：短板补齐计划 §Phase 3「测试框架」/ §3.1 测试运行器
//   · 自动发现：列出目录 → 取文件名 → 以 `测试.心` 结尾判定测试源（跳过子目录）
//   · 套件组织：文件名 → 套件名（去 `.心`，再去尾部 `测试`）
//   · 过滤：过滤词为套件名子串（复用 `测试框架.心` 的 `测试名匹配`）
//   · 执行：`创建进程(编译器 文件 输出名)` → `等待进程` 取编译码；编译通过后再运行产物取退出码
//   · 汇总：通过 / 失败 / 跳过 + 通过率
//   · 静态覆盖率近似：`断言` 标记在源码中出现的次数（`测试文件断言数`）
//
// 纯 `.心` 切片（不改编译器 / 文法 / 自举源 ⇒ 不动点恒定）。
// 限制：不捕获子进程 stdout（运行时无管道读取内建），故以退出码判定通过；
//       不做并行执行 / 不做 setup-teardown 跨文件钩子（单文件内见 `测试运行带钩子`）。

// 导入测试框架
导入 "../标准库/测试框架.心";

// 模块版本：3 = 自动发现 / 套件名 / 过滤 / 编译运行 / 汇总 / 断言点计数 / 逐套件明细（JSON 片段）
函数 ()测试运行器模块版本(0 = 结果:整数) {
    3 = 结果;
}

// 文件名是否测试源：以 `测试.心` 结尾 → 1
函数 (名称:字符串)测试源文件名(0 = 结果:整数) {
    0 = 长;
    0 = 后长;
    0 = 比;
    "" = 尾;
    (名称)长度 = 长;
    ("测试.心")长度 = 后长;
    如果 (长 >= 后长) {
        (名称, 长 - 后长, 后长)子串 = 尾;
        (尾, "测试.心")字符串比较 = 比;
        如果 (比 ?= 0) { 1 = 结果; }
    }
}

// 路径的基名（最后一个 `/` 或 `\` 之后；无分隔符 → 原样复制）
函数 (路径:字符串)测试基名("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    0 = 位;
    0 = i;
    (路径)长度 = 长;
    -1 = 位;
    0 = i;
    当 (i < 长) {
        (路径, i)字符码 = 码;
        如果 (码 ?= 47 || 码 ?= 92) {
            i = 位;
        }
        i + 1 = i;
    }
    如果 (位 >= 0) {
        (路径, 位 + 1, 长 - 位 - 1)子串 = 结果;
    } 否则 {
        路径 = 结果;
    }
}

// 文件名 → 套件名：去扩展名（最后一个 `.` 之后舍弃），再去尾部 `测试`
函数 (名称:字符串)测试套件名("" = 结果:字符串) {
    0 = 长;
    0 = 字;
    0 = 位;
    0 = 基长;
    0 = 尾长;
    0 = 比;
    "" = 基;
    "" = 尾;
    (名称)长度 = 长;
    -1 = 位;
    0 = 字;
    当 (字 < 长) {
        (名称, 字)字符码 = 基长;
        如果 (基长 ?= 46) {
            字 = 位;
        }
        字 + 1 = 字;
    }
    如果 (位 >= 0) {
        (名称, 0, 位)子串 = 基;
    } 否则 {
        名称 = 基;
    }
    (基)长度 = 基长;
    ("测试")长度 = 尾长;
    如果 (基长 >= 尾长) {
        (基, 基长 - 尾长, 尾长)子串 = 尾;
        (尾, "测试")字符串比较 = 比;
        如果 (比 ?= 0) {
            (基, 0, 基长 - 尾长)子串 = 基;
        }
    }
    基 = 结果;
}

// 拼接目录与文件名（自建分隔符，避免 `连接路径` 的共享静态缓冲）
函数 (目录:字符串, 名称:字符串)测试拼接路径("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    (目录)长度 = 长;
    如果 (长 ?= 0) {
        名称 = 结果;
    } 否则 {
        (目录, 长 - 1)字符码 = 码;
        如果 (码 ?= 47 || 码 ?= 92) {
            (目录, 名称)拼接 = 结果;
        } 否则 {
            (目录, "/")拼接 = 结果;
            (结果, 名称)拼接 = 结果;
        }
    }
}

// 文本数组升序插入排序（按 `字符串比较`）
函数 (表)测试文本排序(空) {
    0 = 数;
    0 = i;
    0 = j;
    0 = 比;
    0 = 停;
    "" = 当前;
    "" = 前;
    (表)动态字符串数组大小 = 数;
    1 = i;
    当 (i < 数) {
        (表, i)动态字符串数组获取 = 当前;
        i - 1 = j;
        0 = 停;
        当 (j >= 0 && 停 ?= 0) {
            (表, j)动态字符串数组获取 = 前;
            (前, 当前)字符串比较 = 比;
            如果 (比 > 0) {
                (表, j + 1, 前)动态字符串数组设置;
                j - 1 = j;
            } 否则 {
                1 = 停;
            }
        }
        (表, j + 1, 当前)动态字符串数组设置;
        i + 1 = i;
    }
}

// 发现目录下的测试源（跳过子目录；结果升序）→ 新动态字符串数组句柄
函数 (目录:字符串)测试发现(0 = 结果:指针) {
    0 = 项数;
    0 = i;
    0 = 是目录;
    0 = 命中;
    "" = 名;
    "" = 路径;
    ()创建动态字符串数组 = 表;
    (目录)列出目录 = 项数;
    0 = i;
    当 (i < 项数) {
        (i)获取目录项名称 = 名;
        (名, "")拼接 = 名;
        (i)获取目录项是否目录 = 是目录;
        如果 (是目录 ?= 0) {
            (名)测试源文件名 = 命中;
            如果 (命中 ?= 1) {
                (目录, 名)测试拼接路径 = 路径;
                (表, 路径)动态字符串数组添加;
            }
        }
        i + 1 = i;
    }
    (表)测试文本排序;
    表 = 结果;
}

// 发现 + 过滤（过滤词为套件名子串；空词保留全部）→ (句柄, 数量)
函数 (目录:字符串, 过滤词:字符串)测试发现过滤(0 = 结果:指针, 0 = 数量:整数) {
    0 = 数;
    0 = i;
    0 = 命中;
    "" = 文件;
    "" = 名;
    "" = 套件;
    ()创建动态字符串数组 = 表;
    (目录)测试发现 = 全部;
    (全部)动态字符串数组大小 = 数;
    0 = i;
    当 (i < 数) {
        (全部, i)动态字符串数组获取 = 文件;
        (文件)测试基名 = 名;
        (名)测试套件名 = 套件;
        (套件, 过滤词)测试名匹配 = 命中;
        如果 (命中 ?= 1) {
            (表, 文件)动态字符串数组添加;
            数量 + 1 = 数量;
        }
        i + 1 = i;
    }
    表 = 结果;
}

// 把路径中的 `/` 换成 `\`：cmd /c 的首个词含 `/` 会被当作开关（如 `构建/.tr甲.exe`
// 被拆成命令 `构建` + 开关 `/.tr甲.exe`），换成分隔符后即可直接执行。
//   · 口径统一：`长度`/`子串`/`字符码` 均按**字符**索引，故逐字符重建，
//     不与 `查找`（按字节偏移）混用。
函数 (路径:字符串)测试反斜杠("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    0 = i;
    "" = 字;
    "" = 反;
    (92)字符 = 反;
    (路径)长度 = 长;
    "" = 结果;
    0 = i;
    当 (i < 长) {
        (路径, i)字符码 = 码;
        如果 (码 ?= 47) {
            (结果, 反)拼接 = 结果;
        } 否则 {
            (码)字符 = 字;
            (结果, 字)拼接 = 结果;
        }
        i + 1 = i;
    }
}

// 单文件编译并运行：-1 = 编译失败；否则返回程序退出码
//   · 走 `执行命令`（运行时的 UTF-8 → 宽字符 `_wsystem`），避免 `创建进程` 的窄接口
//     经 cmd 代码页曲解中文编译器名（如 `日月.exe`）；
//   · 子进程输出一律重定向到宿主空设备，保持运行器输出可判定。
函数 (编译器:字符串, 文件:字符串, 输出名:字符串)测试编译运行(0 = 结果:整数) {
    0 = 编译码;
    "" = 命令;
    "" = 程序;
    // 宿主差异：Windows 下 `OS` 环境变量为 Windows_NT（非空）；POSIX 下通常未设置。
    //   · 分隔符：cmd 需要反斜杠，否则会把 `构建/x.exe` 拆成命令 + 开关；
    //   · 空设备：cmd 为 nul，POSIX 为 /dev/null。
    ("OS")获取环境变量 = 宿主系统;
    (宿主系统)长度 = 宿主系统长;
    "" = 空设备;
    如果 (宿主系统长 > 0) { " >nul 2>&1" = 空设备; } 否则 { " >/dev/null 2>&1" = 空设备; }
    // POSIX 的 shell 不会在当前目录查找命令（cmd 会），故无路径成分时补 `./`。
    编译器 = 实编译器;
    如果 (宿主系统长 ?= 0) {
        0 = 需前缀;
        (编译器)长度 = 编译器长;
        如果 (编译器长 > 0) {
            (编译器, 0)字符码 = 首码;
            如果 (首码 ?= 47 || 首码 ?= 46) { 0 = 需前缀; } 否则 { 1 = 需前缀; }
        }
        如果 (需前缀 ?= 1) { ("./", 编译器)拼接 = 实编译器; }
    }
    (实编译器, " ")拼接 = 命令;
    (命令, 文件)拼接 = 命令;
    (命令, " ")拼接 = 命令;
    (命令, 输出名)拼接 = 命令;
    (命令, 空设备)拼接 = 命令;
    (命令)执行命令 = 编译码;
    -1 = 结果;
    如果 (编译码 ?= 0) {
        如果 (宿主系统长 > 0) {
            // Windows 链接层会给产物补 `.exe` 后缀
            (输出名, ".exe")拼接 = 程序;
            (程序)测试反斜杠 = 程序;
        } 否则 {
            // ELF 产物按给定路径原样落盘，无 `.exe` 约定
            输出名 = 程序;
        }
        (程序, 空设备)拼接 = 程序;
        (程序)执行命令 = 结果;
    }
}

// 单套件明细 JSON 片段：`{"name":"…","status":"…"}`
//   · 与 代码检查器 同口径：不自建 `\"` 字面量，用 `(34)字符` 拼接；
//   · 套件名来自文件名（去 `.心` 与尾部 `测试`），不含 `"` / `\`，故不转义（见限制）。
函数 (套件:字符串, 状态:字符串)测试明细项("" = 结果:字符串) {
    "" = 引;
    (34)字符 = 引;
    "{" = 结果;
    (结果, 引)拼接 = 结果;
    (结果, "name")拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, ":")拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, 套件)拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, ",")拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, "status")拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, ":")拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, 状态)拼接 = 结果;
    (结果, 引)拼接 = 结果;
    (结果, "}")拼接 = 结果;
}

// 目录级执行（含逐套件明细）：发现 → 过滤 → 逐个编译运行 → 汇总计数
//   明细 = JSON 对象片段，逗号分隔、不含外层方括号（空表 → ""）
函数 (目录:字符串, 过滤词:字符串, 编译器:字符串, 输出前缀:字符串)测试运行目录明细(0 = 通过:整数, 0 = 失败:整数, 0 = 跳过:整数, "" = 明细:字符串) {
    0 = 数;
    0 = i;
    0 = 命中;
    0 = 码;
    "" = 文件;
    "" = 名;
    "" = 套件;
    "" = 输出名;
    "" = 项;
    "" = 状态;
    (目录)测试发现 = 文件表;
    (文件表)动态字符串数组大小 = 数;
    0 = i;
    当 (i < 数) {
        (文件表, i)动态字符串数组获取 = 文件;
        (文件)测试基名 = 名;
        (名)测试套件名 = 套件;
        (套件, 过滤词)测试名匹配 = 命中;
        如果 (命中 ?= 1) {
            (输出前缀, 套件)拼接 = 输出名;
            (编译器, 文件, 输出名)测试编译运行 = 码;
            如果 (码 ?= 0) {
                通过 + 1 = 通过;
                "passed" = 状态;
            } 否则 {
                失败 + 1 = 失败;
                "failed" = 状态;
            }
            (套件, 状态)测试明细项 = 项;
            如果 (明细 ?= "") {
                项 = 明细;
            } 否则 {
                (明细, ",")拼接 = 明细;
                (明细, 项)拼接 = 明细;
            }
        } 否则 {
            跳过 + 1 = 跳过;
            "skipped" = 状态;
            (套件, 状态)测试明细项 = 项;
            如果 (明细 ?= "") {
                项 = 明细;
            } 否则 {
                (明细, ",")拼接 = 明细;
                (明细, 项)拼接 = 明细;
            }
        }
        i + 1 = i;
    }
}

// 目录级执行（仅计数）：与 明细 同口径，丢弃明细
函数 (目录:字符串, 过滤词:字符串, 编译器:字符串, 输出前缀:字符串)测试运行目录(0 = 通过:整数, 0 = 失败:整数, 0 = 跳过:整数) {
    (目录, 过滤词, 编译器, 输出前缀)测试运行目录明细 = (通过, 失败, 跳过, 明细);
}

// 汇总单行报告（与 `测试报告` 同格式，计数来自入参）
函数 (通过:整数, 失败:整数, 跳过:整数)测试汇总(空) {
    0 = 总;
    0 = 率;
    "" = 行;
    通过 + 失败 = 总;
    如果 (总 > 0) {
        (通过 * 100 + 总 / 2) / 总 = 率;
    }
    (通过)整数转字符串 = 通;
    (失败)整数转字符串 = 失;
    (跳过)整数转字符串 = 跳;
    (率)整数转字符串 = 率文;
    ("套件: 通过 ", 通)拼接 = 行;
    (行, " / 失败 ")拼接 = 行;
    (行, 失)拼接 = 行;
    (行, " / 跳过 ")拼接 = 行;
    (行, 跳)拼接 = 行;
    (行, " / 通过率 ")拼接 = 行;
    (行, 率文)拼接 = 行;
    (行, "%")拼接 = 行;
    (行)打印;
}

// 源码中 `断言` 标记出现次数（静态覆盖率近似）
//   · 按字符滑窗取片段再比较，避免 `查找`（字节偏移）与 `子串`（字符索引）口径混用。
