// 格式化器（库模块）
// 用法: 导入 "../工具/格式化器.心" 后调用 `(源文本)格式化文本`
//       或 `(源文本, 缩进单位)格式化文本按缩进` 指定缩进风格（如 "  " / "\t"）
//       （库文件：入口见 工具/格式化器命令行.心；无 主程序，避免导入方重定义）
//
// 阶段：短板补齐计划 §Phase 7「工具链增强」/ §7.1 代码格式化器
//   · 缩进：按花括号 `{` / `}` 深度，每层默认 4 空格（可按缩进单位配置）；
//     行首为 `}` 时先降层再输出
//   · 去行尾空白（空格 / 制表 / 回车）
//   · 连续空行压成 1 行；去首部空行（尾部空行随之丢弃）
//
// 纯 `.心` 切片（不改编译器 / 文法 / 自举源 ⇒ 不动点恒定）。
// 注意：本模块**不导入任何模块**（含 `标准库/字符串.心`）——统一 CLI 同时
//       导入 测试运行器（其传递导入 标准库/字符串.心）时，若本模块亦导入，
//       同一文件会经不同相对路径被合并两次（`invalid redefinition`）。
// 限制：不做词法分析，字符串字面量 / 注释内的花括号同样参与计数（简单格式化器）。

// 模块版本：3 = 花括号缩进（默认 4 空格，可按缩进单位配置）/ 去行尾空白 / 空行压缩 / 规范判定
//             + 运算符间距（`=` `?=` `==` `!=` `<=` `>=` `&&` `||`）/ `} 否则 {` 合并 / 尾随逗号去除
函数 ()格式化器模块版本(0 = 结果:整数) {
    3 = 结果;
}

// 取第 N 行（0 基，去掉行尾换行 / 回车）；越界 → ""
函数 (文本:字符串, 行序:整数)格式取行("" = 结果:字符串) {
    "" = 结果;
    (文本)长度 = 总长;
    0 = i;
    0 = 行;
    0 = 起;
    0 = 止;
    0 = 见止;
    0 = 停;
    当 (停 ?= 0 && i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 10) {
            如果 (行 ?= 行序) {
                i = 止;
                1 = 见止;
                1 = 停;
            } 否则 {
                行 + 1 = 行;
                i + 1 = 起;
            }
        }
        i + 1 = i;
    }
    如果 (停 ?= 0 && 行 ?= 行序) {
        总长 = 止;
        1 = 见止;
    }
    如果 (见止 ?= 1) {
        止 = 末;
        如果 (末 > 起) {
            (文本, 末 - 1)字符码 = 末码;
            如果 (末码 ?= 13) { 末 - 1 = 末; }
        }
        如果 (末 > 起) {
            (文本, 起, 末 - 起)子串 = 段;
            ("", 段)拼接 = 结果;
        }
    }
}

// 行数：换行符个数（末行无换行时补 1；以换行结尾时不额外计空行）
函数 (文本:字符串)格式行数(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 10) { 结果 + 1 = 结果; }
        i + 1 = i;
    }
    如果 (总长 > 0) {
        (文本, 总长 - 1)字符码 = 末码;
        如果 (末码 != 10) { 结果 + 1 = 结果; }
    }
}

// 行首缩进：首个非空白（空格 / 制表 / 回车）字符下标（整行空白 → 行长）
函数 (行:字符串)格式行首(0 = 结果:整数) {
    (行)长度 = 行长;
    0 = 结果;
    0 = 停;
    当 (停 ?= 0 && 结果 < 行长) {
        (行, 结果)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 13) {
            结果 + 1 = 结果;
        } 否则 {
            1 = 停;
        }
    }
}

// 行尾：去掉尾部空白（空格 / 制表 / 回车）后的长度（整行空白 → 0）
函数 (行:字符串)格式行尾(0 = 结果:整数) {
    (行)长度 = 结果;
    0 = 停;
    当 (停 ?= 0 && 结果 > 0) {
        (行, 结果 - 1)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 13) {
            结果 - 1 = 结果;
        } 否则 {
            1 = 停;
        }
    }
}

// 区间内花括号净增量（`{` 加 1，`}` 减 1）
函数 (行:字符串, 起:整数, 末:整数)格式括号增量(0 = 结果:整数) {
    0 = 结果;
    起 = i;
    当 (i < 末) {
        (行, i)字符码 = 码;
        如果 (码 ?= 123) { 结果 + 1 = 结果; }
        如果 (码 ?= 125) { 结果 - 1 = 结果; }
        i + 1 = i;
    }
}

// 缩进文本：层数 × 4 个空格（默认风格）
函数 (层:整数)格式缩进文("" = 结果:字符串) {
    (层, "    ")格式按单位缩进 = 结果;
}

// 缩进文本：层数 × 指定缩进单位（单位可为 "  " / "\t" 等）
函数 (层:整数, 单位:字符串)格式按单位缩进("" = 结果:字符串) {
    "" = 结果;
    0 = i;
    0 = 层数;
    如果 (层 > 0) { 层 = 层数; }
    当 (i < 层数) {
        (结果, 单位)拼接 = 结果;
        i + 1 = i;
    }
}

// 文本相等（逐字符比较；不依赖 `字符串比较`，避免额外导入）
函数 (甲:字符串, 乙:字符串)格式文本相等(0 = 结果:整数) {
    1 = 结果;
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    如果 (甲长 != 乙长) { 0 = 结果; }
    如果 (结果 ?= 1) {
        0 = i;
        当 (i < 甲长) {
            (甲, i)字符码 = 甲码;
            (乙, i)字符码 = 乙码;
            如果 (甲码 != 乙码) { 0 = 结果; }
            i + 1 = i;
        }
    }
}

// 去尾部空白（空格 / 制表 / 回车）后的文本
函数 (文本:字符串)格式去尾空("" = 结果:字符串) {
    "" = 结果;
    (文本)格式行尾 = 末;
    如果 (末 > 0) {
        (文本, 0, 末)子串 = 结果;
    }
}

// 文本是否以 前缀 开头（逐字符比较；空前缀 → 1）
函数 (文本:字符串, 前缀:字符串)格式文本以开头(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 文长;
    (前缀)长度 = 前长;
    如果 (前长 <= 文长) {
        (文本, 0, 前长)子串 = 头;
        (头, 前缀)格式文本相等 = 结果;
    }
}

// 位置 i 处的运算符长度（0 = 非运算符；1 = 单字符 `=`；2 = `?=` / `==` / `!=` / `<=` / `>=` / `&&` / `||`）
函数 (行:字符串, i:整数)格式运算符长(0 = 结果:整数) {
    0 = 结果;
    (行)长度 = 总;
    如果 (i < 总) {
        (行, i)字符码 = 码;
        0 = 下码;
        如果 (i + 1 < 总) { (行, i + 1)字符码 = 下码; }
        如果 (码 ?= 61) {
            如果 (下码 ?= 61) { 2 = 结果; } 否则 { 1 = 结果; }
        } 否则如果 (码 ?= 63) {
            如果 (下码 ?= 61) { 2 = 结果; }
        } 否则如果 (码 ?= 33) {
            如果 (下码 ?= 61) { 2 = 结果; }
        } 否则如果 (码 ?= 60) {
            如果 (下码 ?= 61) { 2 = 结果; }
        } 否则如果 (码 ?= 62) {
            如果 (下码 ?= 61) { 2 = 结果; }
        } 否则如果 (码 ?= 38) {
            如果 (下码 ?= 38) { 2 = 结果; }
        } 否则如果 (码 ?= 124) {
            如果 (下码 ?= 124) { 2 = 结果; }
        }
    }
}

// 运算符间距：`=` / `?=` / `==` / `!=` / `<=` / `>=` / `&&` / `||` 两侧统一为一个空格
//   · 字符串字面量（含 `\"` 转义）原样保留；
//   · 行内 `//` 或 `/*` 之后的注释段原样保留（块注释只按本行处理）。
函数 (行:字符串)格式运算符间距("" = 结果:字符串) {
    "" = 结果;
    (行)长度 = 总;
    0 = i;
    0 = 在串;
    0 = 停;
    0 = 长;
    0 = 码;
    "" = 单;
    "" = 操;
    当 (i < 总 && 停 ?= 0) {
        (行, i)字符码 = 码;
        如果 (在串 ?= 1) {
            (码)字符 = 单;
            (结果, 单)拼接 = 结果;
            如果 (码 ?= 92) {
                如果 (i + 1 < 总) {
                    i + 1 = i;
                    (行, i)字符码 = 码;
                    (码)字符 = 单;
                    (结果, 单)拼接 = 结果;
                }
            } 否则如果 (码 ?= 34) {
                0 = 在串;
            }
            i + 1 = i;
        } 否则如果 (码 ?= 34) {
            1 = 在串;
            (码)字符 = 单;
            (结果, 单)拼接 = 结果;
            i + 1 = i;
        } 否则如果 (码 ?= 47) {
            0 = 停;
            如果 (i + 1 < 总) {
                (行, i + 1)字符码 = 码;
                如果 (码 ?= 47 || 码 ?= 42) { 1 = 停; }
            }
            如果 (停 ?= 1) {
                (行, i, 总 - i)子串 = 尾;
                (结果, 尾)拼接 = 结果;
            } 否则 {
                (码)字符 = 单;
                (结果, 单)拼接 = 结果;
                i + 1 = i;
            }
        } 否则 {
            (行, i)格式运算符长 = 长;
            如果 (长 > 0) {
                (结果)格式去尾空 = 结果;
                (行, i, 长)子串 = 操;
                (" ", 操)拼接 = 操;
                (操, " ")拼接 = 操;
                (结果, 操)拼接 = 结果;
                i + 长 = i;
                0 = 停;
                当 (i < 总 && 停 ?= 0) {
                    (行, i)字符码 = 码;
                    如果 (码 ?= 32 || 码 ?= 9) {
                        i + 1 = i;
                    } 否则 {
                        1 = 停;
                    }
                }
                0 = 停;
            } 否则 {
                (码)字符 = 单;
                (结果, 单)拼接 = 结果;
                i + 1 = i;
            }
        }
    }
}

// 格式化全文（默认 4 空格缩进）
函数 (文本:字符串)格式化文本("" = 结果:字符串) {
    (文本, "    ")格式化文本按缩进 = 结果;
}

// 格式化全文：按指定缩进单位缩进 / 去行尾空白 / 空行压缩 / 去首部空行
//   · 空行先挂起（`待空`），遇到后续非空行才补一个空行 ⇒ 首部 / 尾部空行自然丢弃；
//   · 输出统一以 `\n` 结尾；空文本 → 空文本。
//   · v3 三段预处理：运算符间距（逐行）→ `}` 与后续 `否则 …` 行合并 → 行尾 `,` 且下一非空行
//     以 `}` / `)` / `]` 开头时去掉该逗号（尾随逗号）。
函数 (文本:字符串, 单位:字符串)格式化文本按缩进("" = 结果:字符串) {
    "" = 结果;
    0 = 层;
    0 = 打印层;
    0 = 行序;
    0 = 已出;
    0 = 待空;
    0 = 起;
    0 = 末;
    0 = 头码;
    0 = 增量;
    "" = 行;
    "" = 缩进;
    "" = 段;
    "" = 下;
    "" = 下段;
    0 = k;
    0 = n;
    0 = 数;
    0 = 下起;
    0 = 下末;
    0 = 见;
    // ① 运算符间距
    ()创建动态字符串数组 = 规整表;
    (文本)格式行数 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (文本, 行序)格式取行 = 行;
        (行)格式运算符间距 = 行;
        (规整表, 行)动态字符串数组添加;
        行序 + 1 = 行序;
    }
    // ② `}` 与后续（最近的非空）`否则 …` 行合并为 `} 否则 …`
    ()创建动态字符串数组 = 合并表;
    0 = k;
    (规整表)动态字符串数组大小 = 数;
    当 (k < 数) {
        (规整表, k)动态字符串数组获取 = 行;
        (行)格式行首 = 起;
        (行)格式行尾 = 末;
        (行, 起, 末 - 起)子串 = 段;
        0 = 见;
        0 = 停;
        如果 (段 ?= "}") {
            k + 1 = n;
            当 (n < 数 && 停 ?= 0) {
                (规整表, n)动态字符串数组获取 = 下;
                (下)格式行首 = 下起;
                (下)格式行尾 = 下末;
                如果 (下末 > 下起) {
                    (下, 下起, 下末 - 下起)子串 = 下段;
                    (下段, "否则")格式文本以开头 = 见;
                    1 = 停;
                } 否则 {
                    n + 1 = n;
                }
            }
        }
        如果 (见 ?= 1) {
            ("} ", 下段)拼接 = 行;
            (合并表, 行)动态字符串数组添加;
            n + 1 = k;
        } 否则 {
            (合并表, 行)动态字符串数组添加;
            k + 1 = k;
        }
    }
    // ③ 尾随逗号：行尾 `,` 且下一非空行以 `}` / `)` / `]` 开头 → 去掉该逗号
    ()创建动态字符串数组 = 表;
    0 = k;
    (合并表)动态字符串数组大小 = 数;
    当 (k < 数) {
        (合并表, k)动态字符串数组获取 = 行;
        (行)格式去尾空 = 行;
        (行)格式行尾 = 末;
        (行)格式行首 = 起;
        如果 (末 > 起) {
            (行, 末 - 1)字符码 = 头码;
            如果 (头码 ?= 44) {
                k + 1 = n;
                0 = 见;
                0 = 停;
                当 (n < 数 && 停 ?= 0) {
                    (合并表, n)动态字符串数组获取 = 下;
                    (下)格式行首 = 下起;
                    (下)格式行尾 = 下末;
                    如果 (下末 > 下起) {
                        (下, 下起)字符码 = 头码;
                        如果 (头码 ?= 125 || 头码 ?= 41 || 头码 ?= 93) { 1 = 见; }
                        1 = 停;
                    } 否则 {
                        n + 1 = n;
                    }
                }
                如果 (见 ?= 1) {
                    (行, 0, 末 - 1)子串 = 行;
                }
            }
        }
        (表, 行)动态字符串数组添加;
        k + 1 = k;
    }
    // ④ 缩进 / 去首尾空行 / 空行压缩（沿用 v2 语义）
    (表)动态字符串数组大小 = 数;
    0 = 行序;
    当 (行序 < 数) {
        (表, 行序)动态字符串数组获取 = 行;
        (行)格式行首 = 起;
        (行)格式行尾 = 末;
        如果 (起 < 末) {
            (行, 起)字符码 = 头码;
            层 = 打印层;
            如果 (头码 ?= 125 && 打印层 > 0) { 打印层 - 1 = 打印层; }
            如果 (待空 ?= 1 && 已出 ?= 1) {
                (结果, "\n")拼接 = 结果;
            }
            0 = 待空;
            (打印层, 单位)格式按单位缩进 = 缩进;
            (结果, 缩进)拼接 = 结果;
            (行, 起, 末 - 起)子串 = 段;
            (结果, 段)拼接 = 结果;
            (结果, "\n")拼接 = 结果;
            1 = 已出;
            (行, 起, 末)格式括号增量 = 增量;
            层 + 增量 = 层;
            如果 (层 < 0) { 0 = 层; }
        } 否则 {
            1 = 待空;
        }
        行序 + 1 = 行序;
    }
}

// 是否已规范：格式化结果与原文本逐字相同 → 1
函数 (文本:字符串)格式化是否规范(0 = 结果:整数) {
    "" = 规范;
    (文本)格式化文本 = 规范;
    (文本, 规范)格式文本相等 = 结果;
}
