// 日月调试器
// 用法: 日月.exe 工具/调试器.心 [文件]

// 调试器状态
0 = 调试模式;
0 = 断点行;
0 = 当前行;
"" = 当前文件;

// 设置断点
函数 (行号:整数)设置断点(空) {
    行号 = 断点行;
    ("断点已设置在行: ")打印;
    (行号)打印;
    ("")打印;
}

// 检查是否命中断点
函数 (行号:整数)检查断点(0 = 命中:整数) {
    如果 (行号 ?= 断点行) {
        1 = 命中;
    } 否则 {
        0 = 命中;
    }
}

// 显示当前状态
函数 (行号:整数, 代码:字符串)显示状态(空) {
    ("--- 调试信息 ---")打印;
    ("行号: ")打印;
    (行号)打印;
    ("代码: ")打印;
    (代码)打印;
    ("")打印;
}

// 单步执行
函数 单步执行(空) {
    ("单步执行...")打印;
    当前行 + 1 = 当前行;
}

// 继续执行
函数 继续执行(空) {
    ("继续执行...")打印;
}

// 显示变量
函数 (变量名:字符串, 值:整数)显示变量(空) {
    (变量名)打印;
    (" = ")打印;
    (值)打印;
    ("")打印;
}

// 主程序
函数 主程序 {
    ("=== 日月调试器 ===")打印;
    
    ("用法:")打印;
    ("  日月.exe 工具/调试器.心 [文件]")打印;
    ("")打印;
    
    ("命令:")打印;
    ("  断点 <行号>  - 设置断点")打印;
    ("  单步        - 单步执行")打印;
    ("  继续        - 继续执行")打印;
    ("  变量 <名称>  - 显示变量")打印;
    ("  退出        - 退出调试器")打印;
    ("")打印;
    
    ("示例:")打印;
    ("  断点 10     - 在第10行设置断点")打印;
    ("  变量 x      - 显示变量x的值")打印;
    ("")打印;
    
    ("=== 完成 ===")打印;
}
