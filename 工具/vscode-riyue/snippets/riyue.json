{
  "主程序": {
    "prefix": "主程序",
    "body": [
      "函数 主程序 {",
      "\t$0",
      "}"
    ],
    "description": "程序入口"
  },
  "函数": {
    "prefix": "函数",
    "body": [
      "函数 (${1:参数}:${2:整数})${3:名称}(${4:0 = 结果:整数}) {",
      "\t$0",
      "}"
    ],
    "description": "单返回值函数"
  },
  "多返回值函数": {
    "prefix": "函数多返回",
    "body": [
      "函数 (${1:参数})${2:名称}(${3:0 = 结果1:整数}, ${4:\"\" = 结果2:字符串}) {",
      "\t$0",
      "}"
    ],
    "description": "多返回值函数"
  },
  "如果": {
    "prefix": "如果",
    "body": [
      "如果 (${1:条件}) {",
      "\t$0",
      "}"
    ],
    "description": "条件分支"
  },
  "如果否则": {
    "prefix": "如果否则",
    "body": [
      "如果 (${1:条件}) {",
      "\t${2}",
      "} 否则 {",
      "\t$0",
      "}"
    ],
    "description": "条件分支（带否则）"
  },
  "当循环": {
    "prefix": "当",
    "body": [
      "当 (${1:条件}) {",
      "\t$0",
      "}"
    ],
    "description": "当循环"
  },
  "打印": {
    "prefix": "打印",
    "body": [
      "(${1:文本})打印;"
    ],
    "description": "打印一行"
  },
  "导入": {
    "prefix": "导入",
    "body": [
      "导入 \"${1:../标准库/数学.心}\";"
    ],
    "description": "导入模块"
  },
  "测试主程序": {
    "prefix": "测试主程序",
    "body": [
      "导入 \"../标准库/测试框架.心\";",
      "",
      "函数 主程序 {",
      "\t(${1:实际}, ${2:期望}, \"${3:说明}\")断言等于;",
      "\t()测试总结;",
      "}"
    ],
    "description": "测试用例骨架"
  }
}
