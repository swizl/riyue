// 日月 AI 助手（命令行入口，阶段 9.5 生态）
// 阶段：短板补齐计划 §9.5（VS Code 插件 AI 助手入口）——编辑器命令经此脚本调用 标准库/AI.心。
//
// 构建与用法（先编译、再直接运行产物，参数从下标 1 起）：
//   日月.exe 工具/AI助手.心 构建/AI助手
//   构建/AI助手.exe 提示 生成 <需求>
//   构建/AI助手.exe 提示 解释 <源文件>
//   构建/AI助手.exe 提示 补全 <任务> <输入>
//   构建/AI助手.exe 生成 <端点> <密钥> <模型> <需求>
//   构建/AI助手.exe 解释 <端点> <密钥> <模型> <源文件>
//   构建/AI助手.exe 补全 <端点> <密钥> <模型> <任务> <输入>
//
// 退出码：0 = 成功；1 = 模型无输出（端点/密钥/网络/结构不符）；2 = 用法错误。
// 限制：仅明文 http://（无 TLS）；密钥经命令行传入（进程列表可见），仅适合本机调试。
//       纯 `.心`（不改编译器 / 自举源 ⇒ 不动点恒定）。

导入 "../标准库/AI.心";

函数 ()AI助手用法 {
    ("用法: 构建/AI助手.exe <模式> <动作> [参数...]")打印;
    ("  提示 生成 <需求>                        只打印构造好的提示（离线，不联网）")打印;
    ("  提示 解释 <源文件>                      只打印构造好的提示（离线，不联网）")打印;
    ("  提示 补全 <任务> <输入>                 只打印构造好的提示（离线，不联网）")打印;
    ("  生成 <端点> <密钥> <模型> <需求>        调用模型生成代码并打印")打印;
    ("  解释 <端点> <密钥> <模型> <源文件>      调用模型解释源文件并打印")打印;
    ("  补全 <端点> <密钥> <模型> <任务> <输入> 调用模型补全并打印")打印;
}

// 模型无输出时的统一提示（端点 / 密钥 / 网络 / 结构任一不符）
函数 ()AI助手空输出 {
    ("（无输出：请检查端点、密钥、网络与模型返回结构）")打印;
}

// 提示模式（离线）：动作 → 生成 / 解释 / 补全
函数 (动作:字符串, 参数数:整数)AI助手提示模式 {
    "" = 文本;
    "" = 输入;
    "" = 路径;
    如果 (动作 ?= "生成") {
        如果 (参数数 < 4) {
            ()AI助手用法;
            (2)退出进程;
        }
        (3)获取参数 = 文本;
        (文本)AI生成提示 = 文本;
        (文本)打印;
    } 否则 {
        如果 (动作 ?= "解释") {
            如果 (参数数 < 4) {
                ()AI助手用法;
                (2)退出进程;
            }
            (3)获取参数 = 路径;
            (路径)读取文件 = 文本;
            (文本)AI解释提示 = 文本;
            (文本)打印;
        } 否则 {
            如果 (动作 ?= "补全") {
                如果 (参数数 < 5) {
                    ()AI助手用法;
                    (2)退出进程;
                }
                (3)获取参数 = 文本;
                (4)获取参数 = 输入;
                (文本, 输入)AI补全提示 = 文本;
                (文本)打印;
            } 否则 {
                ()AI助手用法;
                (2)退出进程;
            }
        }
    }
}

// 联网模式：动作 → 生成 / 解释 / 补全
函数 (动作:字符串, 参数数:整数)AI助手联网模式 {
    "" = 端点;
    "" = 密钥;
    "" = 模型;
    "" = 文本;
    "" = 输入;
    "" = 路径;
    "" = 结果;
    如果 (动作 ?= "生成") {
        如果 (参数数 < 7) {
            ()AI助手用法;
            (2)退出进程;
        }
        (3)获取参数 = 端点;
        (4)获取参数 = 密钥;
        (5)获取参数 = 模型;
        (6)获取参数 = 文本;
        (端点, 密钥, 模型, 文本)AI生成 = 结果;
        如果 (结果 ?= "") {
            ()AI助手空输出;
            (1)退出进程;
        }
        (结果)打印;
    } 否则 {
        如果 (动作 ?= "解释") {
            如果 (参数数 < 7) {
                ()AI助手用法;
                (2)退出进程;
            }
            (3)获取参数 = 端点;
            (4)获取参数 = 密钥;
            (5)获取参数 = 模型;
            (6)获取参数 = 路径;
            (路径)读取文件 = 文本;
            (端点, 密钥, 模型, 文本)AI解释 = 结果;
            如果 (结果 ?= "") {
                ()AI助手空输出;
                (1)退出进程;
            }
            (结果)打印;
        } 否则 {
            如果 (动作 ?= "补全") {
                如果 (参数数 < 8) {
                    ()AI助手用法;
                    (2)退出进程;
                }
                (3)获取参数 = 端点;
                (4)获取参数 = 密钥;
                (5)获取参数 = 模型;
                (6)获取参数 = 文本;
                (7)获取参数 = 输入;
                (文本, 输入)AI补全提示 = 文本;
                (端点, 密钥, 模型, 文本)AI补全 = 结果;
                如果 (结果 ?= "") {
                    ()AI助手空输出;
                    (1)退出进程;
                }
                (结果)打印;
            } 否则 {
                ()AI助手用法;
                (2)退出进程;
            }
        }
    }
}

函数 主程序 {
    "" = 模式;
    "" = 动作;
    0 = 参数数;
    ()获取参数数量 = 参数数;
    如果 (参数数 <= 2) {
        ()AI助手用法;
        (2)退出进程;
    }
    (1)获取参数 = 模式;
    (2)获取参数 = 动作;
    如果 (模式 ?= "提示") {
        (动作, 参数数)AI助手提示模式;
    } 否则 {
        (模式, 参数数)AI助手联网模式;
    }
}
