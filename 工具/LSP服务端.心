// 日月 LSP 服务端（阶段9 G9：工具链 / IDE 支持）
// 阶段：短板补齐计划 §Phase 6（IDE 支持：LSP 服务端）+ 编译器差距补齐计划 §阶段9
// 状态：stdio 实装——JSON-RPC 2.0 帧循环 + 括号诊断 + 全量文本同步。
//
// 架构：
//   · 传输：stdio —— LSP 帧为 `Content-Length: N\r\n\r\n` + N 字节 JSON-RPC 2.0 消息体；
//           N 按 UTF-8 字节计（`读取标准输入字节` / `写入标准输出` / `字节长度`）。
//   · 会话逻辑：工具/LSP会话.心（诊断扫描 + 方法分派，可单测）；
//             帧编解码：工具/LSP报文.心。
//   · 形态：独立进程，与编辑器插件以 stdio 通信。
//
// 已实现：initialize / initialized / shutdown / exit /
//         textDocument/didOpen / textDocument/didChange（→ publishDiagnostics）/
//         textDocument/completion（关键字 + 文档标识符，最多 64 项）/
//         textDocument/definition（光标处标识符 → 文档内首次出现）/
//         textDocument/hover（光标处标识符 → 推断类型，9F）/
//         textDocument/references（光标处标识符 → 文档内全部出现位置，P6）
//         未知请求 → -32601；诊断日志走 stderr，协议应答走 stdout。
//         诊断：括号配对 / 字符串未闭合 / 全角标点 / 字面量与类型标注不符（9B）/
//               未声明的标识符（9F）；9F 起单帧聚合多诊断（上限 8 条）。
//
// 用法：日月.exe 工具/LSP服务端.心

导入 "LSP会话.心";

// 读一帧 JSON-RPC 正文：循环读头行直到空行，再按 Content-Length 读正文。
// EOF（无任何头）→ ""
函数 ()读报文("" = 结果:字符串) {
    "" = 结果;
    0 = 体长;
    0 = 见头;
    0 = 头停;
    当 (头停 ?= 0) {
        ()读取标准输入行 = 行暂;
        ("", 行暂)拼接 = 行;
        如果 (行 ?= "") {
            1 = 头停;
        } 否则 {
            (行)报文长度 = 候选;
            如果 (候选 > 0) {
                候选 = 体长;
                1 = 见头;
            }
        }
    }
    如果 (见头 ?= 1) {
        (体长)读取标准输入字节 = 体暂;
        ("", 体暂)拼接 = 结果;
    }
}

// 写出应答（空串 = 无应答）
函数 (帧:字符串)输出应答 {
    如果 (帧 ?= "") {
        "" = 帧;
    } 否则 {
        (帧)写入标准输出;
    }
}

函数 主程序 {
    0 = 退出请求;
    ("日月 LSP 服务端已启动（stdio / JSON-RPC 2.0）")输出错误;
    0 = 运行;
    当 (运行 ?= 0) {
        ()读报文 = 正文;
        如果 (正文 ?= "") {
            ("日月 LSP 服务端：输入结束，退出")输出错误;
            1 = 运行;
        } 否则 {
            (正文)LSP处理 = 应答;
            (应答)输出应答;
            如果 (退出请求 ?= 1) {
                1 = 运行;
            }
        }
    }
    ("日月 LSP 服务端已退出")输出错误;
}
