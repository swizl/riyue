// 格式化器命令行入口
// 用法: 日月.exe 工具/格式化器命令行.心 [--检查] 输入 [输出]
//   --检查  只判定是否规范（规范 → 退出 0；不规范 → 打印提示并退出 1）
//   输入    待格式化的源文件（必填）
//   输出    缺省时覆盖原文件
//
// 格式化器主体见 工具/格式化器.心（纯库，无 主程序，可被示例 / 统一 CLI 导入）。

导入 "../工具/格式化器.心";

函数 主程序 {
    "" = 临时;
    "" = 模式;
    "" = 输入;
    "" = 输出;
    "" = 消息;
    "" = 原文;
    "" = 规范;
    0 = 参数数;
    0 = i;
    0 = 有输出;
    0 = 写码;
    0 = 相同;
    ()获取参数数量 = 参数数;
    1 = i;
    当 (i < 参数数) {
        (i)获取参数 = 临时;
        如果 (临时 ?= "--检查") {
            "检查" = 模式;
        } 否则如果 (输入 ?= "") {
            临时 = 输入;
        } 否则 {
            临时 = 输出;
            1 = 有输出;
        }
        i + 1 = i;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/格式化器命令行.心 [--检查] 输入 [输出]")打印;
    } 否则 {
        (输入)读取文件 = 原文;
        (原文)格式化文本 = 规范;
        如果 (模式 ?= "检查") {
            (原文, 规范)格式文本相等 = 相同;
            如果 (相同 ?= 1) {
                ("格式规范: ", 输入)拼接 = 消息;
            } 否则 {
                ("格式不规范: ", 输入)拼接 = 消息;
                (消息)打印;
                (1)退出进程;
            }
            (消息)打印;
        } 否则 {
            如果 (有输出 ?= 1) {
                (输出, 规范)写入文件 = 写码;
                ("已写入: ", 输出)拼接 = 消息;
            } 否则 {
                (输入, 规范)写入文件 = 写码;
                ("已格式化: ", 输入)拼接 = 消息;
            }
            (消息)打印;
        }
    }
}
