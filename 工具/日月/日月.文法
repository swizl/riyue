# ── 顶层 ──────────────────────────────────────────────
程序 = 顶层*
顶层 = 函数定义 / 协程定义 / 导入定义 / 结构体定义 / 枚举定义 / 类型别名 / 全局声明
导入定义 = '导入' 字串 ';'
全局声明 = 字面量 '=' '变量'? 标识符 类型标注? ';'
类型别名 = 类型 数组标记? '=' 标识符 ':' 类型 ';'
数组标记 = '[' ']'

# ── 函数 / 结构体 / 枚举 ──────────────────────────────
函数定义 = '函数' 类型参数表? 输入参数表? 标识符 返回值表? 代码块
协程定义 = '协程' 类型参数表? 输入参数表? 标识符 返回值表? 代码块
类型参数表 = '<' 类型参数 (',' 类型参数)* '>'
类型参数 = 标识符 类型标注?
输入参数表 = '(' (形参 (',' 形参)*)? ')'
形参 = 字面量 '=' 标识符 类型标注? ('=' 表达式)? / 标识符 类型标注? ('=' 表达式)? 省略号?
返回值表 = '(' ')' / '(' '空' ')' / '(' 输出参数 (',' 输出参数)* ')'
输出参数 = 字面量 '=' 标识符 类型标注? / 标识符 类型标注?
结构体定义 = '结构体' 标识符 (':' 标识符)? '{' 结构体项* '}'
结构体项 = 方法定义 / 结构体成员
结构体成员 = 标识符 ':' 类型 ';'
方法定义 = '方法' 标识符 '(' (形参 (',' 形参)*)? ')' 返回值表? 代码块
枚举定义 = '枚举' 标识符 '{' 枚举成员 (',' 枚举成员)* '}'
枚举成员 = 标识符 ('=' 数字)?

类型 = '整数' / '浮点' / '布尔' / '字符串' / '函数' / '空' / 标识符
类型标注 = ':' 类型
字面量 = 数字 / 小数 / 字串 / 插串 / 字符字面 / '真' / '假'

# ── 语句 ──────────────────────────────────────────────
代码块 = '{' 语句* '}'
语句 = 返回语句 / 如果语句 / 当语句 / 做语句 / 循环语句 / 遍历语句 / 匹配语句 / 尝试语句 / 中断语句 / 继续语句 / 抛出语句 / 让出语句 / 结构体定义 / 枚举定义 / 代码块 / 赋值语句 / 标识符赋值 / 表达式语句

返回语句 = '返回' 表达式? ';'
如果语句 = '如果' '(' 如果头 ')' 代码块 ('否则如果' '(' 表达式 ')' 代码块)* ('否则' 代码块)?
如果头 = 表达式 '=' 标识符 类型标注? ';' 表达式 / 表达式
当语句 = '当' '(' 表达式 ')' 代码块
做语句 = '做' 代码块 ('当' '(' 表达式 ')' ';' / '到' '(' 表达式 ')' ';')
循环语句 = '循环' '(' 循环头 ')' 代码块 / '循环' 代码块
循环头 = 标识符 ':' 表达式 ',' 表达式 (',' 表达式)? / 循环C
循环C = 表达式? ';' 表达式? ';' 表达式?
遍历语句 = '遍历' '(' 标识符 ':' 表达式 ')' 代码块
匹配语句 = '匹配' '(' 表达式 ')' '{' 匹配分支* '}'
匹配分支 = ('_' / 表达式) '=>' 代码块
尝试语句 = '尝试' 代码块 ('捕获' '(' 标识符 ')' 代码块)? ('最终' 代码块)?
中断语句 = '中断' ';'
继续语句 = '继续' ';'
抛出语句 = '抛出' 表达式 ';'
让出语句 = '让出' 表达式 ';'

赋值语句 = 表达式 '=' 目标 ';'
目标 = 解构目标 / '常量' 标识符 类型标注? / 标识符 目标后缀? 类型标注?
解构目标 = '(' 标识符 (',' 标识符)* ')'
目标后缀 = '[' 表达式 ']' / '.' 标识符
标识符赋值 = 标识符 目标尾
目标尾 = 下标或成员 '=' 表达式 ';' / 复合赋值 表达式 ';' / '=' 表达式 ';' / 加竖 ';' / 减竖 ';'
下标或成员 = '[' 表达式 ']' / '.' 标识符
复合赋值 = 加等 / 减等 / 乘等 / 除等 / 模等 / 与等 / 或等 / 异或等 / 左移等 / 右移等
表达式语句 = 表达式 ';'

# ── 表达式（低→高） ───────────────────────────────────
表达式 = 条件 { 解析结果 = 结果; }
条件 = 空合并 ('?' 表达式 ':' 表达式)? { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 条; (解析结果,1)取子 = 尾; (尾,1)取子 = 真枝; (尾,3)取子 = 假枝; ("条件表达式","",条,真枝,假枝)三节点 = 结果; } }
空合并 = 或 (问问 或)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
或 = 与 (或或 与)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
与 = 位或 (与与 位或)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
位或 = 位异或 ('|' 位异或)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
位异或 = 位与 ('^' 位与)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
位与 = 比较 ('&' 比较)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
比较 = 移位 (比较符 移位)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
比较符 = 问等 { 解析结果 = 结果; } / 不等 { 解析结果 = 结果; } / 小等 { 解析结果 = 结果; } / 大等 { 解析结果 = 结果; } / '<' { 解析结果 = 结果; } / '>' { 解析结果 = 结果; }
移位 = 加减 (移位符 加减)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
