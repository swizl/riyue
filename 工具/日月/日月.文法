# 日月 语言词法规则（S3.3）
%skip 空白 [ \t\r\n]+
%skip 行注释 //[^\n]*
%skip 块注释 /\*([^*]|\*+[^*/])*\*+/
%token 浮点 [0-9]+[.][0-9]+
%token 整数 [0-9]+
%token 字符串插值 f"[^"]*"
%token 字符串 "[^"]*"
%token 字符 '[^']*'
%token 标识符 [A-Za-z_一-龥][A-Za-z0-9_一-龥]*
%token 箭头 =>
%token 省略号 \.\.\.
%token 左移等于 <<=
%token 右移等于 >>=
%token 加等 +=
%token 减等 -=
%token 乘等 *=
%token 除等 /=
%token 模等 %=
%token 自增 ++
%token 自减 --
%token 双等 ==
%token 不等 !=
%token 小于等于 <=
%token 大于等于 >=
%token 左移 <<
%token 右移 >>
%token 与等 &=
%token 或等 |=
%token 异或等 ^=
%token 与与 &&
%token 或或 ||
%token 问问 ??
%token 刀乐 $
程序 = .*
