乘除 = 一元 (乘除符 一元)* { (解析结果)取子数 = n; 如果 (n ?= 1) { (解析结果,0)取子 = 结果; } 否则 { (解析结果,0)取子 = 累; (解析结果,1)取子 = 尾; (尾)取子数 = m; 0 = i; 当 (i < m) { (尾,i)取子 = 对; (对,0)取子 = 符节; (符节)取文本 = 符; (对,1)取子 = 右; ("二元运算",符,累,右)双节点 = 累; i + 1 = i; } 累 = 结果; } }
乘除符 = '*' { 解析结果 = 结果; } / '/' { 解析结果 = 结果; } / '%' { 解析结果 = 结果; }
