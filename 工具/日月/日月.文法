# 日月 语言 词法 + 文法 (S3.4)
%skip 空白 [ \t\r\n]+
%skip 行注释 //[^\n]*
%skip 块注释 /\*([^*]|\*+[^*/])*\*+/
%skip 字节序 ﻿
%token 小数 [0-9]+[.][0-9]+
%token 数字 [0-9]+
%token 插串 f"([^"\\]|\\.)*"
%token 字串 "([^"\\]|\\.)*"
%token 字符字面 '[^']*'
%token 标识符 [A-Za-z_一-龥][A-Za-z0-9_一-龥]*
%token 箭头 =>
%token 省略号 \.\.\.
%token 问等 \?=
%token 不等 !=
%token 小等 <=
%token 大等 >=
%token 左移 <[|]
%token 右移 >[|]
