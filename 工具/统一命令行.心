// 日月统一命令行
// 用法: 日月.exe 工具/统一命令行.心 <子命令> [参数...]（v1.8：诊断错误码由编译器内建）
//   版本                              显示各子工具模块版本
//   格式 [--检查] 输入 [输出]          格式化源文件（缺省覆盖原文件）
//   文档 [--html|--json|--块 N] 输入 [输出] 生成文档索引（Markdown 缺省；--块 N 取第 N 段代码块正文）
//   检查 [--json] [--递归] 输入|目录  静态检查并打印诊断（有错误 → 退出码 1）
//   诊断 [--json] 输入.心              调用编译器并提取诊断（编译失败 → 退出码 1；--json 带编译器内建错误码 code）
//   测试 [--json] [--覆盖] [过滤词]    运行 示例/ 下的测试套件（--覆盖 出断言点覆盖率报告）
//   验证 [--json]                     全量回归 + 不动点，输出机器可读报告
//   包 [--注册表 文件] <子命令> [参数] 包管理（安装/搜索/锁定/列表/最新/更新/卸载/发布）
//   帮助                              显示本帮助
//
// 导入：格式化器、测试运行器、代码检查器、验证报告、包管理（代码检查器传递导入 文档生成器）。
// 注意：**不直接导入 文档生成器**——代码检查器已导入，再以 `工具/...` 直接导入会因
//       相对路径不同产生不同模块键，同一文件被包含两次（`invalid redefinition`）。
//       字符串库冲突已由 文档生成器 去除 `标准库/字符串.心` 导入（改用本地
//       `文档整数转字符串`）解决，故可与 测试运行器（→测试框架→字符串.心）同链聚合。

导入 "../工具/格式化器.心";
导入 "../工具/测试运行器.心";
导入 "../工具/代码检查器.心";
导入 "../工具/验证报告.心";
// 诊断行解析（`错误[C0xx][文件]: 消息` → JSON 对象），由 `诊断` 子命令共用
导入 "../工具/诊断解析.心";
// 包管理 经 `../工具/../标准库` 两级相对导入：自举链按「未规范化路径」做模块键去重，
// 测试运行器 链（`工具/../工具/../标准库`）已包含 `字符串.心`；用 `../标准库/包管理.心`
// 会得到 `工具/../标准库/字符串.心`，同一文件两键 → `invalid redefinition`。
导入 "../工具/../标准库/包管理.心";

// 版本子命令：格式化器 / 测试运行器 / 文档生成器 / 代码检查器 / 包管理 模块版本
函数 统一显示版本(空) {
    "" = 行;
    "" = 版文;
    ()格式化器模块版本 = 版一;
    ()测试运行器模块版本 = 版二;
    ()文档生成器模块版本 = 版三;
    ()代码检查器模块版本 = 版四;
    ()包管理模块版本 = 版五;
    ("日月统一命令行 v1.8")打印;
    (版一)整数转字符串 = 版文;
    ("格式化器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版二)整数转字符串 = 版文;
    ("测试运行器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版三)整数转字符串 = 版文;
    ("文档生成器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版四)整数转字符串 = 版文;
    ("代码检查器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版五)整数转字符串 = 版文;
    ("包管理模块版本: ", 版文)拼接 = 行;
    (行)打印;
}

