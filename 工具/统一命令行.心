// 日月统一命令行
// 用法: 日月.exe 工具/统一命令行.心 <子命令> [参数...]
//   版本                              显示各子工具模块版本
//   格式 [--检查] 输入 [输出]          格式化源文件（缺省覆盖原文件）
//   文档 输入 [输出]                  生成 Markdown 文档索引（缺省打印）
//   检查 [--json] [--递归] 输入|目录  静态检查并打印诊断（有错误 → 退出码 1）
//   诊断 [--json] 输入.心              调用编译器并提取诊断（编译失败 → 退出码 1）
//   测试 [--json] [过滤词]            运行 示例/ 下的测试套件
//   验证 [--json]                     全量回归 + 不动点，输出机器可读报告
//   帮助                              显示本帮助
//
// 导入：格式化器、测试运行器、代码检查器、验证报告（代码检查器传递导入 文档生成器）。
// 注意：**不直接导入 文档生成器**——代码检查器已导入，再以 `工具/...` 直接导入会因
//       相对路径不同产生不同模块键，同一文件被包含两次（`invalid redefinition`）。
//       字符串库冲突已由 文档生成器 去除 `标准库/字符串.心` 导入（改用本地
//       `文档整数转字符串`）解决，故可与 测试运行器（→测试框架→字符串.心）同链聚合。

导入 "../工具/格式化器.心";
导入 "../工具/测试运行器.心";
导入 "../工具/代码检查器.心";
导入 "../工具/验证报告.心";

// 版本子命令：格式化器 / 测试运行器 / 文档生成器 / 代码检查器模块版本
函数 统一显示版本(空) {
    "" = 行;
    "" = 版文;
    ()格式化器模块版本 = 版一;
    ()测试运行器模块版本 = 版二;
    ()文档生成器模块版本 = 版三;
    ()代码检查器模块版本 = 版四;
    ("日月统一命令行 v1.3")打印;
    (版一)整数转字符串 = 版文;
    ("格式化器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版二)整数转字符串 = 版文;
    ("测试运行器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版三)整数转字符串 = 版文;
    ("文档生成器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版四)整数转字符串 = 版文;
    ("代码检查器模块版本: ", 版文)拼接 = 行;
    (行)打印;
}

