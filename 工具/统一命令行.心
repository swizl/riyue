// 日月统一命令行
// 用法: 日月.exe 工具/统一命令行.心 <子命令> [参数...]
//   版本                              显示各子工具模块版本
//   格式 [--检查] 输入 [输出]          格式化源文件（缺省覆盖原文件）
//   文档 输入 [输出]                  生成 Markdown 文档索引（缺省打印）
//   检查 输入|目录                    静态检查并打印诊断（有错误 → 退出码 1）
//   测试 [过滤词]                     运行 示例/ 下的测试套件
//   帮助                              显示本帮助
//
// 导入：格式化器、测试运行器、代码检查器（代码检查器传递导入 文档生成器）。
// 注意：**不直接导入 文档生成器**——代码检查器已导入，再以 `工具/...` 直接导入会因
//       相对路径不同产生不同模块键，同一文件被包含两次（`invalid redefinition`）。
//       字符串库冲突已由 文档生成器 去除 `标准库/字符串.心` 导入（改用本地
//       `文档整数转字符串`）解决，故可与 测试运行器（→测试框架→字符串.心）同链聚合。

导入 "../工具/格式化器.心";
导入 "../工具/测试运行器.心";
导入 "../工具/代码检查器.心";

// 版本子命令：格式化器 / 测试运行器 / 文档生成器 / 代码检查器模块版本
函数 统一显示版本(空) {
    "" = 行;
    "" = 版文;
    ()格式化器模块版本 = 版一;
    ()测试运行器模块版本 = 版二;
    ()文档生成器模块版本 = 版三;
    ()代码检查器模块版本 = 版四;
    ("日月统一命令行 v1.2")打印;
    (版一)整数转字符串 = 版文;
    ("格式化器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版二)整数转字符串 = 版文;
    ("测试运行器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版三)整数转字符串 = 版文;
    ("文档生成器模块版本: ", 版文)拼接 = 行;
    (行)打印;
    (版四)整数转字符串 = 版文;
    ("代码检查器模块版本: ", 版文)拼接 = 行;
    (行)打印;
}

// 帮助文本
函数 统一显示帮助(空) {
    ("用法: 日月.exe 工具/统一命令行.心 <子命令> [参数...]")打印;
    ("  版本                              显示各子工具模块版本")打印;
    ("  格式 [--检查] 输入 [输出]          格式化源文件（缺省覆盖原文件）")打印;
    ("  文档 输入 [输出]                  生成 Markdown 文档索引（缺省打印）")打印;
    ("  检查 输入|目录                    静态检查并打印诊断（有错误 → 退出码 1）")打印;
    ("  测试 [过滤词]                     运行 示例/ 下的测试套件")打印;
    ("  帮助                              显示本帮助")打印;
}

// 格式子命令：从 参数起 开始解析 [--检查] 输入 [输出]
函数 (参数起:整数)统一格式(0 = 结果:整数) {
    "" = 临时;
    "" = 模式;
    "" = 输入;
    "" = 输出;
    "" = 消息;
    "" = 原文;
    "" = 规范;
    0 = 参数数;
    0 = i;
    0 = 有输出;
    0 = 写码;
    0 = 相同;
    ()获取参数数量 = 参数数;
    参数起 = i;
    当 (i < 参数数) {
        (i)获取参数 = 临时;
        如果 (临时 ?= "--检查") {
            "检查" = 模式;
        } 否则如果 (输入 ?= "") {
            临时 = 输入;
        } 否则 {
            临时 = 输出;
            1 = 有输出;
        }
        i + 1 = i;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/统一命令行.心 格式 [--检查] 输入 [输出]")打印;
        (2)退出进程;
    }
    (输入)读取文件 = 原文;
    (原文)格式化文本 = 规范;
    如果 (模式 ?= "检查") {
        (原文, 规范)格式文本相等 = 相同;
        如果 (相同 ?= 0) {
            ("格式不规范: ", 输入)拼接 = 消息;
            (消息)打印;
            (1)退出进程;
        }
        ("格式规范: ", 输入)拼接 = 消息;
        (消息)打印;
    } 否则 {
        如果 (有输出 ?= 1) {
            (输出, 规范)写入文件 = 写码;
            ("已写入: ", 输出)拼接 = 消息;
        } 否则 {
            (输入, 规范)写入文件 = 写码;
            ("已格式化: ", 输入)拼接 = 消息;
        }
        (消息)打印;
    }
}

// 文档子命令：参数起 处为 输入 [输出]；缺省打印 Markdown，给出输出路径则写文件
函数 (参数起:整数)统一文档(空) {
    "" = 临时;
    "" = 输入;
    "" = 输出;
    "" = 原文;
    "" = 标记;
    "" = 消息;
    0 = 参数数;
    0 = i;
    0 = 有输出;
    0 = 写码;
    ()获取参数数量 = 参数数;
    参数起 = i;
    当 (i < 参数数) {
        (i)获取参数 = 临时;
        如果 (输入 ?= "") {
            临时 = 输入;
        } 否则 {
            临时 = 输出;
            1 = 有输出;
        }
        i + 1 = i;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/统一命令行.心 文档 输入 [输出]")打印;
        (2)退出进程;
    }
    (输入)读取文件 = 原文;
    (原文)文档生成标记 = 标记;
    如果 (有输出 ?= 1) {
        (输出, 标记)写入文件 = 写码;
        ("已生成: ", 输出)拼接 = 消息;
        (消息)打印;
    } 否则 {
        (标记)打印;
    }
}

// 检查子命令：参数起 处为输入（文件或目录）；打印诊断，存在错误时退出码 1
//   目录模式：单层（跳过子目录），仅检查 `.心`，按路径升序（见 `检查目录诊断`）
函数 (参数起:整数)统一检查(空) {
    "" = 输入;
    "" = 原文;
    "" = 诊断;
    "" = 消息;
    0 = 参数数;
    0 = 错误数;
    0 = 是目录;
    0 = 文件数;
    ()获取参数数量 = 参数数;
    如果 (参数数 > 参数起) {
        (参数起)获取参数 = 输入;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/统一命令行.心 检查 输入|目录")打印;
        (2)退出进程;
    }
    (输入)目录存在 = 是目录;
    如果 (是目录 ?= 1) {
        (输入)检查目录诊断 = (诊断, 文件数, 错误数);
    } 否则 {
        (输入)读取文件 = 原文;
        (原文)代码检查诊断 = 诊断;
        (诊断)检查错误行数 = 错误数;
    }
    (诊断)打印;
    如果 (错误数 > 0) {
        ("检查未通过: ", 输入)拼接 = 消息;
        (消息, " 有错误")拼接 = 消息;
        (消息)打印;
        (1)退出进程;
    }
}

// 测试子命令：参数起 处可选过滤词，目录固定 示例/，输出前缀 构建/.tr
函数 (参数起:整数)统一测试(空) {
    "" = 临时;
    "" = 过滤词;
    "" = 目录;
    "" = 编译器;
    0 = 参数数;
    0 = 通过;
    0 = 失败;
    0 = 跳过;
    ()获取参数数量 = 参数数;
    如果 (参数数 > 参数起) {
        (参数起)获取参数 = 临时;
        临时 = 过滤词;
    }
    "示例" = 目录;
    "日月.exe" = 编译器;
    ("日月测试运行器 v2.0")打印;
    ("=")打印;
    (目录, 过滤词, 编译器, "构建/.tr")测试运行目录 = (通过, 失败, 跳过);
    (通过, 失败, 跳过)测试汇总;
}

函数 主程序 {
    "" = 临时;
    "" = 子;
    "" = 行;
    0 = 参数数;
    0 = 未知;
    ()获取参数数量 = 参数数;
    如果 (参数数 > 1) {
        (1)获取参数 = 临时;
        临时 = 子;
        1 = 未知;
    }
    如果 (子 ?= "版本") {
        0 = 未知;
        ()统一显示版本;
    }
    如果 (子 ?= "格式") {
        0 = 未知;
        (2)统一格式;
    }
    如果 (子 ?= "文档") {
        0 = 未知;
        (2)统一文档;
    }
    如果 (子 ?= "检查") {
        0 = 未知;
        (2)统一检查;
    }
    如果 (子 ?= "测试") {
        0 = 未知;
        (2)统一测试;
    }
    如果 (子 ?= "帮助") {
        0 = 未知;
        ()统一显示帮助;
    }
    如果 (未知 ?= 1) {
        ("未知子命令: ", 子)拼接 = 行;
        (行)打印;
        ()统一显示帮助;
        (1)退出进程;
    }
    如果 (子 ?= "") {
        ()统一显示帮助;
    }
}
