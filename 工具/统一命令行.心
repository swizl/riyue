// 格式子命令：从 参数起 开始解析 [--检查] 输入 [输出]
函数 (参数起:整数)统一格式(0 = 结果:整数) {
    "" = 临时;
    "" = 模式;
    "" = 输入;
    "" = 输出;
    "" = 消息;
    "" = 原文;
    "" = 规范;
    0 = 参数数;
    0 = i;
    0 = 有输出;
    0 = 写码;
    0 = 相同;
    ()获取参数数量 = 参数数;
    参数起 = i;
    当 (i < 参数数) {
        (i)获取参数 = 临时;
        如果 (临时 ?= "--检查") {
            "检查" = 模式;
        } 否则如果 (输入 ?= "") {
            临时 = 输入;
        } 否则 {
            临时 = 输出;
            1 = 有输出;
        }
        i + 1 = i;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/统一命令行.心 格式 [--检查] 输入 [输出]")打印;
        (2)退出进程;
    }
    (输入)读取文件 = 原文;
    (原文)格式化文本 = 规范;
    如果 (模式 ?= "检查") {
        (原文, 规范)格式文本相等 = 相同;
        如果 (相同 ?= 0) {
            ("格式不规范: ", 输入)拼接 = 消息;
            (消息)打印;
            (1)退出进程;
        }
        ("格式规范: ", 输入)拼接 = 消息;
        (消息)打印;
    } 否则 {
        如果 (有输出 ?= 1) {
            (输出, 规范)写入文件 = 写码;
            ("已写入: ", 输出)拼接 = 消息;
        } 否则 {
            (输入, 规范)写入文件 = 写码;
            ("已格式化: ", 输入)拼接 = 消息;
        }
        (消息)打印;
    }
}

// 非负十进制文本 → 整数（非数字字符处截断；空串 → 0）
函数 (文本:字符串)统一十进制转整数(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 总长;
    0 = i;
    0 = 停;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            结果 * 10 + 码 - 48 = 结果;
        } 否则 {
            1 = 停;
        }
        i + 1 = i;
    }
}

// 文档子命令：`[--html|--json|--块 序号]`（顺序任意，须在路径前）后为 输入 [输出]
//   缺省生成 Markdown；`--html` / `--json` 选择生成格式；`--块 序号` 取第 N 段代码块正文（0 基）；
//   给出输出路径则写文件，否则打印
函数 (参数起:整数)统一文档(空) {
    "" = 临时;
    "" = 输入;
    "" = 输出;
    "" = 原文;
    "" = 标记;
    "" = 消息;
    0 = 参数数;
    0 = i;
    0 = 有输出;
    0 = 写码;
    0 = 输出HTML;
    0 = 输出JSON;
    0 = 输出块;
    0 = 块序号;
    ()获取参数数量 = 参数数;
    参数起 = i;
    当 (i < 参数数) {
        (i)获取参数 = 临时;
        如果 (临时 ?= "--html") {
            1 = 输出HTML;
        } 否则如果 (临时 ?= "--json") {
            1 = 输出JSON;
        } 否则如果 (临时 ?= "--块") {
            i + 1 = i;
            如果 (i < 参数数) {
                (i)获取参数 = 临时;
                (临时)统一十进制转整数 = 块序号;
                1 = 输出块;
            }
        } 否则如果 (输入 ?= "") {
            临时 = 输入;
        } 否则 {
            临时 = 输出;
            1 = 有输出;
        }
        i + 1 = i;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/统一命令行.心 文档 [--html|--json|--块 序号] 输入 [输出]")打印;
        (2)退出进程;
    }
    (输入)读取文件 = 原文;
    如果 (输出块 ?= 1) {
        (原文, 块序号)文档代码块 = 标记;
    } 否则如果 (输出JSON ?= 1) {
        (原文)文档生成JSON = 标记;
    } 否则如果 (输出HTML ?= 1) {
        (原文)文档生成HTML = 标记;
    } 否则 {
        (原文)文档生成标记 = 标记;
    }
    如果 (有输出 ?= 1) {
        (输出, 标记)写入文件 = 写码;
        ("已生成: ", 输出)拼接 = 消息;
        (消息)打印;
    } 否则 {
        (标记)打印;
    }
}

// 检查子命令：`[--json] [--递归]`（顺序任意，须在路径前）后为输入（文件或目录）
//   目录模式：仅检查 `.心`、按路径升序；`--递归` 时含子目录
//   `--json`：输出 {"files":N,"errors":M,"diagnostics":[{file,line,severity,message}...]}
//   存在错误时仍退出码 1（JSON 模式不再额外打印「检查未通过」文本）
函数 (参数起:整数)统一检查(空) {
    "" = 输入;
    "" = 原文;
    "" = 诊断;
    "" = 消息;
    "" = 选项;
    0 = 参数数;
    0 = 错误数;
    0 = 是目录;
    0 = 文件数;
    0 = 递归;
    0 = JSON模式;
    0 = 位置;
    0 = 继续;
    ()获取参数数量 = 参数数;
    参数起 = 位置;
    1 = 继续;
    当 (继续 ?= 1) {
        如果 (位置 < 参数数) {
            (位置)获取参数 = 选项;
            如果 (选项 ?= "--递归") {
                1 = 递归;
                位置 + 1 = 位置;
            } 否则 {
                如果 (选项 ?= "--json") {
                    1 = JSON模式;
                    位置 + 1 = 位置;
                } 否则 {
                    0 = 继续;
                }
            }
        } 否则 {
            0 = 继续;
        }
    }
    如果 (位置 < 参数数) {
        (位置)获取参数 = 输入;
    }
    如果 (输入 ?= "") {
        ("用法: 日月.exe 工具/统一命令行.心 检查 [--json] [--递归] 输入|目录")打印;
        (2)退出进程;
    }
    (输入)目录存在 = 是目录;
    如果 (是目录 ?= 1) {
        如果 (JSON模式 ?= 1) {
            (输入, 递归)检查目录诊断JSON = (诊断, 文件数, 错误数);
        } 否则 {
            如果 (递归 ?= 1) {
                (输入)检查目录诊断递归 = (诊断, 文件数, 错误数);
            } 否则 {
                (输入)检查目录诊断 = (诊断, 文件数, 错误数);
            }
        }
    } 否则 {
        如果 (JSON模式 ?= 1) {
            (输入)检查单文件诊断JSON = (诊断, 文件数, 错误数);
        } 否则 {
            (输入)读取文件 = 原文;
            (原文)代码检查诊断 = 诊断;
            (诊断)检查错误行数 = 错误数;
        }
    }
    (诊断)打印;
    如果 (错误数 > 0) {
        如果 (JSON模式 ?= 0) {
            ("检查未通过: ", 输入)拼接 = 消息;
            (消息, " 有错误")拼接 = 消息;
            (消息)打印;
        }
        (1)退出进程;
    }
}

