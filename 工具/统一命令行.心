            (输入)读取文件 = 原文;
            (原文)代码检查诊断 = 诊断;
            (诊断)检查错误行数 = 错误数;
        }
    }
    (诊断)打印;
    如果 (错误数 > 0) {
        如果 (JSON模式 ?= 0) {
            ("检查未通过: ", 输入)拼接 = 消息;
            (消息, " 有错误")拼接 = 消息;
            (消息)打印;
