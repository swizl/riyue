// 编译器诊断行 → JSON 对象；非诊断行返回 ""
//   编译器格式：`错误[文件]: 消息（行 N:列）`（文件名 / 列号可缺省）
//   后续的源码行与 `^` 指示符行不以 错误|警告|注意 开头，自然被过滤
函数 (行:字符串)统一诊断行JSON("" = 结果:字符串) {
    0 = 长;
    0 = 偏移;
    0 = 扫;
    0 = 起;
    0 = 止;
    0 = 标记;
    0 = 行号;
    0 = 列号;
    0 = 位数;
    0 = 停;
    0 = 是数;
    0 = 码;
    0 = 行长;
    "" = 严重;
    "" = 文件名;
    "" = 消息;
    "" = 探;
    "" = 前两;
    "" = 引;
    "" = 段;
    "" = 文;
    (34)字符 = 引;
    (行)长度 = 长;
    0 = 偏移;
    如果 (长 >= 2) {
        (行, 0, 2)子串 = 前两;
        如果 (前两 ?= "错误") {
            "error" = 严重;
            2 = 偏移;
        } 否则 {
            如果 (前两 ?= "警告") {
                "warning" = 严重;
                2 = 偏移;
            } 否则 {
                如果 (前两 ?= "注意") {
                    "note" = 严重;
                    2 = 偏移;
                }
            }
        }
    }
    如果 (偏移 > 0) {
        // 可选 `[文件名]`
        如果 (偏移 < 长) {
            (行, 偏移, 1)子串 = 探;
            如果 (探 ?= "[") {
                偏移 + 1 = 扫;
                0 = 标记;
                当 (扫 < 长 && 标记 ?= 0) {
                    (行, 扫, 1)子串 = 探;
                    如果 (探 ?= "]") {
                        1 = 标记;
                    } 否则 {
                        扫 + 1 = 扫;
                    }
                }
                如果 (标记 ?= 1) {
                    (行, 偏移 + 1, 扫 - 偏移 - 1)子串 = 文件名;
                    扫 + 3 = 偏移;
                }
            } 否则 {
                偏移 + 2 = 偏移;
            }
        }
        // 消息结束位置 = `（行 ` 标记
        偏移 = 起;
        0 = 标记;
        起 = 扫;
        当 (扫 + 3 <= 长 && 标记 ?= 0) {
            (行, 扫, 3)子串 = 探;
            如果 (探 ?= "（行 ") {
                扫 = 标记;
            } 否则 {
                扫 + 1 = 扫;
            }
        }
        长 = 止;
        如果 (标记 ?= 1) {
            标记 = 止;
        }
        如果 (止 > 起) {
            (行, 起, 止 - 起)子串 = 消息;
        }
        // 行号 / 列号
        如果 (标记 ?= 1) {
            标记 + 3 = 扫;
            0 = 停;
            当 (扫 < 长 && 停 ?= 0) {
                (行, 扫)字符码 = 码;
                0 = 是数;
                如果 (码 >= 48) {
                    如果 (码 <= 57) {
                        1 = 是数;
                    }
                }
                如果 (是数 ?= 1) {
                    行号 * 10 + 码 - 48 = 行号;
                    位数 + 1 = 位数;
                    扫 + 1 = 扫;
                } 否则 {
                    1 = 停;
                }
            }
            如果 (扫 < 长 && 位数 > 0) {
                (行, 扫, 1)子串 = 探;
                如果 (探 ?= ":") {
                    扫 + 1 = 扫;
                    0 = 停;
                    当 (扫 < 长 && 停 ?= 0) {
                        (行, 扫)字符码 = 码;
                        0 = 是数;
                        如果 (码 >= 48) {
                            如果 (码 <= 57) {
                                1 = 是数;
                            }
                        }
                        如果 (是数 ?= 1) {
                            列号 * 10 + 码 - 48 = 列号;
                            扫 + 1 = 扫;
                        } 否则 {
                            1 = 停;
                        }
                    }
                }
            }
            如果 (位数 ?= 0) {
                0 = 行号;
            }
        }
        // 组装对象
        "{" = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "file")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (文件名)统一JSON串 = 段;
        (结果, 段)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "line")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (行号)整数转字符串 = 文;
        (结果, 文)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "column")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (列号)整数转字符串 = 文;
        (结果, 文)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "severity")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, ":")拼接 = 结果;
        (严重)统一JSON串 = 段;
        (结果, 段)拼接 = 结果;
        (结果, ",")拼接 = 结果;
        (结果, 引)拼接 = 结果;
        (结果, "message")拼接 = 结果;
        (结果, 引)拼接 = 结果;
