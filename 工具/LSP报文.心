// 日月工具链 - LSP 报文分帧（JSON-RPC 2.0 over stdio）
// 8CG：纯 `.心`，双链一致。
//   · 仅实现 Content-Length 帧的编解码所需的最小逻辑（不解析 JSON 本体）；
//   · CR / LF 以码点构造（`(13)字符` / `(10)字符`），宿主链 `字符` 为共享静态缓冲，
//     故先复制进新缓冲（`("", 单字)拼接`）再复用。

导入 "../标准库/字符串.心";

// 解析帧头中 `Content-Length: N` 的 N：扫描首个十进制数字串（无数字 → 0）
函数 (头:字符串)报文长度(0 = 结果:整数) {
    0 = 结果;
    (头)长度 = 长度;
    0 = i;
    0 = 见数字;
    0 = 停;
    当 (i < 长度 && 停 ?= 0) {
        (头, i)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            结果 * 10 + 码 - 48 = 结果;
            1 = 见数字;
        } 否则 {
            如果 (见数字 ?= 1) { 1 = 停; }
        }
        i + 1 = i;
    }
}

// 构造完整报文：`Content-Length: <正文字符数>\r\n\r\n<正文>`
函数 (正文:字符串)构造报文("" = 结果:字符串) {
    (13)字符 = 单字;
    ("", 单字)拼接 = 回车符;
    (10)字符 = 单字;
    (回车符, 单字)拼接 = 回车换行;
    (正文)长度 = 正长;
    (正长)整数转字符串 = 正长文本;
    "" = 累计;
    (累计, "Content-Length: ")拼接 = 累计;
    (累计, 正长文本)拼接 = 累计;
    (累计, 回车换行)拼接 = 累计;
    (累计, 回车换行)拼接 = 累计;
    (累计, 正文)拼接 = 累计;
    累计 = 结果;
}

// 取报文体：跳过首个 `\r\n\r\n`（13,10,13,10）之后的内容；未找到 → ""
函数 (报文:字符串)报文正文("" = 结果:字符串) {
    (报文)长度 = 长度;
    0 = i;
    0 = 体起;
    0 = 找;
    当 (i + 3 < 长度 && 找 ?= 0) {
        (报文, i)字符码 = 甲;
        (报文, i + 1)字符码 = 乙;
        (报文, i + 2)字符码 = 丙;
        (报文, i + 3)字符码 = 丁;
        如果 (甲 ?= 13 && 乙 ?= 10 && 丙 ?= 13 && 丁 ?= 10) {
            i + 4 = 体起;
            1 = 找;
        }
        i + 1 = i;
    }
    如果 (找 ?= 1) {
        (报文, 体起, 长度 - 体起)字符串截取 = 结果;
    }
}

