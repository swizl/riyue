// 取 JSON-RPC 正文中 "id" 后的整数（无 → 0）（8CJ）
函数 (正文:字符串)JSONRPC取编号(0 = 结果:整数) {
    0 = 结果;
    (正文)长度 = 长度;
    0 = i;
    0 = 找;
    当 (i + 3 < 长度 && 找 ?= 0) {
        (正文, i)字符码 = 甲;
        (正文, i + 1)字符码 = 乙;
        (正文, i + 2)字符码 = 丙;
        (正文, i + 3)字符码 = 丁;
        如果 (甲 ?= 34 && 乙 ?= 105 && 丙 ?= 100 && 丁 ?= 34) {
            1 = 找;
        }
        如果 (找 ?= 0) { i + 1 = i; }
    }
    如果 (找 ?= 1) {
        0 = j;
        i + 4 = j;
        0 = 见数;
        0 = 停;
        当 (j < 长度 && 停 ?= 0) {
            (正文, j)字符码 = 码;
            如果 (码 >= 48 && 码 <= 57) {
                结果 * 10 + 码 - 48 = 结果;
                1 = 见数;
            } 否则 {
                如果 (见数 ?= 1) { 1 = 停; }
            }
            j + 1 = j;
        }
    }
}

