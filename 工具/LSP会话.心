    "" = 词;
    0 = 有词;
    如果 (i < 总长) {
        (文本, i)字符码 = 码;
        (码)是标识符首码 = 首;
        如果 (首 ?= 1) {
            1 = 有词;
            0 = 停;
            当 (i < 总长 && 停 ?= 0) {
                (文本, i)字符码 = 码;
                (码)是标识符码 = 是;
                如果 (是 ?= 1) {
