// 日月 LSP 会话逻辑（阶段9 G9：工具链 / IDE 支持）
// 纯 `.心`，宿主链与自举链双链一致；不触碰 stdio，便于单元测试。
//   · 诊断：括号配对扫描（圆/方/花），跳过字符串字面量与 `//` 行注释；
//   · 分派：initialize / shutdown / exit / textDocument/didOpen|didChange，
//           未知请求回应 -32601（MethodNotFound），通知不应答。
// 传输层：工具/LSP报文.心（帧编解码）+ 工具/LSP服务端.心（stdio 循环）。

导入 "LSP报文.心";

// 诊断结果（0 基行列；种类：0 无错 / 1 多余的右括号 / 2 括号未闭合）
0 = 变量 诊断行;
0 = 变量 诊断列;
0 = 变量 诊断种类;
// 收到 exit 通知后置 1：服务端主循环据此终止
0 = 变量 退出请求;

// 模块版本（G9：骨架 1 → 实装 2）
函数 ()LSP模块版本(0 = 结果: 整数) {
    2 = 结果;
}

// JSON 字段取值：JSON获取字符串 共用静态缓冲，取到后立刻复制
函数 (正文:字符串, 键:字符串)取字段("" = 结果:字符串) {
    (正文, 键)JSON获取字符串 = 暂;
    ("", 暂)拼接 = 结果;
}

// 括号配对扫描：结果写入 诊断行 / 诊断列 / 诊断种类
// 行列均为 0 基；字符串字面量与行注释内的括号不计。
函数 (文本:字符串)括号诊断 {
    0 - 1 = 诊断行;
    0 = 诊断列;
    0 = 诊断种类;
    (文本)长度 = 总长;
    0 = i;
    0 = 行;
    0 = 列;
    0 = 在串;
    0 = 在注释;
    0 = 圆数;
    0 = 方数;
    0 = 花数;
    0 = 圆行;
    0 = 圆列;
    0 = 方行;
    0 = 方列;
    0 = 花行;
    0 = 花列;
    0 = 停;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (在注释 ?= 1) {
            如果 (码 ?= 10) {
                0 = 在注释;
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (在串 ?= 1) {
            如果 (码 ?= 34) {
                0 = 在串;
            } 否则如果 (码 ?= 10) {
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (码 ?= 34) {
            1 = 在串;
        } 否则如果 (码 ?= 47) {
            (文本, i + 1)字符码 = 后码;
            如果 (后码 ?= 47) {
                1 = 在注释;
            }
        } 否则如果 (码 ?= 10) {
            行 + 1 = 行;
            0 - 1 = 列;
        } 否则如果 (码 ?= 40) {
            圆数 + 1 = 圆数;
            行 = 圆行;
            列 = 圆列;
        } 否则如果 (码 ?= 41) {
            圆数 - 1 = 圆数;
            如果 (圆数 < 0) {
                1 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        } 否则如果 (码 ?= 91) {
            方数 + 1 = 方数;
            行 = 方行;
            列 = 方列;
        } 否则如果 (码 ?= 93) {
            方数 - 1 = 方数;
            如果 (方数 < 0) {
                1 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        } 否则如果 (码 ?= 123) {
            花数 + 1 = 花数;
            行 = 花行;
            列 = 花列;
        } 否则如果 (码 ?= 125) {
            花数 - 1 = 花数;
            如果 (花数 < 0) {
                1 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        }
        如果 (停 ?= 0) {
            i + 1 = i;
            列 + 1 = 列;
        }
    }
    如果 (诊断种类 ?= 0) {
        如果 (圆数 > 0) {
            2 = 诊断种类;
            圆行 = 诊断行;
            圆列 = 诊断列;
        } 否则如果 (方数 > 0) {
            2 = 诊断种类;
            方行 = 诊断行;
            方列 = 诊断列;
        } 否则如果 (花数 > 0) {
            2 = 诊断种类;
            花行 = 诊断行;
            花列 = 诊断列;
        }
    }
}

// 诊断文案（无错 → 空串）
函数 ()诊断消息("" = 结果:字符串) {
    如果 (诊断种类 ?= 1) {
        "多余的右括号" = 结果;
    } 否则如果 (诊断种类 ?= 2) {
        "括号未闭合" = 结果;
    } 否则 {
        "" = 结果;
    }
}

// 诊断帧：每次 didOpen/didChange 都回一帧（无错则空诊断表，清除旧标记）
函数 (地址:字符串, 文本:字符串)诊断帧("" = 结果:字符串) {
    (文本)括号诊断;
    如果 (诊断种类 > 0) {
        ()诊断消息 = 消息;
        (地址, 诊断行, 诊断列, 消息)构造单条诊断通知 = 结果;
    } 否则 {
        (地址)构造诊断通知 = 结果;
    }
}

// JSON-RPC 分派：返回应答帧；无应答（通知）返回 ""
函数 (正文:字符串)LSP处理("" = 结果:字符串) {
    "" = 结果;
    (正文, "method")取字段 = 方法;
    (正文)JSONRPC取编号 = 编号;
    (正文, "id")JSON存在 = 有编号;
    如果 (方法 ?= "initialize") {
        (编号)构造服务端能力响应 = 结果;
    } 否则如果 (方法 ?= "shutdown") {
        (编号)构造关闭响应 = 结果;
    } 否则如果 (方法 ?= "exit") {
        1 = 退出请求;
        "" = 结果;
    } 否则如果 (方法 ?= "initialized") {
        "" = 结果;
    } 否则如果 (方法 ?= "textDocument/didOpen" || 方法 ?= "textDocument/didChange") {
        (正文, "uri")取字段 = 地址;
        (正文, "text")取字段 = 文本;
        (地址, 文本)诊断帧 = 结果;
    } 否则 {
        如果 (有编号 ?= 1) {
            (编号, 0 - 32601)构造错误响应 = 结果;
        } 否则 {
            "" = 结果;
        }
    }
}
