// JSON 字段取值：JSON获取字符串 共用静态缓冲，取到后立刻复制
函数 (正文:字符串, 键:字符串)取字段("" = 结果:字符串) {
    (正文, 键)JSON获取字符串 = 暂;
    ("", 暂)拼接 = 结果;
}

// JSON 字符串反转义：\n \t \r \" \\ \/（未知转义保留反斜；用于 didOpen/didChange 的 text）
函数 (文本:字符串)JSON反转义("" = 结果:字符串) {
    "" = 输出;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 92 && i + 1 < 总长) {
            (文本, i + 1)字符码 = 后码;
            0 = 认;
            如果 (后码 ?= 110) { 10 = 后码; 1 = 认; }
            如果 (后码 ?= 116) { 9 = 后码; 1 = 认; }
            如果 (后码 ?= 114) { 13 = 后码; 1 = 认; }
            如果 (后码 ?= 34) { 34 = 后码; 1 = 认; }
            如果 (后码 ?= 92) { 92 = 后码; 1 = 认; }
            如果 (后码 ?= 47) { 47 = 后码; 1 = 认; }
            如果 (认 ?= 1) {
                (后码)字符 = 符;
                (输出, 符)拼接 = 输出;
                i + 2 = i;
            } 否则 {
                (码)字符 = 符;
                (输出, 符)拼接 = 输出;
                i + 1 = i;
            }
        } 否则 {
            (码)字符 = 符;
            (输出, 符)拼接 = 输出;
            i + 1 = i;
        }
    }
    输出 = 结果;
}

// 9B：全角标点码（中文输入法常见误输入；不改写，只提示）
函数 (码:整数)是全角标点码(0 = 结果:整数) {
    如果 (码 ?= 65292) { 1 = 结果; }        // ，
    否则如果 (码 ?= 65307) { 1 = 结果; }    // ；
    否则如果 (码 ?= 65306) { 1 = 结果; }    // ：
    否则如果 (码 ?= 65288) { 1 = 结果; }    // （
    否则如果 (码 ?= 65289) { 1 = 结果; }    // ）
    否则如果 (码 ?= 65371) { 1 = 结果; }    // ｛
    否则如果 (码 ?= 65373) { 1 = 结果; }    // ｝
    否则如果 (码 ?= 12304) { 1 = 结果; }    // 【
    否则如果 (码 ?= 12305) { 1 = 结果; }    // 】
    否则如果 (码 ?= 8220) { 1 = 结果; }     // “
    否则如果 (码 ?= 8221) { 1 = 结果; }     // ”
    否则如果 (码 ?= 65281) { 1 = 结果; }    // ！
    否则如果 (码 ?= 65311) { 1 = 结果; }    // ？
    否则如果 (码 ?= 12289) { 1 = 结果; }    // 、
    否则如果 (码 ?= 12288) { 1 = 结果; }    // 全角空格
}

// 括号配对扫描：结果写入 诊断行 / 诊断列 / 诊断种类（首条）
// 行列均为 0 基；字符串字面量与行注释内的括号不计。
// 9B：另报「字符串未闭合」（3）与「全角标点」（4）。
// 9F：改为**逐错聚合**（不再遇首个错误即停），全部条目进入 诊断缓冲。
函数 (文本:字符串)括号诊断 {
    ()清理诊断;
    (文本)长度 = 总长;
    0 = i;
    0 = 行;
    0 = 列;
    0 = 在串;
    0 = 在注释;
    0 = 圆数;
    0 = 方数;
    0 = 花数;
    0 = 圆行;
    0 = 圆列;
    0 = 方行;
    0 = 方列;
    0 = 花行;
    0 = 花列;
    0 = 串行;
    0 = 串列;
    0 = 停;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (在注释 ?= 1) {
            如果 (码 ?= 10) {
                0 = 在注释;
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (在串 ?= 1) {
            如果 (码 ?= 34) {
                0 = 在串;
            } 否则如果 (码 ?= 10) {
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (码 ?= 34) {
            1 = 在串;
            行 = 串行;
            列 = 串列;
        } 否则如果 (码 ?= 47) {
            (文本, i + 1)字符码 = 后码;
            如果 (后码 ?= 47) {
                1 = 在注释;
            }
        } 否则如果 (码 ?= 10) {
            行 + 1 = 行;
            0 - 1 = 列;
        } 否则如果 (码 ?= 40) {
            圆数 + 1 = 圆数;
            行 = 圆行;
            列 = 圆列;
        } 否则如果 (码 ?= 41) {
            圆数 - 1 = 圆数;
            如果 (圆数 < 0) {
                (1, 行, 列, "")记诊断;
                0 = 圆数;
            }
        } 否则如果 (码 ?= 91) {
            方数 + 1 = 方数;
            行 = 方行;
            列 = 方列;
        } 否则如果 (码 ?= 93) {
            方数 - 1 = 方数;
            如果 (方数 < 0) {
                (1, 行, 列, "")记诊断;
                0 = 方数;
            }
        } 否则如果 (码 ?= 123) {
            花数 + 1 = 花数;
            行 = 花行;
            列 = 花列;
        } 否则如果 (码 ?= 125) {
            花数 - 1 = 花数;
            如果 (花数 < 0) {
                (1, 行, 列, "")记诊断;
                0 = 花数;
            }
        } 否则 {
            (码)是全角标点码 = 全角;
            如果 (全角 ?= 1) {
                (4, 行, 列, "")记诊断;
            }
        }
        如果 (停 ?= 0) {
            i + 1 = i;
            列 + 1 = 列;
        }
    }
    // 9F：未闭合与字符串未闭合改为无条件上报（多诊断聚合；首条语义由 记诊断 保证）
    如果 (圆数 > 0) {
        (2, 圆行, 圆列, "")记诊断;
    } 否则如果 (方数 > 0) {
        (2, 方行, 方列, "")记诊断;
    } 否则如果 (花数 > 0) {
        (2, 花行, 花列, "")记诊断;
    }
    // 9B：扫描到末尾仍在字符串内 → 字符串未闭合（定位到开引号）
    如果 (在串 ?= 1) {
        (3, 串行, 串列, "")记诊断;
    }
}

// 诊断文案（无错 → 空串）
函数 ()诊断消息("" = 结果:字符串) {
    如果 (诊断种类 ?= 1) {
        "多余的右括号" = 结果;
    } 否则如果 (诊断种类 ?= 2) {
        "括号未闭合" = 结果;
    } 否则如果 (诊断种类 ?= 3) {
        "字符串未闭合" = 结果;
    } 否则如果 (诊断种类 ?= 4) {
        "疑似全角标点，请改用半角" = 结果;
    } 否则如果 (诊断种类 ?= 5) {
        "字面量默认值与类型标注不符" = 结果;
    } 否则 {
        "" = 结果;
    }
}

// ==================== 9F：多诊断聚合 ====================
//   · 诊断行 / 诊断列 / 诊断种类 只记**首条**（兼容 9A/9B 的单条语义）；
//   · 全部条目按序进 诊断缓冲（已用逗号连接的对象串），单帧上限 8 条。

