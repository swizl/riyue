            (编号, 推断体)构造对象结果响应按字节 = 结果;
        }
    } 否则如果 (方法名 ?= "textDocument/references") {
        // P6/9.2：光标处标识符 → 本地 + 其他登记文档的全部出现位置
        (正文, "line")取字段数 = 行号;
        (正文, "character")取字段数 = 列号;
        (行号, 列号)跨文件引用对象 = 引用体;
        (编号, 引用体)构造对象结果响应按字节 = 结果;
    } 否则如果 (方法名 ?= "textDocument/semanticTokens/full") {
        // 9.2：全文语义令牌（相对编码 5 元组数组）
        (文档文本)语义令牌对象 = 令牌体;
        (编号, 令牌体)构造对象结果响应按字节 = 结果;
    } 否则如果 (方法名 ?= "workspace/symbol") {
        // 9.2：全部登记文档的声明 → SymbolInformation 数组
        ()工作区符号对象 = 工作区符号体;
        (编号, 工作区符号体)构造对象结果响应按字节 = 结果;
    } 否则如果 (方法名 ?= "textDocument/documentSymbol") {
        // P6 续：最近打开文档内的声明 → DocumentSymbol 数组
        (文档文本)文档符号对象 = 符号体;
        (编号, 符号体)构造对象结果响应按字节 = 结果;
    } 否则如果 (方法名 ?= "textDocument/rename") {
        // P6 续2：光标处标识符 → WorkspaceEdit（全部出现位置改写为新名）
        (正文, "line")取字段数 = 行号;
        (正文, "character")取字段数 = 列号;
        (正文, "newName")取字段 = 新名;
        (行号, 列号, 新名)重命名对象 = 改名体;
        (编号, 改名体)构造对象结果响应按字节 = 结果;
    } 否则如果 (方法名 ?= "textDocument/codeAction") {
        // P6 续3：光标所在行的文本问题（缩进制表符 / 行尾空白 / 全角标点）→ quickfix 数组
        (正文, "line")取字段数 = 行号;
        (行号)代码操作对象 = 操作体;
        (编号, 操作体)构造对象结果响应按字节 = 结果;
    } 否则如果 (方法名 ?= "textDocument/foldingRange") {
        // P6 续4：跨行花括号块 → 折叠区间数组
        ()折叠对象 = 折叠体;
        (编号, 折叠体)构造对象结果响应按字节 = 结果;
    } 否则 {
        如果 (有编号 ?= 1) {
            (编号, 0 - 32601)构造错误响应 = 结果;
        } 否则 {
            "" = 结果;
        }
    }
}
