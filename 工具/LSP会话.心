// ==================== 9A：补全 / 跳转（纯 `.心`，双链一致） ====================
//   · 位置一律按**字符（码点）**偏移计（与 `括号诊断` 的行列口径一致；LSP 的 UTF-16 列
//     在 BMP 文本上与之一致，辅助平面字符会有偏差，属已知限制，见 文档/编译器差距补齐计划.md 阶段9）。
//   · 补全：固定关键字表 + 文档内标识符（按首次出现去重，最多 64 项）。
//   · 跳转：光标处标识符 → 文档内首次出现位置（启发式「定义点」，不做作用域解析）。

// 是否标识符字符：ASCII 字母 / 数字 / 下划线 / 非 ASCII（中文标识符）
函数 (码:整数)是标识符码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 65 && 码 <= 90) { 1 = 结果; }
    如果 (码 >= 97 && 码 <= 122) { 1 = 结果; }
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
    如果 (码 ?= 95) { 1 = 结果; }
    如果 (码 >= 128) { 1 = 结果; }
}

// 是否标识符**首**字符：字母 / 下划线 / 非 ASCII（数字可续接，但不能起词）
函数 (码:整数)是标识符首码(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 65 && 码 <= 90) { 1 = 结果; }
    如果 (码 >= 97 && 码 <= 122) { 1 = 结果; }
    如果 (码 ?= 95) { 1 = 结果; }
    如果 (码 >= 128) { 1 = 结果; }
}

// 取 JSON 里 "<键>":<整数> 的整数值（跳过空白；无该键或无数字 → -1）
函数 (正文:字符串, 键:字符串)取字段数(-1 = 结果:整数) {
    -1 = 结果;
    (34)字符 = 单;
    ("", 单)拼接 = 引;
    ("", 引)拼接 = 针;
    (针, 键)拼接 = 针;
    (针, 引)拼接 = 针;
    (针, ":")拼接 = 针;
    (正文)长度 = 总长;
    (针)长度 = 针长;
    0 = i;
    0 = 停;
    当 (停 ?= 0 && i + 针长 <= 总长) {
        1 = 命中;
        0 = j;
        当 (j < 针长) {
            (正文, i + j)字符码 = 甲;
            (针, j)字符码 = 乙;
            如果 (甲 != 乙) { 0 = 命中; }
            j + 1 = j;
        }
        如果 (命中 ?= 1) {
            i + 针长 = 位;
            0 = 见数;
            0 = 数;
            0 = 扫;
            当 (扫 ?= 0 && 位 < 总长) {
                (正文, 位)字符码 = 码;
                如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 13 || 码 ?= 10) {
                    位 + 1 = 位;
                } 否则如果 (码 >= 48 && 码 <= 57) {
                    数 * 10 + 码 - 48 = 数;
                    1 = 见数;
                    位 + 1 = 位;
                } 否则 {
                    1 = 扫;
                }
            }
            如果 (见数 ?= 1) {
                数 = 结果;
                1 = 停;
            }
        }
        如果 (停 ?= 0) {
            i + 1 = i;
        }
    }
}

// 第 行（0 基）的行首字符偏移；行不存在 → -1
函数 (文本:字符串, 行:整数)行首偏移(-1 = 结果:整数) {
    行 = 行参;
    如果 (行参 < 0) {
        -1 = 结果;
    } 否则如果 (行参 ?= 0) {
        0 = 结果;
    } 否则 {
        (文本)长度 = 总长;
        0 = 当前行;
        0 = i;
        0 = 停;
        当 (停 ?= 0 && i < 总长) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 10) {
                当前行 + 1 = 当前行;
                如果 (当前行 ?= 行参) {
                    i + 1 = 结果;
