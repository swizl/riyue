// JSON 字符串反转义：\n \t \r \" \\ \/（未知转义保留反斜；用于 didOpen/didChange 的 text）
函数 (文本:字符串)JSON反转义("" = 结果:字符串) {
    "" = 输出;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 92 && i + 1 < 总长) {
            (文本, i + 1)字符码 = 后码;
            0 = 认;
            如果 (后码 ?= 110) { 10 = 后码; 1 = 认; }
            如果 (后码 ?= 116) { 9 = 后码; 1 = 认; }
            如果 (后码 ?= 114) { 13 = 后码; 1 = 认; }
            如果 (后码 ?= 34) { 34 = 后码; 1 = 认; }
            如果 (后码 ?= 92) { 92 = 后码; 1 = 认; }
            如果 (后码 ?= 47) { 47 = 后码; 1 = 认; }
            如果 (认 ?= 1) {
                (后码)字符 = 符;
                (输出, 符)拼接 = 输出;
                i + 2 = i;
            } 否则 {
                (码)字符 = 符;
                (输出, 符)拼接 = 输出;
                i + 1 = i;
            }
        } 否则 {
            (码)字符 = 符;
            (输出, 符)拼接 = 输出;
            i + 1 = i;
        }
    }
    输出 = 结果;
}

