// 名表（换行分隔，首尾带换行）是否含 词；含 → 1
函数 (表:字符串, 词:字符串)名表含(0 = 结果:整数) {
    0 = 结果;
    如果 (词 ?= "") { } 否则 {
        (10)字符 = 单;
        ("", 单)拼接 = 换行;
        "" = 针;
        (针, 换行)拼接 = 针;
        (针, 词)拼接 = 针;
        (针, 换行)拼接 = 针;
        (表, 针)查词位置 = 位;
        如果 (位 >= 0) { 1 = 结果; }
    }
}

// 种类 + 词 → 诊断文案（词仅种类 6 使用）
函数 (种类:整数, 词:字符串)种类消息("" = 结果:字符串) {
    如果 (种类 ?= 1) {
        "多余的右括号" = 结果;
    } 否则如果 (种类 ?= 2) {
        "括号未闭合" = 结果;
    } 否则如果 (种类 ?= 3) {
        "字符串未闭合" = 结果;
    } 否则如果 (种类 ?= 4) {
        "疑似全角标点，请改用半角" = 结果;
    } 否则如果 (种类 ?= 5) {
        "字面量默认值与类型标注不符" = 结果;
    } 否则如果 (种类 ?= 6) {
        (结果, "未声明的标识符")拼接 = 结果;
        如果 (词 ?= "") { } 否则 {
            (结果, ": ")拼接 = 结果;
            (结果, 词)拼接 = 结果;
        }
    } 否则 {
        "" = 结果;
    }
}

// 追加一条诊断（0 基行列；首条写入 诊断行/列/种类；上限 8 条）
函数 (种类:整数, 行:整数, 列:整数, 词:字符串)记诊断 {
    如果 (诊断种类 ?= 0) {
        种类 = 诊断种类;
        行 = 诊断行;
        列 = 诊断列;
    }
    如果 (诊断条数 < 8) {
        (种类, 词)种类消息 = 消息;
        (行, 列, 消息)构造诊断条目 = 条目;
        如果 (诊断条数 > 0) {
            (诊断缓冲, ",")拼接 = 诊断缓冲;
        }
        (诊断缓冲, 条目)拼接 = 诊断缓冲;
        诊断条数 + 1 = 诊断条数;
    }
}

// ==================== 9B：类型诊断（字面量默认值 vs 类型标注） ====================
//   · 文法决定形态：输出形参 / 返回位写作 `字面量 '=' 标识符 类型标注?`，
//     故只在「字面量 `=` 标识符 `:` 类型名」这一最小可判定窗口内比对。
//   · 只认四个内建标量类型名（整数 / 浮点 / 字符串 / 布尔）；结构体 / 枚举 / 别名等
//     自定义类型名一律放过（静态不可判定），限制见 文档/编译器差距补齐计划.md 阶段9。
//   · 字面种类：1 字符串 / 2 整数（由首个数字起算，`x1` 这类标识符内数字不计）。

// 位 = `=` 之后首个字符偏移。命中矛盾 → 诊断种类 5，定位到字面量起点，返回 1
函数 (文本:字符串, 位:整数, 字面种类:整数, 字行:整数, 字列:整数)标注不符(0 = 结果:整数) {
    (文本)长度 = 总长;
    位 = i;
    0 = 停;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) {
            i + 1 = i;
        } 否则 {
            1 = 停;
        }
    }
    "" = 词;
    0 = 有词;
    如果 (i < 总长) {
        (文本, i)字符码 = 码;
        (码)是标识符首码 = 首;
        如果 (首 ?= 1) {
            1 = 有词;
            0 = 停;
            当 (i < 总长 && 停 ?= 0) {
                (文本, i)字符码 = 码;
                (码)是标识符码 = 是;
                如果 (是 ?= 1) {
                    (码)字符 = 字;
                    (词, 字)拼接 = 词;
                    i + 1 = i;
                } 否则 {
                    1 = 停;
                }
            }
        }
    }
    "" = 类型词;
    0 = 命中;
    如果 (有词 ?= 1) {
        0 = 停;
        当 (i < 总长 && 停 ?= 0) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                i + 1 = i;
            } 否则 {
                1 = 停;
            }
        }
        如果 (i < 总长) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 58) {
                i + 1 = i;
                0 = 停;
                当 (i < 总长 && 停 ?= 0) {
                    (文本, i)字符码 = 码;
                    如果 (码 ?= 32 || 码 ?= 9) {
                        i + 1 = i;
                    } 否则 {
                        1 = 停;
                    }
                }
                如果 (i < 总长) {
                    (文本, i)字符码 = 码;
                    (码)是标识符首码 = 首二;
                    如果 (首二 ?= 1) {
                        0 = 停;
                        当 (i < 总长 && 停 ?= 0) {
                            (文本, i)字符码 = 码;
                            (码)是标识符码 = 是二;
                            如果 (是二 ?= 1) {
                                (码)字符 = 字二;
                                (类型词, 字二)拼接 = 类型词;
                                i + 1 = i;
                            } 否则 {
                                1 = 停;
                            }
                        }
                    }
                }
                如果 (字面种类 ?= 1) {
                    如果 (类型词 ?= "整数" || 类型词 ?= "浮点" || 类型词 ?= "布尔") {
                        1 = 命中;
                    }
                } 否则如果 (字面种类 ?= 2) {
                    如果 (类型词 ?= "字符串" || 类型词 ?= "布尔") {
                        1 = 命中;
                    }
                }
            }
        }
    }
    如果 (命中 ?= 1) {
        (5, 字行, 字列, "")记诊断;
        1 = 结果;
    }
}

