// ==================== 9B：类型诊断（字面量默认值 vs 类型标注） ====================
//   · 文法决定形态：输出形参 / 返回位写作 `字面量 '=' 标识符 类型标注?`，
//     故只在「字面量 `=` 标识符 `:` 类型名」这一最小可判定窗口内比对。
//   · 只认四个内建标量类型名（整数 / 浮点 / 字符串 / 布尔）；结构体 / 枚举 / 别名等
//     自定义类型名一律放过（静态不可判定），限制见 文档/编译器差距补齐计划.md 阶段9。
//   · 字面种类：1 字符串 / 2 整数（由首个数字起算，`x1` 这类标识符内数字不计）。

// 位 = `=` 之后首个字符偏移。命中矛盾 → 诊断种类 5，定位到字面量起点，返回 1
函数 (文本:字符串, 位:整数, 字面种类:整数, 字行:整数, 字列:整数)标注不符(0 = 结果:整数) {
    (文本)长度 = 总长;
    位 = i;
    0 = 停;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9) {
            i + 1 = i;
        } 否则 {
            1 = 停;
        }
    }
    "" = 词;
    0 = 有词;
    如果 (i < 总长) {
        (文本, i)字符码 = 码;
        (码)是标识符首码 = 首;
        如果 (首 ?= 1) {
            1 = 有词;
            0 = 停;
            当 (i < 总长 && 停 ?= 0) {
                (文本, i)字符码 = 码;
                (码)是标识符码 = 是;
                如果 (是 ?= 1) {
                    (码)字符 = 字;
                    (词, 字)拼接 = 词;
                    i + 1 = i;
                } 否则 {
                    1 = 停;
                }
            }
        }
    }
    "" = 类型词;
    0 = 命中;
    如果 (有词 ?= 1) {
        0 = 停;
        当 (i < 总长 && 停 ?= 0) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                i + 1 = i;
            } 否则 {
                1 = 停;
            }
        }
        如果 (i < 总长) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 58) {
                i + 1 = i;
                0 = 停;
                当 (i < 总长 && 停 ?= 0) {
                    (文本, i)字符码 = 码;
                    如果 (码 ?= 32 || 码 ?= 9) {
                        i + 1 = i;
                    } 否则 {
                        1 = 停;
                    }
                }
                如果 (i < 总长) {
                    (文本, i)字符码 = 码;
                    (码)是标识符首码 = 首二;
                    如果 (首二 ?= 1) {
                        0 = 停;
                        当 (i < 总长 && 停 ?= 0) {
                            (文本, i)字符码 = 码;
                            (码)是标识符码 = 是二;
                            如果 (是二 ?= 1) {
                                (码)字符 = 字二;
                                (类型词, 字二)拼接 = 类型词;
                                i + 1 = i;
                            } 否则 {
                                1 = 停;
                            }
                        }
                    }
                }
                如果 (字面种类 ?= 1) {
                    如果 (类型词 ?= "整数" || 类型词 ?= "浮点" || 类型词 ?= "布尔") {
                        1 = 命中;
                    }
                } 否则如果 (字面种类 ?= 2) {
                    如果 (类型词 ?= "字符串" || 类型词 ?= "布尔") {
                        1 = 命中;
                    }
                }
            }
        }
    }
    如果 (命中 ?= 1) {
        5 = 诊断种类;
        字行 = 诊断行;
        字列 = 诊断列;
        1 = 结果;
    }
}

// 类型诊断扫描：仅在没有括号 / 字符串 / 全角错误时运行（首个错误优先）
函数 (文本:字符串)标注诊断 {
    0 = 停;
    (文本)长度 = 总长;
    0 = i;
    0 = 行;
    0 = 列;
    0 = 在串;
    0 = 在注释;
    0 = 字面种类;
    0 = 字行;
    0 = 字列;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (在注释 ?= 1) {
            如果 (码 ?= 10) {
                0 = 在注释;
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (在串 ?= 1) {
            如果 (码 ?= 34) {
                0 = 在串;
            } 否则如果 (码 ?= 10) {
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (码 ?= 34) {
            1 = 在串;
            1 = 字面种类;
            行 = 字行;
            列 = 字列;
        } 否则如果 (码 ?= 47) {
            (文本, i + 1)字符码 = 后码;
            如果 (后码 ?= 47) {
                1 = 在注释;
            } 否则 {
                0 = 字面种类;
            }
        } 否则如果 (码 ?= 10) {
            行 + 1 = 行;
            0 - 1 = 列;
        } 否则如果 (码 ?= 61) {
            如果 (字面种类 > 0) {
                (文本, i + 1, 字面种类, 字行, 字列)标注不符 = 命中;
                0 = 字面种类;
                如果 (命中 ?= 1) {
                    1 = 停;
                }
            }
        } 否则如果 (码 >= 48 && 码 <= 57) {
            如果 (字面种类 != 2) {
                0 = 前是;
                如果 (i > 0) {
                    (文本, i - 1)字符码 = 前码;
                    (前码)是标识符码 = 前是;
                }
                如果 (前是 ?= 0) {
                    2 = 字面种类;
                    行 = 字行;
                    列 = 字列;
                }
            }
        } 否则 {
            如果 (码 != 32 && 码 != 9) {
                0 = 字面种类;
            }
        }
        如果 (停 ?= 0) {
            i + 1 = i;
            列 + 1 = 列;
        }
    }
}

