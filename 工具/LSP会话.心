// 括号配对扫描：结果写入 诊断行 / 诊断列 / 诊断种类
// 行列均为 0 基；字符串字面量与行注释内的括号不计。
// 9B：另报首个「字符串未闭合」（3）与「全角标点」（4）。
函数 (文本:字符串)括号诊断 {
    0 - 1 = 诊断行;
    0 = 诊断列;
    0 = 诊断种类;
    (文本)长度 = 总长;
    0 = i;
    0 = 行;
    0 = 列;
    0 = 在串;
    0 = 在注释;
    0 = 圆数;
    0 = 方数;
    0 = 花数;
    0 = 圆行;
    0 = 圆列;
    0 = 方行;
    0 = 方列;
    0 = 花行;
    0 = 花列;
    0 = 串行;
    0 = 串列;
    0 = 停;
    当 (i < 总长 && 停 ?= 0) {
        (文本, i)字符码 = 码;
        如果 (在注释 ?= 1) {
            如果 (码 ?= 10) {
                0 = 在注释;
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (在串 ?= 1) {
            如果 (码 ?= 34) {
                0 = 在串;
            } 否则如果 (码 ?= 10) {
                行 + 1 = 行;
                0 - 1 = 列;
            }
        } 否则如果 (码 ?= 34) {
            1 = 在串;
            行 = 串行;
            列 = 串列;
        } 否则如果 (码 ?= 47) {
            (文本, i + 1)字符码 = 后码;
            如果 (后码 ?= 47) {
                1 = 在注释;
            }
        } 否则如果 (码 ?= 10) {
            行 + 1 = 行;
            0 - 1 = 列;
        } 否则如果 (码 ?= 40) {
            圆数 + 1 = 圆数;
            行 = 圆行;
            列 = 圆列;
        } 否则如果 (码 ?= 41) {
            圆数 - 1 = 圆数;
            如果 (圆数 < 0) {
                1 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        } 否则如果 (码 ?= 91) {
            方数 + 1 = 方数;
            行 = 方行;
            列 = 方列;
        } 否则如果 (码 ?= 93) {
            方数 - 1 = 方数;
            如果 (方数 < 0) {
                1 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        } 否则如果 (码 ?= 123) {
            花数 + 1 = 花数;
            行 = 花行;
            列 = 花列;
        } 否则如果 (码 ?= 125) {
            花数 - 1 = 花数;
            如果 (花数 < 0) {
                1 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        } 否则 {
            (码)是全角标点码 = 全角;
            如果 (全角 ?= 1) {
                4 = 诊断种类;
                行 = 诊断行;
                列 = 诊断列;
                1 = 停;
            }
        }
        如果 (停 ?= 0) {
            i + 1 = i;
            列 + 1 = 列;
        }
    }
    如果 (诊断种类 ?= 0) {
        如果 (圆数 > 0) {
            2 = 诊断种类;
            圆行 = 诊断行;
            圆列 = 诊断列;
        } 否则如果 (方数 > 0) {
            2 = 诊断种类;
            方行 = 诊断行;
            方列 = 诊断列;
        } 否则如果 (花数 > 0) {
            2 = 诊断种类;
            花行 = 诊断行;
            花列 = 诊断列;
        }
    }
    // 9B：扫描到末尾仍在字符串内 → 字符串未闭合（定位到开引号）
    如果 (诊断种类 ?= 0 && 在串 ?= 1) {
        3 = 诊断种类;
        串行 = 诊断行;
        串列 = 诊断列;
    }
}

// 诊断文案（无错 → 空串）
函数 ()诊断消息("" = 结果:字符串) {
