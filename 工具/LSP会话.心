                    1 = 停;
                }
            }
        }
    }
    "" = 类型词;
    0 = 命中;
    如果 (有词 ?= 1) {
        0 = 停;
        当 (i < 总长 && 停 ?= 0) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                i + 1 = i;
            } 否则 {
                1 = 停;
            }
        }
        如果 (i < 总长) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 58) {
                i + 1 = i;
                0 = 停;
                当 (i < 总长 && 停 ?= 0) {
                    (文本, i)字符码 = 码;
                    如果 (码 ?= 32 || 码 ?= 9) {
                        i + 1 = i;
                    } 否则 {
                        1 = 停;
                    }
                }
                如果 (i < 总长) {
                    (文本, i)字符码 = 码;
                    (码)是标识符首码 = 首二;
                    如果 (首二 ?= 1) {
