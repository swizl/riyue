                        当 (i < 总长 && 停 ?= 0) {
                            (文本, i)字符码 = 码;
                            (码)是标识符码 = 是二;
                            如果 (是二 ?= 1) {
                                (码)字符 = 字二;
                                (类型词, 字二)拼接 = 类型词;
                                i + 1 = i;
                            } 否则 {
                                1 = 停;
                            }
