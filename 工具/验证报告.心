// 验证报告（库模块）
// 用法：被 工具/统一命令行.心（`验证` 子命令）与 示例/验证报告测试.心 导入；无 `主程序`。
//
// 阶段：短板补齐计划 §Phase 9.3「AI 验证闭环」
//   · 回归日志（`bash run_tests.sh` → 阶段/回归.log）：解析 `Pass: N  Fail: M`、
//     首条 `FAIL:` / `TIMEOUT:`（失败用例 + 首个失败点）、`门禁: 通过`
//   · 不动点日志（`bash 不动点验证.sh` → 阶段/不动点.log）：解析
//     `中间码1.ll  字节=N  SHA256=…`、两份哈希一致性与 `门禁: 通过`
//   · 汇总为单行 JSON：{"ok","tests":{…},"fixpoint":{…},"logs":{…}}，供 AI 修改后自检
//
// 纯 `.心` 切片（不改编译器 / 文法 / 自举源 ⇒ 不动点恒定）。
// 限制：日志格式若变动需同步解析规则；JSON 为手写拼装（单行扁平）；文件按 UTF-8 字节
//       逐字节扫描（`子串`/`字符码` 均以字节为单位）。
// 依赖：仅 工具/文档生成器.心（提供 `文档行数`/`文档取行`）；字符串前缀/查找/比较
//       在本文件内手写，避免与 测试框架→字符串.心 的导入键冲突。

导入 "../工具/文档生成器.心";

// 模块版本：1 = 回归/不动点日志解析 + 报告 JSON
函数 ()验证报告模块版本(0 = 结果:整数) {
    1 = 结果;
}

// 文本是否以 前缀 开头 → 1/0（空前缀 → 1）
函数 (文本:字符串, 前缀:字符串)验证以开头(0 = 结果:整数) {
    0 = 文本长;
    0 = 前缀长;
    0 = j;
    0 = 码;
    0 = 乙;
    0 = 停;
    (文本)长度 = 文本长;
    (前缀)长度 = 前缀长;
    如果 (前缀长 <= 文本长) {
        1 = 结果;
        0 = j;
        0 = 停;
        当 (j < 前缀长 && 停 ?= 0) {
            (文本, j)字符码 = 码;
            (前缀, j)字符码 = 乙;
            如果 (码 ?= 乙) {
                j + 1 = j;
            } 否则 {
                0 = 结果;
                1 = 停;
            }
        }
    }
}

// 去掉 前缀（无该前缀 → 原样）
函数 (文本:字符串, 前缀:字符串)验证去前缀("" = 结果:字符串) {
    0 = 文本长;
    0 = 前缀长;
    0 = 有;
    (文本)验证以开头 = 有;
    (文本)长度 = 文本长;
    (前缀)长度 = 前缀长;
    如果 (有 ?= 1) {
        (文本, 前缀长, 文本长 - 前缀长)子串 = 结果;
    } 否则 {
        文本 = 结果;
    }
}

// 子串首次出现的字节下标；未找到 → -1（空子串 → 0）
函数 (文本:字符串, 子串:字符串)验证查找(0 = 位置:整数) {
    0 = 文本长;
    0 = 子长;
    0 = i;
    0 = j;
    0 = 码;
    0 = 乙;
    0 = 停;
    0 = 匹配;
    -1 = 位置;
    (文本)长度 = 文本长;
    (子串)长度 = 子长;
    如果 (子长 <= 文本长) {
        0 = i;
        0 = 停;
        当 (i + 子长 <= 文本长 && 停 ?= 0) {
            1 = 匹配;
            0 = j;
            当 (j < 子长 && 匹配 ?= 1) {
                (文本, i + j)字符码 = 码;
                (子串, j)字符码 = 乙;
                如果 (码 ?= 乙) {
                    j + 1 = j;
                } 否则 {
                    0 = 匹配;
                }
            }
            如果 (匹配 ?= 1) {
                i = 位置;
                1 = 停;
            } 否则 {
                i + 1 = i;
            }
        }
    }
}

// 字节序比较：甲 < 乙 → -1；相等 → 0；甲 > 乙 → 1
函数 (甲:字符串, 乙:字符串)验证比较(0 = 结果:整数) {
    0 = 甲长;
    0 = 乙长;
    0 = n;
    0 = i;
    0 = a;
    0 = b;
    0 = 停;
    (甲)长度 = 甲长;
    (乙)长度 = 乙长;
    甲长 = n;
    如果 (乙长 < n) {
        乙长 = n;
    }
    0 = i;
    0 = 停;
    当 (i < n && 停 ?= 0) {
        (甲, i)字符码 = a;
        (乙, i)字符码 = b;
        如果 (a < b) {
            -1 = 结果;
            1 = 停;
        }
        如果 (a > b) {
            1 = 结果;
            1 = 停;
        }
        i + 1 = i;
    }
    如果 (停 ?= 0) {
        如果 (甲长 < 乙长) {
            -1 = 结果;
        }
        如果 (甲长 > 乙长) {
            1 = 结果;
        }
    }
}

// 从 起 起扫描十进制数字 → (值, 末)；无数字时 值 = 0、末 = 起
函数 (文本:字符串, 起:整数)验证取十进制(0 = 值:整数, 0 = 末:整数) {
    0 = 长;
    0 = 扫;
    0 = 码;
    0 = 停;
    (文本)长度 = 长;
    起 = 扫;
    0 = 停;
    当 (扫 < 长 && 停 ?= 0) {
        (文本, 扫)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            值 * 10 + 码 - 48 = 值;
            扫 + 1 = 扫;
        } 否则 {
            1 = 停;
        }
    }
    扫 = 末;
}

// 从 起 起扫描十六进制串（0-9 / a-f / A-F）→ 子串；无则 ""
函数 (文本:字符串, 起:整数)验证取十六进制("" = 结果:字符串) {
    0 = 长;
    0 = 扫;
    0 = 码;
    0 = 停;
    0 = 是;
    (文本)长度 = 长;
    起 = 扫;
    0 = 停;
    当 (扫 < 长 && 停 ?= 0) {
        (文本, 扫)字符码 = 码;
        0 = 是;
        如果 (码 >= 48 && 码 <= 57) { 1 = 是; }
        如果 (码 >= 97 && 码 <= 102) { 1 = 是; }
        如果 (码 >= 65 && 码 <= 70) { 1 = 是; }
        如果 (是 ?= 1) {
            扫 + 1 = 扫;
        } 否则 {
            1 = 停;
        }
    }
    如果 (扫 > 起) {
        (文本, 起, 扫 - 起)子串 = 结果;
    }
}

// JSON 字符串值段：`"…"`（转义 `"` / `\` / 换行 / 回车 / 制表）
函数 (文本:字符串)验证JSON串("" = 结果:字符串) {
    0 = 长;
    0 = i;
    0 = 码;
    "" = 一;
    "" = 引;
    "" = 反;
    (34)字符 = 引;
    (92)字符 = 反;
    (文本)长度 = 长;
    引 = 结果;
    0 = i;
    当 (i < 长) {
        (文本, i)字符码 = 码;
        (文本, i, 1)子串 = 一;
        如果 (码 ?= 34) {
            (结果, 反)拼接 = 结果;
            (结果, 引)拼接 = 结果;
        } 否则如果 (码 ?= 92) {
            (结果, 反)拼接 = 结果;
            (结果, 反)拼接 = 结果;
        } 否则如果 (码 ?= 10) {
            (结果, 反)拼接 = 结果;
            (结果, "n")拼接 = 结果;
        } 否则如果 (码 ?= 13) {
            (结果, 反)拼接 = 结果;
            (结果, "r")拼接 = 结果;
        } 否则如果 (码 ?= 9) {
            (结果, 反)拼接 = 结果;
            (结果, "t")拼接 = 结果;
        } 否则 {
            (结果, 一)拼接 = 结果;
        }
        i + 1 = i;
    }
    (结果, 引)拼接 = 结果;
}

// 回归日志 → (通过, 失败, 首个失败, 门禁)
//   汇总行：`Pass: 206  Fail: 0`；首个失败点：首条 `FAIL: …` / `TIMEOUT: …`；
//   门禁：`门禁: 通过 (Pass=… >= …, Fail=0)`
函数 (文本:字符串)验证解析回归(0 = 通过:整数, 0 = 失败:整数, "" = 首个失败:字符串, 0 = 门禁:整数) {
    0 = 总行;
    0 = 行序;
    0 = 位;
    0 = 末;
    0 = 是行;
    0 = 字长;
    "" = 行;
    ()创建动态字符串数组 = 行表;
    (文本, 行表)文档拆行 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (行表, 行序)动态字符串数组获取 = 行;
        // 汇总行
        (行, "Pass: ")验证以开头 = 是行;
        如果 (是行 ?= 1) {
            ("Pass: ")长度 = 字长;
            (行, 字长)验证取十进制 = (通过, 末);
            (行, "Fail: ")验证查找 = 位;
            如果 (位 >= 0) {
                ("Fail: ")长度 = 字长;
                (行, 位 + 字长)验证取十进制 = (失败, 末);
            }
        }
        // 首个失败点
        如果 (首个失败 ?= "") {
            (行, "FAIL: ")验证以开头 = 是行;
            如果 (是行 ?= 1) {
                (行, "FAIL: ")验证去前缀 = 首个失败;
            } 否则 {
                (行, "TIMEOUT: ")验证以开头 = 是行;
                如果 (是行 ?= 1) {
                    (行, "TIMEOUT: ")验证去前缀 = 首个失败;
                }
            }
        }
        // 门禁行
        (行, "门禁: 通过")验证以开头 = 是行;
        如果 (是行 ?= 1) {
            1 = 门禁;
        }
        行序 + 1 = 行序;
    }
}

// 不动点日志 → (字节, 哈希, 一致, 门禁)
//   证据行：`中间码1.ll  字节=6078606  SHA256=f623…`（中间码2.ll 同格式）
//   一致：两份 SHA256 非空且相等；门禁：`门禁: 通过（不动点成立…）`
函数 (文本:字符串)验证解析不动点(0 = 字节:整数, "" = 哈希:字符串, 0 = 一致:整数, 0 = 门禁:整数) {
    0 = 总行;
    0 = 行序;
    0 = 位;
    0 = 末;
    0 = 是行;
    0 = 字长;
    0 = 字节二;
    0 = 比;
    "" = 行;
    "" = 哈希二;
    ()创建动态字符串数组 = 行表;
    (文本, 行表)文档拆行 = 总行;
    0 = 行序;
    当 (行序 < 总行) {
        (行表, 行序)动态字符串数组获取 = 行;
        (行, "中间码1.ll")验证以开头 = 是行;
        如果 (是行 ?= 1) {
            (行, "字节=")验证查找 = 位;
            如果 (位 >= 0) {
                ("字节=")长度 = 字长;
                (行, 位 + 字长)验证取十进制 = (字节, 末);
            }
            (行, "SHA256=")验证查找 = 位;
            如果 (位 >= 0) {
                ("SHA256=")长度 = 字长;
                (行, 位 + 字长)验证取十六进制 = 哈希;
            }
        }
        (行, "中间码2.ll")验证以开头 = 是行;
        如果 (是行 ?= 1) {
            (行, "字节=")验证查找 = 位;
            如果 (位 >= 0) {
                ("字节=")长度 = 字长;
                (行, 位 + 字长)验证取十进制 = (字节二, 末);
            }
            (行, "SHA256=")验证查找 = 位;
            如果 (位 >= 0) {
                ("SHA256=")长度 = 字长;
                (行, 位 + 字长)验证取十六进制 = 哈希二;
            }
        }
        (行, "门禁: 通过")验证以开头 = 是行;
        如果 (是行 ?= 1) {
            1 = 门禁;
        }
        行序 + 1 = 行序;
    }
    如果 (哈希 != "") {
        如果 (哈希二 != "") {
            (哈希, 哈希二)验证比较 = 比;
            如果 (比 ?= 0) {
                1 = 一致;
            }
        }
    }
}

