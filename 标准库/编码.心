// 日月标准库 - 编码工具（Base64 / 十六进制）
//
// 说明：
//   · 纯 .心 实现，不依赖任何编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 位或 `|` 在表达式位置被管道解析器优先消费，故一律用 `+` 拼接互不重叠的 6 位字段；
//     移位运算符词法为 `<|` / `>|`，本模块改用 `/ 4`、`/ 16`、`/ 64`、`% 4`（2 的幂，等价）。
//   · 按「码点」处理：ASCII 下与字节等价；多字节 UTF-8 按码点而非字节（见计划 8A 限制）。
//   · 字符结果「即取即拼」：同一时刻只持有一个 `(码)字符` 结果并立即拼接（同 标准库/字符串.心）。
//     宿主链字符串为裸 char*、生产者共享静态缓冲，同时持有两个结果会互相覆盖（自举链因胖字符串
//     拷贝而无此现象）；即取即拼使两链行为一致。

// 表内下标（0..63）→ Base64 字符；下标非法或为填充位时归返 "="
函数 (下标:整数)Base64字符("=" = 结果:字符串) {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" = 表;
    如果 (下标 >= 0) {
        如果 (下标 < 64) {
            (表, 下标)字符码 = 码;
            (码)字符 = 结果;
        }
    }
}

// 码点 → 表内下标（0..63）；非本表字符（含 '='）归返 64（越界哨兵，输出参数初值须为字面量）
函数 (码:整数)Base64值(64 = 结果:整数) {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" = 表;
    0 = i;
    当 (i < 64) {
        (表, i)字符码 = 表码;
        如果 (表码 ?= 码) { i = 结果; }
        i + 1 = i;
    }
}

// Base64 编码（RFC 4648 标准表，'=' 填充）
函数 (数据:字符串)Base64编码("" = 结果:字符串) {
    (数据)长度 = 总长;
    "" = 输出;
    0 = i;
    当 (i < 总长) {
        总长 - i = 剩余;
        0 = b0;
        0 = b1;
        0 = b2;
        (数据, i)字符码 = b0;
        如果 (i + 1 < 总长) { (数据, i + 1)字符码 = b1; }
        如果 (i + 2 < 总长) { (数据, i + 2)字符码 = b2; }
        b0 / 4 = i0;
        (b0 % 4) * 16 + b1 / 16 = i1;
        (b1 % 16) * 4 + b2 / 64 = i2;
        b2 % 64 = i3;
        // 即取即拼（同 标准库/字符串.心）：同一时刻只持有一个 字符 结果，
        // 避免宿主链裸 char* 共享静态缓冲导致相邻结果互相覆盖。
        (i0)Base64字符 = c0;
        (输出, c0)拼接 = 输出;
        (i1)Base64字符 = c1;
        (输出, c1)拼接 = 输出;
        如果 (剩余 >= 2) {
            (i2)Base64字符 = c2;
            (输出, c2)拼接 = 输出;
        } 否则 {
            (输出, "=")拼接 = 输出;
        }
        如果 (剩余 >= 3) {
            (i3)Base64字符 = c3;
            (输出, c3)拼接 = 输出;
        } 否则 {
            (输出, "=")拼接 = 输出;
        }
        i + 3 = i;
    }
    输出 = 结果;
}

// Base64 解码（忽略末尾不足 4 字符的残片；'=' 与非法字符按填充处理）
函数 (编码:字符串)Base64解码("" = 结果:字符串) {
    (编码)长度 = 总长;
    "" = 输出;
    0 = i;
    当 (i + 3 < 总长) {
        (编码, i)字符码 = p0;
        (编码, i + 1)字符码 = p1;
        (编码, i + 2)字符码 = p2;
        (编码, i + 3)字符码 = p3;
        (p0)Base64值 = v0;
        (p1)Base64值 = v1;
        (p2)Base64值 = v2;
        (p3)Base64值 = v3;
        3 = 字节数;
        如果 (p2 ?= 61) { 1 = 字节数; }
        否则如果 (p3 ?= 61) { 2 = 字节数; }
        v0 * 4 + v1 / 16 = b0;
        (v1 % 16) * 16 + v2 / 4 = b1;
        (v2 % 4) * 64 + v3 = b2;
        (b0)字符 = 字符0;
        (输出, 字符0)拼接 = 输出;
        如果 (字节数 >= 2) {
            (b1)字符 = 字符1;
            (输出, 字符1)拼接 = 输出;
        }
        如果 (字节数 >= 3) {
            (b2)字符 = 字符2;
            (输出, 字符2)拼接 = 输出;
        }
        i + 4 = i;
    }
    输出 = 结果;
}

// 半字节（0..15）→ 十六进制字符；越界归返 "?"
函数 (值:整数)十六进制字符("?" = 结果:字符串) {
    "0123456789abcdef" = 表;
    如果 (值 < 16) {
        (表, 值)字符码 = 码;
        (码)字符 = 结果;
    }
}

// 十六进制字符码 → 半字节值（0..15）；非法归返 16（越界哨兵）
函数 (码:整数)十六进制值(16 = 结果:整数) {
    0 = i;
    当 (i < 10) {
        如果 (48 + i ?= 码) { i = 结果; }
        i + 1 = i;
    }
    0 = j;
    当 (j < 6) {
        如果 (97 + j ?= 码) { 10 + j = 结果; }
        如果 (65 + j ?= 码) { 10 + j = 结果; }
        j + 1 = j;
    }
}

// 字符串 → 小写十六进制（每码点两位，低位在前）
函数 (数据:字符串)转十六进制("" = 结果:字符串) {
    (数据)长度 = 总长;
    "" = 输出;
    0 = i;
    当 (i < 总长) {
        (数据, i)字符码 = 码;
        码 / 16 = 高;
        码 % 16 = 低;
        (高)十六进制字符 = 高字符;
        (输出, 高字符)拼接 = 输出;
        (低)十六进制字符 = 低字符;
        (输出, 低字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 十六进制 → 字符串（每两位一码点；非法位按 0 处理；末尾奇数位忽略）
函数 (文本:字符串)十六进制转("" = 结果:字符串) {
    (文本)长度 = 总长;
    "" = 输出;
    0 = i;
    当 (i + 1 < 总长) {
        (文本, i)字符码 = 高码;
        (文本, i + 1)字符码 = 低码;
        (高码)十六进制值 = 高;
        (低码)十六进制值 = 低;
        如果 (高 > 15) { 0 = 高; }
        如果 (低 > 15) { 0 = 低; }
        高 * 16 + 低 = 字节;
        (字节)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i + 2 = i;
    }
    输出 = 结果;
}