// 日月标准库 - 正则表达式封装
//
// 8AX：在原有「定长逐字符」匹配器基础上，改为**递归回溯**匹配器，新增量词 `*`（0+）/`+`（1+）/`?`（0/1），
//      贪婪匹配 + 失败回溯；并修正 `正则查找` 原「返回末次匹配（且受窗口长度约束）」缺陷为「返回首个匹配起始下标」。
// 8AY：新增**字符类** `[...]`（含范围 `a-z`、否定 `[^...]`）与**锚点** `^`（行首/串首）/`$`（串尾）；
//      内部匹配器由 8AX 的「单整数种类」重构为「原子跨度 [原子起, 原子终)」表示（`正则原子`/`正则原子命中`/`正则类命中`）。
//
// 支持：字面量、`.`（任意字符）、`\d`/`\w`/`\s`、字符类 `[...]`（范围/否定）、量词 `*`/`+`/`?`、锚点 `^`/`$`。
// 不支持：分组 `(...)`、或 `|`、区间量词 `{m,n}`、非贪婪 `*?`、字符类内转义（如 `[\d]`）。

// ---------------------------------------------------------------------------
// 原子表示：以「模式串下标跨度 [原子起, 原子终)」表示一个原子（**不含**尾部量词）
//   · 空跨度（原子起 >= 原子终）表示模式耗尽
//   · 首字节 `.`（46）   → 任意字符
//   · 首字节 `\`（92）   → 转义类 `\d`/`\w`/`\s` 或转义字面
//   · 首字节 `[`（91）   → 字符类（扫描至 `]`）
//   · 其余               → 字面字符
// ---------------------------------------------------------------------------

// 解析模式中 模位 处的原子 → (原子起, 原子终, 下一模位)
//   原子起 = 原子首字节下标；原子终 = 原子末字节后一位（不含量词）；下一模位 = 含量词后的下标
函数 (模:字符串, 模位:整数)正则原子(0 = 原子起:整数, 0 = 原子终:整数, 0 = 下一模位:整数) {
    0 = 模长;
    0 = 起;
    0 = 终;
    0 = 码;
    0 = 停;
    (模)长度 = 模长;
    模位 = 起;
    如果 (模位 >= 模长) {
        起 = 原子起;
        起 = 原子终;
        起 = 下一模位;
    } 否则 {
        (模, 模位)字符码 = 码;
        如果 (码 ?= 92) {
            如果 (模位 + 1 < 模长) {
                模位 + 2 = 终;
            } 否则 {
                模位 + 1 = 终;
            }
        } 否则如果 (码 ?= 91) {
            模位 + 1 = 终;
            0 = 停;
            当 (停 ?= 0) {
                如果 (终 < 模长) {
                    (模, 终)字符码 = 码;
                    如果 (码 ?= 93) {
                        终 + 1 = 终;
                        1 = 停;
                    } 否则 {
                        终 + 1 = 终;
                    }
                } 否则 {
                    1 = 停;
                }
            }
        } 否则 {
            模位 + 1 = 终;
        }
        起 = 原子起;
        终 = 原子终;
        如果 (终 < 模长) {
            (模, 终)字符码 = 码;
            如果 (码 ?= 42 || 码 ?= 43 || 码 ?= 63) {
                终 + 1 = 下一模位;
            } 否则 {
                终 = 下一模位;
            }
        } 否则 {
            终 = 下一模位;
        }
    }
}

// 字符类命中：模[类起, 类终) 形如 '[' ... ']'（类起 = '[' 下标，类终 = ']' 后一位）
//   支持范围 `a-z`（首字符后紧跟 `-` 且其后仍有字符）与前导否定 `[^...]`
函数 (模:字符串, 类起:整数, 类终:整数, 文本码:整数)正则类命中(0 = 命中:整数) {
    0 = i;
    0 = 上界;
    0 = 取反;
    0 = 码;
    0 = 码2;
    0 = 码3;
    0 = 停;
    类终 - 1 = 上界;
    类起 + 1 = i;
    如果 (i < 上界) {
        (模, i)字符码 = 码;
        如果 (码 ?= 94) {
            1 = 取反;
            i + 1 = i;
        }
    }
    0 = 停;
    当 (停 ?= 0) {
        如果 (i < 上界) {
            (模, i)字符码 = 码;
            如果 (i + 2 < 上界) {
                (模, i + 1)字符码 = 码2;
                如果 (码2 ?= 45) {
                    (模, i + 2)字符码 = 码3;
                    如果 (文本码 >= 码 && 文本码 <= 码3) { 1 = 命中; }
                    i + 3 = i;
                } 否则 {
                    如果 (文本码 ?= 码) { 1 = 命中; }
                    i + 1 = i;
                }
            } 否则 {
                如果 (文本码 ?= 码) { 1 = 命中; }
                i + 1 = i;
            }
        } 否则 {
            1 = 停;
        }
    }
    如果 (取反 ?= 1) {
        如果 (命中 ?= 1) { 0 = 命中; } 否则 { 1 = 命中; }
    }
}

// 判断 文本码 是否命中 模[原子起, 原子终) 表示的原子（空跨度不命中）
函数 (模:字符串, 原子起:整数, 原子终:整数, 文本码:整数)正则原子命中(0 = 命中:整数) {
    0 = 码;
    0 = 类;
    如果 (原子起 >= 原子终) {
    } 否则 {
        (模, 原子起)字符码 = 码;
        如果 (码 ?= 46) {
            1 = 命中;
        } 否则如果 (码 ?= 92) {
            (模, 原子起 + 1)字符码 = 类;
            如果 (类 ?= 100) {
                如果 (文本码 >= 48 && 文本码 <= 57) { 1 = 命中; }
            } 否则如果 (类 ?= 119) {
                如果 (文本码 >= 48 && 文本码 <= 57) { 1 = 命中; }
                否则如果 (文本码 >= 65 && 文本码 <= 90) { 1 = 命中; }
                否则如果 (文本码 >= 97 && 文本码 <= 122) { 1 = 命中; }
            } 否则如果 (类 ?= 115) {
                如果 (文本码 ?= 32) { 1 = 命中; }
                否则如果 (文本码 ?= 9) { 1 = 命中; }
                否则如果 (文本码 ?= 10) { 1 = 命中; }
                否则如果 (文本码 ?= 13) { 1 = 命中; }
            } 否则 {
                如果 (文本码 ?= 类) { 1 = 命中; }
            }
        } 否则如果 (码 ?= 91) {
            (模, 原子起, 原子终, 文本码)正则类命中 = 命中;
        } 否则 {
            如果 (文本码 ?= 码) { 1 = 命中; }
        }
    }
}

// 从 文位/模位 起，模式能否完全匹配文本（贪婪量词 + 失败回溯）
//   命中=1 表示「模式已全部消费且沿途匹配」，文本可有剩余（子串匹配语义；`$` 锚点除外）。
//   尾锚点 `$`：当 模位 指向模式最后一个字符且为 `$` 时，要求 文位 = 文长。
函数 (文本:字符串, 模:字符串, 文位:整数, 模位:整数)正则从(0 = 命中:整数) {
    0 = 模长;
    0 = 文长;
    0 = 原子起;
    0 = 原子终;
    0 = 下一模位;
    0 = 量词码;
    0 = 量词;
    0 = 后模位;
    0 = 文本码;
    0 = 原子中;
    0 = 子;
    0 = 试位;
    0 = 试码;
    0 = 限次;
    0 = 下界;
    0 = k;
    0 = 停;
    0 = 已中;
    0 = 锚码;
    0 = 锚;
    (模)长度 = 模长;
    (文本)长度 = 文长;

    如果 (模位 >= 模长) {
        1 = 命中;
    } 否则 {
        0 = 锚;
        如果 (模位 ?= 模长 - 1) {
            (模, 模位)字符码 = 锚码;
            如果 (锚码 ?= 36) { 1 = 锚; }
        }
        如果 (锚 ?= 1) {
            如果 (文位 ?= 文长) { 1 = 命中; }
        } 否则 {
            (模, 模位)正则原子 = (原子起, 原子终, 下一模位);
            如果 (原子起 >= 原子终) {
                1 = 命中;
            } 否则 {
                0 = 量词;
                如果 (下一模位 > 原子终) {
                    (模, 原子终)字符码 = 量词码;
                    如果 (量词码 ?= 42) { 1 = 量词; }
                    否则如果 (量词码 ?= 43) { 2 = 量词; }
                    否则如果 (量词码 ?= 63) { 3 = 量词; }
                }
                下一模位 = 后模位;

                如果 (量词 ?= 0) {
                    // 无量词：单次匹配即前进
                    如果 (文位 < 文长) {
                        (文本, 文位)字符码 = 文本码;
                        (模, 原子起, 原子终, 文本码)正则原子命中 = 原子中;
                        如果 (原子中 ?= 1) {
                            (文本, 模, 文位 + 1, 后模位)正则从 = 子;
                            如果 (子 ?= 1) { 1 = 命中; }
                        }
                    }
                } 否则如果 (量词 ?= 3) {
                    // '?'：先试 1 次，失败再试 0 次
                    0 = 已中;
                    如果 (文位 < 文长) {
                        (文本, 文位)字符码 = 文本码;
                        (模, 原子起, 原子终, 文本码)正则原子命中 = 原子中;
                        如果 (原子中 ?= 1) {
                            (文本, 模, 文位 + 1, 后模位)正则从 = 子;
                            如果 (子 ?= 1) { 1 = 命中; 1 = 已中; }
                        }
                    }
                    如果 (已中 ?= 0) {
                        (文本, 模, 文位, 后模位)正则从 = 子;
                        如果 (子 ?= 1) { 1 = 命中; }
                    }
                } 否则 {
                    // '*' 或 '+'：贪婪统计最大连续命中数，再由多到少回溯
                    0 = 下界;
                    如果 (量词 ?= 2) { 1 = 下界; }
                    0 = 限次;
                    文位 = 试位;
                    0 = 停;
                    当 (停 ?= 0) {
                        如果 (试位 < 文长) {
                            (文本, 试位)字符码 = 试码;
                            (模, 原子起, 原子终, 试码)正则原子命中 = 原子中;
                            如果 (原子中 ?= 1) {
                                试位 + 1 = 试位;
                                限次 + 1 = 限次;
                            } 否则 {
                                1 = 停;
                            }
                        } 否则 {
                            1 = 停;
                        }
                    }
                    如果 (限次 >= 下界) {
                        限次 = k;
                        0 = 停;
                        当 (停 ?= 0) {
                            (文本, 模, 文位 + k, 后模位)正则从 = 子;
                            如果 (子 ?= 1) {
                                1 = 命中;
                                1 = 停;
                            } 否则 {
                                如果 (k <= 下界) {
                                    1 = 停;
                                } 否则 {
                                    k - 1 = k;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 正则匹配：文本中是否存在从某起始位置起完全匹配模式的子串
//   · 模式以 `^` 开头时**仅**从下标 0 起尝试（串首锚）
//   · 模式以 `$` 结尾时由 `正则从` 要求匹配至文本末尾（串尾锚）
函数 (文本:字符串, 模式:字符串)正则匹配(0 = 结果:整数) {
    0 = 文长;
    0 = 模长;
    0 = 起始;
    0 = 停;
    0 = 子;
    0 = 码;
    0 = 锚首;
    0 = 模位起;
    0 = 只试零;
    (文本)长度 = 文长;
    (模式)长度 = 模长;
    0 = 起始;
    0 = 停;
    0 = 锚首;
    0 = 模位起;
    0 = 只试零;
    如果 (模长 > 0) {
        (模式, 0)字符码 = 码;
        如果 (码 ?= 94) { 1 = 锚首; }
    }
    如果 (锚首 ?= 1) {
        1 = 模位起;
        1 = 只试零;
    }
    当 (停 ?= 0) {
        如果 (起始 <= 文长) {
            (文本, 模式, 起始, 模位起)正则从 = 子;
            如果 (子 ?= 1) {
                1 = 结果;
                1 = 停;
            } 否则 {
                如果 (只试零 ?= 1) {
                    1 = 停;
                } 否则 {
                    起始 + 1 = 起始;
                }
            }
        } 否则 {
            1 = 停;
        }
    }
}

// 正则查找：返回首个匹配起始下标；未命中 -1
//   （8AX 由「末次匹配且受窗口约束」修正为「首个匹配」；8AY 支持 `^`/`$` 锚点）
函数 (文本:字符串, 模式:字符串)正则查找(-1 = 结果:整数) {
    0 = 文长;
    0 = 模长;
    0 = 起始;
    0 = 停;
    0 = 子;
    0 = 码;
    0 = 锚首;
    0 = 模位起;
    0 = 只试零;
    (文本)长度 = 文长;
    (模式)长度 = 模长;
    0 = 起始;
    0 = 停;
    0 = 锚首;
    0 = 模位起;
    0 = 只试零;
    如果 (模长 > 0) {
        (模式, 0)字符码 = 码;
        如果 (码 ?= 94) { 1 = 锚首; }
    }
    如果 (锚首 ?= 1) {
        1 = 模位起;
        1 = 只试零;
    }
    当 (停 ?= 0) {
        如果 (起始 <= 文长) {
            (文本, 模式, 起始, 模位起)正则从 = 子;
            如果 (子 ?= 1) {
                起始 = 结果;
                1 = 停;
            } 否则 {
                如果 (只试零 ?= 1) {
                    1 = 停;
                } 否则 {
                    起始 + 1 = 起始;
                }
            }
        } 否则 {
            1 = 停;
        }
    }
}
