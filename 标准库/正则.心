函数 (文本:字符串, 模式:字符串)正则匹配(0 = 结果:整数) {
    (文本)长度 = 文本长度;
    (模式)长度 = 模式长度;
    
    如果 (模式长度 ?= 0) { 1 = 结果; }
    
    0 = 文本位置;
    当 (文本位置 <= 文本长度 - 模式长度) {
        1 = 匹配成功;
        0 = 模式位置;
        当 (模式位置 < 模式长度) {
            (文本, 文本位置 + 模式位置)字符码 = 文本码;
            (模式, 模式位置)字符码 = 模式码;
            
            如果 (模式码 ?= 46) { // '.'
            } 否则如果 (模式码 ?= 92) { // '\'
                模式位置 + 1 = 模式位置;
                如果 (模式位置 < 模式长度) {
                    (模式, 模式位置)字符码 = 转义码;
                    如果 (转义码 ?= 100) { // 'd'
                        如果 (文本码 < 48 || 文本码 > 57) { 0 = 匹配成功; }
                    } 否则如果 (转义码 ?= 119) { // 'w'
                        如果 (文本码 < 48 || (文本码 > 57 && 文本码 < 65) || (文本码 > 90 && 文本码 < 97) || 文本码 > 122) { 0 = 匹配成功; }
                    } 否则如果 (转义码 ?= 115) { // 's'
                        如果 (文本码 != 32 && 文本码 != 9 && 文本码 != 10 && 文本码 != 13) { 0 = 匹配成功; }
                    } 否则 {
                        如果 (文本码 != 转义码) { 0 = 匹配成功; }
                    }
                }
            } 否则 {
                如果 (文本码 != 模式码) { 0 = 匹配成功; }
            }
            模式位置 + 1 = 模式位置;
        }
        如果 (匹配成功 ?= 1) { 1 = 结果; }
        文本位置 + 1 = 文本位置;
    }
}

