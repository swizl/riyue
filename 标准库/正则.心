// 日月标准库 - 正则表达式封装
//
// 8AX：在原有「定长逐字符」匹配器基础上，新增量词 `*`（0+）/`+`（1+）/`?`（0/1），
//      贪婪匹配 + 失败回溯；并修正 `正则查找` 原「返回末次匹配（且受窗口长度约束）」缺陷为「返回首个匹配起始下标」。
// 8AY：新增**字符类** `[...]`（含范围 `a-z`、否定 `[^...]`）与**锚点** `^`（行首/串首）/`$`（串尾）；
//      内部匹配器统一用「原子跨度 [原子起, 原子终)」表示（`正则原子`/`正则原子命中`/`正则类命中`）。
// 8BB：新增**区间量词** `{m}`（恰好 m 次）/`{m,}`（至少 m 次）/`{m,n}`（m 到 n 次）；
//      将 `*`/`+`/`?` 与区间量词统一归一为「最小次数/最大次数」（最大为 -1 表示无上限）。
// 8BC：字符类支持**类内转义**——`[\d]`/`[\w]`/`[\s]` 预定义类与 `[\x]` 字面转义（消费 2 字节）。
// 8JS：新增**分组** `(...)`（可嵌套）与**或** `|`（顶层或组内）；匹配器改为
//      **显式栈 + 回溯**（`正则试配`）：不调用自身、不形成任何递归，回溯点全部落在显式栈上。
//      · 每个「或」分支、每个量词次数选择都是栈上的一个回溯点；
//      · 分组进入/退出用「上下文栈」记录，嵌套深度不受函数调用栈限制；
//      · 设**步数上限**（`正则步数上限`）作安全阀：极端模式（如 `(a|aa)*b`）超限即判不匹配，
//        不会无限循环、不会耗尽内存。
//      能力边界：无捕获组取值（只判「是否匹配」，不返回子串）、无反向引用 `\1`、无惰性量词 `*?`；
//      可匹配空串的分组（如 `(a?)*`）不做零宽空转迭代。
//
// 支持：字面量、`.`（任意字符）、`\d`/`\w`/`\s`、字符类 `[...]`（范围/否定/类内转义 `[\d]` 等）、
//      量词 `*`/`+`/`?`/`{m}`/`{m,}`/`{m,n}`、锚点 `^`/`$`、分组 `(...)`、或 `|`。
// 说明：区间量词非法或未闭合（如 `a{`、`a{1`）时将该 `{` 退化为字面字符处理，与主流引擎一致；
//      未闭合的 `(` 同样退化为字面字符。

// 回溯步数上限（安全阀）：单次试配超过该步数即判不匹配。
// 正常用例（几十字符的文本与模式）步数远低于该值。
函数 ()正则步数上限(50000 = 上限:整数) {
}

// ---------------------------------------------------------------------------
// 原子表示：以「模式串下标跨度 [原子起, 原子终)」表示一个原子（**不含**尾部量词）
//   · 空跨度（原子起 >= 原子终）表示模式耗尽
//   · 首字节 `.`（46）   → 任意字符
//   · 首字节 `\`（92）   → 转义类 `\d`/`\w`/`\s` 或转义字面
//   · 首字节 `[`（91）   → 字符类（扫描至 `]`）
//   · 首字节 `(`（40）   → 分组（扫描至配对 `)`），组内区间为 [原子起+1, 原子终-1)
//   · 其余               → 字面字符
// ---------------------------------------------------------------------------

// 扫描字符类：起 = '[' 下标，返回 ']' 之后下标（未闭合返回 上界）
函数 (模:字符串, 起:整数, 上界:整数)正则扫类(0 = 结果:整数) {
    0 = 模长;
    0 = i;
    0 = 停;
    0 = 码;
    (模)长度 = 模长;
    起 + 1 = i;
    0 = 停;
    当 (停 ?= 0) {
        如果 (i < 模长 && i < 上界) {
            (模, i)字符码 = 码;
            如果 (码 ?= 92 && i + 1 < 模长 && i + 1 < 上界) {
                i + 2 = i;
            } 否则如果 (码 ?= 93) {
                i + 1 = i;
                1 = 停;
            } 否则 {
                i + 1 = i;
            }
        } 否则 {
            1 = 停;
        }
    }
    i = 结果;
}

// 扫描分组：起 = '(' 下标，返回配对 ')' 之后下标（未闭合返回 起+1，退化为字面 `(`）
//   跳过转义 `\x`（2 字节）、字符类 `[...]`、嵌套分组
函数 (模:字符串, 起:整数, 上界:整数)正则扫组(0 = 结果:整数) {
    0 = 模长;
    0 = i;
    0 = 深;
    0 = 停;
    0 = 有;
    0 = 码;
    0 = 类终;
    (模)长度 = 模长;
    起 + 1 = i;
    1 = 深;
    0 = 停;
    0 = 有;
    当 (停 ?= 0) {
        如果 (i < 模长 && i < 上界) {
            (模, i)字符码 = 码;
            如果 (码 ?= 92) {
                如果 (i + 1 < 模长 && i + 1 < 上界) { i + 2 = i; } 否则 { i + 1 = i; }
            } 否则如果 (码 ?= 91) {
                (模, i, 上界)正则扫类 = 类终;
                类终 = i;
            } 否则如果 (码 ?= 40) {
                深 + 1 = 深;
                i + 1 = i;
            } 否则如果 (码 ?= 41) {
                深 - 1 = 深;
                i + 1 = i;
                如果 (深 ?= 0) { 1 = 有; 1 = 停; }
            } 否则 {
                i + 1 = i;
            }
        } 否则 {
            1 = 停;
        }
    }
    如果 (有 ?= 1) { i = 结果; } 否则 { 起 + 1 = 结果; }
}

// 解析模式中 模位 处的原子 → (原子起, 原子终, 下一模位, 最少, 最多, 组)
//   原子起 = 原子首字节下标；原子终 = 原子末字节后一位（**不含**量词）；下一模位 = 含量词后的下标
//   最少/最多 = 该原子的量词次数下界/上界（最多 = -1 表示无上限）；无量词时均为 1
//   组 = 1 表示该原子是分组 `(...)`（原子终 指向 `)` 之后）
//   量词归一：`*`→(0,-1)  `+`→(1,-1)  `?`→(0,1)  `{m}`→(m,m)  `{m,}`→(m,-1)  `{m,n}`→(m,n)
//   非法/未闭合区间量词（`{` 后无 `m` 或无 `}`）退化为「无区间量词」，`{` 作为后续字面原子
函数 (模:字符串, 模位:整数)正则原子(0 = 原子起:整数, 0 = 原子终:整数, 0 = 下一模位:整数, 0 = 最少:整数, 0 = 最多:整数, 0 = 组:整数) {
    0 = 模长;
    0 = 起;
    0 = 终;
    0 = 码;
    0 = 停;
    0 = 扫;
    0 = 值;
    0 = 有数;
    0 = 数;
    0 = 有数2;
    0 = 好;
    0 = 组;
    (模)长度 = 模长;
    模位 = 起;
    如果 (模位 >= 模长) {
        起 = 原子起;
        起 = 原子终;
        起 = 下一模位;
        1 = 最少;
        1 = 最多;
    } 否则 {
        (模, 模位)字符码 = 码;
        如果 (码 ?= 40) {
            (模, 模位, 模长)正则扫组 = 终;
            如果 (终 > 模位 + 1) {
                1 = 组;
            } 否则 {
                // 未闭合：退化为字面 `(`
                模位 + 1 = 终;
            }
        } 否则如果 (码 ?= 92) {
            如果 (模位 + 1 < 模长) {
                模位 + 2 = 终;
            } 否则 {
                模位 + 1 = 终;
            }
        } 否则如果 (码 ?= 91) {
            (模, 模位, 模长)正则扫类 = 终;
        } 否则 {
            模位 + 1 = 终;
        }
        起 = 原子起;
        终 = 原子终;
        // 默认量词：恰好一次
        1 = 最少;
        1 = 最多;
        终 = 下一模位;
        如果 (终 < 模长) {
            (模, 终)字符码 = 码;
            如果 (码 ?= 42) {
                0 = 最少;
                -1 = 最多;
                终 + 1 = 下一模位;
            } 否则如果 (码 ?= 43) {
                1 = 最少;
                -1 = 最多;
                终 + 1 = 下一模位;
            } 否则如果 (码 ?= 63) {
                0 = 最少;
                1 = 最多;
                终 + 1 = 下一模位;
            } 否则如果 (码 ?= 123) {
                // 区间量词 {m} / {m,} / {m,n}
                0 = 好;
                终 + 1 = 扫;
                0 = 值;
                0 = 有数;
                0 = 停;
                当 (停 ?= 0) {
                    如果 (扫 < 模长) {
                        (模, 扫)字符码 = 码;
                        如果 (码 >= 48 && 码 <= 57) {
                            值 * 10 + 码 - 48 = 值;
                            扫 + 1 = 扫;
                            1 = 有数;
                        } 否则 {
                            1 = 停;
                        }
                    } 否则 {
                        1 = 停;
                    }
                }
                如果 (有数 ?= 1 && 扫 < 模长) {
                    (模, 扫)字符码 = 码;
                    如果 (码 ?= 125) {
                        // {m}
                        值 = 最少;
                        值 = 最多;
                        扫 + 1 = 下一模位;
                        1 = 好;
                    } 否则如果 (码 ?= 44) {
                        // {m,} 或 {m,n}
                        扫 + 1 = 扫;
                        0 = 数;
                        0 = 有数2;
                        0 = 停;
                        当 (停 ?= 0) {
                            如果 (扫 < 模长) {
                                (模, 扫)字符码 = 码;
                                如果 (码 >= 48 && 码 <= 57) {
                                    数 * 10 + 码 - 48 = 数;
                                    扫 + 1 = 扫;
                                    1 = 有数2;
                                } 否则 {
                                    1 = 停;
                                }
                            } 否则 {
                                1 = 停;
                            }
                        }
                        如果 (扫 < 模长) {
                            (模, 扫)字符码 = 码;
                            如果 (码 ?= 125) {
                                值 = 最少;
                                如果 (有数2 ?= 1) { 数 = 最多; } 否则 { -1 = 最多; }
                                扫 + 1 = 下一模位;
                                1 = 好;
                            }
                        }
                    }
                }
                如果 (好 ?= 0) {
                    // 非法/未闭合：退回「恰好一次」，`{` 留给后续字面原子
                    1 = 最少;
                    1 = 最多;
                }
            }
        }
    }
}

// 字符类命中：模[类起, 类终) 形如 '[' ... ']'（类起 = '[' 下标，类终 = ']' 后一位）
//   支持范围 `a-z`（首字符后紧跟 `-` 且其后仍有字符）、前导否定 `[^...]`、类内转义 `\d`/`\w`/`\s` 与 `\x`
函数 (模:字符串, 类起:整数, 类终:整数, 文本码:整数)正则类命中(0 = 命中:整数) {
    0 = i;
    0 = 上界;
    0 = 取反;
    0 = 码;
    0 = 码2;
    0 = 码3;
    0 = 停;
    类终 - 1 = 上界;
    类起 + 1 = i;
    如果 (i < 上界) {
        (模, i)字符码 = 码;
        如果 (码 ?= 94) {
            1 = 取反;
            i + 1 = i;
        }
    }
    0 = 停;
    当 (停 ?= 0) {
        如果 (i < 上界) {
            (模, i)字符码 = 码;
            如果 (码 ?= 92 && i + 1 < 上界) {
                // 类内转义：`\d`/`\w`/`\s` 预定义类，或 `\x` 字面转义（消费 2 字节）
                (模, i + 1)字符码 = 码2;
                如果 (码2 ?= 100) {
                    如果 (文本码 >= 48 && 文本码 <= 57) { 1 = 命中; }
                } 否则如果 (码2 ?= 119) {
                    如果 (文本码 >= 48 && 文本码 <= 57) { 1 = 命中; }
                    否则如果 (文本码 >= 65 && 文本码 <= 90) { 1 = 命中; }
                    否则如果 (文本码 >= 97 && 文本码 <= 122) { 1 = 命中; }
                } 否则如果 (码2 ?= 115) {
                    如果 (文本码 ?= 32) { 1 = 命中; }
                    否则如果 (文本码 ?= 9) { 1 = 命中; }
                    否则如果 (文本码 ?= 10) { 1 = 命中; }
                    否则如果 (文本码 ?= 13) { 1 = 命中; }
                } 否则 {
                    如果 (文本码 ?= 码2) { 1 = 命中; }
                }
                i + 2 = i;
            } 否则如果 (i + 2 < 上界) {
                (模, i + 1)字符码 = 码2;
                如果 (码2 ?= 45) {
                    (模, i + 2)字符码 = 码3;
                    如果 (文本码 >= 码 && 文本码 <= 码3) { 1 = 命中; }
                    i + 3 = i;
                } 否则 {
                    如果 (文本码 ?= 码) { 1 = 命中; }
                    i + 1 = i;
                }
            } 否则 {
                如果 (文本码 ?= 码) { 1 = 命中; }
                i + 1 = i;
            }
        } 否则 {
            1 = 停;
        }
    }
    如果 (取反 ?= 1) {
        如果 (命中 ?= 1) { 0 = 命中; } 否则 { 1 = 命中; }
    }
}

