// 日月标准库 - 正则表达式封装
//
// 8AX：在原有「定长逐字符」匹配器基础上，改为**递归回溯**匹配器，新增量词 `*`（0+）/`+`（1+）/`?`（0/1），
//      贪婪匹配 + 失败回溯；并修正 `正则查找` 原「返回末次匹配（且受窗口长度约束）」缺陷为「返回首个匹配起始下标」。
//
// 支持：字面量、`.`（任意字符）、`\d`/`\w`/`\s`（转义类）、量词 `*`/`+`/`?`。
// 不支持：字符类 `[...]`、分组 `(...)`、或 `|`、锚点 `^`/`$`、`\d{2,3}` 等区间量词。

// 原子种类编码（取负值避开码点区间，避免与字面字符码冲突）：
//   -1 = 无原子（模式耗尽 / 悬空反斜杠）
//   -2 = '.' 任意字符
//   -3 = '\d' 数字
//   -4 = '\w' 单词字符（[0-9A-Za-z]，与旧实现一致，**不含**下划线）
//   -5 = '\s' 空白
//   >=0 = 字面字符码

// 原子是否命中给定文本码点
函数 (种类:整数, 文本码:整数)正则原子命中(0 = 命中:整数) {
    如果 (种类 ?= -1) {
    } 否则如果 (种类 ?= -2) {
        1 = 命中;
    } 否则如果 (种类 ?= -3) {
        如果 (文本码 >= 48 && 文本码 <= 57) { 1 = 命中; }
    } 否则如果 (种类 ?= -4) {
        如果 (文本码 >= 48 && 文本码 <= 57) { 1 = 命中; }
        否则如果 (文本码 >= 65 && 文本码 <= 90) { 1 = 命中; }
        否则如果 (文本码 >= 97 && 文本码 <= 122) { 1 = 命中; }
    } 否则如果 (种类 ?= -5) {
        如果 (文本码 ?= 32) { 1 = 命中; }
        否则如果 (文本码 ?= 9) { 1 = 命中; }
        否则如果 (文本码 ?= 10) { 1 = 命中; }
        否则如果 (文本码 ?= 13) { 1 = 命中; }
    } 否则 {
        如果 (文本码 ?= 种类) { 1 = 命中; }
    }
}

// 解析模式中 模位 处的原子 → (种类, 下一模位)
函数 (模:字符串, 模位:整数)正则原子(-1 = 种类:整数, 0 = 下一模位:整数) {
    0 = 模长;
    (模)长度 = 模长;
    如果 (模位 >= 模长) {
        -1 = 种类;
        模位 = 下一模位;
    } 否则 {
        (模, 模位)字符码 = 当前码;
        如果 (当前码 ?= 92) {
            如果 (模位 + 1 < 模长) {
                (模, 模位 + 1)字符码 = 转义码;
                如果 (转义码 ?= 100) { -3 = 种类; }
                否则如果 (转义码 ?= 119) { -4 = 种类; }
                否则如果 (转义码 ?= 115) { -5 = 种类; }
                否则 { 转义码 = 种类; }
                模位 + 2 = 下一模位;
            } 否则 {
                -1 = 种类;
                模长 = 下一模位;
            }
        } 否则如果 (当前码 ?= 46) {
            -2 = 种类;
            模位 + 1 = 下一模位;
        } 否则 {
            当前码 = 种类;
            模位 + 1 = 下一模位;
        }
    }
}

// 从 文位/模位 起，模式能否完全匹配文本（贪婪量词 + 失败回溯）
//   命中=1 表示「模式已全部消费且沿途匹配」，文本可有剩余（子串匹配语义）。
函数 (文本:字符串, 模:字符串, 文位:整数, 模位:整数)正则从(0 = 命中:整数) {
    0 = 模长;
    0 = 文长;
    0 = 种类;
    0 = 下一模位;
    0 = 量词码;
    0 = 量词;
    0 = 后模位;
    0 = 文本码;
    0 = 原子中;
    0 = 子;
    0 = 试位;
    0 = 试码;
    0 = 限次;
    0 = 下界;
    0 = k;
    0 = 停;
    0 = 已中;
    (模)长度 = 模长;
    (文本)长度 = 文长;

    如果 (模位 >= 模长) {
        1 = 命中;
    } 否则 {
        (模, 模位)正则原子 = (种类, 下一模位);
        如果 (种类 ?= -1) {
            1 = 命中;
        } 否则 {
            0 = 量词;
            如果 (下一模位 < 模长) {
                (模, 下一模位)字符码 = 量词码;
                如果 (量词码 ?= 42) { 1 = 量词; }
                否则如果 (量词码 ?= 43) { 2 = 量词; }
                否则如果 (量词码 ?= 63) { 3 = 量词; }
            }
            如果 (量词 ?= 0) {
                下一模位 = 后模位;
            } 否则 {
                下一模位 + 1 = 后模位;
            }

            如果 (量词 ?= 0) {
                // 无量词：单次匹配即前进
                如果 (文位 < 文长) {
                    (文本, 文位)字符码 = 文本码;
                    (种类, 文本码)正则原子命中 = 原子中;
                    如果 (原子中 ?= 1) {
                        (文本, 模, 文位 + 1, 后模位)正则从 = 子;
                        如果 (子 ?= 1) { 1 = 命中; }
                    }
                }
            } 否则如果 (量词 ?= 3) {
                // '?'：先试 1 次，失败再试 0 次
                0 = 已中;
                如果 (文位 < 文长) {
                    (文本, 文位)字符码 = 文本码;
                    (种类, 文本码)正则原子命中 = 原子中;
                    如果 (原子中 ?= 1) {
                        (文本, 模, 文位 + 1, 后模位)正则从 = 子;
                        如果 (子 ?= 1) { 1 = 命中; 1 = 已中; }
                    }
                }
                如果 (已中 ?= 0) {
                    (文本, 模, 文位, 后模位)正则从 = 子;
                    如果 (子 ?= 1) { 1 = 命中; }
                }
            } 否则 {
                // '*' 或 '+'：贪婪统计最大连续命中数，再由多到少回溯
                0 = 下界;
                如果 (量词 ?= 2) { 1 = 下界; }
                0 = 限次;
                文位 = 试位;
                0 = 停;
                当 (停 ?= 0) {
                    如果 (试位 < 文长) {
                        (文本, 试位)字符码 = 试码;
                        (种类, 试码)正则原子命中 = 原子中;
                        如果 (原子中 ?= 1) {
                            试位 + 1 = 试位;
                            限次 + 1 = 限次;
                        } 否则 {
                            1 = 停;
                        }
                    } 否则 {
                        1 = 停;
                    }
                }
                如果 (限次 >= 下界) {
                    限次 = k;
                    0 = 停;
                    当 (停 ?= 0) {
                        (文本, 模, 文位 + k, 后模位)正则从 = 子;
                        如果 (子 ?= 1) {
                            1 = 命中;
                            1 = 停;
                        } 否则 {
                            如果 (k <= 下界) {
                                1 = 停;
                            } 否则 {
                                k - 1 = k;
                            }
                        }
                    }
                }
            }
        }
    }
}

// 正则匹配：文本中是否存在从某起始位置起完全匹配模式的子串
函数 (文本:字符串, 模式:字符串)正则匹配(0 = 结果:整数) {
    0 = 文长;
    0 = 起始;
    0 = 停;
    0 = 子;
    (文本)长度 = 文长;
    0 = 起始;
    0 = 停;
    当 (停 ?= 0) {
        如果 (起始 <= 文长) {
            (文本, 模式, 起始, 0)正则从 = 子;
            如果 (子 ?= 1) {
                1 = 结果;
                1 = 停;
            } 否则 {
                起始 + 1 = 起始;
            }
        } 否则 {
            1 = 停;
        }
    }
}

// 正则查找：返回首个匹配起始下标；未命中 -1
//   （旧实现返回「末次匹配」且起点受 `文本长度 - 模式长度` 窗口约束，8AX 修正为「首个匹配」）
函数 (文本:字符串, 模式:字符串)正则查找(-1 = 结果:整数) {
    0 = 文长;
    0 = 起始;
    0 = 停;
    0 = 子;
    (文本)长度 = 文长;
    0 = 起始;
    0 = 停;
    当 (停 ?= 0) {
        如果 (起始 <= 文长) {
            (文本, 模式, 起始, 0)正则从 = 子;
            如果 (子 ?= 1) {
                起始 = 结果;
                1 = 停;
            } 否则 {
                起始 + 1 = 起始;
            }
        } 否则 {
            1 = 停;
        }
    }
}
