// 日月标准库 - 二叉搜索树（索引式，泛型元素）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 语言无用户级指针类型（仅 字符串 内部为指针），故采用**索引式**节点：
//       值: T[]    —— 各节点的键
//       左: 整数[] —— 左子下标（-1 表空）
//       右: 整数[] —— 右子下标（-1 表空）
//       根: 整数   —— 根下标（空树为 -1）
//       数量: 整数 —— 节点个数
//     以**下标**代替指针实现链接与下降。
//   · 泛型结构体（同 优先队列/双端队列/链表/哈希集合）：规避自举链对非泛型结构体
//     方法体内 `(成员数组, i)动态数组获取` 与后续方法共存的顺序敏感缺陷。
//   · **非自平衡**（无 AVL/红黑旋转）：最坏 O(n)。**允许重复键**（等值走右）。**无删除**。
//   · 不使用递归方法（泛型结构体上递归风险高），全部用 `当` 循环下降。
// 创建：二叉搜索树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 根: -1, 数量: 0 } = t;

结构体 二叉搜索树<T> {
    值: T[];
    左: 整数[];
    右: 整数[];
    根: 整数;
    数量: 整数;

    // 插入（等值走右，允许重复键）
    方法 插入(值: T) {
        二叉搜索树.数量 = 新下标;
        (二叉搜索树.值, 值)动态数组添加;
        (二叉搜索树.左, -1)动态数组添加;
        (二叉搜索树.右, -1)动态数组添加;
        二叉搜索树.数量 + 1 = 二叉搜索树.数量;
        如果 (二叉搜索树.数量 ?= 1) {
            新下标 = 二叉搜索树.根;
        } 否则 {
            二叉搜索树.根 = 当前;
            0 = 停;
            当 (停 ?= 0) {
                (二叉搜索树.值, 当前)动态数组获取 = 当前值;
                如果 (值 < 当前值) {
                    (二叉搜索树.左, 当前)动态数组获取 = 子;
                    如果 (子 ?= -1) {
                        (二叉搜索树.左, 当前, 新下标)动态数组设置;
                        1 = 停;
                    } 否则 {
                        子 = 当前;
                    }
                } 否则 {
                    (二叉搜索树.右, 当前)动态数组获取 = 子;
                    如果 (子 ?= -1) {
                        (二叉搜索树.右, 当前, 新下标)动态数组设置;
                        1 = 停;
                    } 否则 {
                        子 = 当前;
                    }
                }
            }
        }
    }

    // 是否包含（返回 1 / 0）
    方法 包含(值: T)(0 = 结果: 整数) {
        二叉搜索树.根 = 当前;
        0 = 结果;
        0 = 停;
        当 (停 ?= 0) {
            如果 (当前 ?= -1) {
                1 = 停;
            } 否则 {
                (二叉搜索树.值, 当前)动态数组获取 = 当前值;
                如果 (值 ?= 当前值) {
                    1 = 结果;
                    1 = 停;
                } 否则如果 (值 < 当前值) {
                    (二叉搜索树.左, 当前)动态数组获取 = 子;
                    子 = 当前;
                } 否则 {
                    (二叉搜索树.右, 当前)动态数组获取 = 子;
                    子 = 当前;
                }
            }
        }
    }

    // 最小键（最左叶）；空树行为未定义
    方法 最小()(0 = 结果: T) {
        二叉搜索树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            (二叉搜索树.左, 当前)动态数组获取 = 子;
            如果 (子 ?= -1) {
                1 = 停;
            } 否则 {
                子 = 当前;
            }
        }
        (二叉搜索树.值, 当前)动态数组获取 = 结果;
    }

    // 最大键（最右叶）；空树行为未定义
    方法 最大()(0 = 结果: T) {
        二叉搜索树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            (二叉搜索树.右, 当前)动态数组获取 = 子;
            如果 (子 ?= -1) {
                1 = 停;
            } 否则 {
                子 = 当前;
            }
        }
        (二叉搜索树.值, 当前)动态数组获取 = 结果;
    }

    // 当前节点个数
    方法 长度()(0 = 结果: 整数) {
        二叉搜索树.数量 = 结果;
    }
}