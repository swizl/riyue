// 日月标准库 - 语义化版本（SemVer）
//
// 归属：短板补齐计划 §Phase 2 包管理器 §2.1「语义化版本管理」（首增量）。
// 说明：
//   · 纯 .心 实现，不依赖任何编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 版本号形如 `[v]主.次.修订`（三段十进制，前缀 v/V 可选）；比较按 主→次→修订 逐段。
//   · 约束支持：`=x.y.z`（或省略等号为 x.y.z）、`>x.y.z`、`>=x.y.z`、`<x.y.z`、`<=x.y.z`、
//     `^x.y.z`（兼容，>= 且主相同）、`~x.y.z`（>= 且 主.次 相同）。约束内版本号须三段齐全。
//   · 仅按字符码扫描，不用位或 `|`（表达式位或被管道解析器优先消费）；
//     不使用 `去除空白`（宿主链共享静态缓冲），字符串处理「即取即拼」。
//   · 返回值一律写进「返回标注」位（如 `(0 = 结果:整数)`），不可写成形参。
//   · 限制：不支持预发布/构建元数据（`-alpha`/`+build`）与部分版本号（`^1.2`）；`^`/`~` 采用简化语义。

// 模块版本
函数 ()版本模块版本(0 = 结果:整数) {
    1 = 结果;
}

// 读一段十进制数字：从 起始 起消费连续数字，返回 值 与 新位置（未消费任何数字时 值 为 0）
函数 (文本:字符串, 起始:整数)读数字段(0 = 值:整数, 0 = 新位置:整数) {
    0 = 值;
    起始 = 新位置;
    (文本)长度 = 长度;
    1 = 扫描中;
    当 (扫描中 ?= 1) {
        如果 (新位置 < 长度) {
            (文本, 新位置)字符码 = 码;
            如果 (码 >= 48) {
                如果 (码 <= 57) {
                    值 * 10 = 值;
                    值 + (码 - 48) = 值;
                    新位置 + 1 = 新位置;
                } 否则 {
                    0 = 扫描中;
                }
            } 否则 {
                0 = 扫描中;
            }
        } 否则 {
            0 = 扫描中;
        }
    }
}

// 解析版本号 `[v]主.次.修订` -> (主, 次, 修订, 有效)；三段齐全且三处皆非空数字段时 有效=1
函数 (文本:字符串)版本解析(0 = 主:整数, 0 = 次:整数, 0 = 修订:整数, 0 = 有效:整数) {
    0 = 主;
    0 = 次;
    0 = 修订;
    0 = 有效;
    (文本)长度 = 长度;
    0 = 位置;
    如果 (长度 >= 1) {
        (文本, 0)字符码 = 首码;
        如果 (首码 ?= 118) {
            1 = 位置;
        }
        否则如果 (首码 ?= 86) {
            1 = 位置;
        }
        位置 = 段起;
        (文本, 位置)读数字段 = (主, 位置);
        如果 (位置 > 段起) {
            如果 (位置 < 长度) {
                (文本, 位置)字符码 = 码1;
                如果 (码1 ?= 46) {
                    位置 + 1 = 位置;
                    位置 = 段起;
                    (文本, 位置)读数字段 = (次, 位置);
                    如果 (位置 > 段起) {
                        如果 (位置 < 长度) {
                            (文本, 位置)字符码 = 码2;
                            如果 (码2 ?= 46) {
                                位置 + 1 = 位置;
                                位置 = 段起;
                                (文本, 位置)读数字段 = (修订, 位置);
                                如果 (位置 > 段起) {
                                    如果 (位置 ?= 长度) {
                                        1 = 有效;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 比较两个版本（各段已解析）：左小返回 -1、相等 0、左大 1
函数 (主1:整数, 次1:整数, 修1:整数, 主2:整数, 次2:整数, 修2:整数)版本比较(0 = 结果:整数) {
    0 = 结果;
    如果 (主1 > 主2) {
        1 = 结果;
    }
    否则如果 (主1 < 主2) {
        0 - 1 = 结果;
    }
    否则如果 (次1 > 次2) {
        1 = 结果;
    }
    否则如果 (次1 < 次2) {
        0 - 1 = 结果;
    }
    否则如果 (修1 > 修2) {
        1 = 结果;
    }
    否则如果 (修1 < 修2) {
        0 - 1 = 结果;
    }
}

// 判定 版本 是否满足 约束：满足返回 1，否则 0
// 约束操作符：`=`/省略（精确）、`>`、`>=`、`<`、`<=`、`^`、`~`
函数 (版本:字符串, 约束:字符串)版本满足约束(0 = 满足:整数) {
    0 = 满足;
    (版本)版本解析 = (主, 次, 修, 版本有效);
    (约束)长度 = 约束长;
    如果 (约束长 ?= 0) {
        0 = 满足;
    } 否则 {
        0 = 起点;
        0 = 类型;
        (约束, 0)字符码 = 码;
        如果 (码 ?= 94) {
            5 = 类型;
            1 = 起点;
        }
        否则如果 (码 ?= 126) {
            6 = 类型;
            1 = 起点;
        }
        否则如果 (码 ?= 62) {
            1 = 类型;
            1 = 起点;
            如果 (约束长 > 1) {
                (约束, 1)字符码 = 码2;
                如果 (码2 ?= 61) {
                    2 = 类型;
                    2 = 起点;
                }
            }
        }
        否则如果 (码 ?= 60) {
            3 = 类型;
            1 = 起点;
            如果 (约束长 > 1) {
                (约束, 1)字符码 = 码3;
                如果 (码3 ?= 61) {
                    4 = 类型;
                    2 = 起点;
                }
            }
        }
        否则如果 (码 ?= 61) {
            0 = 类型;
            1 = 起点;
        }
        (约束, 起点, 约束长 - 起点)子串 = 约束版本;
        (约束版本)版本解析 = (约主, 约次, 约修, 约有效);
        (主, 次, 修, 约主, 约次, 约修)版本比较 = 比较结果;
        如果 (版本有效 ?= 1) {
            如果 (约有效 ?= 1) {
                如果 (类型 ?= 0) {
                    如果 (比较结果 ?= 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 1) {
                    如果 (比较结果 > 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 2) {
                    如果 (比较结果 >= 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 3) {
                    如果 (比较结果 < 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 4) {
                    如果 (比较结果 <= 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 5) {
                    如果 (比较结果 >= 0) {
                        如果 (主 ?= 约主) {
                            1 = 满足;
                        }
                    }
                }
                否则如果 (类型 ?= 6) {
                    如果 (比较结果 >= 0) {
                        如果 (主 ?= 约主) {
                            如果 (次 ?= 约次) {
                                1 = 满足;
                            }
                        }
                    }
                }
            }
        }
    }
}
