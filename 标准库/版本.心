// 日月标准库 - 语义化版本（SemVer）
//
// 归属：短板补齐计划 §Phase 2 包管理器 §2.1「语义化版本管理」（首增量）。
// 说明：
//   · 纯 .心 实现，不依赖任何编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 版本号形如 `[v]主.次.修订`（三段十进制，前缀 v/V 可选）；比较按 主→次→修订 逐段。
//   · 约束支持：`=x.y.z`（或省略等号为 x.y.z）、`>x.y.z`、`>=x.y.z`、`<x.y.z`、`<=x.y.z`、
//     `^x.y.z`（兼容，>= 且主相同）、`~x.y.z`（>= 且 主.次 相同）。约束内版本号须三段齐全。
//   · 仅按字符码扫描，不用位或 `|`（表达式位或被管道解析器优先消费）；
//     不使用 `去除空白`（宿主链共享静态缓冲），字符串处理「即取即拼」。
//   · 返回值一律写进「返回标注」位（如 `(0 = 结果:整数)`），不可写成形参。
//   · 限制：不支持预发布/构建元数据（`-alpha`/`+build`）与部分版本号（`^1.2`）；`^`/`~` 采用简化语义。
//   · 8AZ：新增预发布（`-alpha.1`）解析与**完整优先级比较** `版本优先级比较`（SemVer §11）；构建元数据 `+build` 解析时忽略；
//     但 `版本满足约束`/`版本满足区间` 等**仍按三段数字匹配**（含预发布者在约束匹配中视为不满足，见各函数注释）。

// 模块版本
函数 ()版本模块版本(0 = 结果:整数) {
    4 = 结果;
}

// 读一段十进制数字：从 起始 起消费连续数字，返回 值 与 新位置（未消费任何数字时 值 为 0）
函数 (文本:字符串, 起始:整数)读数字段(0 = 值:整数, 0 = 新位置:整数) {
    0 = 值;
    起始 = 新位置;
    (文本)长度 = 长度;
    1 = 扫描中;
    当 (扫描中 ?= 1) {
        如果 (新位置 < 长度) {
            (文本, 新位置)字符码 = 码;
            如果 (码 >= 48) {
                如果 (码 <= 57) {
                    值 * 10 = 值;
                    值 + (码 - 48) = 值;
                    新位置 + 1 = 新位置;
                } 否则 {
                    0 = 扫描中;
                }
            } 否则 {
                0 = 扫描中;
            }
        } 否则 {
            0 = 扫描中;
        }
    }
}

// 解析版本号 `[v]主.次.修订` -> (主, 次, 修订, 有效)；三段齐全且三处皆非空数字段时 有效=1
函数 (文本:字符串)版本解析(0 = 主:整数, 0 = 次:整数, 0 = 修订:整数, 0 = 有效:整数) {
    0 = 主;
    0 = 次;
    0 = 修订;
    0 = 有效;
    (文本)长度 = 长度;
    0 = 位置;
    如果 (长度 >= 1) {
        (文本, 0)字符码 = 首码;
        如果 (首码 ?= 118) {
            1 = 位置;
        }
        否则如果 (首码 ?= 86) {
            1 = 位置;
        }
        位置 = 段起;
        (文本, 位置)读数字段 = (主, 位置);
        如果 (位置 > 段起) {
            如果 (位置 < 长度) {
                (文本, 位置)字符码 = 码1;
                如果 (码1 ?= 46) {
                    位置 + 1 = 位置;
                    位置 = 段起;
                    (文本, 位置)读数字段 = (次, 位置);
                    如果 (位置 > 段起) {
                        如果 (位置 < 长度) {
                            (文本, 位置)字符码 = 码2;
                            如果 (码2 ?= 46) {
                                位置 + 1 = 位置;
                                位置 = 段起;
                                (文本, 位置)读数字段 = (修订, 位置);
                                如果 (位置 > 段起) {
                                    如果 (位置 ?= 长度) {
                                        1 = 有效;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 比较两个版本（各段已解析）：左小返回 -1、相等 0、左大 1
函数 (主1:整数, 次1:整数, 修1:整数, 主2:整数, 次2:整数, 修2:整数)版本比较(0 = 结果:整数) {
    0 = 结果;
    如果 (主1 > 主2) {
        1 = 结果;
    }
    否则如果 (主1 < 主2) {
        0 - 1 = 结果;
    }
    否则如果 (次1 > 次2) {
        1 = 结果;
    }
    否则如果 (次1 < 次2) {
        0 - 1 = 结果;
    }
    否则如果 (修1 > 修2) {
        1 = 结果;
    }
    否则如果 (修1 < 修2) {
        0 - 1 = 结果;
    }
}

// 判定 版本 是否满足 约束：满足返回 1，否则 0
// 约束操作符：`=`/省略（精确）、`>`、`>=`、`<`、`<=`、`^`、`~`
函数 (版本:字符串, 约束:字符串)版本满足约束(0 = 满足:整数) {
    0 = 满足;
    (版本)版本解析 = (主, 次, 修, 版本有效);
    (约束)长度 = 约束长;
    如果 (约束长 ?= 0) {
        0 = 满足;
    } 否则 {
        0 = 起点;
        0 = 类型;
        (约束, 0)字符码 = 码;
        如果 (码 ?= 94) {
            5 = 类型;
            1 = 起点;
        }
        否则如果 (码 ?= 126) {
            6 = 类型;
            1 = 起点;
        }
        否则如果 (码 ?= 62) {
            1 = 类型;
            1 = 起点;
            如果 (约束长 > 1) {
                (约束, 1)字符码 = 码2;
                如果 (码2 ?= 61) {
                    2 = 类型;
                    2 = 起点;
                }
            }
        }
        否则如果 (码 ?= 60) {
            3 = 类型;
            1 = 起点;
            如果 (约束长 > 1) {
                (约束, 1)字符码 = 码3;
                如果 (码3 ?= 61) {
                    4 = 类型;
                    2 = 起点;
                }
            }
        }
        否则如果 (码 ?= 61) {
            0 = 类型;
            1 = 起点;
        }
        (约束, 起点, 约束长 - 起点)子串 = 约束版本;
        (约束版本)版本解析 = (约主, 约次, 约修, 约有效);
        (主, 次, 修, 约主, 约次, 约修)版本比较 = 比较结果;
        如果 (版本有效 ?= 1) {
            如果 (约有效 ?= 1) {
                如果 (类型 ?= 0) {
                    如果 (比较结果 ?= 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 1) {
                    如果 (比较结果 > 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 2) {
                    如果 (比较结果 >= 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 3) {
                    如果 (比较结果 < 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 4) {
                    如果 (比较结果 <= 0) {
                        1 = 满足;
                    }
                }
                否则如果 (类型 ?= 5) {
                    如果 (比较结果 >= 0) {
                        如果 (主 ?= 约主) {
                            1 = 满足;
                        }
                    }
                }
                否则如果 (类型 ?= 6) {
                    如果 (比较结果 >= 0) {
                        如果 (主 ?= 约主) {
                            如果 (次 ?= 约次) {
                                1 = 满足;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== 8AT：区间约束（逗号 AND）与通配段 ====================
// 语义化版本区间（SemVer ranges 子集）：
//   · 约束版本段支持通配 `x`/`X`/`*`（`1.2.x` ≡ 主.次 相同；`1.x` ≡ 主相同；`x`/`*` ≡ 任意）。
//   · `版本满足区间(版本, 区间)`：区间为逗号分隔的多个子句，**全部满足（AND）→ 1**。
//   · 子句两种形态（不可混用）：① 操作符约束（`>=1.2.0` 等，走 `版本满足约束`）；② 裸通配模式（`1.2.x`）。
//   · 限制：不含 `||`（OR）；不以空格分隔多约束；操作符与通配不可混用；空子句视为不满足。

// 读一个版本段：数字或通配（x=120 / X=88 / *=42）。返回 (值, 是通配, 新位置, 有段)
函数 (文本:字符串, 起始:整数)读版本段(0 = 值:整数, 0 = 通配:整数, 0 = 新位置:整数, 0 = 有段:整数) {
    0 = 值;
    0 = 通配;
    0 = 有段;
    0 = 码;
    起始 = 新位置;
    (文本)长度 = 长度;
    如果 (新位置 < 长度) {
        (文本, 新位置)字符码 = 码;
        如果 (码 ?= 120) {
            1 = 通配;
            1 = 有段;
            新位置 + 1 = 新位置;
        }
        否则如果 (码 ?= 88) {
            1 = 通配;
            1 = 有段;
            新位置 + 1 = 新位置;
        }
        否则如果 (码 ?= 42) {
            1 = 通配;
            1 = 有段;
            新位置 + 1 = 新位置;
        }
        否则如果 (码 >= 48) {
            如果 (码 <= 57) {
                (文本, 新位置)读数字段 = (值, 新位置);
                1 = 有段;
            }
        }
    }
}

// 解析版本/模式 `[v]段[.段[.段]]`（段可为数字或通配）。
// 返回 (主, 次, 修订, 等级, 有效)：等级 0=精确 1=修订通配 2=次通配 3=全通配；无通配时须三段齐全。
函数 (文本:字符串)版本解析通配(0 = 主:整数, 0 = 次:整数, 0 = 修订:整数, 0 = 等级:整数, 0 = 有效:整数) {
    0 = 主;
    0 = 次;
    0 = 修订;
    0 = 等级;
    0 = 有效;
    0 = 首码;
    0 = 点1;
    0 = 点2;
    0 = 段1值;
    0 = 段1通;
    0 = 有1;
    0 = 段2值;
    0 = 段2通;
    0 = 有2;
    0 = 段3值;
    0 = 段3通;
    0 = 有3;
    (文本)长度 = 长度;
    0 = 位置;
    如果 (长度 >= 1) {
        (文本, 0)字符码 = 首码;
        如果 (首码 ?= 118) { 1 = 位置; }
        否则如果 (首码 ?= 86) { 1 = 位置; }
    }
    (文本, 位置)读版本段 = (段1值, 段1通, 位置, 有1);
    如果 (有1 ?= 1) {
        如果 (位置 < 长度) {
            (文本, 位置)字符码 = 点1;
            如果 (点1 ?= 46) {
                位置 + 1 = 位置;
                (文本, 位置)读版本段 = (段2值, 段2通, 位置, 有2);
                如果 (有2 ?= 1) {
                    如果 (位置 < 长度) {
                        (文本, 位置)字符码 = 点2;
                        如果 (点2 ?= 46) {
                            位置 + 1 = 位置;
                            (文本, 位置)读版本段 = (段3值, 段3通, 位置, 有3);
                        }
                    }
                }
            }
        }
        如果 (位置 ?= 长度) {
            如果 (有2 ?= 0) {
                如果 (段1通 ?= 1) {
                    3 = 等级;
                    1 = 有效;
                }
            }
            否则如果 (有3 ?= 0) {
                如果 (段2通 ?= 1) {
                    段1值 = 主;
                    2 = 等级;
                    1 = 有效;
                }
            }
            否则 {
                如果 (段1通 ?= 1) {
                    3 = 等级;
                    1 = 有效;
                }
                否则如果 (段2通 ?= 1) {
                    段1值 = 主;
                    2 = 等级;
                    1 = 有效;
                }
                否则如果 (段3通 ?= 1) {
                    段1值 = 主;
                    段2值 = 次;
                    1 = 等级;
                    1 = 有效;
                }
                否则 {
                    段1值 = 主;
                    段2值 = 次;
                    段3值 = 修订;
                    0 = 等级;
                    1 = 有效;
                }
            }
        }
    }
}

// 文本中是否含通配字符（x/X/*）
函数 (文本:字符串)是否含通配(0 = 含:整数) {
    0 = 含;
    0 = 码;
    0 = i;
    (文本)长度 = 长度;
    当 (i < 长度) {
        如果 (含 ?= 0) {
            (文本, i)字符码 = 码;
            如果 (码 ?= 120) { 1 = 含; }
            否则如果 (码 ?= 88) { 1 = 含; }
            否则如果 (码 ?= 42) { 1 = 含; }
        }
        i + 1 = i;
    }
}

// 子句是否以操作符（> < = ^ ~）开头
函数 (文本:字符串)版本有操作符(0 = 有:整数) {
    0 = 有;
    0 = 码;
    (文本)长度 = 长度;
    如果 (长度 >= 1) {
        (文本, 0)字符码 = 码;
        如果 (码 ?= 62) { 1 = 有; }
        否则如果 (码 ?= 60) { 1 = 有; }
        否则如果 (码 ?= 61) { 1 = 有; }
        否则如果 (码 ?= 94) { 1 = 有; }
        否则如果 (码 ?= 126) { 1 = 有; }
    }
}

// 版本文本是否匹配通配模式（如 `1.2.x` / `1.x` / `x`）
函数 (版本:字符串, 模式:字符串)版本满足通配(0 = 满足:整数) {
    0 = 满足;
    0 = V主;
    0 = V次;
    0 = V修;
    0 = V有效;
    0 = P主;
    0 = P次;
    0 = P修;
    0 = P等级;
    0 = P有效;
    (版本)版本解析 = (V主, V次, V修, V有效);
    (模式)版本解析通配 = (P主, P次, P修, P等级, P有效);
    如果 (V有效 ?= 1) {
        如果 (P有效 ?= 1) {
            如果 (P等级 ?= 3) {
                1 = 满足;
            }
            否则如果 (P等级 ?= 2) {
                如果 (V主 ?= P主) { 1 = 满足; }
            }
            否则如果 (P等级 ?= 1) {
                如果 (V主 ?= P主) {
                    如果 (V次 ?= P次) { 1 = 满足; }
                }
            }
            否则 {
                如果 (V主 ?= P主) {
                    如果 (V次 ?= P次) {
                        如果 (V修 ?= P修) { 1 = 满足; }
                    }
                }
            }
        }
    }
}

// 判定单个子句（跳过前导空白后，按「操作符约束 / 裸通配」二选一）
函数 (版本:字符串, 子句:字符串)版本判定子句(0 = 命中:整数) {
    0 = 命中;
    0 = 码;
    0 = 起;
    0 = 进行中;
    (子句)长度 = 长度;
    1 = 进行中;
    当 (进行中 ?= 1) {
        如果 (起 < 长度) {
            (子句, 起)字符码 = 码;
            如果 (码 ?= 32) {
                起 + 1 = 起;
            } 否则 {
                0 = 进行中;
            }
        } 否则 {
            0 = 进行中;
        }
    }
    如果 (起 < 长度) {
        (子句, 起, 长度 - 起)子串 = 主体;
        (主体)是否含通配 = 含通;
        (主体)版本有操作符 = 有操作符;
        如果 (含通 ?= 1) {
            如果 (有操作符 ?= 0) {
                (版本, 主体)版本满足通配 = 命中;
            }
        } 否则 {
            (版本, 主体)版本满足约束 = 命中;
        }
    }
}

// 版本是否满足区间（逗号分隔的多约束，全部满足 → 1）
函数 (版本:字符串, 区间:字符串)版本满足区间(0 = 满足:整数) {
    1 = 满足;
    0 = 码;
    0 = 起始;
    0 = i;
    (区间)长度 = 长度;
    当 (i <= 长度) {
        如果 (满足 ?= 1) {
            如果 (i ?= 长度) {
                (区间, 起始, i - 起始)子串 = 子句;
                (版本, 子句)版本判定子句 = 命中;
                如果 (命中 ?= 0) { 0 = 满足; }
            } 否则 {
                (区间, i)字符码 = 码;
                如果 (码 ?= 44) {
                    (区间, 起始, i - 起始)子串 = 子句;
                    (版本, 子句)版本判定子句 = 命中;
                    如果 (命中 ?= 0) { 0 = 满足; }
                    i + 1 = 起始;
                }
            }
        }
        i + 1 = i;
    }
}

// ==================== 8AT：版本选择（依赖解析核心） ====================
// 从候选（动态字符串数组）中选出满足 约束 的最高版本，返回其索引；无满足者返回 -1。
// 约束 可为单个约束、逗号区间或裸通配模式（走 `版本满足区间`）。
//   · `候选` 为动态字符串数组句柄：按 `语法规范.md:904` 句柄参数**不加类型标注**（须置末）。
//     若标注为 `字符串`，自举链按值传递、句柄失效（`动态字符串数组获取` 返回空）。
函数 (约束:字符串, 候选)选最高满足版本(-1 = 索引:整数) {
    -1 = 索引;
    0 = 数量;
    0 = i;
    0 = 命中;
    0 = E主;
    0 = E次;
    0 = E修;
    0 = E有效;
    0 = C主;
    0 = C次;
    0 = C修;
    0 = C有效;
    0 = 比;
    (候选)动态字符串数组大小 = 数量;
    0 = i;
    当 (i < 数量) {
        (候选, i)动态字符串数组获取 = 元素;
        (元素, 约束)版本满足区间 = 命中;
        如果 (命中 ?= 1) {
            (元素)版本解析 = (E主, E次, E修, E有效);
            如果 (E有效 ?= 1) {
                如果 (索引 < 0) {
                    i = 索引;
                } 否则 {
                    (候选, 索引)动态字符串数组获取 = 当前;
                    (当前)版本解析 = (C主, C次, C修, C有效);
                    (E主, E次, E修, C主, C次, C修)版本比较 = 比;
                    如果 (比 > 0) {
                        i = 索引;
                    }
                }
            }
        }
        i + 1 = i;
    }
}

// ==================== 8AV：多约束与版本冲突检测（依赖解析） ====================
// 依赖解析：同一包被多处依赖时，其约束构成「约束表」（每个元素为一个约束/区间），
//   解析出的版本须同时满足表中**全部**约束，否则视为**版本冲突**。
//   · `约束表` / `候选择` 为动态字符串数组句柄：按 `语法规范.md:904` **不加类型标注**（须置末）。
//   · 复用 8AT 的 `版本满足区间`（单元素即单约束/区间，含通配）。

// 版本是否满足约束表中全部约束：空表 → 1（无约束即满足）；任一不满足 → 0。
函数 (版本:字符串, 约束表)版本满足全部(1 = 满足:整数) {
    1 = 满足;
