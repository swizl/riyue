    0 = 乙数;
    (甲)是否数字串 = 甲数;
    (乙)是否数字串 = 乙数;
    如果 (甲数 ?= 1 && 乙数 ?= 1) {
        (甲, 乙)数字串比较 = 结果;
    } 否则如果 (甲数 ?= 1) {
        0 - 1 = 结果;
    } 否则如果 (乙数 ?= 1) {
        1 = 结果;
    } 否则 {
        (甲, 乙)字符串字典比较 = 结果;
    }
}

// 从 起始 读一个以 `.` 分隔的标识段 → (段, 新位置)；新位置 指向 `.` 之后（或末位）
函数 (文本:字符串, 起始:整数)取标识段("" = 段:字符串, 0 = 新位置:整数) {
    0 = 长度;
    0 = 位置;
    0 = 码;
    0 = 扫中;
    (文本)长度 = 长度;
    起始 = 位置;
    1 = 扫中;
    当 (扫中 ?= 1) {
        如果 (位置 < 长度) {
            (文本, 位置)字符码 = 码;
            如果 (码 ?= 46) {
                0 = 扫中;
            } 否则 {
                位置 + 1 = 位置;
            }
        } 否则 {
            0 = 扫中;
        }
    }
    (文本, 起始, 位置 - 起始)子串 = 段;
    如果 (位置 < 长度) {
        位置 + 1 = 位置;
    }
    位置 = 新位置;
}

// 预发布串比较（`alpha.1` vs `alpha.2`）：甲小 -1、相等 0、甲大 1
//   逐标识段比较；前缀全等时**段数少者小**（SemVer §11）
函数 (甲:字符串, 乙:字符串)预发布比较(0 = 结果:整数) {
    0 = 长甲;
    0 = 长乙;
    0 = i甲;
    0 = i乙;
    0 = c;
    0 = 停;
    (甲)长度 = 长甲;
    (乙)长度 = 长乙;
    0 = i甲;
    0 = i乙;
    0 = 停;
    当 (停 ?= 0) {
        如果 (i甲 >= 长甲 && i乙 >= 长乙) {
            1 = 停;
        } 否则如果 (i甲 >= 长甲) {
            0 - 1 = 结果;
            1 = 停;
        } 否则如果 (i乙 >= 长乙) {
            1 = 结果;
            1 = 停;
        } 否则 {
            (甲, i甲)取标识段 = (段甲, i甲);
            (乙, i乙)取标识段 = (段乙, i乙);
            (段甲, 段乙)标识比较 = c;
            如果 (c != 0) {
                c = 结果;
                1 = 停;
            }
        }
    }
}

// 从 起始 读版本尾部 `[-预发布][+构建]` → (有预, 预起, 预长, 新位置, 有效)
//   预发布自 `-` 后至 `+` 或末尾；构建元数据自 `+` 后至末尾（忽略）；仅当恰好消费至末尾时 有效=1
函数 (文本:字符串, 起始:整数)版本读尾部(0 = 有预:整数, 0 = 预起:整数, 0 = 预长:整数, 0 = 新位置:整数, 0 = 有效:整数) {
    0 = 有预;
    0 = 预起;
    0 = 预长;
    0 = 有效;
    0 = 长度;
    0 = 位置;
    0 = 码;
    0 = 扫中;
    (文本)长度 = 长度;
    起始 = 位置;
    如果 (位置 >= 长度) {
        1 = 有效;
    } 否则 {
        (文本, 位置)字符码 = 码;
        如果 (码 ?= 45) {
            位置 + 1 = 位置;
            位置 = 预起;
            1 = 有预;
            1 = 扫中;
            当 (扫中 ?= 1) {
                如果 (位置 < 长度) {
                    (文本, 位置)字符码 = 码;
                    如果 (码 ?= 43) {
                        0 = 扫中;
                    } 否则 {
                        位置 + 1 = 位置;
                    }
                } 否则 {
                    0 = 扫中;
                }
            }
            位置 - 预起 = 预长;
        }
        如果 (位置 < 长度) {
            (文本, 位置)字符码 = 码;
            如果 (码 ?= 43) {
                1 = 扫中;
                当 (扫中 ?= 1) {
                    位置 + 1 = 位置;
                    如果 (位置 >= 长度) {
                        0 = 扫中;
                    }
                }
            }
        }
        如果 (位置 ?= 长度) {
            1 = 有效;
        }
    }
    位置 = 新位置;
}

// 解析版本号 `[v]主.次.修订[-预发布][+构建]` → (主, 次, 修订, 有预, 预起, 预长, 有效)
//   三段数字齐全且尾部（预发布/构建）合法时 有效=1；预发布以 [预起, 预起+预长) 标注在原串中
函数 (文本:字符串)版本解析扩展(0 = 主:整数, 0 = 次:整数, 0 = 修订:整数, 0 = 有预:整数, 0 = 预起:整数, 0 = 预长:整数, 0 = 有效:整数) {
    0 = 主;
    0 = 次;
    0 = 修订;
    0 = 有预;
    0 = 预起;
    0 = 预长;
    0 = 有效;
    0 = 长度;
    0 = 位置;
    0 = 首码;
    0 = 码1;
    0 = 码2;
    0 = 段起;
    0 = 尾起;
    0 = 尾位;
    0 = 尾有效;
    (文本)长度 = 长度;
    0 = 位置;
    如果 (长度 >= 1) {
        (文本, 0)字符码 = 首码;
        如果 (首码 ?= 118) { 1 = 位置; }
        否则如果 (首码 ?= 86) { 1 = 位置; }
        位置 = 段起;
        (文本, 位置)读数字段 = (主, 位置);
        如果 (位置 > 段起) {
            如果 (位置 < 长度) {
                (文本, 位置)字符码 = 码1;
                如果 (码1 ?= 46) {
                    位置 + 1 = 位置;
                    位置 = 段起;
                    (文本, 位置)读数字段 = (次, 位置);
                    如果 (位置 > 段起) {
                        如果 (位置 < 长度) {
                            (文本, 位置)字符码 = 码2;
                            如果 (码2 ?= 46) {
                                位置 + 1 = 位置;
                                位置 = 段起;
                                (文本, 位置)读数字段 = (修订, 位置);
                                如果 (位置 > 段起) {
                                    位置 = 尾起;
                                    (文本, 尾起)版本读尾部 = (有预, 预起, 预长, 尾位, 尾有效);
                                    如果 (尾有效 ?= 1) {
                                        1 = 有效;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 完整优先级比较（SemVer §11）：甲低 -1、相等 0、甲高 1
