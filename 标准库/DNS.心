// 日月标准库 - DNS 编解码（RFC 1035 子集：A 记录 / IPv4）
//
// 阶段：短板补齐计划 §Phase 1.1（网络库：DNS 解析）
// 状态：**编解码层已实现（8AC）**；`域名解析`（建套接字→发送→接收→解析的完整往返）**待实现**。
//
// 说明：
//   · 纯 `.心`，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 二进制负载以「整数数组」承载（每元素 0..255）——同 标准库/二进制.心、摘要.心、AES.心。
//     **不可用 文本 承载**：宿主链 文本 为裸 char* 且以 NUL 结尾，DNS 报文头/标签结束符含 0x00 会被截断。
//   · **`域名解析` 阻塞点（重要）**：UDP/TCP 收发内建（`UDP发送到` / `TCP接收` 等）以 `文本`（char*）
//     传数据，按 `strlen` 计长、遇 NUL 截断，故**无法可靠收发含 0x00 的原始报文**；须待运行时提供
//     「带长度的字节缓冲收发」（独立切片）后方可落地完整往返。本切片只做**离线可测**的构造/解析。
//   · 网络字节序为**大端**（big-endian），与本模块的 `DNS写大端16 / DNS读大端16 / DNS读大端32` 对应。
//   · 数组句柄参数以「无类型标注」表示，须置于参数表末尾（见 语法规范.md）；调用一律前缀括号 `(参数)函数名`。
//   · 反向赋值语义：`左 = 右;` 恒为 `右 := 左`。
//   · 仅 A 记录（IPv4）；不做 CNAME 递归 / TCP 回退 / DNSSEC / EDNS0；域名按 ASCII 标签（每标签 ≤ 63 字节，
//     整体 ≤ 255 字节）；转义序列、大小写归一化均不处理。默认端口 53（见 `域名解析` 待实现说明）。

// 模块版本（编解码层已落地）
函数 ()DNS模块版本(0 = 结果: 整数) {
    2 = 结果;
}

// 追加单字节（取低 8 位）
函数 (值: 整数, 输出)DNS写字节(空) {
    (输出, 值 & 255)动态数组添加;
}

// 从 输入 的 游标[0] 处取一字节，游标自增 1
函数 (输入, 游标)DNS取字节(0 = 结果: 整数) {
    0 = 位置;
    (游标, 0)动态数组获取 = 位置;
    (输入, 位置)动态数组获取 = 结果;
    位置 + 1 = 位置;
    (游标, 0, 位置)动态数组设置;
}

// 追加 16 位无符号整数（大端 2 字节）
函数 (值: 整数, 输出)DNS写大端16(空) {
    ((值 >| 8) & 255, 输出)DNS写字节;
    (值 & 255, 输出)DNS写字节;
}

// 读 16 位无符号整数（大端 2 字节），游标自增 2
函数 (输入, 游标)DNS读大端16(0 = 结果: 整数) {
    0 = 高;
    0 = 低;
    (输入, 游标)DNS取字节 = 高;
    (输入, 游标)DNS取字节 = 低;
    高 <| 8 = 结果;
    结果 + 低 = 结果;
}

// 读 32 位无符号整数（大端 4 字节），游标自增 4（用于 TTL 等）
函数 (输入, 游标)DNS读大端32(0 = 结果: 整数) {
    0 = k;
    0 = b;
    0 = 结果;
    当 (k < 4) {
        (输入, 游标)DNS取字节 = b;
        (结果 <| 8) + b = 结果;
        k + 1 = k;
    }
}

// 跳过域名：逐标签前进；遇 0x00 结束，遇压缩指针（高 2 位为 11）再吃 1 字节结束
函数 (输入, 游标)DNS跳过名称(空) {
    0 = 停;
    0 = 首;
    0 = 高位;
    0 = 尾;
    0 = j;
    0 = 丢;
    当 (停 ?= 0) {
        (输入, 游标)DNS取字节 = 首;
        如果 (首 ?= 0) {
            1 = 停;
        } 否则 {
            首 & 192 = 高位;
            如果 (高位 ?= 192) {
                (输入, 游标)DNS取字节 = 尾;
                1 = 停;
            } 否则 {
                0 = j;
                当 (j < 首) {
                    (输入, 游标)DNS取字节 = 丢;
                    j + 1 = j;
                }
            }
        }
    }
}

// 写域名：按 '.' 拆标签，逐标签写「长度(1 字节) + 标签字节(ASCII)」，末尾写 0x00 结束符
函数 (域名: 字符串, 输出)DNS写域名(空) {
    0 = 总长;
    0 = 起;
    0 = i;
    0 = 是点;
    0 = 码;
    0 = 段长;
    0 = k;
    0 = 段码;
    (域名)长度 = 总长;
    0 = 起;
    0 = i;
    当 (i <= 总长) {
        0 = 是点;
        如果 (i ?= 总长) {
            1 = 是点;
        } 否则 {
            (域名, i)字符码 = 码;
            如果 (码 ?= 46) {
                1 = 是点;
            }
        }
        如果 (是点 ?= 1) {
            i - 起 = 段长;
            如果 (段长 > 0) {
                (段长, 输出)DNS写字节;
                起 = k;
                当 (k < i) {
                    (域名, k)字符码 = 段码;
                    (段码 & 255, 输出)DNS写字节;
                    k + 1 = k;
                }
            }
            i + 1 = 起;
        }
        i + 1 = i;
    }
    (0, 输出)DNS写字节;
}

// 构造 A 查询报文，追加到 输出：头(12) + QNAME + QTYPE=1(A) + QCLASS=1(IN)
// 头：ID=事务号；FLAGS=0x0100(RD)；QDCOUNT=1；AN/NS/ARCOUNT=0
函数 (域名: 字符串, 事务号: 整数, 输出)构造DNS查询(空) {
    (事务号, 输出)DNS写大端16;
    (256, 输出)DNS写大端16;
    (1, 输出)DNS写大端16;
    (0, 输出)DNS写大端16;
    (0, 输出)DNS写大端16;
    (0, 输出)DNS写大端16;
    (域名, 输出)DNS写域名;
    (1, 输出)DNS写大端16;
    (1, 输出)DNS写大端16;
}

// 解析响应：跳过头/问题段，在答案段找 A 记录（TYPE=1 & CLASS=1 & RDLENGTH=4），
// 命中则把 4 字节 IPv4 追加到 输出 并归返 0；无 A 记录归返 1；报文头不足 12 字节归返 2。
函数 (输入, 输出)解析DNS响应(0 = 结果: 整数) {
    0 = 总长;
    0 = 事务;
    0 = 标志;
    0 = 问数;
    0 = 答数;
    0 = 权数;
    0 = 附数;
    0 = i;
    0 = j;
    0 = 停;
    0 = 类型;
    0 = 类别;
    0 = 存活;
    0 = 数据长;
    0 = 命中;
    0 = k;
    0 = o1;
    0 = o2;
    0 = o3;
    0 = o4;
    0 = 丢;
    0 = 丢1;
    0 = 丢2;
    ()创建动态数组 = 游标;
    (游标, 0)动态数组添加;
    1 = 结果;
    (输入)动态数组大小 = 总长;
    如果 (总长 >= 12) {
        (输入, 游标)DNS读大端16 = 事务;
        (输入, 游标)DNS读大端16 = 标志;
        (输入, 游标)DNS读大端16 = 问数;
        (输入, 游标)DNS读大端16 = 答数;
        (输入, 游标)DNS读大端16 = 权数;
        (输入, 游标)DNS读大端16 = 附数;
        0 = i;
        当 (i < 问数) {
            (输入, 游标)DNS跳过名称;
            (输入, 游标)DNS读大端16 = 丢1;
            (输入, 游标)DNS读大端16 = 丢2;
            i + 1 = i;
        }
        0 = j;
        0 = 停;
        当 (j < 答数) {
            如果 (停 ?= 1) {
                答数 = j;
            } 否则 {
                (输入, 游标)DNS跳过名称;
                (输入, 游标)DNS读大端16 = 类型;
                (输入, 游标)DNS读大端16 = 类别;
                (输入, 游标)DNS读大端32 = 存活;
                (输入, 游标)DNS读大端16 = 数据长;
                0 = 命中;
                如果 (类型 ?= 1) {
                    如果 (类别 ?= 1) {
                        如果 (数据长 ?= 4) {
                            1 = 命中;
                        }
                    }
                }
                如果 (命中 ?= 1) {
                    (输入, 游标)DNS取字节 = o1;
                    (输入, 游标)DNS取字节 = o2;
                    (输入, 游标)DNS取字节 = o3;
                    (输入, 游标)DNS取字节 = o4;
                    (输出, o1)动态数组添加;
                    (输出, o2)动态数组添加;
                    (输出, o3)动态数组添加;
                    (输出, o4)动态数组添加;
                    0 = 结果;
                    1 = 停;
                } 否则 {
                    0 = k;
                    当 (k < 数据长) {
                        (输入, 游标)DNS取字节 = 丢;
                        k + 1 = k;
                    }
                }
            }
            j + 1 = j;
        }
    } 否则 {
        2 = 结果;
    }
}

// 半字节（0..15）→ 十六进制字符；越界归返 "?"
函数 (值: 整数)DNS十六进制字符("?" = 结果: 字符串) {
    "0123456789abcdef" = 表;
    如果 (值 < 16) {
        (表, 值)字符码 = 码;
        (码)字符 = 结果;
    }
}

// 字节数组 → 小写十六进制文本（便于查看/测试）
函数 (字节数组)DNS转十六进制("" = 结果: 字符串) {
    0 = 个数;
    0 = i;
    0 = b;
    0 = 高;
    0 = 低;
    (字节数组)动态数组大小 = 个数;
    "" = 输出;
    0 = i;
    当 (i < 个数) {
        (字节数组, i)动态数组获取 = b;
        b / 16 = 高;
        b % 16 = 低;
        (高)DNS十六进制字符 = 高字符;
        (输出, 高字符)拼接 = 输出;
        (低)DNS十六进制字符 = 低字符;
        (输出, 低字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}
