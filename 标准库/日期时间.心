// ==================== 8BQ：日期算法（闰年 / 月天数 / 儒略日 / 星期几）——纯 `.心`，双链一致 ====================
//   · 仅用两链皆已支持的内建/运算（整除 `/`、取余 `%`、比较/逻辑运算符）。
//   · **标量形参须标注 `:整数`**（同 8BL/8BM/8BN/8BO/8BP）；**赋值目标恒在 `=` 右侧**。
//   · 公历（Gregorian）算法，假定 年 ≥ 1、月 ∈ [1,12]、日 ∈ [1,31]；正数域上 `/` 即下取整。

// 是否闰年：能被 4 整除且不能被 100 整除，或能被 400 整除 → 1/0
函数 (年:整数)是否闰年(0 = 结果:整数) {
    0 = 结果;
    如果 (年 % 400 ?= 0) {
        1 = 结果;
    } 否则如果 (年 % 100 ?= 0) {
        0 = 结果;
    } 否则如果 (年 % 4 ?= 0) {
        1 = 结果;
    }
}

// 某年某月的天数（月 ∈ [1,12]；2 月按闰年；月超出范围按 31 处理）
函数 (年:整数, 月:整数)月天数(0 = 结果:整数) {
    31 = 结果;
    如果 (月 ?= 4) { 30 = 结果; }
    如果 (月 ?= 6) { 30 = 结果; }
    如果 (月 ?= 9) { 30 = 结果; }
    如果 (月 ?= 11) { 30 = 结果; }
    如果 (月 ?= 2) {
        28 = 结果;
        (年)是否闰年 = 闰;
        如果 (闰 ?= 1) { 29 = 结果; }
    }
}

// 公历日期 → 儒略日数（JDN，正午为界）
函数 (年:整数, 月:整数, 日:整数)到儒略日(0 = 结果:整数) {
    0 = a;
    如果 (月 <= 2) { 1 = a; }
    年 + 4800 - a = y;
    月 + 12 * a - 3 = m;
    日 + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045 = 结果;
}

// 公历日期 → 星期（0=周一 … 6=周日；等于 JDN 对 7 取余）
函数 (年:整数, 月:整数, 日:整数)星期几(0 = 结果:整数) {
    (年, 月, 日)到儒略日 = j;
    j % 7 = 结果;
}
