// ==================== 8BQ：日期算法（闰年 / 月天数 / 儒略日 / 星期几）——纯 `.心`，双链一致 ====================
//   · 仅用两链皆已支持的内建/运算（整除 `/`、取余 `%`、比较/逻辑运算符）。
//   · **标量形参须标注 `:整数`**（同 8BL/8BM/8BN/8BO/8BP）；**赋值目标恒在 `=` 右侧**。
//   · 公历（Gregorian）算法，假定 年 ≥ 1、月 ∈ [1,12]、日 ∈ [1,31]；正数域上 `/` 即下取整。

// 是否闰年：能被 4 整除且不能被 100 整除，或能被 400 整除 → 1/0
函数 (年:整数)是否闰年(0 = 结果:整数) {
    0 = 结果;
    如果 (年 % 400 ?= 0) {
        1 = 结果;
    } 否则如果 (年 % 100 ?= 0) {
        0 = 结果;
    } 否则如果 (年 % 4 ?= 0) {
        1 = 结果;
    }
}

// 某年某月的天数（月 ∈ [1,12]；2 月按闰年；月超出范围按 31 处理）
函数 (年:整数, 月:整数)月天数(0 = 结果:整数) {
    31 = 结果;
    如果 (月 ?= 4) { 30 = 结果; }
    如果 (月 ?= 6) { 30 = 结果; }
    如果 (月 ?= 9) { 30 = 结果; }
    如果 (月 ?= 11) { 30 = 结果; }
    如果 (月 ?= 2) {
        28 = 结果;
        (年)是否闰年 = 闰;
        如果 (闰 ?= 1) { 29 = 结果; }
    }
}

// 公历日期 → 儒略日数（JDN，正午为界）
函数 (年:整数, 月:整数, 日:整数)到儒略日(0 = 结果:整数) {
    0 = a;
    如果 (月 <= 2) { 1 = a; }
    年 + 4800 - a = y;
    月 + 12 * a - 3 = m;
    日 + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045 = 结果;
}

// 公历日期 → 星期（0=周一 … 6=周日；等于 JDN 对 7 取余）
函数 (年:整数, 月:整数, 日:整数)星期几(0 = 结果:整数) {
    (年, 月, 日)到儒略日 = j;
    j % 7 = 结果;
}

// ==================== 8BR：日期算术（儒略日还原 / 日期加天数 / 日期差）——纯 `.心`，双链一致 ====================
//   · 复用 8BQ 的 `到儒略日`；儒略日 → 公历采用 Fliegel–Van Flandern 整数算法。
//   · **标量形参须标注 `:整数`**；**句柄形参（输出数组）不加类型标注**；**赋值目标恒在 `=` 右侧**。

// 儒略日数 → 公历日期；写入 输出[0]=年 / [1]=月 / [2]=日（Fliegel–Van Flandern）
函数 (jdn:整数, 输出)儒略日到日期(空) {
    jdn + 68569 = l;
    4 * l / 146097 = n;
    l - (146097 * n + 3) / 4 = l;
    4000 * (l + 1) / 1461001 = i;
    l - 1461 * i / 4 + 31 = l;
    80 * l / 2447 = j;
    l - 2447 * j / 80 = d;
    j / 11 = l;
    j + 2 - 12 * l = m;
    100 * (n - 49) + i + l = y;
    (输出, 0, y)动态数组设置;
    (输出, 1, m)动态数组设置;
    (输出, 2, d)动态数组设置;
}

// 日期 + 天数（天数可负）→ 新日期；写入 输出[0]=年 / [1]=月 / [2]=日
函数 (年:整数, 月:整数, 日:整数, 天数:整数, 输出)日期加天数(空) {
    (年, 月, 日)到儒略日 = 基;
    基 + 天数 = 新儒略日;
    (新儒略日, 输出)儒略日到日期;
}

// 日期差（天数）：日期乙 − 日期甲（带符号；乙晚于甲为正）
函数 (年甲:整数, 月甲:整数, 日甲:整数, 年乙:整数, 月乙:整数, 日乙:整数)日期差天数(0 = 结果:整数) {
    (年甲, 月甲, 日甲)到儒略日 = j1;
    (年乙, 月乙, 日乙)到儒略日 = j2;
    j2 - j1 = 结果;
}

// ==================== 8BU：日期查询与月步进（有效性 / 年积日 / 季度 / 日期加月数）——纯 `.心`，双链一致 ====================
//   · 复用 8BQ/8BR 的 `到儒略日`/`月天数`；仅用两链皆已支持的内建/运算（整除 `/`、取余 `%`、比较/逻辑运算符）。
//   · **标量形参须标注 `:整数`**；**句柄形参（输出数组）不加类型标注**；**赋值目标恒在 `=` 右侧**。
//   · 公历算法，假定 年 ≥ 1；`日期加月数` 结果须落在 年 ≥ 1。

// 日期是否有效：月 ∈ [1,12] 且 日 ∈ [1, 该月天数] → 1；否则 0
函数 (年:整数, 月:整数, 日:整数)日期是否有效(0 = 结果:整数) {
    0 = 结果;
    (年, 月)月天数 = 上限;
    如果 (月 >= 1 && 月 <= 12 && 日 >= 1 && 日 <= 上限) { 1 = 结果; }
}

// 年积日：该日期是当年第几天（1..365/366）
函数 (年:整数, 月:整数, 日:整数)年积日(0 = 结果:整数) {
    (年, 月, 日)到儒略日 = j;
    (年, 1, 1)到儒略日 = j0;
    j - j0 + 1 = 结果;
}

// 季度：月 ∈ [1,12] → 1..4（月超出范围按公式外推，不报错）
函数 (月:整数)季度(0 = 结果:整数) {
    (月 - 1) / 3 + 1 = 结果;
}

// 日期 + 月数（月数可负）→ 新日期，日超出新月天数则收拢到月末；写入 输出[0]=年 / [1]=月 / [2]=日
函数 (年:整数, 月:整数, 日:整数, 月数:整数, 输出)日期加月数(空) {
    年 * 12 + 月 - 1 = 总;
    总 + 月数 = 总;
    总 / 12 = 新年;
    总 % 12 + 1 = 新月;
    (新年, 新月)月天数 = 上限;
    0 = 新日;
    如果 (日 <= 上限) { 日 = 新日; }
    如果 (日 > 上限) { 上限 = 新日; }
    (输出, 0, 新年)动态数组设置;
    (输出, 1, 新月)动态数组设置;
    (输出, 2, 新日)动态数组设置;
}

// ==================== 8BW：日期年步进与比较（日期加年数 / 日期比较 / 年积日到日期 / 是否同一天）——纯 `.心`，双链一致 ====================
//   · 复用 8BQ/8BR/8BU 的 `到儒略日`/`儒略日到日期`/`月天数`；仅用两链皆已支持的内建/运算。
//   · **标量形参须标注 `:整数`**；**句柄形参（输出数组）不加类型标注**；**赋值目标恒在 `=` 右侧**。
//   · 公历算法，假定 年 ≥ 1；`日期加年数` 结果须落在 年 ≥ 1。

// 日期 + 年数（年数可负）→ 新日期，2 月 29 遇平年则收拢到 2 月 28；写入 输出[0]=年 / [1]=月 / [2]=日
函数 (年:整数, 月:整数, 日:整数, 年数:整数, 输出)日期加年数(空) {
    年 + 年数 = 新年;
    (新年, 月)月天数 = 上限;
    0 = 新日;
    如果 (日 <= 上限) { 日 = 新日; }
    如果 (日 > 上限) { 上限 = 新日; }
    (输出, 0, 新年)动态数组设置;
    (输出, 1, 月)动态数组设置;
    (输出, 2, 新日)动态数组设置;
}

// 日期比较：甲 < 乙 → -1；甲 > 乙 → 1；相等 → 0
函数 (年甲:整数, 月甲:整数, 日甲:整数, 年乙:整数, 月乙:整数, 日乙:整数)日期比较(0 = 结果:整数) {
    (年甲, 月甲, 日甲)到儒略日 = j1;
    (年乙, 月乙, 日乙)到儒略日 = j2;
    如果 (j1 < j2) { -1 = 结果; }
    如果 (j1 > j2) { 1 = 结果; }
}

// 年积日 → 日期：返回该年第 年积日 天对应的公历日期；写入 输出[0]=年 / [1]=月 / [2]=日
函数 (年:整数, 年积日:整数, 输出)年积日到日期(空) {
    (年, 1, 1)到儒略日 = 基;
    基 + 年积日 - 1 = jdn;
    (jdn, 输出)儒略日到日期;
}

// 是否同一天（年月日全等）→ 1/0
函数 (年甲:整数, 月甲:整数, 日甲:整数, 年乙:整数, 月乙:整数, 日乙:整数)是否同一天(0 = 结果:整数) {
    0 = 结果;
    (年甲, 月甲, 日甲, 年乙, 月乙, 日乙)日期比较 = c;
    如果 (c ?= 0) { 1 = 结果; }
}

// ==================== 8BX：ISO 周与周末判定（是否周末 / ISO星期 / ISO周年 / ISO周号）——纯 `.心`，双链一致 ====================
//   · 复用 8BQ 的 `到儒略日`/`星期几`；ISO-8601 规则：周一为一周之首、周四所属公历年即 ISO 周年。
//   · **标量形参须标注 `:整数`**；**赋值目标恒在 `=` 右侧**；公历算法，假定 年 ≥ 1、日期有效。
//   · ISO 周号做法：取该日期所属周的**周四**（JDN），其公历年即 ISO 周年，其当年序日决定周号。

// 是否周末（周六或周日）→ 1/0（星期几：0=周一 … 6=周日）
函数 (年:整数, 月:整数, 日:整数)是否周末(0 = 结果:整数) {
    0 = 结果;
    (年, 月, 日)星期几 = w;
    如果 (w >= 5) { 1 = 结果; }
}

// ISO 星期：1=周一 … 7=周日（等于 `星期几` + 1）
函数 (年:整数, 月:整数, 日:整数)ISO星期(0 = 结果:整数) {
    (年, 月, 日)星期几 = w;
    w + 1 = 结果;
}

// ISO 周年：该日期所属 ISO 周所在的公历年份（等于该周周四的公历年）
函数 (年:整数, 月:整数, 日:整数)ISO周年(0 = 结果:整数) {
    (年, 月, 日)到儒略日 = j;
    j % 7 + 1 = wd;
    j - wd + 4 = jdn;
    jdn + 68569 = l;
    4 * l / 146097 = n;
    l - (146097 * n + 3) / 4 = l;
    4000 * (l + 1) / 1461001 = i;
    l - 1461 * i / 4 + 31 = l;
    80 * l / 2447 = jj;
    jj / 11 = l;
    100 * (n - 49) + i + l = 结果;
}

// ISO 周号：该日期所属 ISO 周序号（1..53）
函数 (年:整数, 月:整数, 日:整数)ISO周号(0 = 结果:整数) {
    (年, 月, 日)到儒略日 = j;
    j % 7 + 1 = wd;
    j - wd + 4 = 周四;
    (年, 月, 日)ISO周年 = 周年;
    (周年, 1, 1)到儒略日 = 基;
    (周四 - 基) / 7 + 1 = 结果;
}

// ==================== 8BZ：ISO 周反解（ISO周日期 / ISO周年周数 / ISO周起始 / ISO周结束）——纯 `.心`，双链一致 ====================
//   · 复用 8BQ 的 `到儒略日`/`是否闰年`、8BR 的 `儒略日到日期`；ISO-8601：周一为一周之首、第 1 周含 1 月 4 日。
//   · **标量形参须标注 `:整数`**；**句柄形参（输出数组）不加类型标注**；**赋值目标恒在 `=` 右侧**。
//   · ISO 周 1 的周一 = 1 月 4 日所在周的周一（`到儒略日(年,1,4) - 到儒略日(年,1,4) % 7`，因 `星期几` = JDN % 7，0=周一）。

// ISO 周年 + 周号 + 星期号 → 公历日期；写入 输出[0]=年 / [1]=月 / [2]=日（8BX `ISO周年`/`ISO周号`/`ISO星期` 的反解）
函数 (周年:整数, 周号:整数, 星期号:整数, 输出)ISO周日期(空) {
    (周年, 1, 4)到儒略日 = j4;
    j4 % 7 = 偏移;
    j4 - 偏移 = 周一首;
    (周号 - 1) * 7 + (星期号 - 1) = 位移;
    周一首 + 位移 = jdn;
    (jdn, 输出)儒略日到日期;
}

// ISO 周年的周数（52 或 53）：1 月 1 日为周四，或闰年且 1 月 1 日为周三 → 53；否则 52
函数 (周年:整数)ISO周年周数(0 = 结果:整数) {
    52 = 结果;
    (周年, 1, 1)到儒略日 = j1;
    j1 % 7 = w;
    如果 (w ?= 3) { 53 = 结果; }
    (周年)是否闰年 = 闰;
    如果 (闰 ?= 1 && w ?= 2) { 53 = 结果; }
}

// 该日期所属 ISO 周的周一 → 公历日期；写入 输出[0]=年 / [1]=月 / [2]=日
函数 (年:整数, 月:整数, 日:整数, 输出)ISO周起始(空) {
    (年, 月, 日)到儒略日 = j;
    j % 7 = 偏移;
    j - 偏移 = 周一;
    (周一, 输出)儒略日到日期;
}

// 该日期所属 ISO 周的周日 → 公历日期；写入 输出[0]=年 / [1]=月 / [2]=日
函数 (年:整数, 月:整数, 日:整数, 输出)ISO周结束(空) {
    (年, 月, 日)到儒略日 = j;
    j % 7 = 偏移;
    j - 偏移 + 6 = 周日;
    (周日, 输出)儒略日到日期;
}

// ==================== 8CC：当日时间运算（时间到秒 / 秒到时间 / 时间加秒 / 时间差秒）——纯 `.心`，双链一致 ====================
//   · 全程 i32 域；**标量形参须标注 `:整数`**；**句柄形参（输出数组）不加类型标注**；**赋值目标恒在 `=` 右侧**。
//   · 24 小时制、每日 86400 秒；`秒到时间`/`时间加秒` 按 86400 归一（跨日回绕）；仅用整除 `/` 与取余 `%`。

// 当日时间 → 秒数（0..86399）：时*3600 + 分*60 + 秒（入参越界按公式外推，不校验）
函数 (时:整数, 分:整数, 秒:整数)时间到秒(0 = 结果:整数) {
    时 * 3600 + 分 * 60 + 秒 = 结果;
}

// 当日秒数 → 时间；按 86400 归一（负值 + 86400 收拢到 [0,86400)）；写入 输出[0]=时 / [1]=分 / [2]=秒
函数 (总秒:整数, 输出)秒到时间(空) {
    总秒 % 86400 = 余;
    如果 (余 < 0) { 余 + 86400 = 余; }
    余 / 3600 = 时;
    余 % 3600 / 60 = 分;
    余 % 60 = 秒;
    (输出, 0, 时)动态数组设置;
    (输出, 1, 分)动态数组设置;
    (输出, 2, 秒)动态数组设置;
}

// 时间 + 秒数（可负）→ 时间；按 86400 归一（跨日回绕）；写入 输出[0]=时 / [1]=分 / [2]=秒
函数 (时:整数, 分:整数, 秒:整数, 增量:整数, 输出)时间加秒(空) {
    时 * 3600 + 分 * 60 + 秒 + 增量 = 总;
    (总, 输出)秒到时间;
}

// 当日时间差（秒）：乙 − 甲（带符号；乙晚于甲为正）
函数 (时甲:整数, 分甲:整数, 秒甲:整数, 时乙:整数, 分乙:整数, 秒乙:整数)时间差秒(0 = 结果:整数) {
    时甲 * 3600 + 分甲 * 60 + 秒甲 = s1;
    时乙 * 3600 + 分乙 * 60 + 秒乙 = s2;
    s2 - s1 = 结果;
}
