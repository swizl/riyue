// 日月标准库 - 栈容器（泛型结构体，阶段4C2）
// 说明：底层复用内建动态数组（整数元素，与 数组.心/集合.心 同），故以 <整数> 实例化。
// 创建：栈<整数> { 数据: ()创建动态数组, 数量: 0 } = s;
// 成员初值须用 `()创建动态数组`（真正的 动态数组* 句柄），不可用数组字面量
//（数组字面量写的是裸 C 数组指针，与内建动态数组表示不同）。

结构体 栈<T> {
    数据: T[];
    数量: 整数;
    方法 入栈(值: T) {
        (栈.数据, 值)动态数组添加;
        栈.数量 + 1 = 栈.数量;
    }
    方法 出栈()(0 = 结果: T) {
        栈.数量 - 1 = 栈.数量;
        (栈.数据, 栈.数量)动态数组获取 = 结果;
    }
    方法 长度()(0 = 结果: 整数) {
        栈.数量 = 结果;
    }
}