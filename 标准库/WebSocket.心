// 日月标准库 - WebSocket（RFC 6455 子集：帧编解码层）
//
// 阶段：短板补齐计划 §Phase 1.1（网络库：WebSocket 支持）
// 状态：**帧编解码层已实现（8AD）**；**握手（Sec-WebSocket-Accept）已实现（8AP，纯 `.心`）**；
//       **完整收发（把握手请求/帧经 TCP 打到对端并解析应答）待实现**。
//
// 说明：
//   · 纯 `.心`，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 二进制帧以「整数数组」承载（每元素 0..255）——同 标准库/二进制.心、DNS.心。
//     **不可用 文本 承载**：宿主链 文本 为裸 char* 且以 NUL 结尾，帧头/长度字段含 0x00 会被截断。
//   · **阻塞点（重要）**：TCP 收发内建（`TCP发送` / `TCP接收`）以 `文本`（char*）传数据、按 `strlen`
//     计长、遇 NUL 截断，故**无法可靠收发含 0x00 的原始帧**；完整 WebSocket 往返须待运行时提供
//     「带长度的字节缓冲收发」（独立切片，会改自举源）。
//   · **握手已实现（8AP）**：`Sec-WebSocket-Accept = base64(sha1(客户端键 + GUID))`。为免改
//     共享的 `摘要.心`（SHA-1 公开接口为 40 位十六进制串），握手以「十六进制串 → 20 字节数组
//     （经 `编码.十六进制值`）→ `编码.Base64编码字节`」落地；`编码.Base64编码字节` 为 8AP 新增
//     的**字节数组**入参版本（既有 `Base64编码` 只吃文本、按 NUL 截断）。
//   · 完整收发仍待实现：把握手请求与帧经 `网络.TCP发送字节`（8AG）打出、并解析对端应答。
//   · 网络字节序为**大端**；长度字段：<126 用 7 位、126..65535 用 126+2 字节、否则 127+8 字节。
//   · 数组句柄参数以「无类型标注」表示、须置于参数表末尾；带标注参数在前（见 语法规范.md）。
//   · 反向赋值语义：`左 = 右;` 恒为 `右 := 左`；调用一律前缀括号 `(参数)函数名`。
//   · 不做 permessage-deflate 压缩扩展 / wss(TLS) / 分片重组 / 客户端随机掩码。

导入 "摘要.心";
导入 "编码.心";

// —— 字节写出 ——

// 追加单字节（取低 8 位）
函数 (值: 整数, 输出)WS写字节(空) {
    (输出, 值 & 255)动态数组添加;
}

// 追加 16 位无符号整数（大端 2 字节）
函数 (值: 整数, 输出)WS写大端16(空) {
    ((值 >| 8) & 255, 输出)WS写字节;
    (值 & 255, 输出)WS写字节;
}

// 追加 64 位无符号整数（大端 8 字节；本层仅用低 32 位，高 4 字节填 0）
函数 (值: 整数, 输出)WS写大端64(空) {
    (0, 输出)WS写字节;
    (0, 输出)WS写字节;
    (0, 输出)WS写字节;
    (0, 输出)WS写字节;
    ((值 >| 24) & 255, 输出)WS写字节;
    ((值 >| 16) & 255, 输出)WS写字节;
    ((值 >| 8) & 255, 输出)WS写字节;
    (值 & 255, 输出)WS写字节;
}

// 写长度字段（无掩码位）：<126 用 7 位；<=65535 用 126 + 2 字节；否则 127 + 8 字节
函数 (长度: 整数, 输出)WS写长度(空) {
    如果 (长度 < 126) {
        (长度, 输出)WS写字节;
    } 否则如果 (长度 <= 65535) {
        (126, 输出)WS写字节;
        (长度, 输出)WS写大端16;
    } 否则 {
        (127, 输出)WS写字节;
        (长度, 输出)WS写大端64;
    }
}

// 写长度字段（置掩码位 MASK=1）：<126 用 128+长度；<=65535 用 254 + 2 字节；否则 255 + 8 字节
函数 (长度: 整数, 输出)WS写长度掩码(空) {
    如果 (长度 < 126) {
        (128 + 长度, 输出)WS写字节;
    } 否则如果 (长度 <= 65535) {
        (254, 输出)WS写字节;
        (长度, 输出)WS写大端16;
    } 否则 {
        (255, 输出)WS写字节;
        (长度, 输出)WS写大端64;
    }
}

// —— 文本 / 十六进制辅助 ——

// 半字节（0..15）→ 十六进制字符；越界归返 "?"
函数 (值: 整数)WS十六进制字符("?" = 结果: 字符串) {
    "0123456789abcdef" = 表;
    如果 (值 < 16) {
        (表, 值)字符码 = 码;
        (码)字符 = 结果;
    }
}

// 字节数组 → 小写十六进制文本（便于查看 / 测试）
函数 (字节数组)WebSocket转十六进制("" = 结果: 字符串) {
    0 = 个数;
    0 = i;
    0 = b;
    0 = 高;
    0 = 低;
    (字节数组)动态数组大小 = 个数;
    "" = 输出;
    0 = i;
    当 (i < 个数) {
        (字节数组, i)动态数组获取 = b;
        b / 16 = 高;
        b % 16 = 低;
        (高)WS十六进制字符 = 高字符;
        (输出, 高字符)拼接 = 输出;
        (低)WS十六进制字符 = 低字符;
        (输出, 低字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 文本 → 字节数组：把 文本 的字节逐个（取低 8 位，ASCII 语义）追加到 输出
函数 (文本: 字符串, 输出)WebSocket追加文本(空) {
    0 = 总长;
    0 = i;
    0 = 码;
    (文本)长度 = 总长;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        (输出, 码 & 255)动态数组添加;
        i + 1 = i;
    }
}

// 字节数组 → 文本：逐字节按字符码构造（仅 ASCII / 单字节可读）
函数 (字节数组)WebSocket转文本("" = 结果: 字符串) {
    0 = 个数;
    0 = i;
    0 = b;
    (字节数组)动态数组大小 = 个数;
    "" = 输出;
    0 = i;
    当 (i < 个数) {
        (字节数组, i)动态数组获取 = b;
        (b)字符 = 单字;
        (输出, 单字)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// —— 帧构造 ——

// 服务端帧（FIN=1，MASK=0）：首字节 + 长度 + 原始载荷，追加到 输出
函数 (操作码: 整数, 载荷, 输出)WebSocket构造帧(空) {
    0 = 个数;
    0 = i;
    0 = b;
    (载荷)动态数组大小 = 个数;
    (128 + (操作码 & 15), 输出)WS写字节;
    (个数, 输出)WS写长度;
    0 = i;
    当 (i < 个数) {
        (载荷, i)动态数组获取 = b;
        (b & 255, 输出)WS写字节;
        i + 1 = i;
    }
}

// 客户端帧（FIN=1，MASK=1）：掩码键为 4 字节整数数组；载荷按掩码键逐字节异或
函数 (操作码: 整数, 掩码键, 载荷, 输出)WebSocket构造帧掩码(空) {
    0 = 个数;
    0 = i;
    0 = b;
    0 = 键;
    0 = m;
    0 = 异;
    (载荷)动态数组大小 = 个数;
    (128 + (操作码 & 15), 输出)WS写字节;
    (个数, 输出)WS写长度掩码;
    0 = i;
    当 (i < 4) {
        (掩码键, i)动态数组获取 = 键;
        (键 & 255, 输出)WS写字节;
        i + 1 = i;
    }
    0 = i;
    当 (i < 个数) {
        (载荷, i)动态数组获取 = b;
        i % 4 = m;
        (掩码键, m)动态数组获取 = 键;
        (b ^ 键) = 异;
        (异 & 255, 输出)WS写字节;
        i + 1 = i;
    }
}

// —— 帧解析 ——

// 从 输入 的 偏移[0] 处解析一帧：成功把载荷（已解掩码）追加到 输出，
// 归返 (操作码, 结束=FIN)，并把 偏移[0] 更新为下一帧起点；
// 数据不足时归返 操作码 = -1（偏移不变，调用方可补数据后重试）。
函数 (输入, 输出, 偏移)解析WebSocket帧(0 = 操作码: 整数, 0 = 结束: 整数) {
    0 = 总长;
    0 = 起;
    0 = 首;
    0 = 次;
    0 = 掩码;
    0 = 长度;
    0 = 高;
    0 = 低;
    0 = i;
    0 = k;
    0 = b;
    0 = 键;
    0 = m;
    0 = 可用;
    0 = 头够;
    0 = 够;
    0 = 异;
    -1 = 操作码;
    0 = 结束;
    (输入)动态数组大小 = 总长;
    (偏移, 0)动态数组获取 = 起;
    总长 - 起 = 可用;
    如果 (可用 >= 2) {
        (输入, 起)动态数组获取 = 首;
        起 + 1 = 起;
        (输入, 起)动态数组获取 = 次;
        起 + 1 = 起;
        首 & 15 = 操作码;
        (首 >| 7) & 1 = 结束;
        (次 >| 7) = 掩码;
        次 & 127 = 长度;
        0 = 头够;
        如果 (长度 ?= 126) {
            总长 - 起 = 可用;
            如果 (可用 >= 2) {
                (输入, 起)动态数组获取 = 高;
                起 + 1 = 起;
                (输入, 起)动态数组获取 = 低;
                起 + 1 = 起;
                (高 <| 8) + 低 = 长度;
                1 = 头够;
            }
        } 否则如果 (长度 ?= 127) {
            总长 - 起 = 可用;
            如果 (可用 >= 8) {
                0 = 长度;
                0 = i;
                当 (i < 8) {
                    (输入, 起)动态数组获取 = b;
                    起 + 1 = 起;
                    (长度 <| 8) + b = 长度;
                    i + 1 = i;
                }
                1 = 头够;
            }
        } 否则 {
            1 = 头够;
        }
        如果 (头够 ?= 1) {
            0 = 够;
            如果 (掩码 ?= 1) {
                总长 - 起 = 可用;
                如果 (可用 >= 4) {
                    ()创建动态数组 = 键表;
                    0 = i;
                    当 (i < 4) {
                        (输入, 起)动态数组获取 = b;
                        (键表, b & 255)动态数组添加;
                        起 + 1 = 起;
                        i + 1 = i;
                    }
                    总长 - 起 = 可用;
                    如果 (可用 >= 长度) {
                        1 = 够;
                    }
                    如果 (够 ?= 1) {
                        0 = k;
                        当 (k < 长度) {
                            (输入, 起)动态数组获取 = b;
                            k % 4 = m;
                            (键表, m)动态数组获取 = 键;
                            (b ^ 键) = 异;
                            (输出, 异 & 255)动态数组添加;
                            起 + 1 = 起;
                            k + 1 = k;
                        }
                    }
                }
            } 否则 {
                总长 - 起 = 可用;
                如果 (可用 >= 长度) {
                    1 = 够;
                }
                如果 (够 ?= 1) {
                    0 = k;
                    当 (k < 长度) {
                        (输入, 起)动态数组获取 = b;
                        (输出, b & 255)动态数组添加;
                        起 + 1 = 起;
                        k + 1 = k;
                    }
                }
            }
            如果 (够 ?= 1) {
                (偏移, 0, 起)动态数组设置;
            } 否则 {
                -1 = 操作码;
            }
        } 否则 {
            -1 = 操作码;
        }
    }
}

// —— 握手（RFC 6455 §4.2.2）——

// 握手应答键：`Sec-WebSocket-Accept = base64(sha1(客户端键 + GUID))`，
// GUID 为 RFC 6455 固定魔法值。`客户端键` 即客户端 `Sec-WebSocket-Key` 头的值。
// 路径：`摘要.SHA1`（40 位十六进制串）→ 逐两位还原 20 字节 → `编码.Base64编码字节`
//（避开「SHA-1 原始字节接口」，从而不改共享的 摘要.心）。
函数 (客户端键:字符串)WebSocket握手接受键("" = 结果:字符串) {
    (客户端键, "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")拼接 = 素材;
    (素材)SHA1 = 十六;
    (十六)长度 = 十六长;
    ()创建动态数组 = 摘要;
    0 = i;
    0 = 高;
    0 = 低;
    当 (i + 1 < 十六长) {
        (十六, i)字符码 = 高码;
        (十六, i + 1)字符码 = 低码;
        (高码)十六进制值 = 高;
        (低码)十六进制值 = 低;
        (摘要, 高 * 16 + 低)动态数组添加;
        i + 2 = i;
    }
    (摘要)Base64编码字节 = 结果;
}

// 模块版本（帧编解码层 8AD + 握手 8AP）
函数 ()WebSocket模块版本(0 = 结果: 整数) {
    3 = 结果;
}
