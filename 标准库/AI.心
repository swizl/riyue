    "" = 路径;
    "" = 请求;
    "" = 原文;
    "" = 段;
    "" = 认证;
    0 = 端口;
    0 = 套接字;
    0 = 段长;
    0 = 次数;
    0 = 停;
    (端点)AI拆分端点 = (主机, 端口, 路径);
    ()创建动态字符串数组 = 头;
    (头, "Content-Type: application/json")动态字符串数组添加;
    (头, "Connection: close")动态字符串数组添加;
    如果 (密钥 != "") {
        ("Authorization: Bearer ", 密钥)拼接 = 认证;
        (头, 认证)动态字符串数组添加;
    }
    ("POST", 路径, 主机, 体, 头)HTTP构造请求 = 请求;
    "" = 原文;
    (主机, 端口, 请求)TCP连接发送 = 套接字;
    如果 (套接字 >= 0) {
        0 = 停;
        0 = 次数;
        当 (停 ?= 0) {
            (套接字)TCP接收 = 段;
            (段)长度 = 段长;
            如果 (段长 > 0) {
                (原文, 段)拼接 = 原文;
                次数 + 1 = 次数;
                如果 (次数 >= 64) {
                    1 = 停;
                }
            } 否则 {
                1 = 停;
            }
        }
        (套接字)TCP关闭;
        ()创建动态字符串数组 = 应头;
        (原文, 应头)HTTP解析响应 = (状态, 响应体);
    } 否则 {
        0 = 状态;
        "" = 响应体;
    }
}

