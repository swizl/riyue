// ==================== 端点拆分 ====================

// 拆分端点 `http://主机[:端口][/路径]` → (主机, 端口, 路径)；缺端口按 80、缺路径按 "/"。
//   · 同时接受 `https://` 前缀（仅剥离，传输层不支持 TLS）。
函数 (端点:字符串)AI拆分端点("" = 主机:字符串, 0 = 端口:整数, "" = 路径:字符串) {
    "" = 余;
    "" = 主机端口;
    0 = 长;
    0 = 余长;
    0 = 斜;
    0 = 冒;
    0 = 主长;
    0 = 有;
    "" = 端口文;
    (端点)长度 = 长;
    (端点, "http://")AI以开头 = 有;
    如果 (有 ?= 1) {
        (端点, 7, 长 - 7)子串 = 余;
    } 否则 {
        (端点, "https://")AI以开头 = 有;
        如果 (有 ?= 1) {
            (端点, 8, 长 - 8)子串 = 余;
        } 否则 {
            端点 = 余;
        }
    }
    (余)长度 = 余长;
    (余, "/")查找 = 斜;
    如果 (斜 > -1) {
        (余, 0, 斜)子串 = 主机端口;
        (余, 斜, 余长 - 斜)子串 = 路径;
    } 否则 {
        余 = 主机端口;
        "/" = 路径;
    }
    (主机端口)长度 = 主长;
    (主机端口, ":")查找 = 冒;
    如果 (冒 > -1) {
        (主机端口, 0, 冒)子串 = 主机;
        (主机端口, 冒 + 1, 主长 - 冒 - 1)子串 = 端口文;
        (端口文)转整数 = 端口;
        如果 (端口 <= 0) {
            80 = 端口;
        }
    } 否则 {
        主机端口 = 主机;
        80 = 端口;
    }
}

