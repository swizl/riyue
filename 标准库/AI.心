// 文本以 前缀 开头 → 1/0（空前缀 → 1）
函数 (文本:字符串, 前缀:字符串)AI以开头(0 = 结果:整数) {
    0 = 文本长;
    0 = 前缀长;
    0 = j;
    0 = 码;
    0 = 乙;
    0 = 停;
    (文本)长度 = 文本长;
    (前缀)长度 = 前缀长;
    如果 (前缀长 <= 文本长) {
        1 = 结果;
        0 = j;
        0 = 停;
        当 (j < 前缀长 && 停 ?= 0) {
            (文本, j)字符码 = 码;
            (前缀, j)字符码 = 乙;
            如果 (码 ?= 乙) {
                j + 1 = j;
            } 否则 {
                1 = 停;
                0 = 结果;
            }
        }
    }
}

