        契约失败数 + 1 = 契约失败数;
        ("  ✗ 后置: ")打印;
        (信息)打印;
    }
}

// 不变式：任意时刻必须成立
函数 (条件:整数, 信息:字符串)不变式(空) {
    如果 (条件 ?= 1) {
        契约通过数 + 1 = 契约通过数;
        ("  ✓ 不变式: ")打印;
        (信息)打印;
