        如果 (值 <= 高) {
            契约通过数 + 1 = 契约通过数;
            ("  ✓ 前置区间: ")打印;
            (信息)打印;
        } 否则 {
            契约失败数 + 1 = 契约失败数;
            ("  ✗ 前置区间: ")打印;
            (信息)打印;
            (" 越上界=")打印;
            (高)打印;
            (" 实际=")打印;
            (值)打印;
        }
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 前置区间: ")打印;
