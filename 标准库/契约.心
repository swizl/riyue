// 日月标准库 - 契约（Design by Contract：前置 / 后置 / 不变式 运行期检查）
// 8CE：纯 `.心`，双链一致。
//   · 全部检查运行期求值：命中记通过数，违背记失败数，并各自打印一行；
//   · 计数为模块级全局（函数内以「读改写」惯用法访问），`契约重置` 归零以便多组用例复用。
//   · 形参约定：条件为「整数」布尔量（1 真 / 0 假），信息为「字符串」描述。

0 = 契约通过数:整数;
0 = 契约失败数:整数;

// 前置条件：调用方必须满足
函数 (条件:整数, 信息:字符串)要求(空) {
    如果 (条件 ?= 1) {
        契约通过数 + 1 = 契约通过数;
        ("  ✓ 前置: ")打印;
        (信息)打印;
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 前置: ")打印;
        (信息)打印;
    }
}

// 后置条件：被调方保证满足
函数 (条件:整数, 信息:字符串)确保(空) {
    如果 (条件 ?= 1) {
        契约通过数 + 1 = 契约通过数;
        ("  ✓ 后置: ")打印;
        (信息)打印;
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 后置: ")打印;
        (信息)打印;
    }
}

// 不变式：任意时刻必须成立
函数 (条件:整数, 信息:字符串)不变式(空) {
    如果 (条件 ?= 1) {
        契约通过数 + 1 = 契约通过数;
        ("  ✓ 不变式: ")打印;
        (信息)打印;
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 不变式: ")打印;
        (信息)打印;
    }
}

// 区间前置：低 ≤ 值 ≤ 高
函数 (值:整数, 低:整数, 高:整数, 信息:字符串)要求区间(空) {
    如果 (值 >= 低) {
        如果 (值 <= 高) {
            契约通过数 + 1 = 契约通过数;
            ("  ✓ 前置区间: ")打印;
            (信息)打印;
        } 否则 {
            契约失败数 + 1 = 契约失败数;
            ("  ✗ 前置区间: ")打印;
            (信息)打印;
            (" 越上界=")打印;
            (高)打印;
            (" 实际=")打印;
            (值)打印;
        }
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 前置区间: ")打印;
        (信息)打印;
        (" 越下界=")打印;
        (低)打印;
        (" 实际=")打印;
        (值)打印;
    }
}

// 契约结果汇总
函数 契约总结(空) {
    ("---")打印;
    ("契约结果: ")打印;
    (契约通过数)打印;
    (" 通过, ")打印;
    (契约失败数)打印;
    (" 失败")打印;
}

// 计数归零（「读改写」惯用法确保解析为模块级全局）
函数 契约重置(空) {
    契约通过数 - 契约通过数 = 契约通过数;
    契约失败数 - 契约失败数 = 契约失败数;
}

// 前置：值 > 0（8CI）
函数 (值:整数, 信息:字符串)要求正(空) {
    如果 (值 > 0) {
        契约通过数 + 1 = 契约通过数;
        ("  ✓ 前置正: ")打印;
        (信息)打印;
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 前置正: ")打印;
        (信息)打印;
        (" 实际=")打印;
        (值)打印;
    }
}

// 前置：值 >= 0（8CI）
函数 (值:整数, 信息:字符串)要求非负(空) {
    如果 (值 >= 0) {
        契约通过数 + 1 = 契约通过数;
        ("  ✓ 前置非负: ")打印;
        (信息)打印;
    } 否则 {
        契约失败数 + 1 = 契约失败数;
        ("  ✗ 前置非负: ")打印;
        (信息)打印;
        (" 实际=")打印;
        (值)打印;
    }
}

// 全通过判定：失败数为 0 → 1，否则 0（8CI）
函数 契约是否全通过(0 = 结果:整数) {
    0 = 结果;
    如果 (契约失败数 ?= 0) {
        1 = 结果;
    }
}

// 取计数到输出数组：槽 0 = 通过数，槽 1 = 失败数（槽位须已预置 ≥ 2）（8CI）
函数 (输出)契约计数(空) {
    (输出, 0, 契约通过数)动态数组设置;
    (输出, 1, 契约失败数)动态数组设置;
}
