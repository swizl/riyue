// 日月标准库 - 单元测试框架

0 = 变量 测试通过数;
0 = 变量 测试失败数;

函数 (条件:整数, 消息:字符串)断言 {
    如果 (条件 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
    }
}

函数 (实际:整数, 期望:整数, 消息:字符串)断言等于 {
    如果 (实际 ?= 期望) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 期望=")打印;
        (期望)打印;
        (" 实际=")打印;
        (实际)打印;
    }
}

函数 测试总结 {
    ("---")打印;
    ("测试结果: ")打印;
    (测试通过数)打印;
    (" 通过, ")打印;
    (测试失败数)打印;
    (" 失败")打印;
}
