// 日月标准库 - 单元测试框架

导入 "正则.心";

0 = 测试通过数:整数;
0 = 测试失败数:整数;

函数 (条件:整数, 消息:字符串)断言(空) {
    如果 (条件 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
    }
}

函数 (实际:整数, 期望:整数, 消息:字符串)断言等于(空) {
    如果 (实际 ?= 期望) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 期望=")打印;
        (期望)打印;
        (" 实际=")打印;
        (实际)打印;
    }
}

函数 测试总结(空) {
    ("---")打印;
    ("测试结果: ")打印;
    (测试通过数)打印;
    (" 通过, ")打印;
    (测试失败数)打印;
    (" 失败")打印;
}

// ==================== 8AU：扩展断言库（纯 `.心`，双链一致） ====================
//   · 复用 测试通过数/测试失败数 与既有 ✓/✗ 输出范式，纯附加、不破坏既有消费方；
//   · `断言近似` 取绝对值内建缺失，改以「先比大小、再作差」规避负号。

// 断言 实际 ≠ 期望
函数 (实际:整数, 期望:整数, 消息:字符串)断言不等于(空) {
    如果 (实际 != 期望) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 不应等于=")打印;
        (期望)打印;
    }
}

// 断言 实际 > 期望
