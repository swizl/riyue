// 断言 低 ≤ 值 ≤ 高
函数 (值:整数, 低:整数, 高:整数, 消息:字符串)断言区间(空) {
    如果 (值 >= 低) {
        如果 (值 <= 高) {
            测试通过数 + 1 = 测试通过数;
            ("  ✓ ")打印;
            (消息)打印;
        } 否则 {
            测试失败数 + 1 = 测试失败数;
            ("  ✗ ")打印;
            (消息)打印;
            (" 越上界=")打印;
            (高)打印;
            (" 实际=")打印;
            (值)打印;
        }
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 越下界=")打印;
        (低)打印;
        (" 实际=")打印;
        (值)打印;
    }
}

