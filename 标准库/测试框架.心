        (文本)打印;
    }
}

// 断言 文本 以 后缀 结尾
函数 (文本:字符串, 后缀:字符串, 消息:字符串)断言文本结尾(空) {
    (文本)长度 = 文长;
    (后缀)长度 = 后长;
    0 = 命中;
    如果 (后长 <= 文长) {
        (文本, 文长 - 后长, 后长)子串 = 尾;
        (尾, 后缀)文本相等 = 命中;
    }
    如果 (命中 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
