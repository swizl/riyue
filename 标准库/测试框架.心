// ==================== 8BA：断言库续 - 文本与数组（纯 `.心`，双链一致） ====================
//   · 文本相等以「长度相同 + `查找` 命中于 0」判定（空串须长度亦为 0，避免空串误判）。
//   · 数组句柄参数**不加类型标注**（否则自举链按值传递、`动态数组获取`/`动态字符串数组获取` 取空）。

// 文本相等判定：长度相同且 `查找` 命中于 0（空串须长度亦为 0）
函数 (甲:字符串, 乙:字符串)文本相等(0 = 相等:整数) {
    0 = 长甲;
    0 = 长乙;
    0 = 位;
    0 = 相等;
    (甲)长度 = 长甲;
    (乙)长度 = 长乙;
    如果 (长甲 ?= 长乙) {
        如果 (长甲 ?= 0) {
            1 = 相等;
        } 否则 {
            (甲, 乙)查找 = 位;
            如果 (位 ?= 0) { 1 = 相等; }
        }
    }
}

// 断言 实际文本 等于 期望文本
函数 (实际:字符串, 期望:字符串, 消息:字符串)断言文本等于(空) {
    (实际, 期望)文本相等 = 相等;
    如果 (相等 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 期望=")打印;
        (期望)打印;
        (" 实际=")打印;
        (实际)打印;
    }
}

// 断言 文本 以 前缀 开头
函数 (文本:字符串, 前缀:字符串, 消息:字符串)断言文本开头(空) {
    (文本)长度 = 文长;
    (前缀)长度 = 前长;
    0 = 命中;
    如果 (前长 <= 文长) {
        (文本, 0, 前长)子串 = 头;
        (头, 前缀)文本相等 = 命中;
    }
    如果 (命中 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
