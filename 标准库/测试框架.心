        ()获取时间戳 = 止;
        止 - 起 = 耗时;
        轮 + 1 = 轮;
        如果 (耗时 >= 1) {
            1 = 停;
        } 否则 {
            批 * 2 = 批;
        }
    }
    批 = 基准迭代数;
    耗时 = 基准耗时秒;
    0 = 基准每秒次;
    如果 (耗时 > 0) {
        批 / 耗时 = 基准每秒次;
    }
}

