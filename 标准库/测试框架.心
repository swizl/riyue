// 断言 |实际 - 期望| ≤ 容差（浮点）
函数 (实际:浮点, 期望:浮点, 容差:浮点, 消息:字符串)断言近似(空) {
    如果 (实际 >= 期望) {
        如果 (实际 - 期望 <= 容差) {
            测试通过数 + 1 = 测试通过数;
            ("  ✓ ")打印;
            (消息)打印;
        } 否则 {
            测试失败数 + 1 = 测试失败数;
            ("  ✗ ")打印;
            (消息)打印;
        }
    } 否则 {
        如果 (期望 - 实际 <= 容差) {
            测试通过数 + 1 = 测试通过数;
            ("  ✓ ")打印;
            (消息)打印;
        } 否则 {
            测试失败数 + 1 = 测试失败数;
            ("  ✗ ")打印;
            (消息)打印;
        }
    }
}

// 断言 文本 包含 子串（`查找` 未命中返回 -1）
函数 (文本:字符串, 子串:字符串, 消息:字符串)断言包含(空) {
    (文本, 子串)查找 = 位置;
    如果 (位置 >= 0) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 未包含=")打印;
        (子串)打印;
    }
}

// ==================== 8AW：断言库续（纯 `.心`，双链一致） ====================
