    (率值)整数转字符串 = 率;
    ("用例: 通过 ", 通)拼接 = 行;
    (行, " / 失败 ")拼接 = 行;
    (行, 失)拼接 = 行;
    (行, " / 跳过 ")拼接 = 行;
    (行, 跳)拼接 = 行;
    (行, " / 通过率 ")拼接 = 行;
    (行, 率)拼接 = 行;
