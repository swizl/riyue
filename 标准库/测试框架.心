    当 (i < 长) {
        (数组, i)动态字符串数组获取 = 当前;
        (当前, 值)文本相等 = 等;
        如果 (等 ?= 1) { 1 = 命中; }
        i + 1 = i;
    }
    如果 (命中 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
