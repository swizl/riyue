}

// 按过滤词运行：命中 → 执行；未命中 → 记为跳过
函数 (名称:字符串, 过滤词:字符串, 主体:函数)测试运行过滤(空) {
    (名称, 过滤词)测试名匹配 = 命中;
    如果 (命中 ?= 1) {
        (名称, 主体)测试运行;
    } 否则 {
        (名称)测试跳过;
    }
}

// 断言 主体 必须抛出（捕获到一次即通过）
函数 (主体:函数, 消息:字符串)断言抛出(空) {
    0 = 已抛;
    尝试 {
        ()主体;
    } 捕获 (错误) {
        1 = 已抛;
    }
    如果 (已抛 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ", 消息)拼接 = 行;
        (行)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ", 消息)拼接 = 行;
        (行)打印;
        (" 未抛出异常")打印;
    }
}

// 断言 主体 不得抛出
函数 (主体:函数, 消息:字符串)断言不抛出(空) {
