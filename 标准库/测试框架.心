        (消息)打印;
        (" 期望后缀=")打印;
        (后缀)打印;
        (" 实际=")打印;
        (文本)打印;
    }
}

// 断言 整数数组 与 期望 逐元素相等（长度相同且对应元素皆相等）
函数 (实际, 期望, 消息:字符串)断言整数数组等于(空) {
    (实际)动态数组大小 = 长实;
    (期望)动态数组大小 = 长期;
    0 = 相等;
    0 = i;
    0 = 实值;
    0 = 期值;
    如果 (长实 ?= 长期) {
        1 = 相等;
        当 (i < 长实) {
            如果 (相等 ?= 1) {
                (实际, i)动态数组获取 = 实值;
                (期望, i)动态数组获取 = 期值;
                如果 (实值 != 期值) { 0 = 相等; }
            }
            i + 1 = i;
        }
    }
    如果 (相等 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 期望长度=")打印;
        (长期)打印;
        (" 实际长度=")打印;
        (长实)打印;
    }
}

// 断言 字符串数组 与 期望 逐元素相等（长度相同且对应元素皆相等）
函数 (实际, 期望, 消息:字符串)断言字符串数组等于(空) {
    (实际)动态字符串数组大小 = 长实;
    (期望)动态字符串数组大小 = 长期;
    0 = 相等;
    0 = i;
    0 = 等;
    如果 (长实 ?= 长期) {
        1 = 相等;
        当 (i < 长实) {
            如果 (相等 ?= 1) {
                (实际, i)动态字符串数组获取 = 实值;
                (期望, i)动态字符串数组获取 = 期值;
                (实值, 期值)文本相等 = 等;
                如果 (等 ?= 0) { 0 = 相等; }
            }
            i + 1 = i;
        }
    }
    如果 (相等 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 期望长度=")打印;
        (长期)打印;
        (" 实际长度=")打印;
        (长实)打印;
    }
}

// 断言 整数数组 含 值
函数 (数组, 值:整数, 消息:字符串)断言数组含整数(空) {
    (数组)动态数组大小 = 长;
    0 = 命中;
    0 = i;
    0 = 当前;
    当 (i < 长) {
        (数组, i)动态数组获取 = 当前;
        如果 (当前 ?= 值) { 1 = 命中; }
        i + 1 = i;
    }
    如果 (命中 ?= 1) {
        测试通过数 + 1 = 测试通过数;
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        测试失败数 + 1 = 测试失败数;
        ("  ✗ ")打印;
        (消息)打印;
        (" 未包含=")打印;
        (值)打印;
    }
}

// 断言 字符串数组 含 值
函数 (数组, 值:字符串, 消息:字符串)断言数组含文本(空) {
    (数组)动态字符串数组大小 = 长;
