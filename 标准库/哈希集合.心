// 日月标准库 - 哈希集合（开放寻址 + 线性探测，泛型元素）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 泛型结构体（同 优先队列.心/双端队列.心/链表.心）：规避自举链对非泛型结构体
//     方法体内 `(成员数组, i)动态数组获取` 与后续方法共存的顺序敏感缺陷。
//   · 结构：键 存于 键: T[]，另有 占用: 整数[]（1 已用 / 0 空）标记槽位。
//   · **容量在 初始化(容) 时固定，不自动扩容**：调用方须预留 > 元素数 的容量，
//     否则满载时探测死循环。
//   · 键须为**非负整数**（哈希位置 = 值 % 容量；负键取模为负，未定义）。
//   · **不支持删除**（无墓碑；删除会断链，后续探测失真）。
// 创建：哈希集合<整数> { 键: ()创建动态数组, 占用: ()创建动态数组, 容量: 0, 数量: 0 } = s;
//       s.初始化(16);

结构体 哈希集合<T> {
    键: T[];
    占用: 整数[];
    容量: 整数;
    数量: 整数;

    // 预置 容 个空槽（占用全 0）
    方法 初始化(容: 整数) {
        容 = 哈希集合.容量;
        0 = i;
        0 = 停;
        当 (停 ?= 0) {
            如果 (i >= 哈希集合.容量) {
                1 = 停;
            } 否则 {
                (哈希集合.键, 0)动态数组添加;
                (哈希集合.占用, 0)动态数组添加;
                i + 1 = i;
            }
        }
        0 = 哈希集合.数量;
    }

    // 添加元素（已存在则去重）
    方法 添加(值: T) {
        值 % 哈希集合.容量 = 位置;
        0 = 停;
        当 (停 ?= 0) {
            (哈希集合.占用, 位置)动态数组获取 = 占;
            如果 (占 ?= 0) {
                (哈希集合.键, 位置, 值)动态数组设置;
                (哈希集合.占用, 位置, 1)动态数组设置;
                哈希集合.数量 + 1 = 哈希集合.数量;
                1 = 停;
            } 否则 {
                (哈希集合.键, 位置)动态数组获取 = 键值;
                如果 (键值 ?= 值) {
                    1 = 停;
                } 否则 {
                    位置 + 1 = 位置;
                    如果 (位置 >= 哈希集合.容量) {
                        0 = 位置;
                    }
                }
            }
        }
    }

    // 是否包含元素（返回 1 / 0）
    方法 包含(值: T)(0 = 结果: 整数) {
        值 % 哈希集合.容量 = 位置;
        0 = 结果;
        0 = 计;
        0 = 停;
        当 (停 ?= 0) {
            如果 (计 >= 哈希集合.容量) {
                1 = 停;
            } 否则 {
                (哈希集合.占用, 位置)动态数组获取 = 占;
                如果 (占 ?= 0) {
                    1 = 停;
                } 否则 {
                    (哈希集合.键, 位置)动态数组获取 = 键值;
                    如果 (键值 ?= 值) {
                        1 = 结果;
                        1 = 停;
                    } 否则 {
                        位置 + 1 = 位置;
                        如果 (位置 >= 哈希集合.容量) {
                            0 = 位置;
                        }
                        计 + 1 = 计;
                    }
                }
            }
        }
    }

    // 当前元素个数
    方法 长度()(0 = 结果: 整数) {
        哈希集合.数量 = 结果;
    }
}