// 日月标准库 - 二进制序列化（字节数组接口，双链一致）
//
// 说明：
//   · 纯 .心 实现，不依赖任何编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 二进制负载以「整数数组」承载（每元素 0..255）；宿主链 `文本` 为裸 char* 且以 NUL 结尾，
//     原始字节含 0x00 会被截断，故不用 文本 承载二进制（同 标准库/摘要.心、标准库/AES.心）。
//   · 数组句柄参数以「无类型标注」表示（见 语法规范.md:904）；调用一律前缀括号形式 (参数)函数名。
//   · 整数字节序为**小端**（32 位有符号，按二补码原样）；长度/计数用 **LEB128 变长无符号**（更紧凑）。
//   · 文本按「码点」遍历（长度/字符码 均按码点，实测双链一致），逐码点做 **UTF-8** 编码；
//     先写字节长度（变长），读取端据此精确消费。
//   · 位或 `|` 在表达式位置被管道解析器优先消费，本模块只用 `&`/`^`/`+`/`-`/移位/`<|`/`>|`。
//   · 字符结果「即取即拼」：同一时刻只持有一个 `(码)字符` 结果并立即拼接
//     （宿主链字符串为裸 char*、生产者共享静态缓冲；即取即拼使两链一致，同 标准库/编码.心）。
//   · 返回值一律写进「返回标注」位（如 `(0 = 结果:整数)`），不可写成形参，否则返回类型退化为 `空`。

// 追加单字节（取低 8 位）
函数 (值:整数, 输出)二进制写字节(空) {
    (输出, 值 & 255)动态数组添加;
}

// 从 输入 的 游标[0] 处取一字节，游标自增 1
函数 (输入, 游标)二进制取字节(0 = 结果:整数) {
    (游标, 0)动态数组获取 = 位置;
    (输入, 位置)动态数组获取 = 结果;
    位置 + 1 = 位置;
    (游标, 0, 位置)动态数组设置;
}

// 追加 32 位有符号整数（小端 4 字节）
函数 (值:整数, 输出)二进制写整数(空) {
    (值 & 255, 输出)二进制写字节;
    ((值 >| 8) & 255, 输出)二进制写字节;
    ((值 >| 16) & 255, 输出)二进制写字节;
    ((值 >| 24) & 255, 输出)二进制写字节;
}

// 读 32 位有符号整数（小端 4 字节），游标自增 4
函数 (输入, 游标)二进制读整数(0 = 结果:整数) {
    (输入, 游标)二进制取字节 = b0;
    (输入, 游标)二进制取字节 = b1;
    (输入, 游标)二进制取字节 = b2;
    (输入, 游标)二进制取字节 = b3;
    b0 = 值;
    b1 <| 8 = 段;
    值 + 段 = 值;
    b2 <| 16 = 段;
    值 + 段 = 值;
    b3 <| 24 = 段;
    值 + 段 = 值;
    值 = 结果;
}

// 追加 LEB128 变长无符号整数（非负；用于长度/计数）
函数 (值:整数, 输出)二进制写变长(空) {
    值 = 余;
    1 = 更多;
    当 (更多 ?= 1) {
        如果 (余 < 128) {
            (余, 输出)二进制写字节;
            0 = 更多;
        } 否则 {
            余 & 127 = 低;
            低 + 128 = 低;
            (低, 输出)二进制写字节;
            余 >| 7 = 余;
        }
    }
}

// 读 LEB128 变长无符号整数，游标前进若干字节
函数 (输入, 游标)二进制读变长(0 = 结果:整数) {
    0 = 移位;
    0 = 值;
    1 = 更多;
    当 (更多 ?= 1) {
        (输入, 游标)二进制取字节 = b;
        如果 ((b & 128) ?= 0) {
            b <| 移位 = 段;
            值 + 段 = 值;
            0 = 更多;
        } 否则 {
            (b & 127) = 低;
            低 <| 移位 = 段;
            值 + 段 = 值;
            移位 + 7 = 移位;
        }
    }
    值 = 结果;
}

// 码点 → UTF-8 字节（1..4 字节），追加到 输出
函数 (码:整数, 输出)二进制写码点(空) {
    如果 (码 < 128) {
        (码, 输出)二进制写字节;
    } 否则如果 (码 < 2048) {
        (192 + (码 >| 6), 输出)二进制写字节;
        (128 + (码 & 63), 输出)二进制写字节;
    } 否则如果 (码 < 65536) {
        (224 + (码 >| 12), 输出)二进制写字节;
        (128 + ((码 >| 6) & 63), 输出)二进制写字节;
        (128 + (码 & 63), 输出)二进制写字节;
    } 否则 {
        (240 + (码 >| 18), 输出)二进制写字节;
        (128 + ((码 >| 12) & 63), 输出)二进制写字节;
        (128 + ((码 >| 6) & 63), 输出)二进制写字节;
        (128 + (码 & 63), 输出)二进制写字节;
    }
}

// 从 输入 的 游标处读一个 UTF-8 码点，游标前进对应字节数
函数 (输入, 游标)二进制读码点(0 = 结果:整数) {
    0 = b1;
    0 = b2;
    0 = b3;
    (输入, 游标)二进制取字节 = b0;
    如果 (b0 < 128) {
        b0 = 结果;
    } 否则如果 (b0 < 224) {
        (输入, 游标)二进制取字节 = b1;
        (b0 & 31) <| 6 = 高;
        高 + (b1 & 63) = 结果;
    } 否则如果 (b0 < 240) {
        (输入, 游标)二进制取字节 = b1;
        (输入, 游标)二进制取字节 = b2;
        (b0 & 15) <| 12 = 高;
        高 + ((b1 & 63) <| 6) = 高;
        高 + (b2 & 63) = 结果;
    } 否则 {
        (输入, 游标)二进制取字节 = b1;
        (输入, 游标)二进制取字节 = b2;
        (输入, 游标)二进制取字节 = b3;
        (b0 & 7) <| 18 = 高;
        高 + ((b1 & 63) <| 12) = 高;
        高 + ((b2 & 63) <| 6) = 高;
        高 + (b3 & 63) = 结果;
    }
}

// 追加文本：先写「UTF-8 字节长度」（变长），再逐码点写 UTF-8
函数 (文本:字符串, 输出)二进制写文本(空) {
    (文本)长度 = 总长;
    0 = 字节数;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        1 = 宽;
        如果 (码 >= 128) { 2 = 宽; }
        如果 (码 >= 2048) { 3 = 宽; }
        如果 (码 >= 65536) { 4 = 宽; }
        字节数 + 宽 = 字节数;
        i + 1 = i;
    }
    (字节数, 输出)二进制写变长;
    0 = j;
    当 (j < 总长) {
        (文本, j)字符码 = 码;
        (码, 输出)二进制写码点;
        j + 1 = j;
    }
}

// 读文本：先读字节长度（变长），再按字节边界逐码点解码为文本
函数 (输入, 游标)二进制读文本("" = 结果:字符串) {
    (输入, 游标)二进制读变长 = 字节数;
    (游标, 0)动态数组获取 = 位置;
    位置 + 字节数 = 止;
    "" = 输出;
    0 = 停;
    当 (停 ?= 0) {
        (游标, 0)动态数组获取 = 位置;
        如果 (位置 >= 止) {
            1 = 停;
        } 否则 {
            (输入, 游标)二进制读码点 = 码;
            (码)字符 = 字符;
            (输出, 字符)拼接 = 输出;
        }
    }
    输出 = 结果;
}

// 追加字节块：先写「字节个数」（变长），再原样写各字节
函数 (字节数组, 输出)二进制写字节块(空) {
    (字节数组)动态数组大小 = 个数;
    (个数, 输出)二进制写变长;
    0 = i;
    当 (i < 个数) {
        (字节数组, i)动态数组获取 = b;
        (b, 输出)二进制写字节;
        i + 1 = i;
    }
}

// 读字节块：读「字节个数」（变长）后把各字节追加到 输出 句柄，归返个数
函数 (输入, 游标, 输出)二进制读字节块(0 = 结果:整数) {
    (输入, 游标)二进制读变长 = 个数;
    0 = i;
    当 (i < 个数) {
        (输入, 游标)二进制取字节 = b;
        (输出, b)动态数组添加;
        i + 1 = i;
    }
    个数 = 结果;
}

// 半字节（0..15）→ 十六进制字符；越界归返 "?"
函数 (值:整数)二进制十六进制字符("?" = 结果:字符串) {
    "0123456789abcdef" = 表;
    如果 (值 < 16) {
        (表, 值)字符码 = 码;
        (码)字符 = 结果;
    }
}

// 字节数组 → 小写十六进制文本（便于查看/测试）
函数 (字节数组)二进制转十六进制("" = 结果:字符串) {
    (字节数组)动态数组大小 = 个数;
    "" = 输出;
    0 = i;
    当 (i < 个数) {
        (字节数组, i)动态数组获取 = b;
        b / 16 = 高;
        b % 16 = 低;
        (高)二进制十六进制字符 = 高字符;
        (输出, 高字符)拼接 = 输出;
        (低)二进制十六进制字符 = 低字符;
        (输出, 低字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}
