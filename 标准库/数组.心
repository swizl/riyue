// 日月标准库 - 数组工具

函数 (arr, size)数组最大值(0 = 结果:整数) {
    (arr, 0)动态数组获取 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 > 结果) { 当前值 = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组最小值(0 = 结果:整数) {
    (arr, 0)动态数组获取 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 < 结果) { 当前值 = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组求和(0 = 结果:整数) {
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        结果 + 当前值 = 结果;
        i + 1 = i;
    }
}

函数 (arr, size, 目标)查找(0 = 结果:整数) {
    -1 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { i = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组复制(0 = 结果:整数) {
    ()创建动态数组 = 新数组;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 值;
        (新数组, 值)动态数组添加;
        i + 1 = i;
    }
    新数组 = 结果;
}

函数 (arr, size)数组翻转 {
    0 = 左;
    size - 1 = 右;
    当 (左 < 右) {
        (arr, 左)动态数组获取 = 左值;
        (arr, 右)动态数组获取 = 右值;
        (arr, 左, 右值)动态数组设置;
        (arr, 右, 左值)动态数组设置;
        左 + 1 = 左;
        右 - 1 = 右;
    }
}

函数 (arr, size, 分隔符)数组连接("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    当 (i < size) {
        如果 (i > 0) { (输出, 分隔符)拼接 = 输出; }
        (arr, i)动态数组获取 = 值;
        (值)转字符串 = 值字符串;
        (输出, 值字符串)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// ==================== 8BI：数组统计与判定（纯 `.心`，双链一致） ====================
//   · 承接既有 `数组最大值`/`数组最小值`/`数组求和`/`查找`/`数组复制`/`数组翻转`/`数组连接`。
//   · 整数数组句柄参数**不加类型标注**（同 `集合.心`/`整数数组.心`）；赋值目标恒在 `=` 右侧
//     （`当前值 = 最大;` 即 `最大 := 当前值`；`i = 结果;` 即 `结果 := i`）。

// 统计 arr 中等于 目标 的元素个数
函数 (arr, size, 目标)数组计数(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { 结果 + 1 = 结果; }
        i + 1 = i;
    }
}

// 首个最大值的下标（空数组 → -1）
函数 (arr, size)数组最大值索引(0 = 结果:整数) {
    -1 = 结果;
    如果 (size > 0) {
        0 = 结果;
        (arr, 0)动态数组获取 = 最大;
        1 = i;
        当 (i < size) {
            (arr, i)动态数组获取 = 当前值;
            如果 (当前值 > 最大) {
                当前值 = 最大;
                i = 结果;
            }
            i + 1 = i;
        }
    }
}

// 首个最小值的下标（空数组 → -1）
函数 (arr, size)数组最小值索引(0 = 结果:整数) {
    -1 = 结果;
    如果 (size > 0) {
        0 = 结果;
        (arr, 0)动态数组获取 = 最小;
        1 = i;
        当 (i < size) {
            (arr, i)动态数组获取 = 当前值;
            如果 (当前值 < 最小) {
                当前值 = 最小;
                i = 结果;
            }
            i + 1 = i;
        }
    }
}

// 是否非递减（升序，允许相等）；空数组或单元素 → 1
函数 (arr, size)数组是否升序(0 = 结果:整数) {
    1 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 < 前值) { 0 = 结果; }
        i + 1 = i;
    }
}

// 是否非递增（降序，允许相等）；空数组或单元素 → 1
函数 (arr, size)数组是否降序(0 = 结果:整数) {
    1 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 > 前值) { 0 = 结果; }
        i + 1 = i;
    }
}

// 原地把 arr 变为前缀和（arr[i] := 前 i+1 项之和）
函数 (arr, size)数组前缀和 {
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        前值 + 当前值 = 新值;
        (arr, i, 新值)动态数组设置;
        i + 1 = i;
    }
}

// ==================== 8BL：数组切片 / 填充 / 旋转 / 末次查找（纯 `.心`，双链一致） ====================
//   · 承接 8BI；**句柄参数不加类型标注、标量参数须标注 `:整数`**
//     （未标注且仅出现在 `动态数组设置` 的形参会被推断为「指针」⇒ 自举链类型不匹配，见下）。
//   · 赋值目标恒在 `=` 右侧（`起 = 开始;` 即 `开始 := 起`；`步 + size = 步;` 即 `步 := 步 + size`）。
//   · 仅用两链皆已支持的内建/运算（动态数组获取/设置/添加/大小、整除 `/` 与取余 `%`）。

// 取 arr[起, 末) 追加到 目标数组（越界自动收拢：起<0→0、末>size→size、末<=起→不追加）；返回追加个数
函数 (arr, size:整数, 起:整数, 末:整数, 目标)数组切片到(0 = 结果:整数) {
    0 = 结果;
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    开始 = i;
    当 (i < 结束) {
        (arr, i)动态数组获取 = 值;
        (目标, 值)动态数组添加;
        结果 + 1 = 结果;
        i + 1 = i;
    }
}

// 原地把 arr[起, 末) 全部设为 值（越界自动收拢，同 数组切片到）
函数 (arr, size:整数, 起:整数, 末:整数, 值:整数)数组填充 {
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    开始 = i;
    当 (i < 结束) {
        (arr, i, 值)动态数组设置;
        i + 1 = i;
    }
}

// 原地循环左移 位移 位（位移 可为负/超界，按 `位移 % size` 归一；size<=1 不动）
函数 (arr, size:整数, 位移:整数)数组旋转 {
    如果 (size > 1) {
        位移 % size = 步;
        如果 (步 < 0) { 步 + size = 步; }
        如果 (步 > 0) {
            ()创建动态数组 = 临时;
            步 = i;
            当 (i < size) {
                (arr, i)动态数组获取 = 值;
                (临时, 值)动态数组添加;
                i + 1 = i;
            }
            0 = i;
            当 (i < 步) {
                (arr, i)动态数组获取 = 值;
                (临时, 值)动态数组添加;
                i + 1 = i;
            }
            0 = i;
            当 (i < size) {
                (临时, i)动态数组获取 = 值;
                (arr, i, 值)动态数组设置;
                i + 1 = i;
            }
        }
    }
}

// 末个等于 目标 的下标（未找到 → -1）
函数 (arr, size:整数, 目标:整数)查找末次(0 = 结果:整数) {
    -1 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { i = 结果; }
        i + 1 = i;
    }
}

// ==================== 8BP：数组区间删除 / 反转 / 求和 / 包含（纯 `.心`，双链一致） ====================
//   · 承接 8BI/8BL；**句柄参数不加类型标注、标量参数须标注 `:整数`**。
//   · 赋值目标恒在 `=` 右侧（`size = 结果;` 即 `结果 := size`；`i + 1 = i;` 即 `i := i + 1`）。
//   · 仅用两链皆已支持的内建/运算（动态数组获取/设置、比较/逻辑运算符）。

// 原地删除 arr[起, 末)（末之后的元素左移补位）；越界自动收拢；返回删除后的长度
函数 (arr, size:整数, 起:整数, 末:整数)数组删除区间(0 = 结果:整数) {
    size = 结果;
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    如果 (结束 > 开始) {
        开始 = i;
        结束 = j;
        当 (j < size) {
            (arr, j)动态数组获取 = 值;
            (arr, i, 值)动态数组设置;
            i + 1 = i;
            j + 1 = j;
        }
        size - (结束 - 开始) = 结果;
    }
}

// 原地反转 arr[起, 末)（越界自动收拢；空区间不动）
函数 (arr, size:整数, 起:整数, 末:整数)数组反转区间 {
    0 = 左;
    如果 (起 > 0) { 起 = 左; }
    size = 右;
    如果 (末 < size) { 末 = 右; }
    右 - 1 = 右;
    当 (左 < 右) {
        (arr, 左)动态数组获取 = 左值;
        (arr, 右)动态数组获取 = 右值;
        (arr, 左, 右值)动态数组设置;
        (arr, 右, 左值)动态数组设置;
        左 + 1 = 左;
        右 - 1 = 右;
    }
}

// arr[起, 末) 的元素之和（越界自动收拢；空区间 → 0）
函数 (arr, size:整数, 起:整数, 末:整数)数组区间求和(0 = 结果:整数) {
    0 = 结果;
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    开始 = i;
    当 (i < 结束) {
        (arr, i)动态数组获取 = 值;
        结果 + 值 = 结果;
        i + 1 = i;
    }
}

// arr 中是否含 目标 → 1/0（空数组 → 0）
函数 (arr, size:整数, 目标:整数)数组是否包含(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { 1 = 结果; }
        i + 1 = i;
    }
}

// ==================== 8BV：数组续增（逆序追加 / 区间计数 / 回文判定 / 相邻最大差）——纯 `.心`，双链一致 ====================
//   · 承接 8BI/8BL/8BP；**句柄参数不加类型标注、标量参数须标注 `:整数`**。
//   · 赋值目标恒在 `=` 右侧（`size - 1 = i;` 即 `i := size - 1`；`结果 + 1 = 结果;` 即 `结果 := 结果 + 1`）。
//   · 仅用两链皆已支持的内建/运算（动态数组获取/添加、比较/逻辑运算符）。

// 把 arr 反向逐元素追加到 目标；返回追加个数（目标原有内容保留）
函数 (arr, size:整数, 目标)数组逆序追加(0 = 结果:整数) {
    0 = 结果;
    size - 1 = i;
    当 (i >= 0) {
        (arr, i)动态数组获取 = 值;
        (目标, 值)动态数组添加;
        结果 + 1 = 结果;
        i - 1 = i;
    }
}

// 统计 arr 中落在闭区间 [低, 高] 内的元素个数
函数 (arr, size:整数, 低:整数, 高:整数)数组区间计数(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 值;
        如果 (值 >= 低 && 值 <= 高) { 结果 + 1 = 结果; }
        i + 1 = i;
    }
}

// 是否回文（正读反读相同）→ 1/0；空数组或单元素 → 1
函数 (arr, size:整数)数组是回文(0 = 结果:整数) {
    1 = 结果;
    0 = 左;
    size - 1 = 右;
    当 (左 < 右) {
        (arr, 左)动态数组获取 = 左值;
        (arr, 右)动态数组获取 = 右值;
        如果 (左值 != 右值) { 0 = 结果; }
        左 + 1 = 左;
        右 - 1 = 右;
    }
}

// 相邻元素差的最大绝对值（|arr[i+1]-arr[i]|）；空数组或单元素 → 0
函数 (arr, size:整数)数组相邻最大差(0 = 结果:整数) {
    0 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        当前值 - 前值 = 差;
        如果 (差 < 0) { 0 - 差 = 差; }
        如果 (差 > 结果) { 差 = 结果; }
        i + 1 = i;
    }
}

// ==================== 8BY：数组删除与重复判定（删除首个值 / 删除所有值 / 是否含重复 / 众数）——纯 `.心`，双链一致 ====================
//   · 承接 8BI/8BP/8BV；**句柄参数（数组）不加类型标注、标量参数须标注 `:整数`**。
//   · 赋值目标恒在 `=` 右侧（`写 + 1 = 写;` 即 写 := 写 + 1）；仅用两链皆已支持的内建/运算。

// 删除首个等于 值 的元素（其后元素左移补位）；返回删后长度；未命中 → 原长度
函数 (arr, size:整数, 值:整数)数组删除首个值(0 = 结果:整数) {
    size = 结果;
    0 - 1 = 命中;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 值 && 命中 < 0) { i = 命中; }
        i + 1 = i;
    }
    如果 (命中 >= 0) {
        命中 = j;
        当 (j < size - 1) {
            (arr, j + 1)动态数组获取 = 后继;
            (arr, j, 后继)动态数组设置;
            j + 1 = j;
        }
        size - 1 = 结果;
    }
}

// 删除所有等于 值 的元素（原地压缩）；返回删后长度
函数 (arr, size:整数, 值:整数)数组删除所有值(0 = 结果:整数) {
    0 = 写;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 != 值) {
            (arr, 写, 当前值)动态数组设置;
            写 + 1 = 写;
        }
        i + 1 = i;
    }
    写 = 结果;
}

// 是否含重复元素 → 1/0（空数组或单元素 → 0）
函数 (arr, size:整数)数组是否含重复(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        i + 1 = j;
        当 (j < size) {
            (arr, j)动态数组获取 = 后继;
            如果 (后继 ?= 当前值) { 1 = 结果; }
            j + 1 = j;
        }
        i + 1 = i;
    }
}

// 众数：出现次数最多的元素值；并列取最先出现者；空数组 → 0
函数 (arr, size:整数)数组众数(0 = 结果:整数) {
    0 = 结果;
    0 = 最佳;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        0 = 次数;
        0 = j;
        当 (j < size) {
            (arr, j)动态数组获取 = 后继;
            如果 (后继 ?= 当前值) { 次数 + 1 = 次数; }
            j + 1 = j;
        }
        如果 (次数 > 最佳) {
            次数 = 最佳;
            当前值 = 结果;
        }
        i + 1 = i;
    }
}

// ==================== 8CA：数组序统计与区间极值（第几小 / 中位数 / 逐元素相等 / 区间最大值）——纯 `.心`，双链一致 ====================
//   · 承接 8BI/8BP/8BV/8BY（8BV「范围/限制」正标注**无中位数**）；**句柄参数（数组）不加类型标注、标量参数须标注 `:整数`**。
//   · 赋值目标恒在 `=` 右侧（`不大于 + 1 = 不大于;` 即 不大于 := 不大于 + 1）；仅用两链皆已支持的内建/运算。
//   · `数组第几小`/`数组中位数` 以 O(n²) 计数法求序统计量（**不改动入参**、无排序依赖）。

// 第 k 小（k 自 1 起，写成 `第几小`）：值为 v 使得「< v 的个数 < k」且「<= v 的个数 >= k」；k 越界 → 0
函数 (arr, size:整数, k:整数)数组第几小(0 = 结果:整数) {
    0 = 结果;
    0 = 已定;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 候选;
        0 = 小于;
        0 = 不大于;
        0 = j;
        当 (j < size) {
            (arr, j)动态数组获取 = 值;
            如果 (值 < 候选) { 小于 + 1 = 小于; }
            如果 (值 <= 候选) { 不大于 + 1 = 不大于; }
            j + 1 = j;
        }
        如果 (小于 < k && 不大于 >= k && 已定 ?= 0) {
            候选 = 结果;
            1 = 已定;
        }
        i + 1 = i;
    }
}

// 中位数（下中位数 = 第 floor((size+1)/2) 小）；空数组 → 0
函数 (arr, size:整数)数组中位数(0 = 结果:整数) {
    0 = 结果;
    如果 (size > 0) {
        (size + 1) / 2 = k;
        (arr, size, k)数组第几小 = 结果;
    }
}

// 两数组逐元素相等（长度相同且同下标值全等）→ 1/0
函数 (甲, 大小甲:整数, 乙, 大小乙:整数)数组是否等于(0 = 结果:整数) {
    0 = 结果;
    如果 (大小甲 ?= 大小乙) {
        1 = 结果;
        0 = i;
        当 (i < 大小甲) {
            (甲, i)动态数组获取 = 值甲;
            (乙, i)动态数组获取 = 值乙;
            如果 (值甲 != 值乙) { 0 = 结果; }
            i + 1 = i;
        }
    }
}

// arr[起, 末) 的最大值（越界自动收拢；空区间 → 0）
函数 (arr, size:整数, 起:整数, 末:整数)数组区间最大值(0 = 结果:整数) {
    0 = 结果;
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    如果 (结束 > 开始) {
        (arr, 开始)动态数组获取 = 结果;
        开始 + 1 = i;
        当 (i < 结束) {
            (arr, i)动态数组获取 = 值;
            如果 (值 > 结果) { 值 = 结果; }
            i + 1 = i;
        }
    }
}
