// 日月标准库 - 数组工具

函数 (arr, size)数组最大值(0 = 结果:整数) {
    (arr, 0)动态数组获取 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 > 结果) { 当前值 = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组最小值(0 = 结果:整数) {
    (arr, 0)动态数组获取 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 < 结果) { 当前值 = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组求和(0 = 结果:整数) {
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        结果 + 当前值 = 结果;
        i + 1 = i;
    }
}

函数 (arr, size, 目标)查找(0 = 结果:整数) {
    -1 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { i = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组复制(0 = 结果:整数) {
    ()创建动态数组 = 新数组;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 值;
        (新数组, 值)动态数组添加;
        i + 1 = i;
    }
    新数组 = 结果;
}

函数 (arr, size)数组翻转 {
    0 = 左;
    size - 1 = 右;
    当 (左 < 右) {
        (arr, 左)动态数组获取 = 左值;
        (arr, 右)动态数组获取 = 右值;
        (arr, 左, 右值)动态数组设置;
        (arr, 右, 左值)动态数组设置;
        左 + 1 = 左;
        右 - 1 = 右;
    }
}

函数 (arr, size, 分隔符)数组连接("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    当 (i < size) {
        如果 (i > 0) { (输出, 分隔符)拼接 = 输出; }
        (arr, i)动态数组获取 = 值;
        (值)转字符串 = 值字符串;
        (输出, 值字符串)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}
