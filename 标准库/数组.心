// 日月标准库 - 数组工具

函数 (arr, size)数组最大值(0 = 结果:整数) {
    (arr, 0)动态数组获取 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 > 结果) { 当前值 = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组最小值(0 = 结果:整数) {
    (arr, 0)动态数组获取 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 < 结果) { 当前值 = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组求和(0 = 结果:整数) {
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        结果 + 当前值 = 结果;
        i + 1 = i;
    }
}

函数 (arr, size, 目标)查找(0 = 结果:整数) {
    -1 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { i = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size)数组复制(0 = 结果:整数) {
    ()创建动态数组 = 新数组;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 值;
        (新数组, 值)动态数组添加;
        i + 1 = i;
    }
    新数组 = 结果;
}

函数 (arr, size)数组翻转 {
    0 = 左;
    size - 1 = 右;
    当 (左 < 右) {
        (arr, 左)动态数组获取 = 左值;
        (arr, 右)动态数组获取 = 右值;
        (arr, 左, 右值)动态数组设置;
        (arr, 右, 左值)动态数组设置;
        左 + 1 = 左;
        右 - 1 = 右;
    }
}

函数 (arr, size, 分隔符)数组连接("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    当 (i < size) {
        如果 (i > 0) { (输出, 分隔符)拼接 = 输出; }
        (arr, i)动态数组获取 = 值;
        (值)转字符串 = 值字符串;
        (输出, 值字符串)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// ==================== 8BI：数组统计与判定（纯 `.心`，双链一致） ====================
//   · 承接既有 `数组最大值`/`数组最小值`/`数组求和`/`查找`/`数组复制`/`数组翻转`/`数组连接`。
//   · 整数数组句柄参数**不加类型标注**（同 `集合.心`/`整数数组.心`）；赋值目标恒在 `=` 右侧
//     （`当前值 = 最大;` 即 `最大 := 当前值`；`i = 结果;` 即 `结果 := i`）。

// 统计 arr 中等于 目标 的元素个数
函数 (arr, size, 目标)数组计数(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { 结果 + 1 = 结果; }
        i + 1 = i;
    }
}

// 首个最大值的下标（空数组 → -1）
函数 (arr, size)数组最大值索引(0 = 结果:整数) {
    -1 = 结果;
    如果 (size > 0) {
        0 = 结果;
        (arr, 0)动态数组获取 = 最大;
        1 = i;
        当 (i < size) {
            (arr, i)动态数组获取 = 当前值;
            如果 (当前值 > 最大) {
                当前值 = 最大;
                i = 结果;
            }
            i + 1 = i;
        }
    }
}

// 首个最小值的下标（空数组 → -1）
函数 (arr, size)数组最小值索引(0 = 结果:整数) {
    -1 = 结果;
    如果 (size > 0) {
        0 = 结果;
        (arr, 0)动态数组获取 = 最小;
        1 = i;
        当 (i < size) {
            (arr, i)动态数组获取 = 当前值;
            如果 (当前值 < 最小) {
                当前值 = 最小;
                i = 结果;
            }
            i + 1 = i;
        }
    }
}

// 是否非递减（升序，允许相等）；空数组或单元素 → 1
函数 (arr, size)数组是否升序(0 = 结果:整数) {
    1 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 < 前值) { 0 = 结果; }
        i + 1 = i;
    }
}

// 是否非递增（降序，允许相等）；空数组或单元素 → 1
函数 (arr, size)数组是否降序(0 = 结果:整数) {
    1 = 结果;
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 > 前值) { 0 = 结果; }
        i + 1 = i;
    }
}

// 原地把 arr 变为前缀和（arr[i] := 前 i+1 项之和）
函数 (arr, size)数组前缀和 {
    1 = i;
    当 (i < size) {
        (arr, i - 1)动态数组获取 = 前值;
        (arr, i)动态数组获取 = 当前值;
        前值 + 当前值 = 新值;
        (arr, i, 新值)动态数组设置;
        i + 1 = i;
    }
}

// ==================== 8BL：数组切片 / 填充 / 旋转 / 末次查找（纯 `.心`，双链一致） ====================
//   · 承接 8BI；**句柄参数不加类型标注、标量参数须标注 `:整数`**
//     （未标注且仅出现在 `动态数组设置` 的形参会被推断为「指针」⇒ 自举链类型不匹配，见下）。
//   · 赋值目标恒在 `=` 右侧（`起 = 开始;` 即 `开始 := 起`；`步 + size = 步;` 即 `步 := 步 + size`）。
//   · 仅用两链皆已支持的内建/运算（动态数组获取/设置/添加/大小、整除 `/` 与取余 `%`）。

// 取 arr[起, 末) 追加到 目标数组（越界自动收拢：起<0→0、末>size→size、末<=起→不追加）；返回追加个数
函数 (arr, size:整数, 起:整数, 末:整数, 目标)数组切片到(0 = 结果:整数) {
    0 = 结果;
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    开始 = i;
    当 (i < 结束) {
        (arr, i)动态数组获取 = 值;
        (目标, 值)动态数组添加;
        结果 + 1 = 结果;
        i + 1 = i;
    }
}

// 原地把 arr[起, 末) 全部设为 值（越界自动收拢，同 数组切片到）
函数 (arr, size:整数, 起:整数, 末:整数, 值:整数)数组填充 {
    0 = 开始;
    如果 (起 > 0) { 起 = 开始; }
    size = 结束;
    如果 (末 < size) { 末 = 结束; }
    开始 = i;
    当 (i < 结束) {
        (arr, i, 值)动态数组设置;
        i + 1 = i;
    }
}

// 原地循环左移 位移 位（位移 可为负/超界，按 `位移 % size` 归一；size<=1 不动）
函数 (arr, size:整数, 位移:整数)数组旋转 {
    如果 (size > 1) {
        位移 % size = 步;
        如果 (步 < 0) { 步 + size = 步; }
        如果 (步 > 0) {
            ()创建动态数组 = 临时;
            步 = i;
            当 (i < size) {
                (arr, i)动态数组获取 = 值;
                (临时, 值)动态数组添加;
                i + 1 = i;
            }
            0 = i;
            当 (i < 步) {
                (arr, i)动态数组获取 = 值;
                (临时, 值)动态数组添加;
                i + 1 = i;
            }
            0 = i;
            当 (i < size) {
                (临时, i)动态数组获取 = 值;
                (arr, i, 值)动态数组设置;
                i + 1 = i;
            }
        }
    }
}

// 末个等于 目标 的下标（未找到 → -1）
函数 (arr, size:整数, 目标:整数)查找末次(0 = 结果:整数) {
    -1 = 结果;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 当前值;
        如果 (当前值 ?= 目标) { i = 结果; }
        i + 1 = i;
    }
}
