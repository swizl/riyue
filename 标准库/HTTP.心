    0 = 行止;
    0 = 码;
    0 = 末码;
    1 = 首行;
    0 = 头完;
    0 = 体起;
    0 = k;
    0 = 停;
    "" = 行;

    0 = i;
    0 = 行起;
    当 (i < 总长) {
        如果 (头完 ?= 0) {
            (请求, i)字符码 = 码;
            如果 (码 ?= 10) {
                i = 行止;
                如果 (i > 行起) {
                    (请求, i - 1)字符码 = 末码;
                    如果 (末码 ?= 13) { i - 1 = 行止; }
                }
                如果 (行止 > 行起) {
                    (请求, 行起, 行止 - 行起)子串 = 行;
                    如果 (首行 ?= 1) {
                        (行)HTTP切前两段 = (请求方法, 路径);
                    } 否则 {
                        (头, 行)动态字符串数组添加;
                    }
                    0 = 首行;
                } 否则 {
                    1 = 头完;
                    i + 1 = 体起;
                }
                i + 1 = 行起;
            }
        }
        i + 1 = i;
    }

    如果 (头完 ?= 0) {
        如果 (行起 < 总长) {
            (请求, 行起, 总长 - 行起)子串 = 行;
            如果 (首行 ?= 1) {
                (行)HTTP切前两段 = (请求方法, 路径);
            } 否则 {
                (头, 行)动态字符串数组添加;
            }
            0 = 首行;
        }
    }

    如果 (头完 ?= 1) {
        体起 = k;
        0 = 停;
        当 (停 ?= 0) {
            如果 (k < 总长) {
                (请求, k)字符码 = 码;
                如果 (码 ?= 13) { k + 1 = k; }
                否则如果 (码 ?= 10) { k + 1 = k; }
