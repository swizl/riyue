// 日月标准库 - HTTP 请求
// 封装运行时 HTTP获取（内部借助系统 curl 实现 GET）

函数 (url:字符串)HTTP获取网页("" = 结果:字符串) {
    (url)HTTP获取 = 结果;
}

// ==================== HTTP 客户端文本层 ====================
// 纯 .心 实现（无编译器改动，双链 引导.exe / 日月.exe 行为一致）。
//   · 头集合以「动态字符串数组」句柄承载，每元素形如 `名称: 值`；句柄参数**不加类型标注**
//     （`语法规范.md:904`：数组句柄参数以无类型标注表示）。句柄参数**不得标注为 `字符串`**：
//     自举链会按值传递、句柄不被就地修改。
//   · CR / LF 以码点构造（`(13)字符` / `(10)字符`），再 `拼接`（分配新缓冲，可安全复用）；
//     切勿同时持有两个 `(码)字符` 结果（宿主链共享静态缓冲）。
//   · `去除空白` / `转小写` 归返**共享静态缓冲**：宿主链同一时刻只保留最后一次结果，
//     故凡需同时持有两串（如逐头比较）时，均以 `("", 串)拼接` 复制到新缓冲后再比较。
//   · 范围：仅文本层（请求构造 / 响应解析 / 取头）；实际收发由 TCP 内建或运行时 HTTP获取 负责。

// 构造 HTTP/1.1 请求报文：请求行 + `Host` + 各头 + `Content-Length` + 空行 + 体。
//   · `头` 为字符串数组句柄，每元素形如 `名称: 值`（无类型标注参数须置末）。
//   · 各段以 CRLF 分隔；`Content-Length` 取 `体` 的字符长度。
函数 (请求方法:字符串, 路径:字符串, 主机:字符串, 体:字符串, 头)HTTP构造请求("" = 结果:字符串) {
    (13)字符 = 单字;
    ("", 单字)拼接 = 元;
    (10)字符 = 单字;
    (元, 单字)拼接 = 换行符;
    (32)字符 = 单字;
    ("", 单字)拼接 = 空格;
    (头)动态字符串数组大小 = 头数;
    (体)长度 = 体长;
    "" = 输出;
    "" = 行;
    "" = 数文;
    0 = i;

    (输出, 请求方法)拼接 = 输出;
    (输出, 空格)拼接 = 输出;
    (输出, 路径)拼接 = 输出;
    (输出, 空格)拼接 = 输出;
    (输出, "HTTP/1.1")拼接 = 输出;
    (输出, 换行符)拼接 = 输出;
    (输出, "Host: ")拼接 = 输出;
    (输出, 主机)拼接 = 输出;
    (输出, 换行符)拼接 = 输出;

    0 = i;
    当 (i < 头数) {
        (头, i)动态字符串数组获取 = 行;
        (输出, 行)拼接 = 输出;
        (输出, 换行符)拼接 = 输出;
        i + 1 = i;
    }

    (输出, "Content-Length: ")拼接 = 输出;
    (体长)转字符串 = 数文;
    (输出, 数文)拼接 = 输出;
    (输出, 换行符)拼接 = 输出;
    (输出, 换行符)拼接 = 输出;
    (输出, 体)拼接 = 输出;

    输出 = 结果;
}

// 解析 HTTP 响应文本：状态码为返回值 `状态`（失败 0），消息体为返回值 `体`；
// 头依序追加到字符串数组句柄 `头`（调用方传入空句柄）。
//   · 首行 `HTTP/1.1 200 OK`：取首个空格后的连续数字为状态码。
//   · 行分隔符兼容 CRLF / LF（末尾 CR 剥离）；首遇空行即头结束，其后为消息体。
//   · 无空行分隔 → 视为无消息体。消息体按原始字节保留（含换行）。
函数 (响应:字符串, 头)HTTP解析响应(0 = 状态:整数, "" = 体:字符串) {
    (响应)长度 = 总长;
    0 = i;
    0 = 行起;
    0 = 行止;
    0 = 码;
    0 = 末码;
    1 = 首行;
    0 = 头完;
    0 = 体起;
    0 = k;
    0 = 找空;
    0 = 停;
    "" = 行;
    0 = 行长;

    0 = i;
    0 = 行起;
    当 (i < 总长) {
        如果 (头完 ?= 0) {
            (响应, i)字符码 = 码;
            如果 (码 ?= 10) {
                i = 行止;
                如果 (i > 行起) {
                    (响应, i - 1)字符码 = 末码;
                    如果 (末码 ?= 13) { i - 1 = 行止; }
                }
                如果 (行止 > 行起) {
                    (响应, 行起, 行止 - 行起)子串 = 行;
                    如果 (首行 ?= 1) {
                        (行)长度 = 行长;
                        0 = k;
                        0 = 找空;
                        0 = 停;
                        当 (k < 行长) {
                            如果 (停 ?= 0) {
                                (行, k)字符码 = 码;
                                如果 (找空 ?= 0) {
                                    如果 (码 ?= 32) { 1 = 找空; }
                                } 否则如果 (码 > 47) {
                                    如果 (码 < 58) {
                                        状态 * 10 + (码 - 48) = 状态;
                                    } 否则 { 1 = 停; }
                                } 否则 { 1 = 停; }
                            }
                            k + 1 = k;
                        }
                    } 否则 {
                        (头, 行)动态字符串数组添加;
                    }
                    0 = 首行;
                } 否则 {
                    1 = 头完;
                    i + 1 = 体起;
                }
                i + 1 = 行起;
            }
        }
        i + 1 = i;
    }

    如果 (头完 ?= 0) {
        如果 (行起 < 总长) {
            (响应, 行起, 总长 - 行起)子串 = 行;
            如果 (首行 ?= 1) {
                (行)长度 = 行长;
                0 = k;
                0 = 找空;
                0 = 停;
                当 (k < 行长) {
                    如果 (停 ?= 0) {
                        (行, k)字符码 = 码;
                        如果 (找空 ?= 0) {
                            如果 (码 ?= 32) { 1 = 找空; }
                        } 否则如果 (码 > 47) {
                            如果 (码 < 58) {
                                状态 * 10 + (码 - 48) = 状态;
                            } 否则 { 1 = 停; }
                        } 否则 { 1 = 停; }
                    }
                    k + 1 = k;
                }
            } 否则 {
                (头, 行)动态字符串数组添加;
            }
            0 = 首行;
        }
    }

    如果 (头完 ?= 1) {
        体起 = k;
        0 = 停;
        当 (停 ?= 0) {
            如果 (k < 总长) {
                (响应, k)字符码 = 码;
                如果 (码 ?= 13) { k + 1 = k; }
                否则如果 (码 ?= 10) { k + 1 = k; }
                否则 { 1 = 停; }
            } 否则 { 1 = 停; }
        }
        如果 (k < 总长) { (响应, k, 总长 - k)子串 = 体; }
    }
}

// 从响应头句柄 `头` 查询 `名称` 的值（名称大小写不敏感，名/值两侧空白去除）；
// 未找到 → 空串。`头` 元素形如 `名称: 值`（无类型标注参数须置末）。
函数 (名称:字符串, 头)HTTP取头("" = 结果:字符串) {
    (头)动态字符串数组大小 = 数量;
    (名称)去除空白 = 目标;
    (目标)转小写 = 目标;
    ("", 目标)拼接 = 目标;
    "" = 行;
    "" = 名;
    "" = 尾;
    0 = 编;
    0 = 冒号;
    0 = 命中;
    0 = 行长;
    当 (编 < 数量) {
        如果 (命中 ?= 0) {
            (头, 编)动态字符串数组获取 = 行;
            (行, ":")查找 = 冒号;
            如果 (冒号 > -1) {
                (行, 0, 冒号)子串 = 名;
                (名)去除空白 = 名;
                (名)转小写 = 名;
                ("", 名)拼接 = 名;
                如果 (名 ?= 目标) {
                    1 = 命中;
                    (行)长度 = 行长;
                    (行, 冒号 + 1, 行长 - 冒号 - 1)子串 = 尾;
                    (尾)去除空白 = 尾;
                    尾 = 结果;
                }
            }
        }
        编 + 1 = 编;
    }
}

// ==================== HTTP 服务端文本层 ====================
// 纯 .心 实现（约束同客户端文本层，双链一致）。
//   · 请求解析：首行 `METHOD 路径 HTTP版本` → 方法 / 路径（版本忽略）；头追加到句柄；空行后为体。
//   · 响应构造：状态行 `HTTP/1.1 码 原因` + 各头 + `Content-Length` + 空行 + 体（CRLF）。
//   · 范围：仅文本层；路由 / 中间件依赖回调（待 FFI），本层不含。

// 把 `行` 以首个空格切为两段：`甲` = 首段之前，`乙` = 首个空格之后（忽略其后空白）。
函数 (行:字符串)HTTP切前两段("" = 甲:字符串, "" = 乙:字符串) {
    (行, " ")查找 = 空一;
    (行)长度 = 总长;
    0 = 空二;
    0 = k;
    当 (k < 总长) {
        如果 (k > 空一) {
            如果 (空二 ?= 0) {
                (行, k)字符码 = 码;
                如果 (码 ?= 32) { k = 空二; }
            }
        }
        k + 1 = k;
    }
    (行, 0, 空一)子串 = 甲;
    如果 (空二 > 0) {
        (行, 空一 + 1, 空二 - 空一 - 1)子串 = 乙;
    } 否则 {
        (行, 空一 + 1, 总长 - 空一 - 1)子串 = 乙;
    }
}

// 解析 HTTP 请求文本：首行切为 `请求方法` / `路径`（版本忽略）；头依序追加到句柄 `头`；
// 空行其后为消息体 `体`。行分隔兼容 CRLF / LF（末尾 CR 剥离）；无空行 → 无体。
//   · `头` 为字符串数组句柄（无类型标注参数须置末）。
函数 (请求:字符串, 头)HTTP解析请求("" = 请求方法:字符串, "" = 路径:字符串, "" = 体:字符串) {
    (请求)长度 = 总长;
    0 = i;
    0 = 行起;
    0 = 行止;
    0 = 码;
    0 = 末码;
    1 = 首行;
    0 = 头完;
    0 = 体起;
    0 = k;
    0 = 停;
    "" = 行;

    0 = i;
    0 = 行起;
    当 (i < 总长) {
        如果 (头完 ?= 0) {
            (请求, i)字符码 = 码;
            如果 (码 ?= 10) {
                i = 行止;
                如果 (i > 行起) {
                    (请求, i - 1)字符码 = 末码;
                    如果 (末码 ?= 13) { i - 1 = 行止; }
                }
                如果 (行止 > 行起) {
                    (请求, 行起, 行止 - 行起)子串 = 行;
                    如果 (首行 ?= 1) {
                        (行)HTTP切前两段 = (请求方法, 路径);
                    } 否则 {
                        (头, 行)动态字符串数组添加;
                    }
                    0 = 首行;
                } 否则 {
                    1 = 头完;
                    i + 1 = 体起;
                }
                i + 1 = 行起;
            }
        }
        i + 1 = i;
    }

    如果 (头完 ?= 0) {
        如果 (行起 < 总长) {
            (请求, 行起, 总长 - 行起)子串 = 行;
            如果 (首行 ?= 1) {
                (行)HTTP切前两段 = (请求方法, 路径);
            } 否则 {
                (头, 行)动态字符串数组添加;
            }
            0 = 首行;
        }
    }

    如果 (头完 ?= 1) {
        体起 = k;
        0 = 停;
        当 (停 ?= 0) {
            如果 (k < 总长) {
                (请求, k)字符码 = 码;
                如果 (码 ?= 13) { k + 1 = k; }
                否则如果 (码 ?= 10) { k + 1 = k; }
                否则 { 1 = 停; }
            } 否则 { 1 = 停; }
        }
        如果 (k < 总长) { (请求, k, 总长 - k)子串 = 体; }
    }
}

// 构造 HTTP/1.1 响应报文：状态行 + 各头 + `Content-Length` + 空行 + 体（CRLF 分隔）。
//   · `头` 为字符串数组句柄，每元素形如 `名称: 值`（无类型标注参数须置末）。
//   · `Content-Length` 取 `体` 的字符长度。
函数 (状态码:整数, 原因:字符串, 体:字符串, 头)HTTP构造响应("" = 结果:字符串) {
    (13)字符 = 单字;
    ("", 单字)拼接 = 元;
    (10)字符 = 单字;
    (元, 单字)拼接 = 换行符;
    (32)字符 = 单字;
    ("", 单字)拼接 = 空格;
    (头)动态字符串数组大小 = 头数;
    (体)长度 = 体长;
    "" = 输出;
    "" = 行;
    "" = 数文;
    0 = i;

    (输出, "HTTP/1.1 ")拼接 = 输出;
    (状态码)转字符串 = 数文;
    (输出, 数文)拼接 = 输出;
    (输出, 空格)拼接 = 输出;
    (输出, 原因)拼接 = 输出;
    (输出, 换行符)拼接 = 输出;

    0 = i;
    当 (i < 头数) {
        (头, i)动态字符串数组获取 = 行;
        (输出, 行)拼接 = 输出;
        (输出, 换行符)拼接 = 输出;
        i + 1 = i;
    }

    (输出, "Content-Length: ")拼接 = 输出;
    (体长)转字符串 = 数文;
    (输出, 数文)拼接 = 输出;
    (输出, 换行符)拼接 = 输出;
    (输出, 换行符)拼接 = 输出;
    (输出, 体)拼接 = 输出;

    输出 = 结果;
}
