    ()创建动态字符串数组 = 头;
    (请求文本, 头)HTTP解析请求 = (请求方法, 路径, 体);
    (请求方法, 路径, 路由表)HTTP路由匹配 = 编号;
    (编号, 请求方法, 路径, 体)分派 = 结果;
}

// 中间件链：请求中间件 → 路由处理 → 响应中间件；返回最终响应报文。
//   请求中间件 `入(请求文本:字符串)函数(0 = 结果:字符串)`（原样返回即不修改）；
//   响应中间件 `入(请求文本:字符串, 响应文本:字符串)函数(0 = 结果:字符串)`。
函数 (请求文本:字符串, 请求中间件:函数, 分派:函数, 响应中间件:函数, 路由表)HTTP中间件处理("" = 结果:字符串) {
    (请求文本)请求中间件 = 请求改写;
    (请求改写, 分派, 路由表)HTTP路由处理 = 响应;
    (请求改写, 响应)响应中间件 = 结果;
}

// 在已构造的响应报文头部插入一个头字段（置于空行之前）；返回新报文。
//   · 空行定位：优先 CRLFCRLF，其次 LFLF；两者均无 → 原样返回。
//   · 不重算 `Content-Length`（本函数只加头，不改体）。
函数 (响应:字符串, 名称:字符串, 值:字符串)HTTP响应加头("" = 结果:字符串) {
    (13)字符 = 单字;
    ("", 单字)拼接 = 回车;
    (10)字符 = 单字;
    ("", 单字)拼接 = 换行;
    (回车, 换行)拼接 = 断行;
    (断行, 断行)拼接 = 空行;
    (响应, 空行)查找 = 位;
    如果 (位 < 0) {
        (换行, 换行)拼接 = 空行;
        (响应, 空行)查找 = 位;
        换行 = 断行;
    }
    响应 = 结果;
    如果 (位 >= 0) {
        // 插入点在「最后一条头的行尾之后」：空行起点再右移一个断行的长度
        // （CRLF → 2，LF → 1），否则新头会挤进上一行、空行也被拆散。
        (断行)长度 = 断行长;
        位 + 断行长 = 插入点;
        (响应)长度 = 总长;
        (响应, 0, 插入点)子串 = 前段;
        (响应, 插入点, 总长 - 插入点)子串 = 后段;
        (名称, ": ")拼接 = 行;
        (行, 值)拼接 = 行;
        (行, 断行)拼接 = 行;
        (前段, 行)拼接 = 结果;
        (结果, 后段)拼接 = 结果;
    }
}

// 服务一次：接受一个连接 → 接收请求 → 路由处理 → 发送响应并关闭连接；返回命中的路由下标（-1 = 未命中）。
//   · 单次接收上限 4095 字节（运行时静态缓冲，见 `标准库/网络.心`）；请求更大需多次接收。
函数 (服务器:整数, 分派:函数, 路由表)HTTP服务一次(0 = 结果:整数) {
    (服务器)TCP接受接收 = (连接, 请求文本);
    ()创建动态字符串数组 = 头;
    (请求文本, 头)HTTP解析请求 = (请求方法, 路径, 体);
    (请求方法, 路径, 路由表)HTTP路由匹配 = 编号;
    (编号, 请求方法, 路径, 体)分派 = 响应;
    (连接, 响应)TCP发送关闭;
    编号 = 结果;
}
