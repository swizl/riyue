// 匹配路由：返回首个命中的路由下标，未命中 -1。
//   · 方法须相等，或路由方法为 `*`；路径按精确 / 前缀（路由路径以 `*` 结尾）匹配。
//   · 匹配在剥离查询串后的路径上进行。
函数 (请求方法:字符串, 路径:字符串, 路由表)HTTP路由匹配(-1 = 结果:整数) {
    (路由表)动态字符串数组大小 = 数量;
    (路径)HTTP取路径 = 只路径;
    (只路径)长度 = 路径长;
    0 = i;
    0 = 方法合;
    0 = 末字;
    0 = 路由长;
    0 = 前缀长;
    "" = 行;
    "" = 路由方法;
    "" = 路由路径;
    "" = 路由前缀;
    "" = 路径前;
    当 (i < 数量) {
        如果 (结果 < 0) {
            (路由表, i)动态字符串数组获取 = 行;
            (行)HTTP切前两段 = (路由方法, 路由路径);
            0 = 方法合;
            如果 (路由方法 ?= "*") { 1 = 方法合; }
            否则如果 (路由方法 ?= 请求方法) { 1 = 方法合; }
            如果 (方法合 ?= 1) {
                (路由路径)长度 = 路由长;
                如果 (路由长 > 0) {
                    (路由路径, 路由长 - 1)字符码 = 末字;
                    如果 (末字 ?= 42) {
