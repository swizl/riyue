                        (路由前缀)长度 = 前缀长;
                        如果 (前缀长 <= 路径长) {
                            (只路径, 0, 前缀长)子串 = 路径前;
                            如果 (路径前 ?= 路由前缀) { i = 结果; }
                        }
                    } 否则如果 (路由路径 ?= 只路径) {
                        i = 结果;
                    }
                }
            }
        }
        i + 1 = i;
    }
}

// 处理一次请求：解析请求报文 → 匹配路由 → 调分派生成响应报文；返回完整响应。
