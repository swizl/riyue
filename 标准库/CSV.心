// 日月标准库 - CSV 工具（RFC 4180 子集：解析 / 生成）
//
// 说明：
//   · 纯 .心 实现，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 字段集合以「动态字符串数组」句柄承载；句柄参数按语言约定**不加类型标注**
//     （`语法规范.md:904`：数组句柄参数以无类型标注表示，如 `函数 (arr, i:整数)获取数组元素`）。
//     函数就地追加字段，调用方随后可 `动态字符串数组大小`/`动态字符串数组获取`。
//     ⚠️ 句柄参数**不得标注为 `字符串`**：自举链会按值传递、句柄不被就地修改（双链分歧）。
//   · 字符结果「即取即拼」：同一时刻只持有一个 `(码)字符` 结果并立即拼接。
//     宿主链字符串为裸 char*、生产者共享静态缓冲，同时持有两个字符结果会互相覆盖；
//     自举链因胖字符串拷贝无此现象。即取即拼使两链行为一致（同 标准库/编码.心、字符串.心）。
//   · 引号 / 逗号 / 换行一律以码点构造（`(34)字符` / `(44)字符` / `(10)字符`），不依赖字面量转义。
//   · 范围：
//       单条记录——`CSV解析行`（不支持字段内换行；CR/LF 忽略）/ `CSV生成行`。
//       多记录文本——`CSV解析文本` / `CSV生成文本`（支持字段内换行；记录分隔符 CR/LF 归一）。
//     公式注入转义（以 `'` 前缀等）不在本模块。

// 解析单条 CSV 记录：把字段依序追加到字符串数组句柄 `字段`，归返字段个数。
//   · 引号内含 `""` 视为一个转义引号；引号内逗号/引号外逗号语义不同。
//   · 空输入 → 一个空字段（字段个数 1）。
函数 (行:字符串, 字段)CSV解析行(0 = 结果:整数) {
    (行)长度 = 总长;
    "" = 缓冲;
    "" = 单字;
    0 = 码;
    0 = 下码;
    0 = 计数;
    0 = 在引;
    0 = 双引;
    0 = i;
    当 (i < 总长) {
        (行, i)字符码 = 码;
        如果 (在引 ?= 1) {
            如果 (码 ?= 34) {
                0 = 双引;
                如果 (i + 1 < 总长) {
                    (行, i + 1)字符码 = 下码;
                    如果 (下码 ?= 34) { 1 = 双引; }
                }
                如果 (双引 ?= 1) {
                    (34)字符 = 单字;
                    (缓冲, 单字)拼接 = 缓冲;
                    i + 1 = i;
                } 否则 {
                    0 = 在引;
                }
            } 否则 {
                (码)字符 = 单字;
                (缓冲, 单字)拼接 = 缓冲;
            }
        } 否则 {
            如果 (码 ?= 34) {
                1 = 在引;
            } 否则如果 (码 ?= 44) {
                (字段, 缓冲)动态字符串数组添加;
                计数 + 1 = 计数;
                "" = 缓冲;
            } 否则 {
                如果 (码 != 10) {
                    如果 (码 != 13) {
                        (码)字符 = 单字;
                        (缓冲, 单字)拼接 = 缓冲;
                    }
                }
            }
        }
        i + 1 = i;
    }
    (字段, 缓冲)动态字符串数组添加;
    计数 + 1 = 计数;
    计数 = 结果;
}

// 转义单个字段为 CSV 片段：含逗号 / 引号 / CR / LF 时整体加引号，内部引号翻倍。
函数 (值:字符串)CSV转义字段("" = 结果:字符串) {
    (值)长度 = 值长;
    "" = 输出;
    "" = 单字;
    0 = 需引;
    0 = 码;
    0 = j;
    当 (j < 值长) {
        (值, j)字符码 = 码;
        如果 (码 ?= 34) { 1 = 需引; }
        否则如果 (码 ?= 44) { 1 = 需引; }
        否则如果 (码 ?= 10) { 1 = 需引; }
        否则如果 (码 ?= 13) { 1 = 需引; }
        j + 1 = j;
    }
    如果 (需引 ?= 1) {
        (34)字符 = 单字;
        (输出, 单字)拼接 = 输出;
        0 = j;
        当 (j < 值长) {
            (值, j)字符码 = 码;
            如果 (码 ?= 34) {
                (34)字符 = 单字;
                (输出, 单字)拼接 = 输出;
                (34)字符 = 单字;
                (输出, 单字)拼接 = 输出;
            } 否则 {
                (码)字符 = 单字;
                (输出, 单字)拼接 = 输出;
            }
            j + 1 = j;
        }
        (34)字符 = 单字;
        (输出, 单字)拼接 = 输出;
    } 否则 {
        值 = 输出;
    }
    输出 = 结果;
}

// 生成单条 CSV 记录：把字符串数组句柄 `字段` 的全部字段以逗号连接成一行文本；空数组 → 空串。
函数 (字段)CSV生成行("" = 结果:字符串) {
    (字段)动态字符串数组大小 = 数量;
    "" = 输出;
    "" = 单字;
    "" = 值;
    "" = 片;
    0 = i;
    当 (i < 数量) {
        (字段, i)动态字符串数组获取 = 值;
        (值)CSV转义字段 = 片;
        如果 (i > 0) {
            (44)字符 = 单字;
            (输出, 单字)拼接 = 输出;
        }
        (输出, 片)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 解析多记录 CSV 文本：字段按出现顺序平铺追加到字符串数组句柄 `字段`；
// 每记录的字段个数追加到整数数组句柄 `行字段数`；归返记录数。
//   · 支持引号内换行（字段可跨物理行）；引号内 `""` 为一个转义引号。
//   · 记录分隔符 CR/LF 归一（`\r\n`/`\n`/`\r` 均视为行尾）；末尾无换行的末记录亦计入。
//   · 空文本 → 0 记录。
函数 (文本:字符串, 字段, 行字段数)CSV解析文本(0 = 结果:整数) {
    (文本)长度 = 总长;
    "" = 缓冲;
    "" = 单字;
    0 = 码;
    0 = 下码;
    0 = 在引;
    0 = 双引;
    0 = 行内;
    0 = 行数;
    0 = 待收;
    0 = i;
    当 (i < 总长) {
        (文本, i)字符码 = 码;
        如果 (在引 ?= 1) {
            如果 (码 ?= 34) {
                0 = 双引;
                如果 (i + 1 < 总长) {
                    (文本, i + 1)字符码 = 下码;
                    如果 (下码 ?= 34) { 1 = 双引; }
                }
                如果 (双引 ?= 1) {
                    (34)字符 = 单字;
                    (缓冲, 单字)拼接 = 缓冲;
                    i + 1 = i;
                } 否则 {
                    0 = 在引;
                }
                1 = 待收;
            } 否则 {
                (码)字符 = 单字;
                (缓冲, 单字)拼接 = 缓冲;
                1 = 待收;
            }
        } 否则 {
            如果 (码 ?= 34) {
                1 = 在引;
                1 = 待收;
            } 否则如果 (码 ?= 44) {
                (字段, 缓冲)动态字符串数组添加;
                行内 + 1 = 行内;
                "" = 缓冲;
                1 = 待收;
            } 否则如果 (码 ?= 10) {
                (字段, 缓冲)动态字符串数组添加;
                行内 + 1 = 行内;
                (行字段数, 行内)动态数组添加;
                行数 + 1 = 行数;
                "" = 缓冲;
                0 = 行内;
                0 = 待收;
            } 否则 {
                如果 (码 != 13) {
                    (码)字符 = 单字;
                    (缓冲, 单字)拼接 = 缓冲;
                    1 = 待收;
                }
            }
        }
        i + 1 = i;
    }
    如果 (待收 ?= 1) {
        (字段, 缓冲)动态字符串数组添加;
        行内 + 1 = 行内;
        (行字段数, 行内)动态数组添加;
        行数 + 1 = 行数;
    }
    行数 = 结果;
}

// 生成多记录 CSV 文本：把平铺的字符串数组句柄 `字段` 按整数数组句柄 `行字段数`
// （每记录字段个数）划分，逐记录生成并以 LF（`\n`）连接；无记录 → 空串。
函数 (字段, 行字段数)CSV生成文本("" = 结果:字符串) {
    (字段)动态字符串数组大小 = 字段数;
    (行字段数)动态数组大小 = 行数;
    "" = 输出;
    "" = 单字;
    "" = 值;
    "" = 片;
    0 = 行号;
    0 = 基;
    0 = 本行;
    0 = j;
    当 (行号 < 行数) {
        (行字段数, 行号)动态数组获取 = 本行;
        0 = j;
        当 (j < 本行) {
            (字段, 基 + j)动态字符串数组获取 = 值;
            (值)CSV转义字段 = 片;
            如果 (j > 0) {
                (44)字符 = 单字;
                (输出, 单字)拼接 = 输出;
            }
            (输出, 片)拼接 = 输出;
            j + 1 = j;
        }
        基 + 本行 = 基;
        如果 (行号 + 1 < 行数) {
            (10)字符 = 单字;
            (输出, 单字)拼接 = 输出;
        }
        行号 + 1 = 行号;
    }
    输出 = 结果;
}
