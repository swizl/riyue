// 日月标准库 - CSV 工具（RFC 4180 子集：单条记录 解析 / 生成）
//
// 说明：
//   · 纯 .心 实现，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 字段集合以「动态字符串数组」句柄承载；句柄参数按语言约定**不加类型标注**
//     （`语法规范.md:904`：数组句柄参数以无类型标注表示，如 `函数 (arr, i:整数)获取数组元素`）。
//     函数就地追加字段，调用方随后可 `动态字符串数组大小`/`动态字符串数组获取`。
//     ⚠️ 句柄参数**不得标注为 `字符串`**：自举链会按值传递、句柄不被就地修改（双链分歧）。
//   · 字符结果「即取即拼」：同一时刻只持有一个 `(码)字符` 结果并立即拼接。
//     宿主链字符串为裸 char*、生产者共享静态缓冲，同时持有两个字符结果会互相覆盖；
//     自举链因胖字符串拷贝无此现象。即取即拼使两链行为一致（同 标准库/编码.心、字符串.心）。
//   · 引号 / 逗号一律以码点构造（`(34)字符` / `(44)字符`），不依赖字符串字面量转义。
//   · 范围：仅处理「单条记录」——不支持字段内换行（记录即一行）；多记录文本、字段内换行、
//     记录分隔符归一为后续切片。解析时 CR/LF 一律忽略（使带尾换行的单行输入可直接解析）。

// 解析单条 CSV 记录：把字段依序追加到字符串数组句柄 `字段`，归返字段个数。
//   · 引号内含 `""` 视为一个转义引号；引号内逗号/引号外逗号语义不同。
//   · 空输入 → 一个空字段（字段个数 1）。
函数 (行:字符串, 字段)CSV解析行(0 = 结果:整数) {
    (行)长度 = 总长;
    "" = 缓冲;
    "" = 单字;
    0 = 码;
    0 = 下码;
    0 = 计数;
    0 = 在引;
    0 = 双引;
    0 = i;
    当 (i < 总长) {
        (行, i)字符码 = 码;
        如果 (在引 ?= 1) {
            如果 (码 ?= 34) {
                0 = 双引;
                如果 (i + 1 < 总长) {
                    (行, i + 1)字符码 = 下码;
                    如果 (下码 ?= 34) { 1 = 双引; }
                }
                如果 (双引 ?= 1) {
                    (34)字符 = 单字;
                    (缓冲, 单字)拼接 = 缓冲;
                    i + 1 = i;
                } 否则 {
                    0 = 在引;
                }
            } 否则 {
                (码)字符 = 单字;
                (缓冲, 单字)拼接 = 缓冲;
            }
        } 否则 {
            如果 (码 ?= 34) {
                1 = 在引;
            } 否则如果 (码 ?= 44) {
                (字段, 缓冲)动态字符串数组添加;
                计数 + 1 = 计数;
                "" = 缓冲;
            } 否则 {
                如果 (码 != 10) {
                    如果 (码 != 13) {
                        (码)字符 = 单字;
                        (缓冲, 单字)拼接 = 缓冲;
                    }
                }
            }
        }
        i + 1 = i;
    }
    (字段, 缓冲)动态字符串数组添加;
    计数 + 1 = 计数;
    计数 = 结果;
}

// 生成单条 CSV 记录：把字符串数组句柄 `字段` 的全部字段以逗号连接成一行文本。
//   · 字段含逗号 / 引号 / CR / LF 时整体加引号，内部引号翻倍（`"` → `""`）。
//   · 空数组 → 空串。
函数 (字段)CSV生成行("" = 结果:字符串) {
    (字段)动态字符串数组大小 = 数量;
    "" = 输出;
    "" = 单字;
    "" = 值;
    0 = 值长;
    0 = 需引;
    0 = 码;
    0 = i;
    0 = j;
    当 (i < 数量) {
        (字段, i)动态字符串数组获取 = 值;
        (值)长度 = 值长;
        0 = 需引;
        0 = j;
        当 (j < 值长) {
            (值, j)字符码 = 码;
            如果 (码 ?= 34) { 1 = 需引; }
            否则如果 (码 ?= 44) { 1 = 需引; }
            否则如果 (码 ?= 10) { 1 = 需引; }
            否则如果 (码 ?= 13) { 1 = 需引; }
            j + 1 = j;
        }
        如果 (i > 0) {
            (44)字符 = 单字;
            (输出, 单字)拼接 = 输出;
        }
        如果 (需引 ?= 1) {
            (34)字符 = 单字;
            (输出, 单字)拼接 = 输出;
            0 = j;
            当 (j < 值长) {
                (值, j)字符码 = 码;
                如果 (码 ?= 34) {
                    (34)字符 = 单字;
                    (输出, 单字)拼接 = 输出;
                    (34)字符 = 单字;
                    (输出, 单字)拼接 = 输出;
                } 否则 {
                    (码)字符 = 单字;
                    (输出, 单字)拼接 = 输出;
                }
                j + 1 = j;
            }
            (34)字符 = 单字;
            (输出, 单字)拼接 = 输出;
        } 否则 {
            (输出, 值)拼接 = 输出;
        }
        i + 1 = i;
    }
    输出 = 结果;
}
