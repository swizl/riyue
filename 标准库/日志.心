// 日志系统库

// 当前日志级别（默认为信息）
0 = 当前日志级别:整数;

// 设置日志级别
函数 (level:整数)设置日志级别(空) {
    level = 当前日志级别;
}

// 调试日志
函数 (msg:字符串)日志调试(空) {
    如果 (当前日志级别 <= 0) {
        ("[调试] ")打印;
        (msg)打印;
    }
}

// 信息日志
函数 (msg:字符串)日志信息(空) {
    如果 (当前日志级别 <= 1) {
        ("[信息] ")打印;
        (msg)打印;
    }
}

// 警告日志
函数 (msg:字符串)日志警告(空) {
    如果 (当前日志级别 <= 2) {
        ("[警告] ")打印;
        (msg)打印;
    }
}

// 错误日志
函数 (msg:字符串)日志错误(空) {
    如果 (当前日志级别 <= 3) {
        ("[错误] ")打印;
        (msg)打印;
    }
}
