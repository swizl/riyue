// 日月标准库 - 字符串工具

函数 (文本:字符串, 旧:字符串, 新:字符串)字符串替换("" = 结果:字符串) {
    (文本)长度 = 文本长度;
    (旧)长度 = 旧长度;
    "" = 输出;
    0 = 位置;
    当 (位置 < 文本长度) {
        (文本, 位置)字符码 = 当前码;
        如果 (位置 + 旧长度 <= 文本长度) {
            1 = 已匹配;
            0 = j;
            当 (j < 旧长度) {
                (文本, 位置 + j)字符码 = 文本码;
                (旧, j)字符码 = 模式码;
                如果 (文本码 != 模式码) { 0 = 已匹配; }
                j + 1 = j;
            }
            如果 (已匹配 ?= 1) {
                (输出, 新)拼接 = 输出;
                位置 + 旧长度 = 位置;
            } 否则 {
                (当前码)字符 = 字符;
                (输出, 字符)拼接 = 输出;
                位置 + 1 = 位置;
            }
        } 否则 {
            (当前码)字符 = 字符;
            (输出, 字符)拼接 = 输出;
            位置 + 1 = 位置;
        }
    }
    输出 = 结果;
}

函数 (文本:字符串)字符串反转("" = 结果:字符串) {
    (文本)长度 = 文本长度;
    "" = 输出;
    文本长度 - 1 = i;
    当 (i >= 0) {
        (文本, i)字符码 = 码;
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i - 1 = i;
    }
    输出 = 结果;
}

// ==================== 8BF：字符串变换扩充（纯 `.心`，双链一致） ====================
//   · 内建 `转大写`/`转小写`/`去除空白` 在宿主链归返**共享静态缓冲**（同一时刻只保留最后一次结果，
//     见 标准库/HTTP.心 注释）；本片以「即取即拼」纯 `.心` 重写为独立函数，结果互不干扰、可安全多次调用。
//   · 仅按字符码扫描，不用位或 `|`；字符串输出参数须汇总到 `"" = 名称:字符串` 的返回位。

// 文本转大写（仅 ASCII 小写 a-z → A-Z，其余字符原样）
函数 (文本:字符串)字符串转大写("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    0 = 码;
    (文本)长度 = 长度;
    当 (i < 长度) {
        (文本, i)字符码 = 码;
        如果 (码 >= 97 && 码 <= 122) {
            码 - 32 = 码;
        }
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 文本转小写（仅 ASCII 大写 A-Z → a-z，其余字符原样）
函数 (文本:字符串)字符串转小写("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    0 = 码;
    (文本)长度 = 长度;
    当 (i < 长度) {
        (文本, i)字符码 = 码;
        如果 (码 >= 65 && 码 <= 90) {
            码 + 32 = 码;
        }
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 去除首尾空白（空格 32 / 制表 9 / 换行 10 / 回车 13）；空串或全空白 → ""
函数 (文本:字符串)去除首尾空白("" = 结果:字符串) {
    0 = 起;
    0 = 末;
    0 = 码;
    0 = 停;
    (文本)长度 = 长度;
    0 = 起;
    1 = 停;
    当 (停 ?= 1) {
        如果 (起 < 长度) {
            (文本, 起)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) {
                起 + 1 = 起;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    长度 = 末;
    1 = 停;
    当 (停 ?= 1) {
        如果 (末 > 起) {
            (文本, 末 - 1)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) {
                末 - 1 = 末;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    (文本, 起, 末 - 起)子串 = 结果;
}

// 文本重复 次数 次（次数 <= 0 → ""）
函数 (文本:字符串, 次数:整数)字符串重复("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    当 (i < 次数) {
        (输出, 文本)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 文本是否包含 子串 → 1/0（空 子串 视为包含）
函数 (文本:字符串, 子串:字符串)字符串含子串(0 = 结果:整数) {
    0 = 结果;
    (文本, 子串)查找 = 位置;
    如果 (位置 >= 0) {
        1 = 结果;
    }
}
