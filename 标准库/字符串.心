// 日月标准库 - 字符串工具

函数 (文本:字符串, 旧:字符串, 新:字符串)字符串替换("" = 结果:字符串) {
    (文本)长度 = 文本长度;
    (旧)长度 = 旧长度;
    "" = 输出;
    0 = 位置;
    当 (位置 < 文本长度) {
        (文本, 位置)字符码 = 当前码;
        如果 (位置 + 旧长度 <= 文本长度) {
            1 = 已匹配;
            0 = j;
            当 (j < 旧长度) {
                (文本, 位置 + j)字符码 = 文本码;
                (旧, j)字符码 = 模式码;
                如果 (文本码 != 模式码) { 0 = 已匹配; }
                j + 1 = j;
            }
            如果 (已匹配 ?= 1) {
                (输出, 新)拼接 = 输出;
                位置 + 旧长度 = 位置;
            } 否则 {
                (当前码)字符 = 字符;
                (输出, 字符)拼接 = 输出;
                位置 + 1 = 位置;
            }
        } 否则 {
            (当前码)字符 = 字符;
            (输出, 字符)拼接 = 输出;
            位置 + 1 = 位置;
        }
    }
    输出 = 结果;
}

函数 (文本:字符串)字符串反转("" = 结果:字符串) {
    (文本)长度 = 文本长度;
    "" = 输出;
    文本长度 - 1 = i;
    当 (i >= 0) {
        (文本, i)字符码 = 码;
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i - 1 = i;
    }
    输出 = 结果;
}
