// 日月标准库 - 字符串工具

函数 (文本:字符串, 旧:字符串, 新:字符串)字符串替换("" = 结果:字符串) {
    (文本)长度 = 文本长度;
    (旧)长度 = 旧长度;
    "" = 输出;
    0 = 位置;
    当 (位置 < 文本长度) {
        (文本, 位置)字符码 = 当前码;
        如果 (位置 + 旧长度 <= 文本长度) {
            1 = 已匹配;
            0 = j;
            当 (j < 旧长度) {
                (文本, 位置 + j)字符码 = 文本码;
                (旧, j)字符码 = 模式码;
                如果 (文本码 != 模式码) { 0 = 已匹配; }
                j + 1 = j;
            }
            如果 (已匹配 ?= 1) {
                (输出, 新)拼接 = 输出;
                位置 + 旧长度 = 位置;
            } 否则 {
                (当前码)字符 = 字符;
                (输出, 字符)拼接 = 输出;
                位置 + 1 = 位置;
            }
        } 否则 {
            (当前码)字符 = 字符;
            (输出, 字符)拼接 = 输出;
            位置 + 1 = 位置;
        }
    }
    输出 = 结果;
}

函数 (文本:字符串)字符串反转("" = 结果:字符串) {
    (文本)长度 = 文本长度;
    "" = 输出;
    文本长度 - 1 = i;
    当 (i >= 0) {
        (文本, i)字符码 = 码;
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i - 1 = i;
    }
    输出 = 结果;
}

// ==================== 8BF：字符串变换扩充（纯 `.心`，双链一致） ====================
//   · 内建 `转大写`/`转小写`/`去除空白` 在宿主链归返**共享静态缓冲**（同一时刻只保留最后一次结果，
//     见 标准库/HTTP.心 注释）；本片以「即取即拼」纯 `.心` 重写为独立函数，结果互不干扰、可安全多次调用。
//   · 仅按字符码扫描，不用位或 `|`；字符串输出参数须汇总到 `"" = 名称:字符串` 的返回位。

// 文本转大写（仅 ASCII 小写 a-z → A-Z，其余字符原样）
函数 (文本:字符串)字符串转大写("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    0 = 码;
    (文本)长度 = 长度;
    当 (i < 长度) {
        (文本, i)字符码 = 码;
        如果 (码 >= 97 && 码 <= 122) {
            码 - 32 = 码;
        }
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 文本转小写（仅 ASCII 大写 A-Z → a-z，其余字符原样）
函数 (文本:字符串)字符串转小写("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    0 = 码;
    (文本)长度 = 长度;
    当 (i < 长度) {
        (文本, i)字符码 = 码;
        如果 (码 >= 65 && 码 <= 90) {
            码 + 32 = 码;
        }
        (码)字符 = 字符;
        (输出, 字符)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 去除首尾空白（空格 32 / 制表 9 / 换行 10 / 回车 13）；空串或全空白 → ""
函数 (文本:字符串)去除首尾空白("" = 结果:字符串) {
    0 = 起;
    0 = 末;
    0 = 码;
    0 = 停;
    (文本)长度 = 长度;
    0 = 起;
    1 = 停;
    当 (停 ?= 1) {
        如果 (起 < 长度) {
            (文本, 起)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) {
                起 + 1 = 起;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    长度 = 末;
    1 = 停;
    当 (停 ?= 1) {
        如果 (末 > 起) {
            (文本, 末 - 1)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) {
                末 - 1 = 末;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    (文本, 起, 末 - 起)子串 = 结果;
}

// 文本重复 次数 次（次数 <= 0 → ""）
函数 (文本:字符串, 次数:整数)字符串重复("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    当 (i < 次数) {
        (输出, 文本)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 文本是否包含 子串 → 1/0（空 子串 视为包含）
函数 (文本:字符串, 子串:字符串)字符串含子串(0 = 结果:整数) {
    0 = 结果;
    (文本, 子串)查找 = 位置;
    如果 (位置 >= 0) {
        1 = 结果;
    }
}

// ==================== 8BG：字符串分割与连接（纯 `.心`，双链一致） ====================
//   · 未用内建 `分割`/`连接`：`分割` 仅宿主链后端有特化分支、自举链未实现，
//     `连接` 后端特化按 3 实参（数组, 数量, 分隔符）调用而规范写作 2 实参——两者均致双链不一致，
//     故本片以纯 `.心` 手写扫描实现，仅用两链皆已支持的内建（长度/字符码/子串/拼接 + 动态字符串数组）。
//   · 动态字符串数组句柄参数**不加类型标注**（见 版本.心 与 语法规范.md:904）。
//   · 分隔符为空 → 按**单字符**切分（对齐 JS `split("")`）；非空且文本为空 → 一段空串。

// 把 文本 按 分隔符 逐段切分，追加到 段数组（动态字符串数组句柄，不加类型标注）；返回追加段数
函数 (文本:字符串, 分隔符:字符串, 段数组)字符串分割到(0 = 数量:整数) {
    (文本)长度 = 文本长;
    (分隔符)长度 = 分隔符长;
    0 = 数量;
    如果 (分隔符长 <= 0) {
        0 = i;
        当 (i < 文本长) {
            (文本, i, 1)子串 = 段;
            (段数组, 段)动态字符串数组添加;
            数量 + 1 = 数量;
            i + 1 = i;
        }
    } 否则 {
        0 = 段起;
        0 = i;
        当 (i + 分隔符长 <= 文本长) {
            1 = 命中;
            0 = j;
            当 (j < 分隔符长) {
                (文本, i + j)字符码 = 甲;
                (分隔符, j)字符码 = 乙;
                如果 (甲 != 乙) { 0 = 命中; }
                j + 1 = j;
            }
            如果 (命中 ?= 1) {
                (文本, 段起, i - 段起)子串 = 段;
                (段数组, 段)动态字符串数组添加;
                数量 + 1 = 数量;
                i + 分隔符长 = i;
                i = 段起;
            } 否则 {
                i + 1 = i;
            }
        }
        (文本, 段起, 文本长 - 段起)子串 = 段;
        (段数组, 段)动态字符串数组添加;
        数量 + 1 = 数量;
    }
}

// 把 段数组（动态字符串数组句柄）前 数量 段用 分隔符 连接成一个字符串；数量 <= 0 → ""
函数 (段数组, 数量:整数, 分隔符:字符串)字符串连接数组("" = 结果:字符串) {
    "" = 输出;
    0 = i;
    当 (i < 数量) {
        如果 (i > 0) {
            (输出, 分隔符)拼接 = 输出;
        }
        (段数组, i)动态字符串数组获取 = 段;
        (输出, 段)拼接 = 输出;
        i + 1 = i;
    }
    输出 = 结果;
}

// 文本 按 分隔符 可切出的段数（不建数组）；空分隔符 → 文本长度；空文本且非空分隔符 → 1
函数 (文本:字符串, 分隔符:字符串)字符串分割段数(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 文本长;
    (分隔符)长度 = 分隔符长;
    如果 (分隔符长 <= 0) {
        文本长 = 结果;
    } 否则 {
        0 = 段起;
        0 = i;
        当 (i + 分隔符长 <= 文本长) {
            1 = 命中;
            0 = j;
            当 (j < 分隔符长) {
                (文本, i + j)字符码 = 甲;
                (分隔符, j)字符码 = 乙;
                如果 (甲 != 乙) { 0 = 命中; }
                j + 1 = j;
            }
            如果 (命中 ?= 1) {
                结果 + 1 = 结果;
                i + 分隔符长 = i;
                i = 段起;
            } 否则 {
                i + 1 = i;
            }
        }
        结果 + 1 = 结果;
    }
}

// 文本 按 分隔符 切分后的第 序号 段（0 起）；越界 → ""；空分隔符 → 第 序号 个单字符
函数 (文本:字符串, 分隔符:字符串, 序号:整数)字符串取分割段("" = 结果:字符串) {
    0 = 停;
    (文本)长度 = 文本长;
    (分隔符)长度 = 分隔符长;
    如果 (序号 < 0) { 1 = 停; }
    如果 (停 ?= 0 && 分隔符长 <= 0) {
        如果 (序号 < 文本长) {
            (文本, 序号, 1)子串 = 结果;
        }
        1 = 停;
    }
    如果 (停 ?= 0) {
        0 = 当前;
        0 = 段起;
        0 = i;
        0 = 已取;
        当 (i + 分隔符长 <= 文本长) {
            1 = 命中;
            0 = j;
            当 (j < 分隔符长) {
                (文本, i + j)字符码 = 甲;
                (分隔符, j)字符码 = 乙;
                如果 (甲 != 乙) { 0 = 命中; }
                j + 1 = j;
            }
            如果 (命中 ?= 1) {
                如果 (当前 ?= 序号) {
                    (文本, 段起, i - 段起)子串 = 结果;
                    1 = 已取;
                }
                当前 + 1 = 当前;
                i + 分隔符长 = i;
                i = 段起;
            } 否则 {
                i + 1 = i;
            }
        }
        如果 (已取 ?= 0 && 当前 ?= 序号) {
            (文本, 段起, 文本长 - 段起)子串 = 结果;
        }
    }
}

// 子串 在 文本 中出现的**非重叠**次数；空 子串 → 0
函数 (文本:字符串, 子串:字符串)字符串计数子串(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 文本长;
    (子串)长度 = 子长;
    如果 (子长 > 0 && 子长 <= 文本长) {
        0 = i;
        当 (i + 子长 <= 文本长) {
            1 = 命中;
            0 = j;
            当 (j < 子长) {
                (文本, i + j)字符码 = 甲;
                (子串, j)字符码 = 乙;
                如果 (甲 != 乙) { 0 = 命中; }
                j + 1 = j;
            }
            如果 (命中 ?= 1) {
                结果 + 1 = 结果;
                i + 子长 = i;
            } 否则 {
                i + 1 = i;
            }
        }
    }
}

// ==================== 8BH：字符串取字符 / 前后缀 / 替换首个 / 填充（纯 `.心`，双链一致） ====================
//   · 承接 8BF/8BG；仅用两链皆已支持的内建（长度/字符码/子串/拼接），手写扫描，不用位或 `|`。
//   · 地址/输出约束同 8BG：句柄参数不加类型标注；赋值目标恒在 `=` 右侧（`文本 = 结果;` 即 结果 := 文本）。

// 文本第 序号 个字符（0 起）；越界 → ""
函数 (文本:字符串, 序号:整数)字符串取字符("" = 结果:字符串) {
    (文本)长度 = 文本长;
    如果 (序号 >= 0 && 序号 < 文本长) {
        (文本, 序号, 1)子串 = 结果;
    }
}

// 文本以 前缀 开头则删去该前缀，否则原样返回（空 前缀 → 原样）
函数 (文本:字符串, 前缀:字符串)字符串删除前缀("" = 结果:字符串) {
    文本 = 结果;
    (文本)长度 = 文本长;
    (前缀)长度 = 前缀长;
    如果 (前缀长 > 0 && 前缀长 <= 文本长) {
        1 = 命中;
        0 = j;
        当 (j < 前缀长) {
            (文本, j)字符码 = 甲;
            (前缀, j)字符码 = 乙;
            如果 (甲 != 乙) { 0 = 命中; }
            j + 1 = j;
        }
        如果 (命中 ?= 1) {
            (文本, 前缀长, 文本长 - 前缀长)子串 = 结果;
        }
    }
}

// 文本以 后缀 结尾则删去该后缀，否则原样返回（空 后缀 → 原样）
函数 (文本:字符串, 后缀:字符串)字符串删除后缀("" = 结果:字符串) {
    文本 = 结果;
    (文本)长度 = 文本长;
    (后缀)长度 = 后缀长;
    如果 (后缀长 > 0 && 后缀长 <= 文本长) {
        1 = 命中;
        0 = j;
        当 (j < 后缀长) {
            (文本, 文本长 - 后缀长 + j)字符码 = 甲;
            (后缀, j)字符码 = 乙;
            如果 (甲 != 乙) { 0 = 命中; }
            j + 1 = j;
        }
        如果 (命中 ?= 1) {
            (文本, 0, 文本长 - 后缀长)子串 = 结果;
        }
    }
}

// 仅替换 文本 中**首个** 旧 为 新（非重叠位置从左起）；未命中/空 旧 → 原样
函数 (文本:字符串, 旧:字符串, 新:字符串)字符串替换首个("" = 结果:字符串) {
    文本 = 结果;
    (文本)长度 = 文本长;
    (旧)长度 = 旧长;
    -1 = 位置;
    如果 (旧长 > 0 && 旧长 <= 文本长) {
        0 = i;
        0 = 停;
        当 (停 ?= 0 && i + 旧长 <= 文本长) {
            1 = 命中;
            0 = j;
            当 (j < 旧长) {
                (文本, i + j)字符码 = 甲;
                (旧, j)字符码 = 乙;
                如果 (甲 != 乙) { 0 = 命中; }
                j + 1 = j;
            }
            如果 (命中 ?= 1) {
                i = 位置;
                1 = 停;
            } 否则 {
                i + 1 = i;
            }
        }
    }
    如果 (位置 >= 0) {
        (文本, 0, 位置)子串 = 头;
        (文本, 位置 + 旧长, 文本长 - 位置 - 旧长)子串 = 尾;
        (头, 新)拼接 = 结果;
        (结果, 尾)拼接 = 结果;
    }
}

// 在左侧用 填充 反复补齐，直至长度 >= 宽度（填充为空 → 原样；宽度 <= 当前长度 → 原样）
函数 (文本:字符串, 宽度:整数, 填充:字符串)字符串左填充("" = 结果:字符串) {
    文本 = 结果;
    (文本)长度 = 文本长;
    (填充)长度 = 填充长;
    如果 (填充长 > 0) {
        当 (文本长 < 宽度) {
            (填充, 结果)拼接 = 结果;
            文本长 + 填充长 = 文本长;
        }
    }
}

// 在右侧用 填充 反复补齐，直至长度 >= 宽度（填充为空 → 原样；宽度 <= 当前长度 → 原样）
函数 (文本:字符串, 宽度:整数, 填充:字符串)字符串右填充("" = 结果:字符串) {
    文本 = 结果;
    (文本)长度 = 文本长;
    (填充)长度 = 填充长;
    如果 (填充长 > 0) {
        当 (文本长 < 宽度) {
            (结果, 填充)拼接 = 结果;
            文本长 + 填充长 = 文本长;
        }
    }
}

// ==================== 8BJ：数字/文本互转 · 空白判定 · 字典序比较（纯 `.心`，双链一致） ====================
//   · 承接 8BF/8BG/8BH；仅用两链皆已支持的内建（长度/字符码/拼接），手写扫描。
//   · 整数运算用 `/`（整除）与 `%`（取余）——均已在 `DNS.心`/`B树.心`/`AES.心` 使用。
//   · 赋值目标恒在 `=` 右侧（`结果 * 符号 = 结果;` 即 结果 := 结果 * 符号）。

// 是否整数文本（可选前导 `+`/`-`，其后至少一个数字字符；`1`/`0`）
函数 (文本:字符串)字符串是否整数(0 = 结果:整数) {
    0 = 结果;
    (文本)长度 = 长度;
    如果 (长度 > 0) {
        0 = 起;
        (文本, 0)字符码 = 首码;
        如果 (首码 ?= 43 || 首码 ?= 45) { 1 = 起; }
        如果 (起 < 长度) {
            1 = 全数字;
            当 (起 < 长度) {
                (文本, 起)字符码 = 码;
                如果 (码 < 48 || 码 > 57) { 0 = 全数字; }
                起 + 1 = 起;
            }
            如果 (全数字 ?= 1) { 1 = 结果; }
        }
    }
}

// 解析整数（可选前导 `+`/`-`；逐位累加；遇非数字停止；无有效数字 → 0）
函数 (文本:字符串)字符串转整数(0 = 结果:整数) {
    0 = 结果;
    1 = 符号;
    0 = i;
    (文本)长度 = 长度;
    如果 (长度 > 0) {
        (文本, 0)字符码 = 首码;
        如果 (首码 ?= 45) {
            -1 = 符号;
            1 = i;
        } 否则如果 (首码 ?= 43) {
            1 = i;
        }
    }
    当 (i < 长度) {
        (文本, i)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            结果 * 10 + 码 - 48 = 结果;
        }
        i + 1 = i;
    }
    结果 * 符号 = 结果;
}

// 整数转十进制文本（含负号；0 → "0"；逐位取余逆序拼装）
函数 (值:整数)整数转字符串("" = 结果:字符串) {
    "" = 输出;
    如果 (值 ?= 0) {
        "0" = 输出;
    } 否则 {
        0 = 数;
        如果 (值 < 0) {
            0 - 值 = 数;
        } 否则 {
            值 = 数;
        }
        当 (数 > 0) {
            数 / 10 = 商;
            数 - 商 * 10 = 位;
            位 + 48 = 码;
            (码)字符 = 字符;
            (字符, 输出)拼接 = 输出;
            商 = 数;
        }
        如果 (值 < 0) {
            ("-", 输出)拼接 = 输出;
        }
    }
    输出 = 结果;
}

// 是否全为空白（空格 32 / 制表 9 / 换行 10 / 回车 13）；空串 → 1
函数 (文本:字符串)字符串是否空白(0 = 结果:整数) {
    1 = 结果;
    (文本)长度 = 长度;
    0 = i;
    当 (i < 长度) {
        (文本, i)字符码 = 码;
        如果 (码 != 32 && 码 != 9 && 码 != 10 && 码 != 13) { 0 = 结果; }
        i + 1 = i;
    }
}

// 按字符码字典序比较：甲 < 乙 → -1，相等 → 0，甲 > 乙 → 1（较短前缀较小时更小）
函数 (甲:字符串, 乙:字符串)字符串比较(0 = 结果:整数) {
    0 = 结果;
    (甲)长度 = 长甲;
    (乙)长度 = 长乙;
    0 = i;
