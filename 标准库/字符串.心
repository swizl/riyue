    当 (停 ?= 0 && i < 长甲 && i < 长乙) {
        (甲, i)字符码 = 码甲;
        (乙, i)字符码 = 码乙;
        如果 (码甲 < 码乙) {
            -1 = 结果;
            1 = 停;
        } 否则如果 (码甲 > 码乙) {
            1 = 结果;
            1 = 停;
        } 否则 {
            i + 1 = i;
        }
    }
    如果 (停 ?= 0) {
        如果 (i < 长甲) { 1 = 结果; }
        否则如果 (i < 长乙) { -1 = 结果; }
    }
}
