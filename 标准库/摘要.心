                (乙, 丙, 丁)摘要SHA1异或 = f;
                -899497514 = k;
            }

            (W, i)动态数组获取 = 词;
            (甲, 5)摘要循环左移 = 旋甲;
            (旋甲 + f + 戊 + k + 词) = 临;
            丁 = 戊;
            丙 = 丁;
            (乙, 30)摘要循环左移 = 丙;
            甲 = 乙;
            临 = 甲;
            i + 1 = i;
        }

        甲 + 保甲 = 甲;
        乙 + 保乙 = 乙;
        丙 + 保丙 = 丙;
        丁 + 保丁 = 丁;
        戊 + 保戊 = 戊;
