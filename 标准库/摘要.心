        ()创建动态数组 = M;
        0 = g0;
        当 (g0 < 16) {
            (块 * 64 + g0 * 4) = 基;
            (缓冲, 基)动态数组获取 = m0;
            (缓冲, 基 + 1)动态数组获取 = m1;
            (缓冲, 基 + 2)动态数组获取 = m2;
            (缓冲, 基 + 3)动态数组获取 = m3;
