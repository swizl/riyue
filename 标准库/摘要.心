// MD5 摘要（RFC 1321），返回 32 位小写十六进制串。
// 适配说明（双链一致必需）：
//   1) 宿主链不支持位或 `|` → 用 a+b-(a&b) 仿真（模 2^32 下与或等价）。
//   2) 位反 `~x` → (0-1)^x（与全 1 异或）。
//   3) 循环左移 → (x<|s) + ((x>|(32-s)) & ((1<|s)-1))：高半与低半位段不相交，加即或；
//      `整数` 为有符号 32 位、`>|` 为算术右移，低位掩码后即得逻辑右移。
//   4) 十六进制段「即取即拼」：宿主链 `字符` 结果为共享静态缓冲，同一时刻只持有一个
//      `(码)字符` 结果并立即拼接，避免相邻结果互相覆盖（同 标准库/编码.心）。
// 限制：长度按字符数（ASCII 下等于字节数）；仅支持 ASCII/单字节文本。

函数 (a: 整数, b: 整数)MD5位或(0 = 结果: 整数) {
    (a & b) = 交;
    a + b - 交 = 结果;
}

函数 (x: 整数, s: 整数)MD5循环左移(0 = 结果: 整数) {
    1 = 掩;
    (掩 <| s) - 1 = 掩;
    (x >| (32 - s)) & 掩 = 低位;
    (x <| s) + 低位 = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)MD5F(0 = 结果: 整数) {
    (b & c) = 项一;
    (((0 - 1) ^ b) & d) = 项二;
    项一 + 项二 = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)MD5G(0 = 结果: 整数) {
    (b & d) = 项一;
    (c & ((0 - 1) ^ d)) = 项二;
    项一 + 项二 = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)MD5H(0 = 结果: 整数) {
    (b ^ c ^ d) = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)MD5I(0 = 结果: 整数) {
    (b, (0 - 1) ^ d)MD5位或 = 内;
    (c ^ 内) = 结果;
}

函数 (值: 整数)MD5十六进制字符("?" = 结果: 文本) {
    "0123456789abcdef" = 表;
    如果 (值 < 16) {
        (表, 值)字符码 = 码;
        (码)字符 = 结果;
    }
}

函数 (消息: 文本)MD5(0 = 结果: 文本) {
    [-680876936, -389564586, 606105819, -1044525330, -176418897, 1200080426, -1473231341, -45705983, 1770035416, -1958414417, -42063, -1990404162, 1804603682, -40341101, -1502002290, 1236535329, -165796510, -1069501632, 643717713, -373897302, -701558691, 38016083, -660478335, -405537848, 568446438, -1019803690, -187363961, 1163531501, -1444681467, -51403784, 1735328473, -1926607734, -378558, -2022574463, 1839030562, -35309556, -1530992060, 1272893353, -155497632, -1094730640, 681279174, -358537222, -722521979, 76029189, -640364487, -421815835, 530742520, -995338651, -198630844, 1126891415, -1416354905, -57434055, 1700485571, -1894986606, -1051523, -2054922799, 1873313359, -30611744, -1560198380, 1309151649, -145523070, -1120210379, 718787259, -343485551] = K;
    [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21] = S;

    (消息)长度 = 原长;

    ()创建动态数组 = 缓冲;
    0 = p;
    当 (p < 原长) {
        (缓冲, (消息, p)字符码)动态数组添加;
        p + 1 = p;
    }
    (缓冲, 128)动态数组添加;

    0 = 停;
    当 (停 ?= 0) {
        (缓冲)动态数组大小 = 大小;
        大小 % 64 = 余;
        如果 (余 ?= 56) {
            1 = 停;
        } 否则 {
            (缓冲, 0)动态数组添加;
        }
    }

    原长 * 8 = 位数;
    0 = j;
    0 = 字;
    当 (j < 8) {
        如果 (j < 4) {
            ((位数 >| (j * 8)) & 255) = 字;
        } 否则 {
            0 = 字;
        }
        (缓冲, 字)动态数组添加;
        j + 1 = j;
    }

    1732584193 = 甲;
    -271733879 = 乙;
    -1732584194 = 丙;
    271733878 = 丁;

    (缓冲)动态数组大小 = 总;
    总 / 64 = 块数;
    0 = 块;
    当 (块 < 块数) {
        甲 = 保甲;
        乙 = 保乙;
        丙 = 保丙;
        丁 = 保丁;

        ()创建动态数组 = M;
        0 = g0;
        当 (g0 < 16) {
            (块 * 64 + g0 * 4) = 基;
            (缓冲, 基)动态数组获取 = m0;
            (缓冲, 基 + 1)动态数组获取 = m1;
            (缓冲, 基 + 2)动态数组获取 = m2;
            (缓冲, 基 + 3)动态数组获取 = m3;
            (m0 + (m1 <| 8) + (m2 <| 16) + (m3 <| 24)) = 词;
            (M, 词)动态数组添加;
            g0 + 1 = g0;
        }

        0 = i;
        0 = f;
        0 = g;
        当 (i < 64) {
            如果 (i < 16) {
                (乙, 丙, 丁)MD5F = f;
                i = g;
            } 否则如果 (i < 32) {
                (乙, 丙, 丁)MD5G = f;
                ((5 * i + 1) % 16) = g;
            } 否则如果 (i < 48) {
                (乙, 丙, 丁)MD5H = f;
                ((3 * i + 5) % 16) = g;
            } 否则 {
                (乙, 丙, 丁)MD5I = f;
                ((7 * i) % 16) = g;
            }

            (M, g)动态数组获取 = 词;
            K[i] = 常数;
            S[i] = 移位;
            (甲 + f + 常数 + 词) = 和;
            (和, 移位)MD5循环左移 = 旋转;

            丁 = 存丁;
            丙 = 存丙;
            乙 = 存乙;
            存丙 = 丁;
            存乙 = 丙;
            (存乙 + 旋转) = 乙;
            存丁 = 甲;

            i + 1 = i;
        }

        甲 + 保甲 = 甲;
        乙 + 保乙 = 乙;
        丙 + 保丙 = 丙;
        丁 + 保丁 = 丁;
        块 + 1 = 块;
    }

    ()创建动态数组 = 字表;
    (字表, 甲)动态数组添加;
    (字表, 乙)动态数组添加;
    (字表, 丙)动态数组添加;
    (字表, 丁)动态数组添加;

    "" = 十六;
    0 = w;
    当 (w < 4) {
        (字表, w)动态数组获取 = 字;
        0 = bi;
        当 (bi < 4) {
            ((字 >| (bi * 8)) & 255) = 字节;
            (字节 >| 4) = 高半;
            (字节 & 15) = 低半;
            (高半)MD5十六进制字符 = 高字符;
            (十六, 高字符)拼接 = 十六;
            (低半)MD5十六进制字符 = 低字符;
            (十六, 低字符)拼接 = 十六;
            bi + 1 = bi;
        }
        w + 1 = w;
    }
    十六 = 结果;
}