            0 = 字;
        }
        (缓冲, 字)动态数组添加;
        j + 1 = j;
    }

    1732584193 = 甲;
    -271733879 = 乙;
    -1732584194 = 丙;
    271733878 = 丁;

    (缓冲)动态数组大小 = 总;
    总 / 64 = 块数;
    0 = 块;
    当 (块 < 块数) {
        甲 = 保甲;
        乙 = 保乙;
        丙 = 保丙;
