            (M, 词)动态数组添加;
            g0 + 1 = g0;
        }

        0 = i;
        0 = f;
        0 = g;
        当 (i < 64) {
            如果 (i < 16) {
                (乙, 丙, 丁)MD5F = f;
                i = g;
            } 否则如果 (i < 32) {
                (乙, 丙, 丁)MD5G = f;
                ((5 * i + 1) % 16) = g;
            } 否则如果 (i < 48) {
                (乙, 丙, 丁)MD5H = f;
                ((3 * i + 5) % 16) = g;
            } 否则 {
                (乙, 丙, 丁)MD5I = f;
                ((7 * i) % 16) = g;
            }

            (M, g)动态数组获取 = 词;
            K[i] = 常数;
            S[i] = 移位;
            (甲 + f + 常数 + 词) = 和;
            (和, 移位)摘要循环左移 = 旋转;

            丁 = 存丁;
            丙 = 存丙;
            乙 = 存乙;
            存丙 = 丁;
            存乙 = 丙;
            (存乙 + 旋转) = 乙;
            存丁 = 甲;

            i + 1 = i;
        }

        甲 + 保甲 = 甲;
        乙 + 保乙 = 乙;
        丙 + 保丙 = 丙;
        丁 + 保丁 = 丁;
        块 + 1 = 块;
    }

    ()创建动态数组 = 字表;
    (字表, 甲)动态数组添加;
    (字表, 乙)动态数组添加;
    (字表, 丙)动态数组添加;
    (字表, 丁)动态数组添加;

    "" = 十六;
    0 = w;
    当 (w < 4) {
        (字表, w)动态数组获取 = 字;
        0 = bi;
        当 (bi < 4) {
            ((字 >| (bi * 8)) & 255) = 字节;
            (字节 >| 4) = 高半;
            (字节 & 15) = 低半;
            (高半)摘要十六进制字符 = 高字符;
            (十六, 高字符)拼接 = 十六;
            (低半)摘要十六进制字符 = 低字符;
            (十六, 低字符)拼接 = 十六;
            bi + 1 = bi;
        }
        w + 1 = w;
    }
    十六 = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)摘要SHA1选择(0 = 结果: 整数) {
    (b & c) = 项一;
    ((0 - 1) ^ b) = 反乙;
    (反乙 & d) = 项二;
    (项一, 项二)摘要位或 = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)摘要SHA1异或(0 = 结果: 整数) {
    (b ^ c ^ d) = 结果;
}

函数 (b: 整数, c: 整数, d: 整数)摘要SHA1多数(0 = 结果: 整数) {
    (b & c) = 项一;
    (b & d) = 项二;
    (项一, 项二)摘要位或 = 甲乙;
    (c & d) = 项三;
    (甲乙, 项三)摘要位或 = 结果;
}

// SHA-1（RFC 3174），返回 40 位小写十六进制串。
// 与 MD5 同源适配：位或用 摘要位或、循环左移用 摘要循环左移、十六进制段即取即拼。
// 差异：消息填充长度与字序均为大端。
函数 (消息: 文本)SHA1(0 = 结果: 文本) {
    (消息)长度 = 原长;

    ()创建动态数组 = 缓冲;
    0 = p;
    当 (p < 原长) {
        (缓冲, (消息, p)字符码)动态数组添加;
        p + 1 = p;
    }
    (缓冲, 128)动态数组添加;

    0 = 停;
    当 (停 ?= 0) {
        (缓冲)动态数组大小 = 大小;
        大小 % 64 = 余;
        如果 (余 ?= 56) {
            1 = 停;
        } 否则 {
            (缓冲, 0)动态数组添加;
        }
    }

    原长 * 8 = 位数;
    0 = j;
    0 = 字;
    当 (j < 8) {
        如果 (j < 4) {
            0 = 字;
        } 否则 {
            ((位数 >| ((7 - j) * 8)) & 255) = 字;
        }
        (缓冲, 字)动态数组添加;
        j + 1 = j;
    }

    1732584193 = 甲;
    -271733879 = 乙;
    -1732584194 = 丙;
    271733878 = 丁;
    -1009589776 = 戊;

    (缓冲)动态数组大小 = 总;
    总 / 64 = 块数;
    0 = 块;
    当 (块 < 块数) {
        甲 = 保甲;
        乙 = 保乙;
        丙 = 保丙;
        丁 = 保丁;
        戊 = 保戊;

        ()创建动态数组 = W;
        0 = t;
        0 = 词;
        0 = m0;
        0 = m1;
        0 = m2;
        0 = m3;
        0 = w3;
        0 = w8;
        0 = w14;
