// 日月标准库 - 迭代器与急切集合适配器
// 阶段：短板补齐计划 §Phase 5（迭代器与生成器）+ 编译器差距补齐计划 §阶段8「迭代器适配器」
// 状态：**急切版适配器已落地**（纯 .心，回调以 `函数` 值传入）；惰性版（`下一个`/`结束` 协议、
//       生成器 `让出`）待后续切片。
//
// 设计：适配器一律「数组 → 新数组」或「数组 → 标量」，可任意链式组合：
//   (源, 变换)迭代器映射 -> 新数组      // 逐元素变换
//   (源, 谓词)迭代器过滤 -> 新数组      // 保留谓词为真（1）的元素
//   (源, 初值, 合并)迭代器折叠 -> 标量  // 左折叠：累计 = 合并(累计, 元素)
//   (源, 个数:整数)迭代器取 -> 新数组    // 取前 n 个（n 超长按全长）
//   (源, 个数:整数)迭代器跳过 -> 新数组  // 跳过前 n 个
//   (甲, 乙)迭代器连接 -> 新数组        // 顺序拼接
//   (源)迭代器反转 -> 新数组            // 逆序
//   (源)迭代器计数 -> 标量              // 元素个数
//
// 约束：源与新数组均为内建动态数组句柄（整数元素）；回调为 `函数` 值（闭包 / 匿名函数）。
//       **返回新数组的函数结果须标注 `:指针`**（数组句柄为指针；标注 `:整数` 会被截断为 32 位
//       并在调用方还原成野指针——两链均实证崩溃）。
//       非整数元素容器（字符串数组等）另片。

// 逐元素变换
函数 (源, 变换:函数)迭代器映射(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = 值;
        (值)变换 = 新值;
        (输出, 新值)动态数组添加;
        i + 1 = i;
    }
    输出 = 结果;
}

// 保留谓词为真的元素
函数 (源, 谓词:函数)迭代器过滤(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = 值;
        如果 ((值)谓词 ?= 1) {
            (输出, 值)动态数组添加;
        }
        i + 1 = i;
    }
    输出 = 结果;
}

// 左折叠：累计 = 合并(累计, 元素)
函数 (源, 初值:整数, 合并:函数)迭代器折叠(0 = 结果:整数) {
    初值 = 累计;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = 值;
        (累计, 值)合并 = 累计;
        i + 1 = i;
    }
    累计 = 结果;
}

// 取前 n 个（n 超过长度时按全长）
函数 (源, 个数:整数)迭代器取(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 总;
    0 = i;
    当 (i < 个数 && i < 总) {
        (源, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i + 1 = i;
    }
    输出 = 结果;
}

// 跳过前 n 个
函数 (源, 个数:整数)迭代器跳过(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 总;
    个数 = i;
    如果 (i < 0) { 0 = i; }
    当 (i < 总) {
        (源, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i + 1 = i;
    }
    输出 = 结果;
}

// 顺序拼接
函数 (甲, 乙)迭代器连接(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (甲)动态数组大小 = 甲数;
    0 = i;
    当 (i < 甲数) {
        (甲, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i + 1 = i;
    }
    (乙)动态数组大小 = 乙数;
    0 = j;
    当 (j < 乙数) {
        (乙, j)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        j + 1 = j;
    }
    输出 = 结果;
}

// 逆序
函数 (源)迭代器反转(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 个数;
    个数 - 1 = i;
    当 (i >= 0) {
        (源, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i - 1 = i;
    }
    输出 = 结果;
}

// 元素个数
函数 (源)迭代器计数(0 = 结果:整数) {
    (源)动态数组大小 = 结果;
}

// 模块版本：2 = 急切适配器已落地（1 = 早期骨架）
函数 ()迭代器模块版本(0 = 结果: 整数) {
    2 = 结果;
}
