// 日月标准库 - 迭代器与急切集合适配器
// 阶段：短板补齐计划 §Phase 5（迭代器与生成器）+ 编译器差距补齐计划 §阶段8「迭代器适配器」
// 状态：**急切适配器 + 惰性游标协议均已落地**（纯 .心）；生成器语法由语言层 `协程` + `让出` + `恢复`
//       提供（见 示例/协程测试.心），本模块的游标可消费其产出的元素。
//
// 设计：适配器一律「数组 → 新数组」或「数组 → 标量」，可任意链式组合：
//   (源, 变换)迭代器映射 -> 新数组      // 逐元素变换
//   (源, 谓词)迭代器过滤 -> 新数组      // 保留谓词为真（1）的元素
//   (源, 初值, 合并)迭代器折叠 -> 标量  // 左折叠：累计 = 合并(累计, 元素)
//   (源, 个数:整数)迭代器取 -> 新数组    // 取前 n 个（n 超长按全长）
//   (源, 个数:整数)迭代器跳过 -> 新数组  // 跳过前 n 个
//   (甲, 乙)迭代器连接 -> 新数组        // 顺序拼接
//   (源)迭代器反转 -> 新数组            // 逆序
//   (源)迭代器计数 -> 标量              // 元素个数
//
// 约束：源与新数组均为内建动态数组句柄（整数元素）；回调为 `函数` 值（闭包 / 匿名函数）。
//       **返回新数组的函数结果须标注 `:指针`**（数组句柄为指针；标注 `:整数` 会被截断为 32 位
//       并在调用方还原成野指针——两链均实证崩溃）。
//       非整数元素容器（字符串数组等）另片。
//       映射容器（`标准库/哈希映射.心`）的 `键数组()`/`值数组()` 可直接接入本模块适配器链，
//       其槽序惰性游标（`重置游标`/`有下一个`/`下一个键`/`下一个值`/`剩余`）由该模块提供。

// 逐元素变换
函数 (源, 变换:函数)迭代器映射(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = 值;
        (值)变换 = 新值;
        (输出, 新值)动态数组添加;
        i + 1 = i;
    }
    输出 = 结果;
}

// 保留谓词为真的元素
函数 (源, 谓词:函数)迭代器过滤(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = 值;
        如果 ((值)谓词 ?= 1) {
            (输出, 值)动态数组添加;
        }
        i + 1 = i;
    }
    输出 = 结果;
}

// 左折叠：累计 = 合并(累计, 元素)
函数 (源, 初值:整数, 合并:函数)迭代器折叠(0 = 结果:整数) {
    初值 = 累计;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = 值;
        (累计, 值)合并 = 累计;
        i + 1 = i;
    }
    累计 = 结果;
}

// 取前 n 个（n 超过长度时按全长）
函数 (源, 个数:整数)迭代器取(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 总;
    0 = i;
    当 (i < 个数 && i < 总) {
        (源, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i + 1 = i;
    }
    输出 = 结果;
}

// 跳过前 n 个
函数 (源, 个数:整数)迭代器跳过(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 总;
    个数 = i;
    如果 (i < 0) { 0 = i; }
    当 (i < 总) {
        (源, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i + 1 = i;
    }
    输出 = 结果;
}

// 顺序拼接
函数 (甲, 乙)迭代器连接(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (甲)动态数组大小 = 甲数;
    0 = i;
    当 (i < 甲数) {
        (甲, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i + 1 = i;
    }
    (乙)动态数组大小 = 乙数;
    0 = j;
    当 (j < 乙数) {
        (乙, j)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        j + 1 = j;
    }
    输出 = 结果;
}

// 逆序
函数 (源)迭代器反转(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (源)动态数组大小 = 个数;
    个数 - 1 = i;
    当 (i >= 0) {
        (源, i)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        i - 1 = i;
    }
    输出 = 结果;
}

// 元素个数
函数 (源)迭代器计数(0 = 结果:整数) {
    (源)动态数组大小 = 结果;
}

// ==================== 惰性游标协议（纯 `.心`） ====================
// 游标 = 动态整数数组 `[位置, 长度]`。**游标不持有源**：动态数组元素是 32 位整数，
// 存放 64 位数组/字符串句柄会被截断，故协议各步都显式接收源（首个参数）。
// 典型用法：
//     (源)迭代器游标 = 游标;
//     1 = 继续;
//     当 (继续 ?= 1) {
//         (源, 游标)迭代器有下一个 = 有;
//         如果 (有 ?= 1) { (源, 游标)迭代器下一个 = 值; } 否则 { 0 = 继续; }
//     }
// 语义：`迭代器结束` 是 `有下一个` 的取反；`迭代器下一个` 在耗尽后归返 0 且游标不动。

// 新建数组游标（位置 0，长度取 源 的当前大小）
函数 (源)迭代器游标(0 = 结果:指针) {
    ()创建动态数组 = 游标;
    (游标, 0)动态数组添加;
    (源)动态数组大小 = 长;
    (游标, 长)动态数组添加;
    游标 = 结果;
}

// 当前位置（0 起）
函数 (游标)迭代器位置(0 = 结果:整数) {
    (游标, 0)动态数组获取 = 结果;
}

// 总长度（建游标时的快照）
函数 (游标)迭代器长度(0 = 结果:整数) {
    (游标, 1)动态数组获取 = 结果;
}

// 尚未取出的元素个数（不为负）
函数 (游标)迭代器剩余(0 = 结果:整数) {
    (游标, 0)动态数组获取 = 位;
    (游标, 1)动态数组获取 = 长;
    如果 (位 < 长) {
        长 - 位 = 结果;
    }
}

// 还有下一个？
函数 (源, 游标)迭代器有下一个(0 = 结果:整数) {
    (游标, 0)动态数组获取 = 位;
    (游标, 1)动态数组获取 = 长;
    如果 (位 < 长) { 1 = 结果; }
}

// 是否已结束？（`有下一个` 的取反）
函数 (源, 游标)迭代器结束(0 = 结果:整数) {
    (源, 游标)迭代器有下一个 = 有;
    如果 (有 ?= 0) { 1 = 结果; }
}

// 取下一个元素并把游标前移；耗尽后归返 0 且游标不动
函数 (源, 游标)迭代器下一个(0 = 结果:整数) {
    (游标, 0)动态数组获取 = 位;
    (游标, 1)动态数组获取 = 长;
    如果 (位 < 长) {
        (源, 位)动态数组获取 = 结果;
        (游标, 0, 位 + 1)动态数组设置;
    }
}

// 重置到起点
函数 (游标)迭代器重置(空) {
    (游标, 0, 0)动态数组设置;
}

// 把剩余元素收集为新数组（游标耗尽）
函数 (源, 游标)迭代器收集(0 = 结果:指针) {
    ()创建动态数组 = 输出;
    (游标, 0)动态数组获取 = 位;
    (游标, 1)动态数组获取 = 长;
    当 (位 < 长) {
        (源, 位)动态数组获取 = 值;
        (输出, 值)动态数组添加;
        位 + 1 = 位;
    }
    (游标, 0, 位)动态数组设置;
    输出 = 结果;
}

// ==================== 文本游标（按码点切分） ====================
// 文本拆成「动态字符串数组」逐码点元素，再用文本游标按同一 `下一个 / 结束` 协议消费。
// 语言层 `长度` / `字符码` / `子串` 均按**码点**索引（运行时已做字符→字节换算），故逐位取 1 个字符即可。

// 把 文本 按码点拆入调用方给定的 字符数组，归返码点个数
函数 (文本:字符串, 字符数组)文本拆字符(0 = 结果:整数) {
    (文本)长度 = 数;
    0 = 位;
    当 (位 < 数) {
        (文本, 位, 1)子串 = 字;
        (字符数组, 字)动态字符串数组添加;
        位 + 1 = 位;
    }
    数 = 结果;
}

// 新建文本游标（长度取 源 字符串数组的当前大小）
函数 (源)迭代器文本游标(0 = 结果:指针) {
    ()创建动态数组 = 游标;
    (游标, 0)动态数组添加;
    (源)动态字符串数组大小 = 长;
    (游标, 长)动态数组添加;
    游标 = 结果;
}

// 文本游标：还有下一个？
函数 (源, 游标)迭代器文本有下一个(0 = 结果:整数) {
    (游标, 0)动态数组获取 = 位;
    (游标, 1)动态数组获取 = 长;
    如果 (位 < 长) { 1 = 结果; }
}

// 文本游标：取下一个码点文本；耗尽后归返 "" 且游标不动
函数 (源, 游标)迭代器下一个文本("" = 结果:字符串) {
    (游标, 0)动态数组获取 = 位;
    (游标, 1)动态数组获取 = 长;
    如果 (位 < 长) {
        (源, 位)动态字符串数组获取 = 结果;
        (游标, 0, 位 + 1)动态数组设置;
    }
}

// 模块版本：3 = 急切适配器 + 惰性游标协议 + 文本码点游标（2 = 仅急切适配器；1 = 早期骨架）
函数 ()迭代器模块版本(0 = 结果: 整数) {
    3 = 结果;
}
