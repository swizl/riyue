// 日月标准库 - 集合工具
// 基于动态数组实现集合操作

函数 (arr:整数[], size:整数)(0 = 结果:整数) {
    ()创建动态数组 = seen;
    0 = unique_count;
    0 = i;
    当 (i < size) {
        (arr, i)获取动态数组元素 = val;
        // 简单线性检查（因为没有哈希表）
        1 = is_dup;
        0 = j;
        当 (j < unique_count) {
            (seen, j)获取动态数组元素 = seen_val;
            如果 (seen_val ?= val) { 0 = is_dup; }
            j + 1 = j;
        }
        如果 (is_dup ?= 1) {
            (seen, val)动态数组添加;
            unique_count + 1 = unique_count;
        }
        i + 1 = i;
    }
    // 复制回原数组
    0 = i;
    当 (i < unique_count) {
        (seen, i)获取动态数组元素 = val;
        (arr, i, val)动态数组设置;
        i + 1 = i;
    }
    unique_count = 结果;
}

函数 (arr1:整数[], size1:整数, arr2:整数[], size2:整数)(0 = 结果:整数) {
    ()创建动态数组 = 联合;
    0 = 联合大小;
    // 添加第一个数组的所有元素
    0 = i;
    当 (i < size1) {
        (arr1, i)获取动态数组元素 = val;
        (联合, val)动态数组添加;
        联合大小 + 1 = 联合大小;
        i + 1 = i;
    }
    // 添加第二个数组的唯一元素
    0 = j;
    当 (j < size2) {
        (arr2, j)获取动态数组元素 = val;
        1 = is_new;
        0 = k;
        当 (k < 联合大小) {
            (联合, k)获取动态数组元素 = existing;
            如果 (existing ?= val) { 0 = is_new; }
            k + 1 = k;
        }
        如果 (is_new ?= 1) {
            (联合, val)动态数组添加;
            联合大小 + 1 = 联合大小;
        }
        j + 1 = j;
    }
    联合大小 = 结果;
}

函数 (arr1:整数[], size1:整数, arr2:整数[], size2:整数)(0 = 结果:整数) {
    ()创建动态数组 = 交集;
    0 = 交集大小;
    0 = i;
    当 (i < size1) {
        (arr1, i)获取动态数组元素 = val;
        0 = j;
        当 (j < size2) {
            (arr2, j)获取动态数组元素 = other;
            如果 (other ?= val) {
                (交集, val)动态数组添加;
                交集大小 + 1 = 交集大小;
            }
            j + 1 = j;
        }
        i + 1 = i;
    }
    交集大小 = 结果;
}

函数 (arr:整数[], size:整数, target:整数)(-1 = 结果:整数) {
    0 = i;
    当 (i < size) {
        (arr, i)获取动态数组元素 = val;
        如果 (val ?= target) { i = 结果; }
        i + 1 = i;
    }
}

函数 (arr:整数[], size:整数, compare:函数)(0 = 结果:整数) {
    0 = i;
    当 (i < size - 1) {
        0 = j;
        当 (j < size - i - 1) {
            (arr, j)获取动态数组元素 = a;
            (arr, j + 1)获取动态数组元素 = b;
            如果 ((a, b)比较 ?= 1) {
                (arr, j, b)动态数组设置;
                (arr, j + 1, a)动态数组设置;
            }
            j + 1 = j;
        }
        i + 1 = i;
    }
    0 = 结果;
}
