// 日月标准库 - 集合工具
// 基于动态数组实现集合操作
//
// 8BD：新增 `数组差集`（结果写回 arr1，返回新长度）、`数组包含`（arr1 ⊇ arr2）、`数组相等`（长度相同且互为子集）。

函数 (arr, size:整数)数组去重(0 = 结果:整数) {
    ()创建动态数组 = seen;
    0 = unique_count;
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = val;
        // 简单线性检查（因为没有哈希表）
        1 = is_dup;
        0 = j;
        当 (j < unique_count) {
            (seen, j)动态数组获取 = seen_val;
            如果 (seen_val ?= val) { 0 = is_dup; }
            j + 1 = j;
        }
        如果 (is_dup ?= 1) {
            (seen, val)动态数组添加;
            unique_count + 1 = unique_count;
        }
        i + 1 = i;
    }
    // 复制回原数组
    0 = i;
    当 (i < unique_count) {
        (seen, i)动态数组获取 = val;
        (arr, i, val)动态数组设置;
        i + 1 = i;
    }
    unique_count = 结果;
}

函数 (arr1, size1:整数, arr2, size2:整数)数组联合(0 = 结果:整数) {
    ()创建动态数组 = 联合;
    0 = 联合大小;
    // 添加第一个数组的所有元素
    0 = i;
    当 (i < size1) {
        (arr1, i)动态数组获取 = val;
        (联合, val)动态数组添加;
        联合大小 + 1 = 联合大小;
        i + 1 = i;
    }
    // 添加第二个数组的唯一元素
    0 = j;
    当 (j < size2) {
        (arr2, j)动态数组获取 = val;
        1 = is_new;
        0 = k;
        当 (k < 联合大小) {
            (联合, k)动态数组获取 = existing;
            如果 (existing ?= val) { 0 = is_new; }
            k + 1 = k;
        }
        如果 (is_new ?= 1) {
            (联合, val)动态数组添加;
            联合大小 + 1 = 联合大小;
        }
        j + 1 = j;
    }
    联合大小 = 结果;
}

函数 (arr1, size1:整数, arr2, size2:整数)数组交集(0 = 结果:整数) {
    ()创建动态数组 = 交集;
    0 = 交集大小;
    0 = i;
    当 (i < size1) {
        (arr1, i)动态数组获取 = val;
        0 = j;
        当 (j < size2) {
            (arr2, j)动态数组获取 = other;
            如果 (other ?= val) {
                (交集, val)动态数组添加;
                交集大小 + 1 = 交集大小;
            }
            j + 1 = j;
        }
        i + 1 = i;
    }
    交集大小 = 结果;
}

函数 (arr, size:整数, target:整数)数组查找下标(-1 = 结果:整数) {
    0 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = val;
        如果 (val ?= target) { i = 结果; }
        i + 1 = i;
    }
}

函数 (arr, size:整数, compare:函数)数组排序(0 = 结果:整数) {
    0 = i;
    当 (i < size - 1) {
        0 = j;
        当 (j < size - i - 1) {
            (arr, j)动态数组获取 = a;
            (arr, j + 1)动态数组获取 = b;
            如果 ((a, b)compare ?= 1) {
                (arr, j, b)动态数组设置;
                (arr, j + 1, a)动态数组设置;
            }
            j + 1 = j;
        }
        i + 1 = i;
    }
    0 = 结果;
}

// 数组差集：arr1 中不属于 arr2 的元素（保序），结果写回 arr1 并返回新长度
函数 (arr1, size1:整数, arr2, size2:整数)数组差集(0 = 结果:整数) {
    ()创建动态数组 = 差;
    0 = 差大小;
    0 = i;
    当 (i < size1) {
        (arr1, i)动态数组获取 = val;
        0 = 在乙;
        0 = j;
        当 (j < size2) {
            (arr2, j)动态数组获取 = other;
            如果 (other ?= val) { 1 = 在乙; }
            j + 1 = j;
        }
        如果 (在乙 ?= 0) {
            (差, val)动态数组添加;
            差大小 + 1 = 差大小;
        }
        i + 1 = i;
    }
    0 = i;
    当 (i < 差大小) {
        (差, i)动态数组获取 = val;
        (arr1, i, val)动态数组设置;
        i + 1 = i;
    }
    差大小 = 结果;
}

// 数组包含：arr2 的每个元素都能在 arr1 中找到 → 1；否则 0（空 arr2 视为包含）
函数 (arr1, size1:整数, arr2, size2:整数)数组包含(0 = 结果:整数) {
    1 = 结果;
    0 = i;
    当 (i < size2) {
        (arr2, i)动态数组获取 = val;
        0 = 找到;
        0 = j;
        当 (j < size1) {
            (arr1, j)动态数组获取 = other;
            如果 (other ?= val) { 1 = 找到; }
            j + 1 = j;
        }
        如果 (找到 ?= 0) { 0 = 结果; }
        i + 1 = i;
    }
}

// 数组相等：长度相同且互为子集 → 1；否则 0
函数 (arr1, size1:整数, arr2, size2:整数)数组相等(0 = 结果:整数) {
    如果 (size1 ?= size2) {
        (arr1, size1, arr2, size2)数组包含 = 结果;
        如果 (结果 ?= 1) {
            (arr2, size2, arr1, size1)数组包含 = 结果;
        }
    }
}
