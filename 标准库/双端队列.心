// 日月标准库 - 双端队列（顺序容器，泛型元素）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 底层复用内建动态数组（同 标准库/优先队列.心、栈.心、列表.心 风格），以 <整数> 实例化。
//     内建动态数组为整数元素，故实际以 双端队列<整数> 使用。
//   · 顺序容器（非循环缓冲）：后端操作 O(1)，前端操作 O(n) 搬移。
//   · 采用泛型结构体（而非非泛型）：自举链对非泛型结构体方法体内
//     `(成员数组, i)动态数组获取` 与后续方法共存存在顺序敏感的「未声明的标识符」缺陷，
//     泛型特化路径无此问题（与 优先队列.心/栈.心/列表.心 一致）。
// 创建：双端队列<整数> { 数据: ()创建动态数组, 数量: 0 } = d;
//（数组成员初值须用 `()创建动态数组` 得到真正的 动态数组* 句柄，不可用数组字面量。）

结构体 双端队列<T> {
    数据: T[];
    数量: 整数;

    // 后端入队：尾部追加（O(1)）
    方法 后端入队(值: T) {
        (双端队列.数据, 值)动态数组添加;
        双端队列.数量 + 1 = 双端队列.数量;
    }

    // 前端入队：先尾部追加，再自末位向前逐个后移腾出下标 0，最后置新值（O(n)）
    方法 前端入队(值: T) {
        (双端队列.数据, 值)动态数组添加;
        双端队列.数量 + 1 = 双端队列.数量;
        双端队列.数量 - 1 = i;
        0 = 停;
        当 (停 ?= 0) {
            如果 (i <= 0) {
                1 = 停;
            } 否则 {
                i - 1 = 前;
                (双端队列.数据, 前)动态数组获取 = 前值;
                (双端队列.数据, i, 前值)动态数组设置;
                前 = i;
            }
        }
        (双端队列.数据, 0, 值)动态数组设置;
    }

    // 前端出队：取下标 0 为结果，其后元素逐个前移，再删除末位；空队列行为未定义
    方法 前端出队()(0 = 结果: T) {
        (双端队列.数据, 0)动态数组获取 = 结果;
        双端队列.数量 - 1 = 新数;
        如果 (新数 > 0) {
            0 = i;
            0 = 停;
            当 (停 ?= 0) {
                如果 (i >= 新数) {
                    1 = 停;
                } 否则 {
                    i + 1 = 后;
                    (双端队列.数据, 后)动态数组获取 = 后值;
                    (双端队列.数据, i, 后值)动态数组设置;
                    后 = i;
                }
            }
            新数 = 双端队列.数量;
            (双端队列.数据, 新数)动态数组删除;
        } 否则 {
            (双端队列.数据, 0)动态数组删除;
            0 = 双端队列.数量;
        }
    }

    // 后端出队：取末位为结果并删除末位；空队列行为未定义
    方法 后端出队()(0 = 结果: T) {
        双端队列.数量 - 1 = 新数;
        (双端队列.数据, 新数)动态数组获取 = 结果;
        新数 = 双端队列.数量;
        (双端队列.数据, 新数)动态数组删除;
    }

    // 当前元素个数
    方法 长度()(0 = 结果: 整数) {
        双端队列.数量 = 结果;
    }
}