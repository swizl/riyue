// 日月标准库 - 实用工具

// 条件选择
函数 (条件:整数, 真值:整数, 假值:整数)选择值(0 = 结果:整数) {
    如果 (条件 ?= 1) { 真值 = 结果; } 否则 { 假值 = 结果; }
}

// 范围检查
函数 (值:整数, 最小:整数, 最大:整数)在范围内(0 = 结果:整数) {
    如果 (值 >= 最小 && 值 <= 最大) { 1 = 结果; }
}

// 限制范围
函数 (值:整数, 最小:整数, 最大:整数)限制范围(0 = 结果:整数) {
    如果 (值 < 最小) { 最小 = 结果; }
    如果 (值 > 最大) { 最大 = 结果; }
    值 = 结果;
}

// 序列生成
函数 (开始:整数, 结束:整数, 步长:整数)生成序列(0 = 结果:整数) {
    ()创建动态数组 = arr;
    开始 = 当前;
    当 (当前 < 结束) {
        (arr, 当前)动态数组添加;
        当前 + 步长 = 当前;
    }
    arr = 结果;
}

// 计数满足条件的元素
函数 (arr, 大小:整数, f:函数)计数满足(0 = 结果:整数) {
    0 = 计数;
    0 = i;
    当 (i < 大小) {
        (arr, i)动态数组获取 = 值;
        如果 ((值)f ?= 1) {
            计数 + 1 = 计数;
        }
        i + 1 = i;
    }
    计数 = 结果;
}

// 查找第一个满足条件的元素
函数 (arr, 大小:整数, f:函数)查找满足(-1 = 结果:整数) {
    0 = i;
    当 (i < 大小) {
        (arr, i)动态数组获取 = 值;
        如果 ((值)f ?= 1) {
            值 = 结果;
        }
        i + 1 = i;
    }
}

// 过滤数组
函数 (arr, 大小:整数, f:函数)过滤数组(0 = 结果:整数) {
    ()创建动态数组 = 过滤结果;
    0 = i;
    当 (i < 大小) {
        (arr, i)动态数组获取 = 值;
        如果 ((值)f ?= 1) {
            (过滤结果, 值)动态数组添加;
        }
        i + 1 = i;
    }
    过滤结果 = 结果;
}

// 谓词函数
函数 (x:整数)是偶数(0 = 结果:整数) {
    如果 (x % 2 ?= 0) { 1 = 结果; }
}

函数 (x:整数)是正数(0 = 结果:整数) {
    如果 (x > 0) { 1 = 结果; }
}

函数 (x:整数)是负数(0 = 结果:整数) {
    如果 (x < 0) { 1 = 结果; }
}
