// 日月标准库 - 平衡树（AVL，索引式，泛型元素）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 语言无用户级指针类型（仅 字符串 内部为指针），故采用**索引式**节点（同 二叉搜索树.心）：
//       值: T[]   左: 整数[]   右: 整数[]   高: 整数[]   根: 整数   数量: 整数
//     以**下标**代替指针；`高` 为节点高度（叶为 1，空为 0），插入后回溯更新并做四种旋转
//     （LL 右旋 / RR 左旋 / LR 先左旋后右旋 / RL 先右旋后左旋），维持 |平衡因子| ≤ 1。
//   · 泛型结构体（同 优先队列/双端队列/链表/哈希集合/二叉搜索树）：规避自举链对非泛型结构体
//     方法体内 `(成员数组, i)动态数组获取` 与后续方法共存的顺序敏感缺陷。
//   · **不允许重复键**（插入时检测到等值即忽略）。**无删除**（后续切片）。不用递归方法，
//     全部用 `当` 循环下降 + 路径数组回溯。
//   · 旋转与前缀为 `AVL` 的模块级辅助函数（取值/定高/左旋/右旋）协作；辅助函数以**数组句柄**
//     为无类型标注参数（须置于参数表末尾），就地修改、无返回值 Copy 语义问题。
// 创建：平衡树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组,
//                      高: ()创建动态数组, 根: -1, 数量: 0 } = t;

结构体 平衡树<T> {
    值: T[];
    左: 整数[];
    右: 整数[];
    高: 整数[];
    根: 整数;
    数量: 整数;

    // 插入（不允许重复键；标准 BST 下降 + 路径回溯调平）
    方法 插入(值: T) {
        0 = 父;
        0 = 新根;
        0 = 已转;
        0 = 平衡;
        0 = x;
        0 = lx;
        0 = rx;
        0 = hlx;
        0 = hrx;
        0 = 中;
        0 = y;
        0 = ly;
        0 = ry;
        0 = 高左;
        0 = 高右;
        0 = 子;

        平衡树.根 = 当前;
        如果 (当前 ?= -1) {
            平衡树.数量 = 新下标;
            (平衡树.值, 值)动态数组添加;
            (平衡树.左, -1)动态数组添加;
            (平衡树.右, -1)动态数组添加;
            (平衡树.高, 1)动态数组添加;
            平衡树.数量 + 1 = 平衡树.数量;
            新下标 = 平衡树.根;
        } 否则 {
            0 = 停;
            0 = 重复;
            ()创建动态数组 = 路径;
            平衡树.根 = 当前;
            当 (停 ?= 0) {
                (平衡树.值, 当前)动态数组获取 = 当前值;
                如果 (值 ?= 当前值) {
                    1 = 重复;
                    1 = 停;
                } 否则 {
                    (路径, 当前)动态数组添加;
                    如果 (值 < 当前值) {
                        (平衡树.左, 当前)动态数组获取 = 子;
                    } 否则 {
                        (平衡树.右, 当前)动态数组获取 = 子;
                    }
                    如果 (子 ?= -1) {
                        1 = 停;
                    } 否则 {
                        子 = 当前;
                    }
                }
            }
            如果 (重复 ?= 0) {
                平衡树.数量 = 新下标;
                (平衡树.值, 值)动态数组添加;
                (平衡树.左, -1)动态数组添加;
                (平衡树.右, -1)动态数组添加;
                (平衡树.高, 1)动态数组添加;
                平衡树.数量 + 1 = 平衡树.数量;
                (平衡树.值, 当前)动态数组获取 = 父值;
                如果 (值 < 父值) {
                    (平衡树.左, 当前, 新下标)动态数组设置;
                } 否则 {
                    (平衡树.右, 当前, 新下标)动态数组设置;
                }

                // 自底向上回溯：更新高度、按平衡因子旋转
                (路径)动态数组大小 = 路径长;
                路径长 - 1 = 下标;
                0 = 停调;
                当 (停调 ?= 0) {
                    如果 (下标 < 0) {
                        1 = 停调;
                    } 否则 {
                        (路径, 下标)动态数组获取 = y;
                        (y, 平衡树.左, 平衡树.右, 平衡树.高)AVL定高;
                        (平衡树.左, y)动态数组获取 = ly;
                        (平衡树.右, y)动态数组获取 = ry;
                        (ly, 平衡树.高)AVL取高 = 高左;
                        (ry, 平衡树.高)AVL取高 = 高右;
                        高左 - 高右 = 平衡;
                        -2 = 父;
                        如果 (下标 > 0) {
                            (路径, 下标 - 1)动态数组获取 = 父;
                        }
                        0 = 已转;
                        如果 (平衡 > 1) {
                            (平衡树.左, y)动态数组获取 = x;
                            (平衡树.左, x)动态数组获取 = lx;
                            (平衡树.右, x)动态数组获取 = rx;
                            (lx, 平衡树.高)AVL取高 = hlx;
                            (rx, 平衡树.高)AVL取高 = hrx;
                            如果 (hlx >= hrx) {
                                (y, 父, 平衡树.左, 平衡树.右, 平衡树.高)AVL右旋 = 新根;
                            } 否则 {
                                (x, y, 平衡树.左, 平衡树.右, 平衡树.高)AVL左旋 = 中;
                                (y, 父, 平衡树.左, 平衡树.右, 平衡树.高)AVL右旋 = 新根;
                            }
                            1 = 已转;
                        } 否则如果 (平衡 < -1) {
                            (平衡树.右, y)动态数组获取 = x;
                            (平衡树.右, x)动态数组获取 = rx;
                            (平衡树.左, x)动态数组获取 = lx;
                            (rx, 平衡树.高)AVL取高 = hrx;
                            (lx, 平衡树.高)AVL取高 = hlx;
                            如果 (hrx >= hlx) {
                                (y, 父, 平衡树.左, 平衡树.右, 平衡树.高)AVL左旋 = 新根;
                            } 否则 {
                                (x, y, 平衡树.左, 平衡树.右, 平衡树.高)AVL右旋 = 中;
                                (y, 父, 平衡树.左, 平衡树.右, 平衡树.高)AVL左旋 = 新根;
                            }
                            1 = 已转;
                        }
                        如果 (已转 ?= 1) {
                            如果 (父 ?= -2) {
                                新根 = 平衡树.根;
                            }
                        }
                        下标 - 1 = 下标;
                    }
                }
            }
        }
    }

    // 是否包含（返回 1 / 0）
    方法 包含(值: T)(0 = 结果: 整数) {
        平衡树.根 = 当前;
        0 = 结果;
        0 = 停;
        当 (停 ?= 0) {
            如果 (当前 ?= -1) {
                1 = 停;
            } 否则 {
                (平衡树.值, 当前)动态数组获取 = 当前值;
                如果 (值 ?= 当前值) {
                    1 = 结果;
                    1 = 停;
                } 否则如果 (值 < 当前值) {
                    (平衡树.左, 当前)动态数组获取 = 子;
                    子 = 当前;
                } 否则 {
                    (平衡树.右, 当前)动态数组获取 = 子;
                    子 = 当前;
                }
            }
        }
    }

    // 最小键（最左叶）；空树行为未定义
    方法 最小()(0 = 结果: T) {
        平衡树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            (平衡树.左, 当前)动态数组获取 = 子;
            如果 (子 ?= -1) {
                1 = 停;
            } 否则 {
                子 = 当前;
            }
        }
        (平衡树.值, 当前)动态数组获取 = 结果;
    }

    // 最大键（最右叶）；空树行为未定义
    方法 最大()(0 = 结果: T) {
        平衡树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            (平衡树.右, 当前)动态数组获取 = 子;
            如果 (子 ?= -1) {
                1 = 停;
            } 否则 {
                子 = 当前;
            }
        }
        (平衡树.值, 当前)动态数组获取 = 结果;
    }

    // 树高（根节点高度；空树为 0）
    方法 树高()(0 = 结果: 整数) {
        0 = 结果;
        平衡树.根 = 根下标;
        如果 (根下标 >= 0) {
            (平衡树.高, 根下标)动态数组获取 = 结果;
        }
    }

    // 当前节点个数
    方法 长度()(0 = 结果: 整数) {
        平衡树.数量 = 结果;
    }
}

// 取节点高：下标 -1（空）为 0，否则读 `高`。`高` 为数组句柄（无类型标注，置末）。
函数 (i: 整数, 高)AVL取高(0 = 结果: 整数) {
    0 = 结果;
    如果 (i >= 0) {
        (高, i)动态数组获取 = 结果;
    }
}

// 重算节点 i 的高 = 1 + max(高[左[i]], 高[右[i]])。
函数 (i: 整数, 左, 右, 高)AVL定高(空) {
    (左, i)动态数组获取 = 子左;
    (右, i)动态数组获取 = 子右;
    (子左, 高)AVL取高 = 高左;
    (子右, 高)AVL取高 = 高右;
    0 = 数;
    如果 (高左 >= 高右) {
        高左 + 1 = 数;
    } 否则 {
        高右 + 1 = 数;
    }
    (高, i, 数)动态数组设置;
}

// 右旋：绕 y（其左子 x 上位）；`父` 为 y 的父下标（-2 表 y 为根，由调用方更新根）。
// 返回新子树根 x。
函数 (y: 整数, 父: 整数, 左, 右, 高)AVL右旋(0 = 结果: 整数) {
    (左, y)动态数组获取 = x;
    (右, x)动态数组获取 = 移;
    (左, y, 移)动态数组设置;
    (右, x, y)动态数组设置;
    (y, 左, 右, 高)AVL定高;
    (x, 左, 右, 高)AVL定高;
    如果 (父 >= 0) {
        (左, 父)动态数组获取 = 父左;
        如果 (父左 ?= y) {
            (左, 父, x)动态数组设置;
        } 否则 {
            (右, 父, x)动态数组设置;
        }
    }
    x = 结果;
}

// 左旋：绕 y（其右子 x 上位）；语义同 AVL右旋（镜像）。
函数 (y: 整数, 父: 整数, 左, 右, 高)AVL左旋(0 = 结果: 整数) {
    (右, y)动态数组获取 = x;
    (左, x)动态数组获取 = 移;
    (右, y, 移)动态数组设置;
    (左, x, y)动态数组设置;
    (y, 左, 右, 高)AVL定高;
    (x, 左, 右, 高)AVL定高;
    如果 (父 >= 0) {
        (左, 父)动态数组获取 = 父左;
        如果 (父左 ?= y) {
            (左, 父, x)动态数组设置;
        } 否则 {
            (右, 父, x)动态数组设置;
        }
    }
    x = 结果;
}
