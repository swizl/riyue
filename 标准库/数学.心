// 日月标准库 - 数学工具

函数 (a:整数, b:整数)最大值(0 = 结果:整数) {
    如果 (a > b) { a = 结果; } 否则 { b = 结果; }
}

函数 (a:整数, b:整数)最小值(0 = 结果:整数) {
    如果 (a < b) { a = 结果; } 否则 { b = 结果; }
}

函数 (n:整数)绝对值(0 = 结果:整数) {
    如果 (n < 0) { 0 - n = 结果; } 否则 { n = 结果; }
}

函数 (n:整数)阶乘(1 = 结果:整数) {
    如果 (n > 1) {
        n - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        n * 递归结果 = 结果;
    }
}

函数 (a:整数, b:整数)最大公约数(0 = 结果:整数) {
    如果 (b ?= 0) {
        a = 结果;
    } 否则 {
        (b, a % b)最大公约数 = 结果;
    }
}

函数 (base:整数, exp:整数)幂(1 = 结果:整数) {
    0 = i;
    当 (i < exp) {
        结果 * base = 结果;
        i + 1 = i;
    }
}
