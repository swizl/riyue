// 日月标准库 - 数学工具

函数 (a:整数, b:整数)最大值(0 = 结果:整数) {
    如果 (a > b) { a = 结果; } 否则 { b = 结果; }
}

函数 (a:整数, b:整数)最小值(0 = 结果:整数) {
    如果 (a < b) { a = 结果; } 否则 { b = 结果; }
}

函数 (n:整数)绝对值(0 = 结果:整数) {
    如果 (n < 0) { 0 - n = 结果; } 否则 { n = 结果; }
}

函数 (n:整数)阶乘(1 = 结果:整数) {
    如果 (n > 1) {
        n - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        n * 递归结果 = 结果;
    }
}

函数 (a:整数, b:整数)最大公约数(0 = 结果:整数) {
    如果 (b ?= 0) {
        a = 结果;
    } 否则 {
        (b, a % b)最大公约数 = 结果;
    }
}

函数 (base:整数, exp:整数)幂(1 = 结果:整数) {
    0 = i;
    当 (i < exp) {
        结果 * base = 结果;
        i + 1 = i;
    }
}

// ==================== 8BM：数论扩展（纯 `.心`，双链一致） ====================
//   · 承接既有 最大值/最小值/绝对值/阶乘/最大公约数/幂。
//   · **标量参数必须标注 `:整数`**（未标注的标量形参可能被推断为「指针」，见 8BL 踩坑）。
//   · 赋值目标恒在 `=` 右侧（`积 = 结果;` 即 `结果 := 积`）。

// 最小公倍数（|a|/gcd * |b|，先除后乘以减小溢出；任一为 0 → 0）
函数 (a:整数, b:整数)最小公倍数(0 = 结果:整数) {
    0 = 结果;
    如果 (a ?= 0 || b ?= 0) {
        0 = 结果;
    } 否则 {
        (a)绝对值 = 甲;
        (b)绝对值 = 乙;
        (甲, 乙)最大公约数 = 公约;
        甲 / 公约 * 乙 = 结果;
    }
}

// 模幂（循环累乘取模；mod > 0 时取模，否则退化为普通 幂）；假设 exp >= 0
函数 (base:整数, exp:整数, mod:整数)幂模(1 = 结果:整数) {
    如果 (mod > 0) {
        base % mod = 底;
        0 = i;
        当 (i < exp) {
            结果 * 底 % mod = 结果;
            i + 1 = i;
        }
    } 否则 {
        (base, exp)幂 = 结果;
    }
}

// 是否素数（n < 2 → 0；2 → 1；偶数 → 0；奇数试除到 d*d > n）
函数 (n:整数)是否素数(0 = 结果:整数) {
    0 = 结果;
    如果 (n > 1) {
        如果 (n ?= 2) {
            1 = 结果;
        } 否则如果 (n % 2 ?= 0) {
            0 = 结果;
        } 否则 {
            1 = 结果;
            3 = d;
            当 (d * d <= n) {
                如果 (n % d ?= 0) { 0 = 结果; }
                d + 2 = d;
            }
        }
    }
}

// 素数个数：区间 [2, n] 内素数数量（n < 2 → 0）
函数 (n:整数)素数个数(0 = 结果:整数) {
    0 = 结果;
    2 = k;
    当 (k <= n) {
        (k)是否素数 = 是;
        如果 (是 ?= 1) { 结果 + 1 = 结果; }
        k + 1 = k;
    }
}

// ==================== 8BS：组合数学（整数平方根 / 组合数 / 排列数 / 斐波那契）——纯 `.心`，双链一致 ====================
//   · **标量形参须标注 `:整数`**；**赋值目标恒在 `=` 右侧**；整除 `/` 为正数域下取整。
//   · **`整数` 为 32 位（i32）**——大数相乘易溢出，比较平方时用 `中 <= n / 中` 规避（见 8BS 踩坑）。

// 整数平方根：⌊√n⌋（二分查找；比较用 `中 <= n / 中` 规避 i32 溢出；n < 0 → 0）
函数 (n:整数)整数平方根(0 = 结果:整数) {
    0 = 结果;
    如果 (n > 0) {
        1 = 低;
        n = 高;
        当 (低 <= 高) {
            (低 + 高) / 2 = 中;
            如果 (中 <= n / 中) {
                中 = 结果;
                中 + 1 = 低;
            } 否则 {
                中 - 1 = 高;
            }
        }
    }
}

// 组合数 C(n, k)（0 ≤ k ≤ n，否则 0；逐步乘除保证中间量整除）
函数 (n:整数, k:整数)组合数(0 = 结果:整数) {
    0 = 结果;
    如果 (n >= 0 && k >= 0 && k <= n) {
        1 = 结果;
        1 = i;
        当 (i <= k) {
            结果 * (n - k + i) / i = 结果;
            i + 1 = i;
        }
    }
}

// 排列数 P(n, k)（0 ≤ k ≤ n，否则 0；= n·(n−1)···(n−k+1)）
函数 (n:整数, k:整数)排列数(0 = 结果:整数) {
    0 = 结果;
    如果 (n >= 0 && k >= 0 && k <= n) {
        1 = 结果;
        0 = i;
        当 (i < k) {
            结果 * (n - i) = 结果;
            i + 1 = i;
        }
    }
}

// 斐波那契数列 F(n)（F(0)=0、F(1)=1；n < 0 → 0；迭代 O(n)）
函数 (n:整数)斐波那契(0 = 结果:整数) {
    0 = 结果;
    如果 (n ?= 1) {
        1 = 结果;
    } 否则如果 (n > 1) {
        0 = 前;
        1 = 后;
        1 = i;
        当 (i < n) {
            前 + 后 = 新;
            后 = 前;
            新 = 后;
            i + 1 = i;
        }
        后 = 结果;
    }
}
