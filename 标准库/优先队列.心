// 日月标准库 - 优先队列（最小堆，泛型元素）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 底层复用内建动态数组（同 标准库/栈.心、列表.心 风格），以 <整数> 实例化。
//     内建动态数组为整数元素，故实际以 优先队列<整数> 使用。
//   · 最小堆：堆顶恒为当前最小元素；出队恒弹出最小值。
//   · 采用泛型结构体（而非非泛型）：自举链对非泛型结构体方法体内
//     `(成员数组, i)动态数组获取` 与后续方法共存存在顺序敏感的「未声明的标识符」缺陷，
//     泛型特化路径无此问题（与 栈.心/列表.心 一致）。
// 创建：优先队列<整数> { 数据: ()创建动态数组, 数量: 0 } = q;
//（数组成员初值须用 `()创建动态数组` 得到真正的 动态数组* 句柄，不可用数组字面量。）

结构体 优先队列<T> {
    数据: T[];
    数量: 整数;

    // 入队：尾部追加后上浮至满足堆序
    方法 入队(值: T) {
        (优先队列.数据, 值)动态数组添加;
        优先队列.数量 + 1 = 优先队列.数量;
        优先队列.数量 - 1 = i;
        0 = 停;
        当 (停 ?= 0) {
            如果 (i <= 0) {
                1 = 停;
            } 否则 {
                (i - 1) / 2 = 父;
                (优先队列.数据, i)动态数组获取 = 当前;
                (优先队列.数据, 父)动态数组获取 = 父值;
                如果 (当前 < 父值) {
                    (优先队列.数据, 父, 当前)动态数组设置;
                    (优先队列.数据, i, 父值)动态数组设置;
                    父 = i;
                } 否则 {
                    1 = 停;
                }
            }
        }
    }

    // 出队：弹出并返回最小元素（堆顶）后下沉至满足堆序；空队列行为未定义
    方法 出队()(0 = 结果: T) {
        (优先队列.数据, 0)动态数组获取 = 结果;
        优先队列.数量 - 1 = 新数;
        如果 (新数 > 0) {
            (优先队列.数据, 新数)动态数组获取 = 末值;
            (优先队列.数据, 新数)动态数组删除;
            新数 = 优先队列.数量;
            (优先队列.数据, 0, 末值)动态数组设置;
            0 = i;
            0 = 停;
            当 (停 ?= 0) {
                i * 2 + 1 = 左;
                如果 (左 >= 优先队列.数量) {
                    1 = 停;
                } 否则 {
                    左 = 小;
                    i * 2 + 2 = 右;
                    如果 (右 < 优先队列.数量) {
                        (优先队列.数据, 右)动态数组获取 = 右值;
                        (优先队列.数据, 左)动态数组获取 = 左值;
                        如果 (右值 < 左值) { 右 = 小; }
                    }
                    (优先队列.数据, i)动态数组获取 = 当前;
                    (优先队列.数据, 小)动态数组获取 = 小值;
                    如果 (小值 < 当前) {
                        (优先队列.数据, i, 小值)动态数组设置;
                        (优先队列.数据, 小, 当前)动态数组设置;
                        小 = i;
                    } 否则 {
                        1 = 停;
                    }
                }
            }
        } 否则 {
            (优先队列.数据, 0)动态数组删除;
            0 = 优先队列.数量;
        }
    }

    // 当前元素个数
    方法 长度()(0 = 结果: 整数) {
        优先队列.数量 = 结果;
    }
}