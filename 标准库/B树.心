// 日月标准库 - B 树（索引式，泛型元素，最小度 t）
//
// 阶段：短板补齐计划 §Phase 1.2（数据结构：树——二叉搜索树/AVL/B树）；本模块补 B 树。
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 语言无用户级指针类型（仅 字符串 内部为指针），故采用**索引式**节点（同 二叉搜索树.心 / 平衡树.心）：
//       键: T[]     —— 各节点键的**扁平**存储，节点 n 的键在 [n*K, n*K+K)
//       子: 整数[]  —— 各节点子下标的**扁平**存储，节点 n 的子与键同一步长区
//       键数: 整数[] —— 各节点当前键个数
//       根: 整数    —— 根下标（空树 -1）
//       数量: 整数  —— 全树键总数
//       最小度: 整数 —— B 树最小度 t（插入时写入）
//       高度: 整数  —— 层数（仅根为 1，空树为 0）
//     以**下标**代替指针实现链接与下降。
//   · **步长 K = 2t+1**（而非规范 B 树的 2t-1）：B 树「自底向上」插入会令被插节点
//     临时达到 2t 个键 / 2t+1 个子，故每节点预留 2t+1 槽以容纳该瞬时溢出，随后立即分裂回落。
//     规范上限仍为「键 ≤ 2t-1、子 ≤ 2t」。
//   · 泛型结构体（同 优先队列/双端队列/链表/哈希集合/二叉搜索树/平衡树）：规避自举链对
//     非泛型结构体方法体内 `(成员数组, i)动态数组获取` 与后续方法共存的顺序敏感缺陷。
//   · **不允许重复键**（下降/叶内定位阶段检测到等值即忽略，不改变树）。
//   · **拆分约定**（自底向上、就地、O(树高)）：溢出节点有 2t 个键，取**中位键 = 键[t]** 上推父亲；
//     左半保留 键[0..t-1]（t 个）、右半（新节点）收 键[t+1..2t-1]（t-1 个），子随键同搬；
//     根溢出则新建根，树高 +1。左右两半键数 t / t-1 均落在 [t-1, 2t-1] 的合法区间。
//   · **无删除**（范围限制，同 二叉搜索树.心）；不做递归方法，全部用 `当` 循环。
//   · **中序遍历**：非递归（显式栈 ×2：节点栈 + 位置栈），按「子0,键0,子1,键1,…,子n,键n」升序
//     追加到输出数组；输出为数组句柄（无类型标注参数，置参数表末尾）。
//   · 反向赋值语义：`左 = 右;` 恒为 `右 := 左`。
// 创建：B树<整数> { 键: ()创建动态数组, 子: ()创建动态数组, 键数: ()创建动态数组,
//                   根: -1, 数量: 0, 最小度: 2, 高度: 0 } = t;

// 模块版本
函数 ()B树模块版本(0 = 结果: 整数) {
    1 = 结果;
}

结构体 B树<T> {
    键: T[];
    子: 整数[];
    键数: 整数[];
    根: 整数;
    数量: 整数;
    最小度: 整数;
    高度: 整数;

    // 插入（不允许重复键；自顶向下定位到叶 + 叶内插入 + 自底向上分裂）
    方法 插入(值: T) {
        0 = t;
        0 = K;
        0 = 键上限;
        0 = 根节点;
        0 = 当前;
        0 = 停;
        0 = 停2;
        0 = i;
        0 = 键数cur;
        0 = 子0;
        0 = 子1;
        0 = 重复;
        0 = 是叶;
        0 = 插入位;
        0 = j;
        0 = 尾;
        0 = 路径长;
        0 = 需拆;
        0 = pi;
        0 = 父;
        0 = 父键数;
        0 = 新根;
        0 = z;
        0 = 移子1;
        0 = 移子2;

        B树.最小度 = t;
        2 * t + 1 = K;
        2 * t - 1 = 键上限;

        B树.根 = 根节点;
        如果 (根节点 ?= -1) {
            // 空树：以 值 为初值新建根，写入唯一键
            0 = j;
            当 (j < K) {
                (B树.键, 值)动态数组添加;
                j + 1 = j;
            }
            0 = j;
            当 (j < K) {
                (B树.子, -1)动态数组添加;
                j + 1 = j;
            }
            (B树.键数)动态数组大小 = 新根;
            (B树.键数, 0)动态数组添加;
            (B树.键, 新根 * K + 0, 值)动态数组设置;
            (B树.键数, 新根, 1)动态数组设置;
            新根 = B树.根;
            1 = B树.数量;
            1 = B树.高度;
        } 否则 {
            // ---- 自顶向下定位到叶 ----
            ()创建动态数组 = 路径;
            ()创建动态数组 = 位路;
            根节点 = 当前;
            0 = 重复;
            0 = 是叶;
            0 = 停;
            当 (停 ?= 0) {
                (B树.键数, 当前)动态数组获取 = 键数cur;
                0 = i;
                0 = 停2;
                当 (停2 ?= 0) {
                    如果 (i >= 键数cur) {
                        1 = 停2;
                    } 否则 {
                        (B树.键, 当前 * K + i)动态数组获取 = 键i;
                        如果 (键i < 值) {
                            i + 1 = i;
                        } 否则 {
                            如果 (键i ?= 值) {
                                1 = 重复;
                            }
                            1 = 停2;
                        }
                    }
                }
                如果 (重复 ?= 1) {
                    1 = 停;
                } 否则 {
                    (B树.子, 当前 * K + 0)动态数组获取 = 子0;
                    如果 (子0 ?= -1) {
                        1 = 停;
                        1 = 是叶;
                        i = 插入位;
                    } 否则 {
                        (路径, 当前)动态数组添加;
                        (位路, i)动态数组添加;
                        (B树.子, 当前 * K + i)动态数组获取 = 当前;
                    }
                }
            }
            // ---- 叶内插入（右移腾位）----
            如果 (重复 ?= 0) {
                (B树.键数, 当前)动态数组获取 = 键数cur;
                键数cur = 尾;
                当 (尾 > 插入位) {
                    (B树.键, 当前 * K + 尾 - 1)动态数组获取 = 移键1;
                    (B树.键, 当前 * K + 尾, 移键1)动态数组设置;
                    尾 - 1 = 尾;
                }
                (B树.键, 当前 * K + 插入位, 值)动态数组设置;
                (B树.键数, 当前, 键数cur + 1)动态数组设置;
                B树.数量 + 1 = B树.数量;
                // ---- 自底向上分裂 ----
                (B树.键数, 当前)动态数组获取 = 键数cur;
                0 = 需拆;
                如果 (键数cur > 键上限) {
                    1 = 需拆;
                }
                当 (需拆 ?= 1) {
                    // 当前节点溢出：键数 = 2t，中位键 = 键[t]
                    (B树.键, 当前 * K + t)动态数组获取 = 中值;
                    // 新建右半节点 z，先以中值为填充初值
                    0 = j;
                    当 (j < K) {
                        (B树.键, 中值)动态数组添加;
                        j + 1 = j;
                    }
                    0 = j;
                    当 (j < K) {
                        (B树.子, -1)动态数组添加;
                        j + 1 = j;
                    }
                    (B树.键数)动态数组大小 = z;
                    (B树.键数, 0)动态数组添加;
                    // 搬键：cur[t+1..2t-1] → z[0..t-2]
                    0 = j;
                    当 (j < t - 1) {
                        (B树.键, 当前 * K + t + 1 + j)动态数组获取 = 移键2;
                        (B树.键, z * K + j, 移键2)动态数组设置;
                        j + 1 = j;
                    }
                    // 搬子（若非叶）：cur[t+1..2t] → z[0..t-1]
                    (B树.子, 当前 * K + 0)动态数组获取 = 子0;
                    如果 (子0 ?= -1) {
                        0 = 子1;
                    } 否则 {
                        0 = j;
                        当 (j <= t - 1) {
                            (B树.子, 当前 * K + t + 1 + j)动态数组获取 = 移子1;
                            (B树.子, z * K + j, 移子1)动态数组设置;
                            j + 1 = j;
                        }
                        1 = 子1;
                    }
                    (B树.键数, z, t - 1)动态数组设置;
                    (B树.键数, 当前, t)动态数组设置;
                    // ---- 中值上推 ----
                    (路径)动态数组大小 = 路径长;
                    如果 (路径长 ?= 0) {
                        // 当前为根：新建根
                        0 = j;
                        当 (j < K) {
                            (B树.键, 中值)动态数组添加;
                            j + 1 = j;
                        }
                        0 = j;
                        当 (j < K) {
                            (B树.子, -1)动态数组添加;
                            j + 1 = j;
                        }
                        (B树.键数)动态数组大小 = 新根;
                        (B树.键数, 0)动态数组添加;
                        (B树.键, 新根 * K + 0, 中值)动态数组设置;
                        (B树.键数, 新根, 1)动态数组设置;
                        (B树.子, 新根 * K + 0, 当前)动态数组设置;
                        (B树.子, 新根 * K + 1, z)动态数组设置;
                        新根 = B树.根;
                        B树.高度 + 1 = B树.高度;
                        0 = 需拆;
                    } 否则 {
                        (路径, 路径长 - 1)动态数组获取 = 父;
                        (位路, 路径长 - 1)动态数组获取 = pi;
                        (路径, 路径长 - 1)动态数组删除;
                        (位路, 路径长 - 1)动态数组删除;
                        (B树.键数, 父)动态数组获取 = 父键数;
                        // 父的子右移：父[pi+1..父键数] → 父[pi+2..]
                        父键数 = 尾;
                        当 (尾 >= pi + 1) {
                            (B树.子, 父 * K + 尾)动态数组获取 = 移子2;
                            (B树.子, 父 * K + 尾 + 1, 移子2)动态数组设置;
                            尾 - 1 = 尾;
                        }
                        (B树.子, 父 * K + pi + 1, z)动态数组设置;
                        // 父的键右移：父[pi..父键数-1] → 父[pi+1..]
                        父键数 - 1 = 尾;
                        当 (尾 >= pi) {
                            (B树.键, 父 * K + 尾)动态数组获取 = 移键3;
                            (B树.键, 父 * K + 尾 + 1, 移键3)动态数组设置;
                            尾 - 1 = 尾;
                        }
                        (B树.键, 父 * K + pi, 中值)动态数组设置;
                        (B树.键数, 父, 父键数 + 1)动态数组设置;
                        // 继续向上
                        父 = 当前;
                        父键数 + 1 = 键数cur;
                        如果 (键数cur > 键上限) {
                            1 = 需拆;
                        } 否则 {
                            0 = 需拆;
                        }
                    }
                }
            }
        }
    }

    // 是否包含（返回 1 / 0）
    方法 包含(值: T)(0 = 结果: 整数) {
        0 = t;
        0 = K;
        0 = 当前;
        0 = 停;
        0 = 停2;
        0 = i;
        0 = 键数cur;
        0 = 子0;
        0 = 命中;

        B树.最小度 = t;
        2 * t + 1 = K;
        0 = 结果;
        0 = 命中;
        B树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            如果 (当前 ?= -1) {
                1 = 停;
            } 否则 {
                (B树.键数, 当前)动态数组获取 = 键数cur;
                0 = i;
                0 = 停2;
                当 (停2 ?= 0) {
                    如果 (i >= 键数cur) {
                        1 = 停2;
                    } 否则 {
                        (B树.键, 当前 * K + i)动态数组获取 = 键i;
                        如果 (键i < 值) {
                            i + 1 = i;
                        } 否则 {
                            如果 (键i ?= 值) {
                                1 = 命中;
                            }
                            1 = 停2;
                        }
                    }
                }
                如果 (命中 ?= 1) {
                    1 = 结果;
                    1 = 停;
                } 否则 {
                    (B树.子, 当前 * K + i)动态数组获取 = 子0;
                    子0 = 当前;
                }
            }
        }
    }

    // 中序遍历到 `输出`（升序；数组句柄参数置末）
    方法 中序遍历(输出) {
        0 = K;
        0 = 当前;
        0 = 停;
        0 = 键数cur;
        0 = 双界;
        0 = 位;
        0 = 余;
        0 = 子位;
        0 = 键位;
        0 = 子0;
        0 = 栈长;

        ()创建动态数组 = 栈节点;
        ()创建动态数组 = 栈位;
        2 * B树.最小度 + 1 = K;
        0 = 停;
        B树.根 = 当前;
        如果 (当前 >= 0) {
            (栈节点, 当前)动态数组添加;
            (栈位, 0)动态数组添加;
        }
        当 (停 ?= 0) {
            (栈节点)动态数组大小 = 栈长;
            如果 (栈长 ?= 0) {
                1 = 停;
            } 否则 {
                (栈节点, 栈长 - 1)动态数组获取 = 当前;
                (栈位, 栈长 - 1)动态数组获取 = 位;
                (B树.键数, 当前)动态数组获取 = 键数cur;
                2 * 键数cur = 双界;
                如果 (位 > 双界) {
                    (栈节点, 栈长 - 1)动态数组删除;
                    (栈位, 栈长 - 1)动态数组删除;
                } 否则 {
                    位 % 2 = 余;
                    如果 (余 ?= 0) {
                        位 / 2 = 子位;
                        (B树.子, 当前 * K + 子位)动态数组获取 = 子0;
                        如果 (子0 ?= -1) {
                            (栈位, 栈长 - 1, 位 + 1)动态数组设置;
                        } 否则 {
                            (栈位, 栈长 - 1, 位 + 1)动态数组设置;
                            (栈节点, 子0)动态数组添加;
                            (栈位, 0)动态数组添加;
                        }
                    } 否则 {
                        (位 - 1) / 2 = 键位;
                        (B树.键, 当前 * K + 键位)动态数组获取 = 键值;
                        (输出, 键值)动态数组添加;
                        (栈位, 栈长 - 1, 位 + 1)动态数组设置;
                    }
                }
            }
        }
    }

    // 最小键（沿 子[0] 下降至叶后取首键）；空树行为未定义
    方法 最小()(0 = 结果: T) {
        0 = K;
        0 = 当前;
        0 = 停;
        0 = 子0;

        2 * B树.最小度 + 1 = K;
        B树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            (B树.子, 当前 * K + 0)动态数组获取 = 子0;
            如果 (子0 ?= -1) {
                1 = 停;
            } 否则 {
                子0 = 当前;
            }
        }
        (B树.键, 当前 * K + 0)动态数组获取 = 结果;
    }

    // 最大键（沿最右子下降至叶后取末键）；空树行为未定义
    方法 最大()(0 = 结果: T) {
        0 = K;
        0 = 当前;
        0 = 停;
        0 = 子0;
        0 = 键数cur;

        2 * B树.最小度 + 1 = K;
        B树.根 = 当前;
        0 = 停;
        当 (停 ?= 0) {
            (B树.键数, 当前)动态数组获取 = 键数cur;
            (B树.子, 当前 * K + 键数cur)动态数组获取 = 子0;
            如果 (子0 ?= -1) {
                1 = 停;
            } 否则 {
                子0 = 当前;
            }
        }
        (B树.键数, 当前)动态数组获取 = 键数cur;
        (B树.键, 当前 * K + 键数cur - 1)动态数组获取 = 结果;
    }

    // 键总数
    方法 长度()(0 = 结果: 整数) {
        B树.数量 = 结果;
    }

    // 层数（仅根为 1；空树为 0）
    方法 树高()(0 = 结果: 整数) {
        B树.高度 = 结果;
    }
}
