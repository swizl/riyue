// 日月标准库 - 列表容器（泛型结构体，阶段4C2）
// 说明：底层复用内建动态数组（整数元素，与 数组.心/集合.心 同），故以 <整数> 实例化。
// 创建：列表<整数> { 数据: ()创建动态数组, 数量: 0 } = l;
// 成员初值须用 `()创建动态数组`（真正的 动态数组* 句柄），不可用数组字面量
//（数组字面量写的是裸 C 数组指针，与内建动态数组表示不同）。

结构体 列表<T> {
    数据: T[];
    数量: 整数;
    方法 添加(值: T) {
        (列表.数据, 值)动态数组添加;
        列表.数量 + 1 = 列表.数量;
    }
    方法 获取(索引: 整数)(0 = 结果: T) {
        (列表.数据, 索引)动态数组获取 = 结果;
    }
    方法 长度()(0 = 结果: 整数) {
        列表.数量 = 结果;
    }
}