// 排序算法库
//
// 说明：动态数组句柄可作为函数参数传递（句柄参数**不加类型标注**，见 标准库/集合.心、标准库/数组.心）。
// 本模块提供整数数组的**原地升序排序**与**二分查找**，纯 `.心` 手写，双链（引导.exe / 日月.exe）一致。
// 赋值目标恒在 `=` 右侧（`当前值 = 最小;` 即 `最小 := 当前值`；`j = 最小位;` 即 `最小位 := j`）。
// 仅用两链皆已支持的内建（动态数组获取/设置、整除 `/`）。

// 冒泡排序（原地升序）
函数 (arr, size)数组冒泡排序 {
    0 = i;
    当 (i < size) {
        0 = j;
        当 (j + 1 < size - i) {
            (arr, j)动态数组获取 = 左值;
            (arr, j + 1)动态数组获取 = 右值;
            如果 (左值 > 右值) {
                (arr, j, 右值)动态数组设置;
                (arr, j + 1, 左值)动态数组设置;
            }
            j + 1 = j;
        }
        i + 1 = i;
    }
}

// 选择排序（原地升序）
函数 (arr, size)数组选择排序 {
    0 = i;
    当 (i + 1 < size) {
        i = 最小位;
        i + 1 = j;
        当 (j < size) {
            (arr, j)动态数组获取 = 当前值;
            (arr, 最小位)动态数组获取 = 最小;
            如果 (当前值 < 最小) { j = 最小位; }
            j + 1 = j;
        }
        (arr, i)动态数组获取 = 首值;
        (arr, 最小位)动态数组获取 = 小值;
        (arr, i, 小值)动态数组设置;
        (arr, 最小位, 首值)动态数组设置;
        i + 1 = i;
    }
}

// 插入排序（原地升序）
函数 (arr, size)数组插入排序 {
    1 = i;
    当 (i < size) {
        (arr, i)动态数组获取 = 键;
        i - 1 = j;
        1 = 找;
        当 (找 ?= 1 && j >= 0) {
            (arr, j)动态数组获取 = 值;
            如果 (值 > 键) {
                (arr, j + 1, 值)动态数组设置;
                j - 1 = j;
            } 否则 {
                0 = 找;
            }
        }
        (arr, j + 1, 键)动态数组设置;
        i + 1 = i;
    }
}

// 二分查找（要求 arr 已升序）；找到 → 下标（0 起），未找到 → -1
函数 (arr, size, 目标)数组二分查找(0 = 结果:整数) {
    -1 = 结果;
    0 = 低;
    size - 1 = 高;
    1 = 找;
    当 (找 ?= 1 && 低 <= 高) {
        (低 + 高) / 2 = 中;
        (arr, 中)动态数组获取 = 中值;
        如果 (中值 ?= 目标) {
            中 = 结果;
            0 = 找;
        } 否则如果 (中值 < 目标) {
            中 + 1 = 低;
        } 否则 {
            高 - 1 = 高;
        }
    }
}
