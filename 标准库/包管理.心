// 日月标准库 - 包管理
//
// 阶段：短板补齐计划 §Phase 2「包管理器完善」
//   §2.1 核心功能：包清单（注册表元数据）/ 语义化版本（复用 版本.心）/ 依赖解析（版本冲突检测）
//                 / 包锁定文件（含内容校验和）/ 安装-搜索-锁定-列表 子命令分派
//   §2.2 包结构：包清单即 `包信息.心`（`键 = 值` 行文本）
//   §2.3 命令行：`包命令(命令, 参数, 清单, 注册表)` 分派 安装/搜索/锁定/列表
//
// 纯 `.心` 切片（不改编译器 / 文法 / 自举源 ⇒ 不动点恒定）。
//
// 数据约定：
//   · 注册表 = 动态字符串数组句柄，元素形如 `名称@版本`（如 `数学@1.2.0`）
//   · 依赖项 = `名称` 或 `名称 约束`（约束语法见 版本.心：= > >= < <= ^ ~ 与 x/* 通配、逗号区间 AND）
//   · 包清单 = `键 = 值` 行；支持 名称/版本/描述/作者/依赖（依赖以逗号分隔）
//   · 锁文件 = 每行 `名称@版本 md5=<32 位小写十六进制>`，按依赖声明顺序、LF 分隔；
//     包内容为空 → 校验和写 `-`（不对空串求摘要）
//
// 限制：`包解析依赖`/`包解析依赖表` 只做单层解析（每个依赖独立取最高满足版本）；
//       传递依赖闭包与同名多约束求解放 `包闭包解析`（模块版本 3）；不做跨包 DFS
//       全量回溯、不回收因版本下调而失效的旧依赖；校验和走 摘要.心 的 MD5（仅
//       ASCII 文本）；不访问网络，注册表与元数据表由调用方给出。

导入 "字符串.心";
导入 "版本.心";
导入 "摘要.心";

// 模块版本：2 = 增加「文件系统闭环」：清单文件读取 / 本地路径依赖 / 缓存目录安装 / 锁文件落盘 / 导入解析
//           3 = 增加「传递依赖闭包与冲突检测」：元数据表 / 闭包解析 / 闭包锁文件
函数 ()包管理模块版本(0 = 结果:整数) {
    3 = 结果;
}

// 去掉两侧空白与成对双引号（清单取值用；无引号时原样返回净文本）
函数 (文本:字符串)包去引号("" = 结果:字符串) {
    0 = 起;
    0 = 末;
    0 = 码;
    0 = 长;
    1 = 停;
    (文本)长度 = 长;
    0 = 起;
    长 = 末;
    当 (停 ?= 1) {
        如果 (起 < 末) {
            (文本, 起)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                起 + 1 = 起;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    1 = 停;
    当 (停 ?= 1) {
        如果 (末 > 起) {
            (文本, 末 - 1)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                末 - 1 = 末;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    如果 (末 - 起 >= 2) {
        (文本, 起)字符码 = 码;
        如果 (码 ?= 34) {
            (文本, 末 - 1)字符码 = 码;
            如果 (码 ?= 34) {
                起 + 1 = 起;
                末 - 1 = 末;
            }
        }
    }
    (文本, 起, 末 - 起)字符串截取 = 结果;
}

// 从清单文本取键值（`键 = 值` 行；值两侧空白与成对双引号去除）；无该键 → ""
函数 (清单:文本, 键:字符串)包清单取值("" = 结果:字符串) {
    0 = 总长;
    0 = 码;
    0 = 在键;
    0 = 有等号;
    0 = 收尾;
    0 = 比;
    0 = i;
    "" = 键缓冲;
    "" = 值缓冲;
    "" = 单字;
    (清单)长度 = 总长;
    1 = 在键;
    0 = 有等号;
    0 = 收尾;
    0 = i;
    当 (i <= 总长) {
        10 = 码;
        如果 (i < 总长) {
            (清单, i)字符码 = 码;
        }
        如果 (码 ?= 10) {
            如果 (有等号 ?= 1 && 收尾 ?= 0) {
                (键缓冲, 键)字符串比较 = 比;
                如果 (比 ?= 0) {
                    (值缓冲)包去引号 = 结果;
                    1 = 收尾;
                }
            }
            "" = 键缓冲;
            "" = 值缓冲;
            1 = 在键;
            0 = 有等号;
        } 否则如果 (码 ?= 61 && 在键 ?= 1) {
            0 = 在键;
            1 = 有等号;
        } 否则 {
            如果 (码 != 13) {
                (码)字符 = 单字;
                如果 (在键 ?= 1) {
                    如果 (码 != 32 && 码 != 9) {
                        (键缓冲, 单字)拼接 = 键缓冲;
                    }
                } 否则如果 (有等号 ?= 1) {
                    (码)字符 = 单字;
                    (值缓冲, 单字)拼接 = 值缓冲;
                }
            }
        }
        i + 1 = i;
    }
}

// 清单的依赖项列表：按逗号切分、逐项去空白，压紧写入 依赖表（句柄），返回有效项数
函数 (清单:文本, 依赖表)包清单依赖(0 = 数量:整数) {
