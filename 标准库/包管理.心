    当 (i < 数量) {
        (注册表, i)动态字符串数组获取 = 条目;
        (条目)包条目名称 = 名;
        (名, 名称)字符串比较 = 比;
        如果 (比 ?= 0) {
            (条目)包条目版本 = 版;
            (输出, 版)动态字符串数组添加;
        }
        i + 1 = i;
    }
    输出 = 结果;
}

// 依赖项 → 注册表条目下标（选满足约束的最高版本；无满足者 → -1，即版本冲突）
函数 (依赖项:字符串, 注册表)包解析依赖(-1 = 结果:整数) {
    0 = 候选数;
    0 = 索;
    0 = 数量;
    0 = i;
    0 = 比名;
    0 = 比版;
    "" = 名;
    "" = 约;
    "" = 条目;
    "" = 条名;
    "" = 条版;
    "" = 选版;
    -1 = 结果;
    (依赖项)包依赖拆分 = (名, 约);
    如果 (约 ?= "") {
        "*" = 约;
    }
    (名, 注册表)包注册表候选 = 候选;
    (候选)动态字符串数组大小 = 候选数;
    如果 (候选数 > 0) {
        (约, 候选)选最高满足版本 = 索;
        如果 (索 >= 0) {
            (候选, 索)动态字符串数组获取 = 选版;
            (注册表)动态字符串数组大小 = 数量;
            0 = i;
            当 (i < 数量) {
                (注册表, i)动态字符串数组获取 = 条目;
                (条目)包条目名称 = 条名;
                (条目)包条目版本 = 条版;
                (条名, 名)字符串比较 = 比名;
                (条版, 选版)字符串比较 = 比版;
                如果 (比名 ?= 0 && 比版 ?= 0 && 结果 < 0) {
                    i = 结果;
                }
                i + 1 = i;
            }
        }
    }
}

