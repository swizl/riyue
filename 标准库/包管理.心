    0 = 段数;
    0 = i;
    "" = 原值;
    "" = 段;
    "" = 净;
    (清单, "依赖")包清单取值 = 原值;
    (原值, ",", 依赖表)字符串分割到 = 段数;
    0 = i;
    当 (i < 段数) {
        (依赖表, i)动态字符串数组获取 = 段;
        (段)去除首尾空白 = 净;
        如果 (净 != "") {
            (依赖表, 数量, 净)动态字符串数组设置;
            数量 + 1 = 数量;
        }
        i + 1 = i;
    }
}

// 依赖项拆成 (名称, 约束)：首个空白前为名称，其后去空白为约束（无约束 → ""）
函数 (依赖项:字符串)包依赖拆分("" = 名称:字符串, "" = 约束:字符串) {
    0 = 长;
    0 = 码;
    1 = 在名;
    0 = i;
    "" = 名;
    "" = 约;
    "" = 单字;
    (依赖项)长度 = 长;
    1 = 在名;
    0 = i;
    当 (i < 长) {
        (依赖项, i)字符码 = 码;
        如果 (在名 ?= 1) {
            如果 (码 ?= 32 || 码 ?= 9) {
                0 = 在名;
            } 否则 {
                (码)字符 = 单字;
                (名, 单字)拼接 = 名;
            }
        } 否则 {
            如果 (码 != 32 && 码 != 9) {
                (码)字符 = 单字;
                (约, 单字)拼接 = 约;
            }
        }
        i + 1 = i;
    }
    名 = 名称;
    约 = 约束;
}

// 注册表条目 `名称@版本` 的名称部分
函数 (条目:字符串)包条目名称("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    0 = 位置;
    0 = i;
    (条目)长度 = 长;
    -1 = 位置;
    0 = i;
    当 (i < 长) {
        (条目, i)字符码 = 码;
        如果 (码 ?= 64 && 位置 < 0) {
            i = 位置;
        }
        i + 1 = i;
    }
    如果 (位置 < 0) {
        条目 = 结果;
    } 否则 {
        (条目, 0, 位置)字符串截取 = 结果;
    }
}

// 注册表条目 `名称@版本` 的版本部分（无 `@` → ""）
函数 (条目:字符串)包条目版本("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    0 = 位置;
    0 = i;
    (条目)长度 = 长;
    -1 = 位置;
    0 = i;
    当 (i < 长) {
        (条目, i)字符码 = 码;
        如果 (码 ?= 64 && 位置 < 0) {
            i = 位置;
        }
        i + 1 = i;
    }
    如果 (位置 >= 0) {
        (条目, 位置 + 1, 长 - 位置 - 1)字符串截取 = 结果;
    }
}

// 注册表中指定名称的全部版本（新动态字符串数组句柄）
函数 (名称:字符串, 注册表)包注册表候选(0 = 结果:指针) {
