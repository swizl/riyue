// 锁文件校验：找 `名称@…` 行并比对其 md5 与 内容 的摘要
//   1 = 匹配；0 = 不匹配；-1 = 锁文件中无该名称
函数 (锁文本:字符串, 名称:字符串, 内容:字符串)包锁校验(0 = 结果:整数) {
    0 = 已定;
    0 = 段数;
    0 = 比;
    0 = 命中;
    0 = i;
    "" = 换行;
    "" = 行;
    "" = 净;
    "" = 行名;
    "" = 和;
    -1 = 结果;
    0 = 已定;
    ()创建动态字符串数组 = 段表;
    (10)字符 = 换行;
    (锁文本, 换行, 段表)字符串分割到 = 段数;
    0 = i;
    当 (i < 段数) {
        (段表, i)动态字符串数组获取 = 行;
        (行)去除首尾空白 = 净;
        如果 (净 != "" && 已定 ?= 0) {
            (净)包条目名称 = 行名;
            (行名, 名称)字符串比较 = 比;
            如果 (比 ?= 0) {
                1 = 已定;
                (内容)MD5 = 和;
                (净, 和)字符串含子串 = 命中;
                如果 (命中 ?= 1) {
                    1 = 结果;
                } 否则 {
                    0 = 结果;
                }
            }
        }
        i + 1 = i;
    }
}

