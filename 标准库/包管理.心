// 日月标准库 - 包管理
//
// 阶段：短板补齐计划 §Phase 2「包管理器完善」
//   §2.1 核心功能：包清单（注册表元数据）/ 语义化版本（复用 版本.心）/ 依赖解析（版本冲突检测）
//                 / 包锁定文件（含内容校验和）/ 安装-搜索-锁定-列表 子命令分派
//   §2.2 包结构：包清单即 `包信息.心`（`键 = 值` 行文本）
//   §2.3 命令行：`包命令(命令, 参数, 清单, 注册表)` 分派 安装/搜索/锁定/列表
//
// 纯 `.心` 切片（不改编译器 / 文法 / 自举源 ⇒ 不动点恒定）。
//
// 数据约定：
//   · 注册表 = 动态字符串数组句柄，元素形如 `名称@版本`（如 `数学@1.2.0`）
//   · 依赖项 = `名称` 或 `名称 约束`（约束语法见 版本.心：= > >= < <= ^ ~ 与 x/* 通配、逗号区间 AND）
//   · 包清单 = `键 = 值` 行；支持 名称/版本/描述/作者/依赖（依赖以逗号分隔）
//   · 锁文件 = 每行 `名称@版本 md5=<32 位小写十六进制>`，按依赖声明顺序、LF 分隔；
//     包内容为空 → 校验和写 `-`（不对空串求摘要）
//
// 限制：不做多包传递闭包 / 冲突回溯求解（见 编译器差距补齐计划.md）；「冲突」仅指
//       「注册表内无满足约束的版本」；校验和走 摘要.心 的 MD5（仅 ASCII 文本）；
//       不访问网络，注册表由调用方给出。

导入 "字符串.心";
导入 "版本.心";
导入 "摘要.心";

// 模块版本：1 = 清单 + 依赖解析 + 锁文件 + 子命令分派
函数 ()包管理模块版本(0 = 结果:整数) {
    1 = 结果;
}

// 去掉两侧空白与成对双引号（清单取值用；无引号时原样返回净文本）
函数 (文本:字符串)包去引号("" = 结果:字符串) {
    0 = 起;
    0 = 末;
    0 = 码;
    0 = 长;
    1 = 停;
    (文本)长度 = 长;
    0 = 起;
    长 = 末;
    当 (停 ?= 1) {
        如果 (起 < 末) {
            (文本, 起)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                起 + 1 = 起;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    1 = 停;
    当 (停 ?= 1) {
        如果 (末 > 起) {
            (文本, 末 - 1)字符码 = 码;
            如果 (码 ?= 32 || 码 ?= 9) {
                末 - 1 = 末;
            } 否则 {
                0 = 停;
            }
        } 否则 {
            0 = 停;
        }
    }
    如果 (末 - 起 >= 2) {
        (文本, 起)字符码 = 码;
        如果 (码 ?= 34) {
            (文本, 末 - 1)字符码 = 码;
            如果 (码 ?= 34) {
                起 + 1 = 起;
                末 - 1 = 末;
            }
        }
    }
    (文本, 起, 末 - 起)字符串截取 = 结果;
}

// 从清单文本取键值（`键 = 值` 行；值两侧空白与成对双引号去除）；无该键 → ""
函数 (清单:文本, 键:字符串)包清单取值("" = 结果:字符串) {
    0 = 总长;
    0 = 码;
    0 = 在键;
    0 = 有等号;
    0 = 收尾;
    0 = 比;
    0 = i;
    "" = 键缓冲;
    "" = 值缓冲;
    "" = 单字;
    (清单)长度 = 总长;
    1 = 在键;
    0 = 有等号;
    0 = 收尾;
    0 = i;
    当 (i <= 总长) {
        10 = 码;
        如果 (i < 总长) {
            (清单, i)字符码 = 码;
        }
        如果 (码 ?= 10) {
            如果 (有等号 ?= 1 && 收尾 ?= 0) {
                (键缓冲, 键)字符串比较 = 比;
                如果 (比 ?= 0) {
                    (值缓冲)包去引号 = 结果;
                    1 = 收尾;
                }
            }
            "" = 键缓冲;
            "" = 值缓冲;
            1 = 在键;
            0 = 有等号;
        } 否则如果 (码 ?= 61 && 在键 ?= 1) {
            0 = 在键;
            1 = 有等号;
        } 否则 {
            如果 (码 != 13) {
                (码)字符 = 单字;
                如果 (在键 ?= 1) {
                    如果 (码 != 32 && 码 != 9) {
                        (键缓冲, 单字)拼接 = 键缓冲;
                    }
                } 否则如果 (有等号 ?= 1) {
                    (码)字符 = 单字;
                    (值缓冲, 单字)拼接 = 值缓冲;
                }
            }
        }
        i + 1 = i;
    }
}

// 清单的依赖项列表：按逗号切分、逐项去空白，压紧写入 依赖表（句柄），返回有效项数
函数 (清单:文本, 依赖表)包清单依赖(0 = 数量:整数) {
    0 = 数量;
    0 = 段数;
    0 = i;
    "" = 原值;
    "" = 段;
    "" = 净;
    (清单, "依赖")包清单取值 = 原值;
    (原值, ",", 依赖表)字符串分割到 = 段数;
    0 = i;
    当 (i < 段数) {
        (依赖表, i)动态字符串数组获取 = 段;
        (段)去除首尾空白 = 净;
        如果 (净 != "") {
            (依赖表, 数量, 净)动态字符串数组设置;
            数量 + 1 = 数量;
        }
        i + 1 = i;
    }
}

// 依赖项拆成 (名称, 约束)：首个空白前为名称，其后去空白为约束（无约束 → ""）
函数 (依赖项:字符串)包依赖拆分("" = 名称:字符串, "" = 约束:字符串) {
    0 = 长;
    0 = 码;
    1 = 在名;
    0 = i;
    "" = 名;
    "" = 约;
    "" = 单字;
    (依赖项)长度 = 长;
    1 = 在名;
    0 = i;
    当 (i < 长) {
        (依赖项, i)字符码 = 码;
        如果 (在名 ?= 1) {
            如果 (码 ?= 32 || 码 ?= 9) {
                0 = 在名;
            } 否则 {
                (码)字符 = 单字;
                (名, 单字)拼接 = 名;
            }
        } 否则 {
            如果 (码 != 32 && 码 != 9) {
                (码)字符 = 单字;
                (约, 单字)拼接 = 约;
            }
        }
        i + 1 = i;
    }
    名 = 名称;
    约 = 约束;
}

// 注册表条目 `名称@版本` 的名称部分
函数 (条目:字符串)包条目名称("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    0 = 位置;
    0 = i;
    (条目)长度 = 长;
    -1 = 位置;
    0 = i;
    当 (i < 长) {
        (条目, i)字符码 = 码;
        如果 (码 ?= 64 && 位置 < 0) {
            i = 位置;
        }
        i + 1 = i;
    }
    如果 (位置 < 0) {
        条目 = 结果;
    } 否则 {
        (条目, 0, 位置)字符串截取 = 结果;
    }
}

// 注册表条目 `名称@版本` 的版本部分（无 `@` → ""）
函数 (条目:字符串)包条目版本("" = 结果:字符串) {
    0 = 长;
    0 = 码;
    0 = 位置;
    0 = i;
    (条目)长度 = 长;
    -1 = 位置;
    0 = i;
    当 (i < 长) {
        (条目, i)字符码 = 码;
        如果 (码 ?= 64 && 位置 < 0) {
            i = 位置;
        }
        i + 1 = i;
    }
    如果 (位置 >= 0) {
        (条目, 位置 + 1, 长 - 位置 - 1)字符串截取 = 结果;
    }
}

// 注册表中指定名称的全部版本（新动态字符串数组句柄）
函数 (名称:字符串, 注册表)包注册表候选(0 = 结果:指针) {
    0 = 数量;
    0 = i;
    0 = 比;
    "" = 条目;
    "" = 名;
    "" = 版;
    ()创建动态字符串数组 = 输出;
    (注册表)动态字符串数组大小 = 数量;
    0 = i;
    当 (i < 数量) {
        (注册表, i)动态字符串数组获取 = 条目;
        (条目)包条目名称 = 名;
        (名, 名称)字符串比较 = 比;
        如果 (比 ?= 0) {
            (条目)包条目版本 = 版;
            (输出, 版)动态字符串数组添加;
        }
        i + 1 = i;
    }
    输出 = 结果;
}

// 依赖项 → 注册表条目下标（选满足约束的最高版本；无满足者 → -1，即版本冲突）
函数 (依赖项:字符串, 注册表)包解析依赖(-1 = 结果:整数) {
    0 = 候选数;
    0 = 索;
    0 = 数量;
    0 = i;
    0 = 比名;
    0 = 比版;
    "" = 名;
    "" = 约;
    "" = 条目;
    "" = 条名;
    "" = 条版;
    "" = 选版;
    -1 = 结果;
    (依赖项)包依赖拆分 = (名, 约);
    如果 (约 ?= "") {
        "*" = 约;
    }
    (名, 注册表)包注册表候选 = 候选;
    (候选)动态字符串数组大小 = 候选数;
    如果 (候选数 > 0) {
        (约, 候选)选最高满足版本 = 索;
        如果 (索 >= 0) {
            (候选, 索)动态字符串数组获取 = 选版;
            (注册表)动态字符串数组大小 = 数量;
            0 = i;
            当 (i < 数量) {
                (注册表, i)动态字符串数组获取 = 条目;
                (条目)包条目名称 = 条名;
                (条目)包条目版本 = 条版;
                (条名, 名)字符串比较 = 比名;
                (条版, 选版)字符串比较 = 比版;
                如果 (比名 ?= 0 && 比版 ?= 0 && 结果 < 0) {
                    i = 结果;
                }
                i + 1 = i;
            }
        }
    }
}

// 依赖项表整体解析：选中下标写入新整数数组（未解析项写 -1），冲突计数另行归返
函数 (依赖项表, 注册表)包解析依赖表(0 = 结果:指针, 0 = 冲突:整数) {
    0 = 数量;
    0 = 位;
    0 = i;
    "" = 项;
    ()创建动态数组 = 输出;
    0 = 冲突;
    (依赖项表)动态字符串数组大小 = 数量;
    0 = i;
    当 (i < 数量) {
        (依赖项表, i)动态字符串数组获取 = 项;
        (项, 注册表)包解析依赖 = 位;
        如果 (位 < 0) {
            冲突 + 1 = 冲突;
            (输出, -1)动态数组添加;
        } 否则 {
            (输出, 位)动态数组添加;
        }
        i + 1 = i;
    }
    输出 = 结果;
}

// 生成锁文件文本：选中表（注册表下标）与 内容表（包内容，用于校验和）按下标平行
函数 (注册表, 选中表, 内容表)包锁文件生成("" = 结果:字符串) {
    0 = 数;
    0 = 容数;
    0 = 位;
    0 = i;
    "" = 输出;
    "" = 单字;
    "" = 条目;
    "" = 内容;
    "" = 和;
    (选中表)动态数组大小 = 数;
    (内容表)动态字符串数组大小 = 容数;
    0 = i;
    当 (i < 数) {
        (选中表, i)动态数组获取 = 位;
        如果 (位 >= 0) {
            (注册表, 位)动态字符串数组获取 = 条目;
            "" = 内容;
            如果 (i < 容数) {
                (内容表, i)动态字符串数组获取 = 内容;
            }
            "-" = 和;
            如果 (内容 != "") {
                (内容)MD5 = 和;
            }
            (输出, 条目)拼接 = 输出;
            (输出, " md5=")拼接 = 输出;
            (输出, 和)拼接 = 输出;
            (10)字符 = 单字;
            (输出, 单字)拼接 = 输出;
        }
        i + 1 = i;
    }
    输出 = 结果;
}

// 锁文件校验：找 `名称@…` 行并比对其 md5 与 内容 的摘要
//   1 = 匹配；0 = 不匹配；-1 = 锁文件中无该名称
函数 (锁文本:字符串, 名称:字符串, 内容:字符串)包锁校验(0 = 结果:整数) {
    0 = 已定;
    0 = 段数;
    0 = 比;
    0 = 命中;
    0 = i;
    "" = 换行;
    "" = 行;
    "" = 净;
    "" = 行名;
    "" = 和;
    -1 = 结果;
    0 = 已定;
    ()创建动态字符串数组 = 段表;
    (10)字符 = 换行;
    (锁文本, 换行, 段表)字符串分割到 = 段数;
    0 = i;
    当 (i < 段数) {
        (段表, i)动态字符串数组获取 = 行;
        (行)去除首尾空白 = 净;
        如果 (净 != "" && 已定 ?= 0) {
            (净)包条目名称 = 行名;
            (行名, 名称)字符串比较 = 比;
            如果 (比 ?= 0) {
                1 = 已定;
                (内容)MD5 = 和;
                (净, 和)字符串含子串 = 命中;
                如果 (命中 ?= 1) {
                    1 = 结果;
                } 否则 {
                    0 = 结果;
                }
            }
        }
        i + 1 = i;
    }
}

// 注册表中指定名称的最高版本（按 `*` 约束取最高）；无该名称 → ""
