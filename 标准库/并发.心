// 日月标准库 - 并发（协作式单线程：通道 + 协程 的运行期封装）
// 8CF：纯 `.心`，双链一致。
//   · 通道句柄 / 协程句柄均为不透明句柄，形参不加类型标注（与数组句柄同规则）；
//   · 发送非阻塞（容量内）；接收按 FIFO 取值（见 示例/通道测试.心 语义）。

// 向通道顺序发送 个数 个整数：首值, 首值+1, ...
函数 (通道, 个数:整数, 首值:整数)通道填充(空) {
    0 = i;
    当 (i < 个数) {
        (通道, 首值 + i)发送;
        i + 1 = i;
    }
}

// 从通道接收 个数 个整数并求和
函数 (通道, 个数:整数)通道收集和(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < 个数) {
        (通道)接收 = 值;
        结果 + 值 = 结果;
        i + 1 = i;
    }
}

// 从通道接收 个数 个整数，逐槽写入 输出 动态数组（槽位须已预置）
函数 (通道, 个数:整数, 输出)通道收集到(空) {
    0 = i;
    当 (i < 个数) {
        (通道)接收 = 值;
        (输出, i, 值)动态数组设置;
        i + 1 = i;
    }
}

// 把 源 通道的 个数 个整数转发到 目标 通道
函数 (源, 目标, 个数:整数)通道转发(空) {
    0 = i;
    当 (i < 个数) {
        (源)接收 = 值;
        (目标, 值)发送;
        i + 1 = i;
    }
}

// 恢复协程 次数 次，返回最后一次的让出 / 返回值（结束归返 0）
函数 (句柄, 次数:整数)协程驱动(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < 次数) {
        (句柄)恢复 = 结果;
        i + 1 = i;
    }
}

// 恢复协程 次数 次，逐步写入 输出 动态数组（槽位须已预置）
函数 (句柄, 次数:整数, 输出)协程收集到(空) {
    0 = i;
    当 (i < 次数) {
        (句柄)恢复 = 值;
        (输出, i, 值)动态数组设置;
        i + 1 = i;
    }
}

// 向通道顺序发送 个数 个整数（倒序）：末值, 末值-1, ...（8CL）
函数 (通道, 个数:整数, 末值:整数)通道填充倒序(空) {
    0 = i;
    当 (i < 个数) {
        (通道, 末值 - i)发送;
        i + 1 = i;
    }
}

// 从通道接收 个数 个整数，统计其中 > 0 的个数（8CL）
函数 (通道, 个数:整数)通道计数正(0 = 结果:整数) {
    0 = 结果;
    0 = i;
    当 (i < 个数) {
        (通道)接收 = 值;
        如果 (值 > 0) { 结果 + 1 = 结果; }
        i + 1 = i;
    }
}

// 从通道接收 个数 个整数累加求和，并把和发送到 目标 通道（8CL）
函数 (通道, 个数:整数, 目标)通道累加到(空) {
    0 = 累计;
    0 = i;
    当 (i < 个数) {
        (通道)接收 = 值;
        累计 + 值 = 累计;
        i + 1 = i;
    }
    (目标, 累计)发送;
}

// 从通道接收 个数 个整数，倒序逐槽写入 输出（槽位须已预置）（8CP）
函数 (通道, 个数:整数, 输出)通道收集到倒序(空) {
    0 = i;
    当 (i < 个数) {
        (通道)接收 = 值;
        (输出, 个数 - 1 - i, 值)动态数组设置;
        i + 1 = i;
    }
}

// 从 初值 起，接收 个数 个整数累加（8CP）
函数 (通道, 个数:整数, 初值:整数)通道折叠(0 = 结果:整数) {
    初值 = 结果;
    0 = i;
    当 (i < 个数) {
        (通道)接收 = 值;
        结果 + 值 = 结果;
        i + 1 = i;
    }
}

// 从通道接收 个数 个整数取最大值（个数为 0 → 0）（8CP）
函数 (通道, 个数:整数)通道最大值(0 = 结果:整数) {
    0 = 结果;
    如果 (个数 > 0) {
        (通道)接收 = 首;
        首 = 结果;
        1 = i;
        当 (i < 个数) {
            (通道)接收 = 值;
            如果 (值 > 结果) { 值 = 结果; }
            i + 1 = i;
        }
    }
}

// 把 源 通道中 > 0 的整数转发到 目标，非正数丢弃（8CP）
函数 (源, 个数:整数, 目标)通道过滤正到(空) {
    0 = i;
    当 (i < 个数) {
        (源)接收 = 值;
        如果 (值 > 0) { (目标, 值)发送; }
        i + 1 = i;
    }
}
