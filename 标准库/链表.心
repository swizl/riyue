// 日月标准库 - 链表（索引式单向链表，泛型元素）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 语言无用户级指针类型（仅 字符串 内部为指针），故采用**索引式**实现：
//     节点存于并行动态数组，用**下标**代替指针链接：
//       数据: T[]   —— 各节点的值
//       下一: 整数[] —— 各节点的后继下标（-1 表示链尾）
//       头: 整数    —— 首节点下标（空表为 -1）
//       数量: 整数  —— 节点个数
//   · 泛型结构体（同 优先级队列.心/双端队列.心）：规避自举链对非泛型结构体
//     方法体内 `(成员数组, i)动态数组获取` 与后续方法共存的顺序敏感缺陷。
// 创建：链表<整数> { 数据: ()创建动态数组, 下一: ()创建动态数组, 头: -1, 数量: 0 } = l;

结构体 链表<T> {
    数据: T[];
    下一: 整数[];
    头: 整数;
    数量: 整数;

    // 尾部插入：新节点置于数组末位，遍历至链尾后链接（O(n)）
    方法 尾部插入(值: T) {
        链表.数量 = 新下标;
        (链表.数据, 值)动态数组添加;
        (链表.下一, -1)动态数组添加;
        如果 (链表.数量 ?= 0) {
            新下标 = 链表.头;
        } 否则 {
            链表.头 = 当前;
            0 = 停;
            当 (停 ?= 0) {
                (链表.下一, 当前)动态数组获取 = 下一个;
                如果 (下一个 ?= -1) {
                    1 = 停;
                } 否则 {
                    下一个 = 当前;
                }
            }
            (链表.下一, 当前, 新下标)动态数组设置;
        }
        链表.数量 + 1 = 链表.数量;
    }

    // 头部插入：新节点后继指向旧头，再改头（O(1)）
    方法 头部插入(值: T) {
        链表.数量 = 新下标;
        链表.头 = 旧头;
        (链表.数据, 值)动态数组添加;
        (链表.下一, 旧头)动态数组添加;
        新下标 = 链表.头;
        链表.数量 + 1 = 链表.数量;
    }

    // 取第 i 个元素（0 基）；自头沿后继走 i 步；i 越界行为未定义
    方法 获取(i: 整数)(0 = 结果: T) {
        链表.头 = 当前;
        0 = 计;
        0 = 停;
        当 (停 ?= 0) {
            如果 (计 >= i) {
                1 = 停;
            } 否则 {
                (链表.下一, 当前)动态数组获取 = 下一个;
                下一个 = 当前;
                计 + 1 = 计;
            }
        }
        (链表.数据, 当前)动态数组获取 = 结果;
    }

    // 当前节点个数
    方法 长度()(0 = 结果: 整数) {
        链表.数量 = 结果;
    }
}