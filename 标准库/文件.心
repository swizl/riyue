// 日月标准库 - 文件工具
// 封装已有的文件运行时函数

函数 (路径:字符串)文件是否存在(0 = 结果:整数) {
    (路径)文件存在 = 结果;
}

函数 (路径:字符串)目录是否存在(0 = 结果:整数) {
    (路径)目录存在 = 结果;
}

函数 (路径:字符串)创建新目录(0 = 结果:整数) {
    (路径)创建目录 = 结果;
}

函数 (路径:字符串)删除文件操作(0 = 结果:整数) {
    (路径)删除文件 = 结果;
}

函数 (路径:字符串)删除目录操作(0 = 结果:整数) {
    (路径)删除目录 = 结果;
}

函数 (路径1:字符串, 路径2:字符串)连接路径操作("" = 结果:字符串) {
    (路径1, 路径2)连接路径 = 结果;
}

函数 ()获取当前工作目录("" = 结果:字符串) {
    ()获取当前目录 = 结果;
}
