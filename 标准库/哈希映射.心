// 日月标准库 - 哈希映射（开放寻址 + 线性探测，整数键 / 泛型值）
//
// 说明：
//   · 纯 .心，无编译器改动；双链（宿主 引导.exe / 自举 日月.exe）行为一致。
//   · 泛型结构体（同 哈希集合.心/优先队列.心）：规避自举链对非泛型结构体
//     方法体内 `(成员数组, i)动态数组获取` 与后续方法共存的顺序敏感缺陷。
//   · 结构：键 存于 键: 整数[]，值 存于 值: T[]，占用: 整数[]（1 已用 / 0 空）标记槽位。
//   · **容量在 初始化(容) 时固定，不自动扩容**：调用方须预留 > 元素数 的容量，
//     否则满载时探测结束、写入被丢弃（不报错）。
//   · 键须为**非负整数**（哈希位置 = 键 % 容量；负键取模为负，未定义）。
//   · **不支持删除**（无墓碑；删除会断链，后续探测失真）。
//   · 同键再次 设置 为覆盖语义（值更新），数量不变。
//   · 遍历为「槽序」（哈希槽从 0 到 容量-1 的顺序），对同一组插入确定但不保证有序。
// 创建：哈希映射<整数> { 键: ()创建动态数组, 值: ()创建动态数组, 占用: ()创建动态数组,
//                        容量: 0, 数量: 0, 槽位: 0, 当前: 0 } = m;
//       m.初始化(16);

结构体 哈希映射<T> {
    键: 整数[];
    值: T[];
    占用: 整数[];
    容量: 整数;
    数量: 整数;
    槽位: 整数;
    当前: 整数;

    // 预置 容 个空槽（占用全 0），并复位遍历游标
    方法 初始化(容: 整数) {
        容 = 哈希映射.容量;
        0 = i;
        0 = 停;
        当 (停 ?= 0) {
            如果 (i >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.键, 0)动态数组添加;
                (哈希映射.值, 0)动态数组添加;
                (哈希映射.占用, 0)动态数组添加;
                i + 1 = i;
            }
        }
        0 = 哈希映射.数量;
        0 = 哈希映射.槽位;
        0 - 1 = 哈希映射.当前;
    }

    // 写入（同键覆盖，新键插入；满载时静默丢弃）
    方法 设置(目标键: 整数, 目标值: T) {
        目标键 % 哈希映射.容量 = 位置;
        0 = 计;
        0 = 停;
        当 (停 ?= 0) {
            如果 (计 >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, 位置)动态数组获取 = 占;
                如果 (占 ?= 0) {
                    (哈希映射.键, 位置, 目标键)动态数组设置;
                    (哈希映射.值, 位置, 目标值)动态数组设置;
                    (哈希映射.占用, 位置, 1)动态数组设置;
                    哈希映射.数量 + 1 = 哈希映射.数量;
                    1 = 停;
                } 否则 {
                    (哈希映射.键, 位置)动态数组获取 = 旧键;
                    如果 (旧键 ?= 目标键) {
                        (哈希映射.值, 位置, 目标值)动态数组设置;
                        1 = 停;
                    } 否则 {
                        位置 + 1 = 位置;
                        如果 (位置 >= 哈希映射.容量) {
                            0 = 位置;
                        }
                        计 + 1 = 计;
                    }
                }
            }
        }
    }

    // 取键对应的值（不存在归返 0）
    方法 获取(目标键: 整数)(0 = 结果: T) {
        目标键 % 哈希映射.容量 = 位置;
        0 = 计;
        0 = 停;
        当 (停 ?= 0) {
            如果 (计 >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, 位置)动态数组获取 = 占;
                如果 (占 ?= 0) {
                    1 = 停;
                } 否则 {
                    (哈希映射.键, 位置)动态数组获取 = 旧键;
                    如果 (旧键 ?= 目标键) {
                        (哈希映射.值, 位置)动态数组获取 = 结果;
                        1 = 停;
                    } 否则 {
                        位置 + 1 = 位置;
                        如果 (位置 >= 哈希映射.容量) {
                            0 = 位置;
                        }
                        计 + 1 = 计;
                    }
                }
            }
        }
    }

    // 是否包含键（返回 1 / 0）
    方法 包含(目标键: 整数)(0 = 结果: 整数) {
        目标键 % 哈希映射.容量 = 位置;
        0 = 计;
        0 = 停;
        当 (停 ?= 0) {
            如果 (计 >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, 位置)动态数组获取 = 占;
                如果 (占 ?= 0) {
                    1 = 停;
                } 否则 {
                    (哈希映射.键, 位置)动态数组获取 = 旧键;
                    如果 (旧键 ?= 目标键) {
                        1 = 结果;
                        1 = 停;
                    } 否则 {
                        位置 + 1 = 位置;
                        如果 (位置 >= 哈希映射.容量) {
                            0 = 位置;
                        }
                        计 + 1 = 计;
                    }
                }
            }
        }
    }

    // 当前键值对个数
    方法 长度()(0 = 结果: 整数) {
        哈希映射.数量 = 结果;
    }

    // 键数组（槽序；可直接交给 迭代器.心 的适配器链）
    方法 键数组()(0 = 结果: 指针) {
        ()创建动态数组 = 新;
        0 = i;
        0 = 停;
        当 (停 ?= 0) {
            如果 (i >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, i)动态数组获取 = 占;
                如果 (占 ?= 1) {
                    (哈希映射.键, i)动态数组获取 = 键值;
                    (新, 键值)动态数组添加;
                }
                i + 1 = i;
            }
        }
        新 = 结果;
    }

    // 值数组（槽序，与 键数组 一一对应）
    方法 值数组()(0 = 结果: 指针) {
        ()创建动态数组 = 新;
        0 = i;
        0 = 停;
        当 (停 ?= 0) {
            如果 (i >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, i)动态数组获取 = 占;
                如果 (占 ?= 1) {
                    (哈希映射.值, i)动态数组获取 = 当前值;
                    (新, 当前值)动态数组添加;
                }
                i + 1 = i;
            }
        }
        新 = 结果;
    }

    // ==================== 惰性遍历（槽序游标） ====================
    // 游标状态保存在结构体自身（槽位 / 当前），故同一时刻只支持一条遍历；
    // 典型用法：
    //     m.重置游标();
    //     1 = 未完;
    //     当 (未完 ?= 1) {
    //         m.有下一个() = 有;
    //         如果 (有 ?= 1) { m.下一个键() = 键; m.下一个值() = 值; }
    //         否则 { 0 = 未完; }
    //     }
    // 语义：`下一个键` 跳过空槽并前移，`下一个值` 读同一槽的值（须紧随 `下一个键`）；
    //       耗尽后 `下一个键` 归返 0 且 `有下一个` 为 0。

    // 回到起点
    方法 重置游标() {
        0 = 哈希映射.槽位;
        0 - 1 = 哈希映射.当前;
    }

    // 还有键值对吗？
    方法 有下一个()(0 = 结果: 整数) {
        哈希映射.槽位 = 位;
        0 = 停;
        当 (停 ?= 0) {
            如果 (位 >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, 位)动态数组获取 = 占;
                如果 (占 ?= 1) {
                    1 = 结果;
                    1 = 停;
                } 否则 {
                    位 + 1 = 位;
                }
            }
        }
    }

    // 下一个键（跳过空槽并前移；耗尽归返 0）
    方法 下一个键()(0 = 结果: 整数) {
        0 - 1 = 哈希映射.当前;
        哈希映射.槽位 = 位;
        0 = 停;
        当 (停 ?= 0) {
            如果 (位 >= 哈希映射.容量) {
                哈希映射.容量 = 哈希映射.槽位;
                1 = 停;
            } 否则 {
                (哈希映射.占用, 位)动态数组获取 = 占;
                如果 (占 ?= 1) {
                    (哈希映射.键, 位)动态数组获取 = 结果;
                    位 = 哈希映射.当前;
                    位 + 1 = 哈希映射.槽位;
                    1 = 停;
                } 否则 {
                    位 + 1 = 位;
                    位 = 哈希映射.槽位;
                }
            }
        }
    }

    // 当前键对应的值（须在一次 下一个键 之后调用；无当前槽归返 0）
    方法 下一个值()(0 = 结果: T) {
        哈希映射.当前 = 位;
        如果 (位 >= 0) {
            (哈希映射.值, 位)动态数组获取 = 结果;
        }
    }

    // 尚未遍历的键值对个数
    方法 剩余()(0 = 结果: 整数) {
        0 = 结果;
        哈希映射.槽位 = 位;
        0 = 停;
        当 (停 ?= 0) {
            如果 (位 >= 哈希映射.容量) {
                1 = 停;
            } 否则 {
                (哈希映射.占用, 位)动态数组获取 = 占;
                如果 (占 ?= 1) {
                    结果 + 1 = 结果;
                }
                位 + 1 = 位;
            }
        }
    }
}
