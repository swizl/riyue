// GF(2^8) 乘法（模 x^8+x^4+x^3+x+1，即 0x11b）：a×n
函数 (a: 整数, n: 整数)AES伽罗瓦乘(0 = 结果: 整数) {
    (a & 255) = 被乘;
    n = 乘数;
    0 = 累;
    当 (乘数 > 0) {
        如果 ((乘数 & 1) ?= 1) {
            (累 ^ 被乘) = 累;
        }
        (被乘 <| 1) = 被乘;
        如果 ((被乘 & 256) ?= 256) {
            ((被乘 & 255) ^ 27) = 被乘;
        }
        乘数 >| 1 = 乘数;
    }
    累 = 结果;
}

