    0 = o;
    当 (o + 16 <= 总) {
        ()创建动态数组 = 块;
        0 = i;
        当 (i < 16) {
            (明文, o + i)动态数组获取 = b;
            (链, i)动态数组获取 = cb;
            (块, (b ^ cb))动态数组添加;
            i + 1 = i;
        }
        ()创建动态数组 = 密块;
        (轮密钥, 块, 轮数, 密块)AES加密块通用;
        0 = i;
        当 (i < 16) {
