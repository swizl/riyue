// 密钥扩展：16 字节密钥 → 176 字节轮密钥（追加到 输出）
函数 (密钥, 输出)AES密钥扩展(0 = 状态: 整数) {
    [1,2,4,8,16,32,64,128,27,54] = RC;
    0 = i;
    当 (i < 16) {
        (密钥, i)动态数组获取 = kb;
        (输出, kb)动态数组添加;
        i + 1 = i;
    }
    4 = 词序;
    当 (词序 < 44) {
        (输出, (词序 - 1) * 4)动态数组获取 = t0;
        (输出, (词序 - 1) * 4 + 1)动态数组获取 = t1;
        (输出, (词序 - 1) * 4 + 2)动态数组获取 = t2;
        (输出, (词序 - 1) * 4 + 3)动态数组获取 = t3;
        如果 (词序 % 4 ?= 0) {
            (t1)AES的S盒 = r0;
            (t2)AES的S盒 = r1;
            (t3)AES的S盒 = r2;
            (t0)AES的S盒 = r3;
            (r0 ^ RC[词序 / 4 - 1]) = t0;
            r1 = t1;
            r2 = t2;
            r3 = t3;
        }
        (输出, (词序 - 4) * 4)动态数组获取 = p0;
        (输出, (词序 - 4) * 4 + 1)动态数组获取 = p1;
        (输出, (词序 - 4) * 4 + 2)动态数组获取 = p2;
        (输出, (词序 - 4) * 4 + 3)动态数组获取 = p3;
        (输出, (p0 ^ t0))动态数组添加;
        (输出, (p1 ^ t1))动态数组添加;
        (输出, (p2 ^ t2))动态数组添加;
        (输出, (p3 ^ t3))动态数组添加;
        词序 + 1 = 词序;
    }
    0 = 状态;
}

// 通用密钥扩展：密钥 16/24/32 字节 → 轮密钥（追加到 输出），返回轮数 Nr（10/12/14）
// 依据 FIPS-197 §5.2：Nk = 密钥字节数/4，Nr = Nk + 6，共 4*(Nr+1) 个词。
函数 (密钥, 输出)AES密钥扩展通用(0 = 轮数: 整数) {
    (密钥)动态数组大小 = 密钥长度;
    密钥长度 / 4 = Nk;
    (Nk + 6) = Nr;
    (4 * (Nr + 1)) = 总词;
    0 = i;
    当 (i < 密钥长度) {
        (密钥, i)动态数组获取 = kb;
        (输出, kb)动态数组添加;
        i + 1 = i;
    }
    1 = RC;
    Nk = 词序;
    当 (词序 < 总词) {
        (输出, (词序 - 1) * 4)动态数组获取 = t0;
        (输出, (词序 - 1) * 4 + 1)动态数组获取 = t1;
        (输出, (词序 - 1) * 4 + 2)动态数组获取 = t2;
        (输出, (词序 - 1) * 4 + 3)动态数组获取 = t3;
        如果 (词序 % Nk ?= 0) {
            t1 = 暂0;
            t2 = 暂1;
            t3 = 暂2;
            t0 = 暂3;
            (暂0)AES的S盒 = 新0;
            (暂1)AES的S盒 = 新1;
            (暂2)AES的S盒 = 新2;
            (暂3)AES的S盒 = 新3;
            (新0 ^ RC) = t0;
            新1 = t1;
            新2 = t2;
            新3 = t3;
            // 轮常量递推：RC = xtime(RC)
            (RC, 2)AES伽罗瓦乘 = RC;
        } 否则如果 (Nk > 6) {
            如果 (词序 % Nk ?= 4) {
                t0 = 暂0;
                t1 = 暂1;
                t2 = 暂2;
                t3 = 暂3;
                (暂0)AES的S盒 = t0;
                (暂1)AES的S盒 = t1;
                (暂2)AES的S盒 = t2;
                (暂3)AES的S盒 = t3;
            }
        }
        (输出, (词序 - Nk) * 4)动态数组获取 = p0;
        (输出, (词序 - Nk) * 4 + 1)动态数组获取 = p1;
        (输出, (词序 - Nk) * 4 + 2)动态数组获取 = p2;
        (输出, (词序 - Nk) * 4 + 3)动态数组获取 = p3;
        (输出, (p0 ^ t0))动态数组添加;
        (输出, (p1 ^ t1))动态数组添加;
        (输出, (p2 ^ t2))动态数组添加;
        (输出, (p3 ^ t3))动态数组添加;
        词序 + 1 = 词序;
    }
    Nr = 轮数;
}

