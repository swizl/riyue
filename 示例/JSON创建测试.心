// JSON 创建 测试：整数 / 字符串 / 浮点 / 布尔（双链一致）
//
// 说明：导入 标准库/JSON.心（封装运行时 `JSON创建*` / `JSON获取*`）。
//   本片补齐宿主链 引导.exe 的 `JSON创建浮点`/`JSON创建布尔`（此前仅自举链实现，
//   引导.exe 无法编译 标准库/JSON.心），关闭 8O 记录的宿主链/自举链行为分歧。

导入 "标准库/JSON.心";

函数 主程序 {
    ("=== JSON 创建 测试 ===")打印;

    ("-- 整数")打印;
    ("k", 42)创建JSON整数 = 整;
    (整)打印;
    (整, "k")获取JSON整数 = 读整;
    (读整)打印;

    ("-- 字符串")打印;
    ("s", "abc")创建JSON字符串 = 文;
    (文)打印;
    (文, "s")获取JSON字符串 = 读文;
    (读文)打印;

    ("-- 浮点")打印;
    ("f", 3.5)创建JSON浮点 = 浮;
    (浮)打印;
    (浮, "f")获取JSON浮点 = 读浮;
    (读浮)打印;

    ("-- 布尔（真）")打印;
    ("b", 1)创建JSON布尔 = 布真;
    (布真)打印;
    (布真, "b")获取JSON布尔 = 读布真;
    (读布真)打印;

    ("-- 布尔（假）")打印;
    ("b", 0)创建JSON布尔 = 布假;
    (布假)打印;
    (布假, "b")获取JSON布尔 = 读布假;
    (读布假)打印;

    ("=== 测试完成 ===")打印;
}
