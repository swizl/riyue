// 新语法全面测试

函数 (甲:整数, 乙:整数)加法(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 (数量:整数)阶乘(0 = 结果:整数) {
    如果 (数量 <= 1) {
        1 = 结果;
    } 否则 {
        数量 - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        数量 * 递归结果 = 结果;
    }
}

函数 (数量:整数)判断奇偶(空) {
    如果 (数量 % 2 ?= 0) {
        ("偶数")打印;
    } 否则 {
        ("奇数")打印;
    }
}

函数 (数量:整数)循环测试(0 = 结果:整数) {
    0 = 索引;
    当 (索引 < 数量) {
        结果 + 索引 = 结果;
        索引 + 1 = 索引;
    }
}

函数 主程序 {
    ("=== 新语法全面测试 ===")打印;

    ("--- 基本函数 ---")打印;
    (3, 4)加法 = r1;
    (r1)打印;

    ("--- 管道操作 ---")打印;
    (3, 4)加法|打印;

    (10)阶乘 = r3;
    (r3)打印;

    ("--- 控制流 ---")打印;
    (7)判断奇偶;
    (4)判断奇偶;

    (100)循环测试 = r4;
    (r4)打印;

    ("--- 常量 ---")打印;
    3 = 常量 PI;
    (PI)打印;

    ("--- 数组 ---")打印;
    [10, 20, 30] = arr;
    (arr[0])打印;
    (arr[2])打印;

    ("--- 字符串 ---")打印;
    "Hello" = 甲;
    " World" = 乙;
    甲 + 乙 = 字符;
    (字符)打印;
    (字符)长度 = len;
    (len)打印;

    ("=== 测试完成 ===")打印;
}
