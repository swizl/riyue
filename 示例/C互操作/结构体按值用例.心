// 阶段10 续52/续53/续54：结构体按值传参与按值返回（链接期直调，验证 C 聚合 ABI）。
// 依赖：run_tests.sh 自测「结构体按值」先用 clang 把 示例/C互操作/工具.c 编成
//       _cstruct.o，再用 --附加对象=./_cstruct.o 与日月产物一并链接；
//       符号在链接期解析（不再运行期 LoadLibrary/dlopen）。
// 按值返回：C 侧 `演示点` 经 RAX 返回，日月包装函数把整数返回值写回新分配的结构体实例；
// 此处再把该实例直接按值传给 C，验证「返回 → 再传参」两段聚合 ABI 都成立。
// 续54：>16 字节的 `演示大点` 由 C 侧经隐藏指针（sret）写入日月新分配的实例，
//       再用 _cinterop.dll 的按指针求和函数读回六个字段（运行期 dlopen 路径）。
// 注意：结构体须先于外部函数声明定义，否则声明收集期无法把它识别为结构体返回值。
结构体 点 {
    横: 整数;
    纵: 整数;
}

结构体 大点 {
    横: 整数;
    纵: 整数;
    甲: 整数;
    乙: 整数;
    丙: 整数;
    丁: 整数;
}

外部 函数 "./_cstruct.o" "riyue_point_weight" 点权重(点: 点)(结果: 整数);
外部 函数 "./_cstruct.o" "riyue_point_make" 造点(横: 整数, 纵: 整数)(点: 点);
外部 函数 "./_cstruct.o" "riyue_big_make" 造大点(横: 整数, 纵: 整数, 基: 整数)(点: 大点);
外部 函数 "./_cinterop.dll" "riyue_big_sum" 大点求和(点: 指针)(结果: 整数);

函数 主程序 {
    ("=== 结构体按值测试 ===")打印;
    点 { 横: 3, 纵: 7 } = 坐标;
    (坐标)点权重 = 权重;
    (权重)打印;
    ((4, 9)造点)点权重 = 权重2;
    (权重2)打印;
    ((1, 2, 100)造大点)大点求和 = 大点和;
    (大点和)打印;
    // 续55：结构体按值返回的结果可直接做成员访问（不再需要整体再传参）。
    ((4, 9)造点).横 = 横值;
    (横值)打印;
    ((1, 2, 100)造大点).丁 = 丁值;
    (丁值)打印;
    ("=== 测试完成 ===")打印;
}
