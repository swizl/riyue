// AI 生态测试：标准库汇总登记 / 包管理器登记 / AI 助手入口 / VS Code 插件静态校验
// 纯 .心（只读文件 + 断言 ⇒ 不改编译器 / 自举源，不动点恒定）

导入 "../标准库/测试框架.心";

函数 (路径:字符串)读("" = 结果:字符串) {
    (路径)读取文件 = 结果;
}

函数 主程序 {
    "" = 文;
    ("=== AI 生态测试 ===")打印;

    // 1) 标准库汇总：所有.心 已登记 AI.心
    ("标准库/所有.心")读 = 文;
    (文, "导入 \"AI.心\";", "所有.心 已导入 AI.心")断言包含;
    (文, "AI 原语", "所有.心 注释列出 AI 原语")断言包含;

    // 2) 包管理器登记 AI 相关包
    ("工具/包管理器.心")读 = 文;
    (文, "AI@1.0.0", "注册表登记 AI@1.0.0")断言包含;
    (文, "MCP@0.1.0", "注册表登记 MCP@0.1.0")断言包含;

    // 3) 标准库包管理器列出 AI 包
    ("工具/标准库包管理器.心")读 = 文;
    (文, "\"AI.心\" = 模块15;", "标准库包清单登记 AI.心")断言包含;
    (文, "AI         - AI 原语", "可用包列表含 AI 说明")断言包含;

    // 4) AI 助手入口（编辑器命令 → 标准库/AI.心）
    ("工具/AI助手.心")读 = 文;
    (文, "AI助手提示模式", "AI 助手：提示模式")断言包含;
    (文, "AI助手联网模式", "AI 助手：联网模式")断言包含;
    (文, "构建/AI助手.exe", "AI 助手：构建用法")断言包含;

    // 5) VS Code 插件：清单 / 语言配置 / 语法 / 片段 / 客户端
    ("工具/vscode-riyue/package.json")文件存在 = 有;
    (有, 1, "插件 package.json 存在")断言等于;
    ("工具/vscode-riyue/package.json")读 = 文;
    (文, "\"id\": \"riyue\"", "语言 id 为 riyue")断言包含;
    (文, "\".心\"", "注册 .心 扩展名")断言包含;
    (文, "riyue.aiGenerate", "贡献 AI 生成命令")断言包含;
    (文, "riyue.restartServer", "贡献重启语言服务命令")断言包含;

    ("工具/vscode-riyue/language-configuration.json")文件存在 = 有;
    (有, 1, "语言配置存在")断言等于;

    ("工具/vscode-riyue/syntaxes/riyue.tmLanguage.json")读 = 文;
    (文, "source.riyue", "语法 scope 为 source.riyue")断言包含;
    (文, "keyword.control.riyue", "语法含控制关键字")断言包含;

    ("工具/vscode-riyue/snippets/riyue.json")读 = 文;
    (文, "主程序", "片段含主程序")断言包含;

    ("工具/vscode-riyue/extension.js")读 = 文;
    (文, "Content-Length", "LSP 客户端：Content-Length 帧")断言包含;
    (文, "textDocument/publishDiagnostics", "LSP 客户端：诊断回调")断言包含;
    (文, "AI助手.心", "LSP 客户端：AI 助手入口")断言包含;

    // 6) LSP 服务端源文件仍在
    ("工具/LSP服务端.心")文件存在 = 有;
    (有, 1, "LSP 服务端存在")断言等于;

    ("---")打印;
    ()测试总结;
    ("=== 测试完成 ===")打印;
}
