// 数组切片 / 填充 / 旋转 / 末次查找测试（8BL）
//
// 导入 标准库/数组.心，验证 8BL 新增的 `数组切片到`/`数组填充`/`数组旋转`/`查找末次`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/数组.心";

函数 (数组)打印整数数组(空) {
    (数组)动态数组大小 = 个数;
    0 = k;
    当 (k < 个数) {
        (数组, k)动态数组获取 = 元;
        (元)打印;
        k + 1 = k;
    }
}

函数 主程序 {
    ("=== 数组切片测试（8BL）===")打印;

    // 甲 = [10, 20, 30, 40, 50]
    ()创建动态数组 = 甲;
    (甲, 10)动态数组添加;
    (甲, 20)动态数组添加;
    (甲, 30)动态数组添加;
    (甲, 40)动态数组添加;
    (甲, 50)动态数组添加;

    ("-- 切片 1..4 --")打印;
    ()创建动态数组 = 切1;
    (甲, 5, 1, 4, 切1)数组切片到 = n1;
    (n1)打印;
    (切1)打印整数数组;

    ("-- 切片越界收拢 -5..100 --")打印;
    ()创建动态数组 = 切2;
    (甲, 5, 0 - 5, 100, 切2)数组切片到 = n2;
    (n2)打印;
    (切2)打印整数数组;

    ("-- 切片空区间 3..1 --")打印;
    ()创建动态数组 = 切3;
    (甲, 5, 3, 1, 切3)数组切片到 = n3;
    (n3)打印;

    ("-- 填充 1..4 为 9 --")打印;
    (甲, 5, 1, 4, 9)数组填充;
    (甲)打印整数数组;

    ("-- 旋转左移 2 --")打印;
    // 乙 = [1, 2, 3, 4, 5]
    ()创建动态数组 = 乙;
    (乙, 1)动态数组添加;
    (乙, 2)动态数组添加;
    (乙, 3)动态数组添加;
    (乙, 4)动态数组添加;
    (乙, 5)动态数组添加;
    (乙, 5, 2)数组旋转;
    (乙)打印整数数组;

    ("-- 旋转左移 -1（即右移 1）--")打印;
    ()创建动态数组 = 丙;
    (丙, 1)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 3)动态数组添加;
    (丙, 4)动态数组添加;
    (丙, 5)动态数组添加;
    (丙, 5, 0 - 1)数组旋转;
    (丙)打印整数数组;

    ("-- 旋转位移 7（模 5 = 2）--")打印;
    ()创建动态数组 = 丁;
    (丁, 1)动态数组添加;
    (丁, 2)动态数组添加;
    (丁, 3)动态数组添加;
    (丁, 4)动态数组添加;
    (丁, 5)动态数组添加;
    (丁, 5, 7)数组旋转;
    (丁)打印整数数组;

    ("-- 查找末次 --")打印;
    // 戊 = [1, 2, 3, 2, 1]
    ()创建动态数组 = 戊;
    (戊, 1)动态数组添加;
    (戊, 2)动态数组添加;
    (戊, 3)动态数组添加;
    (戊, 2)动态数组添加;
    (戊, 1)动态数组添加;
    (戊, 5, 1)查找末次 = f1;
    (f1)打印;
    (戊, 5, 2)查找末次 = f2;
    (f2)打印;
    (戊, 5, 9)查找末次 = f3;
    (f3)打印;

    ("=== 测试完成 ===")打印;
}
