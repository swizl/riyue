// 运行时反射：结构体 / 映射 / 元组判定（是结构体 / 是映射 / 是元组）

结构体 点 {
    x: 整数;
    y: 整数;
}

函数 主程序 {
    ("=== 反射类型判定测试 ===")打印;

    点 { x: 1, y: 2 } = 点变量;
    (点变量)是结构体 = 点结构;
    (点结构)打印;
    (点变量)是映射 = 点映射;
    (点映射)打印;
    (点变量)是元组 = 点元组;
    (点元组)打印;

    ["甲": "一"] = 映射变量;
    (映射变量)是结构体 = 映射结构;
    (映射结构)打印;
    (映射变量)是映射 = 映射映射;
    (映射映射)打印;
    (映射变量)是元组 = 映射元组;
    (映射元组)打印;

    (1, 2, 3) = 元组变量;
    (元组变量)是结构体 = 元组结构;
    (元组结构)打印;
    (元组变量)是映射 = 元组映射;
    (元组映射)打印;
    (元组变量)是元组 = 元组元组;
    (元组元组)打印;

    7 = 整数变量;
    (整数变量)是结构体 = 整数结构;
    (整数结构)打印;
    (整数变量)是映射 = 整数映射;
    (整数映射)打印;
    (整数变量)是元组 = 整数元组;
    (整数元组)打印;

    ("=== 测试完成 ===")打印;
}
