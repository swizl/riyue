// HTTP 服务端文本层测试（请求解析 / 响应构造）

导入 "标准库/HTTP.心";

// 打印字符串数组：先个数一行，再逐元素一行
函数 (表)打印表(空) {
    (表)动态字符串数组大小 = 数量;
    (数量)打印;
    0 = i;
    当 (i < 数量) {
        (表, i)动态字符串数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== HTTP 服务端测试 ===")打印;

    ("-- 解析 GET 请求（LF）")打印;
    ()创建动态字符串数组 = 头甲;
    ("GET /index.html HTTP/1.1\nHost: example.com\nAccept: */*\n\n", 头甲)HTTP解析请求 = (方法甲, 路径甲, 体甲);
    (方法甲)打印;
    (路径甲)打印;
    (头甲)打印表;
    (体甲)长度 = 体甲长;
    (体甲长)打印;

    ("-- 解析 POST 请求（CRLF，含体）")打印;
    (13)字符 = 单字;
    ("", 单字)拼接 = 回车;
    (10)字符 = 单字;
    (回车, 单字)拼接 = 换行;
    ("", "POST /api HTTP/1.1")拼接 = 段一;
    (段一, 换行)拼接 = 段二;
    (段二, "Content-Type: text/plain")拼接 = 段三;
    (段三, 换行)拼接 = 段四;
    (段四, 换行)拼接 = 段五;
    (段五, "hello=world")拼接 = 请求乙;
    ()创建动态字符串数组 = 头乙;
    (请求乙, 头乙)HTTP解析请求 = (方法乙, 路径乙, 体乙);
    (方法乙)打印;
    (路径乙)打印;
    (头乙)打印表;
    (体乙)打印;

    ("-- 构造 200 响应")打印;
    ()创建动态字符串数组 = 应头;
    (应头, "Content-Type: text/plain")动态字符串数组添加;
    (应头, "Set-Cookie: sid=42")动态字符串数组添加;
    (200, "OK", "hello", 应头)HTTP构造响应 = 响应;
    (响应)长度 = 响应长;
    (响应长)打印;
    (响应, "HTTP/1.1 200 OK")查找 = 状态位;
    (状态位)打印;
    (响应, "Content-Length: 5")查找 = 长位;
    (长位)打印;

    ("-- 构造 404 响应")打印;
    ()创建动态字符串数组 = 应头乙;
    (404, "Not Found", "missing", 应头乙)HTTP构造响应 = 响应乙;
    (响应乙)长度 = 响应乙长;
    (响应乙长)打印;
    (响应乙, "HTTP/1.1 404 Not Found")查找 = 状态乙位;
    (状态乙位)打印;

    ("=== 测试完成 ===")打印;
}
