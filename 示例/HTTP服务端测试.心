// HTTP 服务端测试（请求解析 / 响应构造 / 路由 / 中间件 / TCP 回环一次）
// 端到端段落的端口由进程号派生（20000..29999，避开系统临时端口段）且**不打印端口** ⇒ 双链可逐字节比对。

导入 "标准库/网络.心";
导入 "标准库/HTTP.心";

// 打印字符串数组：先个数一行，再逐元素一行
函数 (表)打印表(空) {
    (表)动态字符串数组大小 = 数量;
    (数量)打印;
    0 = i;
    当 (i < 数量) {
        (表, i)动态字符串数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== HTTP 服务端测试 ===")打印;

    ("-- 解析 GET 请求（LF）")打印;
    ()创建动态字符串数组 = 头甲;
    ("GET /index.html HTTP/1.1\nHost: example.com\nAccept: */*\n\n", 头甲)HTTP解析请求 = (方法甲, 路径甲, 体甲);
    (方法甲)打印;
    (路径甲)打印;
    (头甲)打印表;
    (体甲)长度 = 体甲长;
    (体甲长)打印;

    ("-- 解析 POST 请求（CRLF，含体）")打印;
    (13)字符 = 单字;
    ("", 单字)拼接 = 回车;
    (10)字符 = 单字;
    (回车, 单字)拼接 = 换行;
    ("", "POST /api HTTP/1.1")拼接 = 段一;
    (段一, 换行)拼接 = 段二;
    (段二, "Content-Type: text/plain")拼接 = 段三;
    (段三, 换行)拼接 = 段四;
    (段四, 换行)拼接 = 段五;
    (段五, "hello=world")拼接 = 请求乙;
    ()创建动态字符串数组 = 头乙;
    (请求乙, 头乙)HTTP解析请求 = (方法乙, 路径乙, 体乙);
    (方法乙)打印;
    (路径乙)打印;
    (头乙)打印表;
    (体乙)打印;

    ("-- 构造 200 响应")打印;
    ()创建动态字符串数组 = 应头;
    (应头, "Content-Type: text/plain")动态字符串数组添加;
    (应头, "Set-Cookie: sid=42")动态字符串数组添加;
    (200, "OK", "hello", 应头)HTTP构造响应 = 响应;
    (响应)长度 = 响应长;
    (响应长)打印;
    (响应, "HTTP/1.1 200 OK")查找 = 状态位;
    (状态位)打印;
    (响应, "Content-Length: 5")查找 = 长位;
    (长位)打印;

    ("-- 构造 404 响应")打印;
    ()创建动态字符串数组 = 应头乙;
    (404, "Not Found", "missing", 应头乙)HTTP构造响应 = 响应乙;
    (响应乙)长度 = 响应乙长;
    (响应乙长)打印;
    (响应乙, "HTTP/1.1 404 Not Found")查找 = 状态乙位;
    (状态乙位)打印;

    ("-- 路由注册（下标 0..3）")打印;
    ()HTTP路由新建 = 路由表;
    ("GET", "/", 路由表)HTTP路由添加 = 路首页;
    ("GET", "/api/*", 路由表)HTTP路由添加 = 路接口;
    ("POST", "/api/echo", 路由表)HTTP路由添加 = 路回显;
    ("*", "/健康", 路由表)HTTP路由添加 = 路健康;
    (路首页)打印;
    (路接口)打印;
    (路回显)打印;
    (路健康)打印;

    ("-- 路由匹配（精确 / 前缀 + 剥查询 / 方法通配 / 未命中）")打印;
    ("GET", "/", 路由表)HTTP路由匹配 = 命一;
    ("GET", "/api/users?x=1", 路由表)HTTP路由匹配 = 命二;
    ("POST", "/api/users", 路由表)HTTP路由匹配 = 命三;
    ("POST", "/api/echo", 路由表)HTTP路由匹配 = 命四;
    ("PUT", "/健康", 路由表)HTTP路由匹配 = 命五;
    ("PUT", "/missing", 路由表)HTTP路由匹配 = 命六;
    (命一)打印;
    (命二)打印;
    (命三)打印;
    (命四)打印;
    (命五)打印;
    (命六)打印;

    ("-- 路由处理（分派闭包）")打印;
    入(编号:整数, 请求方法:字符串, 请求路径:字符串, 请求体:字符串)函数(0 = 结果:字符串) {
        ()创建动态字符串数组 = 空头;
        如果 (编号 ?= 0) {
            (200, "OK", "home", 空头)HTTP构造响应 = 结果;
        } 否则如果 (编号 ?= 2) {
            (200, "OK", 请求体, 空头)HTTP构造响应 = 结果;
        } 否则如果 (编号 ?= 1) {
            (200, "OK", 请求路径, 空头)HTTP构造响应 = 结果;
        } 否则 {
            (404, "Not Found", "missing", 空头)HTTP构造响应 = 结果;
        }
    } = 分派;
    ("GET / HTTP/1.1\nHost: x\n\n", 分派, 路由表)HTTP路由处理 = 应一;
    (应一, "home")查找 = 应一体位;
    (应一体位)打印;
    ("POST /api/echo HTTP/1.1\nHost: x\n\nhello=world", 分派, 路由表)HTTP路由处理 = 应二;
    (应二, "hello=world")查找 = 应二体位;
    (应二体位)打印;
    ("DELETE /nope HTTP/1.1\nHost: x\n\n", 分派, 路由表)HTTP路由处理 = 应三;
    (应三, "404 Not Found")查找 = 应三状态位;
    (应三状态位)打印;

    ("-- 中间件（请求透传 + 响应加头）")打印;
    入(请求原文:字符串)函数(0 = 结果:字符串) {
        ("", 请求原文)拼接 = 结果;
    } = 请求中间件;
    入(请求原文:字符串, 响应原文:字符串)函数(0 = 结果:字符串) {
        (响应原文, "X-中间件", "1")HTTP响应加头 = 结果;
    } = 响应中间件;
    ("GET / HTTP/1.1\nHost: x\n\n", 请求中间件, 分派, 响应中间件, 路由表)HTTP中间件处理 = 应四;
    (应四, "X-中间件: 1")查找 = 中间件位;
    (中间件位)打印;
    (应四, "HTTP/1.1 200 OK")查找 = 中间件状态位;
    (中间件状态位)打印;

    ("-- 端到端：TCP 回环一次请求")打印;
    ()获取进程标识 = 进程号;
    (进程号 % 10000) + 20000 = 端口;
    (端口)TCP监听 = 服务器;
    (服务器 > 0)打印;
    ("127.0.0.1", 端口, "GET /api/users HTTP/1.1\nHost: x\n\n")TCP连接发送 = 客户端;
    (服务器, 分派, 路由表)HTTP服务一次 = 服务命中;
    (服务命中)打印;
    (客户端)TCP接收关闭 = 收到;
    (收到, "200 OK")查找 = 收到状态位;
    (收到状态位)打印;
    (收到, "/api/users")查找 = 收到路径位;
    (收到路径位)打印;

    ("=== 测试完成 ===")打印;
}
