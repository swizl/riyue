// 日期算法测试（8BQ）
//
// 导入 标准库/日期时间.心，验证 8BQ 新增的 `是否闰年`/`月天数`/`到儒略日`/`星期几`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

函数 主程序 {
    ("=== 日期算法测试（8BQ）===")打印;

    // ---- 是否闰年 ----
    ("-- 是否闰年 --")打印;
    (2000)是否闰年 = 甲1;
    (甲1)打印;
    (1900)是否闰年 = 甲2;
    (甲2)打印;
    (2024)是否闰年 = 甲3;
    (甲3)打印;
    (2023)是否闰年 = 甲4;
    (甲4)打印;
    (2100)是否闰年 = 甲5;
    (甲5)打印;

    // ---- 月天数 ----
    ("-- 月天数 --")打印;
    (2024, 2)月天数 = 乙1;
    (乙1)打印;
    (2023, 2)月天数 = 乙2;
    (乙2)打印;
    (2026, 1)月天数 = 乙3;
    (乙3)打印;
    (2026, 4)月天数 = 乙4;
    (乙4)打印;
    (2026, 12)月天数 = 乙5;
    (乙5)打印;

    // ---- 到儒略日 ----
    ("-- 到儒略日 --")打印;
    (2000, 1, 1)到儒略日 = 丙1;
    (丙1)打印;
    (2026, 10, 18)到儒略日 = 丙2;
    (丙2)打印;

    // ---- 星期几 ----
    ("-- 星期几 --")打印;
    (2024, 1, 1)星期几 = 丁1;
    (丁1)打印;
    (2000, 1, 1)星期几 = 丁2;
    (丁2)打印;
    (2026, 10, 18)星期几 = 丁3;
    (丁3)打印;

    ("=== 测试完成 ===")打印;
}
