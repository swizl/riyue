导入 "标准库/WebSocket.心";

// 把一个字节数组全部追加到另一个（模块内本地辅助）
函数 (源, 目标)追加字节(空) {
    0 = 个数;
    0 = i;
    0 = b;
    (源)动态数组大小 = 个数;
    0 = i;
    当 (i < 个数) {
        (源, i)动态数组获取 = b;
        (目标, b)动态数组添加;
        i + 1 = i;
    }
}

函数 (数组)打印载荷(空) {
    (数组)WebSocket转文本 = 文本值;
    ("载荷:")打印;
    (文本值)打印;
}

函数 主程序 {
    ("=== WebSocket 测试 ===")打印;

    ("模块版本:")打印;
    ()WebSocket模块版本 = 版本;
    (版本)打印;

    // —— 1) 服务端文本帧（不掩码）：载荷 "Hello" ——
    ()创建动态数组 = 载荷1;
    ("Hello", 载荷1)WebSocket追加文本;
    ()创建动态数组 = 帧1;
    (1, 载荷1, 帧1)WebSocket构造帧;
    ("服务端帧hex:")打印;
    (帧1)WebSocket转十六进制 = 帧1hex;
    (帧1hex)打印;

    // —— 2) 客户端掩码帧（掩码键 0x37 0xfa 0x21 0x3d，RFC 6455 §5.7 示例）——
    ()创建动态数组 = 键;
    (键, 55)动态数组添加;
    (键, 250)动态数组添加;
    (键, 33)动态数组添加;
    (键, 61)动态数组添加;
    ()创建动态数组 = 帧2;
    (1, 键, 载荷1, 帧2)WebSocket构造帧掩码;
    ("客户端帧hex:")打印;
    (帧2)WebSocket转十六进制 = 帧2hex;
    (帧2hex)打印;

    // —— 3) 解析服务端帧 ——
    ()创建动态数组 = 偏移1;
    (偏移1, 0)动态数组添加;
    ()创建动态数组 = 解1;
    (帧1, 解1, 偏移1)解析WebSocket帧 = (操作码1, 结束1);
    ("解析服务端 操作码:")打印;
    (操作码1)打印;
    ("解析服务端 结束:")打印;
    (结束1)打印;
    (解1)打印载荷;
    ("解析服务端 下一偏移:")打印;
    (偏移1, 0)动态数组获取 = 位置1;
    (位置1)打印;

    // —— 4) 解析客户端掩码帧（应自动解掩码还原 "Hello"）——
    ()创建动态数组 = 偏移2;
    (偏移2, 0)动态数组添加;
    ()创建动态数组 = 解2;
    (帧2, 解2, 偏移2)解析WebSocket帧 = (操作码2, 结束2);
    ("解析客户端 操作码:")打印;
    (操作码2)打印;
    (解2)打印载荷;

    // —— 5) 长载荷（16 位长度路径）：200 字节二进制帧 ——
    ()创建动态数组 = 大载荷;
    0 = i;
    当 (i < 200) {
        (大载荷, 65)动态数组添加;
        i + 1 = i;
    }
    ()创建动态数组 = 帧3;
    (2, 大载荷, 帧3)WebSocket构造帧;
    ("大帧总长:")打印;
    (帧3)动态数组大小 = 大长;
    (大长)打印;
    ("大帧头hex:")打印;
    ()创建动态数组 = 头四;
    0 = i;
    当 (i < 4) {
        (帧3, i)动态数组获取 = 大b;
        (头四, 大b)动态数组添加;
        i + 1 = i;
    }
    (头四)WebSocket转十六进制 = 头四hex;
    (头四hex)打印;

    // —— 6) 空载荷关闭帧（opcode=8）——
    ()创建动态数组 = 空载荷;
    ()创建动态数组 = 帧4;
    (8, 空载荷, 帧4)WebSocket构造帧;
    ("空载荷帧hex:")打印;
    (帧4)WebSocket转十六进制 = 帧4hex;
    (帧4hex)打印;

    // —— 7) 数据不足：仅 1 字节，应归返 -1 ——
    ()创建动态数组 = 短帧;
    (短帧, 129)动态数组添加;
    ()创建动态数组 = 偏移3;
    (偏移3, 0)动态数组添加;
    ()创建动态数组 = 解3;
    (短帧, 解3, 偏移3)解析WebSocket帧 = (操作码3, 结束3);
    ("短帧操作码:")打印;
    (操作码3)打印;

    // —— 8) 连续两帧（偏移推进）——
    ()创建动态数组 = 流;
    (帧1, 流)追加字节;
    (帧2, 流)追加字节;
    ()创建动态数组 = 流偏移;
    (流偏移, 0)动态数组添加;
    ()创建动态数组 = 解甲;
    (流, 解甲, 流偏移)解析WebSocket帧 = (操作甲, 结束甲);
    ()创建动态数组 = 解乙;
    (流, 解乙, 流偏移)解析WebSocket帧 = (操作乙, 结束乙);
    ("两帧 甲载荷:")打印;
    (解甲)WebSocket转文本 = 甲文;
    (甲文)打印;
    ("两帧 乙操作码:")打印;
    (操作乙)打印;
    ("两帧 乙载荷:")打印;
    (解乙)WebSocket转文本 = 乙文;
    (乙文)打印;
    ("两帧 最终偏移:")打印;
    (流偏移, 0)动态数组获取 = 终偏;
    (终偏)打印;

    ("=== 测试完成 ===")打印;
}
