// 闭包测试

函数 (f:函数, x:整数)应用两次(0 = 结果:整数) {
    (x)f = 中间;
    (中间)f = 结果;
}

函数 主程序 {
    ("=== 闭包测试 ===")打印;

    0 = 计数;
    函数()(0 = 结果:整数) {
        计数 + 1 = 计数;
        计数 = 结果;
    } = 增加;

    (()增加)打印;
    (()增加)打印;
    (()增加)打印;

    10 = 基数;
    函数(值:整数)(0 = 结果:整数) {
        值 + 基数 = 结果;
    } = 加基数;

    ((5)加基数)打印;
    ((20)加基数)打印;

    函数(x:整数)(0 = 结果:整数) {
        x * x = 结果;
    } = 平方;
    (平方, 3)应用两次 = r;
    (r)打印;

    ("=== 测试完成 ===")打印;
}
