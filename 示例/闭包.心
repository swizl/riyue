// 闭包测试
函数 主程序(): 空 {
    // 基本闭包：捕获外部变量
    变量 外部 = 10;
    变量 加上外部 = 函数(数): 整数 { 返回 数 + 外部; };
    打印(加上外部(5));   // 15

    // 闭包修改外部变量
    变量 计数器 = 0;
    变量 递增 = 函数(): 空 { 计数器 = 计数器 + 1; };
    递增();
    递增();
    递增();
    打印(计数器);  // 3

    // 多个闭包捕获同一变量
    变量 基数 = 100;
    变量 加十 = 函数(数): 整数 { 返回 数 + 基数; };
    变量 乘十 = 函数(数): 整数 { 返回 数 * 基数 / 100; };
    打印(加十(5));   // 105
    打印(乘十(3));   // 3

    // 闭包捕获多个变量
    变量 甲 = 10;
    变量 乙 = 20;
    变量 求和 = 函数(丙): 整数 { 返回 甲 + 乙 + 丙; };
    打印(求和(30));  // 60

    // 闭包在循环中使用
    变量 总和 = 0;
    变量 累加 = 函数(值): 空 { 总和 = 总和 + 值; };
    变量 循环计数 = 1;
    当 (循环计数 <= 10) {
        累加(循环计数);
        循环计数 = 循环计数 + 1;
    }
    打印(总和);  // 55

    // 嵌套闭包
    变量 外层值 = 5;
    变量 内层闭包 = 函数(内层参数): 整数 {
        变量 内层值 = 内层参数 * 2;
        变量 最内层 = 函数(): 整数 { 返回 外层值 + 内层值; };
        返回 最内层();
    };
    打印(内层闭包(10));  // 5 + 20 = 25
}
