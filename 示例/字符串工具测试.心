// 字符串工具测试（8BF）
//
// 导入 标准库/字符串.心，验证 8BF 新增的 `字符串转大写`/`字符串转小写`/`去除首尾空白`/`字符串重复`/`字符串含子串`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串工具测试（8BF）===")打印;

    ("-- 转大写 --")打印;
    ("Hello, World 123")字符串转大写 = 大1;
    (大1)打印;

    ("-- 转小写 --")打印;
    ("Hello, WORLD 123")字符串转小写 = 小1;
    (小1)打印;

    ("-- 去除首尾空白 --")打印;
    ("   hello   ")去除首尾空白 = 空1;
    (空1)打印;
    ("")去除首尾空白 = 空2;
    (空2)打印;
    ("     ")去除首尾空白 = 空3;
    (空3)打印;
    ("abc")去除首尾空白 = 空4;
    (空4)打印;
    // 含制表/换行的首尾空白
    (9)字符 = 制表;
    (10)字符 = 换行;
    "" = 带空白;
    (带空白, 制表)拼接 = 带空白;
    (带空白, "hi")拼接 = 带空白;
    (带空白, 换行)拼接 = 带空白;
    (带空白)去除首尾空白 = 空5;
    (空5)打印;

    ("-- 重复 --")打印;
    ("ab", 3)字符串重复 = 重1;
    (重1)打印;
    ("x", 0)字符串重复 = 重2;
    (重2)打印;
    ("", 5)字符串重复 = 重3;
    (重3)打印;

    ("-- 含子串 --")打印;
    ("hello world", "world")字符串含子串 = 含1;
    (含1)打印;
    ("hello world", "xyz")字符串含子串 = 含2;
    (含2)打印;
    ("hello", "ell")字符串含子串 = 含3;
    (含3)打印;

    ("=== 测试完成 ===")打印;
}
