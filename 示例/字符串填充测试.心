// 字符串取字符 / 前后缀 / 替换首个 / 填充测试（8BH）
// 归属：短板补齐计划 §Phase 1 §1.6 文本工具
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。
导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串填充测试（8BH）===")打印;

    // ---- 字符串取字符 ----
    ("abcde", 0)字符串取字符 = 取0;
    ("取0:")打印;
    (取0)打印;
    ("abcde", 4)字符串取字符 = 取4;
    ("取4:")打印;
    (取4)打印;
    ("abcde", 9)字符串取字符 = 取9;
    ("取9:")打印;
    (取9)打印;

    // ---- 字符串删除前缀 ----
    ("https://x", "https://")字符串删除前缀 = 删前1;
    ("删前1:")打印;
    (删前1)打印;
    ("hello", "xyz")字符串删除前缀 = 删前2;
    ("删前2:")打印;
    (删前2)打印;
    ("hello", "")字符串删除前缀 = 删前3;
    ("删前3:")打印;
    (删前3)打印;

    // ---- 字符串删除后缀 ----
    ("file.txt", ".txt")字符串删除后缀 = 删后1;
    ("删后1:")打印;
    (删后1)打印;
    ("file.txt", ".md")字符串删除后缀 = 删后2;
    ("删后2:")打印;
    (删后2)打印;
    ("file.txt", "")字符串删除后缀 = 删后3;
    ("删后3:")打印;
    (删后3)打印;

    // ---- 字符串替换首个 ----
    ("a-b-c", "-", "+")字符串替换首个 = 换1;
    ("换1:")打印;
    (换1)打印;
    ("aaa", "a", "bb")字符串替换首个 = 换2;
    ("换2:")打印;
    (换2)打印;
    ("abc", "z", "y")字符串替换首个 = 换3;
    ("换3:")打印;
    (换3)打印;

    // ---- 字符串左填充 ----
    ("7", 3, "0")字符串左填充 = 左1;
    ("左1:")打印;
    (左1)打印;
    ("abc", 2, "0")字符串左填充 = 左2;
    ("左2:")打印;
    (左2)打印;
    ("ab", 5, "-")字符串左填充 = 左3;
    ("左3:")打印;
    (左3)打印;

    // ---- 字符串右填充 ----
    ("7", 3, "0")字符串右填充 = 右1;
    ("右1:")打印;
    (右1)打印;
    ("ab", 5, ".")字符串右填充 = 右2;
    ("右2:")打印;
    (右2)打印;
    ("ab", 2, ".")字符串右填充 = 右3;
    ("右3:")打印;
    (右3)打印;

    ("=== 测试完成 ===")打印;
}
