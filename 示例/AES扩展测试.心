// AES 扩展测试：AES-192/256（FIPS-197 附录 C.2/C.3）、CBC 模式（SP 800-38A F.2.1）、PKCS#7 填充
// 字节数组接口：以十六进制串构造输入，以十六进制串输出结果。
导入 "标准库/AES.心";

// 十六进制字符码 → 半字节（0..15）；非法归返 16
函数 (码: 整数)测试十六进制值(16 = 结果: 整数) {
    0 = i;
    当 (i < 10) {
        如果 (48 + i ?= 码) { i = 结果; }
        i + 1 = i;
    }
    0 = j;
    当 (j < 6) {
        如果 (97 + j ?= 码) { 10 + j = 结果; }
        如果 (65 + j ?= 码) { 10 + j = 结果; }
        j + 1 = j;
    }
}

// 十六进制串 → 字节数组（追加到 输出）
函数 (十六进制串: 文本, 输出)测试十六进制转字节(0 = 状态: 整数) {
    (十六进制串)长度 = 总;
    0 = i;
    当 (i + 1 < 总) {
        (十六进制串, i)字符码 = 高码;
        (十六进制串, i + 1)字符码 = 低码;
        (高码)测试十六进制值 = 高;
        (低码)测试十六进制值 = 低;
        高 * 16 + 低 = 字节;
        (输出, 字节)动态数组添加;
        i + 2 = i;
    }
    0 = 状态;
}

// 带标题打印十六进制串
函数 (标题: 文本, 字节数组)打印十六进制(0 = 状态: 整数) {
    (字节数组)AES字节转十六进制 = 十六;
    (标题, 十六)拼接 = 行;
    (行)打印;
    0 = 状态;
}

函数 主程序 {
    ("=== AES 扩展测试 ===")打印;

    // 通用路径 128 位（FIPS-197 附录 C.1），验证通用轮数=10 与专用实现一致
    ()创建动态数组 = 密钥128;
    ("000102030405060708090a0b0c0d0e0f", 密钥128)测试十六进制转字节;
    ()创建动态数组 = 明文128;
    ("00112233445566778899aabbccddeeff", 明文128)测试十六进制转字节;
    ()创建动态数组 = 密文128;
    (密钥128, 明文128, 密文128)AES的ECB加密通用;
    ("-- 通用 128 单块 --")打印;
    (密文128)AES字节转十六进制 = 通用128;
    (通用128)打印;

    // AES-192（FIPS-197 附录 C.2）
    ()创建动态数组 = 密钥192;
    ("000102030405060708090a0b0c0d0e0f1011121314151617", 密钥192)测试十六进制转字节;
    ()创建动态数组 = 明文192;
    ("00112233445566778899aabbccddeeff", 明文192)测试十六进制转字节;
    ()创建动态数组 = 密文192;
    (密钥192, 明文192, 密文192)AES的ECB加密通用;
    ("-- AES-192 ECB --")打印;
    (密文192)AES字节转十六进制 = 结果192;
    (结果192)打印;
    ()创建动态数组 = 还原192;
    (密钥192, 密文192, 还原192)AES的ECB解密通用;
    ("还原: ", 还原192)打印十六进制;

    // AES-256（FIPS-197 附录 C.3）
    ()创建动态数组 = 密钥256;
    ("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 密钥256)测试十六进制转字节;
    ()创建动态数组 = 明文256;
    ("00112233445566778899aabbccddeeff", 明文256)测试十六进制转字节;
    ()创建动态数组 = 密文256;
    (密钥256, 明文256, 密文256)AES的ECB加密通用;
    ("-- AES-256 ECB --")打印;
    (密文256)AES字节转十六进制 = 结果256;
    (结果256)打印;
    ()创建动态数组 = 还原256;
    (密钥256, 密文256, 还原256)AES的ECB解密通用;
    ("还原: ", 还原256)打印十六进制;

    // AES-128-CBC 两分组（SP 800-38A F.2.1）
    ()创建动态数组 = 密钥CBC;
    ("2b7e151628aed2a6abf7158809cf4f3c", 密钥CBC)测试十六进制转字节;
    ()创建动态数组 = 向量;
    ("000102030405060708090a0b0c0d0e0f", 向量)测试十六进制转字节;
    ()创建动态数组 = 明文CBC;
    ("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51", 明文CBC)测试十六进制转字节;
    ()创建动态数组 = 密文CBC;
    (密钥CBC, 向量, 明文CBC, 密文CBC)AES的CBC加密;
    ("-- AES-128 CBC 两分组 --")打印;
    (密文CBC)AES字节转十六进制 = 结果CBC;
    (结果CBC)打印;
    ()创建动态数组 = 还原CBC;
    (密钥CBC, 向量, 密文CBC, 还原CBC)AES的CBC解密;
    ("解密: ", 还原CBC)打印十六进制;

    // PKCS#7 填充与去填充
    ()创建动态数组 = 数据;
    ("6162636465", 数据)测试十六进制转字节;
    ()创建动态数组 = 填充后;
    (数据, 填充后)AES填充PKCS7;
    ("-- PKCS#7 填充 --")打印;
    (填充后)动态数组大小 = 填充长度;
    ("长度:")打印;
    (填充长度)打印;
    ("填充: ", 填充后)打印十六进制;
    ()创建动态数组 = 去填充后;
    (填充后, 去填充后)AES去填充PKCS7;
    ("去填充: ", 去填充后)打印十六进制;

    ("=== 测试完成 ===")打印;
}
