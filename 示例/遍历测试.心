// for-in 循环测试
函数 主程序(): 空 {
    打印("=== 遍历测试 ===");

    // 创建数组
    变量 数据 = [10, 20, 30, 40, 50];

    // 遍历数组
    打印("遍历数组:");
    遍历 (元素 : 数据) {
        打印(元素);
    }

    // 遍历求和
    变量 总和 = 0;
    遍历 (元素 : 数据) {
        总和 = 总和 + 元素;
    }
    打印("总和:");
    打印(总和);

    打印("=== 测试完成 ===");
}
