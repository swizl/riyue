// AI 原语测试：提示构造 / 请求体 / 响应解析 / 端点拆分 / MCP 报文与行传输 / 契约校验
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定）；不访问网络。
//   · 传输层（AI发送 / AI补全 / AI生成 / AI解释）依赖真实端点，不入门禁；
//     本示例覆盖其全部文本层与 JSON-RPC 报文层。

导入 "../标准库/测试框架.心";
导入 "../标准库/AI.心";

函数 主程序 {
    "" = 文;
    "" = 甲;
    "" = 乙;
    "" = 报文;
    "" = 路径;
    0 = 版;
    0 = 端口;
    0 = 有;
    0 = 号;
    0 = 码;
    0 = 行数;
    ("=== AI 原语测试 ===")打印;
    ()AI模块版本 = 版;
    ("模块版本:")打印;
    (版)打印;

    // ---- 提示构造 ----
    ("-- 提示构造 --")打印;
    ("翻译", "你好")AI补全提示 = 文;
    (文, "任务：翻译", "补全提示前缀含任务")断言文本开头;
    (文, "你好", "补全提示结尾含输入")断言文本结尾;
    ("求两数之和")AI生成提示 = 文;
    (文, "请用日月语言生成满足以下需求的代码，只输出代码，不要解释：", "生成提示前缀")断言文本开头;
    ("0 = 甲;")AI解释提示 = 文;
    (文, "请逐段解释以下日月语言代码的作用：", "解释提示前缀")断言文本开头;

    // ---- 请求体 ----
    ("-- 请求体 --")打印;
    ("m1", "你好", 16)AI请求体 = 文;
    (文, "{\"model\":\"m1\",\"messages\":[{\"role\":\"user\",\"content\":\"你好\"}],\"max_tokens\":16,\"stream\":false}", "请求体原文")断言文本等于;
    ("m1", "a\"b", 8)AI请求体 = 文;
    (文, "\\\"", "请求体转义引号")断言包含;
    (文, "\"max_tokens\":8", "请求体令牌数")断言包含;

    // ---- 响应解析 ----
    ("-- 响应解析 --")打印;
    ("{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"你好\"}}]}")AI提取内容 = 甲;
    (甲, "你好", "提取 choices[0].message.content")断言文本等于;
    ("{\"error\":{\"message\":\"额度不足\"}}")AI提取内容 = 甲;
    (甲, "", "无 choices 时 content 为空")断言文本等于;
    ("{\"error\":{\"message\":\"额度不足\"}}")AI提取错误 = 甲;
    (甲, "额度不足", "提取 error.message")断言文本等于;
    ("不是JSON")AI提取内容 = 甲;
    (甲, "", "非法 JSON 归空")断言文本等于;

    // ---- 端点拆分 ----
    ("-- 端点拆分 --")打印;
    ("http://127.0.0.1:11434/api/chat")AI拆分端点 = (甲, 端口, 乙);
    (甲, "127.0.0.1", "拆出主机")断言文本等于;
    (端口, 11434, "拆出端口")断言等于;
    (乙, "/api/chat", "拆出路径")断言文本等于;
    ("http://example.com")AI拆分端点 = (甲, 端口, 乙);
    (甲, "example.com", "缺端口时主机")断言文本等于;
    (端口, 80, "缺端口按 80")断言等于;
    (乙, "/", "缺路径按 /")断言文本等于;
    ("https://api.example.com/v1/chat")AI拆分端点 = (甲, 端口, 乙);
    (甲, "api.example.com", "https 亦剥离前缀")断言文本等于;
    (乙, "/v1/chat", "https 路径")断言文本等于;

    // ---- MCP 报文构造 ----
    ("-- MCP 报文构造 --")打印;
    (7, "ping", "{}")MCP请求 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"ping\",\"params\":{}}", "MCP 请求报文")断言文本等于;
    ("notifications/initialized", "{}")MCP通知 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}}", "MCP 通知报文")断言文本等于;
    (1, "日月", "1.0")MCP初始化 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"日月\",\"version\":\"1.0\"}}}", "MCP 初始化报文")断言文本等于;
    (2)MCP工具列表 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}", "MCP 工具列表报文")断言文本等于;
    (3, "read_file", "{\"path\":\"a.txt\"}")MCP工具调用 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"read_file\",\"arguments\":{\"path\":\"a.txt\"}}}", "MCP 工具调用报文")断言文本等于;
    (4, "{\"ok\":true}")MCP响应 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"ok\":true}}", "MCP 成功响应报文")断言文本等于;
    (5, -32601, "Method not found")MCP错误响应 = 报文;
    (报文, "{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}", "MCP 错误响应报文")断言文本等于;

    // ---- MCP 报文提取 ----
    ("-- MCP 报文提取 --")打印;
    ("{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"ok\":true}}")MCP取编号 = 号;
    (号, 4, "取 id")断言等于;
    ("{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"ok\":true}}")MCP取结果 = 甲;
    (甲, "{\"ok\":true}", "取 result 子树")断言文本等于;
    ("{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"ok\":true}}")MCP是否错误 = 有;
    (有, 0, "成功报文无 error")断言等于;
    ("{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}")MCP是否错误 = 有;
    (有, 1, "错误报文有 error")断言等于;
    ("{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}")MCP取错误消息 = 甲;
    (甲, "Method not found", "取 error.message")断言文本等于;
    ("{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"params\":{}}")MCP取编号 = 号;
    (号, -1, "通知无 id")断言等于;

    // ---- MCP 行式传输（文件承载 stdio） ----
    ("-- MCP 行式传输 --")打印;
    "阶段/.mcp测试.txt" = 路径;
    (路径)文件存在 = 有;
    如果 (有 ?= 1) {
        (路径)删除文件 = 码;
    }
    (7, "ping", "{}")MCP请求 = 报文;
    (路径, 报文)MCP追加行 = 码;
    (码, 0, "首次追加成功")断言等于;
    ("notifications/initialized", "{}")MCP通知 = 报文;
    (路径, 报文)MCP追加行 = 码;
    (码, 0, "二次追加成功")断言等于;
    (路径)读取文件 = 文;
    (文)MCP行数 = 行数;
    (行数, 2, "文件两行")断言等于;
    (文, 0)MCP取行 = 甲;
    (甲, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"ping\",\"params\":{}}", "取第 0 行")断言文本等于;
    (文, 1)MCP取行 = 甲;
    (甲, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}}", "取第 1 行")断言文本等于;
    (文, 2)MCP取行 = 甲;
    (甲, "", "越界归空")断言文本等于;
    (路径)文件存在 = 有;
    如果 (有 ?= 1) {
        (路径)删除文件 = 码;
    }

    // ---- 契约校验（复用 8CE 确保） ----
    ("-- 契约校验 --")打印;
    ("{\"a\":1}")AI结构合法 = 有;
    (有, 1, "对象结构合法")断言等于;
    ("[1,2]")AI结构合法 = 有;
    (有, 0, "数组结构非法")断言等于;
    ("不是JSON")AI结构合法 = 有;
    (有, 0, "非 JSON 非法")断言等于;
    ("{\"ok\":true}", "模型输出为 JSON 对象")AI约束模型输出 = 有;
    (有, 1, "契约确保通过")断言等于;
    ("[1]", "模型输出须为 JSON 对象")AI约束模型输出 = 有;
    (有, 0, "契约确保违背")断言等于;

    ()测试总结;
    ("=== 测试完成 ===")打印;
}
