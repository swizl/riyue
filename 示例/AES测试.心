// AES 测试（AES-128 ECB，FIPS-197 附录 C.1 / 两分组向量）
// 字节数组接口：以十六进制串构造字节输入，以十六进制串输出密文/解密结果。
导入 "标准库/AES.心";

// 十六进制字符码 → 半字节（0..15）；非法归返 16
函数 (码: 整数)测试十六进制值(16 = 结果: 整数) {
    0 = i;
    当 (i < 10) {
        如果 (48 + i ?= 码) { i = 结果; }
        i + 1 = i;
    }
    0 = j;
    当 (j < 6) {
        如果 (97 + j ?= 码) { 10 + j = 结果; }
        如果 (65 + j ?= 码) { 10 + j = 结果; }
        j + 1 = j;
    }
}

// 十六进制串 → 字节数组（追加到 输出）
函数 (十六进制串: 文本, 输出)测试十六进制转字节(0 = 状态: 整数) {
    (十六进制串)长度 = 总;
    0 = i;
    当 (i + 1 < 总) {
        (十六进制串, i)字符码 = 高码;
        (十六进制串, i + 1)字符码 = 低码;
        (高码)测试十六进制值 = 高;
        (低码)测试十六进制值 = 低;
        高 * 16 + 低 = 字节;
        (输出, 字节)动态数组添加;
        i + 2 = i;
    }
    0 = 状态;
}

函数 主程序 {
    ("=== AES-128 ECB 测试 ===")打印;

    ()创建动态数组 = 密钥;
    ("000102030405060708090a0b0c0d0e0f", 密钥)测试十六进制转字节;

    // FIPS-197 附录 C.1
    ()创建动态数组 = 明文;
    ("00112233445566778899aabbccddeeff", 明文)测试十六进制转字节;
    ()创建动态数组 = 密文;
    (密钥, 明文, 密文)AES的ECB加密;
    (密文)AES字节转十六进制 = 甲;
    (甲)打印;

    ()创建动态数组 = 还原;
    (密钥, 密文, 还原)AES的ECB解密;
    (还原)AES字节转十六进制 = 乙;
    (乙)打印;

    // 两分组（ECB，各块独立）
    ()创建动态数组 = 明文二;
    ("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 明文二)测试十六进制转字节;
    ()创建动态数组 = 密文二;
    (密钥, 明文二, 密文二)AES的ECB加密;
    (密文二)AES字节转十六进制 = 丙;
    (丙)打印;

    ("=== 测试完成 ===")打印;
}
