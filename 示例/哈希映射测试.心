// 哈希映射测试：写入/覆盖/读取/包含 + 槽序惰性游标 + 与迭代器适配器链
导入 "../标准库/哈希映射.心";
导入 "../标准库/迭代器.心";

函数 (数组)打印数组 {
    (数组)动态数组大小 = 数;
    0 = i;
    当 (i < 数) {
        (数组, i)动态数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== 哈希映射测试 ===")打印;

    哈希映射<整数> { 键: ()创建动态数组, 值: ()创建动态数组, 占用: ()创建动态数组,
                    容量: 0, 数量: 0, 槽位: 0, 当前: 0 } = m;

    m.初始化(8);

    // 3 与 19 同槽（% 8 = 3），线性探测；3 再写一次应覆盖而非新增
    m.设置(3, 30);
    m.设置(11, 110);
    m.设置(19, 190);
    m.设置(3, 33);

    ("长度:")打印;
    (m.长度())打印;

    ("获取 3:")打印;
    (m.获取(3))打印;
    ("获取 19:")打印;
    (m.获取(19))打印;
    ("获取 4:")打印;
    (m.获取(4))打印;

    ("包含 11:")打印;
    (m.包含(11))打印;
    ("包含 4:")打印;
    (m.包含(4))打印;

    ("-- 槽序惰性遍历 --")打印;
    m.重置游标();
    0 = 和;
    1 = 未完;
    当 (未完 ?= 1) {
        m.有下一个() = 有;
        如果 (有 ?= 1) {
            m.下一个键() = 键;
            m.下一个值() = 值;
            (键)打印;
            (值)打印;
            和 + 值 = 和;
        } 否则 {
            0 = 未完;
        }
    }
    ("遍历和:")打印;
    (和)打印;
    ("遍历后剩余:")打印;
    (m.剩余())打印;
    ("遍历后还有下一个:")打印;
    (m.有下一个())打印;

    ("-- 值数组 → 迭代器适配器链 --")打印;
    m.值数组() = 值们;
    (值们)打印数组;

    入(值:整数)函数(结果: 整数) {
        值 * 2 = 结果;
    } = 加倍;

    入(值:整数)函数(结果: 整数) {
        0 = 结果;
        如果 (值 > 100) {
            1 = 结果;
        }
    } = 过百;

    (值们, 加倍)迭代器映射 = 倍增;
    (倍增)打印数组;

    (值们, 过百)迭代器过滤 = 大值;
    (大值)迭代器计数 = 大值个数;
    ("过百个数:")打印;
    (大值个数)打印;

    m.键数组() = 键们;
    (键们)迭代器计数 = 键数;
    ("键数:")打印;
    (键数)打印;

    ("=== 测试完成 ===")打印;
}
