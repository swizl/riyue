// 类型别名完整测试

// 定义类型别名
整数 = 整数别名:类型;
浮点 = 浮点别名:类型;

// 使用类型别名作为参数
函数 (甲:整数别名, 乙:整数别名)求和(0 = 结果:整数别名) {
    甲 + 乙 = 结果;
}

函数 主程序 {
    ("=== 类型别名完整测试 ===")打印;

    // 变量声明使用类型别名
    10 = 变量值:整数别名;
    20 = y:整数别名;
    ("x = ")打印;
    (变量值)打印;
    ("y = ")打印;
    (y)打印;

    // 函数调用
    (变量值, y)求和 = z;
    ("x + y = ")打印;
    (z)打印;

    3.14 = pi:浮点别名;
    ("pi = ")打印;
    (pi)打印;

    ("=== 测试完成 ===")打印;
}
