// 数组删除与重复判定测试（8BY）
//
// 导入 标准库/数组.心，验证 8BY 新增的 `数组删除首个值`/`数组删除所有值`/`数组是否含重复`/`数组众数`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/数组.心";

// 打印 数组 长度 n 及其前 n 个元素
函数 (arr, n:整数)打印数组(空) {
    (n)打印;
    0 = i;
    当 (i < n) {
        (arr, i)动态数组获取 = v;
        (v)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== 数组删除与重复判定测试（8BY）===")打印;

    // 甲 = [1, 2, 3, 2]
    ()创建动态数组 = 甲;
    (甲, 1)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 3)动态数组添加;
    (甲, 2)动态数组添加;

    // 乙 = [5, 5, 5]
    ()创建动态数组 = 乙;
    (乙, 5)动态数组添加;
    (乙, 5)动态数组添加;
    (乙, 5)动态数组添加;

    // 丙 = [1, 2, 3]
    ()创建动态数组 = 丙;
    (丙, 1)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 3)动态数组添加;

    // 丁 = [1, 2, 2, 3, 2]
    ()创建动态数组 = 丁;
    (丁, 1)动态数组添加;
    (丁, 2)动态数组添加;
    (丁, 2)动态数组添加;
    (丁, 3)动态数组添加;
    (丁, 2)动态数组添加;

    // 戊 = [7, 7, 7]
    ()创建动态数组 = 戊;
    (戊, 7)动态数组添加;
    (戊, 7)动态数组添加;
    (戊, 7)动态数组添加;

    // 己 = [1, 2, 3]
    ()创建动态数组 = 己;
    (己, 1)动态数组添加;
    (己, 2)动态数组添加;
    (己, 3)动态数组添加;

    // 庚 = [1, 2, 2, 3]
    ()创建动态数组 = 庚;
    (庚, 1)动态数组添加;
    (庚, 2)动态数组添加;
    (庚, 2)动态数组添加;
    (庚, 3)动态数组添加;

    // 辛 = []（空）
    ()创建动态数组 = 辛;

    // 壬 = [3, 1, 3, 1, 3]
    ()创建动态数组 = 壬;
    (壬, 3)动态数组添加;
    (壬, 1)动态数组添加;
    (壬, 3)动态数组添加;
    (壬, 1)动态数组添加;
    (壬, 3)动态数组添加;

    // 癸 = [5, 5, 6, 6]
    ()创建动态数组 = 癸;
    (癸, 5)动态数组添加;
    (癸, 5)动态数组添加;
    (癸, 6)动态数组添加;
    (癸, 6)动态数组添加;

    // 子 = [9]
    ()创建动态数组 = 子;
    (子, 9)动态数组添加;

    // ---- 删除首个值 ----
    ("-- 删除首个值 --")打印;
    (甲, 4, 2)数组删除首个值 = d1;
    ("[1,2,3,2] 删首个 2:")打印;
    (甲, d1)打印数组;
    (乙, 3, 5)数组删除首个值 = d2;
    ("[5,5,5] 删首个 5:")打印;
    (乙, d2)打印数组;
    (丙, 3, 9)数组删除首个值 = d3;
    ("[1,2,3] 删首个 9:")打印;
    (丙, d3)打印数组;

    // ---- 删除所有值 ----
    ("-- 删除所有值 --")打印;
    (丁, 5, 2)数组删除所有值 = a1;
    ("[1,2,2,3,2] 删所有 2:")打印;
    (丁, a1)打印数组;
    (戊, 3, 7)数组删除所有值 = a2;
    ("[7,7,7] 删所有 7:")打印;
    (戊, a2)打印数组;

    // ---- 是否含重复 ----
    ("-- 是否含重复 --")打印;
    (己, 3)数组是否含重复 = q1;
    ("[1,2,3]:")打印;
    (q1)打印;
    (庚, 4)数组是否含重复 = q2;
    ("[1,2,2,3]:")打印;
    (q2)打印;
    (辛, 0)数组是否含重复 = q3;
    ("[]:")打印;
    (q3)打印;
    (子, 1)数组是否含重复 = q4;
    ("[9]:")打印;
    (q4)打印;

    // ---- 众数 ----
    ("-- 众数 --")打印;
    (庚, 4)数组众数 = m1;
    ("[1,2,2,3]:")打印;
    (m1)打印;
    (壬, 5)数组众数 = m2;
    ("[3,1,3,1,3]:")打印;
    (m2)打印;
    (癸, 4)数组众数 = m3;
    ("[5,5,6,6]:")打印;
    (m3)打印;
    (辛, 0)数组众数 = m4;
    ("[]:")打印;
    (m4)打印;
    (子, 1)数组众数 = m5;
    ("[9]:")打印;
    (m5)打印;

    ("=== 测试完成 ===")打印;
}
