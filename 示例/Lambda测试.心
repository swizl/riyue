// Lambda 表达式测试

函数 主程序 {
    ("=== Lambda 表达式测试 ===")打印;

    入(f:函数, 变量值:整数)函数(0 = 结果:整数) { (变量值)f = 结果; } = 应用;

    // 匿名函数语法: 入(形参表)函数(返回表){函数体}
    入(变量值:整数)函数(0 = 结果:整数) { 变量值 * 变量值 = 结果; } = 平方;
    入(变量值:整数)函数(0 = 结果:整数) { 变量值 + 1 = 结果; } = 加一;
    入(变量值:整数)函数(0 = 结果:整数) { 变量值 * 2 = 结果; } = 加倍;

    // 使用匿名函数
    (平方, 5)应用 = r1;
    (r1)打印;  // 25

    (加一, 3)应用 = r2;
    (r2)打印;  // 4

    (加倍, 10)应用 = r3;
    (r3)打印;  // 20

    // 带类型标注的匿名函数
    入(变量值:浮点数)函数(0.0 = 结果:浮点数) { 变量值 * 变量值 = 结果; } = 平方浮点;

    // 多参数匿名函数
    入(变量值:整数, y:整数)函数(0 = 结果:整数) { 变量值 + y = 结果; } = 加法;

    ("=== 测试完成 ===")打印;
}
