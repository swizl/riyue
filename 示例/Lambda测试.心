// Lambda 表达式测试

函数 主程序 {
    ("=== Lambda 表达式测试 ===")打印;

    // 高阶函数
    函数(f:函数, 变量值:整数)(0 = 结果:整数) { (变量值)f = 结果; } = 应用;

    // Lambda 语法: 入(参数):(表达式)
    入(变量值):(变量值 * 变量值) = 平方;
    入(变量值):(变量值 + 1) = 加一;
    入(变量值):(变量值 * 2) = 加倍;

    // 使用Lambda
    (平方, 5)应用 = r1;
    (r1)打印;  // 25

    (加一, 3)应用 = r2;
    (r2)打印;  // 4

    (加倍, 10)应用 = r3;
    (r3)打印;  // 20

    // 带类型标注的Lambda
    入(变量值:浮点数):(变量值 * 变量值) = 平方浮点;

    // 多参数Lambda
    入(变量值, y):(变量值 + y) = 加法;

    ("=== 测试完成 ===")打印;
}
