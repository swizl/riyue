// ISO 周反解测试（8BZ）
//
// 导入 标准库/日期时间.心，验证 8BZ 新增的 `ISO周日期`/`ISO周年周数`/`ISO周起始`/`ISO周结束`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

// 打印 出[0]/出[1]/出[2]（年/月/日）
函数 (出)打印日期(空) {
    (出, 0)动态数组获取 = y;
    (出, 1)动态数组获取 = m;
    (出, 2)动态数组获取 = d;
    (y)打印;
    (m)打印;
    (d)打印;
}

函数 主程序 {
    ("=== ISO 周反解测试（8BZ）===")打印;

    // 复用同一输出数组，预置 3 槽（儒略日到日期 覆盖既有下标）
    ()创建动态数组 = 出;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;

    // ---- ISO周日期（ISO周年/周号/星期号 → 日期） ----
    ("-- ISO周日期 --")打印;
    (2024, 1, 1, 出)ISO周日期;
    ("2024-W01-1:")打印;
    (出)打印日期;
    (2024, 9, 5, 出)ISO周日期;
    ("2024-W09-5:")打印;
    (出)打印日期;
    (2020, 53, 5, 出)ISO周日期;
    ("2020-W53-5:")打印;
    (出)打印日期;
    (2024, 1, 7, 出)ISO周日期;
    ("2024-W01-7:")打印;
    (出)打印日期;

    // ---- ISO周年周数 ----
    ("-- ISO周年周数 --")打印;
    (2020)ISO周年周数 = c1;
    ("2020:")打印;
    (c1)打印;
    (2021)ISO周年周数 = c2;
    ("2021:")打印;
    (c2)打印;
    (2015)ISO周年周数 = c3;
    ("2015:")打印;
    (c3)打印;
    (2024)ISO周年周数 = c4;
    ("2024:")打印;
    (c4)打印;
    (2004)ISO周年周数 = c5;
    ("2004:")打印;
    (c5)打印;
    (2026)ISO周年周数 = c6;
    ("2026:")打印;
    (c6)打印;

    // ---- ISO周起始（该 ISO 周的周一） ----
    ("-- ISO周起始 --")打印;
    (2024, 3, 1, 出)ISO周起始;
    ("2024-03-01:")打印;
    (出)打印日期;
    (2024, 1, 1, 出)ISO周起始;
    ("2024-01-01:")打印;
    (出)打印日期;
    (2021, 1, 1, 出)ISO周起始;
    ("2021-01-01:")打印;
    (出)打印日期;

    // ---- ISO周结束（该 ISO 周的周日） ----
    ("-- ISO周结束 --")打印;
    (2024, 3, 1, 出)ISO周结束;
    ("2024-03-01:")打印;
    (出)打印日期;
    (2024, 1, 1, 出)ISO周结束;
    ("2024-01-01:")打印;
    (出)打印日期;
    (2021, 1, 1, 出)ISO周结束;
    ("2021-01-01:")打印;
    (出)打印日期;

    ("=== 测试完成 ===")打印;
}
