// 文件操作完整测试

函数 主程序 {
    ("=== 文件操作完整测试 ===")打印;
    
    // 测试创建目录
    ("1. 创建目录")打印;
    ("构建/测试目录")创建目录;
    ("构建/测试目录/子目录")创建目录;
    ("  创建成功")打印;
    
    // 测试目录存在
    ("2. 检查目录存在")打印;
    如果 (("构建/测试目录")目录存在 ?= 1) {
        ("  构建/测试目录 存在")打印;
    }
    如果 (("构建/测试目录/子目录")目录存在 ?= 1) {
        ("  构建/测试目录/子目录 存在")打印;
    }
    
    // 测试创建文件
    ("3. 创建测试文件")打印;
    ("构建/测试目录/文件1.txt", "w")打开 = 句柄1;
    (句柄1, "这是文件1的内容\n")写入;
    (句柄1)关闭;
    
    ("构建/测试目录/文件2.txt", "w")打开 = 句柄2;
    (句柄2, "这是文件2的内容\n")写入;
    (句柄2)关闭;
    
    ("构建/测试目录/子目录/文件3.txt", "w")打开 = 句柄3;
    (句柄3, "这是子目录中的文件\n")写入;
    (句柄3)关闭;
    ("  创建成功")打印;
    
    // 测试列出目录
    ("4. 列出目录内容")打印;
    ("构建/测试目录")列出目录 = 数量;
    ("  找到 ")打印;
    (数量)打印;
    ("  个项目")打印;
    
    0 = 索引;
    当 (索引 < 数量) {
        (索引)获取目录项名称 = 名称;
        (索引)获取目录项是否目录 = 是目录;
        ("    ")打印;
        如果 (是目录 ?= 1) {
            ("[目录] ")打印;
        } 否则 {
            ("[文件] ")打印;
        }
        (名称)打印;
        索引 + 1 = 索引;
    }
    
    // 测试获取文件信息
    ("5. 获取文件信息")打印;
    ("构建/测试目录/文件1.txt")获取文件名 = 文件名;
    ("  文件名: ")打印;
    (文件名)打印;
    
    ("构建/测试目录/文件1.txt")获取文件扩展名 = 扩展名;
    ("  扩展名: ")打印;
    (扩展名)打印;
    
    ("构建/测试目录/文件1.txt")获取目录路径 = 目录路径;
    ("  目录路径: ")打印;
    (目录路径)打印;
    
    // 测试路径连接
    ("6. 路径连接")打印;
    ("构建/测试目录", "新文件.txt")连接路径 = 新路径;
    ("  连接结果: ")打印;
    (新路径)打印;
    
    // 测试复制文件
    ("7. 复制文件")打印;
    ("构建/测试目录/文件1.txt", "构建/测试目录/文件1_副本.txt")复制文件;
    ("  复制成功")打印;
    
    // 测试重命名文件
    ("8. 重命名文件")打印;
    ("构建/测试目录/文件2.txt", "构建/测试目录/文件2_重命名.txt")重命名文件;
    ("  重命名成功")打印;
    
    // 测试获取文件大小
    ("9. 获取文件大小")打印;
    ("构建/测试目录/文件1.txt")获取文件大小 = 大小;
    ("  文件大小: ")打印;
    (大小)打印;
    (" 字节")打印;
    
    // 测试删除文件
    ("10. 删除文件")打印;
    ("构建/测试目录/文件1_副本.txt")删除文件;
    ("构建/测试目录/文件2_重命名.txt")删除文件;
    ("构建/测试目录/子目录/文件3.txt")删除文件;
    ("  删除成功")打印;
    
    // 测试删除目录（递归）
    ("11. 删除目录（递归）")打印;
    ("构建/测试目录")删除目录;
    ("  删除成功")打印;
    
    // 验证删除
    如果 (("构建/测试目录")目录存在 ?= 0) {
        ("  目录已删除")打印;
    }
    
    ("=== 测试完成 ===")打印;
}
