// 阶段10 G11-B：并发深化
//
// 1) 写共享数组的并行：「并行填充」「并行变换加」与只读的「并行求和」共用同一分区内核，
//    各线程只触碰互不相交的区间，故共享数组写入无数据竞争，结果与线程数无关（确定性）。
// 2) 抢占式调度：「抢占式调度运行(时间片毫秒)」给每个已注册任务一个 OS 线程，调度线程
//    按时间片 Resume/Suspend 轮转，任务不让出也会被强制切走。
//    抢占下任务执行顺序不确定，故任务只写「各自固定下标」，主程序按固定顺序读取，
//    输出因此仍然确定（双链逐字一致）。

协程 (槽:整数, 值:整数, 目标)写入槽 {
    0 = i;
    当 (i < 3) {
        (目标, 槽, 值)动态数组设置;
        i + 1 = i;
        让出 i;
    }
}

函数 主程序 {
    ("=== 并发深化测试 ===")打印;

    ("-- 写共享数组的并行 --")打印;
    ()创建动态数组 = 数;
    0 = k;
    当 (k < 8) {
        (数, 0)动态数组添加;
        k + 1 = k;
    }
    (数, 8, 4, 7)并行填充 = 填数;
    ("并行填充处理元素数:")打印;
    (填数)打印;
    (数, 0)动态数组获取 = 首;
    ("填充后首元素:")打印;
    (首)打印;
    (数, 7)动态数组获取 = 尾;
    ("填充后末元素:")打印;
    (尾)打印;

    (数, 8, 4, 5)并行变换加 = 变数;
    ("并行变换加处理元素数:")打印;
    (变数)打印;
    (数, 3)动态数组获取 = 中;
    ("变换后中间元素:")打印;
    (中)打印;

    (数, 8, 4)并行求和 = 总和;
    ("并行求和（4线程）:")打印;
    (总和)打印;

    ("-- 抢占式调度 --")打印;
    ()创建动态数组 = 槽值;
    (槽值, 0)动态数组添加;
    (槽值, 0)动态数组添加;
    (槽值, 0)动态数组添加;
    (0, 111, 槽值)写入槽 = 甲;
    (2, 333, 槽值)写入槽 = 乙;
    (甲)调度注册;
    (乙)调度注册;
    (1)抢占式调度运行 = 任务数;
    ("抢占式任务数:")打印;
    (任务数)打印;
    (槽值, 0)动态数组获取 = 槽零;
    ("槽0:")打印;
    (槽零)打印;
    (槽值, 2)动态数组获取 = 槽二;
    ("槽2:")打印;
    (槽二)打印;

    ("=== 测试完成 ===")打印;
}
