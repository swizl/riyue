// 数组功能测试
函数 主程序(): 空 {
    // 数组声明和初始化
    变量 数组 = [10, 20, 30, 40, 50];

    // 下标访问
    打印(数组[0]);  // 10
    打印(数组[2]);  // 30
    打印(数组[4]);  // 50

    // 下标赋值
    数组[1] = 99;
    打印(数组[1]);  // 99

    // 用变量作索引
    变量 索引 = 3;
    打印(数组[索引]);  // 40

    // 数组元素参与运算
    打印(数组[0] + 数组[4]);  // 60

    // 在循环中使用数组
    变量 和 = 0;
    变量 计数 = 0;
    当 (计数 < 5) {
        和 = 和 + 数组[计数];
        计数 = 计数 + 1;
    }
    打印(和);  // 10+99+30+40+50 = 229

    // 用数组实现冒泡排序
    变量 排序 = [64, 25, 12, 22, 11];
    变量 外层 = 0;
    当 (外层 < 4) {
        变量 内层 = 0;
        当 (内层 < 4 - 外层) {
            如果 (排序[内层] > 排序[内层 + 1]) {
                变量 临时 = 排序[内层];
                排序[内层] = 排序[内层 + 1];
                排序[内层 + 1] = 临时;
            }
            内层 = 内层 + 1;
        }
        外层 = 外层 + 1;
    }
    打印(排序[0]);  // 11
    打印(排序[1]);  // 12
    打印(排序[2]);  // 22
    打印(排序[3]);  // 25
    打印(排序[4]);  // 64
}
