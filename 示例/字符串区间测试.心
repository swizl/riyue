// 字符串续增测试（8BT）
//
// 导入 标准库/字符串.心，验证 8BT 新增的 `字符串去除字符`/`字符串是否以任意前缀`/`字符串是否以任意后缀`/`字符串替换区间`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串续增测试（8BT）===")打印;

    ("-- 字符串去除字符 --")打印;
    ("banana", 97)字符串去除字符 = r1;
    ("r1:")打印;
    (r1)打印;
    ("a-b-c", 45)字符串去除字符 = r2;
    ("r2:")打印;
    (r2)打印;
    ("hello", 122)字符串去除字符 = r3;
    ("r3:")打印;
    (r3)打印;
    ("", 97)字符串去除字符 = r4;
    ("r4:")打印;
    (r4)打印;

    ("-- 字符串是否以任意前缀 --")打印;
    ()创建动态字符串数组 = 前表;
    (前表, "xy")动态字符串数组添加;
    (前表, "he")动态字符串数组添加;
    ("hello", 前表, 2)字符串是否以任意前缀 = p1;
    ("p1:")打印;
    (p1)打印;
    ()创建动态字符串数组 = 前表2;
    (前表2, "xy")动态字符串数组添加;
    (前表2, "ab")动态字符串数组添加;
    ("hello", 前表2, 2)字符串是否以任意前缀 = p2;
    ("p2:")打印;
    (p2)打印;
    ()创建动态字符串数组 = 前表3;
    (前表3, "")动态字符串数组添加;
    (前表3, "xy")动态字符串数组添加;
    ("hello", 前表3, 2)字符串是否以任意前缀 = p3;
    ("p3:")打印;
    (p3)打印;
    ("hello", 前表, 0)字符串是否以任意前缀 = p4;
    ("p4:")打印;
    (p4)打印;

    ("-- 字符串是否以任意后缀 --")打印;
    ()创建动态字符串数组 = 后表;
    (后表, "lo")动态字符串数组添加;
    (后表, "xy")动态字符串数组添加;
    ("hello", 后表, 2)字符串是否以任意后缀 = s1;
    ("s1:")打印;
    (s1)打印;
    ()创建动态字符串数组 = 后表2;
    (后表2, "ly")动态字符串数组添加;
    (后表2, "ab")动态字符串数组添加;
    ("hello", 后表2, 2)字符串是否以任意后缀 = s2;
    ("s2:")打印;
    (s2)打印;
    ()创建动态字符串数组 = 后表3;
    (后表3, "hello")动态字符串数组添加;
    ("hello", 后表3, 1)字符串是否以任意后缀 = s3;
    ("s3:")打印;
    (s3)打印;
    ("hello", 后表, 0)字符串是否以任意后缀 = s4;
    ("s4:")打印;
    (s4)打印;

    ("-- 字符串替换区间 --")打印;
    ("hello", 1, 3, "XYZ")字符串替换区间 = t1;
    ("t1:")打印;
    (t1)打印;
    ("abcdef", 0, 6, "-")字符串替换区间 = t2;
    ("t2:")打印;
    (t2)打印;
    ("abcdef", 2, 2, "-")字符串替换区间 = t3;
    ("t3:")打印;
    (t3)打印;
    ("abcdef", 0 - 5, 100, "-")字符串替换区间 = t4;
    ("t4:")打印;
    (t4)打印;
    ("abcdef", 3, 100, "!")字符串替换区间 = t5;
    ("t5:")打印;
    (t5)打印;

    ("=== 测试完成 ===")打印;
}
