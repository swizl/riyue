// 标准库测试 - 日期时间、JSON、数学函数

函数 主程序(): 空 {
    打印("=== 标准库测试 ===");

    // 日期时间测试
    打印("\n--- 日期时间 ---");
    变量 日期 = 获取日期();
    打印(日期);
    变量 时间 = 获取时间();
    打印(时间);
    变量 日期时间 = 获取日期时间();
    打印(日期时间);
    变量 年 = 获取年份();
    打印(年);
    变量 月 = 获取月份();
    打印(月);
    变量 日 = 获取日();
    打印(日);
    变量 时 = 获取小时();
    打印(时);
    变量 分 = 获取分钟();
    打印(分);
    变量 秒 = 获取秒();
    打印(秒);
    变量 周 = 获取星期();
    打印(周);
    变量 时间戳 = 获取时间戳();
    打印(时间戳);

    // JSON测试
    打印("\n--- JSON ---");
    变量 json = "{\"名称\":\"张三\",\"年龄\":25,\"分数\":95.5,\"及格\":true}";
    打印(json);
    变量 名称 = JSON获取字符串(json, "名称");
    打印(名称);
    变量 年龄 = JSON获取整数(json, "年龄");
    打印(年龄);
    变量 分数 = JSON获取浮点(json, "分数");
    打印(分数);
    变量 及格 = JSON获取布尔(json, "及格");
    打印(及格);
    变量 存在1 = JSON存在(json, "名称");
    打印(存在1);
    变量 存在2 = JSON存在(json, "地址");
    打印(存在2);

    // 创建JSON
    变量 json2 = JSON创建字符串("城市", "北京");
    打印(json2);
    变量 json3 = JSON创建整数("数量", 100);
    打印(json3);

    // 数学函数测试
    打印("\n--- 数学函数 ---");
    变量 幂 = 幂运算(2, 10);
    打印(幂);
    变量 根 = 平方根(144);
    打印(根);
    变量 sin值 = 正弦(角度转弧度(30));
    打印(sin值);
    变量 cos值 = 余弦(角度转弧度(60));
    打印(cos值);
    变量 tan值 = 正切(角度转弧度(45));
    打印(tan值);
    变量 ln值 = 自然对数(2.718282);
    打印(ln值);
    变量 log值 = 常用对数(100);
    打印(log值);

    // 加密测试
    打印("\n--- 加密 ---");
    变量 原文 = "Hello World";
    变量 密钥 = 3;
    变量 密文 = 简单加密(原文, 密钥);
    打印(密文);
    变量 解密 = 简单解密(密文, 密钥);
    打印(解密);
    变量 哈希值 = 简单哈希(原文);
    打印(哈希值);

    // 随机数测试
    打印("\n--- 随机数 ---");
    变量 i = 0;
    当 (i < 5) {
        变量 随机 = 随机数(1, 100);
        打印(随机);
        i = i + 1;
    }
    变量 随机浮 = 随机浮点();
    打印(随机浮);

    // 计时测试
    打印("\n--- 计时 ---");
    开始计时();
    变量 sum = 0;
    变量 j = 0;
    当 (j < 1000000) {
        sum = sum + j;
        j = j + 1;
    }
    变量 耗时 = 结束计时();
    打印(sum);
    打印(耗时);

    // 系统函数测试
    打印("\n--- 系统函数 ---");
    变量 目录 = 获取当前目录();
    打印(目录);
    变量 存在 = 文件存在("示例/标准库测试.心");
    打印(存在);

    打印("\n=== 测试完成 ===");
}
