// 标准库综合测试

导入 "标准库/数学.心";
导入 "标准库/字符串.心";
导入 "标准库/数组.心";
导入 "标准库/测试框架.心";

函数 主程序 {
    ("=== 标准库综合测试 ===")打印;

    // 数学函数测试
    ("数学函数:")打印;
    (5, 3)最大值 = max;
    断言等于(max, 5, "最大值");
    
    (5, 3)最小值 = min;
    断言等于(min, 3, "最小值");
    
    (-5)绝对值 = abs;
    断言等于(abs, 5, "绝对值");
    
    (5)阶乘 = fact;
    断言等于(fact, 120, "阶乘");
    
    (12, 8)最大公约数 = gcd;
    断言等于(gcd, 4, "最大公约数");
    
    (12, 8)最小公倍数 = lcm;
    断言等于(lcm, 24, "最小公倍数");
    
    (2, 10)幂 = pow;
    断言等于(pow, 1024, "幂");

    // 字符串函数测试
    ("字符串函数:")打印;
    ("hello world", "world", "日月")字符串替换 = replaced;
    ("hello 日月")断言(1, "字符串替换");
    
    ("hello world", "hello")字符串开头 = starts;
    断言等于(starts, 1, "字符串开头");
    
    ("hello world", "world")字符串结尾 = ends;
    断言等于(ends, 1, "字符串结尾");
    
    ("hello")字符串反转 = reversed;
    ("olleh")断言(1, "字符串反转");

    // 数组函数测试
    ("数组函数:")打印;
    ()创建动态数组 = arr;
    (arr, 3)动态数组添加;
    (arr, 1)动态数组添加;
    (arr, 4)动态数组添加;
    (arr, 1)动态数组添加;
    (arr, 5)动态数组添加;
    
    (arr, 5)数组最大值 = arr_max;
    断言等于(arr_max, 5, "数组最大值");
    
    (arr, 5)数组最小值 = arr_min;
    断言等于(arr_min, 1, "数组最小值");
    
    (arr, 5)数组求和 = sum;
    断言等于(sum, 14, "数组求和");

    测试总结;
    ("=== 测试完成 ===")打印;
}
