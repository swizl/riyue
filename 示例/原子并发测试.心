// 阶段10 G11-C：原子 RMW（cmpxchg / xchg / and / or / xor）与全内存屏障
//
// 原子整数句柄为「整数32 槽号」（0 = 无效）。所有 RMW 内建统一返回**旧值**，
// 与 LLVM atomicrmw / cmpxchg 的返回约定一致；原子与 / 或 / 异或 分别对应
// atomicrmw and|or|xor，内存屏障对应 fence seq_cst。标准库 并发.心 的封装
// （原子取值 / 原子取交换 / 原子比较交换成功 / 锁内原子加 ...）在本例中一并验证。
// 纯 `.心` + 运行时内建，双链输出应逐字一致。

导入 "标准库/并发.心";

函数 主程序 {
    ("=== 原子并发测试 ===")打印;

    ("-- 比较交换 --")打印;
    (5)创建原子整数 = 原;
    (原, 5, 9)原子比较交换 = 旧一;
    ("命中返回旧值:")打印;
    (旧一)打印;
    (原)原子读 = 读一;
    ("命中后值:")打印;
    (读一)打印;
    (原, 5, 11)原子比较交换 = 旧二;
    ("未命中返回旧值:")打印;
    (旧二)打印;
    (原)原子读 = 读二;
    ("未命中后值:")打印;
    (读二)打印;
    (0, 1, 2)原子比较交换 = 旧无;
    ("无效句柄返回:")打印;
    (旧无)打印;

    ("-- 交换 --")打印;
    (原, 20)原子交换 = 旧三;
    ("交换返回旧值:")打印;
    (旧三)打印;
    (原)原子读 = 读三;
    ("交换后值:")打印;
    (读三)打印;

    ("-- 位运算 RMW --")打印;
    (原, 12)原子与 = 旧四;
    ("与返回旧值:")打印;
    (旧四)打印;
    (原)原子读 = 读四;
    ("与后值:")打印;
    (读四)打印;
    (原, 3)原子或 = 旧五;
    ("或返回旧值:")打印;
    (旧五)打印;
    (原)原子读 = 读五;
    ("或后值:")打印;
    (读五)打印;
    (原, 15)原子异或 = 旧六;
    ("异或返回旧值:")打印;
    (旧六)打印;
    (原)原子读 = 读六;
    ("异或后值:")打印;
    (读六)打印;

    ("-- 内存屏障 --")打印;
    ()内存屏障;
    ()并发屏障;
    ("屏障完成")打印;

    ("-- 标准库封装 --")打印;
    (原)原子取值 = 取一;
    ("取值:")打印;
    (取一)打印;
    (原, 7)原子取交换 = 交回;
    ("取交换旧值:")打印;
    (交回)打印;
    (原, 7, 8)原子比较交换成功 = 成功一;
    ("比较交换成功:")打印;
    (成功一)打印;
    (原, 7, 9)原子比较交换成功 = 成功二;
    ("比较交换失败:")打印;
    (成功二)打印;
    (原, 8, 0)原子比较交换回旧 = 回旧;
    ("回旧值:")打印;
    (回旧)打印;
    (原, 1)原子取与 = 与回;
    ("取与旧值:")打印;
    (与回)打印;
    (原, 2)原子取或 = 或回;
    ("取或旧值:")打印;
    (或回)打印;
    (原, 3)原子取异或 = 异或回;
    ("取异或旧值:")打印;
    (异或回)打印;

    ("-- 锁保护累加 --")打印;
    ()创建互斥锁 = 锁;
    (锁, 原, 2)锁内原子加 = 锁加;
    ("锁内原子加:")打印;
    (锁加)打印;
    (1)创建信号量 = 量;
    (量, 原, 3)量内原子加 = 量加;
    ("量内原子加:")打印;
    (量加)打印;
    (锁)销毁互斥锁 = 销毁锁;
    ("销毁锁:")打印;
    (销毁锁)打印;
    (量)销毁信号量 = 销毁量;
    ("销毁信号量:")打印;
    (销毁量)打印;
    (原)销毁原子整数 = 销毁原;
    ("销毁原子:")打印;
    (销毁原)打印;

    ("=== 测试完成 ===")打印;
}
