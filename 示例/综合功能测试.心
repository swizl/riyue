// 综合功能测试

// Lambda 简写演示（用匿名函数实现）
函数 (变量值:整数)平方(结果:整数) { 变量值 * 变量值 = 结果; }
函数 (变量值:整数)加一(结果:整数) { 变量值 + 1 = 结果; }

// 多返回值
函数 (甲:整数, 乙:整数)交换(变量值:整数, y:整数) {
    乙 = 变量值;
    甲 = y;
}

函数 主程序 {
    ("=== 综合功能测试 ===")打印;

    // 测试匿名函数/Lambda
    ("匿名函数测试:")打印;
    (5)平方 = sq;
    (sq)打印;
    (sq ?= 25)打印;

    (3)加一 = inc;
    (inc)打印;
    (inc ?= 4)打印;

    // 测试多返回值
    ("多返回值测试:")打印;
    (10, 3)交换 = (变量值, y);
    (变量值)打印;
    (变量值 ?= 3)打印;
    (y)打印;
    (y ?= 10)打印;

    // 测试管道
    ("管道测试:")打印;
    (5)平方|(结果=输入)加一 = pipe_result;
    (pipe_result)打印;
    (pipe_result ?= 26)打印;

    ("=== 测试完成 ===")打印;
}