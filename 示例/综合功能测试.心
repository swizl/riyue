// 综合功能测试

导入 "示例/标准库_正则.心";
导入 "示例/标准库_测试.心";

// Lambda 简写演示（用匿名函数实现）
函数 (x:整数)(0 = 结果:整数) { x * x = 结果; } = 平方;
函数 (x:整数)(0 = 结果:整数) { x + 1 = 结果; } = 加一;

// 数组推导演示（用函数实现）
函数 (arr:整数[], 大小:整数, f:函数)(0 = 结果:整数) {
    0 = 索引;
    当 (索引 < 大小) {
        (arr, 索引)获取动态数组元素 = 元素;
        (元素)f = 变换结果;
        (arr, 索引, 变换结果)动态数组设置;
        索引 + 1 = 索引;
    }
    0 = 结果;
}

函数 主程序 {
    ("=== 综合功能测试 ===")打印;

    // 测试正则表达式
    ("正则表达式测试:")打印;
    ("hello", "\\w+")正则匹配 = r1;
    断言(r1 ?= 1, "单词匹配");
    
    ("abc123", "\\d+")正则匹配 = r2;
    断言(r2 ?= 1, "数字匹配");
    
    ("hello world", "world")正则查找 = pos;
    断言等于(pos, 6, "查找位置");

    // 测试匿名函数/Lambda
    ("匿名函数测试:")打印;
    5 平方 = sq;
    断言等于(sq, 25, "平方函数");
    
    3 加一 = inc;
    断言等于(inc, 4, "加一函数");

    // 测试高阶函数
    ("高阶函数测试:")打印;
    ()创建动态数组 = arr;
    (arr, 1)动态数组添加;
    (arr, 2)动态数组添加;
    (arr, 3)动态数组添加;
    
    (arr)求大小 = size;
    断言等于(size, 3, "数组大小");

    // 测试多返回值
    ("多返回值测试:")打印;
    (10, 3)交换 = (x, y);
    断言等于(x, 3, "交换x");
    断言等于(y, 10, "交换y");

    // 测试管道
    ("管道测试:")打印;
    (5)平方|(结果=输入)加一 = pipe_result;
    断言等于(pipe_result, 26, "管道 5²+1");

    测试总结;
    ("=== 测试完成 ===")打印;
}

函数 (a:整数, b:整数)交换(0 = x:整数, 0 = y:整数) {
    b = x;
    a = y;
}
