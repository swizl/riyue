// 管道映射综合测试

函数 (甲:整数, 乙:整数)加法(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 (变量值:整数, y:整数)减法(0 = 结果:整数) {
    变量值 - y = 结果;
}

函数 (输入:整数)平方(0 = 结果:整数) {
    输入 * 输入 = 结果;
}

函数 (first:整数, second:整数)乘法(0 = 结果:整数) {
    first * second = 结果;
}

函数 主程序 {
    ("=== 管道映射综合测试 ===")打印;

    // 简单管道
    (3, 4)加法|平方 = r1;
    (r1)打印;  // 49

    // 映射管道：指定参数名
    (3, 4)加法|(结果=输入)平方 = r2;
    (r2)打印;  // 49

    // 链式管道
    (3, 4)加法|平方|(结果=输入)平方 = r3;
    (r3)打印;  // 2401 (49^2)

    // 映射到不同参数名
    (10, 3)减法|(结果=first)乘法(5) = r4;
    (r4)打印;  // 35 (7*5)

    ("=== 测试完成 ===")打印;
}
