// 日月语言示例：数学函数库
// 展示：递归、迭代、数学算法
// ============================================

// 绝对值
函数 绝对值(数): 整数 {
    如果 (数 < 0) {
        返回 -数;
    }
    返回 数;
}

// 最大值
函数 最大值(甲, 乙): 整数 {
    如果 (甲 > 乙) {
        返回 甲;
    }
    返回 乙;
}

// 最小值
函数 最小值(甲, 乙): 整数 {
    如果 (甲 < 乙) {
        返回 甲;
    }
    返回 乙;
}

// 幂运算（整数次方）
函数 幂(底数, 指数): 整数 {
    变量 结果 = 1;
    变量 计数 = 0;
    当 (计数 < 指数) {
        结果 = 结果 * 底数;
        计数 = 计数 + 1;
    }
    返回 结果;
}

// 整数平方根（牛顿迭代法）
函数 平方根(数): 整数 {
    如果 (数 <= 0) {
        返回 0;
    }
    变量 猜测 = 数 / 2;
    如果 (猜测 <= 0) {
        猜测 = 1;
    }
    变量 迭代 = 0;
    当 (迭代 < 20) {
        变量 新猜测 = (猜测 + 数 / 猜测) / 2;
        如果 (新猜测 >= 猜测) {
            返回 猜测;
        }
        猜测 = 新猜测;
        迭代 = 迭代 + 1;
    }
    返回 猜测;
}

// 判断是否为质数
函数 是质数(数): 整数 {
    如果 (数 <= 1) {
        返回 0;
    }
    如果 (数 <= 3) {
        返回 1;
    }
    如果 (数 % 2 ?= 0) {
        返回 0;
    }
    变量 因子 = 3;
    当 (因子 * 因子 <= 数) {
        如果 (数 % 因子 ?= 0) {
            返回 0;
        }
        因子 = 因子 + 2;
    }
    返回 1;
}

// 统计范围内质数个数
函数 质数计数(上限): 整数 {
    变量 计数 = 0;
    变量 数 = 2;
    当 (数 < 上限) {
        如果 (是质数(数) ?= 1) {
            计数 = 计数 + 1;
        }
        数 = 数 + 1;
    }
    返回 计数;
}

// 数字各位之和
函数 各位之和(数): 整数 {
    变量 和 = 0;
    当 (数 > 0) {
        和 = 和 + 数 % 10;
        数 = 数 / 10;
    }
    返回 和;
}

// 反转数字
函数 反转数字(数): 整数 {
    变量 结果 = 0;
    当 (数 > 0) {
        结果 = 结果 * 10 + 数 % 10;
        数 = 数 / 10;
    }
    返回 结果;
}

// 判断回文数
函数 是回文(数): 整数 {
    返回 数 ?= 反转数字(数);
}

// 三角数（第N个三角数 = 1+2+3+...+N）
函数 三角数(数): 整数 {
    返回 数 * (数 + 1) / 2;
}

// 阶乘（迭代版）
函数 阶乘迭代(数): 整数 {
    变量 结果 = 1;
    变量 计数 = 2;
    当 (计数 <= 数) {
        结果 = 结果 * 计数;
        计数 = 计数 + 1;
    }
    返回 结果;
}

// 主程序
函数 主程序(): 空 {
    打印(5001);  // 标记：数学库开始

    // 绝对值
    打印(绝对值(-42));   // 42
    打印(绝对值(7));     // 7

    // 最大最小值
    打印(最大值(10, 20));  // 20
    打印(最小值(10, 20));  // 10

    // 幂运算
    打印(幂(2, 10));   // 1024
    打印(幂(3, 4));    // 81
    打印(幂(10, 0));   // 1

    // 平方根
    打印(平方根(16));   // 4
    打印(平方根(100));  // 10
    打印(平方根(2));    // 1

    // 质数判断
    打印(是质数(2));    // 1
    打印(是质数(7));    // 1
    打印(是质数(4));    // 0
    打印(是质数(97));   // 1
    打印(是质数(100));  // 0

    // 质数计数
    打印(质数计数(10));   // 4 (2,3,5,7)
    打印(质数计数(100));  // 25

    // 各位之和
    打印(各位之和(12345));  // 15
    打印(各位之和(9999));   // 36

    // 反转数字
    打印(反转数字(12345));  // 54321
    打印(反转数字(100));    // 1

    // 回文判断
    打印(是回文(121));    // 1
    打印(是回文(123));    // 0
    打印(是回文(12321));  // 1

    // 三角数
    打印(三角数(10));   // 55
    打印(三角数(100));  // 5050

    // 阶乘迭代
    打印(阶乘迭代(5));   // 120
    打印(阶乘迭代(12));  // 479001600

    打印(5002);  // 标记：数学库结束
}
