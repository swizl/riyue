// 日期年步进与比较测试（8BW）
//
// 导入 标准库/日期时间.心，验证 8BW 新增的 `日期加年数`/`日期比较`/`年积日到日期`/`是否同一天`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

// 打印 出[0]/出[1]/出[2]（年/月/日）
函数 (出)打印三分量(空) {
    (出, 0)动态数组获取 = y;
    (出, 1)动态数组获取 = m;
    (出, 2)动态数组获取 = d;
    (y)打印;
    (m)打印;
    (d)打印;
}

函数 主程序 {
    ("=== 日期年步进与比较测试（8BW）===")打印;

    // ---- 日期加年数 ----
    ("-- 日期加年数 --")打印;
    ()创建动态数组 = 年甲;
    (年甲, 0)动态数组添加;
    (年甲, 0)动态数组添加;
    (年甲, 0)动态数组添加;
    (2024, 2, 29, 1, 年甲)日期加年数;
    ("2024-02-29 +1:")打印;
    (年甲)打印三分量;
    ()创建动态数组 = 年乙;
    (年乙, 0)动态数组添加;
    (年乙, 0)动态数组添加;
    (年乙, 0)动态数组添加;
    (2024, 2, 29, 4, 年乙)日期加年数;
    ("2024-02-29 +4:")打印;
    (年乙)打印三分量;
    ()创建动态数组 = 年丙;
    (年丙, 0)动态数组添加;
    (年丙, 0)动态数组添加;
    (年丙, 0)动态数组添加;
    (2023, 6, 15, 2, 年丙)日期加年数;
    ("2023-06-15 +2:")打印;
    (年丙)打印三分量;
    ()创建动态数组 = 年丁;
    (年丁, 0)动态数组添加;
    (年丁, 0)动态数组添加;
    (年丁, 0)动态数组添加;
    (2024, 3, 31, 0, 年丁)日期加年数;
    ("2024-03-31 +0:")打印;
    (年丁)打印三分量;
    ()创建动态数组 = 年戊;
    (年戊, 0)动态数组添加;
    (年戊, 0)动态数组添加;
    (年戊, 0)动态数组添加;
    (2024, 1, 1, 0 - 1, 年戊)日期加年数;
    ("2024-01-01 -1:")打印;
    (年戊)打印三分量;

    // ---- 日期比较 ----
    ("-- 日期比较 --")打印;
    (2024, 1, 1, 2024, 3, 1)日期比较 = c1;
    ("2024-01-01 vs 2024-03-01:")打印;
    (c1)打印;
    (2024, 3, 1, 2024, 1, 1)日期比较 = c2;
    ("2024-03-01 vs 2024-01-01:")打印;
    (c2)打印;
    (2024, 5, 5, 2024, 5, 5)日期比较 = c3;
    ("2024-05-05 vs 2024-05-05:")打印;
    (c3)打印;
    (2023, 12, 31, 2024, 1, 1)日期比较 = c4;
    ("2023-12-31 vs 2024-01-01:")打印;
    (c4)打印;

    // ---- 年积日到日期 ----
    ("-- 年积日到日期 --")打印;
    ()创建动态数组 = 积甲;
    (积甲, 0)动态数组添加;
    (积甲, 0)动态数组添加;
    (积甲, 0)动态数组添加;
    (2024, 1, 积甲)年积日到日期;
    ("2024 年第 1 天:")打印;
    (积甲)打印三分量;
    ()创建动态数组 = 积乙;
    (积乙, 0)动态数组添加;
    (积乙, 0)动态数组添加;
    (积乙, 0)动态数组添加;
    (2024, 366, 积乙)年积日到日期;
    ("2024 年第 366 天:")打印;
    (积乙)打印三分量;
    ()创建动态数组 = 积丙;
    (积丙, 0)动态数组添加;
    (积丙, 0)动态数组添加;
    (积丙, 0)动态数组添加;
    (2023, 365, 积丙)年积日到日期;
    ("2023 年第 365 天:")打印;
    (积丙)打印三分量;
    ()创建动态数组 = 积丁;
    (积丁, 0)动态数组添加;
    (积丁, 0)动态数组添加;
    (积丁, 0)动态数组添加;
    (2024, 61, 积丁)年积日到日期;
    ("2024 年第 61 天:")打印;
    (积丁)打印三分量;
    ()创建动态数组 = 积戊;
    (积戊, 0)动态数组添加;
    (积戊, 0)动态数组添加;
    (积戊, 0)动态数组添加;
    (2024, 32, 积戊)年积日到日期;
    ("2024 年第 32 天:")打印;
    (积戊)打印三分量;

    // ---- 是否同一天 ----
    ("-- 是否同一天 --")打印;
    (2024, 5, 5, 2024, 5, 5)是否同一天 = s1;
    ("2024-05-05 vs 2024-05-05:")打印;
    (s1)打印;
    (2024, 5, 5, 2024, 5, 6)是否同一天 = s2;
    ("2024-05-05 vs 2024-05-06:")打印;
    (s2)打印;
    (2024, 5, 5, 2023, 5, 5)是否同一天 = s3;
    ("2024-05-05 vs 2023-05-05:")打印;
    (s3)打印;
    (2024, 2, 29, 2024, 2, 29)是否同一天 = s4;
    ("2024-02-29 vs 2024-02-29:")打印;
    (s4)打印;

    ("=== 测试完成 ===")打印;
}
