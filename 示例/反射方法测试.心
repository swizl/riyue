// 运行时反射：结构体方法枚举与动态调用（方法数量 / 方法名称 / 方法动态调用）

结构体 计数器 {
    值: 整数;

    方法 增加(量: 整数)(0 = 结果:整数) {
        计数器.值 + 量 = 结果;
        结果 = 计数器.值;
    }

    方法 读取()(0 = 结果:整数) {
        计数器.值 = 结果;
    }
}

结构体 空壳 {
    x: 整数;
}

函数 主程序 {
    ("=== 反射方法测试 ===")打印;
    计数器 { 值: 10 } = 计数;

    (计数)方法数量 = 数;
    ("方法数量:")打印;
    (数)打印;

    (计数, 0)方法名称 = 名0;
    (计数, 1)方法名称 = 名1;
    (名0)打印;
    (名1)打印;

    // 越界 / 非字面量索引 → 空串
    (计数, 9)方法名称 = 越界名;
    ("[" + 越界名 + "]")打印;
    1 = 索引;
    (计数, 索引)方法名称 = 动态名;
    ("[" + 动态名 + "]")打印;

    // 按名动态调用方法
    ("增加结果:")打印;
    (计数, "增加", 5)方法动态调用 = 加后;
    (加后)打印;
    ("读取结果:")打印;
    (计数, "读取")方法动态调用 = 读值;
    (读值)打印;

    // 无方法的结构体 / 非结构体变量
    空壳 { x: 1 } = 壳;
    (壳)方法数量 = 空壳数;
    (空壳数)打印;
    (壳, 0)方法名称 = 空名;
    ("[" + 空名 + "]")打印;
    5 = 整数变量;
    (整数变量)方法数量 = 非结构数;
    (非结构数)打印;

    ("=== 测试完成 ===")打印;
}
