// 二叉搜索树测试

导入 "标准库/二叉搜索树.心";

函数 主程序 {
    ("=== 二叉搜索树测试 ===")打印;

    二叉搜索树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 根: -1, 数量: 0 } = t;

    // 插入 50,30,70,20,40,60,80
    t.插入(50);
    t.插入(30);
    t.插入(70);
    t.插入(20);
    t.插入(40);
    t.插入(60);
    t.插入(80);

    ("长度:")打印;
    (t.长度())打印;

    ("包含 40:")打印;
    (t.包含(40))打印;
    ("包含 45:")打印;
    (t.包含(45))打印;

    ("最小:")打印;
    (t.最小())打印;
    ("最大:")打印;
    (t.最大())打印;

    ("=== 测试完成 ===")打印;
}