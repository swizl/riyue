// 增量编译缓存测试：源指纹（MD5）/ 缓存键 / 命中判定 / 文件指纹自洽。
// 说明：文件指纹以「读取文件后 MD5 == 文件指纹」自洽比对，不依赖任何绝对哈希，路径相对于仓库根。
导入 "../标准库/编译缓存.心";

函数 主 {
    ("=== 增量缓存测试 ===")打印;

    ("abc")源指纹 = 甲;
    (甲)打印;
    ("")源指纹 = 空串指纹;
    (空串指纹)打印;

    (甲, "示例/增量缓存测试.心")缓存键 = 键甲;
    (甲, "示例/增量缓存测试.心")缓存键 = 键乙;
    (键甲, 键乙)缓存是否命中 = 命中同;
    (命中同)打印;
    (键甲, "abc")缓存是否命中 = 命中异;
    (命中异)打印;

    ("示例/增量缓存测试.心")读取文件 = 内容;
    (内容)MD5 = 直算;
    ("示例/增量缓存测试.心")文件指纹 = 文件算;
    (直算, 文件算)字符串比较 = 差;
    (差)打印;

    // 8CK 续增：缓存路径 / 缓存文件名 / 源是否变化
    ("示例/增量缓存测试.心", "缓存")缓存路径 = 缓存路径值;
    (缓存路径值)打印;
    (甲, "md5")缓存文件名 = 缓存名;
    (缓存名)打印;
    (甲, "abc")源是否变化 = 变一;
    (变一)打印;
    (甲, "abcd")源是否变化 = 变二;
    (变二)打印;

    ("=== 完成 ===")打印;
}
