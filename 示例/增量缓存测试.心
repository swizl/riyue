// 增量编译缓存测试：源指纹（MD5）/ 缓存键 / 命中判定 / 文件指纹自洽。
// 说明：文件指纹以「读取文件后 MD5 == 文件指纹」自洽比对，不依赖任何绝对哈希，路径相对于仓库根。
导入 "../标准库/编译缓存.心";

函数 主 {
    ("=== 增量缓存测试 ===")打印;

    ("abc")源指纹 = 甲;
    (甲)打印;
    ("")源指纹 = 空串指纹;
    (空串指纹)打印;

    (甲, "示例/增量缓存测试.心")缓存键 = 键甲;
    (甲, "示例/增量缓存测试.心")缓存键 = 键乙;
    (键甲, 键乙)缓存是否命中 = 命中同;
    (命中同)打印;
    (键甲, "abc")缓存是否命中 = 命中异;
    (命中异)打印;

    ("示例/增量缓存测试.心")读取文件 = 内容;
    (内容)MD5 = 直算;
    ("示例/增量缓存测试.心")文件指纹 = 文件算;
    (直算, 文件算)字符串比较 = 差;
    (差)打印;

    // 8CK 续增：缓存路径 / 缓存文件名 / 源是否变化
    ("示例/增量缓存测试.心", "缓存")缓存路径 = 缓存路径值;
    (缓存路径值)打印;
    (甲, "md5")缓存文件名 = 缓存名;
    (缓存名)打印;
    (甲, "abc")源是否变化 = 变一;
    (变一)打印;
    (甲, "abcd")源是否变化 = 变二;
    (变二)打印;

    // 8CN 续增：缓存键取指纹 / 取路径 / 缓存记录 / 缓存目录取
    (键甲)缓存键取指纹 = 指纹部;
    (指纹部)打印;
    (键甲)缓存键取路径 = 路径部;
    (路径部)打印;
    (键甲, "目标.o")缓存记录 = 记录;
    (记录)打印;
    ("示例/增量缓存测试.心")缓存目录取 = 目录部;
    (目录部)打印;
    ("no_slash")缓存目录取 = 无目录;
    (无目录)长度 = 无目录长;
    (无目录长)打印;

    // 8CS 续增：缓存扩展名 / 缓存去扩展名 / 缓存键空格数 / 缓存键是否合法
    (缓存路径值)缓存扩展名 = 扩名;
    (扩名)打印;
    (缓存路径值)缓存去扩展名 = 去扩;
    (去扩)打印;
    ("no_dot")缓存扩展名 = 无扩;
    (无扩)长度 = 无扩长;
    (无扩长)打印;
    (键甲)缓存键空格数 = 空格数;
    (空格数)打印;
    (键甲)缓存键是否合法 = 键合法;
    (键合法)打印;
    ("nospace")缓存键是否合法 = 键非法;
    (键非法)打印;

    // 8CW 续增：缓存键前缀 / 缓存键后缀 / 缓存路径文件名 / 是否同扩展名
    (键甲)缓存键前缀 = 前缀;
    (前缀)长度 = 前缀长;
    (前缀长)打印;
    (键甲)缓存键后缀 = 后缀;
    (后缀)长度 = 后缀长;
    (后缀长)打印;
    ("nospace")缓存键前缀 = 无前缀;
    (无前缀)长度 = 无前缀长;
    (无前缀长)打印;
    ("示例/增量缓存测试.心")缓存路径文件名 = 基名;
    (基名)打印;
    ("no_slash")缓存路径文件名 = 无斜排;
    (无斜排)打印;
    ("a.txt", "b.txt")缓存是否同扩展名 = 同扩;
    (同扩)打印;
    ("a.txt", "b.md")缓存是否同扩展名 = 异扩;
    (异扩)打印;

    ("=== 完成 ===")打印;
}
