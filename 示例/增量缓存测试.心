// 增量编译缓存测试：源指纹（MD5）/ 缓存键 / 命中判定 / 文件指纹自洽。
// 说明：文件指纹以「读取文件后 MD5 == 文件指纹」自洽比对，不依赖任何绝对哈希，路径相对于仓库根。
导入 "../标准库/编译缓存.心";

函数 主 {
    ("=== 增量缓存测试 ===")打印;

    ("abc")源指纹 = 甲;
    (甲)打印;
    ("")源指纹 = 空串指纹;
    (空串指纹)打印;

    (甲, "示例/增量缓存测试.心")缓存键 = 键甲;
    (甲, "示例/增量缓存测试.心")缓存键 = 键乙;
    (键甲, 键乙)缓存是否命中 = 命中同;
    (命中同)打印;
    (键甲, "abc")缓存是否命中 = 命中异;
    (命中异)打印;

    ("示例/增量缓存测试.心")读取文件 = 内容;
    (内容)MD5 = 直算;
    ("示例/增量缓存测试.心")文件指纹 = 文件算;
    (直算, 文件算)字符串比较 = 差;
    (差)打印;

    // 8CK 续增：缓存路径 / 缓存文件名 / 源是否变化
    ("示例/增量缓存测试.心", "缓存")缓存路径 = 缓存路径值;
    (缓存路径值)打印;
    (甲, "md5")缓存文件名 = 缓存名;
    (缓存名)打印;
    (甲, "abc")源是否变化 = 变一;
    (变一)打印;
    (甲, "abcd")源是否变化 = 变二;
    (变二)打印;

    // 8CN 续增：缓存键取指纹 / 取路径 / 缓存记录 / 缓存目录取
    (键甲)缓存键取指纹 = 指纹部;
    (指纹部)打印;
    (键甲)缓存键取路径 = 路径部;
    (路径部)打印;
    (键甲, "目标.o")缓存记录 = 记录;
    (记录)打印;
    ("示例/增量缓存测试.心")缓存目录取 = 目录部;
    (目录部)打印;
    ("no_slash")缓存目录取 = 无目录;
    (无目录)长度 = 无目录长;
    (无目录长)打印;

    // 8CS 续增：缓存扩展名 / 缓存去扩展名 / 缓存键空格数 / 缓存键是否合法
    (缓存路径值)缓存扩展名 = 扩名;
    (扩名)打印;
    (缓存路径值)缓存去扩展名 = 去扩;
    (去扩)打印;
    ("no_dot")缓存扩展名 = 无扩;
    (无扩)长度 = 无扩长;
    (无扩长)打印;
    (键甲)缓存键空格数 = 空格数;
    (空格数)打印;
    (键甲)缓存键是否合法 = 键合法;
    (键合法)打印;
    ("nospace")缓存键是否合法 = 键非法;
    (键非法)打印;

    // 8CW 续增：缓存键前缀 / 缓存键后缀 / 缓存路径文件名 / 是否同扩展名
    (键甲)缓存键前缀 = 前缀;
    (前缀)长度 = 前缀长;
    (前缀长)打印;
    (键甲)缓存键后缀 = 后缀;
    (后缀)长度 = 后缀长;
    (后缀长)打印;
    ("nospace")缓存键前缀 = 无前缀;
    (无前缀)长度 = 无前缀长;
    (无前缀长)打印;
    ("示例/增量缓存测试.心")缓存路径文件名 = 基名;
    (基名)打印;
    ("no_slash")缓存路径文件名 = 无斜排;
    (无斜排)打印;
    ("a.txt", "b.txt")缓存是否同扩展名 = 同扩;
    (同扩)打印;
    ("a.txt", "b.md")缓存是否同扩展名 = 异扩;
    (异扩)打印;

    // 8DA 续增：指纹是否合法 / 是否同目录 / 键是否空 / 路径是否绝对
    (键甲)缓存指纹是否合法 = 指纹合法;
    (指纹合法)打印;
    ("short path")缓存指纹是否合法 = 指纹非法;
    (指纹非法)打印;
    ("示例/a.心", "示例/b.心")缓存是否同目录 = 同目录;
    (同目录)打印;
    ("示例/a.心", "其它/b.心")缓存是否同目录 = 异目录;
    (异目录)打印;
    ("")缓存键是否空 = 空键;
    (空键)打印;
    (键甲)缓存键是否空 = 非空键;
    (非空键)打印;
    ("/abs/x.心")缓存路径是否绝对 = 绝对;
    (绝对)打印;
    ("rel/x.心")缓存路径是否绝对 = 相对;
    (相对)打印;

    // 8DE 续增：路径目录名 / 路径深度 / 键长度 / 是否含点
    ("示例/sub/a.心")缓存路径目录名 = 目录名;
    (目录名)打印;
    ("no_slash")缓存路径目录名 = 无斜目录;
    (无斜目录)长度 = 无斜长;
    (无斜长)打印;
    ("a/b/c.心")缓存路径深度 = 深度;
    (深度)打印;
    (键甲)缓存键长度 = 键长;
    (键长)打印;
    ("a.心")缓存是否含点 = 含点;
    (含点)打印;
    ("noext")缓存是否含点 = 无点;
    (无点)打印;

    // 8DI 续增：路径是否空 / 扩展名长度 / 是否同文件名 / 键指纹长度
    ("")缓存路径是否空 = 空串判;
    (空串判)打印;
    ("a.心")缓存路径是否空 = 非空判;
    (非空判)打印;
    ("a/b/c.心")缓存扩展名长度 = 扩长;
    (扩长)打印;
    ("noext")缓存扩展名长度 = 无扩长;
    (无扩长)打印;
    ("x/a.心", "y/a.心")缓存是否同文件名 = 同名判;
    (同名判)打印;
    ("x/a.心", "y/b.心")缓存是否同文件名 = 异名判;
    (异名判)打印;
    (键甲)缓存键指纹长度 = 指纹长;
    (指纹长)打印;

    // 8DM 续增：是否同路径 / 键是否同指纹 / 路径末字符码 / 路径首字符码
    ("a/b.心", "a/b.心")缓存是否同路径 = 判同路径;
    (判同路径)打印;
    ("a/b.心", "a/c.心")缓存是否同路径 = 判异路径;
    (判异路径)打印;
    (键甲, 键乙)缓存键是否同指纹 = 判键同指;
    (判键同指)打印;
    (键甲, "abc")缓存键是否同指纹 = 判键异指;
    (判键异指)打印;
    ("a/b.心")缓存路径末字符码 = 判末码;
    (判末码)打印;
    ("")缓存路径末字符码 = 判空末码;
    (判空末码)打印;
    ("a/b.心")缓存路径首字符码 = 判首码;
    (判首码)打印;
    ("")缓存路径首字符码 = 判空首码;
    (判空首码)打印;

    // 8DQ 续增：是否含斜杠 / 键是否以前缀开头 / 扩展名是否匹配 / 路径是否以后缀结尾
    ("a/b.心")缓存路径是否含斜杠 = 含斜;
    (含斜)打印;
    ("ab.心")缓存路径是否含斜杠 = 无斜;
    (无斜)打印;
    (键甲, 键甲)缓存键是否以前缀开头 = 键前同;
    (键前同)打印;
    (键甲, "zz")缓存键是否以前缀开头 = 键前异;
    (键前异)打印;
    ("a.心", "心")缓存扩展名是否匹配 = 扩匹;
    (扩匹)打印;
    ("a.心", "md")缓存扩展名是否匹配 = 扩不匹;
    (扩不匹)打印;
    ("a/b.心", ".心")缓存路径是否以后缀结尾 = 尾匹;
    (尾匹)打印;
    ("a/b.心", ".md")缓存路径是否以后缀结尾 = 尾不匹;
    (尾不匹)打印;

    // 8DU 续增：是否以上级 / 是否含反斜杠 / 是否在目录下 / 键是否以后缀结尾
    ("../a.心")缓存路径是否以上级 = 判上级;
    (判上级)打印;
    ("a/b.心")缓存路径是否以上级 = 判非上级;
    (判非上级)打印;
    (92)字符 = 反斜符;
    ("a", 反斜符)拼接 = 反斜串;
    (反斜串, "b.心")拼接 = 反斜串;
    (反斜串)缓存路径是否含反斜杠 = 判反斜;
    (判反斜)打印;
    ("a/b.心")缓存路径是否含反斜杠 = 判无反斜;
    (判无反斜)打印;
    ("src/a.心", "src")缓存路径是否在目录下 = 判在下;
    (判在下)打印;
    ("src/a.心", "lib")缓存路径是否在目录下 = 判不在下;
    (判不在下)打印;
    (键甲, "心")缓存键是否以后缀结尾 = 判键尾;
    (判键尾)打印;
    (键甲, "zz")缓存键是否以后缀结尾 = 判键非尾;
    (判键非尾)打印;

    ("=== 完成 ===")打印;
}
