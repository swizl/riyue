    // 8G2 续增：键是否含数字 / 路径是否含数字 / 键字母个数 / 路径数字个数
    ("a1b2")缓存键是否含数字 = 含数判;
    (含数判)打印;
    ("abc")缓存键是否含数字 = 无含数判;
    (无含数判)打印;
    ("a1b2")缓存路径是否含数字 = 路径含数判;
    (路径含数判)打印;
    ("ab1c")缓存键字母个数 = 键字母数判;
    (键字母数判)打印;
    ("a1b2c3")缓存路径数字个数 = 路径数字数判;
    (路径数字数判)打印;

    // 8G6 续增：键是否全字母 / 路径字母个数 / 键是否以数字结尾 / 键点个数
    ("abc")缓存键是否全字母 = 全字母判;
    (全字母判)打印;
    ("a1b2")缓存键是否全字母 = 非全字母判;
    (非全字母判)打印;
    ("a/bc")缓存路径字母个数 = 路字母数判;
    (路字母数判)打印;
    ("ab1")缓存键是否以数字结尾 = 尾数判;
    (尾数判)打印;
    ("abc")缓存键是否以数字结尾 = 非尾数判;
    (非尾数判)打印;
    ("a.b.c")缓存键点个数 = 键点数判;
    (键点数判)打印;

    // 8GA 续增：键是否含大写字母 / 路径是否含字母 / 路径是否以数字结尾 / 键小写个数
    ("aB")缓存键是否含大写字母 = 大字母判;
    (大字母判)打印;
    ("abc")缓存键是否含大写字母 = 非大字母判;
    (非大字母判)打印;
    ("a/b")缓存路径是否含字母 = 路含字母判;
    (路含字母判)打印;
    ("ab3")缓存路径是否以数字结尾 = 路尾数判;
    (路尾数判)打印;
    ("abc")缓存路径是否以数字结尾 = 非路尾数判;
    (非路尾数判)打印;
    ("aBcD")缓存键小写个数 = 小写个数判;
    (小写个数判)打印;

    ("=== 完成 ===")打印;
}
