// 浮点数测试
函数 主程序(): 空 {
    打印("=== 浮点数测试 ===");

    // 基本浮点字面量
    变量 圆周率 = 3.14159;
    变量 半径 = 5.0;
    打印("圆周率:");
    打印(圆周率);
    打印("半径:");
    打印(半径);

    // 浮点运算
    变量 面积 = 圆周率 * 半径 * 半径;
    打印("面积:");
    打印(面积);

    变量 周长 = 2.0 * 圆周率 * 半径;
    打印("周长:");
    打印(周长);

    // 混合运算（整数和浮点）
    变量 混合 = 10 + 3.14;
    打印("混合运算 10 + 3.14 =");
    打印(混合);

    // 浮点比较
    打印("3.14 > 3.0:");
    打印(3.14 > 3.0);
    打印("2.5 < 2.5:");
    打印(2.5 < 2.5);
    打印("1.0 ?= 1.0:");
    打印(1.0 ?= 1.0);

    // 浮点除法
    变量 除法结果 = 22.0 / 7.0;
    打印("22.0 / 7.0 =");
    打印(除法结果);

    // 负浮点数
    变量 负数 = -3.14;
    打印("负浮点数:");
    打印(负数);

    打印("=== 测试完成 ===");
}
