// 浮点数测试
函数 主程序 {
    ("=== 浮点数测试 ===")打印;

    ("圆周率:")打印;
    3.14159 = pi;
    (pi)打印;

    ("半径:")打印;
    5 = 结果值;
    (结果值)打印;

    ("面积:")打印;
    pi * 结果值 * 结果值 = area;
    (area)打印;

    ("周长:")打印;
    2 * pi * 结果值 = circumference;
    (circumference)打印;

    ("混合运算 10 + 3.14 =")打印;
    10 + 3.14 = 结果;
    (结果)打印;

    ("3.14 > 3.0:")打印;
    (3.14 > 3.0)打印;

    ("2.5 < 2.5:")打印;
    (2.5 < 2.5)打印;

    ("1.0 ?= 1.0:")打印;
    (1.0 ?= 1.0)打印;

    ("22.0 / 7.0 =")打印;
    (22.0 / 7.0)打印;

    ("负浮点数:")打印;
    -3.14 = neg;
    (neg)打印;

    ("=== 测试完成 ===")打印;
}
