// 猜数字游戏

函数 主程序 {
    ("=== 猜数字游戏 ===")打印;

    42 = 秘密数字;
    0 = 猜测次数;
    0 = 已猜对;

    ("我想了一个1到100之间的数字")打印;
    ("请猜猜看！")打印;

    50 = 猜测;
    (f"猜测: {猜测}")打印;
    猜测次数 + 1 = 猜测次数;

    如果 (猜测 < 秘密数字) {
        ("太小了！")打印;
    } 否则如果 (猜测 > 秘密数字) {
        ("太大了！")打印;
    } 否则 {
        ("猜对了！")打印;
        1 = 已猜对;
    }

    75 = 猜测;
    (f"猜测: {猜测}")打印;
    猜测次数 + 1 = 猜测次数;

    如果 (猜测 < 秘密数字) {
        ("太小了！")打印;
    } 否则如果 (猜测 > 秘密数字) {
        ("太大了！")打印;
    } 否则 {
        ("猜对了！")打印;
        1 = 已猜对;
    }

    42 = 猜测;
    (f"猜测: {猜测}")打印;
    猜测次数 + 1 = 猜测次数;

    如果 (猜测 < 秘密数字) {
        ("太小了！")打印;
    } 否则如果 (猜测 > 秘密数字) {
        ("太大了！")打印;
    } 否则 {
        ("猜对了！")打印;
        1 = 已猜对;
    }

    (f"猜测次数: {猜测次数}")打印;

    ("=== 游戏结束 ===")打印;
}
