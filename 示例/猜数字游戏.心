// ============================================
// 日月语言示例：猜数字游戏
// 展示：伪随机数、二分搜索策略
// ============================================

变量 随机种子 = 42;

函数 下一个随机数(): 整数 {
    随机种子 = (随机种子 * 7 + 13) % 1000;
    如果 (随机种子 < 0) {
        随机种子 = -随机种子;
    }
    返回 随机种子;
}

函数 范围随机数(最小, 最大): 整数 {
    变量 数 = 下一个随机数();
    返回 最小 + 数 % (最大 - 最小 + 1);
}

变量 游戏状态 = 0;
变量 目标数字 = 0;
变量 猜测次数 = 0;
变量 最小范围 = 0;
变量 最大范围 = 0;

函数 初始化游戏(最小, 最大): 空 {
    最小范围 = 最小;
    最大范围 = 最大;
    目标数字 = 范围随机数(最小, 最大);
    猜测次数 = 0;
    游戏状态 = 1;
}

函数 猜测(数字): 整数 {
    猜测次数 = 猜测次数 + 1;
    如果 (数字 ?= 目标数字) {
        游戏状态 = 4;
        返回 4;
    }
    如果 (数字 > 目标数字) {
        游戏状态 = 2;
        返回 2;
    }
    游戏状态 = 3;
    返回 3;
}

函数 二分猜测(): 整数 {
    变量 左 = 最小范围;
    变量 右 = 最大范围;
    变量 结果 = 0;
    当 (结果 != 4) {
        变量 中 = 左 + (右 - 左) / 2;
        结果 = 猜测(中);
        如果 (结果 ?= 2) {
            右 = 中 - 1;
        }
        如果 (结果 ?= 3) {
            左 = 中 + 1;
        }
    }
    返回 猜测次数;
}

// 简单栈
变量 栈0 = 0; 变量 栈1 = 0; 变量 栈2 = 0; 变量 栈3 = 0;
变量 栈4 = 0; 变量 栈5 = 0; 变量 栈6 = 0; 变量 栈7 = 0;
变量 栈顶 = 0;

函数 栈压入(值): 空 {
    如果 (栈顶 ?= 0) { 栈0 = 值; }
    如果 (栈顶 ?= 1) { 栈1 = 值; }
    如果 (栈顶 ?= 2) { 栈2 = 值; }
    如果 (栈顶 ?= 3) { 栈3 = 值; }
    如果 (栈顶 ?= 4) { 栈4 = 值; }
    如果 (栈顶 ?= 5) { 栈5 = 值; }
    如果 (栈顶 ?= 6) { 栈6 = 值; }
    如果 (栈顶 ?= 7) { 栈7 = 值; }
    栈顶 = 栈顶 + 1;
}

函数 栈弹出(): 整数 {
    栈顶 = 栈顶 - 1;
    如果 (栈顶 ?= 0) { 返回 栈0; }
    如果 (栈顶 ?= 1) { 返回 栈1; }
    如果 (栈顶 ?= 2) { 返回 栈2; }
    如果 (栈顶 ?= 3) { 返回 栈3; }
    如果 (栈顶 ?= 4) { 返回 栈4; }
    如果 (栈顶 ?= 5) { 返回 栈5; }
    如果 (栈顶 ?= 6) { 返回 栈6; }
    如果 (栈顶 ?= 7) { 返回 栈7; }
    返回 0;
}

函数 栈大小(): 整数 {
    返回 栈顶;
}

函数 主程序(): 空 {
    打印(6001);

    初始化游戏(1, 100);
    变量 次数 = 二分猜测();
    打印(次数);

    初始化游戏(1, 1000);
    次数 = 二分猜测();
    打印(次数);

    栈压入(10);
    栈压入(20);
    栈压入(30);
    打印(栈大小());
    打印(栈弹出());
    打印(栈弹出());

    打印(6002);
}
