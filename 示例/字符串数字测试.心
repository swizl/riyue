// 字符串数字/文本互转测试（8BJ）
//
// 导入 标准库/字符串.心，验证 8BJ 新增的 `字符串是否整数`/`字符串转整数`/`整数转字符串`/
// `字符串是否空白`/`字符串比较`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串数字测试（8BJ）===")打印;

    ("-- 是否整数 --")打印;
    ("123")字符串是否整数 = a1;
    (a1)打印;
    ("-45")字符串是否整数 = a2;
    (a2)打印;
    ("+7")字符串是否整数 = a3;
    (a3)打印;
    ("")字符串是否整数 = a4;
    (a4)打印;
    ("12a")字符串是否整数 = a5;
    (a5)打印;
    ("-")字符串是否整数 = a6;
    (a6)打印;
    ("1.5")字符串是否整数 = a7;
    (a7)打印;

    ("-- 字符串转整数 --")打印;
    ("123")字符串转整数 = b1;
    (b1)打印;
    ("-45")字符串转整数 = b2;
    (b2)打印;
    ("+7")字符串转整数 = b3;
    (b3)打印;
    ("12a")字符串转整数 = b4;
    (b4)打印;
    ("")字符串转整数 = b5;
    (b5)打印;
    ("0")字符串转整数 = b6;
    (b6)打印;

    ("-- 整数转字符串 --")打印;
    (0)整数转字符串 = c1;
    (c1)打印;
    (123)整数转字符串 = c2;
    (c2)打印;
    (-45)整数转字符串 = c3;
    (c3)打印;
    (7)整数转字符串 = c4;
    (c4)打印;

    ("-- 是否空白 --")打印;
    ("")字符串是否空白 = d1;
    (d1)打印;
    ("   ")字符串是否空白 = d2;
    (d2)打印;
    (" a ")字符串是否空白 = d3;
    (d3)打印;
    (9)字符 = 制表;
    (10)字符 = 换行;
    "" = 带空白;
    (带空白, 制表)拼接 = 带空白;
    (带空白, 换行)拼接 = 带空白;
    (带空白)字符串是否空白 = d4;
    (d4)打印;

    ("-- 字符串比较 --")打印;
    ("abc", "abc")字符串比较 = e1;
    (e1)打印;
    ("abc", "abd")字符串比较 = e2;
    (e2)打印;
    ("abd", "abc")字符串比较 = e3;
    (e3)打印;
    ("ab", "abc")字符串比较 = e4;
    (e4)打印;
    ("abc", "ab")字符串比较 = e5;
    (e5)打印;
    ("", "a")字符串比较 = e6;
    (e6)打印;

    ("=== 测试完成 ===")打印;
}
