// 阶段10 续43：与 clang 联合编译 —— C 侧 示例/C互操作/工具.c 由 clang 编成本地动态库，
//   日月侧用 `外部 函数` 按「库名 + 符号名 + 参数/返回类型」声明调用；
//   运行时 LoadLibraryA / dlopen 解析并缓存地址（见 源/运行时/运行时辅助.c 的 FFI 段）。
// 依赖库：run_tests.sh 在回归前构建 `_cinterop.dll`（工作目录 = 仓库根）。
//   手工构建：llvm-build/bin/clang -finput-charset=UTF-8 -fexec-charset=UTF-8 -O2 \
//               -shared 示例/C互操作/工具.c -o _cinterop.dll          （Linux 另加 -fPIC）
// 覆盖三条 ABI 入口：整数（i32）、整数64（i64）、浮点（统一双精度）。
外部 函数 "./_cinterop.dll" "riyue_add" 加法(甲: 整数, 乙: 整数)(结果: 整数);
外部 函数 "./_cinterop.dll" "riyue_mul64" 长整乘(甲: 整数64, 乙: 整数64)(结果: 整数64);
外部 函数 "./_cinterop.dll" "riyue_scale" 缩放(值: 浮点)(结果: 浮点);
// 阶段10 续51：结构体传递（按指针）。心侧 `结构体` 变量本身即指向堆上布局的指针，
// 直接传给 `指针` 形参；字段顺序与自然对齐需与 C 侧结构体一致。
外部 函数 "./_cinterop.dll" "riyue_sum_point" 点求和(点: 指针)(结果: 整数);

结构体 点 {
    横: 整数;
    纵: 整数;
}

函数 主程序 {
    ("=== C 互操作测试 ===")打印;

    (40, 2)加法 = 和;
    (和)打印;

    3000000:整数64 = 甲;
    4000000:整数64 = 乙;
    (甲, 乙)长整乘 = 积;
    (积)打印;

    (2.0)缩放 = 值;
    (值)打印;

    点 { 横: 10, 纵: 20 } = 坐标;
    ("结构体按指针传 C:")打印;
    (坐标)点求和 = 坐标和;
    (坐标和)打印;

    ("=== 测试完成 ===")打印;
}
