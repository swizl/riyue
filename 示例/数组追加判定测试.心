// 数组逆序追加 / 区间计数 / 回文判定 / 相邻最大差测试（8BV）
//
// 导入 标准库/数组.心，验证 8BV 新增的 `数组逆序追加`/`数组区间计数`/`数组是回文`/`数组相邻最大差`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/数组.心";

函数 主程序 {
    ("=== 数组追加判定测试（8BV）===")打印;

    // 甲 = [1, 2, 3, 2]
    ()创建动态数组 = 甲;
    (甲, 1)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 3)动态数组添加;
    (甲, 2)动态数组添加;

    // 乙 = [1, 2, 3, 4, 5]
    ()创建动态数组 = 乙;
    (乙, 1)动态数组添加;
    (乙, 2)动态数组添加;
    (乙, 3)动态数组添加;
    (乙, 4)动态数组添加;
    (乙, 5)动态数组添加;

    // 丙 = [1, 2, 2, 1]（回文）
    ()创建动态数组 = 丙;
    (丙, 1)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 1)动态数组添加;

    // 丁 = []（空）
    ()创建动态数组 = 丁;

    // 戊 = [7, 7]
    ()创建动态数组 = 戊;
    (戊, 7)动态数组添加;
    (戊, 7)动态数组添加;

    // 己 = [1, 5, 2]
    ()创建动态数组 = 己;
    (己, 1)动态数组添加;
    (己, 5)动态数组添加;
    (己, 2)动态数组添加;

    ("-- 逆序追加 --")打印;
    ()创建动态数组 = 目标甲;
    (甲, 4, 目标甲)数组逆序追加 = n1;
    (n1)打印;
    (目标甲, 0)动态数组获取 = t0;
    (t0)打印;
    (目标甲, 1)动态数组获取 = t1;
    (t1)打印;
    (目标甲, 2)动态数组获取 = t2;
    (t2)打印;
    (目标甲, 3)动态数组获取 = t3;
    (t3)打印;
    ()创建动态数组 = 目标空;
    (丁, 0, 目标空)数组逆序追加 = n2;
    (n2)打印;

    ("-- 区间计数 --")打印;
    (乙, 5, 2, 4)数组区间计数 = r1;
    (r1)打印;
    (乙, 5, 1, 5)数组区间计数 = r2;
    (r2)打印;
    (乙, 5, 6, 9)数组区间计数 = r3;
    (r3)打印;
    (丁, 0, 1, 9)数组区间计数 = r4;
    (r4)打印;

    ("-- 回文判定 --")打印;
    (甲, 4)数组是回文 = p1;
    (p1)打印;
    (丙, 4)数组是回文 = p2;
    (p2)打印;
    (丁, 0)数组是回文 = p3;
    (p3)打印;
    (戊, 2)数组是回文 = p4;
    (p4)打印;

    ("-- 相邻最大差 --")打印;
    (乙, 5)数组相邻最大差 = g1;
    (g1)打印;
    (甲, 4)数组相邻最大差 = g2;
    (g2)打印;
    (己, 3)数组相邻最大差 = g3;
    (g3)打印;
    (丁, 0)数组相邻最大差 = g4;
    (g4)打印;
    (戊, 2)数组相邻最大差 = g5;
    (g5)打印;

    ("=== 测试完成 ===")打印;
}
