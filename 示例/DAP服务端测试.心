// DAP 会话分派测试（阶段10 续65：VS Code 调试器集成）
// 覆盖：模块版本、initialize / launch / setBreakpoints / configurationDone /
//       threads / stackTrace / evaluate / continue / 未知方法 / disconnect 分派与帧拼装。
// 说明：只测 工具/DAP会话.心 的纯分派逻辑，不触发编译与运行，也不触碰 stdio。
//       多帧应答（initialize / 停在入口）用「含子串」断言，避免帧头混入正文。
导入 "../工具/DAP会话.心";

// 文本是否含子串（本地实现，避免与 LSP报文.心 重复导入 标准库/字符串.心）
函数 (文本:字符串, 子:字符串)含子串(0 = 结果:整数) {
    0 = 结果;
    (子)长度 = 子长;
    如果 (子长 ?= 0) { 1 = 结果; }
    如果 (子长 > 0) {
        (文本)长度 = 总长;
        0 = i;
        当 (i + 子长 <= 总长) {
            (文本, i, 子长)子串 = 片;
            如果 (片 ?= 子) { 1 = 结果; i + 总长 = i; }
            否则 { i + 1 = i; }
        }
    }
}

函数 主 {
    ("=== DAP服务端测试 ===")打印;

    // 1) 模块版本
    ()DAP模块版本 = 版本;
    (版本)打印;

    // 2) initialize：应答 + initialized 事件（两帧拼接）
    (1, "initialize")构造请求 = 初求;
    (初求)报文正文 = 初体;
    (初体)DAP处理 = 初应;
    (初应, "capabilities")含子串 = 有能;
    (有能)打印;
    (初应, "initialized")含子串 = 有事件;
    (有事件)打印;

    // 3) launch：登记 program（stopOnEntry=false）
    "{\"program\":\"示例/调试器测试.心\",\"stopOnEntry\":false}" = 启参;
    (2, "launch", 启参)构造请求带参数 = 启求;
    (启求)报文正文 = 启体;
    (启体)DAP处理 = 启应;
    (启应)报文正文 = 启应体;
    (启应体)打印;
    (待运行程序)打印;
    (入口暂停)打印;

    // 4) setBreakpoints：两个断点 → 仅登记（verified=false）
    "{\"path\":\"示例/调试器测试.心\",\"breakpoints\":[{\"line\":3},{\"line\":7}]}" = 断参;
    (3, "setBreakpoints", 断参)构造请求带参数 = 断求;
    (断求)报文正文 = 断体;
    (断体)DAP处理 = 断应;
    (断应)报文正文 = 断应体;
    (断应体)打印;
    (断点条数)打印;

    // 5) configurationDone：未要求停在入口 → 置待运行
    (4, "configurationDone")构造请求 = 配求;
    (配求)报文正文 = 配体;
    (配体)DAP处理 = 配应;
    (配应)报文正文 = 配应体;
    (配应体)打印;
    (待运行)打印;

    // 6) threads
    (5, "threads")构造请求 = 线求;
    (线求)报文正文 = 线体;
    (线体)DAP处理 = 线应;
    (线应)报文正文 = 线应体;
    (线应体)打印;

    // 7) stackTrace：未停止 → 空栈帧
    (6, "stackTrace")构造请求 = 栈求;
    (栈求)报文正文 = 栈体;
    (栈体)DAP处理 = 栈应;
    (栈应)报文正文 = 栈应体;
    (栈应体)打印;

    // 8) evaluate：诚实提示
    (7, "evaluate")构造请求 = 值求;
    (值求)报文正文 = 值体;
    (值体)DAP处理 = 值应;
    (值应)报文正文 = 值应体;
    (值应体)打印;

    // 9) continue
    (8, "continue")构造请求 = 续求;
    (续求)报文正文 = 续体;
    (续体)DAP处理 = 续应;
    (续应)报文正文 = 续应体;
    (续应体)打印;

    // 10) 未知方法（有 id）→ -32601
    (9, "custom/unknown")构造请求 = 未求;
    (未求)报文正文 = 未体;
    (未体)DAP处理 = 未应;
    (未应)报文正文 = 未应体;
    (未应体)打印;

    // 11) 未知通知（无 id）→ 无应答
    ("custom/notify")构造通知 = 通帧;
    (通帧)报文正文 = 通体;
    (通体)DAP处理 = 通应;
    (通应)长度 = 通应长;
    (通应长)打印;

    // 12) launch（stopOnEntry=true）
    "{\"program\":\"示例/调试器测试.心\",\"stopOnEntry\":true}" = 停参;
    (10, "launch", 停参)构造请求带参数 = 停求;
    (停求)报文正文 = 停体;
    (停体)DAP处理 = 停应;
    (停应)报文正文 = 停应体;
    (停应体)打印;

    // 13) configurationDone：停在入口 → 应答 + stopped(entry)
    (11, "configurationDone")构造请求 = 停配求;
    (停配求)报文正文 = 停配体;
    (停配体)DAP处理 = 停配应;
    (停配应, "stopped")含子串 = 有停;
    (有停)打印;
    (停配应, "entry")含子串 = 有入口;
    (有入口)打印;
    (停止中)打印;

    // 14) stackTrace：已停止 → 入口一帧
    (12, "stackTrace")构造请求 = 停栈求;
    (停栈求)报文正文 = 停栈体;
    (停栈体)DAP处理 = 停栈应;
    (停栈应)报文正文 = 停栈应体;
    (停栈应体)打印;

    // 15) continue：从入口恢复
    (13, "continue")构造请求 = 停续求;
    (停续求)报文正文 = 停续体;
    (停续体)DAP处理 = 停续应;
    (停续应)报文正文 = 停续应体;
    (停续应体)打印;
    (停止中)打印;

    // 16) disconnect：置退出请求
    (14, "disconnect")构造请求 = 断连求;
    (断连求)报文正文 = 断连体;
    (断连体)DAP处理 = 断连应;
    (断连应)报文正文 = 断连应体;
    (断连应体)打印;
    (退出请求)打印;
}
