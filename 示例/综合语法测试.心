// 综合语法特性测试

导入 "../标准库/数学.心";

函数 (被除数:整数, 除数:整数)除法求余(0 = 商:整数, 0 = 余数:整数) {
    被除数 / 除数 = 商;
    被除数 % 除数 = 余数;
}

函数 主程序 {
    ("=== 综合语法特性测试 ===")打印;

    // 匹配语句
    ("匹配语句:")打印;
    3 = day;
    匹配 (day) {
        1 => { ("周一")打印; }
        2 => { ("周二")打印; }
        3 => { ("周三")打印; }
        _ => { ("其他")打印; }
    }

    // 匿名函数和闭包
    ("匿名函数:")打印;
    函数(x:整数)(0 = 结果:整数) { x * x = 结果; } = 平方;
    函数(x:整数)(0 = 结果:整数) { x + 1 = 结果; } = 加一;
    函数(f:函数, g:函数, x:整数)(0 = 结果:整数) {
        (x)g = 中间;
        (中间)f = 结果;
    } = 组合;

    (平方, 加一, 3)组合 = result;
    (result)打印;  // (3+1)² = 16

    // 高阶函数
    ("高阶函数:")打印;
    函数(f:函数, x:整数)(0 = 结果:整数) { (x)f = 结果; } = 应用;
    (平方, 5)应用 = sq;
    (sq)打印;  // 25

    // 多返回值
    ("多返回值:")打印;
    函数(a:整数, b:整数)(0 = x:整数, 0 = y:整数) {
        b = x;
        a = y;
    } = 交换;

    (10, 3)交换 = (x, y);
    (x)打印;
    (y)打印;

    (17, 5)除法求余 = (商, 余数);
    (商)打印;
    (余数)打印;

    // 标准库函数
    ("标准库:")打印;
    (5, 3)最大值 = max;
    (max)打印;

    (-5)绝对值 = abs;
    (abs)打印;

    (5)阶乘 = fact;
    (fact)打印;

    // 数组操作
    ("数组操作:")打印;
    ()创建动态数组 = arr;
    (arr, 1)动态数组添加;
    (arr, 2)动态数组添加;
    (arr, 3)动态数组添加;
    (arr)动态数组大小 = size;
    (size)打印;

    ("=== 测试完成 ===")打印;
}
