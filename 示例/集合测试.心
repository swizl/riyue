// 集合工具测试（8BD）
//
// 导入 标准库/集合.心，验证 8BD 新增的 `数组差集`（结果写回 arr1）/`数组包含`/`数组相等`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/集合.心";

函数 主程序 {
    ("=== 集合工具测试（8BD）===")打印;

    // 甲 = [1, 2, 3, 2]
    ()创建动态数组 = 甲;
    (甲, 1)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 3)动态数组添加;
    (甲, 2)动态数组添加;
    // 乙 = [2, 3]
    ()创建动态数组 = 乙;
    (乙, 2)动态数组添加;
    (乙, 3)动态数组添加;

    ("-- 数组包含 --")打印;
    (甲, 4, 乙, 2)数组包含 = c1;
    (c1)打印;
    (乙, 2, 甲, 4)数组包含 = c2;
    (c2)打印;

    ("-- 数组相等 --")打印;
    (甲, 4, 甲, 4)数组相等 = e1;
    (e1)打印;
    (甲, 4, 乙, 2)数组相等 = e2;
    (e2)打印;
    (乙, 2, 乙, 2)数组相等 = e3;
    (e3)打印;

    ("-- 数组差集 --")打印;
    (甲, 4, 乙, 2)数组差集 = 差大小;
    (差大小)打印;
    (甲, 0)动态数组获取 = d0;
    (d0)打印;

    // 丙 = [5, 2, 7, 3]，丁 = [2, 3] ⇒ 差集 = [5, 7]
    ()创建动态数组 = 丙;
    (丙, 5)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 7)动态数组添加;
    (丙, 3)动态数组添加;
    ()创建动态数组 = 丁;
    (丁, 2)动态数组添加;
    (丁, 3)动态数组添加;
    (丙, 4, 丁, 2)数组差集 = 差丙;
    (差丙)打印;
    (丙, 0)动态数组获取 = p0;
    (p0)打印;
    (丙, 1)动态数组获取 = p1;
    (p1)打印;

    ("=== 测试完成 ===")打印;
}
