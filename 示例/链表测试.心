// 链表测试

导入 "标准库/链表.心";

函数 主程序 {
    ("=== 链表测试 ===")打印;

    链表<整数> { 数据: ()创建动态数组, 下一: ()创建动态数组, 头: -1, 数量: 0 } = l;

    // 尾部插入 10,20,30  → [10,20,30]
    l.尾部插入(10);
    l.尾部插入(20);
    l.尾部插入(30);

    ("尾部插入后长度:")打印;
    (l.长度())打印;

    ("获取:")打印;
    (l.获取(0))打印;
    (l.获取(1))打印;
    (l.获取(2))打印;

    // 头部插入 5  → [5,10,20,30]
    l.头部插入(5);

    ("头部插入后长度:")打印;
    (l.长度())打印;

    ("获取:")打印;
    (l.获取(0))打印;
    (l.获取(1))打印;

    ("=== 测试完成 ===")打印;
}