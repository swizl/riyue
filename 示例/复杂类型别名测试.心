// 复杂类型别名测试

// 基本类型别名
整数 = 整数别名:类型;
浮点 = 浮点别名:类型;

// 数组类型别名
整数[] = 整数数组:类型;
浮点[] = 浮点数组:类型;

// 嵌套使用类型别名的函数
函数 (a:整数别名, b:整数别名)加法(0 = 结果:整数别名) {
    a + b = 结果;
}

函数 (a:整数别名, b:整数别名)乘法(0 = 结果:整数别名) {
    a * b = 结果;
}

函数 (x:整数别名)平方(0 = 结果:整数别名) {
    (x, x)乘法 = 结果;
}

函数 主程序 {
    ("=== 复杂类型别名测试 ===")打印;

    // 基本使用
    5 = a:整数别名;
    3 = b:整数别名;
    ("a = ")打印;
    (a)打印;
    ("b = ")打印;
    (b)打印;

    // 函数调用
    (a, b)加法 = 和;
    ("a + b = ")打印;
    (和)打印;

    (a, b)乘法 = 积;
    ("a * b = ")打印;
    (积)打印;

    (a)平方 = 平方值;
    ("a² = ")打印;
    (平方值)打印;

    // 条件判断
    如果 (和 > 10) {
        ("和大于10")打印;
    }

    // 循环
    0 = i:整数别名;
    当 (i < 3) {
        (i)打印;
        (i)平方 = 平方值;
        ("的平方是")打印;
        (平方值)打印;
        i + 1 = i;
    }

    ("=== 测试完成 ===")打印;
}
