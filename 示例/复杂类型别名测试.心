// 复杂类型别名测试

// 基本类型别名
整数 = 整数别名:类型;
浮点 = 浮点别名:类型;

// 数组类型别名
整数[] = 整数数组:类型;
浮点[] = 浮点数组:类型;

// 嵌套使用类型别名的函数
函数 (甲:整数别名, 乙:整数别名)加法(0 = 结果:整数别名) {
    甲 + 乙 = 结果;
}

函数 (甲:整数别名, 乙:整数别名)乘法(0 = 结果:整数别名) {
    甲 * 乙 = 结果;
}

函数 (变量值:整数别名)平方(0 = 结果:整数别名) {
    (变量值, 变量值)乘法 = 结果;
}

函数 主程序 {
    ("=== 复杂类型别名测试 ===")打印;

    // 基本使用
    5 = 甲:整数别名;
    3 = 乙:整数别名;
    ("a = ")打印;
    (甲)打印;
    ("b = ")打印;
    (乙)打印;

    // 函数调用
    (甲, 乙)加法 = 和;
    ("a + 乙 = ")打印;
    (和)打印;

    (甲, 乙)乘法 = 积;
    ("a * 乙 = ")打印;
    (积)打印;

    (甲)平方 = 平方值;
    ("a² = ")打印;
    (平方值)打印;

    // 条件判断
    如果 (和 > 10) {
        ("和大于10")打印;
    }

    // 循环
    0 = 索引:整数别名;
    当 (索引 < 3) {
        (索引)打印;
        (索引)平方 = 平方值;
        ("的平方是")打印;
        (平方值)打印;
        索引 + 1 = 索引;
    }

    ("=== 测试完成 ===")打印;
}
