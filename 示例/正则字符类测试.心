// 正则字符类/锚点测试（8AY）
//
// 导入 标准库/正则.心，验证字符类 `[...]`（范围 `a-z`、否定 `[^...]`）与锚点 `^`/`$`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/正则.心";

函数 主程序 {
    ("=== 正则字符类/锚点测试（8AY）===")打印;

    ("-- 字符类 [...] --")打印;
    ("cat", "[abc]at")正则匹配 = r1;
    (r1)打印;
    ("dat", "[abc]at")正则匹配 = r2;
    (r2)打印;
    ("dog", "d[^abc]g")正则匹配 = r3;
    (r3)打印;
    ("dag", "d[^abc]g")正则匹配 = r4;
    (r4)打印;

    ("-- 字符类范围 --")打印;
    ("abc123", "[a-z]+")正则匹配 = r5;
    (r5)打印;
    ("ABC", "[a-z]+")正则匹配 = r6;
    (r6)打印;
    ("x9y", "[0-9]")正则查找 = p1;
    (p1)打印;
    ("hello", "[aeiou]+")正则查找 = p2;
    (p2)打印;
    ("abc", "[^0-9]+")正则匹配 = r7;
    (r7)打印;

    ("-- 锚点 ^ --")打印;
    ("abc", "^abc")正则匹配 = r8;
    (r8)打印;
    ("xabc", "^abc")正则匹配 = r9;
    (r9)打印;
    ("abc", "^bc")正则匹配 = r10;
    (r10)打印;

    ("-- 锚点 $ --")打印;
    ("abc", "abc$")正则匹配 = r11;
    (r11)打印;
    ("abcx", "abc$")正则匹配 = r12;
    (r12)打印;
    ("xy", "y$")正则查找 = p3;
    (p3)打印;

    ("-- 组合 ^...$ --")打印;
    ("123", "^\\d+$")正则匹配 = r13;
    (r13)打印;
    ("12a", "^\\d+$")正则匹配 = r14;
    (r14)打印;
    ("hello", "^[a-z]+$")正则匹配 = r15;
    (r15)打印;
    ("hello", "^[a-z]+$")正则查找 = p4;
    (p4)打印;

    ("=== 测试完成 ===")打印;
}
