// 包管理闭包测试：元数据表解析 / 传递依赖闭包 / 同名多约束重选（降级）/ 版本冲突
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定）。

导入 "标准库/包管理.心";

函数 ()主 {
    ("=== 包闭包测试 ===")打印;
    ("模块版本:")打印;
    ()包管理模块版本 = 模版;
    (模版)打印;

    // 注册表：元素形如 名称@版本
    ()创建动态字符串数组 = 注册表;
    (注册表, "甲@1.0.0")动态字符串数组添加;
    (注册表, "甲@2.0.0")动态字符串数组添加;
    (注册表, "乙@1.0.0")动态字符串数组添加;
    (注册表, "丙@1.0.0")动态字符串数组添加;
    (注册表, "丙@1.5.0")动态字符串数组添加;
    (注册表, "丙@3.0.0")动态字符串数组添加;
    (注册表, "丁@1.0.0")动态字符串数组添加;

    // 元数据表：元素形如 `名称@版本|依赖1, 依赖2`
    ()创建动态字符串数组 = 元数据;
    (元数据, "甲@1.0.0|乙 ^1.0.0")动态字符串数组添加;
    (元数据, "甲@2.0.0|乙 ^1.0.0, 丙 >=1.4.0")动态字符串数组添加;
    (元数据, "乙@1.0.0|")动态字符串数组添加;
    (元数据, "丙@1.0.0|")动态字符串数组添加;
    (元数据, "丙@1.5.0|")动态字符串数组添加;
    (元数据, "丙@3.0.0|")动态字符串数组添加;
    (元数据, "丁@1.0.0|丙 <=1.6.0")动态字符串数组添加;

    ("-- 元数据键与依赖串 --")打印;
    ("甲@2.0.0|乙 ^1.0.0, 丙 >=1.4.0")包元数据键 = 键;
    (键)打印;
    ("甲@2.0.0|乙 ^1.0.0, 丙 >=1.4.0")包元数据依赖串 = 串;
    (串)打印;
    ("无竖线")包元数据键 = 键;
    (键)打印;
    ("无竖线")包元数据依赖串 = 串;
    (串)长度 = 串长;
    ("无竖线时依赖串长度:")打印;
    (串长)打印;

    ("-- 元数据依赖 --")打印;
    ()创建动态字符串数组 = 依赖表;
    (元数据, "甲", "2.0.0", 依赖表)包元数据依赖 = 依赖数;
    (依赖数)打印;
    (依赖表, 0)动态字符串数组获取 = 依0;
    (依0)打印;
    (依赖表, 1)动态字符串数组获取 = 依1;
    (依1)打印;
    (元数据, "甲", "9.9.9", 依赖表)包元数据依赖 = 依赖数;
    ("无元数据条目时新增:")打印;
    (依赖数)打印;

    ("-- 闭包: 丙 + 甲 --")打印;
    ()创建动态字符串数组 = 根表;
    (根表, "丙")动态字符串数组添加;
    (根表, "甲")动态字符串数组添加;
    (根表, 注册表, 元数据)包闭包解析 = (名表, 版表, 冲表, 冲突数);
    ("冲突数:")打印;
    (冲突数)打印;
    (名表)动态字符串数组大小 = 名数;
    ("解析出:")打印;
    (名数)打印;
    0 = i;
    当 (i < 名数) {
        (名表, i)动态字符串数组获取 = 名;
        (版表, i)动态字符串数组获取 = 版;
        (名, "@")拼接 = 行;
        (行, 版)拼接 = 行;
        (行)打印;
        i + 1 = i;
    }

    ("-- 闭包锁文件 --")打印;
    (名表, 版表)包闭包锁文件 = 锁;
    (锁)打印;

    ("-- 闭包: 丙 + 丁（多约束降级）--")打印;
    ()创建动态字符串数组 = 根表2;
    (根表2, "丙")动态字符串数组添加;
    (根表2, "丁")动态字符串数组添加;
    (根表2, 注册表, 元数据)包闭包解析 = (名表2, 版表2, 冲表2, 冲突数2);
    ("冲突数:")打印;
    (冲突数2)打印;
    (名表2)动态字符串数组大小 = 名数2;
    ("解析出:")打印;
    (名数2)打印;
    0 = i;
    当 (i < 名数2) {
        (名表2, i)动态字符串数组获取 = 名;
        (版表2, i)动态字符串数组获取 = 版;
        (名, "@")拼接 = 行;
        (行, 版)拼接 = 行;
        (行)打印;
        i + 1 = i;
    }

    ("-- 闭包: 甲 + 丙 <1.2.0（版本冲突）--")打印;
    ()创建动态字符串数组 = 根表3;
    (根表3, "甲")动态字符串数组添加;
    (根表3, "丙 <1.2.0")动态字符串数组添加;
    (根表3, 注册表, 元数据)包闭包解析 = (名表3, 版表3, 冲表3, 冲突数3);
    ("冲突数:")打印;
    (冲突数3)打印;
    (名表3)动态字符串数组大小 = 名数3;
    ("解析出:")打印;
    (名数3)打印;
    0 = i;
    当 (i < 名数3) {
        (名表3, i)动态字符串数组获取 = 名;
        (版表3, i)动态字符串数组获取 = 版;
        (名, "@")拼接 = 行;
        (行, 版)拼接 = 行;
        (行)打印;
        i + 1 = i;
    }
    (冲表3, 0)动态字符串数组获取 = 冲名;
    ("冲突包:")打印;
    (冲名)打印;

    ("-- 闭包: 甲 >=9.0.0（无可用版本）--")打印;
    ()创建动态字符串数组 = 根表4;
    (根表4, "甲 >=9.0.0")动态字符串数组添加;
    (根表4, 注册表, 元数据)包闭包解析 = (名表4, 版表4, 冲表4, 冲突数4);
    ("冲突数:")打印;
    (冲突数4)打印;
    (名表4)动态字符串数组大小 = 名数4;
    ("解析出:")打印;
    (名数4)打印;
    (冲表4, 0)动态字符串数组获取 = 冲名4;
    ("冲突包:")打印;
    (冲名4)打印;

    ("=== 测试完成 ===")打印;
}
