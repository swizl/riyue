// 数据结构测试

函数 主程序 {
    ("=== 数据结构测试 ===")打印;

    ("栈操作:")打印;
    [] = 栈;
    10 = 栈[0];
    20 = 栈[1];
    30 = 栈[2];
    (栈[0])打印;
    (栈[1])打印;
    (栈[2])打印;

    ("队列操作:")打印;
    [100, 200, 300] = 队列;
    遍历 (v : 队列) {
        (v)打印;
    }

    ("矩阵:")打印;
    [[1, 2, 3], [4, 5, 6], [7, 8, 9]] = 矩阵;
    (矩阵[0][0])打印;
    (矩阵[1][1])打印;
    (矩阵[2][2])打印;

    ("=== 测试完成 ===")打印;
}
