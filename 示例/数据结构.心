// ---- 栈（用变量模拟数组，最大8个元素）----
变量 栈0 = 0; 变量 栈1 = 0; 变量 栈2 = 0; 变量 栈3 = 0;
变量 栈4 = 0; 变量 栈5 = 0; 变量 栈6 = 0; 变量 栈7 = 0;
变量 栈顶 = 0;

函数 栈压入(值): 空 {
    如果 (栈顶 ?= 0) { 栈0 = 值; }
    如果 (栈顶 ?= 1) { 栈1 = 值; }
    如果 (栈顶 ?= 2) { 栈2 = 值; }
    如果 (栈顶 ?= 3) { 栈3 = 值; }
    如果 (栈顶 ?= 4) { 栈4 = 值; }
    如果 (栈顶 ?= 5) { 栈5 = 值; }
    如果 (栈顶 ?= 6) { 栈6 = 值; }
    如果 (栈顶 ?= 7) { 栈7 = 值; }
    栈顶 = 栈顶 + 1;
}

函数 栈弹出(): 整数 {
    栈顶 = 栈顶 - 1;
    如果 (栈顶 ?= 0) { 返回 栈0; }
    如果 (栈顶 ?= 1) { 返回 栈1; }
    如果 (栈顶 ?= 2) { 返回 栈2; }
    如果 (栈顶 ?= 3) { 返回 栈3; }
    如果 (栈顶 ?= 4) { 返回 栈4; }
    如果 (栈顶 ?= 5) { 返回 栈5; }
    如果 (栈顶 ?= 6) { 返回 栈6; }
    如果 (栈顶 ?= 7) { 返回 栈7; }
    返回 0;
}

函数 栈大小(): 整数 {
    返回 栈顶;
}

// ---- 数组模拟（用于排序）----
变量 组0 = 0; 变量 组1 = 0; 变量 组2 = 0; 变量 组3 = 0;
变量 组4 = 0; 变量 组5 = 0; 变量 组6 = 0; 变量 组7 = 0;
变量 组8 = 0; 变量 组9 = 0;
变量 组大小 = 0;

函数 设置元素(索引, 值): 空 {
    如果 (索引 ?= 0) { 组0 = 值; }
    如果 (索引 ?= 1) { 组1 = 值; }
    如果 (索引 ?= 2) { 组2 = 值; }
    如果 (索引 ?= 3) { 组3 = 值; }
    如果 (索引 ?= 4) { 组4 = 值; }
    如果 (索引 ?= 5) { 组5 = 值; }
    如果 (索引 ?= 6) { 组6 = 值; }
    如果 (索引 ?= 7) { 组7 = 值; }
    如果 (索引 ?= 8) { 组8 = 值; }
    如果 (索引 ?= 9) { 组9 = 值; }
}

函数 获取元素(索引): 整数 {
    如果 (索引 ?= 0) { 返回 组0; }
    如果 (索引 ?= 1) { 返回 组1; }
    如果 (索引 ?= 2) { 返回 组2; }
    如果 (索引 ?= 3) { 返回 组3; }
    如果 (索引 ?= 4) { 返回 组4; }
    如果 (索引 ?= 5) { 返回 组5; }
    如果 (索引 ?= 6) { 返回 组6; }
    如果 (索引 ?= 7) { 返回 组7; }
    如果 (索引 ?= 8) { 返回 组8; }
    如果 (索引 ?= 9) { 返回 组9; }
    返回 0;
}

// 交换两个元素
函数 交换(甲, 乙): 空 {
    变量 临时 = 获取元素(甲);
    设置元素(甲, 获取元素(乙));
    设置元素(乙, 临时);
}

// 冒泡排序
函数 冒泡排序(长度): 空 {
    变量 外层 = 0;
    当 (外层 < 长度 - 1) {
        变量 内层 = 0;
        当 (内层 < 长度 - 1 - 外层) {
            如果 (获取元素(内层) > 获取元素(内层 + 1)) {
                交换(内层, 内层 + 1);
            }
            内层 = 内层 + 1;
        }
        外层 = 外层 + 1;
    }
}

// 选择排序
函数 选择排序(长度): 空 {
    变量 外层 = 0;
    当 (外层 < 长度 - 1) {
        变量 最小索引 = 外层;
        变量 内层 = 外层 + 1;
        当 (内层 < 长度) {
            如果 (获取元素(内层) < 获取元素(最小索引)) {
                最小索引 = 内层;
            }
            内层 = 内层 + 1;
        }
        如果 (最小索引 != 外层) {
            交换(外层, 最小索引);
        }
        外层 = 外层 + 1;
    }
}

// 线性搜索
函数 线性搜索(长度, 目标): 整数 {
    变量 遍历 = 0;
    当 (遍历 < 长度) {
        如果 (获取元素(遍历) ?= 目标) {
            返回 遍历;
        }
        遍历 = 遍历 + 1;
    }
    返回 -1;
}

// 二分搜索（要求数组已排序）
函数 二分搜索(长度, 目标): 整数 {
    变量 左 = 0;
    变量 右 = 长度 - 1;
    当 (左 <= 右) {
        变量 中 = 左 + (右 - 左) / 2;
        变量 中值 = 获取元素(中);
        如果 (中值 ?= 目标) {
            返回 中;
        }
        如果 (中值 < 目标) {
            左 = 中 + 1;
        } 否则 {
            右 = 中 - 1;
        }
    }
    返回 -1;
}

// 主程序
函数 主程序(): 空 {
    打印(4001);  // 标记：数据结构开始

    // ---- 栈测试 ----
    栈压入(10);
    栈压入(20);
    栈压入(30);
    打印(栈大小());  // 3
    打印(栈弹出());  // 30
    打印(栈弹出());  // 20
    打印(栈大小());  // 1

    // ---- 冒泡排序测试 ----
    组大小 = 5;
    设置元素(0, 64);
    设置元素(1, 25);
    设置元素(2, 12);
    设置元素(3, 22);
    设置元素(4, 11);

    冒泡排序(组大小);

    // 打印排序结果
    打印(获取元素(0));   // 11
    打印(获取元素(1));   // 12
    打印(获取元素(2));   // 22
    打印(获取元素(3));   // 25
    打印(获取元素(4));   // 64

    // ---- 线性搜索测试 ----
    变量 位置 = 线性搜索(组大小, 22);
    打印(位置);  // 2（排序后22在索引2）

    位置 = 线性搜索(组大小, 999);
    打印(位置);  // -1（未找到）

    // ---- 二分搜索测试 ----
    位置 = 二分搜索(组大小, 25);
    打印(位置);  // 3

    位置 = 二分搜索(组大小, 999);
    打印(位置);  // -1

    // ---- 选择排序测试 ----
    组大小 = 5;
    设置元素(0, 42);
    设置元素(1, 8);
    设置元素(2, 15);
    设置元素(3, 23);
    设置元素(4, 4);

    选择排序(组大小);

    打印(获取元素(0));  // 4
    打印(获取元素(1));  // 8
    打印(获取元素(2));  // 15
    打印(获取元素(3));  // 23
    打印(获取元素(4));  // 42

    打印(4002);  // 标记：数据结构结束
}
