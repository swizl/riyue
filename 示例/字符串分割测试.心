// 字符串分割与连接测试（8BG）
// 归属：短板补齐计划 §Phase 1 §1.6 文本工具（分割 / 连接 / 段数 / 取段 / 计数子串）
导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串分割测试（8BG）===")打印;

    // ---- 字符串分割到 / 字符串连接数组 ----
    ()创建动态字符串数组 = 段;
    ("a,b,c", ",", 段)字符串分割到 = 数量;
    ("段数:")打印;
    (数量)打印;
    (段)动态字符串数组大小 = 总;
    ("总:")打印;
    (总)打印;
    (段, 数量, "-")字符串连接数组 = 拼;
    ("连接:")打印;
    (拼)打印;

    // ---- 空分隔符：按单字符切分 ----
    ()创建动态字符串数组 = 字符段;
    ("abc", "", 字符段)字符串分割到 = 字符数;
    ("字符数:")打印;
    (字符数)打印;
    (字符段, 字符数, "|")字符串连接数组 = 字符拼;
    ("字符拼:")打印;
    (字符拼)打印;

    // ---- 空文本 + 非空分隔符 → 一段空串 ----
    ()创建动态字符串数组 = 空段;
    ("", ",", 空段)字符串分割到 = 空数;
    ("空段数:")打印;
    (空数)打印;

    // ---- 空段（连续分隔符）----
    ()创建动态字符串数组 = 尾段;
    ("x,,y", ",", 尾段)字符串分割到 = 尾数;
    ("尾段数:")打印;
    (尾数)打印;
    (尾段, 尾数, "|")字符串连接数组 = 尾拼;
    ("尾拼:")打印;
    (尾拼)打印;

    // ---- 多字符分隔符 ----
    ()创建动态字符串数组 = 多段;
    ("1::2::3", "::", 多段)字符串分割到 = 多数;
    ("多段数:")打印;
    (多数)打印;
    (多段, 多数, "/")字符串连接数组 = 多拼;
    ("多拼:")打印;
    (多拼)打印;

    // ---- 字符串分割段数 ----
    ("a,b,c", ",")字符串分割段数 = 段数1;
    ("段数1:")打印;
    (段数1)打印;
    ("abc", "")字符串分割段数 = 段数2;
    ("段数2:")打印;
    (段数2)打印;
    ("", ",")字符串分割段数 = 段数3;
    ("段数3:")打印;
    (段数3)打印;

    // ---- 字符串取分割段 ----
    ("a,b,c", ",", 0)字符串取分割段 = 取0;
    ("取0:")打印;
    (取0)打印;
    ("a,b,c", ",", 2)字符串取分割段 = 取2;
    ("取2:")打印;
    (取2)打印;
    ("a,b,c", ",", 9)字符串取分割段 = 取9;
    ("取9:")打印;
    (取9)打印;
    ("abc", "", 1)字符串取分割段 = 取字1;
    ("取字1:")打印;
    (取字1)打印;

    // ---- 字符串计数子串（非重叠）----
    ("aaaa", "aa")字符串计数子串 = 计1;
    ("计1:")打印;
    (计1)打印;
    ("hello world", "o")字符串计数子串 = 计2;
    ("计2:")打印;
    (计2)打印;
    ("abc", "")字符串计数子串 = 计3;
    ("计3:")打印;
    (计3)打印;

    ("=== 测试完成 ===")打印;
}
