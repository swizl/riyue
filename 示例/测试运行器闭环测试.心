// 测试运行器闭环测试：自动发现 / 套件名 / 过滤 / 编译执行 / 汇总 / 断言点计数
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定）；用例源与产物落在 .gitignore 的 构建/ 下。

导入 "../工具/测试运行器.心";

// 二参拼接
函数 (甲:字符串, 乙:字符串)接("" = 结果:字符串) {
    (甲, 乙)拼接 = 结果;
}

// 写用例源文件（0 = 成功）
函数 (路径:字符串, 内容:字符串)写用例(0 = 结果:整数) {
    (路径, 内容)写入文件 = 结果;
}

函数 主程序 {
    ("=== 测试运行器闭环测试 ===")打印;
    ()测试运行器模块版本 = 模块版;
    ("模块版本:")打印;
    (模块版)打印;

    // 工作目录（构建/ 已在忽略清单中）
    "构建" = 根;
    (根)创建目录 = 根建;
    "构建/.测试运行器" = 目录;
    (目录)创建目录 = 目录建;

    "" = 换行;
    (10)字符 = 换行;

    // 甲：两条断言注释（静态断言点 = 2），正常退出
    "" = 源甲;
    (源甲, "函数 主程序 {")接 = 源甲;
    (源甲, 换行)接 = 源甲;
    (源甲, "    // 断言点一")接 = 源甲;
    (源甲, 换行)接 = 源甲;
    (源甲, "    // 断言点二")接 = 源甲;
    (源甲, 换行)接 = 源甲;
    (源甲, "}")接 = 源甲;
    (源甲, 换行)接 = 源甲;
    (目录, "甲测试.心")测试拼接路径 = 甲路径;
    (甲路径, 源甲)写用例 = 写甲;
    (写甲, 0, "甲用例写入成功")断言等于;

    // 乙：空主体，正常退出
    "" = 源乙;
    (源乙, "函数 主程序 {")接 = 源乙;
    (源乙, 换行)接 = 源乙;
    (源乙, "}")接 = 源乙;
    (源乙, 换行)接 = 源乙;
    (目录, "乙测试.心")测试拼接路径 = 乙路径;
    (乙路径, 源乙)写用例 = 写乙;

    // 丙：名称不以 `测试.心` 结尾 → 不被发现
    "" = 源丙;
    (源丙, "函数 主程序 {")接 = 源丙;
    (源丙, 换行)接 = 源丙;
    (源丙, "}")接 = 源丙;
    (源丙, 换行)接 = 源丙;
    (目录, "丙工具.心")测试拼接路径 = 丙路径;
    (丙路径, 源丙)写用例 = 写丙;

    // 丁：运行期退出码 3 → 计一次失败
    "" = 源丁;
    (源丁, "函数 主程序 {")接 = 源丁;
    (源丁, 换行)接 = 源丁;
    (源丁, "    (3)退出进程;")接 = 源丁;
    (源丁, 换行)接 = 源丁;
    (源丁, "}")接 = 源丁;
    (源丁, 换行)接 = 源丁;
    (目录, "丁测试.心")测试拼接路径 = 丁路径;
    (丁路径, 源丁)写用例 = 写丁;

    // 自动发现：丙被名称规则排除 → 3 个
    ("-- 发现 --")打印;
    (目录)测试发现 = 全部;
    (全部)动态字符串数组大小 = 发现数;
    (发现数, 3, "发现测试源 3 个")断言等于;

    // 过滤：套件名含 甲 → 1 个
    (目录, "甲")测试发现过滤 = (甲表, 甲数);
    (甲数, 1, "过滤命中 1 个")断言等于;

    // 套件名：甲测试.心 → 甲
    ("甲测试.心")测试套件名 = 套件;
    (套件, "甲", "套件名去测试后缀")断言文本等于;

    // 静态断言点：甲用例两条注释 → 2
    (甲路径)测试文件断言数 = 点数;
    (点数, 2, "甲用例断言点 2 个")断言等于;

    // 执行全部：甲/乙 退出 0，丁 退出 3
    ("-- 执行 --")打印;
    (目录, "", "日月.exe", "构建/.tr")测试运行目录 = (通过, 失败, 跳过);
    (通过, 失败, 跳过)测试汇总;
    (通过, 2, "执行通过 2")断言等于;
    (失败, 1, "执行失败 1")断言等于;
    (跳过, 0, "执行无跳过")断言等于;

    // 过滤执行：仅甲命中，其余两个计入跳过
    ("-- 过滤执行 --")打印;
    (目录, "甲", "日月.exe", "构建/.tr甲")测试运行目录 = (通过二, 失败二, 跳过二);
    (通过二, 失败二, 跳过二)测试汇总;
    (通过二, 1, "过滤执行通过 1")断言等于;
    (失败二, 0, "过滤执行失败 0")断言等于;
    (跳过二, 2, "过滤执行跳过 2")断言等于;

    ("---")打印;
    ()测试总结;
    ("=== 测试完成 ===")打印;
}
