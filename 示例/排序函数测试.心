// 排序函数与二分查找测试（8BK）
//
// 导入 标准库/排序.心，验证 8BK 实装的 `数组冒泡排序`/`数组选择排序`/`数组插入排序`/`数组二分查找`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/排序.心";

// 打印整数数组（逐元素一行）
函数 (数组)打印整数数组(空) {
    (数组)动态数组大小 = 个数;
    0 = k;
    当 (k < 个数) {
        (数组, k)动态数组获取 = 元;
        (元)打印;
        k + 1 = k;
    }
}

函数 主程序 {
    ("=== 排序函数测试（8BK）===")打印;

    ("-- 冒泡排序 --")打印;
    ()创建动态数组 = 甲;
    (甲, 5)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 9)动态数组添加;
    (甲, 1)动态数组添加;
    (甲, 5)动态数组添加;
    (甲, 6)动态数组添加;
    (甲)动态数组大小 = 甲数;
    (甲, 甲数)数组冒泡排序;
    (甲)打印整数数组;

    ("-- 选择排序 --")打印;
    ()创建动态数组 = 乙;
    (乙, 3)动态数组添加;
    (乙, 7)动态数组添加;
    (乙, 4)动态数组添加;
    (乙, 1)动态数组添加;
    (乙, 8)动态数组添加;
    (乙)动态数组大小 = 乙数;
    (乙, 乙数)数组选择排序;
    (乙)打印整数数组;

    ("-- 插入排序 --")打印;
    ()创建动态数组 = 丙;
    (丙, 10)动态数组添加;
    (丙, 0)动态数组添加;
    (丙, 5)动态数组添加;
    (丙, 5)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, -3)动态数组添加;
    (丙)动态数组大小 = 丙数;
    (丙, 丙数)数组插入排序;
    (丙)打印整数数组;

    ("-- 二分查找 --")打印;
    ()创建动态数组 = 丁;
    (丁, 1)动态数组添加;
    (丁, 3)动态数组添加;
    (丁, 5)动态数组添加;
    (丁, 7)动态数组添加;
    (丁, 9)动态数组添加;
    (丁, 11)动态数组添加;
    (丁)动态数组大小 = 丁数;
    (丁, 丁数, 7)数组二分查找 = f1;
    (f1)打印;
    (丁, 丁数, 1)数组二分查找 = f2;
    (f2)打印;
    (丁, 丁数, 11)数组二分查找 = f3;
    (f3)打印;
    (丁, 丁数, 4)数组二分查找 = f4;
    (f4)打印;
    (丁, 丁数, 0)数组二分查找 = f5;
    (f5)打印;
    (丁, 丁数, 12)数组二分查找 = f6;
    (f6)打印;

    ("=== 测试完成 ===")打印;
}
