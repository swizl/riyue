// 阶段P4 带参回调增量：FFI 回调带整数参数 —— 类型名「函数1」= C 回调 int (*)(int)
// msvcrt.dll 的 signal：注册 SIGINT(2) 处理函数；raise(2) 同步触发该回调。
外部 函数 "msvcrt.dll" "signal" 注册信号(信号码: 整数, 处理: 函数1)(结果: 整数);
外部 函数 "msvcrt.dll" "raise" 触发信号(信号码: 整数)(结果: 整数);

函数 主程序 {
    ("=== 外部函数带参回调测试 ===")打印;

    入(码: 整数)函数(结果: 整数) {
        ("[回调] 收到信号:")打印;
        (码)打印;
        0 = 结果;
    } = 处理函数;

    (2, 处理函数)注册信号 = 第一次;
    (2, 处理函数)注册信号 = 第二次;
    如果 (第二次 ?= 0) {
        ("重复注册失败")打印;
    } 否则 {
        ("重复注册成功")打印;
    }

    (2)触发信号 = 触发结果;
    如果 (触发结果 ?= 0) {
        ("触发成功")打印;
    } 否则 {
        ("触发失败")打印;
    }

    ("=== 主程序结束 ===")打印;
}
