// 运行时反射：动态调用（`(函数名字符串字面量, 实参...)动态调用` 编译期按名解析）

函数 (甲: 整数, 乙: 整数)两数相加(0 = 结果: 整数) {
    甲 + 乙 = 结果;
}

函数 (值: 整数)平方(0 = 结果: 整数) {
    值 * 值 = 结果;
}

函数 主程序 {
    ("=== 动态调用测试 ===")打印;

    // 用户函数：按名字符串解析为直接调用
    ("两数相加", 3, 4)动态调用 = 和;
    (和)打印;
    ("平方", 5)动态调用 = 平方值;
    (平方值)打印;
    ("两数相加", 10, 20)动态调用 = 和2;
    (和2)打印;

    // 内建函数同样可按名解析
    ("最大值", 3, 9)动态调用 = 最大;
    (最大)打印;
    ("打印", 42)动态调用;

    ("=== 测试完成 ===")打印;
}
