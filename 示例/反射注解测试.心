// 运行时反射：注解消费（注解数量 / 注解名称 / 注解实参）

@序列化("用户")
@版本(2)
函数 (值: 整数)处理(0 = 结果: 整数) {
    值 + 1 = 结果;
}

@无参
函数 空注解函数() {
    ("空注解函数")打印;
}

函数 无注解函数() {
    ("无注解函数")打印;
}

函数 主程序 {
    ("=== 反射注解测试 ===")打印;

    // 两个用户注解：名称与实参按声明序号读取
    ("处理")注解数量 = 数量;
    (数量)打印;

    ("处理", 0)注解名称 = 名0;
    (名0)打印;
    ("处理", 0, 0)注解实参 = 参00;
    (参00)打印;

    ("处理", 1)注解名称 = 名1;
    (名1)打印;
    ("处理", 1, 0)注解实参 = 参10;
    (参10)打印;

    // 无参注解：数量正常，实参越界 → 空串
    ("空注解函数")注解数量 = 空数;
    (空数)打印;
    ("空注解函数", 0)注解名称 = 空名;
    (空名)打印;
    ("空注解函数", 0, 0)注解实参 = 空参;
    ("[" + 空参 + "]")打印;

    // 无注解函数 / 未知函数 / 非字面量函数名 → 0 / 空串
    ("无注解函数")注解数量 = 零数;
    (零数)打印;
    ("不存在的函数")注解数量 = 未知数;
    (未知数)打印;
    ("不存在的函数", 0)注解名称 = 未知名;
    ("[" + 未知名 + "]")打印;
    "处理" = 动态名;
    (动态名)注解数量 = 动态数;
    (动态数)打印;

    ("=== 测试完成 ===")打印;
}
