// 网络层测试（TCP 回环：连接 / 发送 / 接受 / 接收 / 关闭）
// 端口由进程号派生（20000..29999，避开系统临时端口段），保证可重复运行且不与前次 TIME_WAIT 冲突；
// 端口号不打印，故双链（引导.exe / 日月.exe）stdout 仍可逐字节比对。

导入 "标准库/网络.心";

函数 主程序 {
    ("=== 网络测试 ===")打印;

    ()获取进程标识 = 进程号;
    (进程号 % 10000) + 20000 = 端口;

    (端口)TCP监听 = 服务器;
    (服务器 > 0)打印;

    ("127.0.0.1", 端口, "PING")TCP连接发送 = 客户端;
    (客户端 > 0)打印;

    (服务器)TCP接受接收 = (连接, 收到甲);
    (收到甲)打印;

    (连接, "PONG")TCP发送关闭;
    (客户端)TCP接收关闭 = 收到乙;
    (收到乙)打印;

    ("=== 测试完成 ===")打印;
}
