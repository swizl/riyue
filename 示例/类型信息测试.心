// 运行时类型信息（反射）测试：类型名称 / 类型 / 是整数 / 是浮点 / 是字符串 / 是数组

函数 主程序 {
    ("=== 类型信息测试 ===")打印;

    // 类型名称：按表达式类型映射
    (5)类型名称 = n1;
    (n1)打印;
    (3.5)类型名称 = n2;
    (n2)打印;
    ("文本")类型名称 = n3;
    (n3)打印;

    // 类型：按运行时值类型映射
    (5)类型 = t1;
    (t1)打印;
    (3.5)类型 = t2;
    (t2)打印;
    ("文本")类型 = t3;
    (t3)打印;

    // 是X：字面量
    (5)是整数 = i1;
    (i1)打印;
    (5)是浮点 = i2;
    (i2)打印;
    (5)是字符串 = i3;
    (i3)打印;
    (5)是数组 = i4;
    (i4)打印;
    (3.5)是浮点 = i5;
    (i5)打印;
    (3.5)是整数 = i6;
    (i6)打印;
    ("文本")是字符串 = i7;
    (i7)打印;
    ("文本")是整数 = i8;
    (i8)打印;

    // 是X：变量
    5 = vi;
    (vi)类型名称 = v1;
    (v1)打印;
    (vi)是整数 = v2;
    (v2)打印;
    3.5 = vf;
    (vf)类型名称 = v3;
    (v3)打印;
    (vf)是浮点 = v4;
    (v4)打印;
    "文本" = vs;
    (vs)类型名称 = v5;
    (v5)打印;
    (vs)是字符串 = v6;
    (v6)打印;

    ("=== 测试完成 ===")打印;
}
