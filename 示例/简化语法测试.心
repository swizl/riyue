// 简化语法测试

函数 (甲:整数, 乙:整数)加法(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 (变量值:浮点数)平方(0.0 = 结果:浮点数) {
    变量值 * 变量值 = 结果;
}

函数 (msg:字符串)打印消息 {
    (msg)打印;
}

函数 获取默认值(42 = 结果:整数) {
}

函数 主程序 {
    ("=== 简化语法测试 ===")打印;

    (10, 20)加法 = r1;
    (r1)打印;

    (5.0)平方 = r2;
    (r2)打印;

    "你好世界" = msg;
    (msg)打印消息;

    ()获取默认值 = r3;
    (r3)打印;

    ("=== 测试完成 ===")打印;
}
