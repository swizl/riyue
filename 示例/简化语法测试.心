// 简化语法测试

函数 (a:整数, b:整数)加法(0 = 结果:整数) {
    a + b = 结果;
}

函数 (x:浮点数)平方(0.0 = 结果:浮点数) {
    x * x = 结果;
}

函数 (msg:字符串)打印消息 {
    (msg)打印;
}

函数 获取默认值(42 = 结果:整数) {
}

函数 主程序 {
    ("=== 简化语法测试 ===")打印;

    (10, 20)加法 = r1;
    (r1)打印;

    (5.0)平方 = r2;
    (r2)打印;

    "你好世界" = msg;
    (msg)打印消息;

    ()获取默认值 = r3;
    (r3)打印;

    ("=== 测试完成 ===")打印;
}
