// 正则查找 默认值 测试（双链一致）
//
// 说明：导入 标准库/正则.心，其 `正则查找` 的返回值标注为 `(-1 = 结果:整数)`
//   （「返回值标注中的负数默认值」）。未匹配时函数不写 结果，应保留默认 -1。
//   本片补齐宿主链 引导.exe 对此语法的解析（此前报 `返回值后应有')'（行 43，得到 '-'）`，
//   关闭该宿主链/自举链行为分歧。

导入 "标准库/正则.心";

函数 主程序 {
    ("=== 正则查找 默认值 测试 ===")打印;

    // 命中：返回首个匹配起始下标
    ("hello", "ll")正则查找 = 位置1;
    (位置1)打印;

    // 未命中：函数不写 结果，应保留负数默认值 -1
    ("hello", "world")正则查找 = 位置2;
    (位置2)打印;

    // 转义：`\d` 命中首个数字
    ("abc123", "\\d")正则查找 = 位置3;
    (位置3)打印;

    ("=== 测试完成 ===")打印;
}
