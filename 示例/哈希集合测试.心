// 哈希集合测试

导入 "标准库/哈希集合.心";

函数 主程序 {
    ("=== 哈希集合测试 ===")打印;

    哈希集合<整数> { 键: ()创建动态数组, 占用: ()创建动态数组, 容量: 0, 数量: 0 } = s;

    s.初始化(16);

    // 插入 5,3,8,5（末一个 5 应去重）
    s.添加(5);
    s.添加(3);
    s.添加(8);
    s.添加(5);

    ("长度:")打印;
    (s.长度())打印;

    ("包含 5:")打印;
    (s.包含(5))打印;
    ("包含 8:")打印;
    (s.包含(8))打印;
    ("包含 4:")打印;
    (s.包含(4))打印;

    ("=== 测试完成 ===")打印;
}