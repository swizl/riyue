// UDP 字节收发测试（回环：带长度字节缓冲，含 0x00 不被截断）
// 服务器/客户端各自绑定确定端口（端口由进程号派生，避开系统临时端口段），不打印端口
// ⇒ 双链 stdout 可逐字节比对。

导入 "标准库/网络.心";
导入 "标准库/二进制.心";

函数 主程序 {
    ("=== UDP 字节收发测试 ===")打印;

    ()获取进程标识 = 进程号;
    (进程号 % 10000) + 20000 = 端口甲;
    端口甲 + 1 = 端口乙;

    (端口甲)UDP创建绑定 = 服务器;
    (服务器 > 0)打印;
    (端口乙)UDP创建绑定 = 客户端;
    (客户端 > 0)打印;

    // 客户端 → 服务器（含 0x00）：00 01 FF 41 00
    ()创建动态数组 = 发送甲;
    (发送甲, 0)动态数组添加;
    (发送甲, 1)动态数组添加;
    (发送甲, 255)动态数组添加;
    (发送甲, 65)动态数组添加;
    (发送甲, 0)动态数组添加;
    (客户端, "127.0.0.1", 端口甲, 发送甲)UDP发送字节;

    // 服务器接收（逐字节追加进 接收甲），打印字节数与十六进制
    ()创建动态数组 = 接收甲;
    (服务器, 接收甲)UDP接收字节追加 = 收甲数;
    (收甲数)打印;
    (接收甲)二进制转十六进制 = 十六甲;
    (十六甲)打印;

    // 服务器 → 客户端（含 0x00）：DE AD BE EF 00 00
    ()创建动态数组 = 发送乙;
    (发送乙, 222)动态数组添加;
    (发送乙, 173)动态数组添加;
    (发送乙, 190)动态数组添加;
    (发送乙, 239)动态数组添加;
    (发送乙, 0)动态数组添加;
    (发送乙, 0)动态数组添加;
    (服务器, "127.0.0.1", 端口乙, 发送乙)UDP发送字节 = 发乙数;
    (发乙数)打印;

    // 客户端接收
    ()创建动态数组 = 接收乙;
    (客户端, 接收乙)UDP接收字节追加 = 收乙数;
    (收乙数)打印;
    (接收乙)二进制转十六进制 = 十六乙;
    (十六乙)打印;

    ("=== 测试完成 ===")打印;
}
