// 阶段P4 浮点混用增量：FFI 浮点与字符串/整数混用（模式串含 F=双精度）
// 覆盖入口：P_F（atof）、FI_F（ldexp）、PF_I / PIF_I / PFF_I（printf）、PPF_I（sprintf）。
外部 函数 "msvcrt.dll" "atof" 转浮点(文本: 字符串)(结果: 浮点);
外部 函数 "msvcrt.dll" "atof" 缓冲区转浮点(文本: 指针)(结果: 浮点);
外部 函数 "msvcrt.dll" "ldexp" 乘二幂(值: 浮点, 指数: 整数)(结果: 浮点);
外部 函数 "msvcrt.dll" "printf" 打印浮点(格式: 字符串, 值: 浮点)(结果: 整数);
外部 函数 "msvcrt.dll" "printf" 打印整数浮点(格式: 字符串, 数: 整数, 值: 浮点)(结果: 整数);
外部 函数 "msvcrt.dll" "printf" 打印双浮点(格式: 字符串, 甲: 浮点, 乙: 浮点)(结果: 整数);
外部 函数 "msvcrt.dll" "sprintf" 写入浮点(目标: 指针, 格式: 字符串, 值: 浮点)(结果: 整数);
外部 函数 "msvcrt.dll" "malloc" 分配(字节数: 整数)(结果: 指针);

函数 主程序 {
    ("=== 外部函数浮点混用测试 ===")打印;

    ("2.5")转浮点 = 文本值;
    ("atof=%.1f\n", 文本值)打印浮点 = 字节数1;
    (字节数1)打印;

    (2.5, 2)乘二幂 = 放大值;
    ("ldexp=%.1f\n", 放大值)打印浮点 = 字节数2;
    (字节数2)打印;

    ("mix=%d/%.1f\n", 7, 1.5)打印整数浮点 = 字节数3;
    (字节数3)打印;

    ("pair=%.1f,%.1f\n", 1.5, 2.5)打印双浮点 = 字节数4;
    (字节数4)打印;

    (64)分配 = 缓冲;
    (缓冲, "%.2f", 3.14159)写入浮点 = 字节数5;
    (缓冲)缓冲区转浮点 = 缓冲值;
    ("buf=%.2f\n", 缓冲值)打印浮点 = 字节数6;
    (字节数5)打印;
    (字节数6)打印;

    ("=== 测试完成 ===")打印;
}
