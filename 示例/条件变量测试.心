// 阶段10 G11-D：条件变量（等待-通知）与读写锁（多读共享 / 写独占）
//
// 条件变量 / 读写锁句柄均为「整数32 槽号」（0 = 无效）。条件变量须与互斥锁配合：
// 等待时原子释放该锁，被唤醒后重新持有。单线程示例验证句柄、各返回码与
// 「无等待者时唤醒为空操作」；真实等待-通知需另一线程（抢占式调度 / 并行内核），
// 故本例不进入阻塞等待。纯 `.心` + 运行时内建，双链输出应逐字一致。

导入 "标准库/并发.心";

函数 主程序 {
    ("=== 条件变量测试 ===")打印;

    ("-- 创建 --")打印;
    ()创建条件变量 = 条件;
    ("条件变量句柄:")打印;
    (条件)打印;
    ()创建互斥锁 = 锁;
    ("互斥锁句柄:")打印;
    (锁)打印;
    ()创建读写锁 = 读写;
    ("读写锁句柄:")打印;
    (读写)打印;

    ("-- 无等待者唤醒 --")打印;
    (条件)条件变量唤醒 = 唤醒一;
    ("唤醒返回:")打印;
    (唤醒一)打印;
    (条件)条件变量唤醒全部 = 唤醒二;
    ("唤醒全部返回:")打印;
    (唤醒二)打印;

    ("-- 无效 / 未持锁等待 --")打印;
    (0, 0)条件变量等待 = 等待无;
    ("无效条件等待:")打印;
    (等待无)打印;
    (锁, 条件)条件变量等待 = 等待未持;
    ("未持锁等待:")打印;
    (等待未持)打印;
    (0)条件变量唤醒 = 无效唤醒;
    ("无效唤醒:")打印;
    (无效唤醒)打印;
    (0)条件变量唤醒全部 = 无效全部;
    ("无效唤醒全部:")打印;
    (无效全部)打印;

    ("-- 标准库封装 --")打印;
    (条件)条件通知 = 通知一;
    ("条件通知:")打印;
    (通知一)打印;
    (条件)条件通知全部 = 通知二;
    ("条件通知全部:")打印;
    (通知二)打印;
    (锁, 条件)条件等待 = 封装等;
    ("封装等待（未持锁）:")打印;
    (封装等)打印;

    ("-- 读写锁 --")打印;
    (读写)读锁加锁 = 读加;
    ("读锁加锁:")打印;
    (读加)打印;
    (读写)读锁解锁 = 读解;
    ("读锁解锁:")打印;
    (读解)打印;
    (读写)写锁加锁 = 写加;
    ("写锁加锁:")打印;
    (写加)打印;
    (读写)写锁解锁 = 写解;
    ("写锁解锁:")打印;
    (写解)打印;
    (读写)读锁进入 = 读进;
    ("读锁进入:")打印;
    (读进)打印;
    (读写)读锁退出 = 读退;
    ("读锁退出:")打印;
    (读退)打印;
    (读写)写锁进入 = 写进;
    ("写锁进入:")打印;
    (写进)打印;
    (读写)写锁退出 = 写退;
    ("写锁退出:")打印;
    (写退)打印;
    (0)读锁加锁 = 读无;
    ("无效读锁加锁:")打印;
    (读无)打印;
    (0)写锁解锁 = 写无;
    ("无效写锁解锁:")打印;
    (写无)打印;

    ("-- 销毁 --")打印;
    (条件)销毁条件变量 = 销条;
    ("销毁条件变量:")打印;
    (销条)打印;
    (条件)销毁条件变量 = 再销条;
    ("重复销毁条件变量:")打印;
    (再销条)打印;
    (读写)销毁读写锁 = 销读;
    ("销毁读写锁:")打印;
    (销读)打印;
    (锁)销毁互斥锁 = 销锁;
    ("销毁互斥锁:")打印;
    (销锁)打印;
    ()同步存活数 = 存活;
    ("同步对象存活:")打印;
    (存活)打印;

    ("=== 测试完成 ===")打印;
}
