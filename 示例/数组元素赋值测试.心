// 数组元素赋值测试

函数 主程序 {
    ("=== 数组元素赋值测试 ===")打印;

    // 创建数组
    [10, 20, 30, 40, 50] = arr;

    // 打印原始数组
    (arr[0])打印;  // 10
    (arr[1])打印;  // 20
    (arr[2])打印;  // 30

    // 使用新语法赋值：值 = 变量名[索引]
    99 = arr[1];
    (arr[1])打印;  // 99

    77 = arr[3];
    (arr[3])打印;  // 77

    // 使用表达式作为索引
    2 + 1 = idx;
    88 = arr[idx];
    (arr[3])打印;  // 88

    // 使用表达式作为值
    arr[0] + arr[2] = arr[4];
    (arr[4])打印;  // 10 + 30 = 40

    ("=== 测试完成 ===")打印;
}
