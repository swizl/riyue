// 数组元素赋值测试

函数 主程序 {
    打印("=== 数组元素赋值测试 ===");

    // 创建数组
    [10, 20, 30, 40, 50] = arr;

    // 打印原始数组
    打印(arr[0]);  // 10
    打印(arr[1]);  // 20
    打印(arr[2]);  // 30

    // 使用新语法赋值：值 = 变量名[索引]
    99 = arr[1];
    打印(arr[1]);  // 99

    77 = arr[3];
    打印(arr[3]);  // 77

    // 使用表达式作为索引
    2 + 1 = idx;
    88 = arr[idx];
    打印(arr[3]);  // 88

    // 使用表达式作为值
    arr[0] + arr[2] = arr[4];
    打印(arr[4]);  // 10 + 30 = 40

    打印("=== 测试完成 ===");
}
