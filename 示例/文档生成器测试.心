// 阶段P7 续：文档生成器（纯 .心）——文档注释 / Markdown 生成 / 声明索引 / 代码块提取
// 期望：示例/文档生成器测试.期望
导入 "../工具/文档生成器.心";

函数 主程序 {
    ("=== 文档生成器测试 ===")打印;

    // 10 行样例：注释行 / 文档注释 / 函数 / 结构体 / 方法 / 注释内声明 / 枚举 / 代码围栏
    "// 普通注释\n/// 平方映射：对源做平方映射\n函数 (源, 变换:函数)映射平方(0 = 结果:指针)\n结构体 点\n  方法 初始化(容: 整数)\n// 枚举 不算（注释内）\n枚举 颜色\n```\n函数 例(空) { }\n```\n" = 源;

    // 行数与取行（含越界）
    (源)文档行数 = 行数;
    ("行数")打印;
    (行数)打印;
    (源, 0)文档取行 = 行零;
    (行零)打印;
    (源, 9)文档取行 = 行九;
    (行九)打印;
    (源, 99)文档取行 = 越界;
    ("越界")打印;
    (越界)打印;

    // 逐行分类与名称
    (源, 2)文档取行 = 行二;
    (行二)文档行种类 = 种二;
    (种二)打印;
    (行二)文档行名称 = 名二;
    (名二)打印;
    (源, 3)文档取行 = 行三;
    (行三)文档行种类 = 种三;
    (种三)打印;
    (行三)文档行名称 = 名三;
    (名三)打印;
    (源, 4)文档取行 = 行四;
    (行四)文档行种类 = 种四;
    (种四)打印;
    (行四)文档行名称 = 名四;
    (名四)打印;
    (源, 6)文档取行 = 行六;
    (行六)文档行种类 = 种六;
    (种六)打印;
    (行六)文档行名称 = 名六;
    (名六)打印;

    // 注释行不是声明（注释内的 `枚举` 不索引）
    (源, 5)文档取行 = 行五;
    (行五)文档行种类 = 种五;
    (种五)打印;

    // 文档注释文本
    (源, 1)文档取行 = 行一;
    (行一)文档注释文本 = 注一;
    (注一)打印;
    (行一)文档行种类 = 种一;
    (种一)打印;

    // 代码围栏与代码块段数
    (源, 7)文档取行 = 行七;
    (行七)文档行围栏 = 围栏;
    (围栏)打印;
    (源)文档代码块数 = 块数;
    (块数)打印;

    // Markdown 生成（代码围栏内的 `函数 例` 不索引）
    ("--- 标记 ---")打印;
    (源)文档生成标记 = 标记;
    (标记)打印;

    // HTML 生成（与 Markdown 同源扫描；名称 / 注释转义）
    ("--- HTML ---")打印;
    (源)文档生成HTML = 网页;
    (网页)打印;
    ("<甲> & 乙")文档转义HTML = 转义;
    ("--- 转义 ---")打印;
    (转义)打印;

    // 空文本
    "" = 空源;
    (空源)文档行数 = 空行数;
    (空行数)打印;
    (空源)文档生成标记 = 空标记;
    (空标记)打印;
    (空源)文档生成HTML = 空网页;
    (空网页)打印;

    // JSON 生成（单行；与 Markdown / HTML 同源扫描）与 JSON 转义
    ("--- JSON ---")打印;
    (源)文档生成JSON = 接口;
    (接口)打印;
    (空源)文档生成JSON = 空接口;
    (空接口)打印;
    ("引号\" 反斜杠\\ 换行\n")文档转义JSON = 转义JSON;
    ("--- JSON 转义 ---")打印;
    (转义JSON)打印;

    // 本地整数转文本（替代 `标准库/字符串.心` 导入，供统一 CLI 聚合时消解模块键冲突）
    ("--- 整数转字符串 ---")打印;
    (0)文档整数转字符串 = 整零;
    (整零)打印;
    (7)文档整数转字符串 = 整七;
    (整七)打印;
    (1234)文档整数转字符串 = 整千;
    (整千)打印;
    (0 - 42)文档整数转字符串 = 整负;
    (整负)打印;

    // 代码块提取（0 基；围栏行本身不含，正文逐行以换行结尾）
    ("--- 代码块 ---")打印;
    (源, 0)文档代码块 = 块零;
    (块零)打印;
    (源, 1)文档代码块 = 块一;
    (块一)打印;
    (源, 9)文档代码块 = 块越;
    (块越)打印;
    "```\n函数 未闭(空) { }\n" = 未闭源;
    (未闭源, 0)文档代码块 = 未闭块;
    (未闭块)打印;
    (空源, 0)文档代码块 = 空块;
    (空块)打印;

    // 模块版本
    ("--- 模块版本 ---")打印;
    ()文档生成器模块版本 = 版本;
    (版本)打印;
}
