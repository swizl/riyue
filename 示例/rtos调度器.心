// ============================================
// 日月语言示例：模拟RTOS任务调度器
// 展示：数组模拟、状态机、优先级调度
// ============================================

// 任务状态常量
// 0=就绪 1=运行 2=等待 3=完成

// 任务控制块（用变量模拟）
// 每个任务占4个字段：ID, 优先级, 状态, 剩余时间

// 简单数组模拟：用独立变量代替
0 = 变量 任务0优先级; 0 = 变量 任务0状态; 0 = 变量 任务0剩余;
0 = 变量 任务1优先级; 0 = 变量 任务1状态; 0 = 变量 任务1剩余;
0 = 变量 任务2优先级; 0 = 变量 任务2状态; 0 = 变量 任务2剩余;
0 = 变量 任务3优先级; 0 = 变量 任务3状态; 0 = 变量 任务3剩余;
0 = 变量 任务数;

// 初始化任务
函数 (编号, 优先级, 执行时间)初始化任务 {
    如果 (编号 ?= 0) {
        优先级 = 任务0优先级;
        0 = 任务0状态;
        执行时间 = 任务0剩余;
    }
    如果 (编号 ?= 1) {
        优先级 = 任务1优先级;
        0 = 任务1状态;
        执行时间 = 任务1剩余;
    }
    如果 (编号 ?= 2) {
        优先级 = 任务2优先级;
        0 = 任务2状态;
        执行时间 = 任务2剩余;
    }
    如果 (编号 ?= 3) {
        优先级 = 任务3优先级;
        0 = 任务3状态;
        执行时间 = 任务3剩余;
    }
    任务数 + 1 = 任务数;
}

// 获取任务优先级
函数 (编号)获取优先级(0 = 结果:整数) {
    如果 (编号 ?= 0) { 任务0优先级 = 结果; }
    如果 (编号 ?= 1) { 任务1优先级 = 结果; }
    如果 (编号 ?= 2) { 任务2优先级 = 结果; }
    如果 (编号 ?= 3) { 任务3优先级 = 结果; }
}

// 获取任务状态
函数 (编号)获取状态(0 = 结果:整数) {
    如果 (编号 ?= 0) { 任务0状态 = 结果; }
    如果 (编号 ?= 1) { 任务1状态 = 结果; }
    如果 (编号 ?= 2) { 任务2状态 = 结果; }
    如果 (编号 ?= 3) { 任务3状态 = 结果; }
}

// 获取任务剩余时间
函数 (编号)获取剩余(0 = 结果:整数) {
    如果 (编号 ?= 0) { 任务0剩余 = 结果; }
    如果 (编号 ?= 1) { 任务1剩余 = 结果; }
    如果 (编号 ?= 2) { 任务2剩余 = 结果; }
    如果 (编号 ?= 3) { 任务3剩余 = 结果; }
}

// 设置任务状态
函数 (编号, 新状态)设置状态 {
    如果 (编号 ?= 0) { 新状态 = 任务0状态; }
    如果 (编号 ?= 1) { 新状态 = 任务1状态; }
    如果 (编号 ?= 2) { 新状态 = 任务2状态; }
    如果 (编号 ?= 3) { 新状态 = 任务3状态; }
}

// 减少任务剩余时间
函数 (编号)执行时间片 {
    如果 (编号 ?= 0) { 任务0剩余 - 1 = 任务0剩余; }
    如果 (编号 ?= 1) { 任务1剩余 - 1 = 任务1剩余; }
    如果 (编号 ?= 2) { 任务2剩余 - 1 = 任务2剩余; }
    如果 (编号 ?= 3) { 任务3剩余 - 1 = 任务3剩余; }
}

// 找到最高优先级的就绪任务
函数 选择任务(0 = 结果:整数) {
    -1 = 结果;
    -1 = 最高优先级;
    -1 = 选中任务;
    0 = 索引;
    当 (索引 < 任务数) {
        如果 ((索引)获取状态 ?= 0) {
            (索引)获取优先级 = 优先级;
            如果 (优先级 > 最高优先级) {
                优先级 = 最高优先级;
                索引 = 选中任务;
            }
        }
        索引 + 1 = 索引;
    }
    选中任务 = 结果;
}

// 检查是否所有任务完成
函数 全部完成(1 = 结果:整数) {
    0 = 索引;
    当 (索引 < 任务数) {
        如果 ((索引)获取状态 != 3) {
            0 = 结果;
        }
        索引 + 1 = 索引;
    }
}

// 主程序：模拟调度器
函数 主程序 {
    (1001)打印;  // 标记：RTOS调度器开始

    // 初始化4个任务（优先级, 执行时间）
    (0, 3, 4)初始化任务;   // 任务0: 优先级3, 需要4个时间片
    (1, 1, 2)初始化任务;   // 任务1: 优先级1, 需要2个时间片
    (2, 4, 3)初始化任务;   // 任务2: 优先级4, 需要3个时间片
    (3, 2, 5)初始化任务;   // 任务3: 优先级2, 需要5个时间片

    (任务数)打印;  // 4

    // 调度循环
    0 = 时间片;
    当 (()全部完成 ?= 0) {
        ()选择任务 = 当前任务;
        如果 (当前任务 != -1) {
            (当前任务, 1)设置状态;  // 设为运行
            时间片 + 1 = 时间片;

            // 执行一个时间片
            (当前任务)执行时间片;

            // 检查是否完成
            如果 ((当前任务)获取剩余 <= 0) {
                (当前任务, 3)设置状态;  // 设为完成
                (当前任务)打印;  // 打印完成的任务编号
            } 否则 {
                (当前任务, 0)设置状态;  // 回到就绪
            }
        }
    }

    (时间片)打印;  // 总时间片数 = 4+2+3+5 = 14
    (2001)打印;  // 标记：RTOS调度器结束
}
