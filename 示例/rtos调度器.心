// ============================================
// 日月语言示例：模拟RTOS任务调度器
// 展示：数组模拟、状态机、优先级调度
// ============================================

// 任务状态常量
// 0=就绪 1=运行 2=等待 3=完成

// 任务控制块（用变量模拟）
// 每个任务占4个字段：ID, 优先级, 状态, 剩余时间

// 简单数组模拟：用独立变量代替
变量 任务0优先级 = 0;
变量 任务0状态 = 0;
变量 任务0剩余 = 0;
变量 任务1优先级 = 0;
变量 任务1状态 = 0;
变量 任务1剩余 = 0;
变量 任务2优先级 = 0;
变量 任务2状态 = 0;
变量 任务2剩余 = 0;
变量 任务3优先级 = 0;
变量 任务3状态 = 0;
变量 任务3剩余 = 0;
变量 任务数 = 0;

// 初始化任务
函数 初始化任务(编号, 优先级, 执行时间): 空 {
    如果 (编号 ?= 0) {
        任务0优先级 = 优先级;
        任务0状态 = 0;
        任务0剩余 = 执行时间;
    }
    如果 (编号 ?= 1) {
        任务1优先级 = 优先级;
        任务1状态 = 0;
        任务1剩余 = 执行时间;
    }
    如果 (编号 ?= 2) {
        任务2优先级 = 优先级;
        任务2状态 = 0;
        任务2剩余 = 执行时间;
    }
    如果 (编号 ?= 3) {
        任务3优先级 = 优先级;
        任务3状态 = 0;
        任务3剩余 = 执行时间;
    }
    任务数 = 任务数 + 1;
}

// 获取任务优先级
函数 获取优先级(编号): 整数 {
    如果 (编号 ?= 0) { 返回 任务0优先级; }
    如果 (编号 ?= 1) { 返回 任务1优先级; }
    如果 (编号 ?= 2) { 返回 任务2优先级; }
    如果 (编号 ?= 3) { 返回 任务3优先级; }
    返回 0;
}

// 获取任务状态
函数 获取状态(编号): 整数 {
    如果 (编号 ?= 0) { 返回 任务0状态; }
    如果 (编号 ?= 1) { 返回 任务1状态; }
    如果 (编号 ?= 2) { 返回 任务2状态; }
    如果 (编号 ?= 3) { 返回 任务3状态; }
    返回 0;
}

// 获取任务剩余时间
函数 获取剩余(编号): 整数 {
    如果 (编号 ?= 0) { 返回 任务0剩余; }
    如果 (编号 ?= 1) { 返回 任务1剩余; }
    如果 (编号 ?= 2) { 返回 任务2剩余; }
    如果 (编号 ?= 3) { 返回 任务3剩余; }
    返回 0;
}

// 设置任务状态
函数 设置状态(编号, 新状态): 空 {
    如果 (编号 ?= 0) { 任务0状态 = 新状态; }
    如果 (编号 ?= 1) { 任务1状态 = 新状态; }
    如果 (编号 ?= 2) { 任务2状态 = 新状态; }
    如果 (编号 ?= 3) { 任务3状态 = 新状态; }
}

// 减少任务剩余时间
函数 执行时间片(编号): 空 {
    如果 (编号 ?= 0) { 任务0剩余 = 任务0剩余 - 1; }
    如果 (编号 ?= 1) { 任务1剩余 = 任务1剩余 - 1; }
    如果 (编号 ?= 2) { 任务2剩余 = 任务2剩余 - 1; }
    如果 (编号 ?= 3) { 任务3剩余 = 任务3剩余 - 1; }
}

// 找到最高优先级的就绪任务
函数 选择任务(): 整数 {
    变量 最高优先级 = -1;
    变量 选中任务 = -1;
    变量 遍历 = 0;
    当 (遍历 < 任务数) {
        如果 (获取状态(遍历) ?= 0) {
            变量 优先级 = 获取优先级(遍历);
            如果 (优先级 > 最高优先级) {
                最高优先级 = 优先级;
                选中任务 = 遍历;
            }
        }
        遍历 = 遍历 + 1;
    }
    返回 选中任务;
}

// 检查是否所有任务完成
函数 全部完成(): 整数 {
    变量 遍历 = 0;
    当 (遍历 < 任务数) {
        如果 (获取状态(遍历) != 3) {
            返回 0;
        }
        遍历 = 遍历 + 1;
    }
    返回 1;
}

// 主程序：模拟调度器
函数 主程序(): 空 {
    打印(1001);  // 标记：RTOS调度器开始

    // 初始化4个任务（优先级, 执行时间）
    初始化任务(0, 3, 4);   // 任务0: 优先级3, 需要4个时间片
    初始化任务(1, 1, 2);   // 任务1: 优先级1, 需要2个时间片
    初始化任务(2, 4, 3);   // 任务2: 优先级4, 需要3个时间片
    初始化任务(3, 2, 5);   // 任务3: 优先级2, 需要5个时间片

    打印(任务数);  // 4

    // 调度循环
    变量 时间片 = 0;
    当 (全部完成() ?= 0) {
        变量 当前任务 = 选择任务();
        如果 (当前任务 != -1) {
            设置状态(当前任务, 1);  // 设为运行
            时间片 = 时间片 + 1;

            // 执行一个时间片
            执行时间片(当前任务);

            // 检查是否完成
            如果 (获取剩余(当前任务) <= 0) {
                设置状态(当前任务, 3);  // 设为完成
                打印(当前任务);  // 打印完成的任务编号
            } 否则 {
                设置状态(当前任务, 0);  // 回到就绪
            }
        }
    }

    打印(时间片);  // 总时间片数 = 4+2+3+5 = 14
    打印(2001);  // 标记：RTOS调度器结束
}
