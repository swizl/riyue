// 正则类内转义测试（8BC）
//
// 导入 标准库/正则.心，验证字符类内的转义——`[\d]`/`[\w]`/`[\s]` 预定义类与 `[\x]` 字面转义，
// 并与区间量词 `{m,n}`（8BB）组合使用。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/正则.心";

函数 主程序 {
    ("=== 正则类内转义测试（8BC）===")打印;

    ("-- '[\\d]' 数字类 --")打印;
    ("abc123", "[\\d]+")正则匹配 = r1;
    (r1)打印;
    ("abc", "[\\d]+")正则匹配 = r2;
    (r2)打印;
    ("abc123", "[\\d]")正则查找 = r3;
    (r3)打印;

    ("-- '[\\w]' 词字符类 --")打印;
    ("abc_1", "[\\w]+")正则匹配 = r4;
    (r4)打印;
    ("a b", "[\\w]+")正则匹配 = r5;
    (r5)打印;

    ("-- '[\\s]' 空白类 --")打印;
    ("   ", "[\\s]+")正则匹配 = r6;
    (r6)打印;
    ("abc", "[\\s]+")正则匹配 = r7;
    (r7)打印;

    ("-- 混合与否定 --")打印;
    ("abc123", "[a-z\\d]+")正则匹配 = r8;
    (r8)打印;
    ("xby", "[\\dx]")正则匹配 = r9;
    (r9)打印;
    ("xby", "[\\dz]")正则匹配 = r10;
    (r10)打印;
    ("a1", "[^\\d]")正则匹配 = r11;
    (r11)打印;
    ("12", "[^\\d]")正则匹配 = r12;
    (r12)打印;

    ("-- '[\\x]' 字面转义 --")打印;
    ("a.b", "[\\w\\.]+")正则匹配 = r13;
    (r13)打印;
    ("ab", "[\\w\\.]+")正则匹配 = r14;
    (r14)打印;

    ("-- 与区间量词组合 --")打印;
    ("123", "[\\d]{3}")正则匹配 = r15;
    (r15)打印;
    ("12", "[\\d]{3}")正则匹配 = r16;
    (r16)打印;

    ("=== 测试完成 ===")打印;
}
