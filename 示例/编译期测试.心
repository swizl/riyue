// 8AK 元编程：编译期常量函数（const fn）——双链一致回归
// 语义：调用点实参全为「编译期可求值」的整数常量时，编译期折叠为整数常量；
//       任一构造不可解释（如实参为变量）则整体放弃、回落为普通运行期调用，结果一致。

编译期 函数 (a:整数, b:整数)加(0 = 结果:整数) {
    a + b = 结果;
}

编译期 函数 (n:整数)平方(0 = 结果:整数) {
    n * n = 结果;
}

// 嵌套编译期调用：四次方(n) = 平方(平方(n))
编译期 函数 (n:整数)四次方(0 = 结果:整数) {
    (n)平方 = 中间;
    (中间)平方 = 结果;
}

// 当循环 + 累乘
编译期 函数 (n:整数)阶乘(0 = 结果:整数) {
    0 = 循环i;
    1 = 累;
    当 (循环i < n) {
        循环i + 1 = 循环i;
        累 * 循环i = 累;
    }
    累 = 结果;
}

// 比较 + 如果分支
编译期 函数 (a:整数, b:整数)较大(0 = 结果:整数) {
    a = 结果;
    如果 (b > a) {
        b = 结果;
    }
}

函数 主程序 {
    (3, 4)加 = 和;
    (和)打印;
    (6)平方 = 平;
    (平)打印;
    (3)四次方 = 四;
    (四)打印;
    (5)阶乘 = 阶;
    (阶)打印;
    (8, 3)较大 = 大;
    (大)打印;
    (1 + 2)平方 = 常量表达式;
    (常量表达式)打印;
    (6)平方 = 非折叠源;
    (非折叠源)平方 = 回落;
    (回落)打印;
}
