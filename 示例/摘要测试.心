// 摘要测试（MD5 / SHA-1 / SHA-256 / HMAC-SHA-256 已知向量）
导入 "标准库/摘要.心";
函数 主程序 {
    ("=== MD5 摘要测试 ===")打印;
    ("")MD5 = 甲;
    (甲)打印;
    ("abc")MD5 = 乙;
    (乙)打印;
    ("message digest")MD5 = 丙;
    (丙)打印;
    ("abcdefghijklmnopqrstuvwxyz")MD5 = 丁;
    (丁)打印;
    ("=== SHA-1 摘要测试 ===")打印;
    ("")SHA1 = 甲;
    (甲)打印;
    ("abc")SHA1 = 乙;
    (乙)打印;
    ("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")SHA1 = 丙;
    (丙)打印;
    ("=== SHA-256 摘要测试 ===")打印;
    ("")SHA256 = 甲;
    (甲)打印;
    ("abc")SHA256 = 乙;
    (乙)打印;
    ("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")SHA256 = 丙;
    (丙)打印;
    ("=== HMAC-SHA-256 测试 ===")打印;
    ("Jefe", "what do ya want for nothing?")HMACSHA256 = 甲;
    (甲)打印;
    "" = 长键;
    0 = 甲序;
    当 (甲序 < 80) {
        (107)字符 = 键单;
        (长键, 键单)拼接 = 长键;
        甲序 + 1 = 甲序;
    }
    "" = 长消;
    0 = 乙序;
    当 (乙序 < 100) {
        (65)字符 = 消单;
        (长消, 消单)拼接 = 长消;
        乙序 + 1 = 乙序;
    }
    (长键, 长消)HMACSHA256 = 乙;
    (乙)打印;
    ("=== 测试完成 ===")打印;
}