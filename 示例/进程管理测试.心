// 进程管理 测试：创建 / 等待 / 退出（双链一致）
//
// 说明：直接使用内建 `获取进程标识()` / `创建进程(命令)` / `等待进程(标识)` / `退出进程(码)`，
//   不导入 所有.心（宿主链 引导.exe 尚不能编译 标准库/JSON.心，见 8O 缺口记录）。
// `创建进程` 经平台命令解释器异步执行命令、返回子进程标识；
// `等待进程` 阻塞至其结束并返回退出码；`退出进程` 立即结束当前进程。

函数 主程序 {
    ("=== 进程管理 测试 ===")打印;

    ("-- 当前进程标识有效")打印;
    0 = 标识有效;
    ()获取进程标识 = 自身标识;
    如果 (自身标识 > 0) { 1 = 标识有效; }
    (标识有效)打印;

    ("-- 创建并等待子进程（退出码 5）")打印;
    0 = 子一成立;
    ("exit 5")创建进程 = 子一;
    如果 (子一 > 0) { 1 = 子一成立; }
    (子一成立)打印;
    (子一)等待进程 = 码一;
    (码一)打印;

    ("-- 创建并等待子进程（退出码 0）")打印;
    ("exit 0")创建进程 = 子二;
    (子二)等待进程 = 码二;
    (码二)打印;

    ("-- 退出当前进程")打印;
    ("（退出前最后一行）")打印;
    (0)退出进程;
    ("（不应出现）")打印;
}
