// 测试运行器示例

导入 "../标准库/测试框架.心";

函数 主程序 {
    ("=== 测试运行器示例 ===")打印;
    ("")打印;

    ("基础测试:")打印;
    (1 + 1, 2, "加法测试")断言等于;
    (10 - 5, 5, "减法测试")断言等于;
    (3 * 4, 12, "乘法测试")断言等于;
    (20 / 4, 5, "除法测试")断言等于;

    ("")打印;
    ("条件测试:")打印;
    (1, "真值测试")断言;
    (1, "另一个真值测试")断言;

    ("")打印;
    ("---")打印;
    ("测试结果: ")打印;
    (测试通过数)打印;
    (" 通过, ")打印;
    (测试失败数)打印;
    (" 失败")打印;
}
