// 字符串续增测试（8BO）
//
// 导入 标准库/字符串.心，验证 8BO 新增的 `字符串替换全部`/`字符串删除全部`/`字符串首字母大写`/`字符串包含任意`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串续增测试（8BO）===")打印;

    ("-- 字符串替换全部 --")打印;
    ("a-b-c", "-", "+")字符串替换全部 = r1;
    ("r1:")打印;
    (r1)打印;
    ("aaa", "aa", "b")字符串替换全部 = r2;
    ("r2:")打印;
    (r2)打印;
    ("hello", "x", "y")字符串替换全部 = r3;
    ("r3:")打印;
    (r3)打印;
    ("abc", "", "z")字符串替换全部 = r4;
    ("r4:")打印;
    (r4)打印;

    ("-- 字符串删除全部 --")打印;
    ("banana", "na")字符串删除全部 = d1;
    ("d1:")打印;
    (d1)打印;
    ("abc", "z")字符串删除全部 = d2;
    ("d2:")打印;
    (d2)打印;

    ("-- 字符串首字母大写 --")打印;
    ("hello")字符串首字母大写 = c1;
    ("c1:")打印;
    (c1)打印;
    ("world")字符串首字母大写 = c2;
    ("c2:")打印;
    (c2)打印;
    ("")字符串首字母大写 = c3;
    ("c3:")打印;
    (c3)打印;
    ("123abc")字符串首字母大写 = c4;
    ("c4:")打印;
    (c4)打印;

    ("-- 字符串包含任意 --")打印;
    ()创建动态字符串数组 = 表;
    (表, "xyz")动态字符串数组添加;
    (表, "world")动态字符串数组添加;
    ("hello world", 表, 2)字符串包含任意 = a1;
    ("a1:")打印;
    (a1)打印;
    ()创建动态字符串数组 = 表2;
    (表2, "xyz")动态字符串数组添加;
    (表2, "abc")动态字符串数组添加;
    ("hello world", 表2, 2)字符串包含任意 = a2;
    ("a2:")打印;
    (a2)打印;
    ("hello", 表2, 0)字符串包含任意 = a3;
    ("a3:")打印;
    (a3)打印;

    ("=== 测试完成 ===")打印;
}
