// 泛型结构体测试（阶段4C1）：同一结构体按类型实参单态化。
结构体 对<A, B> {
    甲: A;
    乙: B;
}

结构体 盒子<T> {
    值: T;
}

函数 主程序 {
    ("=== 泛型结构体测试 ===")打印;

    对<整数, 字符串> { 甲: 3, 乙: "hi" } = p;
    ("甲:")打印;
    (p.甲)打印;
    ("乙:")打印;
    (p.乙)打印;

    盒子<整数> { 值: 42 } = b;
    ("盒值:")打印;
    (b.值)打印;

    ("=== 测试完成 ===")打印;
}