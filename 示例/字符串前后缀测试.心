// 字符串前后缀与截取测试（8CD）
//
// 导入 标准库/字符串.心，验证 8CD 新增的 `字符串以开头`/`字符串以结尾`/`字符串截取`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/字符串.心";

函数 主程序 {
    ("=== 字符串前后缀与截取测试（8CD）===")打印;

    // ---- 字符串以开头 ----
    ("-- 字符串以开头 --")打印;
    ("hello world", "hello")字符串以开头 = p1;
    ("hello world ~ hello:")打印;
    (p1)打印;
    ("hello world", "world")字符串以开头 = p2;
    ("hello world ~ world:")打印;
    (p2)打印;
    ("hello", "helloo")字符串以开头 = p3;
    ("hello ~ helloo:")打印;
    (p3)打印;
    ("hello", "")字符串以开头 = p4;
    ("hello ~ empty:")打印;
    (p4)打印;
    ("", "")字符串以开头 = p5;
    ("empty ~ empty:")打印;
    (p5)打印;
    ("", "a")字符串以开头 = p6;
    ("empty ~ a:")打印;
    (p6)打印;

    // ---- 字符串以结尾 ----
    ("-- 字符串以结尾 --")打印;
    ("hello world", "world")字符串以结尾 = s1;
    ("hello world ~ world:")打印;
    (s1)打印;
    ("hello world", "hello")字符串以结尾 = s2;
    ("hello world ~ hello:")打印;
    (s2)打印;
    ("hello", "llo")字符串以结尾 = s3;
    ("hello ~ llo:")打印;
    (s3)打印;
    ("hello", "o")字符串以结尾 = s4;
    ("hello ~ o:")打印;
    (s4)打印;
    ("hello", "")字符串以结尾 = s5;
    ("hello ~ empty:")打印;
    (s5)打印;
    ("hi", "hello")字符串以结尾 = s6;
    ("hi ~ hello:")打印;
    (s6)打印;

    // ---- 字符串截取 ----
    ("-- 字符串截取 --")打印;
    ("hello world", 0, 5)字符串截取 = c1;
    ("[0,5):")打印;
    (c1)打印;
    ("hello world", 6, 5)字符串截取 = c2;
    ("[6,5):")打印;
    (c2)打印;
    ("hello world", 6, 100)字符串截取 = c3;
    ("[6,100):")打印;
    (c3)打印;
    ("hello world", 6, 0)字符串截取 = c4;
    ("[6,0):")打印;
    (c4)打印;
    ("hello", 0, 100)字符串截取 = c5;
    ("hello[0,100):")打印;
    (c5)打印;
    ("hello", 100, 5)字符串截取 = c6;
    ("hello[100,5):")打印;
    (c6)打印;
    ("hello", 0 - 3, 3)字符串截取 = c7;
    ("hello[-3,3):")打印;
    (c7)打印;
    ("hello", 2, 0 - 1)字符串截取 = c8;
    ("hello[2,-1):")打印;
    (c8)打印;

    ("=== 测试完成 ===")打印;
}
