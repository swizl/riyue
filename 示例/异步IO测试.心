// 异步IO与协程集成测试
// 测试协程中使用异步文件操作

函数 主 {
    ("=== 异步IO + 协程集成测试 ===")打印;
    ("")打印;

    // 测试1: 异步写入文件
    ("[测试1] 异步写入文件")打印;
    ("test_data.txt", "Hello from async IO!")异步写入文件 = 写入任务;
    (写入任务)等待IO完成 = 写入完成;
    如果 (写入完成) {
        ("  写入完成")打印;
    }

    // 测试2: 异步读取文件
    ("[测试2] 异步读取文件")打印;
    ("test_data.txt")异步读取文件 = 读取任务;
    (读取任务)等待IO完成 = 读取完成;
    如果 (读取完成) {
        ("  读取完成")打印;
    }
    (读取任务)IO获取读取结果 = 读取内容;
    ("  内容: ")打印;
    (读取内容)打印;

    // 测试3: 多个异步任务
    ("[测试3] 多个异步任务")打印;
    ("file1.txt", "内容1")异步写入文件 = 任务1;
    ("file2.txt", "内容2")异步写入文件 = 任务2;
    ("file3.txt", "内容3")异步写入文件 = 任务3;
    (任务1)等待IO完成;
    (任务2)等待IO完成;
    (任务3)等待IO完成;
    ("  所有任务完成")打印;

    // 测试4: 读取多个文件
    ("[测试4] 读取多个文件")打印;
    ("file1.txt")异步读取文件 = 读1;
    ("file2.txt")异步读取文件 = 读2;
    (读1)等待IO完成;
    (读2)等待IO完成;
    (读1)IO获取读取结果 = 内容1;
    (读2)IO获取读取结果 = 内容2;
    ("  file1: ")打印;
    (内容1)打印;
    ("  file2: ")打印;
    (内容2)打印;

    // 测试5: 异步IO等待
    ("[测试5] 异步IO等待")打印;
    ("test_data.txt")异步读取文件 = 等待任务;
    (等待任务)异步IO等待 = 等待内容;
    ("  等待结果: ")打印;
    (等待内容)打印;

    // 测试6: 网络操作
    ("[测试6] TCP客户端")打印;
    ()创建TCP客户端 = tcp_sock;
    ("  TCP套接字: ")打印;
    (tcp_sock)打印;
    (tcp_sock)TCP关闭;
    ("  已关闭")打印;

    ("")打印;
    ("=== 所有测试通过 ===")打印;
}
