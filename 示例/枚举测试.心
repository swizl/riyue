// 枚举测试

枚举 颜色 {
    红,
    绿,
    蓝
}

枚举 星期 {
    周一,
    周二,
    周三,
    周四,
    周五,
    周六,
    周日
}

函数 主程序 {
    ("=== 枚举测试 ===")打印;

    颜色::蓝 = 最爱颜色;
    (最爱颜色)打印;

    星期::周三 = 今天;
    (今天)打印;

    匹配 (最爱颜色) {
        颜色::红 => { ("红色")打印; }
        颜色::绿 => { ("绿色")打印; }
        颜色::蓝 => { ("蓝色")打印; }
        _ => { ("未知")打印; }
    }

    如果 (今天 ?= 星期::周六 || 今天 ?= 星期::周日) {
        ("周末")打印;
    } 否则 {
        ("工作日")打印;
    }

    ("=== 测试完成 ===")打印;
}
