// 枚举类型示例

枚举 颜色 {
    红,
    绿,
    蓝
}

枚举 星期 {
    周一,
    周二,
    周三,
    周四,
    周五,
    周六,
    周日
}

函数 主程序(): 空 {
    // 使用枚举值
    变量 最爱颜色 = 颜色::蓝;
    打印(最爱颜色);  // 输出: 2

    变量 今天 = 星期::周三;
    打印(今天);  // 输出: 2

    // 在匹配语句中使用枚举
    匹配 (最爱颜色) {
        颜色::红 => { 打印("红色"); }
        颜色::绿 => { 打印("绿色"); }
        颜色::蓝 => { 打印("蓝色"); }
        _ => { 打印("未知"); }
    }

    // 在条件语句中使用枚举
    如果 (今天 ?= 星期::周六 || 今天 ?= 星期::周日) {
        打印("周末");
    } 否则 {
        打印("工作日");
    }

    // 枚举值比较
    变量 c1 = 颜色::红;
    变量 c2 = 颜色::蓝;
    如果 (c1 ?= c2) {
        打印("颜色相同");
    } 否则 {
        打印("颜色不同");
    }
}
