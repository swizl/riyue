// 匿名函数测试

函数 (f:函数, 变量值:整数)应用(0 = 结果:整数) {
    (变量值)f = 结果;
}

函数 主程序 {
    ("=== 匿名函数测试 ===")打印;

    入(甲:整数, 乙:整数)函数(0 = 结果:整数) {
        甲 + 乙 = 结果;
    } = 加法;
    (3, 4)加法 = r1;
    (r1)打印;

    入()函数(42 = 结果:整数) {
    } = 获取时间;
    ()获取时间 = r2;
    (r2)打印;

    入(变量值:整数)函数(0 = 结果:整数) {
        变量值 * 变量值 = 结果;
    } = 平方;
    (平方, 5)应用 = r3;
    (r3)打印;

    // 立即执行：入(入参表){语句… 结果表达式} 不产生函数对象，直接执行并取整块的值
    入(3, 4) { 参数1 + 参数2 } = r4;
    (r4)打印;

    5 = 次数;
    入(次数) {
        次数 * 次数 = 平方值;
        平方值 + 1
    } = r5;
    (r5)打印;

    ("=== 测试完成 ===")打印;
}
