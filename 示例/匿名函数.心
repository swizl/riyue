// 匿名函数测试
函数 主程序(): 空 {
    // 基本匿名函数：平方
    变量 平方 = 函数(数): 整数 { 返回 数 * 数; };
    打印(平方(5));   // 25
    打印(平方(9));   // 81

    // 无参匿名函数
    变量 获取十 = 函数(): 整数 { 返回 10; };
    打印(获取十());   // 10

    // 多参数匿名函数
    变量 加法 = 函数(甲, 乙): 整数 { 返回 甲 + 乙; };
    打印(加法(3, 4));  // 7

    // 用于当循环条件
    变量 是正数 = 函数(数): 整数 { 如果 (数 > 0) { 返回 1; } 返回 0; };
    打印(是正数(42));  // 1
    打印(是正数(-5));  // 0

    // 用匿名函数做排序比较
    变量 数组 = [64, 25, 12, 22, 11];
    变量 比较 = 函数(甲, 乙): 整数 { 如果 (甲 > 乙) { 返回 1; } 返回 0; };
    变量 外层 = 0;
    当 (外层 < 4) {
        变量 内层 = 0;
        当 (内层 < 4 - 外层) {
            如果 (比较(数组[内层], 数组[内层 + 1]) ?= 1) {
                变量 临时 = 数组[内层];
                数组[内层] = 数组[内层 + 1];
                数组[内层 + 1] = 临时;
            }
            内层 = 内层 + 1;
        }
        外层 = 外层 + 1;
    }
    打印(数组[0]);  // 11
    打印(数组[4]);  // 64
}
