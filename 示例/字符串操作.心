// 字符串操作测试
函数 主程序(): 空 {
    打印("=== 字符串操作测试 ===");

    // 字符串长度
    变量 文本 = "你好世界";
    打印("字符串长度:");
    打印(长度(文本));

    // 字符串拼接
    变量 拼接结果 = 拼接("你好", "世界");
    打印("拼接结果:");
    打印(拼接结果);

    // 数字转字符串
    变量 数字文本 = 转字符串(42);
    打印("数字转字符串:");
    打印(数字文本);

    // 浮点数转字符串
    变量 浮点文本 = 转字符串(3.14);
    打印("浮点转字符串:");
    打印(浮点文本);

    // 字符串拼接数字
    变量 消息 = 拼接("答案是: ", 转字符串(42));
    打印("拼接消息:");
    打印(消息);

    打印("=== 测试完成 ===");
}
