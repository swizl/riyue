// 字符串操作测试

函数 主程序 {
    ("=== 字符串操作测试 ===")打印;

    "你好世界" = 文本;
    ("字符串长度:")打印;
    (文本)长度 = len;
    (len)打印;

    "你好" + "世界" = 拼接结果;
    ("拼接结果:")打印;
    (拼接结果)打印;

    "Hello" = a;
    "Hello" = b;
    ("字符串比较:")打印;
    (a ?= b)打印;

    "Hello World" = text;
    (text, "World")查找 = pos;
    ("查找位置:")打印;
    (pos)打印;

    ("=== 测试完成 ===")打印;
}
