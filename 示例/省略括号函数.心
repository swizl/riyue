// 省略括号函数：无入参时省略前括号，无返回值时省略后括号

// 无入参、无返回值：前后都省略
函数 打招呼 {
    ("你好")打印;
}

// 无入参、有返回值：仅省略前括号
函数 取数(7 = 结果:整数) {
    7 = 结果;
}

// 有入参、无返回值：仅省略后括号
函数 (值:整数)打印值 {
    (值)打印;
}

// 有入参、有返回值：都不省略（对照）
函数 (甲:整数, 乙:整数)相加(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 主程序 {
    ("=== 省略括号函数 ===")打印;

    ()打招呼;

    ()取数 = 数;
    (数)打印;

    (5)打印值;

    (3, 4)相加 = 和;
    (和)打印;

    ("=== 测试完成 ===")打印;
}