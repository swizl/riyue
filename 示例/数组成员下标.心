// 数组成员 + 链式下标（`a.b[i]`）测试：动态数组、定长数组、泛型数组三种数组成员的链式下标读取。

结构体 盒 {
    数量: 整数;
    数据: 整数[];
}

结构体 盒3 {
    数量: 整数;
    数据: 整数[3];
}

结构体 缓冲<T> {
    数量: 整数;
    数据: T[];
}

函数 主程序 {
    ("=== 数组成员下标测试 ===")打印;

    盒 { 数量: 3, 数据: [10, 20, 30] } = b;
    (b.数据[0])打印;  // 10
    (b.数据[1])打印;  // 20
    (b.数据[2])打印;  // 30

    盒3 { 数量: 3, 数据: [40, 50, 60] } = c;
    (c.数据[0])打印;  // 40
    (c.数据[1])打印;  // 50
    (c.数据[2])打印;  // 60

    缓冲<整数> { 数量: 3, 数据: [70, 80, 90] } = d;
    (d.数据[1])打印;  // 80

    ("=== 测试完成 ===")打印;
}