导入 "标准库/DNS.心";

// 逐元素打印整数数组（每元素一行）
函数 (数组)打印整数数组(空) {
    0 = 个数;
    0 = k;
    0 = 元;
    (数组)动态数组大小 = 个数;
    0 = k;
    当 (k < 个数) {
        (数组, k)动态数组获取 = 元;
        (元)打印;
        k + 1 = k;
    }
}

函数 主程序 {
    ("=== DNS 测试 ===")打印;

    // 1) 构造查询：www.example.com，事务号 0x1234(4660)
    ()创建动态数组 = 查询;
    ("www.example.com", 4660, 查询)构造DNS查询;
    ("查询hex:")打印;
    (查询)DNS转十六进制 = 查询十六;
    (查询十六)打印;

    // 2) 解析：手工构造响应（ANCOUNT=1，A 记录 93.184.216.34）
    ()创建动态数组 = 响应;
    (4660, 响应)DNS写大端16;
    (33152, 响应)DNS写大端16;
    (1, 响应)DNS写大端16;
    (1, 响应)DNS写大端16;
    (0, 响应)DNS写大端16;
    (0, 响应)DNS写大端16;
    ("www.example.com", 响应)DNS写域名;
    (1, 响应)DNS写大端16;
    (1, 响应)DNS写大端16;
    (192, 响应)DNS写字节;
    (12, 响应)DNS写字节;
    (1, 响应)DNS写大端16;
    (1, 响应)DNS写大端16;
    (0, 响应)DNS写大端16;
    (60, 响应)DNS写大端16;
    (4, 响应)DNS写大端16;
    (93, 响应)DNS写字节;
    (184, 响应)DNS写字节;
    (216, 响应)DNS写字节;
    (34, 响应)DNS写字节;
    ("响应hex:")打印;
    (响应)DNS转十六进制 = 响应十六;
    (响应十六)打印;
    ()创建动态数组 = 地址;
    (响应, 地址)解析DNS响应 = 状态;
    ("解析状态:")打印;
    (状态)打印;
    ("地址字节:")打印;
    (地址)打印整数数组;

    // 3) 无答案（ANCOUNT=0）→ 状态 1
    ()创建动态数组 = 空响应;
    (4660, 空响应)DNS写大端16;
    (33152, 空响应)DNS写大端16;
    (1, 空响应)DNS写大端16;
    (0, 空响应)DNS写大端16;
    (0, 空响应)DNS写大端16;
    (0, 空响应)DNS写大端16;
    ("example.com", 空响应)DNS写域名;
    (1, 空响应)DNS写大端16;
    (1, 空响应)DNS写大端16;
    ()创建动态数组 = 地址2;
    (空响应, 地址2)解析DNS响应 = 状态2;
    ("空响应状态:")打印;
    (状态2)打印;

    // 4) 头不足 12 字节 → 状态 2
    ()创建动态数组 = 短响应;
    (1, 短响应)DNS写字节;
    ()创建动态数组 = 地址3;
    (短响应, 地址3)解析DNS响应 = 状态3;
    ("短响应状态:")打印;
    (状态3)打印;

    ("=== 测试完成 ===")打印;
}
