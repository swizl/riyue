// 默认参数测试
函数 问候(名字, 问候语 = "你好"): 空 {
    打印(问候语);
    打印("，");
    打印(名字);
    打印("！");
}

函数 加倍(数值, 倍数 = 2): 整数 {
    返回 数值 * 倍数;
}

函数 主程序(): 空 {
    // 使用默认参数
    问候("世界");
    // 输出: 你好，世界！

    // 覆盖默认参数
    问候("朋友", "嗨");
    // 输出: 嗨，朋友！

    // 使用默认参数
    打印(加倍(5));
    // 输出: 10

    // 覆盖默认参数
    打印(加倍(5, 3));
    // 输出: 15

    打印(加倍(10));
    // 输出: 20

    打印(加倍(10, 4));
    // 输出: 40
}
