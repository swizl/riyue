// 三元运算符和空值合并运算符测试

函数 主程序 {
    ("=== 三元运算符测试 ===")打印;

    // 三元运算符
    10 = x;
    (x > 5) ? 100 : 200 = 结果;
    (结果)打印;  // 100

    3 = y;
    (y > 5) ? 100 : 200 = 结果2;
    (结果2)打印;  // 200

    // 嵌套三元
    7 = z;
    (z > 10) ? 1 : (z > 5) ? 2 : 3 = 结果3;
    (结果3)打印;  // 2

    ("=== 空值合并测试 ===")打印;

    // 空值合并
    0 = a;
    a ?? 42 = b;
    (b)打印;  // 42

    5 = c;
    c ?? 42 = d;
    (d)打印;  // 5

    ("=== 测试完成 ===")打印;
}
