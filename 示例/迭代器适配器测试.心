// 迭代器适配器测试：映射 / 过滤 / 折叠 / 取 / 跳过 / 连接 / 反转 / 计数
导入 "../标准库/迭代器.心";

函数 (数组)打印数组 {
    (数组)动态数组大小 = 数;
    0 = i;
    当 (i < 数) {
        (数组, i)动态数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== 迭代器适配器测试 ===")打印;

    ()创建动态数组 = 数据;
    1 = i;
    当 (i <= 5) {
        (数据, i)动态数组添加;
        i + 1 = i;
    }

    入(值:整数)函数(结果: 整数) {
        值 * 值 = 结果;
    } = 平方;

    入(值:整数)函数(结果: 整数) {
        值 % 2 ?= 0 = 结果;
    } = 是偶数;

    入(甲:整数, 乙:整数)函数(结果: 整数) {
        甲 + 乙 = 结果;
    } = 求和;

    ("-- 映射平方 --")打印;
    (数据, 平方)迭代器映射 = 平方列表;
    (平方列表)打印数组;

    ("-- 过滤偶数 --")打印;
    (数据, 是偶数)迭代器过滤 = 偶数列表;
    (偶数列表)打印数组;

    ("-- 折叠求和 --")打印;
    (数据, 0, 求和)迭代器折叠 = 总和;
    (总和)打印;

    ("-- 取前 2 --")打印;
    (数据, 2)迭代器取 = 前二;
    (前二)打印数组;

    ("-- 跳过 3 --")打印;
    (数据, 3)迭代器跳过 = 后二;
    (后二)打印数组;

    ("-- 连接 --")打印;
    ()创建动态数组 = 左;
    (左, 1)动态数组添加;
    (左, 2)动态数组添加;
    ()创建动态数组 = 右;
    (右, 3)动态数组添加;
    (右, 4)动态数组添加;
    (左, 右)迭代器连接 = 合并列表;
    (合并列表)打印数组;

    ("-- 反转 --")打印;
    (数据)迭代器反转 = 逆序;
    (逆序)打印数组;

    ("-- 计数 --")打印;
    (数据)迭代器计数 = 个数;
    (个数)打印;

    ("-- 链式：平方 → 取 3 → 反转 --")打印;
    (平方列表, 3)迭代器取 = 前三;
    (前三)迭代器反转 = 链式结果;
    (链式结果)打印数组;

    ("=== 测试完成 ===")打印;
}
