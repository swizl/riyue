// 排序测试

函数 主程序 {
    ("=== 排序测试 ===")打印;

    ()创建动态数组 = arr;
    (arr, 64)动态数组添加;
    (arr, 34)动态数组添加;
    (arr, 25)动态数组添加;
    (arr, 12)动态数组添加;
    (arr, 22)动态数组添加;
    (arr, 11)动态数组添加;
    (arr, 90)动态数组添加;
    7 = size;

    ("排序前:")打印;
    循环 (i: 0, size) {
        (arr, i)动态数组获取 = val;
        (val)打印;
    }

    // 内联冒泡排序
    循环 (i: 0, size - 1) {
        循环 (j: 0, size - i - 1) {
            (arr, j)动态数组获取 = val1;
            (arr, j + 1)动态数组获取 = val2;
            如果 (val1 > val2) {
                val1 = temp;
                (arr, j, val2)动态数组设置;
                (arr, j + 1, temp)动态数组设置;
            }
        }
    }

    ("排序后:")打印;
    循环 (i: 0, size) {
        (arr, i)动态数组获取 = val;
        (val)打印;
    }

    ("=== 测试完成 ===")打印;
}
