// ============================================
// 日月语言示例：模拟GUI控件系统
// 展示：状态机、事件处理、布局计算
// ============================================

// 控件类型：0=按钮 1=标签 2=输入框 3=滑块
// 控件状态：0=正常 1=悬停 2=按下 3=禁用

// 模拟控件（每个控件用变量表示）
// 字段：类型, X, Y, 宽, 高, 状态, 值, 可见

变量 控件0类型 = 0; 变量 控件0X = 0; 变量 控件0Y = 0;
变量 控件0宽 = 0; 变量 控件0高 = 0; 变量 控件0状态 = 0;
变量 控件0值 = 0; 变量 控件0可见 = 1;

变量 控件1类型 = 0; 变量 控件1X = 0; 变量 控件1Y = 0;
变量 控件1宽 = 0; 变量 控件1高 = 0; 变量 控件1状态 = 0;
变量 控件1值 = 0; 变量 控件1可见 = 1;

变量 控件2类型 = 0; 变量 控件2X = 0; 变量 控件2Y = 0;
变量 控件2宽 = 0; 变量 控件2高 = 0; 变量 控件2状态 = 0;
变量 控件2值 = 0; 变量 控件2可见 = 1;

变量 控件3类型 = 0; 变量 控件3X = 0; 变量 控件3Y = 0;
变量 控件3宽 = 0; 变量 控件3高 = 0; 变量 控件3状态 = 0;
变量 控件3值 = 0; 变量 控件3可见 = 1;

变量 控件数 = 0;

// 创建控件
函数 创建控件(编号, 类型, 左, 上, 宽, 高): 空 {
    如果 (编号 ?= 0) {
        控件0类型 = 类型; 控件0X = 左; 控件0Y = 上;
        控件0宽 = 宽; 控件0高 = 高; 控件0状态 = 0; 控件0值 = 0; 控件0可见 = 1;
    }
    如果 (编号 ?= 1) {
        控件1类型 = 类型; 控件1X = 左; 控件1Y = 上;
        控件1宽 = 宽; 控件1高 = 高; 控件1状态 = 0; 控件1值 = 0; 控件1可见 = 1;
    }
    如果 (编号 ?= 2) {
        控件2类型 = 类型; 控件2X = 左; 控件2Y = 上;
        控件2宽 = 宽; 控件2高 = 高; 控件2状态 = 0; 控件2值 = 0; 控件2可见 = 1;
    }
    如果 (编号 ?= 3) {
        控件3类型 = 类型; 控件3X = 左; 控件3Y = 上;
        控件3宽 = 宽; 控件3高 = 高; 控件3状态 = 0; 控件3值 = 0; 控件3可见 = 1;
    }
    控件数 = 控件数 + 1;
}

// 获取控件X坐标
函数 获取X(编号): 整数 {
    如果 (编号 ?= 0) { 返回 控件0X; }
    如果 (编号 ?= 1) { 返回 控件1X; }
    如果 (编号 ?= 2) { 返回 控件2X; }
    如果 (编号 ?= 3) { 返回 控件3X; }
    返回 0;
}

// 获取控件Y坐标
函数 获取Y(编号): 整数 {
    如果 (编号 ?= 0) { 返回 控件0Y; }
    如果 (编号 ?= 1) { 返回 控件1Y; }
    如果 (编号 ?= 2) { 返回 控件2Y; }
    如果 (编号 ?= 3) { 返回 控件3Y; }
    返回 0;
}

// 获取控件宽度
函数 获取宽(编号): 整数 {
    如果 (编号 ?= 0) { 返回 控件0宽; }
    如果 (编号 ?= 1) { 返回 控件1宽; }
    如果 (编号 ?= 2) { 返回 控件2宽; }
    如果 (编号 ?= 3) { 返回 控件3宽; }
    返回 0;
}

// 获取控件高度
函数 获取高(编号): 整数 {
    如果 (编号 ?= 0) { 返回 控件0高; }
    如果 (编号 ?= 1) { 返回 控件1高; }
    如果 (编号 ?= 2) { 返回 控件2高; }
    如果 (编号 ?= 3) { 返回 控件3高; }
    返回 0;
}

// 获取控件状态
函数 获取控件状态(编号): 整数 {
    如果 (编号 ?= 0) { 返回 控件0状态; }
    如果 (编号 ?= 1) { 返回 控件1状态; }
    如果 (编号 ?= 2) { 返回 控件2状态; }
    如果 (编号 ?= 3) { 返回 控件3状态; }
    返回 0;
}

// 设置控件状态
函数 设置控件状态(编号, 新状态): 空 {
    如果 (编号 ?= 0) { 控件0状态 = 新状态; }
    如果 (编号 ?= 1) { 控件1状态 = 新状态; }
    如果 (编号 ?= 2) { 控件2状态 = 新状态; }
    如果 (编号 ?= 3) { 控件3状态 = 新状态; }
}

// 获取控件值
函数 获取控件值(编号): 整数 {
    如果 (编号 ?= 0) { 返回 控件0值; }
    如果 (编号 ?= 1) { 返回 控件1值; }
    如果 (编号 ?= 2) { 返回 控件2值; }
    如果 (编号 ?= 3) { 返回 控件3值; }
    返回 0;
}

// 设置控件值
函数 设置控件值(编号, 新值): 空 {
    如果 (编号 ?= 0) { 控件0值 = 新值; }
    如果 (编号 ?= 1) { 控件1值 = 新值; }
    如果 (编号 ?= 2) { 控件2值 = 新值; }
    如果 (编号 ?= 3) { 控件3值 = 新值; }
}

// 碰撞检测：检查点是否在控件内
函数 点在控件内(编号, 点X, 点Y): 整数 {
    变量 左 = 获取X(编号);
    变量 上 = 获取Y(编号);
    变量 右边 = 左 + 获取宽(编号);
    变量 下边 = 上 + 获取高(编号);
    如果 (点X >= 左 && 点X < 右边 && 点Y >= 上 && 点Y < 下边) {
        返回 1;
    }
    返回 0;
}

// 处理鼠标点击事件
函数 处理点击(鼠标X, 鼠标Y): 整数 {
    变量 遍历 = 0;
    当 (遍历 < 控件数) {
        如果 (点在控件内(遍历, 鼠标X, 鼠标Y) ?= 1) {
            // 如果是按钮，切换状态
            如果 (获取控件状态(遍历) != 3) {
                设置控件状态(遍历, 2);  // 设为按下
                设置控件值(遍历, 获取控件值(遍历) + 1);
                返回 遍历;
            }
        }
        遍历 = 遍历 + 1;
    }
    返回 -1;
}

// 布局：垂直排列控件
函数 垂直布局(起始X, 起始Y, 间距): 空 {
    变量 当前Y = 起始Y;
    变量 遍历 = 0;
    当 (遍历 < 控件数) {
        // 更新控件位置（简化：只更新Y坐标）
        如果 (遍历 ?= 0) { 控件0X = 起始X; 控件0Y = 当前Y; }
        如果 (遍历 ?= 1) { 控件1X = 起始X; 控件1Y = 当前Y; }
        如果 (遍历 ?= 2) { 控件2X = 起始X; 控件2Y = 当前Y; }
        如果 (遍历 ?= 3) { 控件3X = 起始X; 控件3Y = 当前Y; }
        当前Y = 当前Y + 获取高(遍历) + 间距;
        遍历 = 遍历 + 1;
    }
}

// 主程序
函数 主程序(): 空 {
    打印(3001);  // 标记：GUI系统开始

    // 创建控件：类型, X, Y, 宽, 高
    创建控件(0, 0, 10, 10, 120, 30);   // 按钮
    创建控件(1, 0, 10, 50, 120, 30);   // 按钮
    创建控件(2, 1, 10, 90, 200, 20);   // 标签
    创建控件(3, 3, 10, 120, 150, 10);  // 滑块

    打印(控件数);  // 4

    // 垂直布局
    垂直布局(20, 20, 15);

    // 打印布局后的位置
    打印(获取Y(0));  // 20
    打印(获取Y(1));  // 65
    打印(获取Y(2));  // 100
    打印(获取Y(3));  // 135

    // 模拟点击事件
    变量 点击结果 = 处理点击(50, 35);  // 点击按钮0
    打印(点击结果);   // 0
    打印(获取控件值(0));  // 1

    点击结果 = 处理点击(50, 35);  // 再次点击按钮0
    打印(点击结果);   // 0
    打印(获取控件值(0));  // 2

    点击结果 = 处理点击(50, 80);  // 点击按钮1
    打印(点击结果);   // 1
    打印(获取控件值(1));  // 1

    // 点击空白区域
    点击结果 = 处理点击(500, 500);
    打印(点击结果);   // -1

    打印(3002);  // 标记：GUI系统结束
}
