// ============================================
// 日月语言示例：模拟GUI控件系统
// 展示：状态机、事件处理、布局计算
// ============================================

// 控件类型：0=按钮 1=标签 2=输入框 3=滑块
// 控件状态：0=正常 1=悬停 2=按下 3=禁用

// 模拟控件（每个控件用变量表示）
// 字段：类型, X, Y, 宽, 高, 状态, 值, 可见

0 = 变量 控件0类型; 0 = 变量 控件0X; 0 = 变量 控件0Y;
0 = 变量 控件0宽; 0 = 变量 控件0高; 0 = 变量 控件0状态;
0 = 变量 控件0值; 1 = 变量 控件0可见;

0 = 变量 控件1类型; 0 = 变量 控件1X; 0 = 变量 控件1Y;
0 = 变量 控件1宽; 0 = 变量 控件1高; 0 = 变量 控件1状态;
0 = 变量 控件1值; 1 = 变量 控件1可见;

0 = 变量 控件2类型; 0 = 变量 控件2X; 0 = 变量 控件2Y;
0 = 变量 控件2宽; 0 = 变量 控件2高; 0 = 变量 控件2状态;
0 = 变量 控件2值; 1 = 变量 控件2可见;

0 = 变量 控件3类型; 0 = 变量 控件3X; 0 = 变量 控件3Y;
0 = 变量 控件3宽; 0 = 变量 控件3高; 0 = 变量 控件3状态;
0 = 变量 控件3值; 1 = 变量 控件3可见;

0 = 变量 控件数;

// 创建控件
函数 (编号, 类型, 左, 上, 宽, 高)创建控件 {
    如果 (编号 ?= 0) {
        类型 = 控件0类型; 左 = 控件0X; 上 = 控件0Y;
        宽 = 控件0宽; 高 = 控件0高; 0 = 控件0状态; 0 = 控件0值; 1 = 控件0可见;
    }
    如果 (编号 ?= 1) {
        类型 = 控件1类型; 左 = 控件1X; 上 = 控件1Y;
        宽 = 控件1宽; 高 = 控件1高; 0 = 控件1状态; 0 = 控件1值; 1 = 控件1可见;
    }
    如果 (编号 ?= 2) {
        类型 = 控件2类型; 左 = 控件2X; 上 = 控件2Y;
        宽 = 控件2宽; 高 = 控件2高; 0 = 控件2状态; 0 = 控件2值; 1 = 控件2可见;
    }
    如果 (编号 ?= 3) {
        类型 = 控件3类型; 左 = 控件3X; 上 = 控件3Y;
        宽 = 控件3宽; 高 = 控件3高; 0 = 控件3状态; 0 = 控件3值; 1 = 控件3可见;
    }
    控件数 + 1 = 控件数;
}

// 获取控件X坐标
函数 (编号)获取X(0 = 结果:整数) {
    如果 (编号 ?= 0) { 控件0X = 结果; }
    如果 (编号 ?= 1) { 控件1X = 结果; }
    如果 (编号 ?= 2) { 控件2X = 结果; }
    如果 (编号 ?= 3) { 控件3X = 结果; }
}

// 获取控件Y坐标
函数 (编号)获取Y(0 = 结果:整数) {
    如果 (编号 ?= 0) { 控件0Y = 结果; }
    如果 (编号 ?= 1) { 控件1Y = 结果; }
    如果 (编号 ?= 2) { 控件2Y = 结果; }
    如果 (编号 ?= 3) { 控件3Y = 结果; }
}

// 获取控件宽度
函数 (编号)获取宽(0 = 结果:整数) {
    如果 (编号 ?= 0) { 控件0宽 = 结果; }
    如果 (编号 ?= 1) { 控件1宽 = 结果; }
    如果 (编号 ?= 2) { 控件2宽 = 结果; }
    如果 (编号 ?= 3) { 控件3宽 = 结果; }
}

// 获取控件高度
函数 (编号)获取高(0 = 结果:整数) {
    如果 (编号 ?= 0) { 控件0高 = 结果; }
    如果 (编号 ?= 1) { 控件1高 = 结果; }
    如果 (编号 ?= 2) { 控件2高 = 结果; }
    如果 (编号 ?= 3) { 控件3高 = 结果; }
}

// 获取控件状态
函数 (编号)获取控件状态(0 = 结果:整数) {
    如果 (编号 ?= 0) { 控件0状态 = 结果; }
    如果 (编号 ?= 1) { 控件1状态 = 结果; }
    如果 (编号 ?= 2) { 控件2状态 = 结果; }
    如果 (编号 ?= 3) { 控件3状态 = 结果; }
}

// 设置控件状态
函数 (编号, 新状态)设置控件状态 {
    如果 (编号 ?= 0) { 新状态 = 控件0状态; }
    如果 (编号 ?= 1) { 新状态 = 控件1状态; }
    如果 (编号 ?= 2) { 新状态 = 控件2状态; }
    如果 (编号 ?= 3) { 新状态 = 控件3状态; }
}

// 获取控件值
函数 (编号)获取控件值(0 = 结果:整数) {
    如果 (编号 ?= 0) { 控件0值 = 结果; }
    如果 (编号 ?= 1) { 控件1值 = 结果; }
    如果 (编号 ?= 2) { 控件2值 = 结果; }
    如果 (编号 ?= 3) { 控件3值 = 结果; }
}

// 设置控件值
函数 (编号, 新值)设置控件值 {
    如果 (编号 ?= 0) { 新值 = 控件0值; }
    如果 (编号 ?= 1) { 新值 = 控件1值; }
    如果 (编号 ?= 2) { 新值 = 控件2值; }
    如果 (编号 ?= 3) { 新值 = 控件3值; }
}

// 碰撞检测：检查点是否在控件内
函数 (编号, 点X, 点Y)点在控件内(0 = 结果:整数) {
    (编号)获取X = 左;
    (编号)获取Y = 上;
    左 + (编号)获取宽 = 右边;
    上 + (编号)获取高 = 下边;
    如果 (点X >= 左 && 点X < 右边 && 点Y >= 上 && 点Y < 下边) {
        1 = 结果;
    }
}

// 处理鼠标点击事件
函数 (鼠标X, 鼠标Y)处理点击(0 = 结果:整数) {
    -1 = 结果;
    0 = 索引;
    当 (索引 < 控件数) {
        如果 ((索引, 鼠标X, 鼠标Y)点在控件内 ?= 1) {
            // 如果是按钮，切换状态
            如果 ((索引)获取控件状态 != 3) {
                (索引, 2)设置控件状态;  // 设为按下
                (索引, (索引)获取控件值 + 1)设置控件值;
                索引 = 结果;
            }
        }
        索引 + 1 = 索引;
    }
}

// 布局：垂直排列控件
函数 (起始X, 起始Y, 间距)垂直布局 {
    起始Y = 当前Y;
    0 = 索引;
    当 (索引 < 控件数) {
        // 更新控件位置（简化：只更新Y坐标）
        如果 (索引 ?= 0) { 起始X = 控件0X; 当前Y = 控件0Y; }
        如果 (索引 ?= 1) { 起始X = 控件1X; 当前Y = 控件1Y; }
        如果 (索引 ?= 2) { 起始X = 控件2X; 当前Y = 控件2Y; }
        如果 (索引 ?= 3) { 起始X = 控件3X; 当前Y = 控件3Y; }
        当前Y + (索引)获取高 + 间距 = 当前Y;
        索引 + 1 = 索引;
    }
}

// 主程序
函数 主程序 {
    (3001)打印;  // 标记：GUI系统开始

    // 创建控件：类型, X, Y, 宽, 高
    (0, 0, 10, 10, 120, 30)创建控件;   // 按钮
    (1, 0, 10, 50, 120, 30)创建控件;   // 按钮
    (2, 1, 10, 90, 200, 20)创建控件;   // 标签
    (3, 3, 10, 120, 150, 10)创建控件;  // 滑块

    (控件数)打印;  // 4

    // 垂直布局
    (20, 20, 15)垂直布局;

    // 打印布局后的位置
    ((0)获取Y)打印;  // 20
    ((1)获取Y)打印;  // 65
    ((2)获取Y)打印;  // 100
    ((3)获取Y)打印;  // 135

    // 模拟点击事件
    (50, 35)处理点击 = 点击结果;  // 点击按钮0
    (点击结果)打印;   // 0
    ((0)获取控件值)打印;  // 1

    (50, 35)处理点击 = 点击结果;  // 再次点击按钮0
    (点击结果)打印;   // 0
    ((0)获取控件值)打印;  // 2

    (50, 80)处理点击 = 点击结果;  // 点击按钮1
    (点击结果)打印;   // 1
    ((1)获取控件值)打印;  // 1

    // 点击空白区域
    (500, 500)处理点击 = 点击结果;
    (点击结果)打印;   // -1

    (3002)打印;  // 标记：GUI系统结束
}
