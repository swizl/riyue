// CSV 模块测试（解析 / 生成，RFC 4180 单记录子集）

导入 "标准库/CSV.心";

// 打印字符串数组：先字段个数一行，再逐字段一行
函数 (字段)打印字段表(空) {
    (字段)动态字符串数组大小 = 数量;
    ("字段数")打印;
    (数量)打印;
    0 = i;
    当 (i < 数量) {
        (字段, i)动态字符串数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

// 打印多记录表：字段个数 + 逐字段，再行数 + 每行字段宽
函数 (字段, 行字段数)打印表(空) {
    (字段)动态字符串数组大小 = 字段数;
    (行字段数)动态数组大小 = 行数;
    ("字段数")打印;
    (字段数)打印;
    0 = i;
    当 (i < 字段数) {
        (字段, i)动态字符串数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
    ("行数")打印;
    (行数)打印;
    0 = i;
    当 (i < 行数) {
        (行字段数, i)动态数组获取 = 本;
        ("行宽")打印;
        (本)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== CSV 测试 ===")打印;

    ("-- 解析 a,b,c")打印;
    ()创建动态字符串数组 = 解析甲;
    ("a,b,c", 解析甲)CSV解析行;
    (解析甲)打印字段表;

    ("-- 解析 引号字段")打印;
    ()创建动态字符串数组 = 解析乙;
    ("\"a,b\",c", 解析乙)CSV解析行;
    (解析乙)打印字段表;

    ("-- 解析 转义引号")打印;
    ()创建动态字符串数组 = 解析丙;
    ("\"he said \"\"hi\"\"\",x", 解析丙)CSV解析行;
    (解析丙)打印字段表;

    ("-- 解析 空字段")打印;
    ()创建动态字符串数组 = 解析丁;
    (",", 解析丁)CSV解析行;
    (解析丁)打印字段表;

    ("-- 生成 普通字段")打印;
    ()创建动态字符串数组 = 生成甲;
    (生成甲, "a")动态字符串数组添加;
    (生成甲, "b")动态字符串数组添加;
    (生成甲, "c")动态字符串数组添加;
    (生成甲)CSV生成行 = 行甲;
    (行甲)打印;

    ("-- 生成 含逗号字段")打印;
    ()创建动态字符串数组 = 生成乙;
    (生成乙, "a,b")动态字符串数组添加;
    (生成乙, "c")动态字符串数组添加;
    (生成乙)CSV生成行 = 行乙;
    (行乙)打印;

    ("-- 生成 含引号字段")打印;
    ()创建动态字符串数组 = 生成丙;
    (生成丙, "he\"llo")动态字符串数组添加;
    (生成丙, "plain")动态字符串数组添加;
    (生成丙)CSV生成行 = 行丙;
    (行丙)打印;

    ("-- 往返 生成→解析")打印;
    ()创建动态字符串数组 = 解析戊;
    (行丙, 解析戊)CSV解析行;
    (解析戊)打印字段表;

    ("-- 多记录 解析")打印;
    ()创建动态字符串数组 = 多字段;
    ()创建动态数组 = 多行宽;
    ("a,b\n\"c,d\",e\n", 多字段, 多行宽)CSV解析文本;
    (多字段, 多行宽)打印表;

    ("-- 引号内换行")打印;
    ()创建动态字符串数组 = 换字段;
    ()创建动态数组 = 换行宽;
    ("\"x\ny\",z", 换字段, 换行宽)CSV解析文本;
    (换字段, 换行宽)打印表;

    ("-- 空文本")打印;
    ()创建动态字符串数组 = 空字段;
    ()创建动态数组 = 空行宽;
    ("", 空字段, 空行宽)CSV解析文本;
    (空字段, 空行宽)打印表;

    ("-- 多记录 生成")打印;
    (多字段, 多行宽)CSV生成文本 = 多文本;
    (多文本)打印;

    ("=== 测试完成 ===")打印;
}
