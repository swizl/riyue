// 断言库测试（8AU：扩展断言 不等于 / 大于 / 小于 / 近似 / 包含；8AW：假 / 区间 / 匹配）

导入 "../标准库/测试框架.心";

函数 主程序 {
    ("=== 断言库测试 ===")打印;

    ("-- 基础断言 --")打印;
    (1, "条件为真")断言;
    (0, "条件为假")断言;

    ("-- 断言等于 --")打印;
    (2 + 2, 4, "2+2=4")断言等于;
    (5, 6, "5=6")断言等于;

    ("-- 断言不等于 --")打印;
    (3, 4, "3 不等于 4")断言不等于;
    (3, 3, "3 不等于 3")断言不等于;

    ("-- 断言大于 --")打印;
    (5, 3, "5 > 3")断言大于;
    (3, 5, "3 > 5")断言大于;

    ("-- 断言小于 --")打印;
    (3, 5, "3 < 5")断言小于;
    (5, 3, "5 < 3")断言小于;

    ("-- 断言近似 --")打印;
    (3.14159, 3.14, 0.01, "3.14159 近似 3.14")断言近似;
    (3.14159, 3.0, 0.01, "3.14159 近似 3.0")断言近似;
    (2.0, 2.5, 0.5, "2.0 近似 2.5（容差 0.5）")断言近似;

    ("-- 断言包含 --")打印;
    ("hello world", "world", "含 world")断言包含;
    ("hello world", "xyz", "含 xyz")断言包含;
    ("日月底层", "底层", "含 底层")断言包含;

    ("-- 断言假（8AW）--")打印;
    (0, "条件为假")断言假;
    (1, "条件为真")断言假;

    ("-- 断言区间（8AW）--")打印;
    (5, 1, 10, "5 在 [1, 10]")断言区间;
    (0, 1, 10, "0 在 [1, 10]")断言区间;
    (11, 1, 10, "11 在 [1, 10]")断言区间;

    ("-- 断言匹配（8AW，正则）--")打印;
    ("abc123", "abc...", "abc123 匹配 abc...")断言匹配;
    ("hello", "h.llo", "hello 匹配 h.llo")断言匹配;
    ("abc", "abcd", "abc 匹配 abcd")断言匹配;

    ("-- 断言文本等于（8BA）--")打印;
    ("abc", "abc", "abc = abc")断言文本等于;
    ("abc", "abd", "abc = abd")断言文本等于;
    ("", "", "空串 = 空串")断言文本等于;
    ("日", "日月", "日 = 日月")断言文本等于;

    ("-- 断言文本开头（8BA）--")打印;
    ("hello world", "hello", "以 hello 开头")断言文本开头;
    ("hello", "world", "以 world 开头")断言文本开头;

    ("-- 断言文本结尾（8BA）--")打印;
    ("hello world", "world", "以 world 结尾")断言文本结尾;
    ("hello", "world", "以 world 结尾")断言文本结尾;

    ("-- 断言整数数组等于（8BA）--")打印;
    ()创建动态数组 = 甲数组;
    (甲数组, 1)动态数组添加;
    (甲数组, 2)动态数组添加;
    (甲数组, 3)动态数组添加;
    ()创建动态数组 = 乙数组;
    (乙数组, 1)动态数组添加;
    (乙数组, 2)动态数组添加;
    (乙数组, 3)动态数组添加;
    (甲数组, 乙数组, "[1,2,3] = [1,2,3]")断言整数数组等于;
    ()创建动态数组 = 短数组;
    (短数组, 1)动态数组添加;
    (短数组, 2)动态数组添加;
    (甲数组, 短数组, "[1,2,3] = [1,2]")断言整数数组等于;

    ("-- 断言字符串数组等于（8BA）--")打印;
    ()创建动态字符串数组 = 甲串数组;
    (甲串数组, "a")动态字符串数组添加;
    (甲串数组, "b")动态字符串数组添加;
    ()创建动态字符串数组 = 乙串数组;
    (乙串数组, "a")动态字符串数组添加;
    (乙串数组, "b")动态字符串数组添加;
    (甲串数组, 乙串数组, "[a,b] = [a,b]")断言字符串数组等于;
    ()创建动态字符串数组 = 丙串数组;
    (丙串数组, "a")动态字符串数组添加;
    (丙串数组, "c")动态字符串数组添加;
    (甲串数组, 丙串数组, "[a,b] = [a,c]")断言字符串数组等于;

    ("-- 断言数组含整数（8BA）--")打印;
    (甲数组, 2, "[1,2,3] 含 2")断言数组含整数;
    (甲数组, 9, "[1,2,3] 含 9")断言数组含整数;

    ("-- 断言数组含文本（8BA）--")打印;
    (甲串数组, "b", "[a,b] 含 b")断言数组含文本;
    (甲串数组, "z", "[a,b] 含 z")断言数组含文本;

    ("-- 断言数组不含整数（8BE）--")打印;
    (甲数组, 9, "[1,2,3] 不含 9")断言数组不含整数;
    (甲数组, 2, "[1,2,3] 不含 2")断言数组不含整数;

    ("-- 断言数组不含文本（8BE）--")打印;
    (甲串数组, "z", "[a,b] 不含 z")断言数组不含文本;
    (甲串数组, "b", "[a,b] 不含 b")断言数组不含文本;

    ("-- 断言整数数组等价（8BE）--")打印;
    ()创建动态数组 = 倒序数组;
    (倒序数组, 3)动态数组添加;
    (倒序数组, 2)动态数组添加;
    (倒序数组, 1)动态数组添加;
    (甲数组, 倒序数组, "[1,2,3] 等价 [3,2,1]")断言整数数组等价;
    (甲数组, 短数组, "[1,2,3] 等价 [1,2]")断言整数数组等价;
    ()创建动态数组 = 重复甲;
    (重复甲, 1)动态数组添加;
    (重复甲, 2)动态数组添加;
    (重复甲, 2)动态数组添加;
    (重复甲, 3)动态数组添加;
    ()创建动态数组 = 重复乙;
    (重复乙, 1)动态数组添加;
    (重复乙, 1)动态数组添加;
    (重复乙, 2)动态数组添加;
    (重复乙, 3)动态数组添加;
    (重复甲, 重复乙, "[1,2,2,3] 等价 [1,1,2,3]（不比较次数）")断言整数数组等价;

    ("=== 测试完成 ===")打印;
    ()测试总结;
}
