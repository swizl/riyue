// 断言库测试（8AU：扩展断言 不等于 / 大于 / 小于 / 近似 / 包含）

导入 "../标准库/测试框架.心";

函数 主程序 {
    ("=== 断言库测试 ===")打印;

    ("-- 基础断言 --")打印;
    (1, "条件为真")断言;
    (0, "条件为假")断言;

    ("-- 断言等于 --")打印;
    (2 + 2, 4, "2+2=4")断言等于;
    (5, 6, "5=6")断言等于;

    ("-- 断言不等于 --")打印;
    (3, 4, "3 不等于 4")断言不等于;
    (3, 3, "3 不等于 3")断言不等于;

    ("-- 断言大于 --")打印;
    (5, 3, "5 > 3")断言大于;
    (3, 5, "3 > 5")断言大于;

    ("-- 断言小于 --")打印;
    (3, 5, "3 < 5")断言小于;
    (5, 3, "5 < 3")断言小于;

    ("-- 断言近似 --")打印;
    (3.14159, 3.14, 0.01, "3.14159 近似 3.14")断言近似;
    (3.14159, 3.0, 0.01, "3.14159 近似 3.0")断言近似;
    (2.0, 2.5, 0.5, "2.0 近似 2.5（容差 0.5）")断言近似;

    ("-- 断言包含 --")打印;
    ("hello world", "world", "含 world")断言包含;
    ("hello world", "xyz", "含 xyz")断言包含;
    ("日月底层", "底层", "含 底层")断言包含;

    ("=== 测试完成 ===")打印;
    ()测试总结;
}
