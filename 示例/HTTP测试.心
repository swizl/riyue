// HTTP 客户端文本层测试（请求构造 / 响应解析 / 取头）

导入 "标准库/HTTP.心";

// 打印字符串数组：先个数一行，再逐元素一行
函数 (表)打印表(空) {
    (表)动态字符串数组大小 = 数量;
    (数量)打印;
    0 = i;
    当 (i < 数量) {
        (表, i)动态字符串数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== HTTP 测试 ===")打印;

    ("-- 构造 GET 请求")打印;
    ()创建动态字符串数组 = 请头;
    (请头, "Accept: */*")动态字符串数组添加;
    (请头, "Cookie: sid=42")动态字符串数组添加;
    ("GET", "/index.html", "example.com", "", 请头)HTTP构造请求 = 请求;
    (请求)长度 = 请求长;
    (请求长)打印;
    (请求, "Host:")查找 = 主机位;
    (主机位)打印;
    (请求, "Content-Length: 0")查找 = 长位;
    (长位)打印;

    ("-- 构造 POST 请求")打印;
    ()创建动态字符串数组 = 帖头;
    (帖头, "Content-Type: application/json")动态字符串数组添加;
    ("POST", "/api", "example.com", "abcde", 帖头)HTTP构造请求 = 帖;
    (帖)长度 = 帖长;
    (帖长)打印;
    (帖, "abcde")查找 = 体位;
    (体位)打印;
    (帖, "Content-Length: 5")查找 = 帖长位;
    (帖长位)打印;

    ("-- 解析 LF 响应")打印;
    ()创建动态字符串数组 = 应头甲;
    ("HTTP/1.1 200 OK\nContent-Type: text/plain\nSet-Cookie: sid=42\nContent-Length: 5\n\nhello", 应头甲)HTTP解析响应 = (状态甲, 体甲);
    (状态甲)打印;
    (应头甲)打印表;
    (体甲)打印;

    ("-- 解析 CRLF 响应")打印;
    (13)字符 = 单字;
    ("", 单字)拼接 = 回车;
    (10)字符 = 单字;
    (回车, 单字)拼接 = 换行;
    ("HTTP/1.0 204 No Content", 换行)拼接 = 段一;
    (段一, "Server: ruiyue")拼接 = 段二;
    (段二, 换行)拼接 = 段三;
    (段三, 换行)拼接 = 响应乙;
    ()创建动态字符串数组 = 应头乙;
    (响应乙, 应头乙)HTTP解析响应 = (状态乙, 体乙);
    (状态乙)打印;
    (应头乙)打印表;
    (体乙)长度 = 体乙长;
    (体乙长)打印;

    ("-- 取头（大小写不敏感）")打印;
    ("content-type", 应头甲)HTTP取头 = 值甲;
    (值甲)打印;
    ("SET-COOKIE", 应头甲)HTTP取头 = 值乙;
    (值乙)打印;
    ("Content-Length", 应头甲)HTTP取头 = 值丙;
    (值丙)打印;
    ("X-Missing", 应头甲)HTTP取头 = 值丁;
    (值丁)长度 = 值丁长;
    (值丁长)打印;

    ("=== 测试完成 ===")打印;
}
