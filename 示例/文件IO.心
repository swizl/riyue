// 文件IO测试

函数 主程序 {
    ("=== 文件IO测试 ===")打印;

    ("构建/测试输出.txt", "w")打开 = 文件;
    
    (文件, "日月编译器文件写入测试\n")写入;
    (文件, "第一行: 100\n")写入;
    (文件, "第二行: 200\n")写入;
    
    (文件)关闭;
    ("写入完成")打印;
    
    ("构建/测试输出.txt")文件存在 = 存在;
    如果 (存在 ?= 1) {
        ("文件存在")打印;
    }
    
    ("构建/测试输出.txt")删除文件;
    ("删除完成")打印;
    
    ("=== 测试完成 ===")打印;
}
