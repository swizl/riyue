// 契约（前置 / 后置 / 不变式）运行期检查测试：命中与违背两路 + 区间 + 计数汇总 + 重置。
// 说明：`契约.心` 的计数为模块级全局，`契约重置` 归零后再次汇总，验证「重置 → 再计数」可用。
导入 "../标准库/契约.心";

函数 主 {
    ("=== 契约测试 ===")打印;

    (1, "参数为正")要求;
    (0, "参数为负")要求;

    (1, "结果非空")确保;
    (0, "结果为空")确保;

    (1, "计数非负")不变式;
    (0, "计数为负")不变式;

    (5, 1, 10, "5 在 [1,10]")要求区间;
    (0, 1, 10, "0 在 [1,10]")要求区间;
    (11, 1, 10, "11 在 [1,10]")要求区间;

    ()契约总结;

    ()契约重置;
    (1, "重置后为真")要求;
    ()契约总结;

    // 8CI 续增：要求正 / 要求非负 / 全通过判定 / 计数取回
    ()契约重置;
    (7, "正数合法")要求正;
    (-3, "负数非法")要求正;
    (0, "零非负")要求非负;
    ()契约是否全通过 = 全通;
    (全通)打印;
    ()创建动态数组 = 计;
    (计, 0)动态数组添加;
    (计, 0)动态数组添加;
    (计)契约计数;
    (计, 0)动态数组获取 = 通过;
    (通过)打印;
    (计, 1)动态数组获取 = 失败;
    (失败)打印;
    ()契约总结;

    // 8CO 续增：要求非空 / 要求相等 / 要求大于 / 通过率
    ()契约重置;
    ("abc", "非空文本")要求非空;
    ("", "空文本")要求非空;
    (5, 5, "相等")要求相等;
    (5, 6, "不等")要求相等;
    (7, 3, "大于")要求大于;
    (3, 7, "不大于")要求大于;
    ()契约通过率 = 通过率;
    (通过率)打印;
    ()契约总结;

    // 8CQ 续增：要求小于 / 要求非正 / 要求为真 / 失败计数
    ()契约重置;
    (3, 7, "小于")要求小于;
    (7, 3, "不小于")要求小于;
    (0, "零非正")要求非正;
    (4, "正数非正")要求非正;
    (1, "真条件")要求为真;
    (0, "假条件")要求为真;
    ()创建动态数组 = 失;
    (失, 0)动态数组添加;
    (失)契约失败计数;
    (失, 0)动态数组获取 = 失数;
    (失数)打印;
    ()契约总结;

    // 8CU 续增：要求大于等于 / 要求小于等于 / 要求非零 / 失败率
    ()契约重置;
    (5, 5, "大于等于")要求大于等于;
    (4, 5, "小于")要求大于等于;
    (3, 7, "小于等于")要求小于等于;
    (7, 3, "不小于等于")要求小于等于;
    (9, "非零")要求非零;
    (0, "零非零")要求非零;
    ()契约失败率 = 失败率;
    (失败率)打印;
    ()契约总结;

    // 8CY 续增：要求偶数 / 要求奇数 / 要求倍数 / 是否全失败
    ()契约重置;
    (4, "偶数")要求偶数;
    (5, "奇数非偶")要求偶数;
    (7, "奇数")要求奇数;
    (8, "偶数非奇")要求奇数;
    (12, 3, "三倍数")要求倍数;
    (10, 3, "非三倍数")要求倍数;
    (10, 0, "基数零")要求倍数;
    ()契约是否全失败 = 全失败;
    (全失败)打印;
    ()契约总结;

    // 8DC 续增：要求负数 / 要求不在区间 / 要求合计为 / 是否存在失败
    ()契约重置;
    (-3, "负数")要求负数;
    (5, "非负数")要求负数;
    (9, 1, 5, "区间外")要求不在区间;
    (3, 1, 5, "区间内")要求不在区间;
    (2, 3, 5, "合计相等")要求合计为;
    (2, 3, 6, "合计不等")要求合计为;
    ()契约是否存在失败 = 存在失败;
    (存在失败)打印;
    ()契约总结;

    // 8DG 续增：要求不等于 / 要求整除 / 要求为假 / 是否检查过
    ()契约重置;
    (3, 4, "不相等")要求不等于;
    (3, 3, "相等")要求不等于;
    (12, 3, "可整除")要求整除;
    (10, 3, "不可整除")要求整除;
    (10, 0, "除数为零")要求整除;
    (0, "假条件")要求为假;
    (1, "真条件")要求为假;
    ()契约是否检查过 = 检查过;
    (检查过)打印;
    ()契约总结;

    // 8DK 续增：要求和不超过 / 要求和至少 / 要求均为正 / 检查总数
    ()契约重置;
    (3, 4, 10, "和未超上限")要求和不超过;
    (7, 5, 10, "和超上限")要求和不超过;
    (3, 4, 5, "和达下限")要求和至少;
    (2, 2, 5, "和未达下限")要求和至少;
    (2, 3, "均为正")要求均为正;
    (2, 0, "含零")要求均为正;
    (-1, 3, "含负")要求均为正;
    ()契约检查总数 = 总数;
    (总数)打印;
    ()契约总结;

    // 8DO 续增：要求差值等于 / 要求最大值为 / 通过减失败 / 是否平衡
    ()契约重置;
    (10, 4, 6, "差为6")要求差值等于;
    (10, 4, 5, "差为5")要求差值等于;
    (9, 3, "甲较大")要求最大值为;
    (3, 9, "甲较小")要求最大值为;
    ()契约通过减失败 = 差数;
    (差数)打印;
    ()契约是否平衡 = 平衡;
    (平衡)打印;
    ()契约总结;

    // 8DS 续增：要求在百分内 / 要求个位为 / 失败减通过 / 通过失败和
    ()契约重置;
    (85, "85在百分内")要求在百分内;
    (120, "120越界")要求在百分内;
    (37, 7, "个位7")要求个位为;
    (37, 3, "个位非3")要求个位为;
    ()契约失败减通过 = 失减通;
    (失减通)打印;
    ()契约通过失败和 = 通过失和;
    (通过失和)打印;
    ()契约总结;

    // 8DW 续增：要求至少为 / 要求至多为 / 要求个位不为 / 差额绝对值
    ()契约重置;
    (5, 1, "≥1")要求至少为;
    (5, 5, "≥5边界")要求至少为;
    (0, 1, "<1")要求至少为;
    (3, 9, "≤9")要求至多为;
    (10, 9, ">9")要求至多为;
    (13, 2, "个位≠2")要求个位不为;
    (13, 3, "个位=3")要求个位不为;
    ()契约差额绝对值 = 差绝;
    (差绝)打印;
    ()契约总结;

    // 8E0 续增：要求个位为偶数 / 要求和为偶数 / 要求至少一正 / 差额符号
    ()契约重置;
    (24, "个位偶")要求个位为偶数;
    (23, "个位奇")要求个位为偶数;
    (2, 4, "和偶")要求和为偶数;
    (2, 3, "和奇")要求和为偶数;
    (5, -1, "至少一正")要求至少一正;
    (11, 3, "至少一正2")要求至少一正;
    (-5, -1, "无正")要求至少一正;
    ()契约差额符号 = 差符;
    (差符)打印;
    ()契约总结;

    // 8E4 续增：要求个位非零 / 要求差为偶数 / 要求最多一正 / 通过乘失败
    ()契约重置;
    (25, "个位非零")要求个位非零;
    (20, "个位零")要求个位非零;
    (6, 2, "差偶")要求差为偶数;
    (6, 3, "差奇")要求差为偶数;
    (3, -4, "至多一正")要求最多一正;
    (3, 4, "两正")要求最多一正;
    ()契约通过乘失败 = 乘结果;
    (乘结果)打印;
    ()契约总结;

    // 8E8 续增：要求个位为零 / 要求和为奇数 / 要求至多一负 / 通过平方
    ()契约重置;
    (20, "个位零")要求个位为零;
    (25, "个位非零")要求个位为零;
    (2, 3, "和奇")要求和为奇数;
    (2, 4, "和偶")要求和为奇数;
    (-1, 3, "至多一负")要求至多一负;
    (-1, -3, "两负")要求至多一负;
    ()契约通过平方 = 平结果;
    (平结果)打印;
    ()契约总结;

    // 8EC 续增：要求恰好一负 / 要求均为负 / 要求个位为奇数 / 失败平方
    ()契约重置;
    (1, -2, "恰好一负")要求恰好一负;
    (-1, -2, "两负")要求恰好一负;
    (-1, -2, "均负")要求均为负;
    (-1, 2, "非均负")要求均为负;
    (7, "个位奇")要求个位为奇数;
    (8, "个位偶")要求个位为奇数;
    ()契约失败平方 = 失平结果;
    (失平结果)打印;
    ()契约总结;

    // 8F0 续增：要求恰好一正 / 要求同为偶 / 要求同为奇 / 契约通过立方
    ()契约重置;
    (1, -2, "恰好一正")要求恰好一正;
    (-1, -2, "非恰好一正")要求恰好一正;
    (2, 4, "同为偶")要求同为偶;
    (3, 4, "非同为偶")要求同为偶;
    (3, 5, "同为奇")要求同为奇;
    (4, 5, "非同为奇")要求同为奇;
    ()契约通过立方 = 立结果;
    (立结果)打印;
    ()契约总结;

    // 8F4 续增：要求至少一偶 / 要求至少一奇 / 要求均非负 / 契约失败立方
    ()契约重置;
    (2, 3, "至少一偶")要求至少一偶;
    (3, 5, "无偶")要求至少一偶;
    (3, 5, "至少一奇")要求至少一奇;
    (2, 4, "无奇")要求至少一奇;
    (0, 5, "均非负")要求均非负;
    (-1, 5, "含负")要求均非负;
    ()契约失败立方 = 失立结果;
    (失立结果)打印;
    ()契约总结;

    // 8F8 续增：要求均非正 / 要求恰好一零 / 要求异号 / 契约失败四次方
    ()契约重置;
    (0, -3, "均非正")要求均非正;
    (0, 3, "含正")要求均非正;
    (0, 5, "恰好一零")要求恰好一零;
    (0, 0, "双零")要求恰好一零;
    (3, -5, "异号")要求异号;
    (3, 5, "同号")要求异号;
    ()契约失败四次方 = 失四结果;
    (失四结果)打印;
    ()契约总结;

    // 8FC 续增：要求至少一零 / 要求均非零 / 要求至多一零 / 契约通过四次方
    ()契约重置;
    (0, 3, "至少一零")要求至少一零;
    (3, 5, "无零")要求至少一零;
    (3, 5, "均非零")要求均非零;
    (3, 0, "含零")要求均非零;
    (3, 0, "至多一零")要求至多一零;
    (0, 0, "双零")要求至多一零;
    ()契约通过四次方 = 通四结果;
    (通四结果)打印;

    // 8G0 续增：要求乘积为 / 要求商为 / 要求个位为五 / 契约通过五次方
    (3, 4, 12, "积12")要求乘积为;
    (3, 4, 11, "积11")要求乘积为;
    (12, 3, 4, "商4")要求商为;
    (12, 0, 0, "除零")要求商为;
    (25, "个位五")要求个位为五;
    (23, "个位三")要求个位为五;
    ()契约通过五次方 = 通五结果;
    (通五结果)打印;
    ()契约总结;

    ("=== 完成 ===")打印;
}
