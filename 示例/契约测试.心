// 契约（前置 / 后置 / 不变式）运行期检查测试：命中与违背两路 + 区间 + 计数汇总 + 重置。
// 说明：`契约.心` 的计数为模块级全局，`契约重置` 归零后再次汇总，验证「重置 → 再计数」可用。
导入 "../标准库/契约.心";

函数 主 {
    ("=== 契约测试 ===")打印;

    (1, "参数为正")要求;
    (0, "参数为负")要求;

    (1, "结果非空")确保;
    (0, "结果为空")确保;

    (1, "计数非负")不变式;
    (0, "计数为负")不变式;

    (5, 1, 10, "5 在 [1,10]")要求区间;
    (0, 1, 10, "0 在 [1,10]")要求区间;
    (11, 1, 10, "11 在 [1,10]")要求区间;

    ()契约总结;

    ()契约重置;
    (1, "重置后为真")要求;
    ()契约总结;

    // 8CI 续增：要求正 / 要求非负 / 全通过判定 / 计数取回
    ()契约重置;
    (7, "正数合法")要求正;
    (-3, "负数非法")要求正;
    (0, "零非负")要求非负;
    ()契约是否全通过 = 全通;
    (全通)打印;
    ()创建动态数组 = 计;
    (计, 0)动态数组添加;
    (计, 0)动态数组添加;
    (计)契约计数;
    (计, 0)动态数组获取 = 通过;
    (通过)打印;
    (计, 1)动态数组获取 = 失败;
    (失败)打印;
    ()契约总结;

    ("=== 完成 ===")打印;
}
