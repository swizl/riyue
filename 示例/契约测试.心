    ()创建动态数组 = 计;
    (计, 0)动态数组添加;
    (计, 0)动态数组添加;
    (计)契约计数;
    (计, 0)动态数组获取 = 通过;
    (通过)打印;
    (计, 1)动态数组获取 = 失败;
    (失败)打印;
    ()契约总结;

    // 8CO 续增：要求非空 / 要求相等 / 要求大于 / 通过率
