// 契约（前置 / 后置 / 不变式）运行期检查测试：命中与违背两路 + 区间 + 计数汇总 + 重置。
// 说明：`契约.心` 的计数为模块级全局，`契约重置` 归零后再次汇总，验证「重置 → 再计数」可用。
导入 "../标准库/契约.心";

函数 主 {
    ("=== 契约测试 ===")打印;

    (1, "参数为正")要求;
    (0, "参数为负")要求;

    (1, "结果非空")确保;
    (0, "结果为空")确保;

    (1, "计数非负")不变式;
    (0, "计数为负")不变式;

    (5, 1, 10, "5 在 [1,10]")要求区间;
    (0, 1, 10, "0 在 [1,10]")要求区间;
    (11, 1, 10, "11 在 [1,10]")要求区间;

    ()契约总结;

    ()契约重置;
    (1, "重置后为真")要求;
    ()契约总结;

    // 8CI 续增：要求正 / 要求非负 / 全通过判定 / 计数取回
    ()契约重置;
    (7, "正数合法")要求正;
    (-3, "负数非法")要求正;
    (0, "零非负")要求非负;
    ()契约是否全通过 = 全通;
    (全通)打印;
    ()创建动态数组 = 计;
    (计, 0)动态数组添加;
    (计, 0)动态数组添加;
    (计)契约计数;
    (计, 0)动态数组获取 = 通过;
    (通过)打印;
    (计, 1)动态数组获取 = 失败;
    (失败)打印;
    ()契约总结;

    // 8CO 续增：要求非空 / 要求相等 / 要求大于 / 通过率
    ()契约重置;
    ("abc", "非空文本")要求非空;
    ("", "空文本")要求非空;
    (5, 5, "相等")要求相等;
    (5, 6, "不等")要求相等;
    (7, 3, "大于")要求大于;
    (3, 7, "不大于")要求大于;
    ()契约通过率 = 通过率;
    (通过率)打印;
    ()契约总结;

    // 8CQ 续增：要求小于 / 要求非正 / 要求为真 / 失败计数
    ()契约重置;
    (3, 7, "小于")要求小于;
    (7, 3, "不小于")要求小于;
    (0, "零非正")要求非正;
    (4, "正数非正")要求非正;
    (1, "真条件")要求为真;
    (0, "假条件")要求为真;
    ()创建动态数组 = 失;
    (失, 0)动态数组添加;
    (失)契约失败计数;
    (失, 0)动态数组获取 = 失数;
    (失数)打印;
    ()契约总结;

    // 8CU 续增：要求大于等于 / 要求小于等于 / 要求非零 / 失败率
    ()契约重置;
    (5, 5, "大于等于")要求大于等于;
    (4, 5, "小于")要求大于等于;
    (3, 7, "小于等于")要求小于等于;
    (7, 3, "不小于等于")要求小于等于;
    (9, "非零")要求非零;
    (0, "零非零")要求非零;
    ()契约失败率 = 失败率;
    (失败率)打印;
    ()契约总结;

    // 8CY 续增：要求偶数 / 要求奇数 / 要求倍数 / 是否全失败
    ()契约重置;
    (4, "偶数")要求偶数;
    (5, "奇数非偶")要求偶数;
    (7, "奇数")要求奇数;
    (8, "偶数非奇")要求奇数;
    (12, 3, "三倍数")要求倍数;
    (10, 3, "非三倍数")要求倍数;
    (10, 0, "基数零")要求倍数;
    ()契约是否全失败 = 全失败;
    (全失败)打印;
    ()契约总结;

    // 8DC 续增：要求负数 / 要求不在区间 / 要求合计为 / 是否存在失败
    ()契约重置;
    (-3, "负数")要求负数;
    (5, "非负数")要求负数;
    (9, 1, 5, "区间外")要求不在区间;
    (3, 1, 5, "区间内")要求不在区间;
    (2, 3, 5, "合计相等")要求合计为;
    (2, 3, 6, "合计不等")要求合计为;
    ()契约是否存在失败 = 存在失败;
    (存在失败)打印;
    ()契约总结;

    // 8DG 续增：要求不等于 / 要求整除 / 要求为假 / 是否检查过
    ()契约重置;
    (3, 4, "不相等")要求不等于;
    (3, 3, "相等")要求不等于;
    (12, 3, "可整除")要求整除;
    (10, 3, "不可整除")要求整除;
    (10, 0, "除数为零")要求整除;
    (0, "假条件")要求为假;
    (1, "真条件")要求为假;
    ()契约是否检查过 = 检查过;
    (检查过)打印;
    ()契约总结;

    ("=== 完成 ===")打印;
}
