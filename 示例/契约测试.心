    ("=== 契约测试 ===")打印;

    (1, "参数为正")要求;
    (0, "参数为负")要求;

    (1, "结果非空")确保;
    (0, "结果为空")确保;

    (1, "计数非负")不变式;
    (0, "计数为负")不变式;

