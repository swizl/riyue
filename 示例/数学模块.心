// 数学模块

函数 (a:整数, b:整数)加法(0 = 结果:整数) {
    结果 = a + b;
}

函数 (x:整数)平方(0 = 结果:整数) {
    结果 = x * x;
}

函数 (x:整数)立方(0 = 结果:整数) {
    结果 = x * x * x;
}

函数 (n:整数)阶乘(1 = 结果:整数) {
    如果 (n <= 1) {
        结果 = 1;
    } 否则 {
        变量 前一个 = n - 1;
        (前一个)阶乘 = 递归结果;
        结果 = n * 递归结果;
    }
}
