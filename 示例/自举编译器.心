// 日月自举编译器 - 子集编译器
// 能编译简单的算术表达式和打印语句，输出C代码

// ===== 全局变量 =====
变量 输入位置 = 0;
变量 输入内容 = "";
变量 当前字符 = 0;

// ===== 词法分析 =====
函数 读取下一个字符(): 空 {
    如果 (输入位置 < 100) {
        当前字符 = 输入位置 + 65;  // 模拟读取字符
        输入位置 = 输入位置 + 1;
    } 否则 {
        当前字符 = 0;
    }
}

函数 跳过空白(): 空 {
    当 (当前字符 ?= 32 || 当前字符 ?= 10 || 当前字符 ?= 13 || 当前字符 ?= 9) {
        读取下一个字符();
    }
}

函数 是数字(字符): 整数 {
    返回 (字符 >= 48 && 字符 <= 57);
}

函数 读取整数(): 整数 {
    变量 值 = 0;
    当 (是数字(当前字符)) {
        值 = 值 * 10 + 当前字符 - 48;
        读取下一个字符();
    }
    返回 值;
}

// ===== 代码生成 =====
函数 生成整数(值): 空 {
    打印(值);
}

函数 生成加法(): 空 {
    打印(" + ");
}

函数 生成减法(): 空 {
    打印(" - ");
}

函数 生成乘法(): 空 {
    打印(" * ");
}

函数 生成除法(): 空 {
    打印(" / ");
}

函数 生成换行(): 空 {
    打印("\n");
}

函数 生成打印语句(值): 空 {
    打印("    printf(\"%d\\n\", ");
    打印(值);
    打印(");");
    生成换行();
}

// ===== 表达式解析 =====
函数 解析表达式(): 整数 {
    变量 左 = 0;
    变量 右 = 0;
    变量 操作 = 0;

    // 读取第一个操作数
    跳过空白();
    如果 (是数字(当前字符)) {
        左 = 读取整数();
    }

    // 读取运算符和第二个操作数
    跳过空白();
    如果 (当前字符 ?= 43) {
        操作 = 1;  // +
        读取下一个字符();
        跳过空白();
        右 = 读取整数();
        返回 左 + 右;
    }
    如果 (当前字符 ?= 45) {
        操作 = 2;  // -
        读取下一个字符();
        跳过空白();
        右 = 读取整数();
        返回 左 - 右;
    }
    如果 (当前字符 ?= 42) {
        操作 = 3;  // *
        读取下一个字符();
        跳过空白();
        右 = 读取整数();
        返回 左 * 右;
    }
    如果 (当前字符 ?= 47) {
        操作 = 4;  // /
        读取下一个字符();
        跳过空白();
        右 = 读取整数();
        如果 (右 != 0) {
            返回 左 / 右;
        }
        返回 0;
    }

    返回 左;
}

// ===== 主编译流程 =====
函数 编译简单表达式(表达式): 整数 {
    打印("编译表达式: ");
    打印(表达式);
    打印("");

    // 输出C代码框架
    打印("// 生成的C代码:");
    打印("#include <stdio.h>");
    打印("int main() {");
    打印("    printf(\"%d\\n\", ");
    打印(表达式);
    打印(");");
    打印("    return 0;");
    打印("}");

    返回 0;
}

函数 验证编译结果(输入, 期望输出): 整数 {
    变量 实际结果 = 解析表达式();
    如果 (实际结果 ?= 期望输出) {
        打印("[通过] 计算正确");
        返回 0;
    } 否则 {
        打印("[失败] 期望 ");
        打印(期望输出);
        打印(" 实际 ");
        打印(实际结果);
        返回 1;
    }
}

函数 阶乘(数): 整数 {
    如果 (数 <= 1) {
        返回 1;
    }
    返回 数 * 阶乘(数 - 1);
}

函数 斐波那契(数): 整数 {
    如果 (数 <= 0) {
        返回 0;
    }
    如果 (数 <= 1) {
        返回 1;
    }
    返回 斐波那契(数 - 1) + 斐波那契(数 - 2);
}

