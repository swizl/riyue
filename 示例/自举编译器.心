// 日月自举编译器 - 子集编译器
// 能编译简单的算术表达式和打印语句，输出C代码

// ===== 全局变量 =====
0 = 变量 输入位置;
"" = 变量 输入内容;
0 = 变量 当前字符;

// ===== 词法分析 =====
函数 读取下一个字符 {
    如果 (输入位置 < 100) {
        输入位置 + 65 = 当前字符;
        输入位置 + 1 = 输入位置;
    } 否则 {
        0 = 当前字符;
    }
}

函数 跳过空白 {
    当 (当前字符 ?= 32 || 当前字符 ?= 10 || 当前字符 ?= 13 || 当前字符 ?= 9) {
        ()读取下一个字符;
    }
}

函数 (字符)是数字(0 = 结果:整数) {
    如果 (字符 >= 48 && 字符 <= 57) {
        1 = 结果;
    } 否则 {
        0 = 结果;
    }
}

函数 读取整数 {
    0 = 值;
    当 ((当前字符)是数字 ?= 1) {
        值 * 10 + 当前字符 - 48 = 值;
        ()读取下一个字符;
    }
    (值)打印;
}

// ===== 代码生成 =====
函数 (值)生成整数 {
    (值)打印;
}

函数 生成加法 {
    (" + ")打印;
}

函数 生成减法 {
    (" - ")打印;
}

函数 生成乘法 {
    (" * ")打印;
}

函数 生成除法 {
    (" / ")打印;
}

函数 生成换行 {
    ("\n")打印;
}

函数 (值)生成打印语句 {
    ("    printf(\"%d\\n\", ")打印;
    (值)打印;
    (");")打印;
    ()生成换行;
}

// ===== 表达式解析 =====
函数 (左, 操作符, 右)执行运算(0 = 结果:整数) {
    如果 (操作符 ?= 1) {
        左 + 右 = 结果;
    }
    如果 (操作符 ?= 2) {
        左 - 右 = 结果;
    }
    如果 (操作符 ?= 3) {
        左 * 右 = 结果;
    }
    如果 (操作符 ?= 4) {
        如果 (右 != 0) {
            左 / 右 = 结果;
        } 否则 {
            0 = 结果;
        }
    }
}

// ===== 主编译流程 =====
函数 (表达式)编译简单表达式(0 = 结果:整数) {
    ("编译表达式: ")打印;
    (表达式)打印;
    ("")打印;

    ("// 生成的C代码:")打印;
    ("#include <stdio.h>")打印;
    ("int main() {")打印;
    ("    printf(\"%d\\n\", ")打印;
    (表达式)打印;
    (");")打印;
    ("    return 0;")打印;
    ("}")打印;

    0 = 结果;
}

函数 (数)阶乘(0 = 结果:整数) {
    如果 (数 <= 1) {
        1 = 结果;
    } 否则 {
        数 - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        数 * 递归结果 = 结果;
    }
}

函数 (数)斐波那契(0 = 结果:整数) {
    如果 (数 <= 0) {
        0 = 结果;
    } 否则如果 (数 <= 1) {
        1 = 结果;
    } 否则 {
        数 - 1 = 前一个;
        数 - 2 = 前两个;
        (前一个)斐波那契 = 前结果;
        (前两个)斐波那契 = 前二结果;
        前结果 + 前二结果 = 结果;
    }
}

