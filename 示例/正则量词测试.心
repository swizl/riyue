// 正则量词测试（8AX）
//
// 导入 标准库/正则.心，验证量词 `*`/`+`/`?`（贪婪 + 回溯）与 `正则查找`（首个匹配下标）。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/正则.心";

函数 主程序 {
    ("=== 正则量词测试（8AX）===")打印;

    ("-- '*'（0+）--")打印;
    ("aaa", "a*")正则匹配 = r1;
    (r1)打印;
    ("bbb", "a*")正则匹配 = r2;
    (r2)打印;
    ("bbb", "a*b")正则匹配 = r3;
    (r3)打印;
    ("bbb", "a+c")正则匹配 = r4;
    (r4)打印;

    ("-- '+'（1+）--")打印;
    ("abc123", "\\d+")正则匹配 = r5;
    (r5)打印;
    ("abc", "\\d+")正则匹配 = r6;
    (r6)打印;
    ("hello", "l+")正则查找 = q1;
    (q1)打印;

    ("-- '?'（0/1）--")打印;
    ("color", "colou?r")正则匹配 = r7;
    (r7)打印;
    ("colour", "colou?r")正则匹配 = r8;
    (r8)打印;
    ("colr", "colou?r")正则匹配 = r9;
    (r9)打印;

    ("-- 回溯 --")打印;
    ("aaab", "a*ab")正则匹配 = r10;
    (r10)打印;
    ("ac", "a*bc")正则匹配 = r11;
    (r11)打印;
    ("abcbc", "a.*c")正则匹配 = r12;
    (r12)打印;

    ("-- 正则查找（首个匹配下标）--")打印;
    ("hello world", "o")正则查找 = p1;
    (p1)打印;
    ("abc123def", "\\d+")正则查找 = p2;
    (p2)打印;
    ("xyz", "\\d")正则查找 = p3;
    (p3)打印;

    ("=== 测试完成 ===")打印;
}
