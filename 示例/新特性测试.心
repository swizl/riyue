// P0 新特性测试
函数 主程序(): 空 {
    // === 1. 字符串数组 ===
    打印("=== 字符串数组测试 ===");
    变量 水果 = ["苹果", "香蕉", "橙子"];
    打印(水果[0]);
    打印(水果[1]);
    打印(水果[2]);
    
    // 修改字符串数组元素
    水果[1] = "葡萄";
    打印(水果[1]);
    
    // 字符串数组遍历
    遍历(项 : 水果) {
        打印(项);
    }
    
    // === 2. 字符串插值 ===
    打印("=== 字符串插值测试 ===");
    变量 名字 = "世界";
    变量 年龄 = 25;
    打印(f"你好，{名字}！");
    打印(f"年龄：{年龄}岁");
    打印(f"明年{年龄 + 1}岁");
    打印(f"名字长度：{长度(名字)}");
    
    // === 3. 常量不可变性 ===
    打印("=== 常量测试 ===");
    常量 圆周率 = 3;
    打印(圆周率);
    // 下面这行如果取消注释应该报错：
    // 圆周率 = 4;
    
    // === 4. 文件读取字符串 ===
    打印("=== 文件读取测试 ===");
    变量 写句柄 = 打开("测试写入.txt", "w");
    写入(写句柄, "第一行内容\n");
    写入(写句柄, "第二行内容\n");
    关闭(写句柄);
    
    变量 读句柄 = 打开("测试写入.txt", "r");
    变量 行1 = 读取行(读句柄);
    变量 行2 = 读取行(读句柄);
    关闭(读句柄);
    打印(行1);
    打印(行2);
}
