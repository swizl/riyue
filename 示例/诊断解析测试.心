// 诊断行解析测试（统一命令行 `诊断 --json` 的共用解析器）
// 归属：编译器差距补齐计划 续64「诊断 --json 精确错误码内建」
// 期望：示例/诊断解析测试.期望
导入 "../工具/诊断解析.心";

函数 主程序 {
    ("=== 诊断解析测试 ===")打印;
    ()诊断解析模块版本 = 版;
    (版)打印;

    // 1) 内建码 + 无文件名
    ("错误[C001]: 未声明的标识符: 甲")诊断行JSON = 项;
    (项)打印;

    // 2) 内建码 + 文件名（码在前，文件名在后）
    ("错误[C006][a.心]: '返回;' 不受支持")诊断行JSON = 项;
    (项)打印;

    // 3) 内建码 + 行列号
    ("错误[C005]: 找不到模块 x.心（行 3:7）")诊断行JSON = 项;
    (项)打印;

    // 4) 旧格式（无内建码 / 仅文件名）→ 回落 C000
    ("错误[a.心]: 旧格式无码")诊断行JSON = 项;
    (项)打印;

    // 5) 警告级别同样解析
    ("警告: 普通警告")诊断行JSON = 项;
    (项)打印;

    // 6) 非诊断行（源码行 / 指示符行）→ 空串
    ("  ^")诊断行JSON = 项;
    0 = 空项;
    如果 (项 ?= "") { 1 = 空项; }
    (空项)打印;

    // 7) 码 + 文件名 + 行列号
    ("错误[C003][b.心]: 解析失败（行 12:5）")诊断行JSON = 项;
    (项)打印;

    // 8) 消息内双引号转义
    "错误[C001]: 未知 " = 行;
    (34)字符 = 引;
    (行, 引)拼接 = 行;
    (行, "甲")拼接 = 行;
    (行, 引)拼接 = 行;
    (行)诊断行JSON = 项;
    (项)打印;

    // 9) 错误码判定：C + 3 位数字
    ("C001")诊断是错误码 = 是码;
    (是码)打印;
    ("a.心")诊断是错误码 = 是码;
    (是码)打印;
    ("C01")诊断是错误码 = 是码;
    (是码)打印;
}
