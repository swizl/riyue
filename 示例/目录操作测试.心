// 目录操作测试
函数 主程序 {
    ("=== 目录操作测试 ===")打印;
    
    // 列出当前目录
    ("列出当前目录:")打印;
    (".")列出目录 = 数量;
    ("目录项数量: " + (数量)转字符串)打印;
    
    // 遍历目录项
    0 = i;
    当 (i < 数量) {
        (i)获取目录项名称 = 名称;
        (i)获取目录项是否目录 = 是否目录;
        ("  " + 名称 + (是否目录 ? " [目录]" : " [文件]"))打印;
        i + 1 = i;
    }
    
    ("")打印;
    ("=== 测试完成 ===")打印;
}
