// 日期算术测试（8BR）
//
// 导入 标准库/日期时间.心，验证 8BR 新增的 `儒略日到日期`/`日期加天数`/`日期差天数`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

// 打印 出[0]/出[1]/出[2]（年/月/日）
函数 (出)打印三分量(空) {
    (出, 0)动态数组获取 = y;
    (出, 1)动态数组获取 = m;
    (出, 2)动态数组获取 = d;
    (y)打印;
    (m)打印;
    (d)打印;
}

函数 主程序 {
    ("=== 日期算术测试（8BR）===")打印;

    // ---- 儒略日到日期 ----
    ("-- 儒略日到日期 --")打印;
    ()创建动态数组 = 出甲;
    (出甲, 0)动态数组添加;
    (出甲, 0)动态数组添加;
    (出甲, 0)动态数组添加;
    (2451545, 出甲)儒略日到日期;
    ("2451545:")打印;
    (出甲)打印三分量;
    ()创建动态数组 = 出乙;
    (出乙, 0)动态数组添加;
    (出乙, 0)动态数组添加;
    (出乙, 0)动态数组添加;
    (2460311, 出乙)儒略日到日期;
    ("2460311:")打印;
    (出乙)打印三分量;
    ()创建动态数组 = 出丙;
    (出丙, 0)动态数组添加;
    (出丙, 0)动态数组添加;
    (出丙, 0)动态数组添加;
    (2461332, 出丙)儒略日到日期;
    ("2461332:")打印;
    (出丙)打印三分量;

    // ---- 日期加天数 ----
    ("-- 日期加天数 --")打印;
    ()创建动态数组 = 加甲;
    (加甲, 0)动态数组添加;
    (加甲, 0)动态数组添加;
    (加甲, 0)动态数组添加;
    (2024, 1, 1, 31, 加甲)日期加天数;
    ("2024-01-01 +31:")打印;
    (加甲)打印三分量;
    ()创建动态数组 = 加乙;
    (加乙, 0)动态数组添加;
    (加乙, 0)动态数组添加;
    (加乙, 0)动态数组添加;
    (2024, 2, 28, 1, 加乙)日期加天数;
    ("2024-02-28 +1:")打印;
    (加乙)打印三分量;
    ()创建动态数组 = 加丙;
    (加丙, 0)动态数组添加;
    (加丙, 0)动态数组添加;
    (加丙, 0)动态数组添加;
    (2023, 2, 28, 1, 加丙)日期加天数;
    ("2023-02-28 +1:")打印;
    (加丙)打印三分量;
    ()创建动态数组 = 加丁;
    (加丁, 0)动态数组添加;
    (加丁, 0)动态数组添加;
    (加丁, 0)动态数组添加;
    (2026, 10, 18, 45, 加丁)日期加天数;
    ("2026-10-18 +45:")打印;
    (加丁)打印三分量;
    ()创建动态数组 = 加戊;
    (加戊, 0)动态数组添加;
    (加戊, 0)动态数组添加;
    (加戊, 0)动态数组添加;
    (2024, 1, 1, 0, 加戊)日期加天数;
    ("2024-01-01 +0:")打印;
    (加戊)打印三分量;
    ()创建动态数组 = 加己;
    (加己, 0)动态数组添加;
    (加己, 0)动态数组添加;
    (加己, 0)动态数组添加;
    (2024, 1, 1, 0 - 1, 加己)日期加天数;
    ("2024-01-01 -1:")打印;
    (加己)打印三分量;

    // ---- 日期差天数 ----
    ("-- 日期差天数 --")打印;
    (2024, 1, 1, 2024, 3, 1)日期差天数 = 差甲;
    ("0101->0301:")打印;
    (差甲)打印;
    (2023, 12, 31, 2024, 1, 1)日期差天数 = 差乙;
    ("1231->0101:")打印;
    (差乙)打印;
    (2026, 10, 18, 2026, 10, 18)日期差天数 = 差丙;
    ("同一天:")打印;
    (差丙)打印;
    (2024, 3, 1, 2024, 1, 1)日期差天数 = 差丁;
    ("0301->0101:")打印;
    (差丁)打印;

    ("=== 测试完成 ===")打印;
}
