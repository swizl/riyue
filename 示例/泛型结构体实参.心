// 泛型结构体实参完整支持（阶段4C4）：泛型函数体可引用类型参数形参（结构体实参场景）。
// 覆盖：接口约束 + 结构体实现 + 泛型函数体内调用形参的方法 + 两个结构体实例化同一泛型（特化名不撞）。
接口 可描述 {
    方法 描述()(0 = 结果: 字符串);
}

结构体 点 : 可描述 {
    甲: 整数;
    方法 描述()(0 = 结果: 字符串) {
        "点" = 结果;
    }
}

结构体 线 : 可描述 {
    乙: 整数;
    方法 描述()(0 = 结果: 字符串) {
        "线" = 结果;
    }
}

函数 <T: 可描述> (对象: T)约束测试(0 = 结果: 字符串) {
    对象.描述() = 结果;
}

函数 主程序 {
    ("=== 泛型结构体实参测试 ===")打印;
    点 { 甲: 3 } = p;
    (p)约束测试 = r1;
    (r1)打印;
    线 { 乙: 5 } = q;
    (q)约束测试 = r2;
    (r2)打印;
    ("=== 测试完成 ===")打印;
}