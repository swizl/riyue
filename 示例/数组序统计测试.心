// 数组序统计与区间极值测试（8CA）
//
// 导入 标准库/数组.心，验证 8CA 新增的 `数组第几小`/`数组中位数`/`数组是否等于`/`数组区间最大值`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/数组.心";

// 打印 数组 长度 n 及其前 n 个元素
函数 (arr, n:整数)打印数组(空) {
    (n)打印;
    0 = i;
    当 (i < n) {
        (arr, i)动态数组获取 = v;
        (v)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== 数组序统计与区间极值测试（8CA）===")打印;

    // 甲 = [3, 1, 4, 1, 5]
    ()创建动态数组 = 甲;
    (甲, 3)动态数组添加;
    (甲, 1)动态数组添加;
    (甲, 4)动态数组添加;
    (甲, 1)动态数组添加;
    (甲, 5)动态数组添加;

    // 乙 = [2, 2, 2]
    ()创建动态数组 = 乙;
    (乙, 2)动态数组添加;
    (乙, 2)动态数组添加;
    (乙, 2)动态数组添加;

    // 丙 = [7]
    ()创建动态数组 = 丙;
    (丙, 7)动态数组添加;

    // 丁 = []
    ()创建动态数组 = 丁;

    // 戊 = [1, 2, 2, 3, 3, 3]
    ()创建动态数组 = 戊;
    (戊, 1)动态数组添加;
    (戊, 2)动态数组添加;
    (戊, 2)动态数组添加;
    (戊, 3)动态数组添加;
    (戊, 3)动态数组添加;
    (戊, 3)动态数组添加;

    // 己 = [1, 2, 3, 2]
    ()创建动态数组 = 己;
    (己, 1)动态数组添加;
    (己, 2)动态数组添加;
    (己, 3)动态数组添加;
    (己, 2)动态数组添加;

    // 庚 = [1, 2, 3, 2]
    ()创建动态数组 = 庚;
    (庚, 1)动态数组添加;
    (庚, 2)动态数组添加;
    (庚, 3)动态数组添加;
    (庚, 2)动态数组添加;

    // 辛 = [1, 2, 2, 3]
    ()创建动态数组 = 辛;
    (辛, 1)动态数组添加;
    (辛, 2)动态数组添加;
    (辛, 2)动态数组添加;
    (辛, 3)动态数组添加;

    // 壬 = [2, 2]
    ()创建动态数组 = 壬;
    (壬, 2)动态数组添加;
    (壬, 2)动态数组添加;

    // ---- 数组第几小 ----
    ("-- 数组第几小 --")打印;
    (甲, 5, 1)数组第几小 = k1;
    ("[3,1,4,1,5] k=1:")打印;
    (k1)打印;
    (甲, 5, 2)数组第几小 = k2;
    ("[3,1,4,1,5] k=2:")打印;
    (k2)打印;
    (甲, 5, 3)数组第几小 = k3;
    ("[3,1,4,1,5] k=3:")打印;
    (k3)打印;
    (甲, 5, 5)数组第几小 = k5;
    ("[3,1,4,1,5] k=5:")打印;
    (k5)打印;
    (甲, 5, 0)数组第几小 = k0;
    ("[3,1,4,1,5] k=0:")打印;
    (k0)打印;
    (甲, 5, 6)数组第几小 = k6;
    ("[3,1,4,1,5] k=6:")打印;
    (k6)打印;
    (戊, 6, 4)数组第几小 = k4;
    ("[1,2,2,3,3,3] k=4:")打印;
    (k4)打印;
    (丁, 0, 1)数组第几小 = kd;
    ("[] k=1:")打印;
    (kd)打印;

    // ---- 数组中位数 ----
    ("-- 数组中位数 --")打印;
    (甲, 5)数组中位数 = m1;
    ("[3,1,4,1,5]:")打印;
    (m1)打印;
    (己, 4)数组中位数 = m2;
    ("[1,2,3,2]:")打印;
    (m2)打印;
    (乙, 3)数组中位数 = m3;
    ("[2,2,2]:")打印;
    (m3)打印;
    (丙, 1)数组中位数 = m4;
    ("[7]:")打印;
    (m4)打印;
    (丁, 0)数组中位数 = m5;
    ("[]:")打印;
    (m5)打印;

    // ---- 数组是否等于 ----
    ("-- 数组是否等于 --")打印;
    (甲, 5, 甲, 5)数组是否等于 = e1;
    ("[3,1,4,1,5] ?= [3,1,4,1,5]:")打印;
    (e1)打印;
    (己, 4, 庚, 4)数组是否等于 = e2;
    ("[1,2,3,2] ?= [1,2,3,2]:")打印;
    (e2)打印;
    (己, 4, 辛, 4)数组是否等于 = e3;
    ("[1,2,3,2] ?= [1,2,2,3]:")打印;
    (e3)打印;
    (乙, 3, 壬, 2)数组是否等于 = e4;
    ("[2,2,2] ?= [2,2]:")打印;
    (e4)打印;
    (丁, 0, 丙, 1)数组是否等于 = e5;
    ("[] ?= [7]:")打印;
    (e5)打印;

    // ---- 数组区间最大值 ----
    ("-- 数组区间最大值 --")打印;
    (甲, 5, 0, 5)数组区间最大值 = r1;
    ("[0,5):")打印;
    (r1)打印;
    (甲, 5, 0, 3)数组区间最大值 = r2;
    ("[0,3):")打印;
    (r2)打印;
    (甲, 5, 1, 4)数组区间最大值 = r3;
    ("[1,4):")打印;
    (r3)打印;
    (甲, 5, 2, 5)数组区间最大值 = r4;
    ("[2,5):")打印;
    (r4)打印;
    (甲, 5, 3, 3)数组区间最大值 = r5;
    ("[3,3):")打印;
    (r5)打印;
    (甲, 5, 0, 100)数组区间最大值 = r6;
    ("[0,100):")打印;
    (r6)打印;
    (甲, 5, 0 - 5, 2)数组区间最大值 = r7;
    ("[-5,2):")打印;
    (r7)打印;

    ("=== 测试完成 ===")打印;
}
