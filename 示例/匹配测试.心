// switch/match 语句测试

函数 阶乘(数): 整数 {
    如果 (数 <= 1) {
        返回 1;
    }
    返回 数 * 阶乘(数 - 1);
}

函数 主程序(): 空 {
    打印("=== 匹配语句测试 ===");

    // 基本匹配
    变量 值 = 2;
    匹配 (值) {
        1 => {
            打印("一");
        }
        2 => {
            打印("二");
        }
        3 => {
            打印("三");
        }
        _ => {
            打印("其他");
        }
    }

    // 匹配字符串长度
    变量 文本 = "你好";
    变量 长度值 = 长度(文本);
    匹配 (长度值) {
        0 => {
            打印("空字符串");
        }
        6 => {
            打印("两个汉字");
        }
        _ => {
            打印("其他长度");
        }
    }

    // 匹配函数返回值
    变量 结果 = 阶乘(5);
    匹配 (结果) {
        120 => {
            打印("5的阶乘");
        }
        720 => {
            打印("6的阶乘");
        }
        _ => {
            打印("其他");
        }
    }

    打印("=== 测试完成 ===");
}
