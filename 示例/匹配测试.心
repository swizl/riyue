// 匹配测试

函数 (n:整数)星期名(空) {
    匹配 (n) {
        1 => { ("周一")打印; }
        2 => { ("周二")打印; }
        3 => { ("周三")打印; }
        4 => { ("周四")打印; }
        5 => { ("周五")打印; }
        6 => { ("周六")打印; }
        7 => { ("周日")打印; }
        _ => { ("无效")打印; }
    }
}

函数 (n:整数)阶乘(1 = 结果:整数) {
    匹配 (n) {
        0 => { 1 = 结果; }
        1 => { 1 = 结果; }
        _ => {
            n - 1 = 前一个;
            (前一个)阶乘 = 递归结果;
            n * 递归结果 = 结果;
        }
    }
}

函数 主程序 {
    ("=== 匹配测试 ===")打印;

    ("星期测试:")打印;
    (1)星期名;
    (3)星期名;
    (7)星期名;

    ("阶乘测试:")打印;
    (5)阶乘 = r;
    (r)打印;

    2 = x;
    匹配 (x) {
        1 => { ("一")打印; }
        2 => { ("二")打印; }
        _ => { ("其他")打印; }
    }

    ("=== 测试完成 ===")打印;
}
