导入 "标准库/B树.心";

// 打印整数数组（逐元素一行）
函数 (数组)打印整数数组(空) {
    (数组)动态数组大小 = 个数;
    0 = k;
    当 (k < 个数) {
        (数组, k)动态数组获取 = 元;
        (元)打印;
        k + 1 = k;
    }
}

