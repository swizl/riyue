    1 = i;
    当 (i <= 10) {
        t.插入(i);
        i + 1 = i;
    }
    ("A 长度:")打印;
    (t.长度())打印;
    ("A 树高:")打印;
    (t.树高())打印;
    ("A 最小:")打印;
    (t.最小())打印;
    ("A 最大:")打印;
    (t.最大())打印;
    ("A 包含 5:")打印;
    (t.包含(5))打印;
    ("A 包含 11:")打印;
    (t.包含(11))打印;
    ("A 中序:")打印;
    ()创建动态数组 = 序A;
    t.中序遍历(序A);
    (序A)打印整数数组;
