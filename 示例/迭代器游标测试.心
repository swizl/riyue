// 迭代器游标协议测试：
//   · 数组游标：`下一个` / `有下一个` / `结束` / `剩余` / `位置` / `重置` / `收集`
//   · 文本游标：按码点拆字符（日月ab → 4 个元素）
// 期望输出（双链一致）：见 迭代器游标测试.期望
导入 "../标准库/迭代器.心";

函数 (数组)打印数组 {
    (数组)动态数组大小 = 数;
    0 = i;
    当 (i < 数) {
        (数组, i)动态数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== 迭代器游标协议测试 ===")打印;

    ()迭代器模块版本 = 模块版本;
    ("模块版本=")打印;
    (模块版本)打印;

    ()创建动态数组 = 数据;
    (数据, 10)动态数组添加;
    (数据, 20)动态数组添加;
    (数据, 30)动态数组添加;

    ("-- 逐个取 --")打印;
    (数据)迭代器游标 = 游标;
    1 = 继续;
    当 (继续 ?= 1) {
        (数据, 游标)迭代器有下一个 = 有;
        如果 (有 ?= 1) {
            (数据, 游标)迭代器下一个 = 值;
            (值)打印;
        } 否则 {
            0 = 继续;
        }
    }
    (数据, 游标)迭代器结束 = 已结束;
    ("已结束=")打印;
    (已结束)打印;

    ("-- 重置后取一个再收集 --")打印;
    (游标)迭代器重置;
    (游标)迭代器剩余 = 剩余;
    ("剩余=")打印;
    (剩余)打印;
    (数据, 游标)迭代器下一个 = 头;
    ("头=")打印;
    (头)打印;
    (游标)迭代器位置 = 位置;
    ("位置=")打印;
    (位置)打印;
    (数据, 游标)迭代器收集 = 余下;
    (余下)打印数组;

    ("-- 文本按码点 --")打印;
    ()创建动态字符串数组 = 字符表;
    ("日月ab", 字符表)文本拆字符 = 字符数;
    ("字符数=")打印;
    (字符数)打印;
    (字符表)迭代器文本游标 = 字游标;
    1 = 继续;
    当 (继续 ?= 1) {
        (字符表, 字游标)迭代器文本有下一个 = 有字;
        如果 (有字 ?= 1) {
            (字符表, 字游标)迭代器下一个文本 = 字;
            (字)打印;
        } 否则 {
            0 = 继续;
        }
    }

    ("=== 测试完成 ===")打印;
}
