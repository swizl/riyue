// 当日时间运算测试（8CC）
//
// 导入 标准库/日期时间.心，验证 8CC 新增的 `时间到秒`/`秒到时间`/`时间加秒`/`时间差秒`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

// 打印 出[0]=时 / [1]=分 / [2]=秒
函数 (出)打印时间(空) {
    (出, 0)动态数组获取 = h;
    (出, 1)动态数组获取 = m;
    (出, 2)动态数组获取 = s;
    (h)打印;
    (m)打印;
    (s)打印;
}

函数 主程序 {
    ("=== 当日时间运算测试（8CC）===")打印;

    // 复用同一输出数组，预置 3 槽（秒到时间 覆盖既有下标）
    ()创建动态数组 = 出;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;

    // ---- 时间到秒 ----
    ("-- 时间到秒 --")打印;
    (0, 0, 0)时间到秒 = t1;
    ("0:0:0:")打印;
    (t1)打印;
    (1, 2, 3)时间到秒 = t2;
    ("1:2:3:")打印;
    (t2)打印;
    (12, 30, 0)时间到秒 = t3;
    ("12:30:0:")打印;
    (t3)打印;
    (23, 59, 59)时间到秒 = t4;
    ("23:59:59:")打印;
    (t4)打印;

    // ---- 秒到时间 ----
    ("-- 秒到时间 --")打印;
    (0, 出)秒到时间;
    ("0:")打印;
    (出)打印时间;
    (3723, 出)秒到时间;
    ("3723:")打印;
    (出)打印时间;
    (86399, 出)秒到时间;
    ("86399:")打印;
    (出)打印时间;
    (86400, 出)秒到时间;
    ("86400:")打印;
    (出)打印时间;
    (90061, 出)秒到时间;
    ("90061:")打印;
    (出)打印时间;
    (0 - 1, 出)秒到时间;
    ("-1:")打印;
    (出)打印时间;

    // ---- 时间加秒 ----
    ("-- 时间加秒 --")打印;
    (23, 59, 59, 1, 出)时间加秒;
    ("23:59:59 +1s:")打印;
    (出)打印时间;
    (0, 0, 0, 1, 出)时间加秒;
    ("0:0:0 +1s:")打印;
    (出)打印时间;
    (1, 0, 0, 3661, 出)时间加秒;
    ("1:0:0 +3661s:")打印;
    (出)打印时间;
    (9, 30, 0, 0 - 1, 出)时间加秒;
    ("9:30:0 -1s:")打印;
    (出)打印时间;

    // ---- 时间差秒 ----
    ("-- 时间差秒 --")打印;
    (1, 0, 0, 2, 0, 0)时间差秒 = f1;
    ("2:0:0 - 1:0:0:")打印;
    (f1)打印;
    (23, 30, 0, 0, 30, 0)时间差秒 = f2;
    ("0:30:0 - 23:30:0:")打印;
    (f2)打印;
    (12, 0, 0, 12, 0, 0)时间差秒 = f3;
    ("12:0:0 - 12:0:0:")打印;
    (f3)打印;
    (0, 0, 1, 0, 0, 0)时间差秒 = f4;
    ("0:0:0 - 0:0:1:")打印;
    (f4)打印;

    ("=== 测试完成 ===")打印;
}
