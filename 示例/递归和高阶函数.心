// 递归和高阶函数测试

函数 (数量:整数)阶乘(1 = 结果:整数) {
    如果 (数量 <= 1) {
        1 = 结果;
    } 否则 {
        数量 - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        数量 * 递归结果 = 结果;
    }
}

函数 (f:函数, 变量值:整数)应用(0 = 结果:整数) {
    (变量值)f = 结果;
}

函数 (f:函数, g:函数, 变量值:整数)组合(0 = 结果:整数) {
    (变量值)g = 中间;
    (中间)f = 结果;
}

函数 主程序 {
    ("=== 递归和高阶函数测试 ===")打印;

    (5)阶乘 = r1;
    (r1)打印;

    函数(变量值:整数)(0 = 结果:整数) {
        变量值 * 变量值 = 结果;
    } = 平方;
    (平方, 5)应用 = r2;
    (r2)打印;

    函数(变量值:整数)(0 = 结果:整数) {
        变量值 + 1 = 结果;
    } = 加一;
    (平方, 加一, 3)组合 = r3;
    (r3)打印;

    ("=== 测试完成 ===")打印;
}
