// 递归测试 - 汉诺塔
函数 汉诺塔(盘数, 源, 辅助, 目标): 空 {
    如果 (盘数 ?= 1) {
        打印(盘数);
        返回;
    }
    汉诺塔(盘数 - 1, 源, 目标, 辅助);
    打印(盘数);
    汉诺塔(盘数 - 1, 辅助, 源, 目标);
}

// 递归 - 快速排序的分区逻辑
函数 最大值(甲, 乙): 整数 {
    如果 (甲 > 乙) {
        返回 甲;
    }
    返回 乙;
}

函数 最小值(甲, 乙): 整数 {
    如果 (甲 < 乙) {
        返回 甲;
    }
    返回 乙;
}

// 递归 - 二分查找
函数 二分查找(目标, 低, 高): 整数 {
    如果 (低 > 高) {
        返回 -1;
    }
    变量 中 = (低 + 高) / 2;
    如果 (中 ?= 目标) {
        返回 中;
    }
    如果 (中 < 目标) {
        返回 二分查找(目标, 中 + 1, 高);
    }
    返回 二分查找(目标, 低, 中 - 1);
}

// 高阶函数 - 函数作为参数
函数 对每个执行(数组, 大小, 操作): 空 {
    变量 索引 = 0;
    当 (索引 < 大小) {
        操作(数组[索引]);
        索引 = 索引 + 1;
    }
}

函数 打印加倍(值): 空 {
    打印(值 * 2);
}

函数 主程序(): 空 {
    打印("=== 递归测试 ===");

    // 汉诺塔
    打印("汉诺塔(3):");
    汉诺塔(3, 1, 2, 3);

    // 最大值最小值
    打印("最大值(10, 20):");
    打印(最大值(10, 20));
    打印("最小值(10, 20):");
    打印(最小值(10, 20));

    // 二分查找
    打印("二分查找(7, 0, 10):");
    打印(二分查找(7, 0, 10));

    // 高阶函数
    打印("高阶函数测试:");
    变量 数据 = [10, 20, 30, 40, 50];
    对每个执行(数据, 5, 打印加倍);

    // 闭包测试
    变量 基数 = 100;
    变量 加基数 = 函数(值): 整数 {
        返回 值 + 基数;
    };
    打印("闭包(50):");
    打印(加基数(50));

    打印("=== 测试完成 ===");
}
