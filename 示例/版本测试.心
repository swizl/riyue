// 示例 - 语义化版本（SemVer）测试
// 归属：短板补齐计划 §Phase 2 包管理器 §2.1「语义化版本管理」（8AS 落地 / 8AT 增区间·通配·选择）
导入 "../标准库/版本.心";

函数 主程序 {
    ("=== 版本测试 ===")打印;

    ("模块版本:")打印;
    ()版本模块版本 = 模块版本;
    (模块版本)打印;

    ("解析 1.2.3:")打印;
    ("1.2.3")版本解析 = (主, 次, 修, 有效);
    (主)打印;
    (次)打印;
    (修)打印;
    (有效)打印;

    ("解析 v2.10.0:")打印;
    ("v2.10.0")版本解析 = (主, 次, 修, 有效);
    (主)打印;
    (次)打印;
    (修)打印;
    (有效)打印;

    ("解析 1.2（不足三段）:")打印;
    ("1.2")版本解析 = (主, 次, 修, 有效);
    (主)打印;
    (次)打印;
    (修)打印;
    (有效)打印;

    ("比较 1.2.3 vs 1.2.4:")打印;
    (1, 2, 3, 1, 2, 4)版本比较 = 比较结果;
    (比较结果)打印;

    ("比较 2.0.0 vs 1.9.9:")打印;
    (2, 0, 0, 1, 9, 9)版本比较 = 比较结果;
    (比较结果)打印;

    ("比较 1.2.3 vs 1.2.3:")打印;
    (1, 2, 3, 1, 2, 3)版本比较 = 比较结果;
    (比较结果)打印;

    0 = 满足;
    ("约束 =1.2.3 命中:")打印;
    ("1.2.3", "=1.2.3")版本满足约束 = 满足;
    (满足)打印;

    ("约束 >=1.2.0 命中:")打印;
    ("1.2.3", ">=1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 >1.2.3 命中:")打印;
    ("1.2.3", ">1.2.3")版本满足约束 = 满足;
    (满足)打印;

    ("约束 <2.0.0 命中:")打印;
    ("1.2.3", "<2.0.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ^1.2.0 命中:")打印;
    ("1.2.3", "^1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ^1.2.0 对 2.0.0（越界）:")打印;
    ("2.0.0", "^1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ~1.2.0 命中:")打印;
    ("1.2.5", "~1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ~1.2.0 对 1.3.0（越界）:")打印;
    ("1.3.0", "~1.2.0")版本满足约束 = 满足;
    (满足)打印;

    // ---- 8AT：通配段 ----
    0 = 通配命中;
    ("通配 1.2.3 匹配 1.2.x:")打印;
    ("1.2.3", "1.2.x")版本满足通配 = 通配命中;
    (通配命中)打印;

    ("通配 1.3.0 匹配 1.2.x:")打印;
    ("1.3.0", "1.2.x")版本满足通配 = 通配命中;
    (通配命中)打印;

    ("通配 1.9.9 匹配 1.x:")打印;
    ("1.9.9", "1.x")版本满足通配 = 通配命中;
    (通配命中)打印;

    ("通配 2.0.0 匹配 1.x:")打印;
    ("2.0.0", "1.x")版本满足通配 = 通配命中;
    (通配命中)打印;

    ("通配 9.9.9 匹配 *:")打印;
    ("9.9.9", "*")版本满足通配 = 通配命中;
    (通配命中)打印;

    // ---- 8AT：区间（逗号 AND）----
    0 = 区间命中;
    ("区间 1.5.0 满足 >=1.2.0, <2.0.0:")打印;
    ("1.5.0", ">=1.2.0, <2.0.0")版本满足区间 = 区间命中;
    (区间命中)打印;

    ("区间 2.1.0 满足 >=1.2.0, <2.0.0:")打印;
    ("2.1.0", ">=1.2.0, <2.0.0")版本满足区间 = 区间命中;
    (区间命中)打印;

    ("区间 1.2.7 满足 1.2.x:")打印;
    ("1.2.7", "1.2.x")版本满足区间 = 区间命中;
    (区间命中)打印;

    // ---- 8AT：版本选择（依赖解析核心）----
    ()创建动态字符串数组 = 候选;
    (候选, "1.0.0")动态字符串数组添加;
    (候选, "1.2.0")动态字符串数组添加;
    (候选, "1.2.5")动态字符串数组添加;
    (候选, "2.0.0")动态字符串数组添加;

    0 = 选中;
    ("选择 ^1.2.0:")打印;
    ("^1.2.0", 候选)选最高满足版本 = 选中;
    (选中)打印;

    ("选择 >=1.0.0, <2.0.0:")打印;
    (">=1.0.0, <2.0.0", 候选)选最高满足版本 = 选中;
    (选中)打印;

    ("选择 >=2.0.0:")打印;
    (">=2.0.0", 候选)选最高满足版本 = 选中;
    (选中)打印;

    ("选择 >=3.0.0（无）:")打印;
    (">=3.0.0", 候选)选最高满足版本 = 选中;
    (选中)打印;

    ("选择 1.x:")打印;
    ("1.x", 候选)选最高满足版本 = 选中;
    (选中)打印;

    // ---- 8AV：多约束（约束表）与版本冲突检测 ----
    ()创建动态字符串数组 = 约束表;
    (约束表, ">=1.0.0")动态字符串数组添加;
    (约束表, "<2.0.0")动态字符串数组添加;

    0 = 全部命中;
    ("满足全部 1.5.0 满足 [>=1.0.0, <2.0.0]:")打印;
    ("1.5.0", 约束表)版本满足全部 = 全部命中;
    (全部命中)打印;

    ("满足全部 2.1.0 满足 [>=1.0.0, <2.0.0]:")打印;
    ("2.1.0", 约束表)版本满足全部 = 全部命中;
    (全部命中)打印;

    ()创建动态字符串数组 = 空约束;
    ("满足全部 9.9.9 满足 []（空表）:")打印;
    ("9.9.9", 空约束)版本满足全部 = 全部命中;
    (全部命中)打印;

    0 = 全选;
    ("全选 [>=1.0.0, <2.0.0] 于候选:")打印;
    (约束表, 候选)选最高满足全部 = 全选;
    (全选)打印;

    ()创建动态字符串数组 = 冲突表;
    (冲突表, ">=2.0.0")动态字符串数组添加;
    (冲突表, "<1.0.0")动态字符串数组添加;
    ("全选 [>=2.0.0, <1.0.0]（冲突）:")打印;
    (冲突表, 候选)选最高满足全部 = 全选;
    (全选)打印;

    // ---- 8AZ：预发布与构建元数据 ----
    ("解析扩展 1.2.3-alpha:")打印;
    ("1.2.3-alpha")版本解析扩展 = (E主, E次, E修, E有预, E预起, E预长, E有效);
    (E主)打印;
    (E次)打印;
    (E修)打印;
    (E有预)打印;
    (E预长)打印;
    (E有效)打印;

    ("解析扩展 1.2.3-alpha+build.5:")打印;
    ("1.2.3-alpha+build.5")版本解析扩展 = (E主, E次, E修, E有预, E预起, E预长, E有效);
    (E有预)打印;
    (E预长)打印;
    (E有效)打印;

    ("解析扩展 1.2.3+build:")打印;
    ("1.2.3+build")版本解析扩展 = (E主, E次, E修, E有预, E预起, E预长, E有效);
    (E有预)打印;
    (E有效)打印;

    ("优先级 1.0.0-alpha vs 1.0.0:")打印;
    ("1.0.0-alpha", "1.0.0")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0 vs 1.0.0-alpha:")打印;
    ("1.0.0", "1.0.0-alpha")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0-alpha vs 1.0.0-beta:")打印;
    ("1.0.0-alpha", "1.0.0-beta")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0-alpha.1 vs 1.0.0-alpha.2:")打印;
    ("1.0.0-alpha.1", "1.0.0-alpha.2")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0-alpha vs 1.0.0-alpha.1:")打印;
    ("1.0.0-alpha", "1.0.0-alpha.1")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0-2 vs 1.0.0-10:")打印;
    ("1.0.0-2", "1.0.0-10")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0-alpha.1 vs 1.0.0-alpha.beta:")打印;
    ("1.0.0-alpha.1", "1.0.0-alpha.beta")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.0.0+build.1 vs 1.0.0+build.2:")打印;
    ("1.0.0+build.1", "1.0.0+build.2")版本优先级比较 = 优;
    (优)打印;

    ("优先级 1.2.3 vs 1.2.3:")打印;
    ("1.2.3", "1.2.3")版本优先级比较 = 优;
    (优)打印;

    ("=== 测试完成 ===")打印;
}
