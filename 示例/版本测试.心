// 示例 - 语义化版本（SemVer）测试
// 归属：短板补齐计划 §Phase 2 包管理器 §2.1「语义化版本管理」（8AS）
导入 "../标准库/版本.心";

函数 主程序 {
    ("=== 版本测试 ===")打印;

    ("模块版本:")打印;
    ()版本模块版本 = 模块版本;
    (模块版本)打印;

    ("解析 1.2.3:")打印;
    ("1.2.3")版本解析 = (主, 次, 修, 有效);
    (主)打印;
    (次)打印;
    (修)打印;
    (有效)打印;

    ("解析 v2.10.0:")打印;
    ("v2.10.0")版本解析 = (主, 次, 修, 有效);
    (主)打印;
    (次)打印;
    (修)打印;
    (有效)打印;

    ("解析 1.2（不足三段）:")打印;
    ("1.2")版本解析 = (主, 次, 修, 有效);
    (主)打印;
    (次)打印;
    (修)打印;
    (有效)打印;

    ("比较 1.2.3 vs 1.2.4:")打印;
    (1, 2, 3, 1, 2, 4)版本比较 = 比较结果;
    (比较结果)打印;

    ("比较 2.0.0 vs 1.9.9:")打印;
    (2, 0, 0, 1, 9, 9)版本比较 = 比较结果;
    (比较结果)打印;

    ("比较 1.2.3 vs 1.2.3:")打印;
    (1, 2, 3, 1, 2, 3)版本比较 = 比较结果;
    (比较结果)打印;

    0 = 满足;
    ("约束 =1.2.3 命中:")打印;
    ("1.2.3", "=1.2.3")版本满足约束 = 满足;
    (满足)打印;

    ("约束 >=1.2.0 命中:")打印;
    ("1.2.3", ">=1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 >1.2.3 命中:")打印;
    ("1.2.3", ">1.2.3")版本满足约束 = 满足;
    (满足)打印;

    ("约束 <2.0.0 命中:")打印;
    ("1.2.3", "<2.0.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ^1.2.0 命中:")打印;
    ("1.2.3", "^1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ^1.2.0 对 2.0.0（越界）:")打印;
    ("2.0.0", "^1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ~1.2.0 命中:")打印;
    ("1.2.5", "~1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("约束 ~1.2.0 对 1.3.0（越界）:")打印;
    ("1.3.0", "~1.2.0")版本满足约束 = 满足;
    (满足)打印;

    ("=== 测试完成 ===")打印;
}
