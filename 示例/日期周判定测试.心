// 日期 ISO 周与周末判定测试（8BX）
//
// 导入 标准库/日期时间.心，验证 8BX 新增的 `是否周末`/`ISO星期`/`ISO周年`/`ISO周号`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

函数 主程序 {
    ("=== 日期 ISO 周与周末判定测试（8BX）===")打印;

    // ---- 是否周末 ----
    ("-- 是否周末 --")打印;
    (2024, 3, 1)是否周末 = k1;
    ("2024-03-01(周五):")打印;
    (k1)打印;
    (2024, 3, 2)是否周末 = k2;
    ("2024-03-02(周六):")打印;
    (k2)打印;
    (2024, 3, 3)是否周末 = k3;
    ("2024-03-03(周日):")打印;
    (k3)打印;
    (2024, 1, 1)是否周末 = k4;
    ("2024-01-01(周一):")打印;
    (k4)打印;

    // ---- ISO 星期 ----
    ("-- ISO 星期 --")打印;
    (2024, 1, 1)ISO星期 = i1;
    ("2024-01-01:")打印;
    (i1)打印;
    (2024, 1, 7)ISO星期 = i2;
    ("2024-01-07:")打印;
    (i2)打印;
    (2024, 3, 1)ISO星期 = i3;
    ("2024-03-01:")打印;
    (i3)打印;

    // ---- ISO 周年 ----
    ("-- ISO 周年 --")打印;
    (2024, 1, 1)ISO周年 = y1;
    ("2024-01-01:")打印;
    (y1)打印;
    (2023, 1, 1)ISO周年 = y2;
    ("2023-01-01:")打印;
    (y2)打印;
    (2024, 12, 30)ISO周年 = y3;
    ("2024-12-30:")打印;
    (y3)打印;
    (2021, 1, 1)ISO周年 = y4;
    ("2021-01-01:")打印;
    (y4)打印;

    // ---- ISO 周号 ----
    ("-- ISO 周号 --")打印;
    (2024, 1, 1)ISO周号 = w1;
    ("2024-01-01:")打印;
    (w1)打印;
    (2024, 3, 1)ISO周号 = w2;
    ("2024-03-01:")打印;
    (w2)打印;
    (2020, 12, 31)ISO周号 = w3;
    ("2020-12-31:")打印;
    (w3)打印;
    (2021, 1, 1)ISO周号 = w4;
    ("2021-01-01:")打印;
    (w4)打印;
    (2024, 12, 30)ISO周号 = w5;
    ("2024-12-30:")打印;
    (w5)打印;
    (2023, 1, 1)ISO周号 = w6;
    ("2023-01-01:")打印;
    (w6)打印;

    ("=== 测试完成 ===")打印;
}
