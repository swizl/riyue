// 系统调用 测试：环境变量读写（双链一致）
//
// 说明：直接使用内建 `获取环境变量(名称)` / `设置环境变量(名称, 值)`，
//   不导入 所有.心（宿主链 引导.exe 尚不能编译 标准库/JSON.心，见 8O 缺口记录）。

函数 主程序 {
    ("=== 系统调用 测试 ===")打印;

    ("-- 读取不存在的变量")打印;
    ("RIYUE_8Q_不存在")获取环境变量 = 缺失;
    (缺失)打印;
    (缺失)长度 = 缺失长;
    ("长度=")打印;
    (缺失长)打印;

    ("-- 设置变量")打印;
    ("RIYUE_8Q", "第一值")设置环境变量 = 码一;
    (码一)打印;
    ("RIYUE_8Q")获取环境变量 = 读一;
    (读一)打印;

    ("-- 覆盖变量")打印;
    ("RIYUE_8Q", "第二值")设置环境变量 = 码二;
    (码二)打印;
    ("RIYUE_8Q")获取环境变量 = 读二;
    (读二)打印;

    ("=== 测试完成 ===")打印;
}
