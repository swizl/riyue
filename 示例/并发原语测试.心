// 阶段10 G11：并发原语（互斥锁 / 信号量 / 原子整数 / 并行内核）
//
// 句柄均为「整数32 槽号」（0 = 无效）。互斥锁 / 信号量由 Windows 内核对象、
// 原子整数由 Interlocked 提供真实线程安全；协程与调度器仍为协作式单线程，
// 需要跨线程共享时显式取用本组原语。并行内核在工作线程内只读数组并归约，
// 结果与线程数无关（确定性）。纯 `.心` + 运行时内建，双链输出应逐字一致。

函数 主程序 {
    ("=== 并发原语测试 ===")打印;

    ("-- 互斥锁 --")打印;
    ()创建互斥锁 = 锁;
    (锁)互斥锁是否锁定 = 锁前;
    ("锁定前:")打印;
    (锁前)打印;
    (锁)互斥锁加锁 = 加锁返回;
    ("加锁返回:")打印;
    (加锁返回)打印;
    (锁)互斥锁是否锁定 = 锁中;
    ("锁定中:")打印;
    (锁中)打印;
    (锁)互斥锁解锁 = 解锁返回;
    ("解锁返回:")打印;
    (解锁返回)打印;
    (锁)互斥锁是否锁定 = 锁后;
    ("解锁后:")打印;
    (锁后)打印;
    (0)互斥锁加锁 = 无效锁;
    ("无效句柄加锁:")打印;
    (无效锁)打印;
    (锁)销毁互斥锁 = 销毁锁;
    ("销毁锁:")打印;
    (销毁锁)打印;

    ("-- 信号量 --")打印;
    (2)创建信号量 = 量;
    (量)信号量当前值 = 量初;
    ("初始值:")打印;
    (量初)打印;
    (量)信号量等待;
    (量)信号量当前值 = 量一;
    ("等待一次:")打印;
    (量一)打印;
    (量)信号量等待;
    (量)信号量当前值 = 量二;
    ("等待两次:")打印;
    (量二)打印;
    (量)信号量释放 = 量释;
    ("释放一次:")打印;
    (量释)打印;
    (量)信号量释放;
    (量)信号量当前值 = 量回;
    ("释放两次:")打印;
    (量回)打印;
    (量)销毁信号量 = 销毁量;
    ("销毁信号量:")打印;
    (销毁量)打印;

    ("-- 原子整数 --")打印;
    (10)创建原子整数 = 原;
    (原)原子读 = 原初;
    ("初始值:")打印;
    (原初)打印;
    (原, 3)原子加 = 原加;
    ("加三后:")打印;
    (原加)打印;
    (原, 2)原子减 = 原减;
    ("减二后:")打印;
    (原减)打印;
    (原, 7)原子写 = 原旧;
    ("写入返回旧值:")打印;
    (原旧)打印;
    (原)原子读 = 原读;
    ("写入后读取:")打印;
    (原读)打印;
    (原)销毁原子整数 = 销毁原;
    ("销毁原子:")打印;
    (销毁原)打印;

    ("-- 并行内核 --")打印;
    ()创建动态数组 = 数;
    (数, 1)动态数组添加;
    (数, 2)动态数组添加;
    (数, 3)动态数组添加;
    (数, 4)动态数组添加;
    (数, 5)动态数组添加;
    (数, -6)动态数组添加;
    (数, 7)动态数组添加;
    (数, 8)动态数组添加;
    (数, 8, 3)并行求和 = 和;
    ("并行求和（3线程）:")打印;
    (和)打印;
    (数, 8, 8)并行求和 = 和八;
    ("并行求和（8线程）:")打印;
    (和八)打印;
    (数, 8, 2)并行计数正 = 正数;
    ("并行计数正（2线程）:")打印;
    (正数)打印;

    ()同步存活数 = 存活;
    ("同步对象存活:")打印;
    (存活)打印;

    ("=== 测试完成 ===")打印;
}
