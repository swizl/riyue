// 复杂测试

函数 (数量:整数)是素数(0 = 结果:整数) {
    如果 (数量 <= 1) {
        0 = 结果;
    } 否则如果 (数量 <= 3) {
        1 = 结果;
    } 否则如果 (数量 % 2 ?= 0 || 数量 % 3 ?= 0) {
        0 = 结果;
    } 否则 {
        5 = 索引;
        1 = 是素数标志;
        当 (索引 * 索引 <= 数量) {
            如果 (数量 % 索引 ?= 0 || 数量 % (索引 + 2) ?= 0) {
                0 = 是素数标志;
                中断;
            }
            索引 + 6 = 索引;
        }
        是素数标志 = 结果;
    }
}

函数 (数量:整数)打印素数(空) {
    0 = 计数;
    2 = 数字;
    当 (计数 < 数量) {
        (数字)是素数 = 是;
        如果 (是 ?= 1) {
            (数字)打印;
            计数 + 1 = 计数;
        }
        数字 + 1 = 数字;
    }
}

函数 主程序 {
    ("=== 复杂测试 ===")打印;

    ("前10个素数:")打印;
    (10)打印素数;

    ("=== 测试完成 ===")打印;
}
