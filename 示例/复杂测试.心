// 复杂测试

函数 (n:整数)是素数(0 = 结果:整数) {
    如果 (n <= 1) {
        0 = 结果;
    } 否则如果 (n <= 3) {
        1 = 结果;
    } 否则如果 (n % 2 ?= 0 || n % 3 ?= 0) {
        0 = 结果;
    } 否则 {
        5 = i;
        1 = 是素数标志;
        当 (i * i <= n) {
            如果 (n % i ?= 0 || n % (i + 2) ?= 0) {
                0 = 是素数标志;
                中断;
            }
            i + 6 = i;
        }
        是素数标志 = 结果;
    }
}

函数 (n:整数)打印素数(空) {
    0 = count;
    2 = num;
    当 (count < n) {
        (num)是素数 = 是;
        如果 (是 ?= 1) {
            (num)打印;
            count + 1 = count;
        }
        num + 1 = num;
    }
}

函数 主程序 {
    ("=== 复杂测试 ===")打印;

    ("前10个素数:")打印;
    (10)打印素数;

    ("=== 测试完成 ===")打印;
}
