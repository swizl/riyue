// 复杂测试 - 闭包、数组、高阶函数
函数 创建加法器(基数): 整数 {
    变量 加法器 = 函数(值): 整数 {
        返回 值 + 基数;
    };
    返回 加法器(10);
}

函数 数组求和(数组, 大小): 整数 {
    变量 总和 = 0;
    变量 索引 = 0;
    当 (索引 < 大小) {
        总和 = 总和 + 数组[索引];
        索引 = 索引 + 1;
    }
    返回 总和;
}

函数 数组最大值(数组, 大小): 整数 {
    变量 最大 = 数组[0];
    变量 索引 = 1;
    当 (索引 < 大小) {
        如果 (数组[索引] > 最大) {
            最大 = 数组[索引];
        }
        索引 = 索引 + 1;
    }
    返回 最大;
}

函数 主程序(): 空 {
    // 闭包测试
    打印("闭包测试:");
    打印(创建加法器(100));

    // 数组测试
    打印("数组测试:");
    变量 数据 = [3, 7, 1, 9, 4, 6, 2, 8, 5, 0];
    打印(数组求和(数据, 10));
    打印(数组最大值(数据, 10));

    // 复杂表达式
    变量 x = 10;
    变量 y = 20;
    变量 z = 30;
    打印((x + y) * z - 100);
    打印(x > 5 && y < 25);

    // 嵌套如果
    变量 值 = 85;
    如果 (值 >= 90) {
        打印(1);
    } 否则如果 (值 >= 80) {
        打印(2);
    } 否则如果 (值 >= 70) {
        打印(3);
    } 否则 {
        打印(4);
    }

    // 循环中的中断和继续
    变量 计数 = 0;
    变量 总和 = 0;
    当 (计数 < 20) {
        计数 = 计数 + 1;
        如果 (计数 % 3 ?= 0) {
            继续;
        }
        如果 (计数 > 15) {
            中断;
        }
        总和 = 总和 + 计数;
    }
    打印(总和);
}
