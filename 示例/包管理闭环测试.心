// 包管理闭环测试：清单文件读取 / 本地路径依赖 / 缓存目录安装 / 锁文件落盘 / 导入解析
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定）；产物落在 .gitignore 的 构建/ 下。

导入 "标准库/包管理.心";

函数 ()主 {
    ("=== 包管理闭环测试 ===")打印;
    ()包管理模块版本 = 模块版;
    ("模块版本:")打印;
    (模块版)打印;

    // 工作目录：构建/包测试
    "构建/包测试" = 根;
    (根)包确保目录 = 根建;
    ("根目录就绪:")打印;
    (根建)打印;

    "" = 换行;
    (10)字符 = 换行;

    // 本地包：包信息.心（名称/版本）
    (根, "本地包")包连接路径 = 包目录;
    (包目录)包确保目录 = 包建;
    (包目录, "包信息.心")包连接路径 = 包清单路径;
    "" = 包文;
    "名称 = 数学" = 包文;
    (包文, 换行)拼接 = 包文;
    (包文, "版本 = 1.2.0")拼接 = 包文;
    (包文, 换行)拼接 = 包文;
    (包清单路径, 包文)写入文件 = 包写;
    0 = 包写果;
    如果 (包写 ?= 0) { 1 = 包写果; }
    ("包清单写入:")打印;
    (包写果)打印;

    // 项目清单：依赖 = 数学 @本地包, 字符串 ^1.0.0（前者是本地路径依赖）
    (根, "包信息.心")包连接路径 = 清单路径;
    "" = 清单文;
    "名称 = 演示项目" = 清单文;
    (清单文, 换行)拼接 = 清单文;
    (清单文, "版本 = 0.1.0")拼接 = 清单文;
    (清单文, 换行)拼接 = 清单文;
    (清单文, "依赖 = 数学 @本地包, 字符串 ^1.0.0")拼接 = 清单文;
    (清单文, 换行)拼接 = 清单文;
    (清单路径, 清单文)写入文件 = 清单写;

    // 读回 + 键值
    (清单路径)包读取清单 = 读回;
    ("-- 清单读回 --")打印;
    (读回, "名称")包清单取值 = 项目名;
    (项目名)打印;
    (读回, "版本")包清单取值 = 项目版;
    (项目版)打印;

    // 本地路径依赖：只挑 @ 前缀项，路径按 根 解析
    ()创建动态字符串数组 = 路径表;
    (读回, 根, 路径表)包清单路径依赖 = 本地数;
    ("-- 本地路径依赖 --")打印;
    (本地数)打印;
    (路径表, 0)动态字符串数组获取 = 路径0;
    (路径0)打印;

    // 本地包版本：读 <包目录>/包信息.心
    ("-- 本地包版本 --")打印;
    (包目录)包包版本 = 本地版;
    (本地版)打印;

    // 缓存目录 + 安装：复制 包信息.心 到 缓存/数学
    (根, "缓存")包连接路径 = 缓存目录;
    (缓存目录)包确保目录 = 缓存建;
    ("-- 安装到缓存 --")打印;
    ("数学", 包目录, 缓存目录)包安装本地 = 装果;
    (装果)打印;
    (缓存目录, "数学")包连接路径 = 装目录;
    (装目录, "包信息.心")包连接路径 = 装清单;
    (装清单)文件存在 = 装存在;
    ("缓存清单存在:")打印;
    (装存在)打印;
    (装清单)包读取清单 = 装文;
    (装文, "版本")包清单取值 = 装版;
    ("缓存清单版本:")打印;
    (装版)打印;

    // 导入解析：@名称/相对 → 缓存/名称/相对；其余 → 根/导入项
    ("-- 导入解析 --")打印;
    ("@数学/包信息.心", 根, 缓存目录)包解析导入 = 导包;
    (导包)打印;
    ("标准库/包管理.心", 根, 缓存目录)包解析导入 = 导本;
    (导本)打印;

    // 锁文件落盘：`名称@版本 md5=…`
    ()创建动态数组 = 选中;
    (选中, 0)动态数组添加;
    ()创建动态字符串数组 = 内容表;
    (内容表, "abc")动态字符串数组添加;
    ()创建动态字符串数组 = 小注册表;
    (小注册表, "数学@1.2.0")动态字符串数组添加;
    (小注册表, 选中, 内容表)包锁文件生成 = 锁;
    (锁)去除首尾空白 = 锁净;
    (根, "包锁.心")包连接路径 = 锁路径;
    (锁路径, 锁)包写锁文件 = 锁写;
    ("-- 锁文件落盘 --")打印;
    (锁写)打印;
    (锁净)打印;
    (锁, "数学", "abc")包锁校验 = 锁校;
    (锁校)打印;
    (锁路径)读取文件 = 锁回;
    (锁回)去除首尾空白 = 锁回净;
    (锁回净, 锁净)字符串比较 = 锁比;
    ("读回比对:")打印;
    (锁比)打印;

    // 缺失清单：读不到 → 空串
    ("-- 缺失清单 --")打印;
    (根, "不存在.心")包连接路径 = 缺路径;
    (缺路径)包读取清单 = 缺文;
    (缺文)长度 = 缺长;
    (缺长)打印;

    ("=== 测试完成 ===")打印;
}
