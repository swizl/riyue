// 日月包管理器（完整版）

// 全局变量
"" = 变量 包目录路径;

// 初始化包目录
函数 初始化包目录 {
    ()获取当前目录 = 当前目录;
    (当前目录, "/.日月包")连接路径 = 包目录路径;
    
    如果 ((包目录路径)目录存在 ?= 0) {
        (包目录路径)创建目录;
    }
}

// 列出已安装的包
函数 (包名)列出包 {
    ("已安装的包:")打印;
    
    ()初始化包目录;
    
    (包目录路径, 包名)连接路径 = 目标目录;
    
    如果 ((目标目录)目录存在 ?= 1) {
        ("包已存在: " + 包名)打印;
    }
    
    (目标目录)创建目录;
    
    // 查找源文件
    (包名, ".心")拼接 = 源文件名;
    ("示例/", 源文件名)连接路径 = 源文件;
    
    如果 ((源文件)文件存在 ?= 0) {
        ("找不到包: " + 包名)打印;
    }
    
    // 复制文件
    (目标目录, "/")连接路径 = 目标前缀;
    (目标前缀, 源文件名)连接路径 = 目标文件;
    (源文件, 目标文件)复制文件;
    
    ("安装成功: " + 包名)打印;
}

// 安装包
函数 (包名)安装包 {
    ()初始化包目录;
    
    (包目录路径, 包名)连接路径 = 目标目录;
    (目标目录)创建目录;
    
    // 查找源文件
    (包名, ".心")拼接 = 源文件名;
    ("示例/", 源文件名)连接路径 = 源文件;
    
    如果 ((源文件)文件存在 ?= 0) {
        ("找不到包: " + 包名)打印;
    }
    
    // 复制文件
    (目标目录, "/")连接路径 = 目标前缀;
    (目标前缀, 源文件名)连接路径 = 目标文件;
    (源文件, 目标文件)复制文件;
    
    ("安装成功: " + 包名)打印;
}

// 移除包
函数 (包名)移除包 {
    ()初始化包目录;
    
    (包目录路径, 包名)连接路径 = 目标目录;
    
    如果 ((目标目录)目录存在 ?= 0) {
        ("包不存在: " + 包名)打印;
    }
    
    // 递归删除目录
    (目标目录)删除目录;
    ("移除成功: " + 包名)打印;
}

// 搜索包（在示例目录中）
函数 (关键词)搜索包 {
    ("搜索包: " + 关键词)打印;
    
    ("示例")列出目录 = 数量;
    0 = 找到数量;
    
    0 = 索引;
    当 (索引 < 数量) {
        (索引)获取目录项名称 = 名称;
        (索引)获取目录项是否目录 = 是目录;
        
        // 检查是否是.心文件
        (名称)获取文件扩展名 = 扩展名;
        如果 (扩展名 ?= "心") {
            // 检查文件名是否包含关键词
            (名称)获取文件名 = 文件名;
            如果 (文件名 != "") {
                ("  ")打印;
                (文件名)打印;
                找到数量 + 1 = 找到数量;
            }
        }
        
        索引 + 1 = 索引;
    }
    
    如果 (找到数量 ?= 0) {
        ("  没有找到匹配的包")打印;
    }
}

函数 主程序 {
    ("=== 日月包管理器 ===")打印;
    
    // 获取命令行参数
    (1)获取参数 = 命令;
    (2)获取参数 = 参数1;
    
    如果 (命令 ?= "") {
        ("用法:")打印;
        ("  包管理器 安装 <包名>    - 安装包")打印;
        ("  包管理器 列表          - 列出已安装的包")打印;
        ("  包管理器 移除 <包名>    - 移除包")打印;
        ("  包管理器 搜索 <关键词>  - 搜索包")打印;
    }
    
    如果 (命令 ?= "列表") {
        ("")列出包;
    }
    
    如果 (命令 ?= "安装") {
        如果 (参数1 ?= "") {
            ("用法: 包管理器 安装 <包名>")打印;
        }
        (参数1)安装包;
    }
    
    如果 (命令 ?= "移除") {
        如果 (参数1 ?= "") {
            ("用法: 包管理器 移除 <包名>")打印;
        }
        (参数1)移除包;
    }
    
    如果 (命令 ?= "搜索") {
        如果 (参数1 ?= "") {
            ("用法: 包管理器 搜索 <关键词>")打印;
        }
        (参数1)搜索包;
    }
}
