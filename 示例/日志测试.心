// 日志库测试

导入 "../标准库/日志.心";

函数 主程序 {
    ("=== 日志库测试 ===")打印;

    // 设置日志级别为调试
    (0)设置日志级别;

    ("测试调试日志:")打印;
    ("这是一条调试消息")日志调试;

    ("测试信息日志:")打印;
    ("这是一条信息消息")日志信息;

    ("测试警告日志:")打印;
    ("这是一条警告消息")日志警告;

    ("测试错误日志:")打印;
    ("这是一条错误消息")日志错误;

    // 设置日志级别为警告
    (2)设置日志级别;

    ("设置级别为警告后:")打印;
    ("调试消息（不应显示）")日志调试;
    ("信息消息（不应显示）")日志信息;
    ("警告消息（应显示）")日志警告;
    ("错误消息（应显示）")日志错误;

    ("=== 测试完成 ===")打印;
}
