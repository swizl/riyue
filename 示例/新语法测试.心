// 新语法测试

函数 (a:整数, b:整数)加法(0 = 结果:整数) {
    a + b = 结果;
}

函数 (x:整数)平方(0 = 结果:整数) {
    x * x = 结果;
}

函数 主程序 {
    ("=== 新语法测试 ===")打印;

    42 = x;
    3.14 = y;
    "你好" = 名字;

    (x)打印;
    (y)打印;
    (名字)打印;

    (3, 4)加法 = r1;
    (r1)打印;

    (3, 4)加法|平方 = r2;
    (r2)打印;

    ("=== 测试完成 ===")打印;
}
