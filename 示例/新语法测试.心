// 新语法测试

函数 (甲:整数, 乙:整数)加法(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 (变量值:整数)平方(0 = 结果:整数) {
    变量值 * 变量值 = 结果;
}

函数 主程序 {
    ("=== 新语法测试 ===")打印;

    42 = 变量值;
    3.14 = y;
    "你好" = 名字;

    (变量值)打印;
    (y)打印;
    (名字)打印;

    (3, 4)加法 = r1;
    (r1)打印;

    (3, 4)加法|平方 = r2;
    (r2)打印;

    ("=== 测试完成 ===")打印;
}
