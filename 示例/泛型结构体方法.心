// 泛型结构体方法特化测试（阶段4C1 第二切片）：
// 结构体方法按类型实参单态化（合成名 = 特化名_方法名），返回类型中的类型参数按实参替换。
结构体 对<A, B> {
    甲: A;
    乙: B;
    方法 取甲()(0 = 结果: A) {
        对.甲 = 结果;
    }
}

结构体 盒子<T> {
    值: T;
    方法 取值()(0 = 结果: T) {
        盒子.值 = 结果;
    }
}

函数 主程序 {
    ("=== 泛型结构体方法测试 ===")打印;

    对<整数, 字符串> { 甲: 7, 乙: "hi" } = p;
    ("取甲:")打印;
    (p.取甲())打印;

    盒子<整数> { 值: 42 } = b;
    ("盒值:")打印;
    (b.取值())打印;

    ("=== 测试完成 ===")打印;
}