// 字符串函数测试

函数 主程序 {
    ("=== 字符串函数测试 ===")打印;

    "Hello World" = text;

    ("长度:")打印;
    (text)长度 = len;
    (len)打印;

    ("查找:")打印;
    (text, "World")查找 = pos;
    (pos)打印;

    ("拼接:")打印;
    "Hello" + " " + "World" = c;
    (c)打印;

    ("转字符串:")打印;
    (42)转字符串 = s;
    (s)打印;

    ("=== 测试完成 ===")打印;
}
