// 结构体测试

结构体 点 {
    x: 整数;
    y: 整数;
}

函数 (p:点)打印点(空) {
    (p.x)打印;
    (p.y)打印;
}

函数 主程序 {
    ("=== 结构体测试 ===")打印;

    点 { x: 10, y: 20 } = p;
    ("点:")打印;
    (p.x)打印;
    (p.y)打印;

    100 = p.x;
    ("修改后:")打印;
    (p.x)打印;

    ("打印点:")打印;
    (p)打印点;

    ("=== 测试完成 ===")打印;
}
