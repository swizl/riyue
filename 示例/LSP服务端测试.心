// LSP 服务端会话逻辑测试（阶段9 G9）
// 覆盖：模块版本、initialize/shutdown/未知方法/exit 分派、
//       括号诊断（多余右括号 / 未闭合 / 字符串与注释跳过 / 行计数）、诊断帧构造。
// 说明：花括号 / 双引号避免出现在字面量中（构造期可能被识别为插值），
//       需要时以 `(码)字符` + `拼接` 构造。
导入 "../工具/LSP会话.心";

函数 主 {
    ("=== LSP服务端测试 ===")打印;

    // 1) 模块版本
    ()LSP模块版本 = 版本;
    (版本)打印;

    // 2) initialize 分派：应答正文 + 字符数 / 字节数（中文 serverInfo）
    (7, "initialize")构造请求 = 求;
    (求)报文正文 = 求体;
    (求体)LSP处理 = 应;
    (应)报文正文 = 应体;
    (应体)打印;
    (应体)长度 = 应字符数;
    (应字符数)打印;
    (应体)字节长度 = 应字节数;
    (应字节数)打印;
    (应)报文长度 = 应声明长;
    (应声明长)打印;

    // 3) shutdown 分派
    (9, "shutdown")构造请求 = 关求;
    (关求)报文正文 = 关体;
    (关体)LSP处理 = 关应;
    (关应)报文正文 = 关应体;
    (关应体)打印;

    // 4) 未知方法：有 id → -32601
    (11, "foo/bar")构造请求 = 未知求;
    (未知求)报文正文 = 未知体;
    (未知体)LSP处理 = 未知应;
    (未知应)报文正文 = 未知应体;
    (未知应体)打印;

    // 5) exit 通知：无应答，退出请求置 1
    ()构造退出通知 = 退帧;
    (退帧)报文正文 = 退体;
    (退体)LSP处理 = 退应;
    (退应)长度 = 退应长;
    (退应长)打印;
    (退出请求)打印;

    // 6) 诊断帧：多余的右括号（0 基：行 0 / 列 0）
    ("file:///a.riyue", ")")诊断帧 = 右帧;
    (右帧)报文正文 = 右体;
    (右体)打印;
    (右帧)报文长度 = 右长;
    (右长)打印;

    // 7) 未闭合（"(" 单独出现）
    ("file:///a.riyue", "(")诊断帧 = 未帧;
    (未帧)报文正文 = 未体;
    (未体)打印;

    // 8) 平衡：无诊断
    ("file:///a.riyue", "(甲[乙])")诊断帧 = 平帧;
    (平帧)报文正文 = 平体;
    (平体)打印;

    // 9) 字符串内的括号不计
    (34)字符 = 单;
    ("", 单)拼接 = 引符;
    ("(", 引符)拼接 = 串文本;
    (串文本, ")")拼接 = 串文本;
    (串文本, 引符)拼接 = 串文本;
    (串文本, ")")拼接 = 串文本;
    (串文本)括号诊断;
    (诊断种类)打印;

    // 10) 行注释内的括号不计
    ("(甲) // )")括号诊断;
    (诊断种类)打印;

    // 11) 跨行定位：第 0 行开圆括号，第 1 行出现多余的方右括号 → 行 1 / 列 0
    (10)字符 = 换行单;
    ("", 换行单)拼接 = 换行符;
    ("(", 换行符)拼接 = 跨行;
    (跨行, "]")拼接 = 跨行;
    (跨行)括号诊断;
    (诊断种类)打印;
    (诊断行)打印;
    (诊断列)打印;
}
