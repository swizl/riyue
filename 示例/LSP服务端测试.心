// LSP 服务端会话逻辑测试（阶段9 G9）
// 覆盖：模块版本、initialize/shutdown/未知方法/exit 分派、
//       括号诊断（多余右括号 / 未闭合 / 字符串与注释跳过 / 行计数）、诊断帧构造。
// 说明：花括号 / 双引号避免出现在字面量中（构造期可能被识别为插值），
//       需要时以 `(码)字符` + `拼接` 构造。
导入 "../工具/LSP会话.心";

函数 主 {
    ("=== LSP服务端测试 ===")打印;

    // 1) 模块版本
    ()LSP模块版本 = 版本;
    (版本)打印;

    // 2) initialize 分派：应答正文 + 字符数 / 字节数（中文 serverInfo）
    (7, "initialize")构造请求 = 求;
    (求)报文正文 = 求体;
    (求体)LSP处理 = 应;
    (应)报文正文 = 应体;
    (应体)打印;
    (应体)长度 = 应字符数;
    (应字符数)打印;
    (应体)字节长度 = 应字节数;
    (应字节数)打印;
    (应)报文长度 = 应声明长;
    (应声明长)打印;

    // 3) shutdown 分派
    (9, "shutdown")构造请求 = 关求;
    (关求)报文正文 = 关体;
    (关体)LSP处理 = 关应;
    (关应)报文正文 = 关应体;
    (关应体)打印;

    // 4) 未知方法：有 id → -32601
    (11, "foo/bar")构造请求 = 未知求;
    (未知求)报文正文 = 未知体;
    (未知体)LSP处理 = 未知应;
    (未知应)报文正文 = 未知应体;
    (未知应体)打印;

    // 5) exit 通知：无应答，退出请求置 1
    ()构造退出通知 = 退帧;
    (退帧)报文正文 = 退体;
    (退体)LSP处理 = 退应;
    (退应)长度 = 退应长;
    (退应长)打印;
    (退出请求)打印;

    // 6) 诊断帧：多余的右括号（0 基：行 0 / 列 0）
    ("file:///a.riyue", ")")诊断帧 = 右帧;
    (右帧)报文正文 = 右体;
    (右体)打印;
    (右帧)报文长度 = 右长;
    (右长)打印;

    // 7) 未闭合（"(" 单独出现）
    ("file:///a.riyue", "(")诊断帧 = 未帧;
    (未帧)报文正文 = 未体;
    (未体)打印;

    // 8) 平衡：无诊断
    ("file:///a.riyue", "(甲[乙])")诊断帧 = 平帧;
    (平帧)报文正文 = 平体;
    (平体)打印;

    // 9) 字符串内的括号不计
    (34)字符 = 单;
    ("", 单)拼接 = 引符;
    ("(", 引符)拼接 = 串文本;
    (串文本, ")")拼接 = 串文本;
    (串文本, 引符)拼接 = 串文本;
    (串文本, ")")拼接 = 串文本;
    (串文本)括号诊断;
    (诊断种类)打印;

    // 10) 行注释内的括号不计
    ("(甲) // )")括号诊断;
    (诊断种类)打印;

    // 11) 跨行定位：第 0 行开圆括号，第 1 行出现多余的方右括号 → 行 1 / 列 0
    (10)字符 = 换行单;
    ("", 换行单)拼接 = 换行符;
    ("(", 换行符)拼接 = 跨行;
    (跨行, "]")拼接 = 跨行;
    (跨行)括号诊断;
    (诊断种类)打印;
    (诊断行)打印;
    (诊断列)打印;

    // ============ 9A：补全 / 跳转 ============
    // 12) didOpen 建立文档（三行；第二行与第一行同含 计数器）
    (34)字符 = 单;
    ("", 单)拼接 = 引;
    (92)字符 = 单;
    ("", 单)拼接 = 反斜;
    (反斜, "n")拼接 = 换行转义;
    (反斜, 引)拼接 = 引转义;
    ("0 = 计数器;", 换行转义)拼接 = 文;
    (文, "计数器 + 1 = 计数器;")拼接 = 文;
    (文, 换行转义)拼接 = 文;
    (文, "总数 = 计数器;")拼接 = 文;

    (123)字符 = 单;
    ("", 单)拼接 = 左曲;
    (125)字符 = 单;
    ("", 单)拼接 = 右曲;
    "" = 参;
    (参, 左曲)拼接 = 参;
    (参, 引)拼接 = 参;
    (参, "textDocument")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, ":")拼接 = 参;
    (参, 左曲)拼接 = 参;
    (参, 引)拼接 = 参;
    (参, "uri")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, ":")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, "file:///b.riyue")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, ",")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, "text")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, ":")拼接 = 参;
    (参, 引)拼接 = 参;
    (参, 文)拼接 = 参;
    (参, 引)拼接 = 参;
    (参, 右曲)拼接 = 参;
    (参, 右曲)拼接 = 参;
    (20, "textDocument/didOpen", 参)构造请求带参数 = 开求;
    (开求)报文正文 = 开体;
    (开体)LSP处理 = 开应;
    (开应)报文正文 = 开应体;
    (开应体)打印;

    // 13) 补全：固定关键字 25 项 + 文档标识符（计数器 / 总数）→ 27 项
    (21, "textDocument/completion", 参)构造请求带参数 = 全求;
    (全求)报文正文 = 全体;
    (全体)LSP处理 = 全应;
    (全应)报文正文 = 全应体;
    (全应体)打印;

    // 14) 跳转：第 1 行第 2 列（计数器 内）→ 首次出现在第 0 行第 4 列，宽 3 字符
    "" = 位参;
    (位参, 左曲)拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, "textDocument")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, ":")拼接 = 位参;
    (位参, 左曲)拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, "uri")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, ":")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, "file:///b.riyue")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, 右曲)拼接 = 位参;
    (位参, ",")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, "position")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, ":")拼接 = 位参;
    (位参, 左曲)拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, "line")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, ":1,")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, "character")拼接 = 位参;
    (位参, 引)拼接 = 位参;
    (位参, ":2")拼接 = 位参;
    (位参, 右曲)拼接 = 位参;
    (位参, 右曲)拼接 = 位参;
    (22, "textDocument/definition", 位参)构造请求带参数 = 跳求;
    (跳求)报文正文 = 跳体;
    (跳体)LSP处理 = 跳应;
    (跳应)报文正文 = 跳应体;
    (跳应体)打印;

    // 15) 跳转：第 1 行第 6 列（数字 1，非标识符首）→ result:null
    "" = 空参;
    (空参, 左曲)拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, "textDocument")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, ":")拼接 = 空参;
    (空参, 左曲)拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, "uri")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, ":")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, "file:///b.riyue")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, 右曲)拼接 = 空参;
    (空参, ",")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, "position")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, ":")拼接 = 空参;
    (空参, 左曲)拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, "line")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, ":1,")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, "character")拼接 = 空参;
    (空参, 引)拼接 = 空参;
    (空参, ":6")拼接 = 空参;
    (空参, 右曲)拼接 = 空参;
    (空参, 右曲)拼接 = 空参;
    (23, "textDocument/definition", 空参)构造请求带参数 = 无求;
    (无求)报文正文 = 无体;
    (无体)LSP处理 = 无应;
    (无应)报文正文 = 无应体;
    (无应体)打印;

    // ============ 9B：语法 / 类型诊断 ============
    // 16) 字符串未闭合：`0 = "abc`（开引号在第 0 行第 4 列）
    (34)字符 = 单;
    ("", 单)拼接 = 引;
    ("0 = ", 引)拼接 = 断文;
    (断文, "abc")拼接 = 断文;
    ("file:///c.riyue", 断文)诊断帧 = 断帧;
    (断帧)报文正文 = 断体;
    (断体)打印;

    // 17) 全角逗号（第 0 行第 1 列）
    (65292)字符 = 单;
    ("", 单)拼接 = 全角逗;
    ("甲", 全角逗)拼接 = 全角文;
    ("file:///c.riyue", 全角文)诊断帧 = 角帧;
    (角帧)报文正文 = 角体;
    (角体)打印;

    // 18) 类型不符：`"" = 结果:整数`（第 0 行第 0 列）
    (34)字符 = 单;
    ("", 单)拼接 = 引二;
    ("", 引二)拼接 = 标文;
    (标文, 引二)拼接 = 标文;
    (标文, " = 结果:整数")拼接 = 标文;
    ("file:///c.riyue", 标文)诊断帧 = 标帧;
    (标帧)报文正文 = 标体;
    (标体)打印;
}
