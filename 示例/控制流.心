// 日月编译器 - 功能演示
// 展示：函数参数、返回值、算术运算、比较运算、逻辑运算、
//       否则如果、当循环、继续、用户函数调用、块作用域

// 计算阶乘（递归）
函数 阶乘(数): 整数 {
    如果 (数 <= 1) {
        返回 1;
    }
    返回 数 * 阶乘(数 - 1);
}

// 计算斐波那契数（循环）
函数 斐波那契(数): 整数 {
    如果 (数 <= 0) {
        返回 0;
    }
    变量 前一个 = 0;
    变量 当前 = 1;
    变量 计数 = 1;
    当 (计数 < 数) {
        变量 临时 = 当前;
        当前 = 当前 + 前一个;
        前一个 = 临时;
        计数 = 计数 + 1;
    }
    返回 当前;
}

// 最大公约数（辗转相除法）
函数 最大公约数(甲, 乙): 整数 {
    当 (乙 != 0) {
        变量 临时 = 乙;
        乙 = 甲 % 乙;
        甲 = 临时;
    }
    返回 甲;
}

// 主程序
函数 主程序(): 空 {
    // 算术运算演示
    变量 甲 = 10;
    变量 乙 = 3;
    打印(甲 + 乙);   // 13
    打印(甲 - 乙);   // 7
    打印(甲 * 乙);   // 30
    打印(甲 / 乙);   // 3
    打印(甲 % 乙);   // 1

    // 比较运算演示（?=" 等于）
    打印(甲 ?= 10);   // 1（真）
    打印(甲 != 乙);   // 1（真）
    打印(甲 > 乙);    // 1（真）
    打印(甲 <= 5);    // 0（假）

    // 逻辑运算演示
    打印(1 && 1);    // 1
    打印(1 && 0);    // 0
    打印(0 || 1);    // 1
    打印(!0);         // 1

    // 否则如果演示
    变量 值 = 15;
    如果 (值 < 10) {
        打印(1);
    } 否则如果 (值 < 20) {
        打印(2);      // 输出 2
    } 否则 {
        打印(3);
    }

    // 当循环与继续
    变量 循环计数 = 0;
    当 (循环计数 < 10) {
        循环计数 = 循环计数 + 1;
        如果 (循环计数 % 2 ?= 0) {
            继续;
        }
        打印(循环计数);  // 1, 3, 5, 7, 9
    }

    // 用户函数调用
    打印(阶乘(5));       // 120
    打印(阶乘(10));      // 3628800
    打印(斐波那契(1));   // 1
    打印(斐波那契(10));  // 55
    打印(最大公约数(12, 8)); // 4

    // 块作用域演示
    变量 外层 = 100;
    {
        变量 内层 = 200;
        打印(外层 + 内层);  // 300
    }
    打印(外层);  // 100

    // 取负运算
    变量 负数 = -42;
    打印(负数);    // -42
}
