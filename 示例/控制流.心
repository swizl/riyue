// 控制流测试

函数 (n:整数)阶乘(1 = 结果:整数) {
    如果 (n <= 1) {
        1 = 结果;
    } 否则 {
        n - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        n * 递归结果 = 结果;
    }
}

函数 主程序 {
    ("=== 控制流测试 ===")打印;

    (10)阶乘 = r1;
    (r1)打印;

    42 = x;
    如果 (x > 100) {
        ("大于100")打印;
    } 否则如果 (x > 50) {
        ("大于50")打印;
    } 否则 {
        ("小于等于50")打印;
    }

    ("=== 测试完成 ===")打印;
}
