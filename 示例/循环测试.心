// for 循环测试
函数 主程序(): 空 {
    打印("=== for 循环测试 ===");

    // 基本 for 循环
    打印("1. 基本 for 循环:");
    循环 (变量 i = 0; i < 5; i += 1) {
        打印(i);
    }

    // 求和
    打印("2. 求和 1-100:");
    变量 总和 = 0;
    循环 (变量 i = 1; i <= 100; i += 1) {
        总和 = 总和 + i;
    }
    打印(总和);

    // 嵌套 for 循环
    打印("3. 嵌套 for 循环 (九九乘法表):");
    循环 (变量 i = 1; i <= 9; i += 1) {
        循环 (变量 j = 1; j <= i; j += 1) {
            打印(j * i);
        }
    }

    // 无限循环 with break
    打印("4. 无限循环 with break:");
    变量 计数 = 0;
    循环 {
        计数 = 计数 + 1;
        如果 (计数 >= 5) {
            中断;
        }
        打印(计数);
    }

    // for 循环 with continue
    打印("5. for 循环 with continue:");
    循环 (变量 i = 0; i < 10; i += 1) {
        如果 (i % 2 ?= 0) {
            继续;
        }
        打印(i);
    }

    打印("=== 测试完成 ===");
}
