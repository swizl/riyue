// 递归测试

函数 (数量:整数)阶乘(1 = 结果:整数) {
    如果 (数量 <= 1) {
        1 = 结果;
    } 否则 {
        数量 - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        数量 * 递归结果 = 结果;
    }
}

函数 (甲:整数, 乙:整数)最大公约数(0 = 结果:整数) {
    当 (乙 != 0) {
        乙 = 临时;
        甲 % 乙 = 乙;
        临时 = 甲;
    }
    甲 = 结果;
}

函数 (数量:整数)斐波那契(0 = 结果:整数) {
    如果 (数量 <= 0) {
        0 = 结果;
    } 否则如果 (数量 ?= 1) {
        1 = 结果;
    } 否则 {
        数量 - 1 = 甲;
        数量 - 2 = 乙;
        (甲)斐波那契 = fa;
        (乙)斐波那契 = fb;
        fa + fb = 结果;
    }
}

函数 主程序 {
    ("=== 递归测试 ===")打印;

    (10)阶乘 = r1;
    (r1)打印;

    (48, 18)最大公约数 = r2;
    (r2)打印;

    (10)斐波那契 = r3;
    (r3)打印;

    (5)阶乘 = r4;
    (r4)打印;

    ("=== 测试完成 ===")打印;
}
