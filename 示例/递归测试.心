// 递归测试 - 纯整数运算
函数 阶乘(数): 整数 {
    如果 (数 <= 1) {
        返回 1;
    }
    返回 数 * 阶乘(数 - 1);
}

函数 斐波那契(数): 整数 {
    如果 (数 <= 1) {
        返回 数;
    }
    返回 斐波那契(数 - 1) + 斐波那契(数 - 2);
}

函数 最大公约数(甲, 乙): 整数 {
    当 (乙 != 0) {
        变量 临时 = 乙;
        乙 = 甲 % 乙;
        甲 = 临时;
    }
    返回 甲;
}

函数 主程序(): 空 {
    打印(阶乘(10));
    打印(斐波那契(10));
    打印(最大公约数(48, 18));
    打印(阶乘(5));
    打印(斐波那契(7));
}
