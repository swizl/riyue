// 递归测试

函数 (n:整数)阶乘(1 = 结果:整数) {
    如果 (n <= 1) {
        1 = 结果;
    } 否则 {
        n - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        n * 递归结果 = 结果;
    }
}

函数 (a:整数, b:整数)最大公约数(0 = 结果:整数) {
    当 (b != 0) {
        b = 临时;
        a % b = b;
        临时 = a;
    }
    a = 结果;
}

函数 (n:整数)斐波那契(0 = 结果:整数) {
    如果 (n <= 0) {
        0 = 结果;
    } 否则如果 (n ?= 1) {
        1 = 结果;
    } 否则 {
        n - 1 = a;
        n - 2 = b;
        (a)斐波那契 = fa;
        (b)斐波那契 = fb;
        fa + fb = 结果;
    }
}

函数 主程序 {
    ("=== 递归测试 ===")打印;

    (10)阶乘 = r1;
    (r1)打印;

    (48, 18)最大公约数 = r2;
    (r2)打印;

    (10)斐波那契 = r3;
    (r3)打印;

    (5)阶乘 = r4;
    (r4)打印;

    ("=== 测试完成 ===")打印;
}
