// 二进制序列化 测试（字节数组接口，UTF-8 文本）

导入 "标准库/二进制.心";

函数 主程序 {
    ("=== 二进制序列化 测试 ===")打印;

    ("-- 写入")打印;
    ()创建动态数组 = 缓冲;
    (300, 缓冲)二进制写整数;
    (0 - 2, 缓冲)二进制写整数;
    ("A中B", 缓冲)二进制写文本;
    ("", 缓冲)二进制写文本;
    ()创建动态数组 = 载荷;
    (载荷, 1)动态数组添加;
    (载荷, 2)动态数组添加;
    (载荷, 255)动态数组添加;
    (载荷, 缓冲)二进制写字节块;
    (300, 缓冲)二进制写变长;
    (缓冲)二进制转十六进制 = 十六;
    (十六)打印;

    ("-- 读取")打印;
    ()创建动态数组 = 游标;
    (游标, 0)动态数组添加;
    ("整数1")打印;
    (缓冲, 游标)二进制读整数 = 甲;
    (甲)打印;
    ("整数2")打印;
    (缓冲, 游标)二进制读整数 = 乙;
    (乙)打印;
    ("文本1")打印;
    (缓冲, 游标)二进制读文本 = 丙;
    (丙)打印;
    ("码点数1")打印;
    (丙)长度 = 丙长;
    (丙长)打印;
    ("文本2")打印;
    (缓冲, 游标)二进制读文本 = 丁;
    (丁)打印;
    ("码点数2")打印;
    (丁)长度 = 丁长;
    (丁长)打印;
    ("字节块个数")打印;
    ()创建动态数组 = 回读;
    (缓冲, 游标, 回读)二进制读字节块 = 戊;
    (戊)打印;
    (回读)动态数组大小 = 回读长;
    (回读长)打印;
    0 = k;
    当 (k < 回读长) {
        (回读, k)动态数组获取 = 元素;
        (元素)打印;
        k + 1 = k;
    }
    ("变长")打印;
    (缓冲, 游标)二进制读变长 = 己;
    (己)打印;

    ("=== 测试完成 ===")打印;
}
