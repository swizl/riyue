函数 主程序 {
    ("=== 新功能测试 ===")打印;

    ("--- 日期时间 ---")打印;
    获取日期() = 日期;
    (日期)打印;

    获取时间() = 时间;
    (时间)打印;

    获取年份() = 年;
    (年)打印;

