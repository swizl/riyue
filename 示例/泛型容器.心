// 泛型容器测试（阶段4C2）：标准库 栈<T> / 列表<T>（泛型结构体 + 容器方法）。
// 覆盖：入栈/出栈/长度（栈）、添加/获取/长度（列表）。
// 内建动态数组为整数元素，故以 <整数> 实例化。

导入 "../标准库/栈.心";
导入 "../标准库/列表.心";

函数 主程序 {
    ("=== 泛型容器测试 ===")打印;

    栈<整数> { 数据: ()创建动态数组, 数量: 0 } = s;
    s.入栈(10);
    s.入栈(20);
    s.入栈(30);
    ("栈长度:")打印;
    (s.长度())打印;
    ("出栈:")打印;
    (s.出栈())打印;
    (s.出栈())打印;
    ("栈长度:")打印;
    (s.长度())打印;

    列表<整数> { 数据: ()创建动态数组, 数量: 0 } = l;
    l.添加(100);
    l.添加(200);
    l.添加(300);
    ("列表长度:")打印;
    (l.长度())打印;
    ("列表[1]:")打印;
    (l.获取(1))打印;

    ("=== 测试完成 ===")打印;
}