// 并发（通道 / 协程）运行期封装测试：通道填充/收集和/转发/收集到 + 协程驱动/收集到。
// 说明：`并发.心` 的句柄形参不加类型标注；输出动态数组须先预置槽位再逐槽覆盖。
导入 "../标准库/并发.心";

协程 (上限:整数)计数 {
    0 = i;
    当 (i < 上限) {
        让出 i;
        i + 1 = i;
    }
}

函数 主 {
    ("=== 并发封装测试 ===")打印;

    (8)创建通道 = 甲;
    (甲, 4, 10)通道填充;
    (甲, 4)通道收集和 = 和;
    (和)打印;

    (8)创建通道 = 乙;
    (甲, 4, 1)通道填充;
    (甲, 乙, 3)通道转发;
    ()创建动态数组 = 出;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;
    (乙, 3, 出)通道收集到;
    (出, 0)动态数组获取 = a;
    (a)打印;
    (出, 1)动态数组获取 = b;
    (b)打印;
    (出, 2)动态数组获取 = c;
    (c)打印;
    (甲, 1)通道收集和 = 余;
    (余)打印;

    (3)计数 = 协;
    (协, 3)协程驱动 = 末;
    (末)打印;

    (3)计数 = 协2;
    ()创建动态数组 = 步;
    (步, 0)动态数组添加;
    (步, 0)动态数组添加;
    (步, 0)动态数组添加;
    (协2, 3, 步)协程收集到;
    (步, 0)动态数组获取 = x;
    (x)打印;
    (步, 1)动态数组获取 = y;
    (y)打印;
    (步, 2)动态数组获取 = z;
    (z)打印;

    ("=== 完成 ===")打印;
}
