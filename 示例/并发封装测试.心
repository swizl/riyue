// 并发（通道 / 协程）运行期封装测试：通道填充/收集和/转发/收集到 + 协程驱动/收集到。
// 说明：`并发.心` 的句柄形参不加类型标注；输出动态数组须先预置槽位再逐槽覆盖。
导入 "../标准库/并发.心";

协程 (上限:整数)计数 {
    0 = i;
    当 (i < 上限) {
        让出 i;
        i + 1 = i;
    }
}

函数 主 {
    ("=== 并发封装测试 ===")打印;

    (8)创建通道 = 甲;
    (甲, 4, 10)通道填充;
    (甲, 4)通道收集和 = 和;
    (和)打印;

    (8)创建通道 = 乙;
    (甲, 4, 1)通道填充;
    (甲, 乙, 3)通道转发;
    ()创建动态数组 = 出;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;
    (出, 0)动态数组添加;
    (乙, 3, 出)通道收集到;
    (出, 0)动态数组获取 = a;
    (a)打印;
    (出, 1)动态数组获取 = b;
    (b)打印;
    (出, 2)动态数组获取 = c;
    (c)打印;
    (甲, 1)通道收集和 = 余;
    (余)打印;

    (3)计数 = 协;
    (协, 3)协程驱动 = 末;
    (末)打印;

    (3)计数 = 协2;
    ()创建动态数组 = 步;
    (步, 0)动态数组添加;
    (步, 0)动态数组添加;
    (步, 0)动态数组添加;
    (协2, 3, 步)协程收集到;
    (步, 0)动态数组获取 = x;
    (x)打印;
    (步, 1)动态数组获取 = y;
    (y)打印;
    (步, 2)动态数组获取 = z;
    (z)打印;

    // 8CL 续增：倒序填充 / 计数正 / 累加转发
    (8)创建通道 = 丙;
    (丙, 4, 9)通道填充倒序;
    ()创建动态数组 = 倒;
    (倒, 0)动态数组添加;
    (倒, 0)动态数组添加;
    (倒, 0)动态数组添加;
    (倒, 0)动态数组添加;
    (丙, 4, 倒)通道收集到;
    (倒, 0)动态数组获取 = d0;
    (d0)打印;
    (倒, 1)动态数组获取 = d1;
    (d1)打印;
    (倒, 2)动态数组获取 = d2;
    (d2)打印;
    (倒, 3)动态数组获取 = d3;
    (d3)打印;

    (8)创建通道 = 丁;
    (丁, 4, 2)通道填充倒序;
    (丁, 4)通道计数正 = 正数;
    (正数)打印;

    (8)创建通道 = 戊;
    (8)创建通道 = 己;
    (戊, 3, 5)通道填充;
    (戊, 3, 己)通道累加到;
    (己, 1)通道收集和 = 和2;
    (和2)打印;

    // 8CP 续增：收集到倒序 / 折叠 / 最大值 / 过滤正到
    (8)创建通道 = 庚;
    (庚, 4, 3)通道填充;
    ()创建动态数组 = 倒2;
    (倒2, 0)动态数组添加;
    (倒2, 0)动态数组添加;
    (倒2, 0)动态数组添加;
    (倒2, 0)动态数组添加;
    (庚, 4, 倒2)通道收集到倒序;
    (倒2, 0)动态数组获取 = e0;
    (e0)打印;
    (倒2, 1)动态数组获取 = e1;
    (e1)打印;
    (倒2, 2)动态数组获取 = e2;
    (e2)打印;
    (倒2, 3)动态数组获取 = e3;
    (e3)打印;

    (8)创建通道 = 辛;
    (辛, 4, 1)通道填充;
    (辛, 4, 100)通道折叠 = 折叠;
    (折叠)打印;

    (8)创建通道 = 壬;
    (壬, 4, 5)通道填充;
    (壬, 4)通道最大值 = 最大;
    (最大)打印;

    (8)创建通道 = 癸;
    (8)创建通道 = 子;
    (癸, 5, 1)通道填充倒序;
    (癸, 5, 子)通道过滤正到;
    (子, 1)通道收集和 = 滤和;
    (滤和)打印;

    // 8CT 续增：最小值 / 计数超过 / 计数零 / 偶数和
    (8)创建通道 = 丑;
    (丑, 4, 5)通道填充;
    (丑, 4)通道最小值 = 最小;
    (最小)打印;

    (8)创建通道 = 寅;
    (寅, 4, 1)通道填充;
    (寅, 4, 2)通道计数超过 = 超数;
    (超数)打印;

    (8)创建通道 = 卯;
    (卯, 0)发送;
    (卯, 1)发送;
    (卯, 0)发送;
    (卯, 0)发送;
    (卯, 4)通道计数零 = 零数;
    (零数)打印;

    (8)创建通道 = 辰;
    (辰, 2)发送;
    (辰, 3)发送;
    (辰, 4)发送;
    (辰, 5)发送;
    (辰, 4)通道偶数和 = 偶和;
    (偶和)打印;

    ("=== 完成 ===")打印;
}
