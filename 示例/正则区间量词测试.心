// 正则区间量词测试（8BB）
//
// 导入 标准库/正则.心，验证区间量词 `{m}`（恰好 m 次）/`{m,}`（至少 m 次）/`{m,n}`（m 到 n 次），
// 含贪婪匹配与失败回溯；并验证非法/未闭合 `{` 退化为字面字符。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/正则.心";

函数 主程序 {
    ("=== 正则区间量词测试（8BB）===")打印;

    ("-- '{m}'（恰好 m 次）--")打印;
    ("aaa", "a{3}")正则匹配 = r1;
    (r1)打印;
    ("aa", "a{3}")正则匹配 = r2;
    (r2)打印;
    ("aaaa", "a{3}")正则匹配 = r3;
    (r3)打印;
    ("abc123", "\\d{3}")正则匹配 = r4;
    (r4)打印;
    ("abc12", "\\d{3}")正则匹配 = r5;
    (r5)打印;

    ("-- '{m,}'（至少 m 次）--")打印;
    ("aaaa", "a{2,}")正则匹配 = r6;
    (r6)打印;
    ("a", "a{2,}")正则匹配 = r7;
    (r7)打印;
    ("aaaa", "a{2,}$")正则匹配 = r8;
    (r8)打印;
    ("aaa", "a{4,}")正则匹配 = r9;
    (r9)打印;

    ("-- '{m,n}'（m 到 n 次）--")打印;
    ("aa", "a{2,3}")正则匹配 = r10;
    (r10)打印;
    ("a", "a{2,3}")正则匹配 = r11;
    (r11)打印;
    ("aaa", "^a{2,3}$")正则匹配 = r12;
    (r12)打印;
    ("aaaa", "^a{2,3}$")正则匹配 = r13;
    (r13)打印;

    ("-- 贪婪与回溯 --")打印;
    ("aab", "a{3}b")正则匹配 = r14;
    (r14)打印;
    ("aaab", "a{3}b")正则匹配 = r15;
    (r15)打印;
    ("b", "a{0,2}b")正则匹配 = r16;
    (r16)打印;
    ("aaab", "a{2,3}b")正则匹配 = r17;
    (r17)打印;
    ("xaaay", "a{2,3}")正则查找 = r18;
    (r18)打印;

    ("-- 非法/未闭合 `{` 退化为字面 --")打印;
    ("a{b", "a{b")正则匹配 = r19;
    (r19)打印;
    ("a{", "a{")正则匹配 = r20;
    (r20)打印;

    ("=== 测试完成 ===")打印;
}
