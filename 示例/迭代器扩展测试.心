// 迭代器扩展测试（续59）：字符串数组急切适配器 + 标量字符串按码点游标
导入 "../标准库/迭代器.心";

函数 (数组)打印文本数组 {
    (数组)动态字符串数组大小 = 数;
    0 = i;
    当 (i < 数) {
        (数组, i)动态字符串数组获取 = 值;
        (值)打印;
        i + 1 = i;
    }
}

函数 主程序 {
    ("=== 迭代器扩展测试 ===")打印;

    ("-- 模块版本 --")打印;
    ()迭代器模块版本 = 版本;
    (版本)打印;

    ()创建动态字符串数组 = 词表;
    (词表, "甲")动态字符串数组添加;
    (词表, "乙丙")动态字符串数组添加;
    (词表, "丁")动态字符串数组添加;
    (词表, "戊己")动态字符串数组添加;

    ("-- 文本加前缀 --")打印;
    (词表, "第")迭代器文本加前缀 = 编号表;
    (编号表)打印文本数组;

    ("-- 文本加后缀 --")打印;
    (词表, "字")迭代器文本加后缀 = 带尾表;
    (带尾表)打印文本数组;

    ("-- 文本过滤（长度 > 1） --")打印;
    入(串:字符串)函数(结果: 整数) {
        (串)长度 > 1 = 结果;
    } = 长于一字;
    (词表, 长于一字)迭代器文本过滤 = 长词;
    (长词)打印文本数组;

    ("-- 文本取前 2 --")打印;
    (词表, 2)迭代器文本取 = 前二;
    (前二)打印文本数组;

    ("-- 文本跳过 2 --")打印;
    (词表, 2)迭代器文本跳过 = 后二;
    (后二)打印文本数组;

    ("-- 文本连接 --")打印;
    (前二, 后二)迭代器文本连接 = 全表;
    (全表)打印文本数组;

    ("-- 文本反转 --")打印;
    (词表)迭代器文本反转 = 逆序;
    (逆序)打印文本数组;

    ("-- 文本计数 --")打印;
    (词表)迭代器文本计数 = 个数;
    (个数)打印;

    ("-- 字符串按码点游标 --")打印;
    ("日月心")迭代器字符串游标 = 字符游标;
    1 = 未结束;
    当 (未结束 ?= 1) {
        ("日月心", 字符游标)迭代器字符串有下一个 = 有;
        如果 (有 ?= 1) {
            ("日月心", 字符游标)迭代器下一个字符 = 字;
            (字)打印;
        } 否则 {
            0 = 未结束;
        }
    }

    ("=== 测试完成 ===")打印;
}
