// 平衡树（AVL）测试：有序/逆序/之字形插入触发四种旋转，验证高度受控与查找正确

导入 "标准库/平衡树.心";

// 打印整数数组（逐元素一行）
函数 (数组)打印整数数组(空) {
    (数组)动态数组大小 = 个数;
    0 = k;
    当 (k < 个数) {
        (数组, k)动态数组获取 = 元;
        (元)打印;
        k + 1 = k;
    }
}

函数 主程序 {
    ("=== 平衡树测试 ===")打印;

    平衡树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 高: ()创建动态数组, 根: -1, 数量: 0 } = t;

    // 有序插入 1..7：朴素 BST 高度为 7，AVL 应压到 3（反复 RR → 左旋）
    t.插入(1);
    t.插入(2);
    t.插入(3);
    t.插入(4);
    t.插入(5);
    t.插入(6);
    t.插入(7);

    ("长度:")打印;
    (t.长度())打印;

    ("树高:")打印;
    (t.树高())打印;

    ("最小:")打印;
    (t.最小())打印;
    ("最大:")打印;
    (t.最大())打印;

    ("包含 4:")打印;
    (t.包含(4))打印;
    ("包含 9:")打印;
    (t.包含(9))打印;

    // 重复键应被忽略
    t.插入(4);
    ("长度2:")打印;
    (t.长度())打印;

    // 乱序插入
    平衡树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 高: ()创建动态数组, 根: -1, 数量: 0 } = u;
    u.插入(50);
    u.插入(30);
    u.插入(70);
    u.插入(20);
    u.插入(40);
    u.插入(60);
    u.插入(80);
    ("长度3:")打印;
    (u.长度())打印;
    ("树高2:")打印;
    (u.树高())打印;
    ("最小2:")打印;
    (u.最小())打印;
    ("最大2:")打印;
    (u.最大())打印;

    // 逆序插入 7..1：触发 LL → 右旋
    平衡树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 高: ()创建动态数组, 根: -1, 数量: 0 } = v;
    7 = i;
    当 (i >= 1) {
        v.插入(i);
        i - 1 = i;
    }
    ("长度4:")打印;
    (v.长度())打印;
    ("树高3:")打印;
    (v.树高())打印;
    ("最小3:")打印;
    (v.最小())打印;
    ("最大3:")打印;
    (v.最大())打印;

    // 之字形 3,1,2：触发 LR（先左旋后右旋）
    平衡树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 高: ()创建动态数组, 根: -1, 数量: 0 } = w;
    w.插入(3);
    w.插入(1);
    w.插入(2);
    ("长度5:")打印;
    (w.长度())打印;
    ("树高4:")打印;
    (w.树高())打印;
    ("最小4:")打印;
    (w.最小())打印;
    ("最大4:")打印;
    (w.最大())打印;

    // 较大规模：1..15 有序插入，AVL 高度应为 4（log2(16)）
    平衡树<整数> { 值: ()创建动态数组, 左: ()创建动态数组, 右: ()创建动态数组, 高: ()创建动态数组, 根: -1, 数量: 0 } = big;
    1 = j;
    当 (j <= 15) {
        big.插入(j);
        j + 1 = j;
    }
    ("长度6:")打印;
    (big.长度())打印;
    ("树高5:")打印;
    (big.树高())打印;

    // 中序遍历（升序）
    ()创建动态数组 = 有序;
    t.中序遍历(有序);
    ("中序:")打印;
    (有序)打印整数数组;

    // 删除双子节点（根 4）：中序后继 5 值上移后摘除后继
    t.删除(4);
    ("删除4后长度:")打印;
    (t.长度())打印;
    ("删除4后树高:")打印;
    (t.树高())打印;
    ("删除4后包含4:")打印;
    (t.包含(4))打印;
    ("删除4后中序:")打印;
    ()创建动态数组 = 序2;
    t.中序遍历(序2);
    (序2)打印整数数组;

    // 删除叶节点 1
    t.删除(1);
    ("删除1后长度:")打印;
    (t.长度())打印;
    ("删除1后中序:")打印;
    ()创建动态数组 = 序3;
    t.中序遍历(序3);
    (序3)打印整数数组;

    // 删除叶节点 7
    t.删除(7);
    ("删除7后长度:")打印;
    (t.长度())打印;
    ("删除7后中序:")打印;
    ()创建动态数组 = 序4;
    t.中序遍历(序4);
    (序4)打印整数数组;

    // 删除不存在的键：长度不变
    t.删除(99);
    ("删除99后长度:")打印;
    (t.长度())打印;

    ("=== 测试完成 ===")打印;
}
