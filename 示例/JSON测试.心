// JSON 完整解析 / 生成 测试（RFC 8259 子集）

导入 "标准库/JSON解析.心";

// 打印单个节点的全部字段（类型 / 键 / 值 / 子数 / 首子）
函数 (类型, 值, 键, 首子, 子数, 兄弟, 节点:整数)打印节点(空) {
    (类型, 节点)动态数组获取 = 类型码;
    (值, 节点)动态字符串数组获取 = 文;
    (键, 节点)动态字符串数组获取 = 名;
    (子数, 节点)动态数组获取 = 个数;
    (首子, 节点)动态数组获取 = 首个;
    ("节点")打印;
    (节点)打印;
    ("类型")打印;
    (类型码)打印;
    ("键")打印;
    (名)打印;
    ("值")打印;
    (文)打印;
    ("子数")打印;
    (个数)打印;
    ("首子")打印;
    (首个)打印;
}

函数 主程序 {
    ("=== JSON 测试 ===")打印;

    ("-- 复合文档")打印;
    ()创建动态数组 = 类型;
    ()创建动态字符串数组 = 值;
    ()创建动态字符串数组 = 键;
    ()创建动态数组 = 首子;
    ()创建动态数组 = 子数;
    ()创建动态数组 = 兄弟;
    ("{\"a\":1,\"b\":[true,null,\"x,y\"],\"c\":{\"d\":-2.5}}", 类型, 值, 键, 首子, 子数, 兄弟)JSON解析 = 状;
    ("状态")打印;
    (状)打印;
    (类型)动态数组大小 = 节点数;
    ("节点数")打印;
    (节点数)打印;
    0 = i;
    当 (i < 节点数) {
        (类型, 值, 键, 首子, 子数, 兄弟, i)打印节点;
        i + 1 = i;
    }
    ("生成")打印;
    (类型, 值, 键, 首子, 子数, 兄弟)JSON生成 = 文;
    (文)打印;

    ("-- 往返 生成→解析→生成")打印;
    ()创建动态数组 = 类型乙;
    ()创建动态字符串数组 = 值乙;
    ()创建动态字符串数组 = 键乙;
    ()创建动态数组 = 首子乙;
    ()创建动态数组 = 子数乙;
    ()创建动态数组 = 兄弟乙;
    (文, 类型乙, 值乙, 键乙, 首子乙, 子数乙, 兄弟乙)JSON解析 = 状乙;
    ("状态")打印;
    (状乙)打印;
    (类型乙, 值乙, 键乙, 首子乙, 子数乙, 兄弟乙)JSON生成 = 文乙;
    (文乙)打印;

    ("-- 数字")打印;
    ()创建动态数组 = 类型丙;
    ()创建动态字符串数组 = 值丙;
    ()创建动态字符串数组 = 键丙;
    ()创建动态数组 = 首子丙;
    ()创建动态数组 = 子数丙;
    ()创建动态数组 = 兄弟丙;
    ("-12.5e3", 类型丙, 值丙, 键丙, 首子丙, 子数丙, 兄弟丙)JSON解析 = 状丙;
    (类型丙, 值丙, 键丙, 首子丙, 子数丙, 兄弟丙)JSON生成 = 文丙;
    (文丙)打印;

    ("-- 字符串转义")打印;
    ()创建动态数组 = 类型丁;
    ()创建动态字符串数组 = 值丁;
    ()创建动态字符串数组 = 键丁;
    ()创建动态数组 = 首子丁;
    ()创建动态数组 = 子数丁;
    ()创建动态数组 = 兄弟丁;
    ("\"a\\nb\\\"c\"", 类型丁, 值丁, 键丁, 首子丁, 子数丁, 兄弟丁)JSON解析 = 状丁;
    (类型丁, 值丁, 键丁, 首子丁, 子数丁, 兄弟丁)JSON生成 = 文丁;
    (文丁)打印;

    ("-- unicode 转义")打印;
    ()创建动态数组 = 类型戊;
    ()创建动态字符串数组 = 值戊;
    ()创建动态字符串数组 = 键戊;
    ()创建动态数组 = 首子戊;
    ()创建动态数组 = 子数戊;
    ()创建动态数组 = 兄弟戊;
    ("\"A\\u0042C\"", 类型戊, 值戊, 键戊, 首子戊, 子数戊, 兄弟戊)JSON解析 = 状戊;
    (类型戊, 值戊, 键戊, 首子戊, 子数戊, 兄弟戊)JSON生成 = 文戊;
    (文戊)打印;

    ("-- 空对象")打印;
    ()创建动态数组 = 类型己;
    ()创建动态字符串数组 = 值己;
    ()创建动态字符串数组 = 键己;
    ()创建动态数组 = 首子己;
    ()创建动态数组 = 子数己;
    ()创建动态数组 = 兄弟己;
    ("{}", 类型己, 值己, 键己, 首子己, 子数己, 兄弟己)JSON解析 = 状己;
    (类型己, 值己, 键己, 首子己, 子数己, 兄弟己)JSON生成 = 文己;
    (文己)打印;

    ("-- 空数组")打印;
    ()创建动态数组 = 类型庚;
    ()创建动态字符串数组 = 值庚;
    ()创建动态字符串数组 = 键庚;
    ()创建动态数组 = 首子庚;
    ()创建动态数组 = 子数庚;
    ()创建动态数组 = 兄弟庚;
    ("[]", 类型庚, 值庚, 键庚, 首子庚, 子数庚, 兄弟庚)JSON解析 = 状庚;
    (类型庚, 值庚, 键庚, 首子庚, 子数庚, 兄弟庚)JSON生成 = 文庚;
    (文庚)打印;

    ("-- 深层嵌套")打印;
    ()创建动态数组 = 类型辛;
    ()创建动态字符串数组 = 值辛;
    ()创建动态字符串数组 = 键辛;
    ()创建动态数组 = 首子辛;
    ()创建动态数组 = 子数辛;
    ()创建动态数组 = 兄弟辛;
    ("[[1,[2,3]],4]", 类型辛, 值辛, 键辛, 首子辛, 子数辛, 兄弟辛)JSON解析 = 状辛;
    (类型辛, 值辛, 键辛, 首子辛, 子数辛, 兄弟辛)JSON生成 = 文辛;
    (文辛)打印;

    ("=== 测试完成 ===")打印;
}
