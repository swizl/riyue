// 循环不变式测试：@不变式{条件} 在函数内每个 当 / 循环 入口（含每轮）检查；
// 条件为假时向 stderr 打印 `契约失败: 函数名 循环不变式` 并以退出码 1 中止；
// `--发布` 下完全不发射（零开销）。

@不变式{和 >= 0}
函数 (上限:整数)求和(0 = 和:整数) {
    0 = 和;
    1 = 序号;
    当 (序号 <= 上限) {
        和 + 序号 = 和;
        序号 + 1 = 序号;
    }
}

@不变式{计数 >= 0}
函数 (次数:整数)计数循环(0 = 计数:整数) {
    0 = 计数;
    循环 (i: 0, 次数) {
        计数 + 2 = 计数;
    }
}

函数 主程序 {
    ("=== 循环不变式测试 ===")打印;
    (10)求和 = 甲;
    (甲)打印;
    (3)计数循环 = 乙;
    (乙)打印;
    ("=== 完成 ===")打印;
}
