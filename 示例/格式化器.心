// 日月代码格式化工具（演示版）

函数 主程序 {
    ("=== 日月代码格式化工具 ===")打印;
    
    ("功能演示:")打印;
    ("1. 读取源代码文件")打印;
    ("2. 解析代码结构")打印;
    ("3. 格式化缩进")打印;
    ("4. 写入输出文件")打印;
    
    // 创建测试文件
    ("构建/测试格式化.心", "w")打开 = 句柄;
    (句柄, "// 测试代码\n")写入;
    (句柄, "函数 主程序 {\n")写入;
    (句柄, "打印(\"Hello\");\n")写入;
    (句柄, "}\n")写入;
    (句柄)关闭;
    
    ("测试文件已创建: 构建/测试格式化.心")打印;
    
    // 读取测试文件
    ("构建/测试格式化.心", "r")打开 = 读句柄;
    (读句柄)读取行 = 行1;
    (读句柄)读取行 = 行2;
    (读句柄)读取行 = 行3;
    (读句柄)读取行 = 行4;
    (读句柄)关闭;
    
    ("读取的内容:")打印;
    (行1)打印;
    (行2)打印;
    (行3)打印;
    (行4)打印;
    
    // 格式化演示
    ("格式化后的代码:")打印;
    ("// 测试代码")打印;
    ("函数 主程序 {")打印;
    ("    打印(\"Hello\");")打印;
    ("}")打印;
    
    ("=== 演示完成 ===")打印;
}
