函数 打印数组(数组, 大小): 空 {
    变量 索引 = 0;
    当 (索引 < 大小) {
        打印(数组[索引]);
        索引 = 索引 + 1;
    }
}

函数 数组求和(数组, 大小): 整数 {
    变量 总和 = 0;
    变量 索引 = 0;
    当 (索引 < 大小) {
        总和 = 总和 + 数组[索引];
        索引 = 索引 + 1;
    }
    返回 总和;
}

函数 主程序(): 空 {
    变量 数据 = [10, 20, 30, 40, 50];
    打印数组(数据, 5);
    打印(数组求和(数据, 5));
}
