// LSP 报文分帧测试：Content-Length 帧头解析 + 构造 + 取体。
// 说明：花括号 / 双引号避免出现在字面量中（构造期可能被识别为插值），一律以 `(码)字符` + `拼接` 构造。
导入 "../工具/LSP报文.心";

函数 主 {
    ("=== LSP报文测试 ===")打印;

    ("Content-Length: 12")报文长度 = 长1;
    (长1)打印;
    ("Content-Length: 0")报文长度 = 长2;
    (长2)打印;
    ("Content-Type: text")报文长度 = 长3;
    (长3)打印;
    ("Content-Length: 12345")报文长度 = 长4;
    (长4)打印;

    (123)字符 = 单;
    ("", 单)拼接 = 左花;
    (125)字符 = 单;
    (左花, 单)拼接 = 花括号;

    (花括号)构造报文 = 帧;
    (帧)报文长度 = 帧长;
    (帧长)打印;
    (帧)报文正文 = 体;
    (体)打印;
    (体, 花括号)字符串比较 = 同;
    (同)打印;

    (34)字符 = 单;
    ("", 单)拼接 = 引;
    (123)字符 = 单;
    ("", 单)拼接 = 左曲;
    (125)字符 = 单;
    ("", 单)拼接 = 右曲;
    "" = 目标;
    (目标, 左曲)拼接 = 目标;
    (目标, 引)拼接 = 目标;
    (目标, "id")拼接 = 目标;
    (目标, 引)拼接 = 目标;
    (目标, ":1")拼接 = 目标;
    (目标, 右曲)拼接 = 目标;
    (目标)长度 = 目标长;
    (目标长)打印;
    (目标)构造报文 = 帧2;
    (帧2)报文长度 = 帧2长;
    (帧2长)打印;
    (帧2)报文正文 = 体2;
    (体2, 目标)字符串比较 = 体2比;
    (体2比)打印;

    ("Content-Length: 2")报文正文 = 无体;
    (无体)长度 = 无体长;
    (无体长)打印;

    ("=== 完成 ===")打印;
}
