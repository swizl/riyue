// 数组统计与判定测试（8BI）
//
// 导入 标准库/数组.心，验证 8BI 新增的 `数组计数`/`数组最大值索引`/`数组最小值索引`/
// `数组是否升序`/`数组是否降序`/`数组前缀和`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/数组.心";

函数 主程序 {
    ("=== 数组统计测试（8BI）===")打印;

    // 甲 = [1, 2, 3, 2]
    ()创建动态数组 = 甲;
    (甲, 1)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 3)动态数组添加;
    (甲, 2)动态数组添加;

    // 乙 = [1, 2, 2, 3]（非递减）
    ()创建动态数组 = 乙;
    (乙, 1)动态数组添加;
    (乙, 2)动态数组添加;
    (乙, 2)动态数组添加;
    (乙, 3)动态数组添加;

    // 丙 = [3, 2, 1]（非递增）
    ()创建动态数组 = 丙;
    (丙, 3)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 1)动态数组添加;

    // 丁 = []（空）
    ()创建动态数组 = 丁;

    ("-- 数组计数 --")打印;
    (甲, 4, 2)数组计数 = c1;
    (c1)打印;
    (甲, 4, 9)数组计数 = c2;
    (c2)打印;
    (丁, 0, 5)数组计数 = c3;
    (c3)打印;

    ("-- 最大值索引/最小值索引 --")打印;
    (甲, 4)数组最大值索引 = mx;
    (mx)打印;
    (甲, 4)数组最小值索引 = mn;
    (mn)打印;
    (乙, 4)数组最大值索引 = mx2;
    (mx2)打印;
    (丁, 0)数组最大值索引 = mx3;
    (mx3)打印;
    (丁, 0)数组最小值索引 = mn3;
    (mn3)打印;

    ("-- 升序判定 --")打印;
    (甲, 4)数组是否升序 = u1;
    (u1)打印;
    (乙, 4)数组是否升序 = u2;
    (u2)打印;
    (丁, 0)数组是否升序 = u3;
    (u3)打印;

    ("-- 降序判定 --")打印;
    (甲, 4)数组是否降序 = d1;
    (d1)打印;
    (乙, 4)数组是否降序 = d2;
    (d2)打印;
    (丙, 3)数组是否降序 = d3;
    (d3)打印;

    ("-- 前缀和 --")打印;
    // 戊 = [1, 2, 3, 4] ⇒ [1, 3, 6, 10]
    ()创建动态数组 = 戊;
    (戊, 1)动态数组添加;
    (戊, 2)动态数组添加;
    (戊, 3)动态数组添加;
    (戊, 4)动态数组添加;
    (戊, 4)数组前缀和;
    (戊, 0)动态数组获取 = s0;
    (s0)打印;
    (戊, 1)动态数组获取 = s1;
    (s1)打印;
    (戊, 2)动态数组获取 = s2;
    (s2)打印;
    (戊, 3)动态数组获取 = s3;
    (s3)打印;

    ("=== 测试完成 ===")打印;
}
