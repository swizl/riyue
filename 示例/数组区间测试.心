// 数组区间删除 / 反转 / 求和 / 包含测试（8BP）
//
// 导入 标准库/数组.心，验证 8BP 新增的 `数组删除区间`/`数组反转区间`/`数组区间求和`/`数组是否包含`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/数组.心";

函数 (数组, 数:整数)打印整数数组(空) {
    0 = k;
    当 (k < 数) {
        (数组, k)动态数组获取 = 元;
        (元)打印;
        k + 1 = k;
    }
}

函数 主程序 {
    ("=== 数组区间测试（8BP）===")打印;

    // ---- 数组删除区间 ----
    ("-- 删除 1..3 --")打印;
    // 甲 = [10, 20, 30, 40, 50]
    ()创建动态数组 = 甲;
    (甲, 10)动态数组添加;
    (甲, 20)动态数组添加;
    (甲, 30)动态数组添加;
    (甲, 40)动态数组添加;
    (甲, 50)动态数组添加;
    (甲, 5, 1, 3)数组删除区间 = n1;
    ("新长度:")打印;
    (n1)打印;
    (甲, n1)打印整数数组;

    ("-- 删除越界 -5..100 --")打印;
    ()创建动态数组 = 乙;
    (乙, 1)动态数组添加;
    (乙, 2)动态数组添加;
    (乙, 3)动态数组添加;
    (乙, 3, 0 - 5, 100)数组删除区间 = n2;
    ("新长度:")打印;
    (n2)打印;

    ("-- 删除空区间 3..1（原样）--")打印;
    ()创建动态数组 = 丙;
    (丙, 7)动态数组添加;
    (丙, 8)动态数组添加;
    (丙, 9)动态数组添加;
    (丙, 3, 3, 1)数组删除区间 = n3;
    ("新长度:")打印;
    (n3)打印;
    (丙, n3)打印整数数组;

    // ---- 数组反转区间 ----
    ("-- 反转区间 1..4 --")打印;
    // 丁 = [1, 2, 3, 4, 5]
    ()创建动态数组 = 丁;
    (丁, 1)动态数组添加;
    (丁, 2)动态数组添加;
    (丁, 3)动态数组添加;
    (丁, 4)动态数组添加;
    (丁, 5)动态数组添加;
    (丁, 5, 1, 4)数组反转区间;
    (丁, 5)打印整数数组;

    ("-- 反转整段 0..5 --")打印;
    ()创建动态数组 = 戊;
    (戊, 1)动态数组添加;
    (戊, 2)动态数组添加;
    (戊, 3)动态数组添加;
    (戊, 4)动态数组添加;
    (戊, 5)动态数组添加;
    (戊, 5, 0, 5)数组反转区间;
    (戊, 5)打印整数数组;

    // ---- 数组区间求和 ----
    ("-- 区间求和 --")打印;
    // 己 = [1, 2, 3, 4, 5]
    ()创建动态数组 = 己;
    (己, 1)动态数组添加;
    (己, 2)动态数组添加;
    (己, 3)动态数组添加;
    (己, 4)动态数组添加;
    (己, 5)动态数组添加;
    (己, 5, 1, 4)数组区间求和 = s1;
    ("1..4:")打印;
    (s1)打印;
    (己, 5, 0, 5)数组区间求和 = s2;
    ("0..5:")打印;
    (s2)打印;
    (己, 5, 3, 1)数组区间求和 = s3;
    ("空区间:")打印;
    (s3)打印;

    // ---- 数组是否包含 ----
    ("-- 是否包含 --")打印;
    ()创建动态数组 = 庚;
    (庚, 1)动态数组添加;
    (庚, 2)动态数组添加;
    (庚, 3)动态数组添加;
    (庚, 3, 2)数组是否包含 = b1;
    ("含 2:")打印;
    (b1)打印;
    (庚, 3, 9)数组是否包含 = b2;
    ("含 9:")打印;
    (b2)打印;
    ()创建动态数组 = 辛;
    (辛, 0, 1)数组是否包含 = b3;
    ("空含 1:")打印;
    (b3)打印;

    ("=== 测试完成 ===")打印;
