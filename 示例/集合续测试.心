// 集合续增测试（8BN）
//
// 导入 标准库/集合.心，验证 8BN 新增的 `数组对称差`（结果写回 arr1）/`数组是子集`/`数组真子集`/`数组唯一值个数`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/集合.心";

函数 主程序 {
    ("=== 集合续增测试（8BN）===")打印;

    // 甲 = [1, 2, 3, 2]，乙 = [2, 3]
    ()创建动态数组 = 甲;
    (甲, 1)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 3)动态数组添加;
    (甲, 2)动态数组添加;
    ()创建动态数组 = 乙;
    (乙, 2)动态数组添加;
    (乙, 3)动态数组添加;

    ("-- 数组是子集 --")打印;
    (乙, 2, 甲, 4)数组是子集 = s1;
    (s1)打印;
    (甲, 4, 乙, 2)数组是子集 = s2;
    (s2)打印;
    (乙, 2, 乙, 2)数组是子集 = s3;
    (s3)打印;

    ("-- 数组真子集 --")打印;
    (乙, 2, 甲, 4)数组真子集 = p1;
    (p1)打印;
    (甲, 4, 乙, 2)数组真子集 = p2;
    (p2)打印;
    (甲, 4, 甲, 4)数组真子集 = p3;
    (p3)打印;

    ("-- 数组唯一值个数 --")打印;
    (甲, 4)数组唯一值个数 = u1;
    (u1)打印;
    (乙, 2)数组唯一值个数 = u2;
    (u2)打印;
    ()创建动态数组 = 空数组;
    (空数组, 0)数组唯一值个数 = u3;
    (u3)打印;

    ("-- 数组对称差 --")打印;
    // 丙 = [1,2,3,4]，丁 = [3,4,5,6] ⇒ 对称差 = [1,2,5,6]
    ()创建动态数组 = 丙;
    (丙, 1)动态数组添加;
    (丙, 2)动态数组添加;
    (丙, 3)动态数组添加;
    (丙, 4)动态数组添加;
    ()创建动态数组 = 丁;
    (丁, 3)动态数组添加;
    (丁, 4)动态数组添加;
    (丁, 5)动态数组添加;
    (丁, 6)动态数组添加;
    (丙, 4, 丁, 4)数组对称差 = x1;
    (x1)打印;
    (丙, 0)动态数组获取 = q0;
    (q0)打印;
    (丙, 1)动态数组获取 = q1;
    (q1)打印;
    (丙, 2)动态数组获取 = q2;
    (q2)打印;
    (丙, 3)动态数组获取 = q3;
    (q3)打印;
    // 甲 = [1,2,3,2]，乙 = [2,3] ⇒ 对称差 = [1]
    (甲, 4, 乙, 2)数组对称差 = x2;
    (x2)打印;
    (甲, 0)动态数组获取 = r0;
    (r0)打印;

    ("=== 测试完成 ===")打印;
}
