// 语言特性演示

函数 (a:整数, b:整数)加法(0 = 结果:整数) { a + b = 结果; }
函数 (x:整数)求平方(0 = 结果:整数) { x * x = 结果; }

函数 (f:函数, x:整数)应用(0 = 结果:整数) { (x)f = 结果; }

函数 (f:函数, g:函数, x:整数)组合(0 = 结果:整数) {
    (x)g = 中间;
    (中间)f = 结果;
}

函数 (a:整数, b:整数)交换(0 = x:整数, 0 = y:整数) {
    b = x;
    a = y;
}

函数 (被除数:整数, 除数:整数)除法求余(0 = 商:整数, 0 = 余数:整数) {
    被除数 / 除数 = 商;
    被除数 % 除数 = 余数;
}

函数 主程序 {
    ("=== 语言特性演示 ===")打印;

    // 匿名函数
    函数(x:整数)(0 = 结果:整数) { x * x = 结果; } = 平方;
    函数(x:整数)(0 = 结果:整数) { x + 1 = 结果; } = 加一;
    函数(x:整数)(0 = 结果:整数) { x * 2 = 结果; } = 加倍;

    // 高阶函数
    ("高阶函数:")打印;
    (平方, 5)应用 = sq;
    (sq)打印;
    
    // 函数组合
    ("组合函数:")打印;
    (平方, 加一, 3)组合 = result;
    (result)打印;
    
    // 管道操作
    ("管道操作:")打印;
    (3, 4)加法|(结果=输入)求平方 = pipe_result;
    (pipe_result)打印;
    
    // 多返回值
    ("多返回值:")打印;
    (10, 3)交换 = (x, y);
    (x)打印;
    (y)打印;

    ("除法求余:")打印;
    (17, 5)除法求余 = (商, 余数);
    (商)打印;
    (余数)打印;

    ("=== 演示完成 ===")打印;
}
