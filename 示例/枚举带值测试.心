// 枚举带值测试

枚举 颜色 {
    红=10,
    绿=20,
    蓝=30
}

枚举 星期 {
    周一,
    周二,
    周三,
    周四,
    周五,
    周六,
    周日
}

函数 主程序 {
    ("=== 枚举带值测试 ===")打印;

    颜色::红 = c;
    ("颜色::红 = ")打印;
    (c)打印;

    颜色::绿 = g;
    ("颜色::绿 = ")打印;
    (g)打印;

    颜色::蓝 = b;
    ("颜色::蓝 = ")打印;
    (b)打印;

    星期::周一 = day;
    ("星期::周一 = ")打印;
    (day)打印;

    星期::周日 = sunday;
    ("星期::周日 = ")打印;
    (sunday)打印;

    ("=== 测试完成 ===")打印;
}
