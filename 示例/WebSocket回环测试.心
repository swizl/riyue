// WebSocket 回环测试（8AQ）：握手 + 帧经 TCP 字节收发打到对端并解析应答。
// 端口由进程号派生（20000..29999），**不打印端口** ⇒ 双链 stdout 可逐字节比对。

导入 "标准库/网络.心";
导入 "标准库/WebSocket.心";

函数 主程序 {
    ("=== WebSocket 回环测试 ===")打印;

    ()获取进程标识 = 进程号;
    (进程号 % 10000) + 20000 = 端口;

    (端口)TCP监听 = 服务器;
    ("服务端就绪:")打印;
    (服务器 > 0)打印;

    // 1) 客户端：构造握手请求（RFC 6455 §1.3 固定键）并连接发送
    ("127.0.0.1", "/chat", "dGhlIHNhbXBsZSBub25jZQ==")WebSocket握手请求 = 请求文本;
    ()创建动态数组 = 请求字节;
    (请求文本, 请求字节)WebSocket追加文本;
    ("127.0.0.1", 端口, 请求字节)TCP连接发送字节 = 客户端;
    ("客户端就绪:")打印;
    (客户端 > 0)打印;

    // 2) 服务端：接受并接收请求 → 取键 → 生成应答 → 发送（保持连接）
    ()创建动态数组 = 收到请求;
    (服务器, 收到请求)TCP接受接收字节 = 连接;
    (收到请求)WebSocket转文本 = 请求回读;
    (请求回读)WebSocket取客户端键 = 键回读;
    ("服务端取到键:")打印;
    (键回读)打印;
    (键回读)WebSocket握手接受键 = 服务端接受;
    ("服务端应答接受键:")打印;
    (服务端接受)打印;
    (键回读)WebSocket握手响应 = 应答文本;
    ()创建动态数组 = 应答字节;
    (应答文本, 应答字节)WebSocket追加文本;
    (连接, 应答字节)TCP发送字节保持 = 应答数;

    // 3) 客户端：接收应答 → 解析 `Sec-WebSocket-Accept`
    ()创建动态数组 = 收到应答;
    (客户端, 收到应答)TCP接收字节追加 = 收应答数;
    (收到应答)WebSocket转文本 = 应答回读;
    (应答回读, "Sec-WebSocket-Accept")WebSocket取头值 = 客户端接受;
    ("客户端解析应答接受键:")打印;
    (客户端接受)打印;

    // 4) 客户端：发掩码文本帧 "Hello"（掩码键 0x37 0xfa 0x21 0x3d）
    ()创建动态数组 = 掩码;
    (掩码, 55)动态数组添加;
    (掩码, 250)动态数组添加;
    (掩码, 33)动态数组添加;
    (掩码, 61)动态数组添加;
    ()创建动态数组 = 载荷;
    ("Hello", 载荷)WebSocket追加文本;
    ()创建动态数组 = 帧;
    (1, 掩码, 载荷, 帧)WebSocket构造帧掩码;
    (客户端, 帧)TCP发送字节保持 = 发帧数;

    // 5) 服务端：接收帧 → 解析 → 以无掩码文本帧回显
    ()创建动态数组 = 收到帧;
    (连接, 收到帧)TCP接收字节追加 = 收帧数;
    ()创建动态数组 = 偏移;
    (偏移, 0)动态数组添加;
    ()创建动态数组 = 解;
    (收到帧, 解, 偏移)解析WebSocket帧 = (操作码1, 结束1);
    ("服务端解析帧 操作码:")打印;
    (操作码1)打印;
    ("服务端解析帧 载荷:")打印;
    (解)WebSocket转文本 = 载荷文本;
    (载荷文本)打印;
    ()创建动态数组 = 回显帧;
    (1, 解, 回显帧)WebSocket构造帧;
    (连接, 回显帧)TCP发送字节保持 = 发回显数;

    // 6) 客户端：接收回显帧 → 解析
    ()创建动态数组 = 收到回显;
    (客户端, 收到回显)TCP接收字节追加 = 收回显数;
    ()创建动态数组 = 回显偏移;
    (回显偏移, 0)动态数组添加;
    ()创建动态数组 = 回显解;
    (收到回显, 回显解, 回显偏移)解析WebSocket帧 = (操作码2, 结束2);
    ("客户端回显 操作码:")打印;
    (操作码2)打印;
    ("客户端回显 载荷:")打印;
    (回显解)WebSocket转文本 = 回显文本;
    (回显文本)打印;

    (连接)TCP关闭;
    (客户端)TCP关闭;

    ("=== 测试完成 ===")打印;
}
