// 运行时反射驱动自动序列化：字段数量 / 字段名称 / 字段类型 / 字段值文本

结构体 用户 {
    编号: 整数;
    昵称: 字符串;
    余额: 浮点;
}

结构体 坐标 {
    x: 整数;
    y: 整数;
}

// 反射驱动序列化：键取 字段名称，类型取 字段类型，值取 字段值文本。
函数 (用户变量: 用户)序列化用户(0 = 结果: 字符串) {
    "{" = 结果;
    (用户变量, 0)字段名称 = 名0;
    (用户变量, 0)字段类型 = 型0;
    (用户变量, 0)字段值文本 = 值0;
    结果 + "\"" + 名0 + "\":" = 结果;
    如果 (型0 ?= "字符串") {
        结果 + "\"" + 值0 + "\"" = 结果;
    }
    否则 {
        结果 + 值0 = 结果;
    }
    (用户变量, 1)字段名称 = 名1;
    (用户变量, 1)字段类型 = 型1;
    (用户变量, 1)字段值文本 = 值1;
    结果 + "," + "\"" + 名1 + "\":" = 结果;
    如果 (型1 ?= "字符串") {
        结果 + "\"" + 值1 + "\"" = 结果;
    }
    否则 {
        结果 + 值1 = 结果;
    }
    (用户变量, 2)字段名称 = 名2;
    (用户变量, 2)字段类型 = 型2;
    (用户变量, 2)字段值文本 = 值2;
    结果 + "," + "\"" + 名2 + "\":" = 结果;
    如果 (型2 ?= "字符串") {
        结果 + "\"" + 值2 + "\"" = 结果;
    }
    否则 {
        结果 + 值2 = 结果;
    }
    结果 + "}" = 结果;
}

函数 (坐标变量: 坐标)序列化坐标(0 = 结果: 字符串) {
    "{" = 结果;
    (坐标变量, 0)字段名称 = 横名;
    (坐标变量, 0)字段值文本 = 横值;
    结果 + "\"" + 横名 + "\":" + 横值 = 结果;
    (坐标变量, 1)字段名称 = 纵名;
    (坐标变量, 1)字段值文本 = 纵值;
    结果 + "," + "\"" + 纵名 + "\":" + 纵值 + "}" = 结果;
}

函数 主程序 {
    ("=== 反射序列化测试 ===")打印;

    用户 { 编号: 42, 昵称: "Alice", 余额: 12.5 } = 用户变量;
    (用户变量)字段数量 = 用户字段数;
    ("用户字段数:")打印;
    (用户字段数)打印;
    (用户变量)序列化用户 = 用户JSON;
    (用户JSON)打印;

    坐标 { x: -3, y: 7 } = 坐标变量;
    (坐标变量)字段数量 = 坐标字段数;
    ("坐标字段数:")打印;
    (坐标字段数)打印;
    (坐标变量)序列化坐标 = 坐标JSON;
    (坐标JSON)打印;

    // 越界序号 / 非字面量序号 / 非结构体变量 → 空串
    (用户变量, 9)字段值文本 = 越界值;
    ("[" + 越界值 + "]")打印;
    1 = 动态索引;
    (用户变量, 动态索引)字段值文本 = 动态值;
    ("[" + 动态值 + "]")打印;
    5 = 整数变量;
    (整数变量, 0)字段值文本 = 非结构值;
    ("[" + 非结构值 + "]")打印;

    ("=== 测试完成 ===")打印;
}
