// 运行时反射：结构体字段枚举（字段数量 / 字段名称 / 字段类型）

结构体 点 {
    x: 整数;
    y: 整数;
    名: 字符串;
}

函数 主程序 {
    ("=== 反射字段测试 ===")打印;
    点 { x: 1, y: 2, 名: "原点" } = 点变量;

    (点变量)字段数量 = 数量;
    (数量)打印;

    (点变量, 0)字段名称 = 名0;
    (点变量, 0)字段类型 = 型0;
    (名0)打印;
    (型0)打印;

    (点变量, 1)字段名称 = 名1;
    (点变量, 1)字段类型 = 型1;
    (名1)打印;
    (型1)打印;

    (点变量, 2)字段名称 = 名2;
    (点变量, 2)字段类型 = 型2;
    (名2)打印;
    (型2)打印;

    // 越界 / 非字面量索引 → 空串
    (点变量, 9)字段名称 = 越界名;
    ("[" + 越界名 + "]")打印;
    1 = 索引;
    (点变量, 索引)字段名称 = 动态名;
    ("[" + 动态名 + "]")打印;

    // 非结构体变量 → 0 / 空串
    5 = 整数变量;
    (整数变量)字段数量 = 非结构数;
    (非结构数)打印;
    (整数变量, 0)字段名称 = 非结构名;
    ("[" + 非结构名 + "]")打印;

    ("=== 测试完成 ===")打印;
}
