// 位运算/移位算子测试（双链一致）
// 守卫：自举链曾把 & | ^ <| >| 全部误当取余 %（见 编译器差距补齐计划.md 8G）
函数 主程序 {
    ("与:")打印;
    (12 & 10)打印;
    ("异或:")打印;
    (12 ^ 10)打印;
    ("左移:")打印;
    (1 <| 8)打印;
    ("右移:")打印;
    (256 >| 4)打印;
    ("算术右移负:")打印;
    ((0 - 1) >| 1)打印;
    6 = 甲;
    3 = 乙;
    ("变量与:")打印;
    (甲 & 乙)打印;
    ("变量左移:")打印;
    (甲 <| 乙)打印;
}