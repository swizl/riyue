// WebSocket 握手（RFC 6455 §4.2.2）：Sec-WebSocket-Accept = base64(sha1(客户端键 + GUID))。
// 以 RFC 已知答案（§1.3 / §4.1 示例键）与 编码.Base64编码字节（字节数组入参）做双链一致性验证。
函数 主程序 {
    ("=== WebSocket 握手测试 ===")打印;

    // —— 1) RFC 6455 §1.3 示例键 ——
    ("握手接受键(RFC6455 1.3):")打印;
    ("dGhlIHNhbXBsZSBub25jZQ==")WebSocket握手接受键 = 接受1;
    (接受1)打印;

    // —— 2) RFC 6455 §4.1 示例键 ——
    ("握手接受键(RFC6455 4.1):")打印;
    ("x3JJHMbDL1EzLkh9GBhXDw==")WebSocket握手接受键 = 接受2;
    (接受2)打印;

    ("模块版本:")打印;
    ()WebSocket模块版本 = 版本;
    (版本)打印;

    // —— 3) 字节数组入参 Base64：整组 "Man" ——
    ("Base64编码字节(Man):")打印;
    ()创建动态数组 = 三;
    (三, 77)动态数组添加;
    (三, 97)动态数组添加;
    (三, 110)动态数组添加;
    (三)Base64编码字节 = b64a;
    (b64a)打印;

    // —— 4) 含 0x00 的字节（文本入参会截断，本接口不应截断）——
    ("Base64编码字节(00 01 FF):")打印;
    ()创建动态数组 = 三字节;
    (三字节, 0)动态数组添加;
    (三字节, 1)动态数组添加;
    (三字节, 255)动态数组添加;
    (三字节)Base64编码字节 = b64b;
    (b64b)打印;

    // —— 5) 余 2 字节（须补一个 '=' 填充）——
    ("Base64编码字节(2 字节 Ma):")打印;
    ()创建动态数组 = 两;
    (两, 77)动态数组添加;
    (两, 97)动态数组添加;
    (两)Base64编码字节 = b64c;
    (b64c)打印;

    // —— 6) SHA-1 回归（摘要.心 未改动，应仍为 abc 的标准值）——
    ("SHA1(abc) 回归:")打印;
    ("abc")SHA1 = 摘文;
    (摘文)打印;

    ("=== 测试完成 ===")打印;
}
