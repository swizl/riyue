// 多返回值测试

// 交换两个值
函数 (甲:整数, 乙:整数)交换(0 = 变量值:整数, 0 = y:整数) {
    乙 = 变量值;
    甲 = y;
}

// 返回商和余数
函数 (被除数:整数, 除数:整数)除法求余(0 = 商:整数, 0 = 余数:整数) {
    被除数 / 除数 = 商;
    被除数 % 除数 = 余数;
}

函数 主程序 {
    ("=== 多返回值测试 ===")打印;

    // 测试交换
    (3, 7)交换 = (r1, r2);
    (r1)打印;  // 7
    (r2)打印;  // 3

    // 测试除法求余
    (17, 5)除法求余 = (商, 余数);
    (商)打印;   // 3
    (余数)打印;  // 2

    ("=== 测试完成 ===")打印;
}
