// 正则分组/或测试（8JS）
//
// 导入 标准库/正则.心，验证分组 `(...)`（可嵌套、可带量词）与或 `|`（顶层 / 组内），
// 含需要跨分组回溯的写法（`(a|ab)c`）与分组量词（`(ab)+`、`(abc){2}`）。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/正则.心";

函数 主程序 {
    ("=== 正则分组/或测试（8JS）===")打印;

    ("-- 分组基础 --")打印;
    ("abc", "(ab)c")正则匹配 = r1;
    (r1)打印;
    ("ac", "(ab)c")正则匹配 = r2;
    (r2)打印;
    ("abc", "a(bc)")正则匹配 = r3;
    (r3)打印;
    ("(x)", "\\(x\\)")正则匹配 = r4;
    (r4)打印;
    ("x", "(x)")正则匹配 = r5;
    (r5)打印;

    ("-- 顶层或 --")打印;
    ("cat", "cat|dog")正则匹配 = r6;
    (r6)打印;
    ("dog", "cat|dog")正则匹配 = r7;
    (r7)打印;
    ("cow", "cat|dog")正则匹配 = r8;
    (r8)打印;
    ("a|b", "a\\|b")正则匹配 = r9;
    (r9)打印;
    ("a|b", "a[|]b")正则匹配 = r10;
    (r10)打印;

    ("-- 组内或 --")打印;
    ("abab", "^(ab)+$")正则匹配 = r11;
    (r11)打印;
    ("aba", "^(ab)+$")正则匹配 = r12;
    (r12)打印;
    ("abcabc", "^(abc){2}$")正则匹配 = r13;
    (r13)打印;
    ("abc", "^(abc){2}$")正则匹配 = r14;
    (r14)打印;
    ("aab", "^(a|aa)b$")正则匹配 = r15;
    (r15)打印;
    ("b", "^(a|)b$")正则匹配 = r16;
    (r16)打印;
    ("ab", "^(a|)b$")正则匹配 = r17;
    (r17)打印;

    ("-- 跨分组回溯 --")打印;
    ("abc", "^(a|ab)c$")正则匹配 = r18;
    (r18)打印;
    ("ab", "^(a|ab)$")正则匹配 = r19;
    (r19)打印;
    ("ac", "^(a|ab)c$")正则匹配 = r20;
    (r20)打印;
    ("acab", "^(a(b|c))*$")正则匹配 = r21;
    (r21)打印;
    ("acax", "^(a(b|c))*$")正则匹配 = r22;
    (r22)打印;

    ("-- 分组 + 字符类 + 量词 --")打印;
    ("a1b2", "^([a-z][0-9])+$")正则匹配 = r23;
    (r23)打印;
    ("a1b", "^([a-z][0-9])+$")正则匹配 = r24;
    (r24)打印;
    ("abcabc", "^((abc)){2}$")正则匹配 = r25;
    (r25)打印;
    ("123", "^(\\d+|abc)$")正则匹配 = r26;
    (r26)打印;
    ("abc", "^(\\d+|abc)$")正则匹配 = r27;
    (r27)打印;
    ("xyz", "^(\\d+|abc)$")正则匹配 = r28;
    (r28)打印;

    ("-- 查找（首个匹配下标）--")打印;
    ("xxcatyy", "cat|dog")正则查找 = p1;
    (p1)打印;
    ("xxdog", "dog")正则查找 = p2;
    (p2)打印;
    ("zzz", "cat|dog")正则查找 = p3;
    (p3)打印;
    ("test_ab12_end", "([a-z]+_[a-z]+[0-9]+)")正则查找 = p4;
    (p4)打印;
    ("xxabcx", "^(ab|cd)")正则查找 = p5;
    (p5)打印;

    ("=== 测试完成 ===")打印;
}
