// DNS 往返测试（8AR）：A 查询经 UDP 打到本地应答端并解析应答。
// 端口由进程号派生（避开系统临时端口段）、不打印端口 ⇒ 双链 stdout 可逐字节比对。
// 应答端不真的解析查询，而是回一份**已知答案**（RFC 1035 响应字节：example.com A → 93.184.216.34），
// 以确定性验证「构造查询 → UDP → 解析响应」整条链路。

导入 "标准库/网络.心";
导入 "标准库/DNS.心";

函数 主程序 {
    ("=== DNS 往返测试 ===")打印;

    ()获取进程标识 = 进程号;
    (进程号 % 10000) + 20000 = 服务端口;
    服务端口 + 1 = 客户端端口;

    // 1) 应答端先绑定服务端口（须先于客户端发送）
    (服务端口)UDP创建绑定 = 应答端;
    ("应答端就绪:")打印;
    (应答端 > 0)打印;

    // 2) 客户端：DNS发送查询（绑定客户端端口 → 构造 example.com 查询 → 发送到应答端）
    ("example.com", 4660, "127.0.0.1", 服务端口, 客户端端口)DNS发送查询 = (发送状态, 客户端);
    ("发送状态:")打印;
    (发送状态)打印;

    // 3) 应答端接收查询并打印其十六进制（验证「构造查询 → UDP」）
    ()创建动态数组 = 收到查询;
    (应答端, 收到查询)UDP接收字节追加 = 收查询数;
    ("应答端收到查询hex:")打印;
    (收到查询)DNS转十六进制 = 查询十六;
    (查询十六)打印;

    // 4) 应答端回一份已知答案响应（example.com A → 93.184.216.34，TTL=60）
    ()创建动态数组 = 响应;
    (4660, 响应)DNS写大端16;         // 事务号 0x1234
    (33152, 响应)DNS写大端16;        // 标志 0x8180（QR=1, RD=1, RA=1）
    (1, 响应)DNS写大端16;            // QDCOUNT
    (1, 响应)DNS写大端16;            // ANCOUNT
    (0, 响应)DNS写大端16;            // NSCOUNT
    (0, 响应)DNS写大端16;            // ARCOUNT
    ("example.com", 响应)DNS写域名;  // 问题段 QNAME
    (1, 响应)DNS写大端16;            // QTYPE = A
    (1, 响应)DNS写大端16;            // QCLASS = IN
    (192, 响应)DNS写字节;            // 名字压缩指针 0xC00C
    (12, 响应)DNS写字节;
    (1, 响应)DNS写大端16;            // TYPE = A
    (1, 响应)DNS写大端16;            // CLASS = IN
    (0, 响应)DNS写大端16;            // TTL 高 16 位
    (60, 响应)DNS写大端16;           // TTL 低 16 位
    (4, 响应)DNS写大端16;            // RDLENGTH
    (93, 响应)DNS写字节;
    (184, 响应)DNS写字节;
    (216, 响应)DNS写字节;
    (34, 响应)DNS写字节;
    (应答端, "127.0.0.1", 客户端端口, 响应)UDP发送字节 = 发响应数;

    // 5) 客户端：DNS收取响应（接收一次 → 解析 A 记录）
    ()创建动态数组 = 原始;
    ()创建动态数组 = 地址;
    (客户端, 地址, 原始)DNS收取响应 = 解析状态;
    ("解析状态:")打印;
    (解析状态)打印;
    ("收到响应hex:")打印;
    (原始)DNS转十六进制 = 响应十六;
    (响应十六)打印;
    ("IPv4 点分:")打印;
    (地址, 0)动态数组获取 = o1;
    (地址, 1)动态数组获取 = o2;
    (地址, 2)动态数组获取 = o3;
    (地址, 3)动态数组获取 = o4;
    (o1)打印;
    (o2)打印;
    (o3)打印;
    (o4)打印;

    ("=== 测试完成 ===")打印;
}
