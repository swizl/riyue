// 包管理标准库测试：清单解析 / 依赖拆分 / 依赖解析（版本冲突）/ 锁文件与校验 / 子命令分派
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定），双链（引导.exe / 日月.exe）输出逐字一致。

导入 "标准库/包管理.心";

函数 ()主 {
    ("=== 包管理测试 ===")打印;
    ("模块版本:")打印;
    ()包管理模块版本 = 模版;
    (模版)打印;

    // 注册表：元素形如 名称@版本
    ()创建动态字符串数组 = 注册表;
    (注册表, "数学@1.0.0")动态字符串数组添加;
    (注册表, "数学@1.2.0")动态字符串数组添加;
    (注册表, "数学@2.0.0")动态字符串数组添加;
    (注册表, "字符串@1.1.0")动态字符串数组添加;
    (注册表, "JSON@0.9.0")动态字符串数组添加;

    // 清单：`键 = 值` 行，依赖以逗号分隔（用字符码 10 拼 LF）
    "" = 换行;
    "" = 清单;
    (10)字符 = 换行;
    (清单, "名称 = 演示包")拼接 = 清单;
    (清单, 换行)拼接 = 清单;
    (清单, "版本 = 0.1.0")拼接 = 清单;
    (清单, 换行)拼接 = 清单;
    (清单, "依赖 = 数学 >=1.0.0, 字符串 ^1.0.0")拼接 = 清单;
    (清单, 换行)拼接 = 清单;

    ("-- 清单取值 --")打印;
    (清单, "名称")包清单取值 = 名值;
    (名值)打印;
    (清单, "版本")包清单取值 = 版值;
    (版值)打印;
    (清单, "缺失")包清单取值 = 缺值;
    ("缺失键长度:")打印;
    (缺值)长度 = 缺长;
    (缺长)打印;

    ("-- 清单依赖 --")打印;
    ()创建动态字符串数组 = 依赖表;
    (清单, 依赖表)包清单依赖 = 依赖数;
    (依赖数)打印;
    (依赖表, 0)动态字符串数组获取 = 依赖0;
    (依赖0)打印;
    (依赖表, 1)动态字符串数组获取 = 依赖1;
    (依赖1)打印;

    ("-- 依赖拆分 --")打印;
    ("数学 >=1.0.0")包依赖拆分 = (拆名, 拆约);
    (拆名)打印;
    (拆约)打印;

    ("-- 依赖解析 --")打印;
    ("数学", 注册表)包解析依赖 = 位;
    (位)打印;
    ("数学 <2.0.0", 注册表)包解析依赖 = 位;
    (位)打印;
    ("数学 >=3.0.0", 注册表)包解析依赖 = 位;
    (位)打印;
    ("JSON", 注册表)包解析依赖 = 位;
    (位)打印;
    ("字符串", 注册表)包解析依赖 = 位;
    (位)打印;

    ("-- 依赖表解析 --")打印;
    (依赖表, 注册表)包解析依赖表 = (选中, 冲突);
    (冲突)打印;
    (选中, 0)动态数组获取 = 选0;
    (选0)打印;
    (选中, 1)动态数组获取 = 选1;
    (选1)打印;

    // 锁文件：内容表与选中表按下标平行（内容为 ASCII，摘要模块仅支持单字节文本）
    ()创建动态字符串数组 = 内容表;
    (内容表, "abc")动态字符串数组添加;
    (内容表, "def")动态字符串数组添加;
    ("-- 锁文件 --")打印;
    (注册表, 选中, 内容表)包锁文件生成 = 锁;
    (锁)打印;

    ("-- 锁校验 --")打印;
    (锁, "数学", "abc")包锁校验 = 校;
    (校)打印;
    (锁, "数学", "xyz")包锁校验 = 校;
    (校)打印;
    (锁, "不存在", "abc")包锁校验 = 校;
    (校)打印;

    ("-- 子命令: 搜索 数学 --")打印;
    ("搜索", "数学", 清单, 注册表)包命令 = 命令码;

    ("-- 子命令: 安装 数学 <2.0.0 --")打印;
    ("安装", "数学 <2.0.0", 清单, 注册表)包命令 = 命令码;

    ("-- 子命令: 锁定 --")打印;
    ("锁定", "", 清单, 注册表)包命令 = 命令码;

    ("=== 测试完成 ===")打印;
}
