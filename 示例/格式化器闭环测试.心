// 格式化器闭环测试：模块版本 / 花括号缩进 / 去行尾空白 / 空行压缩 / 规范判定 / 幂等
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定）；不落盘，全部在内存文本上验证。

导入 "../工具/格式化器.心";
导入 "../标准库/测试框架.心";

函数 主程序 {
    ("=== 格式化器闭环测试 ===")打印;
    ()格式化器模块版本 = 版本;
    ("-- 模块版本 --")打印;
    (版本, 2, "格式化器模块版本")断言等于;

    // 脏源：首部两空行 / 连续空行 / 3 空格缩进 / 行尾空白 / 深层花括号
    ("-- 格式化 --")打印;
    "" = 源;
    (源, "\n")拼接 = 源;
    (源, "\n")拼接 = 源;
    (源, "函数 主程序 {\n")拼接 = 源;
    (源, "\n")拼接 = 源;
    (源, "\n")拼接 = 源;
    (源, "   (甲)打印;   \n")拼接 = 源;
    (源, "如果 (1 ?= 1) {\n")拼接 = 源;
    (源, "(乙)打印;\n")拼接 = 源;
    (源, "}\n")拼接 = 源;
    (源, "}\n")拼接 = 源;
    (源)格式化文本 = 规范;
    (规范)打印;

    // 期望：4 空格按层缩进 / 单个空行保留 / 行尾空白清除
    "" = 期望;
    (期望, "函数 主程序 {\n")拼接 = 期望;
    (期望, "\n")拼接 = 期望;
    (期望, "    (甲)打印;\n")拼接 = 期望;
    (期望, "    如果 (1 ?= 1) {\n")拼接 = 期望;
    (期望, "        (乙)打印;\n")拼接 = 期望;
    (期望, "    }\n")拼接 = 期望;
    (期望, "}\n")拼接 = 期望;
    (规范, 期望, "缩进/尾白/空行")断言文本等于;

    ("-- 缩进风格 --")打印;
    (源, "  ")格式化文本按缩进 = 两空;
    "" = 期望两空;
    (期望两空, "函数 主程序 {\n")拼接 = 期望两空;
    (期望两空, "\n")拼接 = 期望两空;
    (期望两空, "  (甲)打印;\n")拼接 = 期望两空;
    (期望两空, "  如果 (1 ?= 1) {\n")拼接 = 期望两空;
    (期望两空, "    (乙)打印;\n")拼接 = 期望两空;
    (期望两空, "  }\n")拼接 = 期望两空;
    (期望两空, "}\n")拼接 = 期望两空;
    (两空, 期望两空, "2 空格缩进")断言文本等于;

    (源, "\t")格式化文本按缩进 = 制表;
    "" = 期望制表;
    (期望制表, "函数 主程序 {\n")拼接 = 期望制表;
    (期望制表, "\n")拼接 = 期望制表;
    (期望制表, "\t(甲)打印;\n")拼接 = 期望制表;
    (期望制表, "\t如果 (1 ?= 1) {\n")拼接 = 期望制表;
    (期望制表, "\t\t(乙)打印;\n")拼接 = 期望制表;
    (期望制表, "\t}\n")拼接 = 期望制表;
    (期望制表, "}\n")拼接 = 期望制表;
    (制表, 期望制表, "制表符缩进")断言文本等于;

    ("-- 规范判定 --")打印;
    (规范)格式化是否规范 = 规一;
    (规一, 1, "规范化结果再判定规范")断言等于;
    (源)格式化是否规范 = 规二;
    (规二, 0, "原始脏文本判定不规范")断言等于;

    ("-- 幂等 --")打印;
    (规范)格式化文本 = 再规范;
    (再规范, 规范, "二次格式化不变")断言文本等于;

    ("-- 空文本 --")打印;
    "" = 空源;
    (空源)格式化文本 = 空规范;
    (空规范, "", "空文本格式化为空")断言文本等于;

    ("---")打印;
    ()测试总结;
    ("=== 测试完成 ===")打印;
}
