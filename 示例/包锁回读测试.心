// 包锁回读与按锁安装测试：锁解析（名称/版本/摘要三表）/ 摘要校验 / 缓存落盘 /
// 摘要不匹配拒绝 / 卸载删目录 / 落盘式子命令（安装-卸载）。
// 纯 .心（不改编译器 / 自举源 ⇒ 不动点恒定）；产物落在 .gitignore 的 构建/ 下。

导入 "标准库/包管理.心";

函数 ()主 {
    ("=== 包锁回读测试 ===")打印;
    ("模块版本:")打印;
    ()包管理模块版本 = 模版;
    (模版)打印;

    "构建/包锁回读" = 根;
    (根)包确保目录 = 根建;
    ("根目录就绪:")打印;
    (根建)打印;

    "" = 换行;
    (10)字符 = 换行;

    // 预清理：同名缓存目录若残留在上一轮，先删除（结果不打印，避免依赖环境）
    ("数学", 根)包卸载缓存 = 预删;
    ("字符串", 根)包卸载缓存 = 预删;

    // 锁文本：首行带 md5（内容 abc），次行摘要 `-`（无内容）
    "abc" = 原文;
    (原文)MD5 = 数学和;
    "" = 锁;
    "数学@1.2.0 md5=" = 锁;
    (锁, 数学和)拼接 = 锁;
    (锁, 换行)拼接 = 锁;
    (锁, "字符串@1.1.0 md5=-")拼接 = 锁;
    (锁, 换行)拼接 = 锁;

    ("-- 锁解析 --")打印;
    ()创建动态字符串数组 = 名称表;
    ()创建动态字符串数组 = 版本表;
    ()创建动态字符串数组 = 摘要表;
    (锁, 名称表, 版本表, 摘要表)包锁解析 = 锁数;
    (锁数)打印;
    (名称表, 0)动态字符串数组获取 = 名0;
    (名0)打印;
    (版本表, 0)动态字符串数组获取 = 版0;
    (版0)打印;
    (摘要表, 0)动态字符串数组获取 = 和0;
    (和0)打印;
    (名称表, 1)动态字符串数组获取 = 名1;
    (名1)打印;
    (摘要表, 1)动态字符串数组获取 = 和1;
    (和1)打印;

    // 内容表与锁同下标：0 = abc（与摘要一致），1 = 空（摘要 `-`，跳过校验）
    ()创建动态字符串数组 = 内容表;
    (内容表, 原文)动态字符串数组添加;
    (内容表, "")动态字符串数组添加;

    ("-- 按锁安装 --")打印;
    (锁, 内容表, 根)包安装按锁 = (已装, 失败, 原因);
    (已装)打印;
    (失败)打印;
    (原因)长度 = 因长;
    ("原因长度:")打印;
    (因长)打印;
    (根, "数学")包连接路径 = 数目录;
    (数目录, "包信息.心")包连接路径 = 数清单;
    (数清单)文件存在 = 数存在;
    ("数学清单存在:")打印;
    (数存在)打印;
    (数清单)包读取清单 = 数文;
    (数文, "版本")包清单取值 = 数版;
    ("数学版本:")打印;
    (数版)打印;

    // 摘要不匹配：内容换成 abd，锁里的 md5 不变
    ()创建动态字符串数组 = 坏内容;
    (坏内容, "abd")动态字符串数组添加;
    (坏内容, "")动态字符串数组添加;
    ("-- 摘要不匹配 --")打印;
    (锁, 坏内容, 根)包安装按锁 = (已装2, 失败2, 原因2);
    (已装2)打印;
    (失败2)打印;
    (原因2)打印;

    ("-- 卸载删目录 --")打印;
    ("数学", 根)包卸载缓存 = 删果;
    (删果)打印;
    (数目录)目录存在 = 数目录在;
    ("数学目录存在:")打印;
    (数目录在)打印;
    ("不存在包卸载:")打印;
    ("不存在", 根)包卸载缓存 = 删果2;
    (删果2)打印;

    // 落盘子命令：安装选最高满足版本并写清单；卸载递归删目录
    ("-- 落盘子命令 --")打印;
    ()创建动态字符串数组 = 注册表;
    (注册表, "数学@1.0.0")动态字符串数组添加;
    (注册表, "数学@1.2.0")动态字符串数组添加;
    "" = 空清单;
    ("安装", "数学 <2.0.0", 空清单, 注册表, 根)包命令落盘 = 命令码;
    ("命令码:")打印;
    (命令码)打印;
    (数清单)文件存在 = 装存在;
    ("安装后清单存在:")打印;
    (装存在)打印;
    ("卸载", "数学", 空清单, 注册表, 根)包命令落盘 = 命令码2;
    ("命令码:")打印;
    (命令码2)打印;
    (数目录)目录存在 = 装目录在;
    ("卸载后目录存在:")打印;
    (装目录在)打印;

    ("=== 测试完成 ===")打印;
}
