// 阶段P7 续：代码检查器（纯 .心）——制表符缩进 / 行尾空白 / 全角标点 / 未闭合字符串 / 非法运算符
// 期望：示例/代码检查器测试.期望
导入 "../工具/代码检查器.心";

函数 主程序 {
    ("=== 代码检查器测试 ===")打印;

    // 8 行样例：正常 / 制表缩进 / 行尾空白 / 全角标点 / 未闭合字符串 / 非法运算符 / 注释豁免 / 空行
    "函数 正常(空) {\n" = 源;
    (9)字符 = 制表;
    (源, 制表)拼接 = 源;
    (源, "0 = 甲;\n")拼接 = 源;
    (源, "0 = 乙; \n")拼接 = 源;
    (源, "0 = 丙，丁;\n")拼接 = 源;
    (源, "(\"未闭合)打印;\n")拼接 = 源;
    (源, "0 = 甲 === 乙;\n")拼接 = 源;
    (源, "// 注释豁免: 甲 === 乙，丙\n")拼接 = 源;
    (源, "\n")拼接 = 源;

    (源)代码检查诊断 = 诊断;
    (诊断)打印;

    // 空文本：无诊断，计数为 0
    "" = 空源;
    (空源)代码检查诊断 = 空诊断;
    (空诊断)打印;

    // 字面量感知：字符串内与注释内的 `===` / 全角标点不再误报
    ("--- 字面量感知 ---")打印;
    (34)字符 = 引;
    "" = 字面源;
    (字面源, "0 = 甲(")拼接 = 字面源;
    (字面源, 引)拼接 = 字面源;
    (字面源, "内含 === 与，标点")拼接 = 字面源;
    (字面源, 引)拼接 = 字面源;
    (字面源, ");\n")拼接 = 字面源;
    (字面源, "0 = 乙; // 注释里 === 与，也不算\n")拼接 = 字面源;
    (字面源)代码检查诊断 = 字面诊断;
    (字面诊断)打印;

    // 字符常量与块注释：内容一并屏蔽（含跨行块注释）；未闭合报 E004 / E003
    ("--- 字符常量与块注释 ---")打印;
    "" = 注释源;
    (注释源, "/* 块注释: 甲 === 乙，丙\n")拼接 = 注释源;
    (注释源, "   跨行仍屏蔽 */\n")拼接 = 注释源;
    (注释源, "0 = '，';\n")拼接 = 注释源;
    (注释源, "0 = 甲 === 乙;\n")拼接 = 注释源;
    (注释源)代码检查诊断 = 注释诊断;
    (注释诊断)打印;

    ("--- 未闭合诊断 ---")打印;
    "" = 未闭源;
    (未闭源, "0 = 'x;\n")拼接 = 未闭源;
    (未闭源, "/* 未闭合\n")拼接 = 未闭源;
    (未闭源)代码检查诊断 = 未闭诊断;
    (未闭诊断)打印;

    // 目录模式：仅收本层 `.心`、跳过子目录与其它扩展名、按路径升序
    ("--- 目录模式 ---")打印;
    ("构建")创建目录 = 根建;
    "构建/.代码检查" = 目录;
    (目录)创建目录 = 目录建;
    0 = 写码;
    "" = 源甲;
    (源甲, "0 = 甲; \n")拼接 = 源甲;
    (源甲, "0 = 甲 === 乙;\n")拼接 = 源甲;
    (目录, "甲.心")检查拼接路径 = 甲路径;
    (甲路径, 源甲)写入文件 = 写码;
    "" = 源乙;
    (源乙, "0 = 乙;\n")拼接 = 源乙;
    (目录, "乙.心")检查拼接路径 = 乙路径;
    (乙路径, 源乙)写入文件 = 写码;
    "" = 源丙;
    (源丙, "0 = 丙; \n")拼接 = 源丙;
    (目录, "丙.txt")检查拼接路径 = 丙路径;
    (丙路径, 源丙)写入文件 = 写码;
    ("甲.心")检查是源文件名 = 甲是源;
    (甲是源)打印;
    ("丙.txt")检查是源文件名 = 丙是源;
    (丙是源)打印;
    (目录)检查目录诊断 = (目录诊断, 文件数, 总错误);
    (目录诊断)打印;
    (文件数)打印;
    (总错误)打印;

    // 递归目录模式：子目录下的 `.心` 也纳入，路径升序（乙.心 → 子/丁.心 → 甲.心）
    ("--- 递归目录模式 ---")打印;
    (目录, "子")检查拼接路径 = 子目录;
    (子目录)创建目录 = 子建;
    "" = 源丁;
    (源丁, "0 = 丁 === 戊;\n")拼接 = 源丁;
    (子目录, "丁.心")检查拼接路径 = 丁路径;
    (丁路径, 源丁)写入文件 = 写码;
    (目录)检查目录诊断递归 = (递归诊断, 递归文件, 递归错误);
    (递归诊断)打印;
    (递归文件)打印;
    (递归错误)打印;

    // JSON 结构化输出（9.1）：扁平诊断数组 + 文件数/错误数，便于 AI 与工具消费
    ("--- JSON 模式 ---")打印;
    (目录, 0)检查目录诊断JSON = (JSON诊断, JSON文件, JSON错误);
    (JSON诊断)打印;
    (JSON文件)打印;
    (JSON错误)打印;
    (目录, 1)检查目录诊断JSON = (JSON递归, JSON递归文件, JSON递归错误);
    (JSON递归)打印;
    (JSON递归文件)打印;
    (JSON递归错误)打印;
    (乙路径)检查单文件诊断JSON = (JSON单文件, JSON单文件数, JSON单文件错);
    (JSON单文件)打印;
    (JSON单文件数)打印;
    (JSON单文件错)打印;

    // JSON 定位字段：`column`（1 基）与 `code`（W001–W003 / E001–E002），覆盖全部 5 条规则
    ("--- JSON 定位字段 ---")打印;
    "构建/.代码检查单" = 单元目录;
    (单元目录)创建目录 = 单元建;
    (单元目录, "全集.心")检查拼接路径 = 全集路径;
    (全集路径, 源)写入文件 = 写码;
    (全集路径)检查单文件诊断JSON = (全集JSON, 全集文件, 全集错误);
    (全集JSON)打印;
    (全集文件)打印;
    (全集错误)打印;

    // JSON 新增定位字段：E004（行内字符常量未闭合）/ E003（文末块注释未闭合）
    ("--- JSON 未闭合定位 ---")打印;
    "构建/.代码检查未闭" = 未闭目录;
    (未闭目录)创建目录 = 未闭建;
    (未闭目录, "未闭.心")检查拼接路径 = 未闭路径;
    (未闭路径, 未闭源)写入文件 = 写码;
    (未闭路径)检查单文件诊断JSON = (未闭JSON, 未闭文件, 未闭错误);
    (未闭JSON)打印;
    (未闭文件)打印;
    (未闭错误)打印;

    // 未使用变量（W004）：赋值目标全文件仅出现一次 → 「只写不读」
    ("--- 未使用变量 ---")打印;
    "" = 未用源;
    (未用源, "0 = 甲;\n")拼接 = 未用源;
    (未用源, "0 = 乙;\n")拼接 = 未用源;
    (未用源, "(乙)打印;\n")拼接 = 未用源;
    (未用源, "0 = 变量 全局;\n")拼接 = 未用源;
    (未用源, "外部 函数 (路径:字符串)打开(0 = 结果:整数);\n")拼接 = 未用源;
    (未用源, "0 = 丙; // 丙 仅在注释出现\n")拼接 = 未用源;
    (未用源, "0 = \"丁\";\n")拼接 = 未用源;
    (未用源)代码检查诊断 = 未用诊断;
    (未用诊断)打印;

    // 未使用变量（W004）细化：只统计「读位置」——赋值目标本身算写，不算读。
    //   · `双写` 写两次、从不读 → 报首次写入行（第 2 行），第二次不重复报；
    //   · `累加` 在赋值号左侧被读（`累加 + 1 = 累加;`）→ 有读，不报；
    //   · `形参` 仅出现在形参表（读位置）与其赋值目标 → 有读，不报。
    ("--- 未使用变量读位置 ---")打印;
    "" = 读位源;
    (读位源, "函数 读位(形参:整数) {\n")拼接 = 读位源;
    (读位源, "    0 = 双写;\n")拼接 = 读位源;
    (读位源, "    1 = 双写;\n")拼接 = 读位源;
    (读位源, "    0 = 累加;\n")拼接 = 读位源;
    (读位源, "    累加 + 1 = 累加;\n")拼接 = 读位源;
    (读位源, "    0 = 形参;\n")拼接 = 读位源;
    (读位源, "}\n")拼接 = 读位源;
    (读位源)代码检查诊断 = 读位诊断;
    (读位诊断)打印;

    // 未使用变量（W004）调用写豁免：赋值号左侧含括号 ⇒ 调用结果落地（输出参数 / 返回值
    //   有意丢弃），不报；只有纯字面量写入且从不读才报。
    ("--- 未使用变量调用写 ---")打印;
    "" = 调用写源;
    (调用写源, "函数 调用写示例 {\n")拼接 = 调用写源;
    (调用写源, "    (路径)读取文件 = 丢弃;\n")拼接 = 调用写源;
    (调用写源, "    0 = 纯写;\n")拼接 = 调用写源;
    (调用写源, "}\n")拼接 = 调用写源;
    (调用写源)代码检查诊断 = 调用写诊断;
    (调用写诊断)打印;

    // 不可达代码（W005）：同一块内 `中断;` / `继续;` 之后的同层语句
    //   花括号层级跟踪：`} 否则 {` 关闭旧块并另起分支，故 else 分支内的语句可达、不报
    ("--- 不可达代码 ---")打印;
    "" = 不可达源;
    (不可达源, "函数 不可达示例(甲:整数) {\n")拼接 = 不可达源;
    (不可达源, "    当 (甲 > 0) {\n")拼接 = 不可达源;
    (不可达源, "        中断;\n")拼接 = 不可达源;
    (不可达源, "        (甲)打印;\n")拼接 = 不可达源;
    (不可达源, "    }\n")拼接 = 不可达源;
    (不可达源, "    如果 (甲 > 0) {\n")拼接 = 不可达源;
    (不可达源, "        继续;\n")拼接 = 不可达源;
    (不可达源, "    } 否则 {\n")拼接 = 不可达源;
    (不可达源, "        (甲)打印;\n")拼接 = 不可达源;
    (不可达源, "    }\n")拼接 = 不可达源;
    (不可达源, "}\n")拼接 = 不可达源;
    (不可达源)代码检查诊断 = 不可达诊断;
    (不可达诊断)打印;

    ("--- JSON 不可达定位 ---")打印;
    "构建/.代码检查不可达" = 不可达目录;
    (不可达目录)创建目录 = 不可达建;
    (不可达目录, "不可达.心")检查拼接路径 = 不可达路径;
    (不可达路径, 不可达源)写入文件 = 写码;
    (不可达路径)检查单文件诊断JSON = (不可达JSON, 不可达文件, 不可达错误);
    (不可达JSON)打印;
    (不可达文件)打印;
    (不可达错误)打印;

    // 潜在空指针（W006）：`打开文件` / `分配` 的目标在首个使用前未判空 → 告警
    //   已判空（`如果 (已检 ?= 0)`）视为安全；同一变量只报一次（`缓冲` 第二次不重复）
    ("--- 潜在空指针 ---")打印;
    "" = 空指针源;
    (空指针源, "外部 函数 (字节数:整数)分配(0 = 结果:指针);\n")拼接 = 空指针源;
    (空指针源, "函数 示例(空) {\n")拼接 = 空指针源;
    (空指针源, "    (64)分配 = 缓冲;\n")拼接 = 空指针源;
    (空指针源, "    (缓冲, \"字\")复制文本 = 写码;\n")拼接 = 空指针源;
    (空指针源, "    (64)分配 = 缓冲;\n")拼接 = 空指针源;
    (空指针源, "    (缓冲)文本长度 = 长度;\n")拼接 = 空指针源;
    (空指针源, "    (写码)打印;\n")拼接 = 空指针源;
    (空指针源, "    (64)分配 = 已检;\n")拼接 = 空指针源;
    (空指针源, "    如果 (已检 ?= 0) {\n")拼接 = 空指针源;
    (空指针源, "        (0)打印;\n")拼接 = 空指针源;
    (空指针源, "    }\n")拼接 = 空指针源;
    (空指针源, "    (已检)文本长度 = 写码;\n")拼接 = 空指针源;
    (空指针源, "    (长度)打印;\n")拼接 = 空指针源;
    (空指针源, "}\n")拼接 = 空指针源;
    (空指针源)代码检查诊断 = 空指针诊断;
    (空指针诊断)打印;

    ("--- JSON 空指针定位 ---")打印;
    "构建/.代码检查空指针" = 空指针目录;
    (空指针目录)创建目录 = 空指针建;
    (空指针目录, "空指针.心")检查拼接路径 = 空指针路径;
    (空指针路径, 空指针源)写入文件 = 写码;
    (空指针路径)检查单文件诊断JSON = (空指针JSON, 空指针文件, 空指针错误);
    (空指针JSON)打印;
    (空指针文件)打印;
    (空指针错误)打印;

    // 类型不匹配（W007）：① `0 = 计数:字符串;` 字面量与标注冲突；② 同函数内 `编号` 先为整数、
    //   再被字符串字面量赋值 → 后者行告警；`名称` 在另一函数内重新推断，边界重置不误报
    ("--- 类型不匹配 ---")打印;
    "" = 类型源;
    (类型源, "函数 类型示例(空) {\n")拼接 = 类型源;
    (类型源, "    0 = 计数:字符串;\n")拼接 = 类型源;
    (类型源, "    \"文本\" = 名称;\n")拼接 = 类型源;
    (类型源, "    0 = 编号;\n")拼接 = 类型源;
    (类型源, "    \"错\" = 编号;\n")拼接 = 类型源;
    (类型源, "    (计数)打印;\n")拼接 = 类型源;
    (类型源, "    (名称)打印;\n")拼接 = 类型源;
    (类型源, "    (编号)打印;\n")拼接 = 类型源;
    (类型源, "}\n")拼接 = 类型源;
    (类型源, "函数 另一示例(空) {\n")拼接 = 类型源;
    (类型源, "    0 = 名称;\n")拼接 = 类型源;
    (类型源, "}\n")拼接 = 类型源;
    (类型源)代码检查诊断 = 类型诊断;
    (类型诊断)打印;

    ("--- JSON 类型不匹配定位 ---")打印;
    "构建/.代码检查类型" = 类型目录;
    (类型目录)创建目录 = 类型建;
    (类型目录, "类型.心")检查拼接路径 = 类型路径;
    (类型路径, 类型源)写入文件 = 写码;
    (类型路径)检查单文件诊断JSON = (类型JSON, 类型文件, 类型错误);
    (类型JSON)打印;
    (类型文件)打印;
    (类型错误)打印;

    // 模块版本
    ("--- 模块版本 ---")打印;
    ()代码检查器模块版本 = 版本;
    (版本)打印;
}
