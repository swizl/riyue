导入 "../工具/代码检查器.心";

函数 主程序 {
    ("=== 代码检查器测试 ===")打印;

    // 8 行样例：正常 / 制表缩进 / 行尾空白 / 全角标点 / 未闭合字符串 / 非法运算符 / 注释豁免 / 空行
    "函数 正常(空) {\n" = 源;
    (9)字符 = 制表;
    (源, 制表)拼接 = 源;
    (源, "0 = 甲;\n")拼接 = 源;
    (源, "0 = 乙; \n")拼接 = 源;
    (源, "0 = 丙，丁;\n")拼接 = 源;
    (源, "(\"未闭合)打印;\n")拼接 = 源;
    (源, "0 = 甲 === 乙;\n")拼接 = 源;
    (源, "// 注释豁免: 甲 === 乙，丙\n")拼接 = 源;
    (源, "\n")拼接 = 源;

    (源)代码检查诊断 = 诊断;
    (诊断)打印;

    // 空文本：无诊断，计数为 0
    "" = 空源;
    (空源)代码检查诊断 = 空诊断;
    (空诊断)打印;
}
