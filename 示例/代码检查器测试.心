// 阶段P7 续：代码检查器（纯 .心）——制表符缩进 / 行尾空白 / 全角标点 / 未闭合字符串 / 非法运算符
// 期望：示例/代码检查器测试.期望
导入 "../工具/代码检查器.心";

函数 主程序 {
    ("=== 代码检查器测试 ===")打印;

    // 8 行样例：正常 / 制表缩进 / 行尾空白 / 全角标点 / 未闭合字符串 / 非法运算符 / 注释豁免 / 空行
    "函数 正常(空) {\n" = 源;
    (9)字符 = 制表;
    (源, 制表)拼接 = 源;
    (源, "0 = 甲;\n")拼接 = 源;
    (源, "0 = 乙; \n")拼接 = 源;
    (源, "0 = 丙，丁;\n")拼接 = 源;
    (源, "(\"未闭合)打印;\n")拼接 = 源;
    (源, "0 = 甲 === 乙;\n")拼接 = 源;
    (源, "// 注释豁免: 甲 === 乙，丙\n")拼接 = 源;
    (源, "\n")拼接 = 源;

    (源)代码检查诊断 = 诊断;
    (诊断)打印;

    // 空文本：无诊断，计数为 0
    "" = 空源;
    (空源)代码检查诊断 = 空诊断;
    (空诊断)打印;

    // 目录模式：仅收本层 `.心`、跳过子目录与其它扩展名、按路径升序
    ("--- 目录模式 ---")打印;
    ("构建")创建目录 = 根建;
    "构建/.代码检查" = 目录;
    (目录)创建目录 = 目录建;
    0 = 写码;
    "" = 源甲;
    (源甲, "0 = 甲; \n")拼接 = 源甲;
    (源甲, "0 = 甲 === 乙;\n")拼接 = 源甲;
    (目录, "甲.心")检查拼接路径 = 甲路径;
    (甲路径, 源甲)写入文件 = 写码;
    "" = 源乙;
    (源乙, "0 = 乙;\n")拼接 = 源乙;
    (目录, "乙.心")检查拼接路径 = 乙路径;
    (乙路径, 源乙)写入文件 = 写码;
    "" = 源丙;
    (源丙, "0 = 丙; \n")拼接 = 源丙;
    (目录, "丙.txt")检查拼接路径 = 丙路径;
    (丙路径, 源丙)写入文件 = 写码;
    ("甲.心")检查是源文件名 = 甲是源;
    (甲是源)打印;
    ("丙.txt")检查是源文件名 = 丙是源;
    (丙是源)打印;
    (目录)检查目录诊断 = (目录诊断, 文件数, 总错误);
    (目录诊断)打印;
    (文件数)打印;
    (总错误)打印;

    // 递归目录模式：子目录下的 `.心` 也纳入，路径升序（乙.心 → 子/丁.心 → 甲.心）
    ("--- 递归目录模式 ---")打印;
    (目录, "子")检查拼接路径 = 子目录;
    (子目录)创建目录 = 子建;
    "" = 源丁;
    (源丁, "0 = 丁 === 戊;\n")拼接 = 源丁;
    (子目录, "丁.心")检查拼接路径 = 丁路径;
    (丁路径, 源丁)写入文件 = 写码;
    (目录)检查目录诊断递归 = (递归诊断, 递归文件, 递归错误);
    (递归诊断)打印;
    (递归文件)打印;
    (递归错误)打印;

    // 模块版本
    ("--- 模块版本 ---")打印;
    ()代码检查器模块版本 = 版本;
    (版本)打印;
}
