// 闭包简单测试

函数 主程序 {
    ("=== 闭包简单测试 ===")打印;

    100 = 基数;
    函数 (值:整数)(结果: 整数) {
        值 + 基数 = 结果;
    } = 加基数;

    (50)加基数 = r1;
    (r1)打印;

    3 = 乘数;
    函数 (值:整数)(结果: 整数) {
        值 * 乘数 = 结果;
    } = 乘以;

    (10)乘以 = r2;
    (r2)打印;

    ("=== 测试完成 ===")打印;
}
