// 集合互斥与大小判定测试（8CB）
//
// 导入 标准库/集合.心，验证 8CB 新增的 `数组是否互斥`/`数组差集大小`/`数组交集大小`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/集合.心";

函数 主程序 {
    ("=== 集合互斥与大小判定测试（8CB）===")打印;

    // 甲 = [1, 2, 3]
    ()创建动态数组 = 甲;
    (甲, 1)动态数组添加;
    (甲, 2)动态数组添加;
    (甲, 3)动态数组添加;

    // 乙 = [4, 5]
    ()创建动态数组 = 乙;
    (乙, 4)动态数组添加;
    (乙, 5)动态数组添加;

    // 丙 = [3, 4, 5]
    ()创建动态数组 = 丙;
    (丙, 3)动态数组添加;
    (丙, 4)动态数组添加;
    (丙, 5)动态数组添加;

    // 丁 = [1, 2, 3, 2]
    ()创建动态数组 = 丁;
    (丁, 1)动态数组添加;
    (丁, 2)动态数组添加;
    (丁, 3)动态数组添加;
    (丁, 2)动态数组添加;

    // 戊 = []
    ()创建动态数组 = 戊;

    // ---- 数组是否互斥 ----
    ("-- 数组是否互斥 --")打印;
    (甲, 3, 乙, 2)数组是否互斥 = d1;
    ("[1,2,3] 互斥 [4,5]:")打印;
    (d1)打印;
    (甲, 3, 丙, 3)数组是否互斥 = d2;
    ("[1,2,3] 互斥 [3,4,5]:")打印;
    (d2)打印;
    (乙, 2, 丙, 3)数组是否互斥 = d3;
    ("[4,5] 互斥 [3,4,5]:")打印;
    (d3)打印;
    (甲, 3, 戊, 0)数组是否互斥 = d4;
    ("[1,2,3] 互斥 []:")打印;
    (d4)打印;

    // ---- 数组差集大小 ----
    ("-- 数组差集大小 --")打印;
    (甲, 3, 乙, 2)数组差集大小 = s1;
    ("[1,2,3] 差 [4,5]:")打印;
    (s1)打印;
    (甲, 3, 丙, 3)数组差集大小 = s2;
    ("[1,2,3] 差 [3,4,5]:")打印;
    (s2)打印;
    (丁, 4, 甲, 3)数组差集大小 = s3;
    ("[1,2,3,2] 差 [1,2,3]:")打印;
    (s3)打印;
    (戊, 0, 甲, 3)数组差集大小 = s4;
    ("[] 差 [1,2,3]:")打印;
    (s4)打印;

    // ---- 数组交集大小 ----
    ("-- 数组交集大小 --")打印;
    (甲, 3, 丙, 3)数组交集大小 = i1;
    ("[1,2,3] 交 [3,4,5]:")打印;
    (i1)打印;
    (丁, 4, 甲, 3)数组交集大小 = i2;
    ("[1,2,3,2] 交 [1,2,3]:")打印;
    (i2)打印;
    (甲, 3, 乙, 2)数组交集大小 = i3;
    ("[1,2,3] 交 [4,5]:")打印;
    (i3)打印;
    (戊, 0, 甲, 3)数组交集大小 = i4;
    ("[] 交 [1,2,3]:")打印;
    (i4)打印;

    ("=== 测试完成 ===")打印;
}
