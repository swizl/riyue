// 阶段3C：保守 GC 冒烟 —— 显式启用后批量创建/丢弃动态数组：
//   · 回收不崩溃、不重复 free；
//   · 仍被局部变量持有的数组连同其数据缓冲必须保活（内容不损坏）。
// 期望输出：GC压测: 通过

// 批量创建后立即丢弃引用（栈帧返回后这些对象不可达，可被回收）
函数 (数量:整数)临时分配 {
    0 = i;
    当 (i < 数量) {
        ()创建动态数组 = 临时;
        (临时, i)动态数组添加;
        (临时, 数量)动态数组添加;
        i + 1 = i;
    }
}

函数 主程序 {
    ()启用GC;
    (64)设置GC阈值;

    // 主程序持有、跨越多次回收仍然存活的对象
    ()创建动态数组 = 保留;
    0 = i;
    当 (i < 64) {
        (保留, i * 2)动态数组添加;
        i + 1 = i;
    }

    // 触发阈值自动回收，再手工全量回收一次
    (200)临时分配;
    ()执行GC;

    ()获取GC对象数量 = 存活数;
    (保留, 0)动态数组获取 = 首值;
    (保留, 63)动态数组获取 = 末值;

    0 = 校验;
    如果 (首值 ?= 0 && 末值 ?= 126 && 存活数 > 0) {
        1 = 校验;
    }
    如果 (校验 ?= 1) {
        "GC压测: 通过" = 消息;
    } 否则 {
        "GC压测: 失败" = 消息;
    }
    (消息)打印;
}
