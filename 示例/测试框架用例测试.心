// 测试框架：用例组织 / 过滤 / 钩子 / 异常断言 / 报告

导入 "../标准库/测试框架.心";

0 = 前置次数:整数;
0 = 后置次数:整数;

函数 重置钩子(空) {
    0 = 前置次数;
    0 = 后置次数;
}

函数 主程序 {
    ("=== 测试框架用例测试 ===")打印;

    入()函数(空) {
        (1 + 1, 2, "加法")断言等于;
        (2 * 3, 6, "乘法")断言等于;
    } = 用例甲;

    ("-- 运行用例 --")打印;
    ()测试重置;
    ("用例甲", 用例甲)测试运行;

    ("-- 过滤 --")打印;
    ("用例甲", "甲", 用例甲)测试运行过滤;
    ("用例乙", "甲", 用例甲)测试运行过滤;

    ("-- 钩子 --")打印;
    ()重置钩子;
    入()函数(空) {
        前置次数 + 1 = 前置次数;
    } = 前置;
    入()函数(空) {
        后置次数 + 1 = 后置次数;
        (后置次数, 1, "后置钩子执行")断言等于;
    } = 后置;
    入()函数(空) {
        (前置次数, 1, "前置钩子执行")断言等于;
    } = 带钩主体;
    ("带钩用例", 前置, 带钩主体, 后置)测试运行带钩子;
    (后置次数, 1, "后置钩子已执行")断言等于;

    ("-- 异常断言 --")打印;
    入()函数(空) {
        (42)抛出;
    } = 抛体;
    入()函数(空) {
        0 = 标记;
        1 = 标记;
    } = 宁体;
    (抛体, "抛出被捕获")断言抛出;
    (宁体, "未抛出")断言不抛出;

    ("-- 抛出的用例 --")打印;
    ("抛出用例", 抛体)测试运行;

    ("-- 报告 --")打印;
    (测试通过数)打印;
    (测试失败数)打印;
    (测试跳过数)打印;
    ()测试通过率 = 率;
    (率)打印;
    ()测试报告;
    ()测试是否全通过 = 全通;
    (全通)打印;

    ("=== 测试完成 ===")打印;
}
