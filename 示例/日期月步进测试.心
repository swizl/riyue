// 日期查询与月步进测试（8BU）
//
// 导入 标准库/日期时间.心，验证 8BU 新增的 `日期是否有效`/`年积日`/`季度`/`日期加月数`。
// 纯 `.心`，双链（引导.exe / 日月.exe）编译运行 stdout 应逐字一致。

导入 "标准库/日期时间.心";

// 打印 出[0]/出[1]/出[2]（年/月/日）
函数 (出)打印三分量(空) {
    (出, 0)动态数组获取 = y;
    (出, 1)动态数组获取 = m;
    (出, 2)动态数组获取 = d;
    (y)打印;
    (m)打印;
    (d)打印;
}

函数 主程序 {
    ("=== 日期月步进测试（8BU）===")打印;

    // ---- 日期是否有效 ----
    ("-- 日期是否有效 --")打印;
    (2024, 2, 29)日期是否有效 = v1;
    ("2024-02-29:")打印;
    (v1)打印;
    (2023, 2, 29)日期是否有效 = v2;
    ("2023-02-29:")打印;
    (v2)打印;
    (2024, 4, 31)日期是否有效 = v3;
    ("2024-04-31:")打印;
    (v3)打印;
    (2024, 13, 1)日期是否有效 = v4;
    ("2024-13-01:")打印;
    (v4)打印;
    (2024, 0, 5)日期是否有效 = v5;
    ("2024-00-05:")打印;
    (v5)打印;
    (2024, 12, 31)日期是否有效 = v6;
    ("2024-12-31:")打印;
    (v6)打印;

    // ---- 年积日 ----
    ("-- 年积日 --")打印;
    (2024, 1, 1)年积日 = n1;
    ("2024-01-01:")打印;
    (n1)打印;
    (2024, 12, 31)年积日 = n2;
    ("2024-12-31:")打印;
    (n2)打印;
    (2023, 12, 31)年积日 = n3;
    ("2023-12-31:")打印;
    (n3)打印;
    (2024, 3, 1)年积日 = n4;
    ("2024-03-01:")打印;
    (n4)打印;

    // ---- 季度 ----
    ("-- 季度 --")打印;
    (1)季度 = q1;
    ("月1:")打印;
    (q1)打印;
    (3)季度 = q2;
    ("月3:")打印;
    (q2)打印;
    (4)季度 = q3;
    ("月4:")打印;
    (q3)打印;
    (6)季度 = q4;
    ("月6:")打印;
    (q4)打印;
    (7)季度 = q5;
    ("月7:")打印;
    (q5)打印;
    (12)季度 = q6;
    ("月12:")打印;
    (q6)打印;

    // ---- 日期加月数 ----
    ("-- 日期加月数 --")打印;
    ()创建动态数组 = 月甲;
    (月甲, 0)动态数组添加;
    (月甲, 0)动态数组添加;
    (月甲, 0)动态数组添加;
    (2024, 1, 31, 1, 月甲)日期加月数;
    ("2024-01-31 +1:")打印;
    (月甲)打印三分量;
    ()创建动态数组 = 月乙;
    (月乙, 0)动态数组添加;
    (月乙, 0)动态数组添加;
    (月乙, 0)动态数组添加;
    (2023, 1, 31, 1, 月乙)日期加月数;
    ("2023-01-31 +1:")打印;
    (月乙)打印三分量;
    ()创建动态数组 = 月丙;
    (月丙, 0)动态数组添加;
    (月丙, 0)动态数组添加;
    (月丙, 0)动态数组添加;
    (2024, 1, 15, 13, 月丙)日期加月数;
    ("2024-01-15 +13:")打印;
    (月丙)打印三分量;
    ()创建动态数组 = 月丁;
    (月丁, 0)动态数组添加;
    (月丁, 0)动态数组添加;
    (月丁, 0)动态数组添加;
    (2024, 3, 31, 0 - 1, 月丁)日期加月数;
    ("2024-03-31 -1:")打印;
    (月丁)打印三分量;
    ()创建动态数组 = 月戊;
    (月戊, 0)动态数组添加;
    (月戊, 0)动态数组添加;
    (月戊, 0)动态数组添加;
    (2024, 11, 30, 3, 月戊)日期加月数;
    ("2024-11-30 +3:")打印;
    (月戊)打印三分量;
    ()创建动态数组 = 月己;
    (月己, 0)动态数组添加;
    (月己, 0)动态数组添加;
    (月己, 0)动态数组添加;
    (2024, 5, 15, 0, 月己)日期加月数;
    ("2024-05-15 +0:")打印;
    (月己)打印三分量;

    ("=== 测试完成 ===")打印;
}
