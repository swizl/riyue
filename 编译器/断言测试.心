// 断言测试

函数 断言(条件:整数, 消息:字符串) {
    ("断言调用")打印;
    ("条件: ")打印;
    (条件)打印;
    ("消息: ")打印;
    (消息)打印;
    如果 (条件 ?= 1) {
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        ("  ✗ ")打印;
        (消息)打印;
    }
}

函数 测试(空) {
    ("=== 测试 ===")打印;
    
    (1, "测试1")断言;
    (0, "测试2")断言;
    
    ("=== 完成 ===")打印;
}

函数 主程序 {
    ()测试;
}
