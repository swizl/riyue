// ============================================
// 日月编译器 — 词法器
// 词法分析器 + 表达式求值器（自包含，无导入）
//
// 将源代码转换为标记流，支持:
//   数字、标识符、单/双字符运算符、注释
//   优先级爬升表达式求值
//
// 已知限制:
//   - 字符串比较用 ?= (!= 做指针比较)
//   - 不用 ||/&& 与 ?= 组合
//   - 不用前向声明
// ============================================

// ────────────────────────────────────────────
// 测试基础设施 (Test Infrastructure)
// ────────────────────────────────────────────

0 = 变量 测试通过;
0 = 变量 测试失败;

函数 (实际:整数, 期望:整数)断言相等 {
    如果 (实际 ?= 期望) {
        测试通过 + 1 = 测试通过;
    } 否则 {
        测试失败 + 1 = 测试失败;
        ("[失败] 期望=")打印;
        (期望)打印;
        (" 实际=")打印;
        (实际)打印;
    }
}

函数 (期望:整数)检查标记 {
    如果 (当前标记类型 ?= 期望) { 测试通过 + 1 = 测试通过; } 否则 { 测试失败 + 1 = 测试失败; ("[失败] 标记检查")打印; }
}

// ────────────────────────────────────────────
// 词法分析器 (Lexer)
// 将源代码字符串转换为标记流
// ────────────────────────────────────────────

"" = 变量 源代码;
0 = 变量 源位置;
0 = 变量 当前标记类型;
0 = 变量 当前标记数值;

// 标记类型常量 (Token Types)
0 = 变量 T_NUM;       // 整数字面量
1 = 变量 T_IDENT;     // 标识符
3 = 变量 T_PLUS;      // +
4 = 变量 T_MINUS;     // -
5 = 变量 T_STAR;      // *
6 = 变量 T_SLASH;     // /
7 = 变量 T_PCT;       // %
8 = 变量 T_LPAREN;    // (
9 = 变量 T_RPAREN;    // )
10 = 变量 T_LBRACE;   // {
11 = 变量 T_RBRACE;   // }
12 = 变量 T_SEMI;     // ;
18 = 变量 T_ASSIGN;   // =
19 = 变量 T_EQ;       // ==
20 = 变量 T_NEQ;      // !=
21 = 变量 T_LT;       // <
22 = 变量 T_GT;       // >
23 = 变量 T_LE;       // <=
24 = 变量 T_GE;       // >=
25 = 变量 T_AND;      // &&
26 = 变量 T_OR;       // ||
27 = 变量 T_NOT;      // !
28 = 变量 T_EOF;      // 文件结束

// 跳过空白与单行注释
函数 跳过空白 {
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源代码, 源位置)字符码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) {
            源位置 + 1 = 源位置;
        } 否则如果 (码 ?= 47) {
            // 可能是 // 注释
            源位置 + 1 = 源位置;
            (源代码)长度 = 长;
            如果 (源位置 < 长) {
                 (源代码, 源位置)字符码 = 第二码;
                如果 (第二码 ?= 47) {
                    // 单行注释：跳到行尾
                    当 (源位置 < 长) {
                         (源代码, 源位置)字符码 = 注释码;
                        如果 (注释码 ?= 10) { 中断; }
                        源位置 + 1 = 源位置;
                    }
                    // 吃掉换行
                    (源代码)长度 = 长;
                    如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 10) { 源位置 + 1 = 源位置; }
                } 否则 {
                    // 不是注释，回退
                    源位置 - 1 = 源位置;
                    中断;
                }
            } 否则 {
                源位置 - 1 = 源位置;
                中断;
            }
        } 否则 {
            中断;
        }
    }
}

// 扫描数字
函数 扫数字 {
    "" = 数字文本;
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源代码, 源位置)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            (源代码, 源位置, 1)子串 = 字;
            数字文本 + 字 = 数字文本;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_NUM = 当前标记类型;
    (数字文本)转整数 = 当前标记数值;
}

// 扫描标识符（支持中文字符）
函数 扫标识符 {
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源代码, 源位置)字符码 = 码;
        如果 ((码 >= 97 && 码 <= 122) || (码 >= 65 && 码 <= 90) || (码 >= 48 && 码 <= 57) || 码 ?= 95 || 码 > 127) {
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_IDENT = 当前标记类型;
}

// 扫描下一个标记
函数 扫描标记 {
    ()跳过空白;
    (源代码)长度 = 长;
    如果 (源位置 >= 长) {
        T_EOF = 当前标记类型;
    } 否则 {
        (源代码, 源位置)字符码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            ()扫数字;
        } 否则如果 ((码 >= 97 && 码 <= 122) || (码 >= 65 && 码 <= 90) || 码 ?= 95 || 码 > 127) {
            ()扫标识符;
        } 否则 {
            源位置 + 1 = 源位置;
            如果 (码 ?= 61) {
                // = 或 ==
                (源代码)长度 = 长;
                如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 61) { 源位置 + 1 = 源位置; T_EQ = 当前标记类型; } 否则 { T_ASSIGN = 当前标记类型; }
            } 否则如果 (码 ?= 33) {
                // ! 或 !=
                (源代码)长度 = 长;
                如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 61) { 源位置 + 1 = 源位置; T_NEQ = 当前标记类型; } 否则 { T_NOT = 当前标记类型; }
            } 否则如果 (码 ?= 60) {
                // < 或 <=
                (源代码)长度 = 长;
                如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 61) { 源位置 + 1 = 源位置; T_LE = 当前标记类型; } 否则 { T_LT = 当前标记类型; }
            } 否则如果 (码 ?= 62) {
                // > 或 >=
                (源代码)长度 = 长;
                如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 61) { 源位置 + 1 = 源位置; T_GE = 当前标记类型; } 否则 { T_GT = 当前标记类型; }
            } 否则如果 (码 ?= 38) {
                // & 或 &&
                (源代码)长度 = 长;
                如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 38) { 源位置 + 1 = 源位置; }
                T_AND = 当前标记类型;
            } 否则如果 (码 ?= 124) {
                // | 或 ||
                (源代码)长度 = 长;
                如果 (源位置 < 长 && (源代码, 源位置)字符码 ?= 124) { 源位置 + 1 = 源位置; }
                T_OR = 当前标记类型;
            } 否则如果 (码 ?= 43) { T_PLUS = 当前标记类型; }
            否则如果 (码 ?= 45) { T_MINUS = 当前标记类型; }
            否则如果 (码 ?= 42) { T_STAR = 当前标记类型; }
            否则如果 (码 ?= 47) { T_SLASH = 当前标记类型; }
            否则如果 (码 ?= 37) { T_PCT = 当前标记类型; }
            否则如果 (码 ?= 40) { T_LPAREN = 当前标记类型; }
            否则如果 (码 ?= 41) { T_RPAREN = 当前标记类型; }
            否则如果 (码 ?= 123) { T_LBRACE = 当前标记类型; }
            否则如果 (码 ?= 125) { T_RBRACE = 当前标记类型; }
            否则如果 (码 ?= 59) { T_SEMI = 当前标记类型; }
            否则 { T_EOF = 当前标记类型; }
        }
    }
}

// ────────────────────────────────────────────
// 语法分析器 (Parser) — 优先级爬升 (Precedence Climbing)
// 直接求值表达式，不构建 AST
//
// 优先级层次:
//   1: || (逻辑或)
//   2: && (逻辑与)
//   3: == != < > <= >= (比较)
//   4: + - (加减)
//   5: * / % (乘除取模)
// ────────────────────────────────────────────

函数 获取优先级(0 = 结果:整数) {
    0 = 结果;
    如果 (当前标记类型 ?= T_OR) { 1 = 结果; }
    如果 (当前标记类型 ?= T_AND) { 2 = 结果; }
    如果 (当前标记类型 ?= T_EQ || 当前标记类型 ?= T_NEQ || 当前标记类型 ?= T_LT || 当前标记类型 ?= T_GT || 当前标记类型 ?= T_LE || 当前标记类型 ?= T_GE) { 3 = 结果; }
    如果 (当前标记类型 ?= T_PLUS || 当前标记类型 ?= T_MINUS) { 4 = 结果; }
    如果 (当前标记类型 ?= T_STAR || 当前标记类型 ?= T_SLASH || 当前标记类型 ?= T_PCT) { 5 = 结果; }
}

函数 解析原子(0 = 结果:整数) {
    0 = 结果;
    如果 (当前标记类型 ?= T_MINUS) {
        ()扫描标记;
        ()解析原子 = 原子值;
        0 - 原子值 = 结果;
    }
    如果 (当前标记类型 ?= T_NOT) {
        ()扫描标记;
        ()解析原子 = 值;
        如果 (值 ?= 0) { 1 = 结果; } 否则 { 0 = 结果; }
    }
    如果 (当前标记类型 ?= T_NUM) {
        当前标记数值 = 值;
        ()扫描标记;
        值 = 结果;
    }
    如果 (当前标记类型 ?= T_LPAREN) {
        ()扫描标记;
        (1)解析表达式_内部 = 值;
        如果 (当前标记类型 ?= T_RPAREN) { ()扫描标记; }
        值 = 结果;
    }
}

函数 (最小优先级:整数)解析表达式_内部(0 = 结果:整数) {
    ()解析原子 = 左;
    当 (真) {
        ()获取优先级 = 优先级;
        如果 (优先级 < 最小优先级) { 中断; }
        当前标记类型 = 操作;
        ()扫描标记;
        (优先级 + 1)解析表达式_内部 = 右;
        如果 (操作 ?= T_PLUS) { 左 + 右 = 左; }
        如果 (操作 ?= T_MINUS) { 左 - 右 = 左; }
        如果 (操作 ?= T_STAR) { 左 * 右 = 左; }
        如果 (操作 ?= T_SLASH) { 如果 (右 != 0) { 左 / 右 = 左; } }
        如果 (操作 ?= T_PCT) { 如果 (右 != 0) { 左 % 右 = 左; } }
        如果 (操作 ?= T_EQ) { (左 ?= 右) = 左; }
        如果 (操作 ?= T_NEQ) { (左 != 右) = 左; }
        如果 (操作 ?= T_LT) { (左 < 右) = 左; }
        如果 (操作 ?= T_GT) { (左 > 右) = 左; }
        如果 (操作 ?= T_LE) { (左 <= 右) = 左; }
        如果 (操作 ?= T_GE) { (左 >= 右) = 左; }
        如果 (操作 ?= T_AND) { (左 && 右) = 左; }
        如果 (操作 ?= T_OR) { (左 || 右) = 左; }
    }
    左 = 结果;
}

函数 解析表达式(0 = 结果:整数) {
    (1)解析表达式_内部 = 结果;
}

