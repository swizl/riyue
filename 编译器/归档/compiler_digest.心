// ============================================
// 日月编译器 — 自举源码 (compiler.心)
// 自我解析 + 确定性摘要输出
//
// Stage1 源：用 日月 语言编写的编译器骨架，
// 读取自身源码做词法/语法结构分析，
// 统计 函数/变量/语句 数量并输出确定性摘要，
// 用于三段 digest 不动点验证。
// ============================================

// ────────────────────────────────────────────
// 全局状态 (Global State)
// ────────────────────────────────────────────

"" = 变量 源码;
0 = 变量 源位置;
0 = 变量 当前行号;
0 = 变量 函数数量;
0 = 变量 变量数量;
0 = 变量 语句数量;
0 = 变量 哈希值;
0 = 变量 标记类型;
"" = 变量 标记值;

// 摘要哈希：哈希值 = (哈希值 * 31 + 值) % 1000000007
函数 (值:整数)更新哈希 {
    哈希值 * 31 = 哈希值;
    哈希值 + 值 = 哈希值;
    哈希值 % 1000000007 = 哈希值;
}

// ────────────────────────────────────────────
// 字符操作 (Character Operations)
// ────────────────────────────────────────────

函数 当前字符码(0 = 结果:整数) {
    (源码)长度 = 长;
    如果 (源位置 < 长) {
        (源码, 源位置)字符码 = 结果;
    } 否则 {
        0 - 1 = 结果;
    }
}

函数 下一个字符码(0 = 结果:整数) {
    (源码)长度 = 长;
    如果 (源位置 + 1 < 长) {
        (源码, 源位置 + 1)字符码 = 结果;
    } 否则 {
        0 - 1 = 结果;
    }
}

函数 前进 {
    (源码, 源位置)字符码 = 当前码;
    如果 (当前码 ?= 10) { 当前行号 + 1 = 当前行号; }
    源位置 + 1 = 源位置;
}

函数 (码:整数)是空白(0 = 结果:整数) {
    0 = 结果;
    如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10 || 码 ?= 13) { 1 = 结果; }
}

函数 (码:整数)是数字(0 = 结果:整数) {
    0 = 结果;
    如果 (码 >= 48 && 码 <= 57) { 1 = 结果; }
}

函数 (码:整数)是字母开始(0 = 结果:整数) {
    0 = 结果;
    如果 ((码 >= 65 && 码 <= 90) || (码 >= 97 && 码 <= 122) || 码 > 127) { 1 = 结果; }
}

函数 (码:整数)是字母数字(0 = 结果:整数) {
    0 = 结果;
    如果 ((码 >= 65 && 码 <= 90) || (码 >= 97 && 码 <= 122) || (码 >= 48 && 码 <= 57) || 码 ?= 95 || 码 > 127) { 1 = 结果; }
}

// ────────────────────────────────────────────
// 词法分析 (Lexer)
// ────────────────────────────────────────────

函数 跳过空白注释 {
    (源码)长度 = 长;
    当 (源位置 < 长) {
        ()当前字符码 = 码;
        (码)是空白 = 是空白结果;
        如果 (是空白结果 ?= 1) {
            ()前进;
        } 否则如果 (码 ?= 47) {
            ()下一个字符码 = 第二码;
            如果 (第二码 ?= 47) {
                // // 单行注释：跳到行尾
                当 (源位置 < 长) {
                    ()当前字符码 = 行内码;
                    如果 (行内码 ?= 10) { 中断; }
                    ()前进;
                }
            } 否则如果 (第二码 ?= 42) {
                // /* 块注释 */
                ()前进;
                ()前进;
                当 (源位置 < 长) {
                    ()当前字符码 = 块码;
                    ()下一个字符码 = 块下码;
                    如果 (块码 ?= 42 && 块下码 ?= 47) {
                        ()前进;
                        ()前进;
                        中断;
                    }
                    ()前进;
                }
            } 否则 {
                中断;
            }
        } 否则 {
            中断;
        }
    }
}

函数 下一个标记 {
    ()跳过空白注释;
    (源码)长度 = 长;
    如果 (源位置 >= 长) {
        0 = 标记类型;
        "" = 标记值;
    } 否则 {
        ()当前字符码 = 码;
        (码)是数字 = 是数字结果;
        如果 (是数字结果 ?= 1) {
            // 数字
            1 = 标记类型;
            "" = 数字文本;
            当 (真) {
                ()当前字符码 = 当前码;
                (当前码)是数字 = 是数字结果;
                如果 (是数字结果 ?= 1) {
                    (源码, 源位置, 1)子串 = 字;
                    数字文本 + 字 = 数字文本;
                    ()前进;
                } 否则 {
                    中断;
                }
            }
            数字文本 = 标记值;
        } 否则 {
            (码)是字母开始 = 是字母开始结果;
            如果 (是字母开始结果 ?= 1) {
                // 标识符
                2 = 标记类型;
                "" = 标识文本;
                当 (真) {
                    ()当前字符码 = 当前码;
                    (当前码)是字母数字 = 是字母数字结果;
                    如果 (是字母数字结果 ?= 1) {
                        (源码, 源位置, 1)子串 = 字;
                        标识文本 + 字 = 标识文本;
                        ()前进;
                    } 否则 {
                        中断;
                    }
                }
                标识文本 = 标记值;
            } 否则如果 (码 ?= 34) {
                // 字符串字面量
                3 = 标记类型;
                ()前进;
                "" = 字符串文本;
                当 (真) {
                    ()当前字符码 = 当前码;
                    如果 (当前码 ?= 34) {
                        ()前进;
                        中断;
                    } 否则如果 (当前码 ?= 92) {
                        // 转义字符
                        ()前进;
                        ()当前字符码 = 转义码;
                        如果 (转义码 ?= 110) { 字符串文本 + "\n" = 字符串文本; }
                        否则如果 (转义码 ?= 116) { 字符串文本 + "\t" = 字符串文本; }
                        否则 { (源码, 源位置, 1)子串 = 转义字; 字符串文本 + 转义字 = 字符串文本; }
                        ()前进;
                    } 否则 {
                        (源码, 源位置, 1)子串 = 字;
                        字符串文本 + 字 = 字符串文本;
                        ()前进;
                    }
                }
                字符串文本 = 标记值;
            } 否则 {
                // 运算符（含双字符）
                4 = 标记类型;
                (源码, 源位置, 1)子串 = 操作符;
                操作符 = 标记值;
                ()前进;
                ()当前字符码 = 第二码;
                如果 (操作符 ?= "=") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 62) { 标记值 + ">" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 43) { 标记值 + "+" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 45) { 标记值 + "-" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 42) { 标记值 + "*" = 标记值; ()前进; }
                    否则如果 (第二码 ?= 47) { 标记值 + "/" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "!") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "<") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= ">") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "&") {
                    如果 (第二码 ?= 38) { 标记值 + "&" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "|") {
                    如果 (第二码 ?= 124) { 标记值 + "|" = 标记值; ()前进; }
                } 否则如果 (操作符 ?= "?") {
                    如果 (第二码 ?= 61) { 标记值 + "=" = 标记值; ()前进; }
                }
            }
        }
    }
}

// ────────────────────────────────────────────
// 语法分析 (Parser) — 结构统计，不构建 AST
// ────────────────────────────────────────────

函数 是表达式结束(0 = 结果:整数) {
    0 = 结果;
    如果 (标记类型 ?= 4) {
        如果 (标记值 ?= ";" || 标记值 ?= "," || 标记值 ?= ")" || 标记值 ?= "]" || 标记值 ?= "}" || 标记值 ?= "{") { 1 = 结果; }
    }
}

// 跳过表达式（含嵌套括号/方括号/调用）
函数 跳过表达式 {
    0 = 括号深度;
    0 = 方括号深度;
    当 (真) {
        ()是表达式结束 = 是结束结果;
        如果 (是结束结果 ?= 1 && 括号深度 ?= 0 && 方括号深度 ?= 0) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "(") {
                括号深度 + 1 = 括号深度;
            } 否则如果 (标记值 ?= ")") {
                如果 (括号深度 > 0) { 括号深度 - 1 = 括号深度; }
            } 否则如果 (标记值 ?= "[") {
                方括号深度 + 1 = 方括号深度;
            } 否则如果 (标记值 ?= "]") {
                如果 (方括号深度 > 0) { 方括号深度 - 1 = 方括号深度; }
            }
        }
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
    }
}

// 跳过代码块 { ... }
函数 跳过代码块 {
    1 = 块深度;
    当 (真) {
        ()下一个标记;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        如果 (标记类型 ?= 4) {
            如果 (标记值 ?= "{") {
                块深度 + 1 = 块深度;
            } 否则如果 (标记值 ?= "}") {
                如果 (块深度 > 0) { 块深度 - 1 = 块深度; }
                如果 (块深度 ?= 0) { 中断; }
            }
        }
    }
}

// 解析并统计一条语句
函数 解析语句 {
    语句数量 + 1 = 语句数量;
    如果 (标记值 ?= "变量" || 标记值 ?= "常量") {
        变量数量 + 1 = 变量数量;
        ()下一个标记;
    } 否则如果 (标记值 ?= "函数") {
        函数数量 + 1 = 函数数量;
        ()下一个标记;
        // 跳到代码块
        当 (真) {
            (源码)长度 = 长;
            如果 (源位置 >= 长) { 中断; }
            如果 (标记值 ?= "{") {
                ()跳过代码块;
                中断;
            }
            ()下一个标记;
        }
    } 否则如果 (标记值 ?= "如果" || 标记值 ?= "否则如果") {
        ()跳过表达式;
        ()下一个标记;
        ()跳过代码块;
    } 否则如果 (标记值 ?= "否则") {
        ()下一个标记;
        ()跳过代码块;
    } 否则如果 (标记值 ?= "当") {
        ()跳过表达式;
        ()下一个标记;
        ()跳过代码块;
    } 否则如果 (标记值 ?= "循环") {
        ()跳过表达式;
        ()下一个标记;
        如果 (标记值 ?= "{") { ()跳过代码块; }
    } 否则如果 (标记值 ?= "返回" || 标记值 ?= "打印" || 标记值 ?= "中断" || 标记值 ?= "继续") {
        ()跳过表达式;
    } 否则如果 (标记值 ?= "{") {
        ()跳过代码块;
    } 否则 {
        // 赋值 / 调用 / 表达式语句
        ()跳过表达式;
        ()下一个标记;
        如果 (标记值 ?= "=" || 标记值 ?= "+=" || 标记值 ?= "-=" || 标记值 ?= "*=" || 标记值 ?= "/=" || 标记值 ?= "[") {
            ()跳过表达式;
        }
    }
}

// 解析整个程序
函数 解析程序 {
    ()下一个标记;
    当 (真) {
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
        ()解析语句;
        (源码)长度 = 长;
        如果 (源位置 >= 长) { 中断; }
    }
}

// ────────────────────────────────────────────
// 主程序
// ────────────────────────────────────────────

函数 主程序 {
    // 读取自身源码
    ("自举/compiler.心")读取文件 = 源码;
    ()解析程序;
    // 摘要统计
    (函数数量)更新哈希;
    (变量数量)更新哈希;
    (语句数量)更新哈希;
    (源码)长度 = 长;
    0 = 循环索引;
    当 (循环索引 < 长) {
        (源码, 循环索引)字符码 = 每个码;
        (每个码)更新哈希;
        循环索引 + 1 = 循环索引;
    }
    ("DIGEST")打印;
    (函数数量)打印;
    (变量数量)打印;
    (语句数量)打印;
    (哈希值)打印;
    ("END")打印;
}
