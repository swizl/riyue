// ============================================
// Stage 0: 最小子集 — 基础功能验证
// 验证编译器能正确编译最基本的语法
// ============================================

函数 断言(条件, 消息): 空 {
    如果 (!条件) {
        打印("[失败] ");
        打印(消息);
    }
}

// --- 整数运算 ---
函数 测试整数运算(): 空 {
    变量 a = 10;
    变量 b = 3;
    断言(a + b ?= 13, "加法");
    断言(a - b ?= 7, "减法");
    断言(a * b ?= 30, "乘法");
    断言(a / b ?= 3, "除法");
    断言(a % b ?= 1, "取模");
    断言(-a ?= -10, "取负");
}

// --- 比较运算 ---
函数 测试比较运算(): 空 {
    变量 a = 10;
    变量 b = 20;
    断言(a < b ?= 1, "小于");
    断言(b > a ?= 1, "大于");
    断言(a <= a ?= 1, "小于等于");
    断言(a >= a ?= 1, "大于等于");
    断言(a ?= a ?= 1, "等于");
    断言(a != b ?= 1, "不等于");
}

// --- 逻辑运算 ---
函数 测试逻辑运算(): 空 {
    断言(1 && 1 ?= 1, "与");
    断言(0 || 1 ?= 1, "或");
    断言(!0 ?= 1, "非");
    断言(!1 ?= 0, "非假");
}

// --- 布尔值 ---
函数 测试布尔值(): 空 {
    变量 t = 真;
    变量 f = 假;
    断言(t ?= 1, "真");
    断言(f ?= 0, "假");
}

// --- 控制流 ---
函数 测试如果(): 空 {
    变量 x = 5;
    变量 结果 = 0;
    如果 (x > 3) {
        结果 = 1;
    } 否则 {
        结果 = 2;
    }
    断言(结果 ?= 1, "如果");

    如果 (x > 10) {
        结果 = 3;
    } 否则如果 (x > 3) {
        结果 = 4;
    } 否则 {
        结果 = 5;
    }
    断言(结果 ?= 4, "否则如果");
}

函数 测试当循环(): 空 {
    变量 总和 = 0;
    变量 i = 1;
    当 (i <= 10) {
        总和 = 总和 + i;
        i = i + 1;
    }
    断言(总和 ?= 55, "当循环");
}

函数 测试循环(): 空 {
    变量 总和 = 0;
    循环 (变量 j = 1; j <= 10; j += 1) {
        总和 = 总和 + j;
    }
    断言(总和 ?= 55, "循环");
}

函数 测试中断继续(): 空 {
    变量 总和 = 0;
    变量 k = 0;
    当 (真) {
        k = k + 1;
        如果 (k > 10) { 中断; }
        如果 (k % 2 ?= 0) { 继续; }
        总和 = 总和 + k;
    }
    断言(总和 ?= 25, "中断继续");
}

// --- 函数调用 ---
函数 加法(甲, 乙): 整数 {
    返回 甲 + 乙;
}

函数 阶乘(数): 整数 {
    如果 (数 <= 1) { 返回 1; }
    返回 数 * 阶乘(数 - 1);
}

函数 测试函数(): 空 {
    断言(加法(3, 4) ?= 7, "函数调用");
    断言(阶乘(5) ?= 120, "递归");
}

// --- 数组 ---
函数 测试数组(): 空 {
    变量 数据 = [10, 20, 30, 40, 50];
    断言(数据[0] ?= 10, "数组访问0");
    断言(数据[2] ?= 30, "数组访问2");
    断言(数据[4] ?= 50, "数组访问4");
    数据[1] = 99;
    断言(数据[1] ?= 99, "数组赋值");
}

// --- 字符串 ---
函数 测试字符串(): 空 {
    变量 s = "你好世界";
    断言(长度(s) ?= 4, "字符串长度");
    变量 t = 拼接("你好", "世界");
    断言(长度(t) ?= 4, "拼接长度");
}

// --- 常量 ---
函数 测试常量(): 空 {
    常量 PI = 3;
    断言(PI ?= 3, "常量");
}

// --- 入口 ---
函数 主程序(): 空 {
    打印("=== Stage 0: 基础功能 ===");
    测试整数运算();
    测试比较运算();
    测试逻辑运算();
    测试布尔值();
    测试如果();
    测试当循环();
    测试循环();
    测试中断继续();
    测试函数();
    测试数组();
    测试字符串();
    测试常量();
    打印("=== Stage 0 通过 ===");
}
