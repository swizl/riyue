// ============================================
// 词法分析器
// ============================================
变量 源代码 = "";
变量 源位置 = 0;
变量 当前标记类型 = 0;
变量 当前标记数值 = 0;

变量 T_NUM = 1;
变量 T_IDENT = 2;
变量 T_PLUS = 3;
变量 T_MINUS = 4;
变量 T_STAR = 5;
变量 T_SLASH = 6;
变量 T_PCT = 7;
变量 T_LPAREN = 8;
变量 T_RPAREN = 9;
变量 T_LBRACE = 10;
变量 T_RBRACE = 11;
变量 T_SEMI = 12;
变量 T_COMMA = 13;
变量 T_ASSIGN = 14;
变量 T_EQ = 15;
变量 T_NEQ = 16;
变量 T_LT = 17;
变量 T_GT = 18;
变量 T_LE = 19;
变量 T_GE = 20;
变量 T_AND = 21;
变量 T_OR = 22;
变量 T_NOT = 23;
变量 T_EOF = 99;

函数 扫描标记(): 空 {
    // 跳过空白
    当 (源位置 < 长度(源代码)) {
        变量 c = 子串(源代码, 源位置, 1);
        如果 (c ?= " " || c ?= "\t" || c ?= "\n" || c ?= "\r") {
            源位置 = 源位置 + 1;
        } 否则 {
            中断;
        }
    }

    如果 (源位置 >= 长度(源代码)) {
        当前标记类型 = T_EOF;
        返回;
    }

    变量 c = 子串(源代码, 源位置, 1);

    // 数字 (内联检查, 避免函数参数传递问题)
    变量 是数字 = 0;
    如果 (c ?= "0") { 是数字 = 1; }
    如果 (c ?= "1") { 是数字 = 1; }
    如果 (c ?= "2") { 是数字 = 1; }
    如果 (c ?= "3") { 是数字 = 1; }
    如果 (c ?= "4") { 是数字 = 1; }
    如果 (c ?= "5") { 是数字 = 1; }
    如果 (c ?= "6") { 是数字 = 1; }
    如果 (c ?= "7") { 是数字 = 1; }
    如果 (c ?= "8") { 是数字 = 1; }
    如果 (c ?= "9") { 是数字 = 1; }

    如果 (是数字 ?= 1) {
        当前标记数值 = 0;
        当 (源位置 < 长度(源代码)) {
            变量 ch = 子串(源代码, 源位置, 1);
            变量 是数 = 0;
            如果 (ch ?= "0") { 是数 = 1; }
            如果 (ch ?= "1") { 是数 = 1; }
            如果 (ch ?= "2") { 是数 = 1; }
            如果 (ch ?= "3") { 是数 = 1; }
            如果 (ch ?= "4") { 是数 = 1; }
            如果 (ch ?= "5") { 是数 = 1; }
            如果 (ch ?= "6") { 是数 = 1; }
            如果 (ch ?= "7") { 是数 = 1; }
            如果 (ch ?= "8") { 是数 = 1; }
            如果 (ch ?= "9") { 是数 = 1; }
            如果 (是数 ?= 1) {
                当前标记数值 = 当前标记数值 * 10;
                如果 (ch ?= "1") { 当前标记数值 = 当前标记数值 + 1; }
                如果 (ch ?= "2") { 当前标记数值 = 当前标记数值 + 2; }
                如果 (ch ?= "3") { 当前标记数值 = 当前标记数值 + 3; }
                如果 (ch ?= "4") { 当前标记数值 = 当前标记数值 + 4; }
                如果 (ch ?= "5") { 当前标记数值 = 当前标记数值 + 5; }
                如果 (ch ?= "6") { 当前标记数值 = 当前标记数值 + 6; }
                如果 (ch ?= "7") { 当前标记数值 = 当前标记数值 + 7; }
                如果 (ch ?= "8") { 当前标记数值 = 当前标记数值 + 8; }
                如果 (ch ?= "9") { 当前标记数值 = 当前标记数值 + 9; }
                源位置 = 源位置 + 1;
            } 否则 {
                中断;
            }
        }
        当前标记类型 = T_NUM;
        返回;
    }

    // 标识符 (非数字、非运算符、非空白)
    变量 是运算符 = 0;
    如果 (c ?= "+") { 是运算符 = 1; }
    如果 (c ?= "-") { 是运算符 = 1; }
    如果 (c ?= "*") { 是运算符 = 1; }
    如果 (c ?= "/") { 是运算符 = 1; }
    如果 (c ?= "%") { 是运算符 = 1; }
    如果 (c ?= "(") { 是运算符 = 1; }
    如果 (c ?= ")") { 是运算符 = 1; }
    如果 (c ?= "{") { 是运算符 = 1; }
    如果 (c ?= "}") { 是运算符 = 1; }
    如果 (c ?= ";") { 是运算符 = 1; }
    如果 (c ?= ",") { 是运算符 = 1; }
    如果 (c ?= "=") { 是运算符 = 1; }
    如果 (c ?= "<") { 是运算符 = 1; }
    如果 (c ?= ">") { 是运算符 = 1; }
    如果 (c ?= "!") { 是运算符 = 1; }
    如果 (c ?= "&") { 是运算符 = 1; }
    如果 (c ?= "|") { 是运算符 = 1; }
    如果 (c ?= "\"") { 是运算符 = 1; }

    如果 (是运算符 ?= 0) {
        源位置 = 源位置 + 1;
        当前标记类型 = T_IDENT;
        返回;
    }

    // 双字符运算符
    如果 (c ?= "=") {
        源位置 = 源位置 + 1;
        如果 (源位置 < 长度(源代码) && 子串(源代码, 源位置, 1) ?= "=") {
            源位置 = 源位置 + 1;
            当前标记类型 = T_EQ;
            返回;
        }
        当前标记类型 = T_ASSIGN;
        返回;
    }
    如果 (c ?= "!") {
        源位置 = 源位置 + 1;
        如果 (源位置 < 长度(源代码) && 子串(源代码, 源位置, 1) ?= "=") {
            源位置 = 源位置 + 1;
            当前标记类型 = T_NEQ;
            返回;
        }
        当前标记类型 = T_NOT;
        返回;
    }
    如果 (c ?= "<") {
        源位置 = 源位置 + 1;
        如果 (源位置 < 长度(源代码) && 子串(源代码, 源位置, 1) ?= "=") {
            源位置 = 源位置 + 1;
            当前标记类型 = T_LE;
            返回;
        }
        当前标记类型 = T_LT;
        返回;
    }
    如果 (c ?= ">") {
        源位置 = 源位置 + 1;
        如果 (源位置 < 长度(源代码) && 子串(源代码, 源位置, 1) ?= "=") {
            源位置 = 源位置 + 1;
            当前标记类型 = T_GE;
            返回;
        }
        当前标记类型 = T_GT;
        返回;
    }
    如果 (c ?= "&") {
        源位置 = 源位置 + 1;
        如果 (源位置 < 长度(源代码) && 子串(源代码, 源位置, 1) ?= "&") {
            源位置 = 源位置 + 1;
            当前标记类型 = T_AND;
            返回;
        }
        当前标记类型 = 0;
        返回;
    }
    如果 (c ?= "|") {
        源位置 = 源位置 + 1;
        如果 (源位置 < 长度(源代码) && 子串(源代码, 源位置, 1) ?= "|") {
            源位置 = 源位置 + 1;
            当前标记类型 = T_OR;
            返回;
        }
        当前标记类型 = 0;
        返回;
    }

    // 单字符运算符
    源位置 = 源位置 + 1;
    如果 (c ?= "+") { 当前标记类型 = T_PLUS; 返回; }
    如果 (c ?= "-") { 当前标记类型 = T_MINUS; 返回; }
    如果 (c ?= "*") { 当前标记类型 = T_STAR; 返回; }
    如果 (c ?= "/") { 当前标记类型 = T_SLASH; 返回; }
    如果 (c ?= "%") { 当前标记类型 = T_PCT; 返回; }
    如果 (c ?= "(") { 当前标记类型 = T_LPAREN; 返回; }
    如果 (c ?= ")") { 当前标记类型 = T_RPAREN; 返回; }
    如果 (c ?= "{") { 当前标记类型 = T_LBRACE; 返回; }
    如果 (c ?= "}") { 当前标记类型 = T_RBRACE; 返回; }
    如果 (c ?= ";") { 当前标记类型 = T_SEMI; 返回; }
    如果 (c ?= ",") { 当前标记类型 = T_COMMA; 返回; }
    当前标记类型 = 0;
}

// ============================================
// 表达式求值器 (优先级爬升)
// ============================================

函数 获取优先级(): 整数 {
    如果 (当前标记类型 ?= T_OR) { 返回 1; }
    如果 (当前标记类型 ?= T_AND) { 返回 2; }
    如果 (当前标记类型 ?= T_EQ || 当前标记类型 ?= T_NEQ || 当前标记类型 ?= T_LT || 当前标记类型 ?= T_GT || 当前标记类型 ?= T_LE || 当前标记类型 ?= T_GE) { 返回 3; }
    如果 (当前标记类型 ?= T_PLUS || 当前标记类型 ?= T_MINUS) { 返回 4; }
    如果 (当前标记类型 ?= T_STAR || 当前标记类型 ?= T_SLASH || 当前标记类型 ?= T_PCT) { 返回 5; }
    返回 0;
}

函数 解析原子(): 整数 {
    如果 (当前标记类型 ?= T_MINUS) {
        扫描标记();
        返回 -解析原子();
    }
    如果 (当前标记类型 ?= T_NOT) {
        扫描标记();
        变量 v = 解析原子();
        如果 (v ?= 0) { 返回 1; } 否则 { 返回 0; }
    }
    如果 (当前标记类型 ?= T_NUM) {
        变量 v = 当前标记数值;
        扫描标记();
        返回 v;
    }
    如果 (当前标记类型 ?= T_LPAREN) {
        扫描标记();
        变量 v = 解析表达式();
        如果 (当前标记类型 ?= T_RPAREN) { 扫描标记(); }
        返回 v;
    }
    返回 0;
}

函数 解析表达式_内部(最小优先级): 整数 {
    变量 左 = 解析原子();
    当 (获取优先级() >= 最小优先级) {
        变量 操作 = 当前标记类型;
        变量 优先级 = 获取优先级();
        扫描标记();
        变量 右 = 解析表达式_内部(优先级 + 1);
        如果 (操作 ?= T_PLUS) { 左 = 左 + 右; }
        如果 (操作 ?= T_MINUS) { 左 = 左 - 右; }
        如果 (操作 ?= T_STAR) { 左 = 左 * 右; }
        如果 (操作 ?= T_SLASH) { 如果 (右 != 0) { 左 = 左 / 右; } }
        如果 (操作 ?= T_PCT) { 如果 (右 != 0) { 左 = 左 % 右; } }
        如果 (操作 ?= T_EQ) { 左 = (左 ?= 右); }
        如果 (操作 ?= T_NEQ) { 左 = (左 != 右); }
        如果 (操作 ?= T_LT) { 左 = (左 < 右); }
        如果 (操作 ?= T_GT) { 左 = (左 > 右); }
        如果 (操作 ?= T_LE) { 左 = (左 <= 右); }
        如果 (操作 ?= T_GE) { 左 = (左 >= 右); }
        如果 (操作 ?= T_AND) { 左 = (左 && 右); }
        如果 (操作 ?= T_OR) { 左 = (左 || 右); }
    }
    返回 左;
}

函数 解析表达式(): 整数 {
    返回 解析表达式_内部(1);
}

