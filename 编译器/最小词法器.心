// 日月编译器 — 最小词法器（自举演示）

// 标记类型
0 = T_NUM:整数;
1 = T_PLUS:整数;
2 = T_EOF:整数;

// 全局状态
"" = 源代码;
0 = 源位置;
0 = 标记类型;
"" = 标记值;

// 获取字符码
函数 取码(0 = 码:整数) {
    (源代码)长度 = 长;
    如果 (源位置 < 长) {
        (源代码, 源位置)字符码 = 码;
    } 否则 {
        0 = 码;
    }
}

// 扫描数字
函数 扫数字(空) {
    "" = 结果;
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        ()取码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            (源代码, 源位置, 1)子串 = 字;
            结果 + 字 = 结果;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_NUM = 标记类型;
    结果 = 标记值;
}

// 扫描标记
函数 扫描(空) {
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        ()取码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10) {
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    如果 (源位置 >= 长) {
        T_EOF = 标记类型;
        "" = 标记值;
    } 否则 {
        ()取码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            ()扫数字;
        } 否则 {
            源位置 + 1 = 源位置;
            如果 (码 ?= 43) { T_PLUS = 标记类型; "+" = 标记值; }
        }
    }
}

// 测试
函数 主程序 {
    ("=== 最小词法器测试 ===")打印;
    
    "42+3" = 源代码;
    0 = 源位置;
    
    ()扫描;
    ("标记1 - 类型: ")打印;
    (标记类型)打印;
    ("值: ")打印;
    (标记值)打印;
    
    ()扫描;
    ("标记2 - 类型: ")打印;
    (标记类型)打印;
    ("值: ")打印;
    (标记值)打印;
    
    ()扫描;
    ("标记3 - 类型: ")打印;
    (标记类型)打印;
    ("值: ")打印;
    (标记值)打印;
    
    ()扫描;
    ("标记4 - 类型: ")打印;
    (标记类型)打印;
    
    ("=== 完成 ===")打印;
}
