// 日月编译器 - 语法分析器（自举）
// 将标记流转换为抽象语法树

// 导入词法器模块
导入 "../编译器/词法器模块.心";

// AST节点类型
0 = N_NUM:整数;
1 = N_IDENT:整数;
2 = N_STRING:整数;
3 = N_BINOP:整数;
4 = N_CALL:整数;
5 = N_ASSIGN:整数;
6 = N_IF:整数;
7 = N_WHILE:整数;
8 = N_FUNC:整数;
9 = N_BLOCK:整数;
10 = N_PRINT:整数;

// 二元运算符类型
0 = OP_ADD:整数;
1 = OP_SUB:整数;
2 = OP_MUL:整数;
3 = OP_DIV:整数;
4 = OP_MOD:整数;
5 = OP_EQ:整数;
6 = OP_NEQ:整数;
7 = OP_LT:整数;
8 = OP_GT:整数;
9 = OP_LE:整数;
10 = OP_GE:整数;

// AST节点结构（使用动态数组模拟）
// 节点: [类型, 值/名称, 左子节点, 右子节点, ...]

// 当前标记信息
0 = 当前类型;
"" = 当前值;

// 前进到下一个标记
函数 前进标记(空) {
    ()扫描;
    标记类型 = 当前类型;
    标记值 = 当前值;
}

// 期望标记类型
函数 (期望类型:整数)期望(空) {
    如果 (当前类型 ?= 期望类型) {
        ()前进标记;
    } 否则 {
        ("语法错误: 期望类型=")打印;
        (期望类型)打印;
        (" 实际类型=")打印;
        (当前类型)打印;
        (" 值=")打印;
        (当前值)打印;
        ("")打印;
    }
}

// 解析数字表达式
函数 解析数字(0 = 节点:整数) {
    当前值 = 数值;
    ()前进标记;
    N_NUM = 节点;
}

// 解析标识符表达式
函数 解析标识符(0 = 节点:整数) {
    当前值 = 名称;
    ()前进标记;
    N_IDENT = 节点;
}

// 解析字符串表达式
函数 解析字符串(0 = 节点:整数) {
    当前值 = 字符串值;
    ()前进标记;
    N_STRING = 节点;
}

// 解析基本表达式
函数 解析基本表达式(0 = 节点:整数) {
    如果 (当前类型 ?= T_NUM) {
        ()解析数字 = 节点;
    } 否则如果 (当前类型 ?= T_IDENT) {
        ()解析标识符 = 节点;
    } 否则如果 (当前类型 ?= T_STRING) {
        ()解析字符串 = 节点;
    } 否则如果 (当前类型 ?= T_LPAREN) {
        ()前进标记;
        ()解析表达式 = 节点;
        T_RPAREN = 期望;
    } 否则 {
        ("语法错误: 期望表达式")打印;
        0 = 节点;
    }
}

// 解析乘除法表达式
函数 解析乘除表达式(0 = 节点:整数) {
    ()解析基本表达式 = 节点;
    当 (当前类型 ?= T_STAR || 当前类型 ?= T_SLASH || 当前类型 ?= T_PCT) {
        当前类型 = 运算符;
        ()前进标记;
        ()解析基本表达式 = 右节点;
        N_BINOP = 节点;
    }
}

// 解析加减法表达式
函数 解析加减表达式(0 = 节点:整数) {
    ()解析乘除表达式 = 节点;
    当 (当前类型 ?= T_PLUS || 当前类型 ?= T_MINUS) {
        当前类型 = 运算符;
        ()前进标记;
        ()解析乘除表达式 = 右节点;
        N_BINOP = 节点;
    }
}

// 解析比较表达式
函数 解析比较表达式(0 = 节点:整数) {
    ()解析加减表达式 = 节点;
    如果 (当前类型 ?= T_EQ || 当前类型 ?= T_NEQ || 当前类型 ?= T_LT || 当前类型 ?= T_GT || 当前类型 ?= T_LE || 当前类型 ?= T_GE) {
        当前类型 = 运算符;
        ()前进标记;
        ()解析加减表达式 = 右节点;
        N_BINOP = 节点;
    }
}

// 解析表达式
函数 解析表达式(0 = 节点:整数) {
    ()解析比较表达式 = 节点;
}

// 解析赋值语句 (日月语法: 值 = 变量名;)
函数 解析赋值(0 = 节点:整数) {
    // 解析值表达式
    如果 (当前类型 ?= T_NUM) {
        当前值 = 数值;
        ()前进标记;
        N_NUM = 节点;
    } 否则如果 (当前类型 ?= T_IDENT) {
        当前值 = 名称;
        ()前进标记;
        N_IDENT = 节点;
    }
    
    // 期望 =
    如果 (当前类型 ?= T_ASSIGN) {
        ()前进标记;
    }
    
    // 期望变量名
    如果 (当前类型 ?= T_IDENT) {
        当前值 = 变量名;
        ()前进标记;
    }
    
    // 期望分号
    如果 (当前类型 ?= T_SEMI) {
        ()前进标记;
    }
    
    N_ASSIGN = 节点;
}

// 解析打印语句
函数 解析打印(0 = 节点:整数) {
    ()前进标记;
    T_LPAREN = 期望;
    ()解析表达式 = 表达式节点;
    T_RPAREN = 期望;
    T_SEMI = 期望;
    N_PRINT = 节点;
}

// 解析语句
函数 解析语句(0 = 节点:整数) {
    如果 (当前类型 ?= T_IDENT) {
        ()解析赋值 = 节点;
    } 否则如果 (当前类型 ?= T_NUM) {
        // 数字开头的语句可能是赋值: 42 = x;
        ()解析赋值 = 节点;
    } 否则如果 (当前值 ?= "打印") {
        ()解析打印 = 节点;
    } 否则 {
        ("未知语句类型: ")打印;
        (当前值)打印;
        ("")打印;
        ()前进标记;
        0 = 节点;
    }
}

// 解析程序
函数 解析程序(空) {
    ("开始解析...")打印;
    ()前进标记;
    当 (当前类型 != T_EOF) {
        ()解析语句 = 节点;
        ("解析语句完成")打印;
    }
    ("解析完成")打印;
}

// 主程序
函数 主程序 {
    ("=== 语法分析器测试 ===")打印;
    
    // 测试简单赋值
    ("42 = x;")初始化;
    ("测试: 42 = x;")打印;
    ()解析程序;
    
    ("")打印;
    
    // 测试打印语句
    ("打印(42);")初始化;
    ("测试: 打印(42);")打印;
    ()解析程序;
    
    ("=== 完成 ===")打印;
}
