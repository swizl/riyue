// 生成alloca指令
函数 (名:字符串)生成alloca {
    生成代码 + "  %" = 生成代码;
    生成代码 + 名 = 生成代码;
    生成代码 + " = alloca i32\n" = 生成代码;
}

// 生成数组alloca（返回指针变量名）
函数 (名:字符串, 大小:整数)生成数组alloca(指针名:字符串) {
    ()获取临时变量 = 指针名;
    (大小)转字符串 = 大小串;
    生成代码 + "  " = 生成代码;
    生成代码 + 指针名 = 生成代码;
    生成代码 + " = alloca i32, i32 " = 生成代码;
    生成代码 + 大小串 = 生成代码;
    生成代码 + "\n" = 生成代码;
}

// 生成赋值指令
函数 (值:字符串, 名:字符串)生成赋值 {
    生成代码 + "  store i32 " = 生成代码;
    生成代码 + 值 = 生成代码;
    生成代码 + ", i32* %" = 生成代码;
    生成代码 + 名 = 生成代码;
    生成代码 + "\n" = 生成代码;
}

// 生成zext指令
函数 (值:字符串)生成zext(结果:字符串) {
