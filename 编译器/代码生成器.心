}

// 解析基本表达式（数字/标识符/数组访问）
函数 解析生成基本表达式("" = 结果:字符串) {
    如果 (当前类型 ?= T_NUM) {
        当前值 = 结果;
        ()前进标记;
    } 否则如果 (当前类型 ?= T_IDENT) {
        当前值 = 标识名;
        ()前进标记;
        // 检查是否为数组访问: 标识符[索引]
        如果 (当前类型 ?= T_LBRACKET) {
            ()前进标记;
            ()解析生成表达式 = 索引;
            如果 (当前类型 ?= T_RBRACKET) {
                ()前进标记;
            }
            (标识名, 索引)生成数组访问 = 结果;
        } 否则如果 (当前类型 ?= T_DOT) {
            // 结构体成员访问: 标识符.成员名
            ()前进标记;
            如果 (当前类型 ?= T_IDENT) {
                当前值 = 成员名;
                ()前进标记;
            }
            // 生成 GEP 指令访问成员（简化：假设成员在偏移0）
            ()获取临时变量 = 成员地址;
            生成代码 + "  " = 生成代码;
            生成代码 + 成员地址 = 生成代码;
            生成代码 + " = getelementptr %struct." = 生成代码;
            生成代码 + 标识名 = 生成代码;
            生成代码 + ", ptr %" = 生成代码;
            生成代码 + 标识名 = 生成代码;
            生成代码 + ", i32 0, i32 0\n" = 生成代码;
            ()获取临时变量 = 结果;
            生成代码 + "  " = 生成代码;
            生成代码 + 结果 = 生成代码;
            生成代码 + " = load i32, ptr " = 生成代码;
            生成代码 + 成员地址 = 生成代码;
            生成代码 + "\n" = 生成代码;
        } 否则 {
            (标识名)生成加载 = 结果;
        }
    } 否则 {
        "0" = 结果;
        ()前进标记;
    }
}

// 解析乘除表达式
函数 解析生成乘除("" = 结果:字符串) {
    ()解析生成基本表达式 = 结果;
    当 (当前类型 ?= T_STAR || 当前类型 ?= T_SLASH || 当前类型 ?= T_PCT) {
        当前值 = 运算符值;
        ()前进标记;
        ()解析生成基本表达式 = 右值;
        (结果, 运算符值, 右值)生成算术 = 结果;
    }
}

// 解析加减表达式
函数 解析生成加减("" = 结果:字符串) {
    ()解析生成乘除 = 结果;
    当 (当前类型 ?= T_PLUS || 当前类型 ?= T_MINUS) {
        当前值 = 运算符值;
        ()前进标记;
        ()解析生成乘除 = 右值;
        (结果, 运算符值, 右值)生成算术 = 结果;
    }
}

// 解析比较表达式（结果为i1）
函数 解析生成比较原始("" = 结果:字符串) {
    ()解析生成加减 = 结果;
    如果 (当前类型 ?= T_GT || 当前类型 ?= T_LT || 当前类型 ?= T_EQ || 当前类型 ?= T_NEQ || 当前类型 ?= T_GE || 当前类型 ?= T_LE) {
        当前值 = 运算符值;
        ()前进标记;
        ()解析生成加减 = 右值;
        (结果, 运算符值, 右值)生成比较 = 结果;
    }
}

// 解析逻辑与表达式（结果为i1）
函数 解析生成逻辑与原始("" = 结果:字符串) {
    ()解析生成比较原始 = 结果;
    当 (当前类型 ?= T_AND) {
        当前值 = 运算符值;
        ()前进标记;
        ()解析生成比较原始 = 右值;
        (结果, 运算符值, 右值)生成逻辑 = 结果;
    }
}

// 解析逻辑或表达式（结果为i1）
函数 解析生成逻辑或原始("" = 结果:字符串) {
    ()解析生成逻辑与原始 = 结果;
    当 (当前类型 ?= T_OR) {
        当前值 = 运算符值;
        ()前进标记;
        ()解析生成逻辑与原始 = 右值;
        (结果, 运算符值, 右值)生成逻辑 = 结果;
    }
}

// 解析条件表达式（结果为i1，用于if/while分支）
函数 解析生成条件("" = 结果:字符串) {
    ()解析生成逻辑或原始 = 结果;
}

// 解析表达式（结果为i32，用于赋值/打印）
函数 解析生成表达式("" = 结果:字符串) {
    0 = 表达式是i1;
    ()解析生成逻辑或原始 = 结果;
    // 如果结果是i1（来自比较/逻辑），zext到i32
    如果 (表达式是i1 ?= 1) {
        ()获取临时变量 = 扩展名;
        生成代码 + "  " = 生成代码;
        生成代码 + 扩展名 = 生成代码;
        生成代码 + " = zext i1 " = 生成代码;
        生成代码 + 结果 = 生成代码;
        生成代码 + " to i32\n" = 生成代码;
        扩展名 = 结果;
    }
}

// 解析并生成语句
函数 解析生成语句(空) {
    如果 (当前值 ?= "函数") {
        // 函数定义
        ()前进标记;
        如果 (当前类型 ?= T_IDENT) {
            当前值 = 函数名;
            ()前进标记;
        }
        生成代码 + "\ndefine i32 @" = 生成代码;
        生成代码 + 函数名 = 生成代码;
        生成代码 + "() {\nentry:\n" = 生成代码;
        // 跳过参数列表
        如果 (当前类型 ?= T_LPAREN) {
            ()前进标记;
            当 (当前类型 != T_RPAREN && 当前类型 != T_EOF) {
                ()前进标记;
            }
            如果 (当前类型 ?= T_RPAREN) {
                ()前进标记;
            }
        }
        // 跳过返回类型
        如果 (当前类型 ?= T_COLON) {
            ()前进标记;
            如果 (当前类型 ?= T_IDENT) {
                ()前进标记;
            }
        }
        // 解析函数体
        如果 (当前类型 ?= T_LBRACE) {
            ()前进标记;
            当 (当前类型 != T_RBRACE && 当前类型 != T_EOF) {
                ()解析生成语句;
            }
            如果 (当前类型 ?= T_RBRACE) {
                ()前进标记;
            }
        }
        生成代码 + "  ret i32 0\n}\n" = 生成代码;
    } 否则如果 (当前值 ?= "如果") {
        // if语句
        ()前进标记;
        如果 (当前类型 ?= T_LPAREN) {
            ()前进标记;
            ()解析生成条件 = 条件;
            如果 (当前类型 ?= T_RPAREN) {
                ()前进标记;
            }
            ()获取临时变量 = 真标签;
            ()获取临时变量 = 假标签;
            ()获取临时变量 = 结束标签;
            (条件, 真标签, 假标签, 结束标签)生成条件分支;
            如果 (当前类型 ?= T_LBRACE) {
                ()前进标记;
                当 (当前类型 != T_RBRACE && 当前类型 != T_EOF) {
                    ()解析生成语句;
                }
                如果 (当前类型 ?= T_RBRACE) {
                    ()前进标记;
                }
            }
            生成代码 + "  br label %" = 生成代码;
            生成代码 + 结束标签 = 生成代码;
            生成代码 + "\n" = 生成代码;
            生成代码 + 假标签 = 生成代码;
            生成代码 + ":\n" = 生成代码;
            如果 (当前值 ?= "否则") {
                ()前进标记;
                如果 (当前类型 ?= T_LBRACE) {
                    ()前进标记;
                    当 (当前类型 != T_RBRACE && 当前类型 != T_EOF) {
                        ()解析生成语句;
                    }
                    如果 (当前类型 ?= T_RBRACE) {
                        ()前进标记;
                    }
                }
            }
            生成代码 + "  br label %" = 生成代码;
            生成代码 + 结束标签 = 生成代码;
            生成代码 + "\n" = 生成代码;
            生成代码 + 结束标签 = 生成代码;
            生成代码 + ":\n" = 生成代码;
        }
    } 否则如果 (当前值 ?= "当") {
        // while循环
        ()前进标记;
        如果 (当前类型 ?= T_LPAREN) {
            ()前进标记;
            生成代码 + "  br label %loop_cond\nloop_cond:\n" = 生成代码;
            ()解析生成条件 = 条件;
            如果 (当前类型 ?= T_RPAREN) {
                ()前进标记;
            }
            生成代码 + "  br i1 " = 生成代码;
            生成代码 + 条件 = 生成代码;
            生成代码 + ", label %loop_body, label %loop_end\nloop_body:\n" = 生成代码;
            如果 (当前类型 ?= T_LBRACE) {
