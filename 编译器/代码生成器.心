// 生成alloca指令
函数 (变量:字符串)生成alloca(空) {
    生成代码 + "  %" = 生成代码;
    生成代码 + 变量 = 生成代码;
    生成代码 + " = alloca i32\n" = 生成代码;
}

// 生成赋值语句（自动处理i1到i32转换）
函数 (值:字符串, 变量:字符串)生成赋值(空) {
    生成代码 + "  store i32 " = 生成代码;
    生成代码 + 值 = 生成代码;
    生成代码 + ", i32* %" = 生成代码;
    生成代码 + 变量 = 生成代码;
    生成代码 + "\n" = 生成代码;
}

// 生成zext（i1转i32）
函数 (值:字符串)生成zext("" = 结果:字符串) {
    ()获取临时变量 = 临时名;
    生成代码 + "  " = 生成代码;
    生成代码 + 临时名 = 生成代码;
    生成代码 + " = zext i1 " = 生成代码;
    生成代码 + 值 = 生成代码;
    生成代码 + " to i32\n" = 生成代码;
    临时名 = 结果;
}

// 生成加载指令
函数 (变量:字符串)生成加载("" = 结果:字符串) {
    ()获取临时变量 = 临时名;
    生成代码 + "  " = 生成代码;
    生成代码 + 临时名 = 生成代码;
    生成代码 + " = load i32, i32* %" = 生成代码;
    生成代码 + 变量 = 生成代码;
    生成代码 + "\n" = 生成代码;
    临时名 = 结果;
}

// 生成比较运算（结果为i1）
函数 (左:字符串, 运算符:字符串, 右:字符串)生成比较("" = 结果:字符串) {
    ()获取临时变量 = 临时名;
    生成代码 + "  " = 生成代码;
    生成代码 + 临时名 = 生成代码;
    生成代码 + " = icmp " = 生成代码;
    如果 (运算符 ?= ">") {
        生成代码 + "sgt" = 生成代码;
    } 否则如果 (运算符 ?= "<") {
        生成代码 + "slt" = 生成代码;
    } 否则如果 (运算符 ?= "==") {
        生成代码 + "eq" = 生成代码;
    } 否则如果 (运算符 ?= "!=") {
        生成代码 + "ne" = 生成代码;
    } 否则如果 (运算符 ?= ">=") {
        生成代码 + "sge" = 生成代码;
    } 否则如果 (运算符 ?= "<=") {
        生成代码 + "sle" = 生成代码;
    }
    生成代码 + " i32 " = 生成代码;
    生成代码 + 左 = 生成代码;
    生成代码 + ", " = 生成代码;
    生成代码 + 右 = 生成代码;
    生成代码 + "\n" = 生成代码;
    临时名 = 结果;
    1 = 表达式是i1;
}

// 生成逻辑运算（结果为i1）
函数 (左:字符串, 运算符:字符串, 右:字符串)生成逻辑("" = 结果:字符串) {
    ()获取临时变量 = 临时名;
    生成代码 + "  " = 生成代码;
    生成代码 + 临时名 = 生成代码;
    生成代码 + " = " = 生成代码;
    如果 (运算符 ?= "&&") {
        生成代码 + "and" = 生成代码;
    } 否则如果 (运算符 ?= "||") {
        生成代码 + "or" = 生成代码;
    }
    生成代码 + " i1 " = 生成代码;
    生成代码 + 左 = 生成代码;
    生成代码 + ", " = 生成代码;
    生成代码 + 右 = 生成代码;
    生成代码 + "\n" = 生成代码;
    临时名 = 结果;
    1 = 表达式是i1;
}

// 生成算术运算
函数 (左:字符串, 运算符:字符串, 右:字符串)生成算术("" = 结果:字符串) {
    ()获取临时变量 = 临时名;
    生成代码 + "  " = 生成代码;
    生成代码 + 临时名 = 生成代码;
    生成代码 + " = " = 生成代码;
    如果 (运算符 ?= "+") {
        生成代码 + "add" = 生成代码;
    } 否则如果 (运算符 ?= "-") {
        生成代码 + "sub" = 生成代码;
    } 否则如果 (运算符 ?= "*") {
        生成代码 + "mul" = 生成代码;
    } 否则如果 (运算符 ?= "/") {
        生成代码 + "sdiv" = 生成代码;
    } 否则如果 (运算符 ?= "%") {
        生成代码 + "srem" = 生成代码;
    }
    生成代码 + " i32 " = 生成代码;
    生成代码 + 左 = 生成代码;
    生成代码 + ", " = 生成代码;
    生成代码 + 右 = 生成代码;
    生成代码 + "\n" = 生成代码;
    临时名 = 结果;
}

// 生成打印语句
函数 (值:字符串)生成打印(空) {
    生成代码 + "  call i32 (i8*, ...) @printf(i8* getelementptr ([4 x i8], [4 x i8]* @fmt, i32 0, i32 0), i32 " = 生成代码;
    生成代码 + 值 = 生成代码;
    生成代码 + ")\n" = 生成代码;
}

// 生成条件分支
函数 (条件:字符串)生成条件分支("" = 真标签:字符串, "" = 假标签:字符串, "" = 结束标签:字符串) {
    "if_true" = 真标签;
    "if_false" = 假标签;
    "if_end" = 结束标签;
    生成代码 + "  br i1 " = 生成代码;
    生成代码 + 条件 = 生成代码;
    生成代码 + ", label %" = 生成代码;
    生成代码 + 真标签 = 生成代码;
    生成代码 + ", label %" = 生成代码;
    生成代码 + 假标签 = 生成代码;
    生成代码 + "\n" = 生成代码;
    生成代码 + 真标签 = 生成代码;
    生成代码 + ":\n" = 生成代码;
}

