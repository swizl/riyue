    生成代码 + "  " = 生成代码;
    生成代码 + 结果 = 生成代码;
    生成代码 + " = zext i1 " = 生成代码;
    生成代码 + 值 = 生成代码;
    生成代码 + " to i32\n" = 生成代码;
}

// 生成加载指令
函数 (名:字符串)生成加载(结果:字符串) {
    ()获取临时变量 = 结果;
    生成代码 + "  " = 生成代码;
    生成代码 + 结果 = 生成代码;
    生成代码 + " = load i32, i32* %" = 生成代码;
    生成代码 + 名 = 生成代码;
    生成代码 + "\n" = 生成代码;
}

// 生成比较指令
函数 (左:字符串, 运算符:字符串, 右:字符串)生成比较(结果:字符串) {
    ()获取临时变量 = 结果;
    生成代码 + "  " = 生成代码;
    生成代码 + 结果 = 生成代码;
    生成代码 + " = icmp " = 生成代码;
    如果 (运算符 ?= "==") { 生成代码 + "eq" = 生成代码; }
    否则如果 (运算符 ?= "!=") { 生成代码 + "ne" = 生成代码; }
    否则如果 (运算符 ?= "<") { 生成代码 + "slt" = 生成代码; }
    否则如果 (运算符 ?= ">") { 生成代码 + "sgt" = 生成代码; }
    否则如果 (运算符 ?= "<=") { 生成代码 + "sle" = 生成代码; }
    否则如果 (运算符 ?= ">=") { 生成代码 + "sge" = 生成代码; }
    生成代码 + " i32 " = 生成代码;
    生成代码 + 左 = 生成代码;
    生成代码 + ", " = 生成代码;
    生成代码 + 右 = 生成代码;
    生成代码 + "\n" = 生成代码;
}

// 生成逻辑运算指令
函数 (左:字符串, 运算符:字符串, 右:字符串)生成逻辑(结果:字符串) {
    如果 (运算符 ?= "&&") {
        生成代码 + "  " = 生成代码;
        ()获取临时变量 = 结果;
        生成代码 + 结果 = 生成代码;
        生成代码 + " = and i1 " = 生成代码;
        生成代码 + 左 = 生成代码;
        生成代码 + ", " = 生成代码;
        生成代码 + 右 = 生成代码;
        生成代码 + "\n" = 生成代码;
    } 否则如果 (运算符 ?= "||") {
        生成代码 + "  " = 生成代码;
        ()获取临时变量 = 结果;
        生成代码 + 结果 = 生成代码;
        生成代码 + " = or i1 " = 生成代码;
        生成代码 + 左 = 生成代码;
        生成代码 + ", " = 生成代码;
        生成代码 + 右 = 生成代码;
        生成代码 + "\n" = 生成代码;
    }
}

// 生成算术运算指令
函数 (左:字符串, 运算符:字符串, 右:字符串)生成算术(结果:字符串) {
    ()获取临时变量 = 结果;
    生成代码 + "  " = 生成代码;
    生成代码 + 结果 = 生成代码;
    生成代码 + " = " = 生成代码;
    如果 (运算符 ?= "+") { 生成代码 + "add" = 生成代码; }
    否则如果 (运算符 ?= "-") { 生成代码 + "sub" = 生成代码; }
    否则如果 (运算符 ?= "*") { 生成代码 + "mul" = 生成代码; }
    否则如果 (运算符 ?= "/") { 生成代码 + "sdiv" = 生成代码; }
    否则如果 (运算符 ?= "%") { 生成代码 + "srem" = 生成代码; }
    生成代码 + " i32 " = 生成代码;
    生成代码 + 左 = 生成代码;
    生成代码 + ", " = 生成代码;
    生成代码 + 右 = 生成代码;
    生成代码 + "\n" = 生成代码;
}

// 生成打印指令
函数 (值:字符串)生成打印 {
    生成代码 + "  call i32 (i8*, ...) @printf(i8* getelementptr ([4 x i8], [4 x i8]* @.str, i32 0, i32 0), i32 " = 生成代码;
    生成代码 + 值 = 生成代码;
    生成代码 + ")\n" = 生成代码;
}

// 生成条件分支
函数 (条件:字符串, 真标签:字符串, 假标签:字符串, 结束标签:字符串)生成条件分支 {
    生成代码 + "  br i1 " = 生成代码;
    生成代码 + 条件 = 生成代码;
    生成代码 + ", label %" = 生成代码;
    生成代码 + 真标签 = 生成代码;
    生成代码 + ", label %" = 生成代码;
    生成代码 + 假标签 = 生成代码;
    生成代码 + "\n" = 生成代码;
    生成代码 + 真标签 = 生成代码;
    生成代码 + ":\n" = 生成代码;
}

