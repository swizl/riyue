// 日月编译器 — 词法器（新语法）
// 将源代码转换为标记流

// 标记类型常量
0 = T_NUM:整数;
1 = T_IDENT:整数;
2 = T_STRING:整数;
3 = T_PLUS:整数;
4 = T_MINUS:整数;
5 = T_STAR:整数;
6 = T_SLASH:整数;
7 = T_PCT:整数;
8 = T_LPAREN:整数;
9 = T_RPAREN:整数;
10 = T_LBRACE:整数;
11 = T_RBRACE:整数;
12 = T_LBRACKET:整数;
13 = T_RBRACKET:整数;
14 = T_SEMI:整数;
15 = T_COMMA:整数;
16 = T_COLON:整数;
17 = T_DOT:整数;
18 = T_ASSIGN:整数;
19 = T_EQ:整数;
20 = T_NEQ:整数;
21 = T_LT:整数;
22 = T_GT:整数;
23 = T_LE:整数;
24 = T_GE:整数;
25 = T_AND:整数;
26 = T_OR:整数;
27 = T_NOT:整数;
28 = T_EOF:整数;

// 词法器状态
"" = 源代码;
0 = 源位置;
0 = 当前行;
0 = 当前标记类型;
"" = 当前标记值;

// 获取当前字符码
函数 获取字符码(0 = 结果:整数) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        0 = 结果;
    } 否则 {
        (源代码, 源位置)字符码 = 结果;
    }
}

// 获取当前字符
函数 获取字符("" = 结果:字符串) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        "" = 结果;
    } 否则 {
        (源代码, 源位置, 1)子串 = 结果;
    }
}

// 跳过空白
函数 跳过空白(空) {
    (源代码)长度 = 代码长度;
    当 (源位置 < 代码长度) {
        ()获取字符码 = c;
        如果 (c ?= 32 || c ?= 9 || c ?= 10) {
            如果 (c ?= 10) {
                当前行 + 1 = 当前行;
            }
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
}

// 扫描数字
函数 扫描数字(空) {
    "" = 数字字符串;
    (源代码)长度 = 代码长度;
    当 (源位置 < 代码长度) {
        ()获取字符码 = c;
        如果 (c >= 48 && c <= 57) {
            ()获取字符 = 数字字符;
            数字字符串 + 数字字符 = 数字字符串;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_NUM = 当前标记类型;
    数字字符串 = 当前标记值;
}

// 扫描标识符
函数 扫描标识符(空) {
    "" = 标识符;
    (源代码)长度 = 代码长度;
    当 (源位置 < 代码长度) {
        ()获取字符码 = c;
        如果 ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c ?= 95) {
            ()获取字符 = 标识字符;
            标识符 + 标识字符 = 标识符;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_IDENT = 当前标记类型;
    标识符 = 当前标记值;
}

// 扫描下一个标记
函数 扫描标记(空) {
    ()跳过空白;
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        T_EOF = 当前标记类型;
        "" = 当前标记值;
    } 否则 {
        ()获取字符码 = c;
        
        如果 (c >= 48 && c <= 57) {
            ()扫描数字;
        } 否则如果 ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c ?= 95) {
            ()扫描标识符;
        } 否则 {
            ()获取字符 = 标点字符;
            源位置 + 1 = 源位置;
            如果 (c ?= 43) { T_PLUS = 当前标记类型; "+" = 当前标记值; }
            如果 (c ?= 45) { T_MINUS = 当前标记类型; "-" = 当前标记值; }
            如果 (c ?= 42) { T_STAR = 当前标记类型; "*" = 当前标记值; }
            如果 (c ?= 47) { T_SLASH = 当前标记类型; "/" = 当前标记值; }
            如果 (c ?= 37) { T_PCT = 当前标记类型; "%" = 当前标记值; }
            如果 (c ?= 40) { T_LPAREN = 当前标记类型; "(" = 当前标记值; }
            如果 (c ?= 41) { T_RPAREN = 当前标记类型; ")" = 当前标记值; }
            如果 (c ?= 123) { T_LBRACE = 当前标记类型; "{" = 当前标记值; }
            如果 (c ?= 125) { T_RBRACE = 当前标记类型; "}" = 当前标记值; }
            如果 (c ?= 91) { T_LBRACKET = 当前标记类型; "[" = 当前标记值; }
            如果 (c ?= 93) { T_RBRACKET = 当前标记类型; "]" = 当前标记值; }
            如果 (c ?= 59) { T_SEMI = 当前标记类型; ";" = 当前标记值; }
            如果 (c ?= 44) { T_COMMA = 当前标记类型; "," = 当前标记值; }
            如果 (c ?= 58) { T_COLON = 当前标记类型; ":" = 当前标记值; }
            如果 (c ?= 46) { T_DOT = 当前标记类型; "." = 当前标记值; }
            如果 (c ?= 61) { T_ASSIGN = 当前标记类型; "=" = 当前标记值; }
            如果 (c ?= 60) { T_LT = 当前标记类型; "<" = 当前标记值; }
            如果 (c ?= 62) { T_GT = 当前标记类型; ">" = 当前标记值; }
            如果 (c ?= 33) { T_NOT = 当前标记类型; "!" = 当前标记值; }
            如果 (c ?= 38) { T_AND = 当前标记类型; "&" = 当前标记值; }
            如果 (c ?= 124) { T_OR = 当前标记类型; "|" = 当前标记值; }
        }
    }
}

// 初始化词法器
函数 初始化词法器(代码:字符串) {
    代码 = 源代码;
    0 = 源位置;
    1 = 当前行;
}

// 断言函数
函数 断言(条件:整数, 消息:字符串) {
    如果 (条件 ?= 1) {
        ("  ✓ ")打印;
        (消息)打印;
    } 否则 {
        ("  ✗ ")打印;
        (消息)打印;
    }
}

// 测试词法器
函数 测试词法器(空) {
    ("=== 词法器测试 ===")打印;
    
    "42 + 3" = 初始化词法器;
    ()扫描标记;
    (当前标记类型 ?= T_NUM, "数字标记")断言;
    (当前标记值 ?= "42", "数字值")断言;
    
    ()扫描标记;
    (当前标记类型 ?= T_PLUS, "加号标记")断言;
    
    ()扫描标记;
    (当前标记类型 ?= T_NUM, "数字标记2")断言;
    (当前标记值 ?= "3", "数字值2")断言;
    
    ("词法器测试完成")打印;
}

// 主程序
函数 主程序 {
    ()测试词法器;
}
