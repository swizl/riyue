// 初始化测试

// 全局状态
"" = 源代码;
0 = 源位置;

// 初始化
函数 初始化(代码:字符串) {
    ("[调试] 初始化: 代码=")打印;
    (代码)打印;
    ("")打印;
    代码 = 源代码;
    0 = 源位置;
    ("[调试] 初始化后: 源代码=")打印;
    (源代码)打印;
    ("")打印;
}

// 测试
函数 主程序 {
    ("=== 初始化测试 ===")打印;
    
    ("[调试] 测试前: 源代码=")打印;
    (源代码)打印;
    ("")打印;
    
    ("42 + 3")初始化;
    
    ("[调试] 测试后: 源代码=")打印;
    (源代码)打印;
    ("")打印;
    
    ("[调试] 长度=")打印;
    ((源代码)长度)打印;
    ("")打印;
    
    ("=== 完成 ===")打印;
}
