// 日月编译器 - 完整词法器

// 标记类型常量
0 = T_NUM:整数;
1 = T_IDENT:整数;
2 = T_STRING:整数;
3 = T_PLUS:整数;
4 = T_MINUS:整数;
5 = T_STAR:整数;
6 = T_SLASH:整数;
7 = T_PCT:整数;
8 = T_LPAREN:整数;
9 = T_RPAREN:整数;
10 = T_LBRACE:整数;
11 = T_RBRACE:整数;
12 = T_LBRACKET:整数;
13 = T_RBRACKET:整数;
14 = T_SEMI:整数;
15 = T_COMMA:整数;
16 = T_COLON:整数;
17 = T_DOT:整数;
18 = T_ASSIGN:整数;
19 = T_EQ:整数;
20 = T_NEQ:整数;
21 = T_LT:整数;
22 = T_GT:整数;
23 = T_LE:整数;
24 = T_GE:整数;
25 = T_AND:整数;
26 = T_OR:整数;
27 = T_NOT:整数;
28 = T_EOF:整数;

// 全局状态
"" = 源代码;
0 = 源位置;
0 = 标记类型;
"" = 标记值;

// 获取字符码
函数 (位置:整数)取码(0 = 码:整数) {
    (源代码)长度 = 长;
    如果 (位置 < 长) {
        (源代码, 位置)字符码 = 码;
    } 否则 {
        0 = 码;
    }
}

// 获取字符
函数 (位置:整数)取字("" = 字:字符串) {
    (源代码)长度 = 长;
    如果 (位置 < 长) {
        (源代码, 位置, 1)子串 = 字;
    } 否则 {
        "" = 字;
    }
}

// 跳过空白
函数 跳过 {
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源位置)取码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10) {
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
}

// 扫描数字
函数 扫数字 {
    "" = 结果;
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源位置)取码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            (源位置)取字 = 字;
            结果 + 字 = 结果;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_NUM = 标记类型;
    结果 = 标记值;
}

// 扫描标识符
函数 扫标识符 {
    "" = 结果;
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源位置)取码 = 码;
        如果 ((码 >= 97 && 码 <= 122) || (码 >= 65 && 码 <= 90) || (码 >= 48 && 码 <= 57) || 码 ?= 95) {
            (源位置)取字 = 字;
            结果 + 字 = 结果;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_IDENT = 标记类型;
    结果 = 标记值;
}

// 扫描字符串
函数 扫字符串 {
    源位置 + 1 = 源位置;
    "" = 结果;
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源位置)取码 = 码;
        如果 (码 ?= 34) {
            源位置 + 1 = 源位置;
            中断;
        } 否则如果 (码 ?= 92) {
            源位置 + 1 = 源位置;
            (源位置)取码 = 转义码;
            如果 (转义码 ?= 110) {
                结果 + "\n" = 结果;
            } 否则如果 (转义码 ?= 116) {
                结果 + "\t" = 结果;
            } 否则 {
                (源位置)取字 = 转义字;
                结果 + 转义字 = 结果;
            }
            源位置 + 1 = 源位置;
        } 否则 {
            (源位置)取字 = 字;
            结果 + 字 = 结果;
            源位置 + 1 = 源位置;
        }
    }
    T_STRING = 标记类型;
    结果 = 标记值;
}

// 扫描下一个标记
函数 扫描 {
    ()跳过;
    (源代码)长度 = 长;
    如果 (源位置 >= 长) {
        T_EOF = 标记类型;
        "" = 标记值;
    } 否则 {
        (源位置)取码 = 码;
        如果 (码 >= 48 && 码 <= 57) {
            ()扫数字;
        } 否则如果 (码 ?= 34) {
            ()扫字符串;
        } 否则如果 ((码 >= 97 && 码 <= 122) || (码 >= 65 && 码 <= 90) || 码 ?= 95) {
            ()扫标识符;
        } 否则 {
            源位置 + 1 = 源位置;
            如果 (码 ?= 43) { T_PLUS = 标记类型; "+" = 标记值; }
            如果 (码 ?= 45) { T_MINUS = 标记类型; "-" = 标记值; }
            如果 (码 ?= 42) { T_STAR = 标记类型; "*" = 标记值; }
            如果 (码 ?= 37) { T_PCT = 标记类型; "%" = 标记值; }
            如果 (码 ?= 40) { T_LPAREN = 标记类型; "(" = 标记值; }
            如果 (码 ?= 41) { T_RPAREN = 标记类型; ")" = 标记值; }
            如果 (码 ?= 123) { T_LBRACE = 标记类型; "{" = 标记值; }
            如果 (码 ?= 125) { T_RBRACE = 标记类型; "}" = 标记值; }
            如果 (码 ?= 91) { T_LBRACKET = 标记类型; "[" = 标记值; }
            如果 (码 ?= 93) { T_RBRACKET = 标记类型; "]" = 标记值; }
            如果 (码 ?= 59) { T_SEMI = 标记类型; ";" = 标记值; }
            如果 (码 ?= 44) { T_COMMA = 标记类型; "," = 标记值; }
            如果 (码 ?= 46) { T_DOT = 标记类型; "." = 标记值; }
            如果 (码 ?= 61) { T_ASSIGN = 标记类型; "=" = 标记值; }
            如果 (码 ?= 58) { T_COLON = 标记类型; ":" = 标记值; }
            如果 (码 ?= 60) { T_LT = 标记类型; "<" = 标记值; }
            如果 (码 ?= 62) { T_GT = 标记类型; ">" = 标记值; }
            如果 (码 ?= 33) { T_NOT = 标记类型; "!" = 标记值; }
            如果 (码 ?= 38) { T_AND = 标记类型; "&" = 标记值; }
            如果 (码 ?= 124) { T_OR = 标记类型; "|" = 标记值; }
            如果 (码 ?= 47) { T_SLASH = 标记类型; "/" = 标记值; }
            如果 (码 ?= 63) { T_EQ = 标记类型; "?" = 标记值; }
        }
    }
}

// 初始化
函数 (代码:字符串)初始化 {
    代码 = 源代码;
    0 = 源位置;
}

