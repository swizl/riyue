// 扫描数字测试

// 词法器状态
"" = 源代码;
0 = 源位置;
0 = 当前标记类型;
"" = 当前标记值;

// 获取当前字符码
函数 获取字符码(0 = 结果:整数) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        0 = 结果;
    } 否则 {
        (源代码, 源位置)字符码 = 结果;
    }
}

// 获取当前字符
函数 获取字符("" = 结果:字符串) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        "" = 结果;
    } 否则 {
        (源代码, 源位置, 1)子串 = 结果;
    }
}

// 扫描数字
函数 扫描数字(空) {
    "" = 数字字符串;
    ("开始扫描数字")打印;
    (源代码)长度 = 代码长度;
    ("代码长度: ")打印;
    (代码长度)打印;
    当 (源位置 < 代码长度) {
        ("循环开始")打印;
        ("源位置: ")打印;
        (源位置)打印;
        ()获取字符码 = c;
        ("字符码: ")打印;
        (c)打印;
        如果 (c >= 48 && c <= 57) {
            ("是数字")打印;
            ()获取字符 = 数字字符;
            数字字符串 + 数字字符 = 数字字符串;
            源位置 + 1 = 源位置;
        } 否则 {
            ("不是数字")打印;
            中断;
        }
    }
    ("扫描数字结束")打印;
    0 = 当前标记类型;
    数字字符串 = 当前标记值;
}

// 测试
函数 测试(空) {
    ("=== 测试 ===")打印;
    
    "42" = 源代码;
    0 = 源位置;
    
    ()扫描数字;
    ("标记类型: ")打印;
    (当前标记类型)打印;
    ("标记值: ")打印;
    (当前标记值)打印;
    
    ("=== 完成 ===")打印;
}

函数 主程序 {
    ()测试;
}
