// 最简单测试

函数 测试(空) {
    ("=== 测试 ===")打印;
    
    "42" = 源代码;
    0 = 源位置;
    
    (源代码)长度 = 代码长度;
    ("代码长度: ")打印;
    (代码长度)打印;
    
    (源代码, 0)字符码 = c;
    ("第一个字符码: ")打印;
    (c)打印;
    
    如果 (c >= 48 && c <= 57) {
        ("是数字")打印;
    } 否则 {
        ("不是数字")打印;
    }
    
    ("=== 完成 ===")打印;
}

函数 主程序 {
    ()测试;
}
