// 简单解析器调试

// 标记类型
18 = T_ASSIGN:整数;
20 = T_EOF:整数;

// 全局状态
"" = 源代码;
0 = 源位置;
0 = 标记类型;
"" = 标记值;

// 获取字符码
函数 (位置:整数)取码(0 = 码:整数) {
    (源代码)长度 = 长;
    如果 (位置 < 长) {
        (源代码, 位置)字符码 = 码;
    } 否则 {
        0 = 码;
    }
}

// 扫描
函数 扫描(空) {
    (源代码)长度 = 长;
    当 (源位置 < 长) {
        (源位置)取码 = 码;
        如果 (码 ?= 32 || 码 ?= 9 || 码 ?= 10) {
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    如果 (源位置 >= 长) {
        T_EOF = 标记类型;
        "" = 标记值;
    } 否则 {
        (源位置)取码 = 码;
        源位置 + 1 = 源位置;
        如果 (码 ?= 61) {
            ("[调试] 扫描到 =")打印;
            T_ASSIGN = 标记类型;
            "=" = 标记值;
        }
    }
}

// 前进标记
函数 前进标记(空) {
    ()扫描;
    ("[调试] 前进标记: 类型=")打印;
    (标记类型)打印;
    (" 值=")打印;
    (标记值)打印;
    ("")打印;
}

// 测试
函数 主程序 {
    ("=== 简单解析器调试 ===")打印;
    
    "= x" = 源代码;
    0 = 源位置;
    
    ()前进标记;
    ("结果: 类型=")打印;
    (标记类型)打印;
    (" 值=")打印;
    (标记值)打印;
    ("")打印;
    
    ("=== 完成 ===")打印;
}
