// ============================================
// 日月编译器 — 种子验证
// 验证 C++ 种子编译器能正确编译日月语言子集
// ============================================

// ────────────────────────────────────────────
// 测试基础设施 (Test Infrastructure)
// ────────────────────────────────────────────

0 = 变量 测试通过;
0 = 变量 测试失败;

函数 (条件:整数, 消息:字符串)断言 {
    如果 (条件) {
        测试通过 + 1 = 测试通过;
    } 否则 {
        测试失败 + 1 = 测试失败;
        ("[失败] ")打印;
        (消息)打印;
    }
}

// ────────────────────────────────────────────
// 语言特性测试 (Language Feature Tests)
// ────────────────────────────────────────────

// --- 整数运算 ---
函数 测试整数运算 {
    10 = a;
    3 = b;
    (a + b ?= 13, "加法")断言;
    (a - b ?= 7, "减法")断言;
    (a * b ?= 30, "乘法")断言;
    (a / b ?= 3, "除法")断言;
    (a % b ?= 1, "取模")断言;
}

// --- 比较运算 ---
函数 测试比较运算 {
    10 = a;
    20 = b;
    (a < b ?= 1, "小于")断言;
    (b > a ?= 1, "大于")断言;
    (a <= a ?= 1, "小于等于")断言;
    (a >= a ?= 1, "大于等于")断言;
    (a ?= a ?= 1, "等于")断言;
    (a != b ?= 1, "不等于")断言;
}

// --- 逻辑运算 ---
函数 测试逻辑运算 {
    (1 && 1 ?= 1, "与")断言;
    (0 || 1 ?= 1, "或")断言;
    (!0 ?= 1, "非")断言;
}

// --- 控制流 ---
函数 测试控制流 {
    5 = x;
    0 = 结果;
    如果 (x > 3) {
        1 = 结果;
    } 否则 {
        2 = 结果;
    }
    (结果 ?= 1, "如果")断言;

    0 = 结果;
    如果 (x > 10) {
        3 = 结果;
    } 否则如果 (x > 3) {
        4 = 结果;
    } 否则 {
        5 = 结果;
    }
    (结果 ?= 4, "否则如果")断言;
}

// --- 循环 ---
函数 测试循环 {
    0 = 总和;
    1 = i;
    当 (i <= 10) {
        总和 + i = 总和;
        i + 1 = i;
    }
    (总和 ?= 55, "当循环")断言;

    0 = 总和;
    1 = j;
    当 (j <= 10) {
        总和 + j = 总和;
        j + 1 = j;
    }
    (总和 ?= 55, "循环")断言;
}

// --- 函数 ---
函数 (甲:整数, 乙:整数)加法(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 (数:整数)阶乘(0 = 结果:整数) {
    如果 (数 <= 1) {
        1 = 结果;
    } 否则 {
        数 - 1 = 前一个;
        (前一个)阶乘 = 递归结果;
        数 * 递归结果 = 结果;
    }
}

函数 测试函数 {
    (3, 4)加法 = 加和;
    (加和 ?= 7, "函数调用")断言;
    (5)阶乘 = 阶乘结果;
    (阶乘结果 ?= 120, "递归")断言;
}

// --- 数组 ---
函数 测试数组 {
    [10, 20, 30, 40, 50] = 数据;
    (数据[0] ?= 10, "数组访问")断言;
    (数据[2] ?= 30, "数组访问2")断言;
    99 = 数据[1];
    (数据[1] ?= 99, "数组赋值")断言;
}

// --- 字符串 ---
函数 测试字符串 {
    "你好世界" = s;
    (s)长度 = 长度值;
    (长度值 ?= 4, "字符串长度")断言;
    ("你好", "世界")拼接 = t;
    (t)长度 = 拼接长度;
    (拼接长度 ?= 4, "拼接长度")断言;
}

// --- 中断/继续 ---
函数 测试中断继续 {
    0 = 总和;
    0 = k;
    当 (真) {
        k + 1 = k;
        如果 (k > 10) { 中断; }
        如果 (k % 2 ?= 0) { 继续; }
        总和 + k = 总和;
    }
    (总和 ?= 25, "中断继续")断言;
}

// ────────────────────────────────────────────
// 入口 (Entry Point)
// ────────────────────────────────────────────
函数 主程序 {
    ("=== 种子验证 ===")打印;
    ()测试整数运算;
    ()测试比较运算;
    ()测试逻辑运算;
    ()测试控制流;
    ()测试循环;
    ()测试函数;
    ()测试数组;
    ()测试字符串;
    ()测试中断继续;
    ("  通过: ")打印;
    (测试通过)打印;
    ("  失败: ")打印;
    (测试失败)打印;
    如果 (测试失败 ?= 0) {
        ("=== 种子验证通过 ===")打印;
    }
}
