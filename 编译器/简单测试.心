// 简单词法器测试

// 标记类型常量
0 = T_NUM:整数;
1 = T_PLUS:整数;

// 词法器状态
"" = 源代码;
0 = 源位置;
0 = 当前标记类型;
"" = 当前标记值;

// 获取当前字符码
函数 获取字符码(0 = 结果:整数) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        0 = 结果;
    } 否则 {
        (源代码, 源位置)字符码 = 结果;
    }
}

// 获取当前字符
函数 获取字符("" = 结果:字符串) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        "" = 结果;
    } 否则 {
        (源代码, 源位置, 1)子串 = 结果;
    }
}

// 扫描数字
函数 扫描数字(空) {
    "" = 数字字符串;
    (源代码)长度 = 代码长度;
    当 (源位置 < 代码长度) {
        ()获取字符码 = c;
        如果 (c >= 48 && c <= 57) {
            ()获取字符 = 数字字符;
            数字字符串 + 数字字符 = 数字字符串;
            源位置 + 1 = 源位置;
        } 否则 {
            中断;
        }
    }
    T_NUM = 当前标记类型;
    数字字符串 = 当前标记值;
}

// 扫描标记
函数 扫描标记(空) {
    (源代码)长度 = 代码长度;
    如果 (源位置 >= 代码长度) {
        99 = 当前标记类型;
        "" = 当前标记值;
    } 否则 {
        ()获取字符码 = c;
        如果 (c >= 48 && c <= 57) {
            ()扫描数字;
        } 否则 {
            源位置 + 1 = 源位置;
            如果 (c ?= 43) { T_PLUS = 当前标记类型; "+" = 当前标记值; }
        }
    }
}

// 测试
函数 测试(空) {
    ("=== 测试 ===")打印;
    
    "42 + 3" = 源代码;
    0 = 源位置;
    
    ()扫描标记;
    ("标记类型: ")打印;
    (当前标记类型)打印;
    ("标记值: ")打印;
    (当前标记值)打印;
    ("期望: 0 42")打印;
    
    ()扫描标记;
    ("标记类型: ")打印;
    (当前标记类型)打印;
    ("标记值: ")打印;
    (当前标记值)打印;
    ("期望: 1 +")打印;
    
    ()扫描标记;
    ("标记类型: ")打印;
    (当前标记类型)打印;
    ("标记值: ")打印;
    (当前标记值)打印;
    ("期望: 0 3")打印;
    
    ("=== 完成 ===")打印;
}

函数 主程序 {
    ()测试;
}
