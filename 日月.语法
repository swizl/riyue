# 日月编程语言语法定义
# 格式说明：
#   %token 名称 正则    - 定义词法标记
#   规则名: 产生式      - 定义语法规则
#   | 替代规则          - 备选产生式
#   { X }               - 重复零次或多次
#   [ X ]               - 可选（零次或一次）
#   ( X )               - 分组
#   '文字'              - 字面量匹配
#   &X                  - 正向前瞻
#   !X                  - 负向前瞻

# ============ 词法定义 ============

# 跳过
%skip   空白        [ \t\r\n]+
%skip   单行注释    '//'.*$
%skip   多行注释    '/\*'[\s\S]*?'\*/'

# 字面量
%token  整数        [0-9]+
%token  字符串      '"'(?:[^"\\]|\\.)*'"'

# 标识符（支持中文和英文）
%token  标识符      [a-zA-Z_\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*

# 关键字（作为特殊标识符处理）
%keyword 函数 空 如果 否则 否则如果 循环 当 中断 继续 变量 常量 打印 返回 整数 布尔 真 假

# 运算符和分隔符
%token  加号        '+'
%token  减号        '-'
%token  乘号        '\*'
%token  除号        '/'
%token  百分号      '%'
%token  加等于      '+='
%token  减等于      '-='
%token  乘等于      '*='
%token  除等于      '/='
%token  等于        '='
%token  等于等于    '?='
%token  感叹号等于  '!='
%token  小于        '<'
%token  大于        '>'
%token  小于等于    '<='
%token  大于等于    '>='
%token  与与        '&&'
%token  或或        '||'
%token  感叹号      '!'
%token  左括号      '('
%token  右括号      ')'
%token  左花括号    '{'
%token  右花括号    '}'
%token  左方括号    '['
%token  右方括号    ']'
%token  分号        ';'
%token  逗号        ','
%token  冒号        ':'

# ============ 语法定义 ============

程序: 全局声明* $;

全局声明:
    | 函数定义
    | 全局变量声明
    ;

全局变量声明: '变量' 标识符 [':' 类型] '=' 表达式 ';' ;

函数定义: '函数' 标识符 '(' 参数列表? ')' [':' 类型] 代码块 ;

参数列表: 参数 (',' 参数)* ;
参数: 标识符 [':' 类型] ;

类型:
    | '整数'
    | '布尔'
    | '空'
    ;

代码块: '{' 语句* '}' ;

语句:
    | 变量声明
    | 赋值语句
    | 下标赋值语句
    | 如果语句
    | 循环语句
    | 当循环语句
    | 中断语句
    | 继续语句
    | 返回语句
    | 打印语句
    | 表达式语句
    | 代码块
    ;

变量声明: ('变量' | '常量') 标识符 [':' 类型] '=' 表达式 ';' ;

赋值语句: 标识符 ('=' | '+=' | '-=' | '*=' | '/=') 表达式 ';' ;

下标赋值语句: 标识符 '[' 表达式 ']' '=' 表达式 ';' ;

如果语句: '如果' '(' 表达式 ')' 代码块 {'否则如果' '(' 表达式 ')' 代码块} ['否则' 代码块] ;

循环语句: '循环' 代码块 ;

当循环语句: '当' '(' 表达式 ')' 代码块 ;

中断语句: '中断' ';' ;

继续语句: '继续' ';' ;

返回语句: '返回' [表达式] ';' ;

打印语句: '打印' '(' 表达式 ')' ';' ;

表达式语句: 表达式 ';' ;

# 表达式（优先级从低到高）
表达式: 逻辑或表达式 ;

逻辑或表达式: 逻辑与表达式 {'||' 逻辑与表达式} ;
逻辑与表达式: 比较表达式 {'&&' 比较表达式} ;
比较表达式: 加减表达式 {比较运算符 加减表达式} ;
加减表达式: 乘除表达式 {('+' | '-') 乘除表达式} ;
乘除表达式: 一元表达式 {('*' | '/' | '%') 一元表达式} ;
一元表达式: ('!' | '-') 一元表达式 | 基本表达式 ;

比较运算符: '?=' | '!=' | '<' | '>' | '<=' | '>=' ;

基本表达式:
    | 整数
    | '真'
    | '假'
    | 字符串
    | 标识符 ['(' 参数列表? ')'] ['[' 表达式 ']']
    | '[' [表达式 (',' 表达式)*] ']'
    | '函数' '(' 参数列表? ')' [':' 类型] 代码块
    | '(' 表达式 ')'
    ;
