// 日月编译器 - 新语法测试套件

0 = 测试通过;
0 = 测试失败;

函数 (条件, 名称)断言(空) {
    如果 (条件) {
        测试通过 = 测试通过 + 1;
        ("[通过] ")打印;
        (名称)打印;
    } 否则 {
        测试失败 = 测试失败 + 1;
        ("[失败] ")打印;
        (名称)打印;
    }
}

// ===== 1. 新变量声明 =====
函数 ()测试变量声明(空) {
    ("=== 1. 新变量声明 ===")打印;

    42 = 变量值;
    (变量值 ?= 42, "整数赋值")断言;

    3.14 = pi;
    (1 ?= 1, "浮点赋值")断言;

    "hello" = msg;
    (1 ?= 1, "字符串赋值")断言;

    ("")打印;
}

// ===== 2. if条件声明变量 =====
函数 ()测试if声明(空) {
    ("=== 2. if条件声明变量 ===")打印;

    如果 (5 = 变量值; 变量值 > 3) {
        (变量值 ?= 5, "if条件声明")断言;
    } 否则 {
        (0 ?= 1, "if条件声明")断言;
    }

    如果 (10 = 值; 值 > 20) {
        (0 ?= 1, "if条件声明(假)")断言;
    } 否则 {
        (值 ?= 10, "if条件声明(假)else")断言;
    }

    ("")打印;
}

// ===== 3. 做循环 =====
函数 ()测试做循环(空) {
    ("=== 3. 做循环 ===")打印;

    0 = 计数;
    0 = 总和;
    做 {
        计数 = 计数 + 1;
        总和 = 总和 + 计数;
    } 当(计数 < 10);
    (总和 ?= 55, "做...当循环")断言;

    0 = 计数2;
    0 = 总和2;
    做 {
        计数2 = 计数2 + 1;
        总和2 = 总和2 + 计数2;
    } 到(计数2 >= 10);
    (总和2 ?= 55, "做...到循环")断言;

    ("")打印;
}

// ===== 4. 循环新语法 =====
函数 ()测试循环(空) {
    ("=== 4. 循环新语法 ===")打印;

    0 = 总和;
    循环 (0 = 索引; 索引 < 10; 索引 = 索引 + 1) {
        总和 = 总和 + 索引;
    }
    (总和 ?= 45, "循环新语法")断言;

    ("")打印;
}

// ===== 5. 基本运算 =====
函数 ()测试运算(空) {
    ("=== 5. 基本运算 ===")打印;

    10 = 甲;
    3 = 乙;

    (甲 + 乙 ?= 13, "加法")断言;
    (甲 - 乙 ?= 7, "减法")断言;
    (甲 * 乙 ?= 30, "乘法")断言;
    (甲 / 乙 ?= 3, "除法")断言;

    ("")打印;
}

// ===== 主函数 =====
函数 ()主(空) {
    ("================================")打印;
    ("  日月新语法测试")打印;
    ("================================")打印;
    ("")打印;

    ()测试变量声明;
    ()测试if声明;
    ()测试做循环;
    ()测试循环;
    ()测试运算;

    ("================================")打印;
    ("通过: ")打印;
    (测试通过)打印;
    ("失败: ")打印;
    (测试失败)打印;

    如果 (测试失败 ?= 0) {
        ("所有测试通过!")打印;
    } 否则 {
        ("有测试失败!")打印;
    }
}
