// 日月编译器 - 完整测试套件
// 测试所有语言特性

变量 测试通过 = 0;
变量 测试失败 = 0;

函数 (条件, 名称)断言 {
    如果 (条件) {
        测试通过 = 测试通过 + 1;
        打印("[通过] ");
        打印(名称);
    } 否则 {
        测试失败 = 测试失败 + 1;
        打印("[失败] ");
        打印(名称);
    }
}

// ===== 工具函数（必须在使用前定义）=====
函数 (甲, 乙)加法(0 = 结果:整数) {
    甲 + 乙 = 结果;
}

函数 (数)阶乘(0 = 结果:整数) {
    如果 (数 <= 1) {
        1 = 结果;
    }
    数 * 阶乘(数 - 1) = 结果;
}

函数 (数)斐波那契(0 = 结果:整数) {
    如果 (数 <= 0) {
        0 = 结果;
    }
    如果 (数 <= 1) {
        1 = 结果;
    }
    斐波那契(数 - 1) + 斐波那契(数 - 2) = 结果;
}

函数 (甲, 乙)最大公约数(0 = 结果:整数) {
    当 (乙 != 0) {
        变量 临时 = 乙;
        乙 = 甲 % 乙;
        甲 = 临时;
    }
    甲 = 结果;
}

// ===== 1. 基本类型测试 =====
函数 测试基本类型 {
    打印("=== 1. 基本类型测试 ===");

    变量 整数值 = 42;
    断言(整数值 ?= 42, "整数字面量");

    变量 真值 = 真;
    变量 假值 = 假;
    断言(真值 ?= 1, "真字面量");
    断言(假值 ?= 0, "假字面量");

    变量 字符串值 = "你好世界";
    打印("字符串: ");
    打印(字符串值);
    断言(1 ?= 1, "字符串字面量");

    打印("");
}

// ===== 2. 算术运算测试 =====
函数 测试算术运算 {
    打印("=== 2. 算术运算测试 ===");

    变量 甲 = 10;
    变量 乙 = 3;

    断言(甲 + 乙 ?= 13, "加法");
    断言(甲 - 乙 ?= 7, "减法");
    断言(甲 * 乙 ?= 30, "乘法");
    断言(甲 / 乙 ?= 3, "除法");
    断言(甲 % 乙 ?= 1, "取模");

    变量 结果 = (甲 + 乙) * 2 - 5;
    断言(结果 ?= 21, "复合运算");

    变量 负数 = -42;
    断言(负数 ?= -42, "取负");

    打印("");
}

// ===== 3. 比较运算测试 =====
函数 测试比较运算 {
    打印("=== 3. 比较运算测试 ===");

    变量 甲 = 10;
    变量 乙 = 20;

    断言(甲 < 乙 ?= 1, "小于");
    断言(乙 > 甲 ?= 1, "大于");
    断言(甲 <= 10 ?= 1, "小于等于");
    断言(乙 >= 20 ?= 1, "大于等于");
    断言(甲 ?= 10 ?= 1, "等于");
    断言(甲 != 乙 ?= 1, "不等于");

    打印("");
}

// ===== 4. 逻辑运算测试 =====
函数 测试逻辑运算 {
    打印("=== 4. 逻辑运算测试 ===");

    断言(1 && 1 ?= 1, "逻辑与(1,1)");
    断言(1 && 0 ?= 0, "逻辑与(1,0)");
    断言(0 || 1 ?= 1, "逻辑或(0,1)");
    断言(0 || 0 ?= 0, "逻辑或(0,0)");
    断言(!0 ?= 1, "逻辑非(0)");
    断言(!1 ?= 0, "逻辑非(1)");

    打印("");
}

// ===== 5. 控制流测试 =====
函数 测试控制流 {
    打印("=== 5. 控制流测试 ===");

    变量 值 = 15;
    变量 结果 = 0;
    如果 (值 < 10) {
        结果 = 1;
    } 否则如果 (值 < 20) {
        结果 = 2;
    } 否则 {
        结果 = 3;
    }
    断言(结果 ?= 2, "如果/否则如果/否则");

    变量 循环计数 = 0;
    变量 循环总和 = 0;
    当 (循环计数 < 10) {
        循环计数 = 循环计数 + 1;
        循环总和 = 循环总和 + 循环计数;
    }
    断言(循环总和 ?= 55, "当循环");

    变量 中断计数 = 0;
    当 (1) {
        中断计数 = 中断计数 + 1;
        如果 (中断计数 >= 5) {
            中断;
        }
    }
    断言(中断计数 ?= 5, "中断语句");

    变量 继续计数 = 0;
    变量 继续总和 = 0;
    当 (继续计数 < 10) {
        继续计数 = 继续计数 + 1;
        如果 (继续计数 % 2 ?= 0) {
            继续;
        }
        继续总和 = 继续总和 + 继续计数;
    }
    断言(继续总和 ?= 25, "继续语句");

    打印("");
}

// ===== 6. 函数测试 =====
函数 测试函数 {
    打印("=== 6. 函数测试 ===");

    断言(加法(10, 20) ?= 30, "基本函数调用");
    断言(阶乘(5) ?= 120, "递归(阶乘)");
    断言(阶乘(10) ?= 3628800, "递归(阶乘大数)");
    断言(斐波那契(10) ?= 55, "递归(斐波那契)");
    断言(最大公约数(48, 18) ?= 6, "递归(最大公约数)");

    变量 结果 = 加法(100, 200);
    断言(结果 ?= 300, "多参数函数");

    打印("");
}

// ===== 7. 数组测试 =====
函数 测试数组 {
    打印("=== 7. 数组测试 ===");

    变量 数据 = [10, 20, 30, 40, 50];
    断言(数据[0] ?= 10, "数组访问[0]");
    断言(数据[1] ?= 20, "数组访问[1]");
    断言(数据[2] ?= 30, "数组访问[2]");
    断言(数据[3] ?= 40, "数组访问[3]");
    断言(数据[4] ?= 50, "数组访问[4]");

    数据[2] = 99;
    断言(数据[2] ?= 99, "数组赋值");

    变量 总和 = 0;
    变量 索引 = 0;
    当 (索引 < 5) {
        总和 = 总和 + 数据[索引];
        索引 = 索引 + 1;
    }
    断言(总和 ?= 219, "数组遍历求和");

    打印("");
}

// ===== 8. 闭包测试 =====
函数 测试闭包 {
    打印("=== 8. 闭包测试 ===");

    变量 基数 = 100;
    变量 加基数 = 函数 (值) {
        值 + 基数 = 结果;
    }(0 = 结果:整数);
    断言(加基数(50) ?= 150, "基本闭包");

    变量 双倍 = 函数 (值) {
        值 * 2 = 结果;
    }(0 = 结果:整数);
    变量 映射结果 = 双倍(21);
    断言(映射结果 ?= 42, "闭包作为参数");

    打印("");
}

// ===== 9. 文件IO测试 =====
函数 测试文件IO {
    打印("=== 9. 文件IO测试 ===");

    变量 写文件 = 打开("构建/测试输出.txt", "w");
    如果 (写文件 != 0) {
        写入(写文件, "测试数据第一行\n");
        写入(写文件, "测试数据第二行\n");
        关闭(写文件);
        断言(1 ?= 1, "文件写入");
    }

    变量 读文件 = 打开("构建/测试输出.txt", "r");
    如果 (读文件 != 0) {
        关闭(读文件);
        断言(1 ?= 1, "文件读取");
    }

    打印("");
}

// ===== 10. 字符串测试 =====
函数 测试字符串 {
    打印("=== 10. 字符串测试 ===");

    打印("字符串字面量: 你好世界");
    打印("转义字符: 换行\t制表符");
    打印("中文支持: 日月编程语言");

    断言(1 ?= 1, "字符串基本功能");

    打印("");
}

// ===== 11. 复杂场景测试 =====
函数 测试复杂场景 {
    打印("=== 11. 复杂场景测试 ===");

    变量 嵌套结果 = 阶乘(加法(3, 2));
    断言(嵌套结果 ?= 120, "嵌套函数调用");

    变量 最大值 = 0;
    变量 甲 = 10;
    变量 乙 = 20;
    如果 (甲 > 乙) {
        最大值 = 甲;
    } 否则 {
        最大值 = 乙;
    }
    断言(最大值 ?= 20, "条件表达式");

    变量 循环结果 = 0;
    变量 循环索引 = 1;
    当 (循环索引 <= 5) {
        循环结果 = 循环结果 + 阶乘(循环索引);
        循环索引 = 循环索引 + 1;
    }
    断言(循环结果 ?= 153, "循环中的函数调用");

    打印("");
}

// ===== 主测试函数 =====
函数 主程序 {
    打印("================================");
    打印("  日月编译器 - 完整测试套件");
    打印("================================");
    打印("");

    测试基本类型();
    测试算术运算();
    测试比较运算();
    测试逻辑运算();
    测试控制流();
    测试函数();
    测试数组();
    测试闭包();
    测试文件IO();
    测试字符串();
    测试复杂场景();

    打印("================================");
    打印("  测试结果汇总");
    打印("================================");
    打印("通过: ");
    打印(测试通过);
    打印("失败: ");
    打印(测试失败);

    如果 (测试失败 ?= 0) {
        打印("所有测试通过!");
    } 否则 {
        打印("有测试失败!");
    }
}
